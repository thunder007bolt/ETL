    {
      "id": "7JsanO4fVhPi9eJyOnuk",
      "type": "text",
      "x": 89.0,
      "y": 898.0,
      "width": 722.8800000000001,
      "height": 45.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
