      "versionNonce": 33666135,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794235844903,
      "link": null,
      "locked": false,
      "text": "Un paiement compte dans le mois qu'il paie, pas dans celui où il est saisi.\nUn rappel versé en février pour octobre compte en octobre. (R4)",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Un paiement compte dans le mois qu'il paie, pas dans celui où il est saisi.\nUn rappel versé en février pour octobre compte en octobre. (R4)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
