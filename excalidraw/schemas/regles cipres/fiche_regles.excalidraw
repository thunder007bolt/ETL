      "updated": 1794235844903,
      "link": null,
      "locked": false,
      "text": "Chaque chiffre se découpe par direction régionale et par agence : celles du\ndossier, à défaut celles de la réception. (T25-T27 N2)",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Chaque chiffre se découpe par direction régionale et par agence : celles du\ndossier, à défaut celles de la réception. (T25-T27 N2)",
      "autoResize": true,
      "lineHeight": 1.25
    },
