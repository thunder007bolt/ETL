      "isDeleted": false,
      "boundElements": [],
      "updated": 1794235844903,
      "link": null,
      "locked": false,
      "text": "Les accessoires d'une pension (bonification ou majoration pour enfant,\ncharges du ménage) ne font ni une demande ni un bénéficiaire de plus. (A1)",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Les accessoires d'une pension (bonification ou majoration pour enfant,\ncharges du ménage) ne font ni une demande ni un bénéficiaire de plus. (A1)",
      "autoResize": true,
      "lineHeight": 1.25
    },
