      "isDeleted": false,
      "boundElements": [],
      "updated": 1794235844903,
      "link": null,
      "locked": false,
      "text": "Un paiement est un débours de paiement payé, au statut D (par un titre de\npaiement) ou P (sans titre). On prend son montant, jamais le net à payer du\ntitre. (R3)",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Un paiement est un débours de paiement payé, au statut D (par un titre de\npaiement) ou P (sans titre). On prend son montant, jamais le net à payer du\ntitre. (R3)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "TCyAEK5VdfqnajIut19H",
      "type": "text",
      "x": 43.0,
      "y": 898.0,
      "width": 18.54,
