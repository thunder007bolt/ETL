      "link": null,
      "locked": false,
      "text": "Seul compte ce qui est saisi dans l'application. Une correction faite à côté (fichier, mission en région, compte de résultat) n'entre pas dans les tableaux. (proposition BI)",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Seul compte ce qui est saisi dans l'application. Une correction faite à côté (fichier, mission en région, compte de résultat) n'entre pas dans les tableaux. (proposition BI)",
      "autoResize": true,
      "lineHeight": 1.25
