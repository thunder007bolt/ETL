      "isDeleted": false,
      "boundElements": [],
      "updated": 1794235844903,
      "link": null,
      "locked": false,
      "text": "Un départ est une décision 02 retraite, 34 décès, 35 fin de contrat, 36\ndémission, 52 rupture ou 54 licenciement. Annulée par une 40, elle ne\ncompte pas. Sans décision, on prend la date de décès. (G2)",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Un départ est une décision 02 retraite, 34 décès, 35 fin de contrat, 36\ndémission, 52 rupture ou 54 licenciement. Annulée par une 40, elle ne\ncompte pas. Sans décision, on prend la date de décès. (G2)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "bJtuzVFZF2uKpYn9VSOA",
