      "type": "text",
      "x": 89.0,
      "y": 1218.0,
      "width": 741.9600000000002,
      "height": 90.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
