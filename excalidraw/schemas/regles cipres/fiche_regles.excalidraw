      "boundElements": [],
      "updated": 1794235844903,
      "link": null,
      "locked": false,
      "text": "Quand un tableau compte des personnes, il compte celle qui a droit\n(l'orphelin, pas son tuteur), une fois par tableau. On n'additionne jamais\ndeux tableaux. (R5)",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Quand un tableau compte des personnes, il compte celle qui a droit\n(l'orphelin, pas son tuteur), une fois par tableau. On n'additionne jamais\ndeux tableaux. (R5)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
