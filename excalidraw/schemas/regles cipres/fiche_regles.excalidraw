      "isDeleted": false,
      "boundElements": [],
      "updated": 1794235844903,
      "link": null,
      "locked": false,
      "text": "Une pension de coordination payée par l'autre caisse compte comme\nbénéficiaire, sans montant : seule la part payée par la CNSS entre dans les\nmontants. (R3)",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Une pension de coordination payée par l'autre caisse compte comme\nbénéficiaire, sans montant : seule la part payée par la CNSS entre dans les\nmontants. (R3)",
      "autoResize": true,
      "lineHeight": 1.25
    },
