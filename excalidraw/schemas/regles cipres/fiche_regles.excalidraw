      "boundElements": [],
      "updated": 1794235844903,
      "link": null,
      "locked": false,
      "text": "Un temporaire est présent si la date d'arrêté tombe dans un de ses contrats\n(engagement 50). Sans fin de contrat connue, il reste compté. (G7)",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Un temporaire est présent si la date d'arrêté tombe dans un de ses contrats\n(engagement 50). Sans fin de contrat connue, il reste compté. (G7)",
      "autoResize": true,
      "lineHeight": 1.25
    },
