      "boundElements": [],
      "updated": 1794235844903,
      "link": null,
      "locked": false,
      "text": "À la fin de janvier N+1, la BI reprend la photo de la base. Cette photo fait foi pour tous les tableaux de l'année N. (remplace R13)",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "À la fin de janvier N+1, la BI reprend la photo de la base. Cette photo fait foi pour tous les tableaux de l'année N. (remplace R13)",
      "autoResize": true,
      "lineHeight": 1.25
    },
