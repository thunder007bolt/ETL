    {
      "id": "zYzv6BzsfJpzk19MWJdY",
      "type": "text",
      "x": 89.0,
      "y": 1163.0,
      "width": 745.9200000000001,
      "height": 45.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
