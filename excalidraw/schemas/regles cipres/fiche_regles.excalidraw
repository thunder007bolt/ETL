      "isDeleted": false,
      "boundElements": [],
      "updated": 1794235844903,
      "link": null,
      "locked": false,
      "text": "Un permanent est présent s'il est entré au plus tard à la date d'arrêté\n(embauche, à défaut prise de service) et pas encore parti à cette date. (G2)",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Un permanent est présent s'il est entré au plus tard à la date d'arrêté\n(embauche, à défaut prise de service) et pas encore parti à cette date. (G2)",
      "autoResize": true,
      "lineHeight": 1.25
    },
