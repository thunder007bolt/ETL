    {
      "id": "IYmiqNPjzBFUQoODzWq9",
      "type": "text",
      "x": 365,
      "y": 732.0,
      "width": 1043.64,
      "height": 67.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
