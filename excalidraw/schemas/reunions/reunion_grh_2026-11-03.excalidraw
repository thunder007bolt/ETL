      "isDeleted": false,
      "boundElements": [],
      "updated": 1793792254116,
      "link": null,
      "locked": false,
      "text": "Il penche pour la prise de service : on peut l'avoir sans l'engagement. Engagé le 25/12/2026, prise de\nservice le 10/01/2027 : entré en 2027. La même date doit servir à l'ancienneté. (opt 11:16 à 14:03)",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Il penche pour la prise de service : on peut l'avoir sans l'engagement. Engagé le 25/12/2026, prise de\nservice le 10/01/2027 : entré en 2027. La même date doit servir à l'ancienneté. (opt 11:16 à 14:03)",
      "autoResize": true,
      "lineHeight": 1.25
    },
