      "boundElements": [],
      "updated": 1793792254116,
      "link": null,
      "locked": false,
      "text": "Les données financières viennent du logiciel financier : la masse salariale dans les comptes 651 et 652.\nLe budget de formation de la GRH n'est pas tenu à jour. Nous définissons la structure des vues ; la CNSS\nles alimente périodiquement.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Les données financières viennent du logiciel financier : la masse salariale dans les comptes 651 et 652.\nLe budget de formation de la GRH n'est pas tenu à jour. Nous définissons la structure des vues ; la CNSS\nles alimente périodiquement.",
      "autoResize": true,
      "lineHeight": 1.25
    },
