    {
      "id": "YFq4qjLWZwqe4EE2AyI5",
      "type": "text",
      "x": 365,
      "y": 1015.5,
      "width": 1045.08,
      "height": 90.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
