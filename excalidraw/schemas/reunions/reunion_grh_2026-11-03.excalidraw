      "seed": 50131765,
      "version": 1,
      "versionNonce": 1012776046,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793792254116,
      "link": null,
      "locked": false,
      "text": "« Avec promotion » est la finalité de la formation, pas la promotion obtenue : « ils disent juste la\nfinalité, on ne sait pas si elle a effectivement eu la promotion ». Une formation diplômante est d'emblée «\navec promotion ».",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "« Avec promotion » est la finalité de la formation, pas la promotion obtenue : « ils disent juste la\nfinalité, on ne sait pas si elle a effectivement eu la promotion ». Une formation diplômante est d'emblée «\navec promotion ».",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "j1qkXOR3Fzc4pgKYeOLK",
      "type": "text",
      "x": 1445,
      "y": 732.0,
      "width": 702.1800000000001,
      "height": 45.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "2bDog6j7Lm72y9RGJCD3"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 664360821,
      "version": 1,
      "versionNonce": 1506266901,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793792254116,
      "link": null,
      "locked": false,
      "text": "Le terme 7 change de sens : on ne cherche plus la montée de catégorie, on\nregarde le type de formation (DIPLO). À confirmer avec la DRH.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Le terme 7 change de sens : on ne cherche plus la montée de catégorie, on\nregarde le type de formation (DIPLO). À confirmer avec la DRH.",
      "autoResize": true,
      "lineHeight": 1.25
    },
