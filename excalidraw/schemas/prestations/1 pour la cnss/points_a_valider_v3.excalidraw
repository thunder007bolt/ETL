      "x": 39.0,
      "y": 11872.5,
      "width": 688.0,
      "height": 20.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "j3j7LjKVrBTnIWn33KLj"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 2054468895,
      "version": 1,
      "versionNonce": 1181277980,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794914765618,
      "link": null,
      "locked": false,
      "text": "Aujourd'hui : seuls les taux sont diffusés ; le détail par dossier reste réservé.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Aujourd'hui : seuls les taux sont diffusés ; le détail par dossier reste réservé.",
