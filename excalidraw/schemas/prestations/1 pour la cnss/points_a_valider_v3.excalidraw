      "text": "La pension de la veuve (T25)",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "La pension de la veuve (T25)",
      "autoResize": true,
