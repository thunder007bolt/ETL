    {
      "id": "j0adczfZhr7Vm9bsayEM",
      "type": "text",
      "x": 118.96888260254597,
      "y": 17964.5,
      "width": 371.6,
      "height": 25.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
