    {
      "id": "dzgu8I18Wnb4lueWLgLu",
      "type": "text",
      "x": 102.22206506364921,
      "y": 2956.5,
      "width": 249.20000000000002,
      "height": 25.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
