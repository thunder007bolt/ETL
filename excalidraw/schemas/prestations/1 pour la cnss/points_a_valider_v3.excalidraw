    {
      "id": "FQXPKOpCmFUceI39cimy",
      "type": "text",
      "x": 955.0,
      "y": 4386.5,
      "width": 214.00000000000003,
      "height": 25.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
