    {
      "id": "KXQLViIdMb76TK0KFq25",
      "type": "text",
      "x": 960.2220650636492,
      "y": 16268.5,
      "width": 373.6,
      "height": 25.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
