      "isDeleted": false,
      "boundElements": [],
      "updated": 1794914765618,
      "link": null,
      "locked": false,
      "text": "Chiffre : 195 victimes ont eu une indemnité journalière liquidée en 2024, pour 371\nindemnités.",
