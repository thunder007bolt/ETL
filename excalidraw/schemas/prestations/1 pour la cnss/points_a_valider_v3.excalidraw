    {
      "id": "GieIYcoDvXkkLeo9YlzV",
      "type": "text",
      "x": 1818.2220650636493,
      "y": 16268.5,
      "width": 474.40000000000003,
      "height": 25.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
