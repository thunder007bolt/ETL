      "id": "v2Wn1K1iKAPTiNV1rZki",
      "type": "text",
      "x": 1755.0,
      "y": 2702.5,
      "width": 101.76,
      "height": 20.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "EXkwQTpHfVv6BZjELqS2"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 431340958,
      "version": 1,
      "versionNonce": 809495746,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794914765618,
      "link": null,
      "locked": false,
      "text": "À qui : DCP",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
