      "id": "4oe8JhK87QVet5ag7K9h",
      "type": "text",
      "x": 39.0,
      "y": 4162.5,
      "width": 339.2,
      "height": 20.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
