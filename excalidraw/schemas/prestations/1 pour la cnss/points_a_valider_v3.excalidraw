    {
      "id": "R4gKBYNOAgP5vCPRn0FF",
      "type": "rectangle",
      "x": 1755.0,
      "y": 5986.5,
      "width": 22,
      "height": 22,
      "angle": 0,
      "strokeColor": "#1e1e1e",
