    {
      "id": "4g35tFiyTU4qHTyzLOZC",
      "type": "text",
      "x": 102.22206506364921,
      "y": 27464.5,
      "width": 297.6,
      "height": 25.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
