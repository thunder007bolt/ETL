      "seed": 51343230,
      "version": 1,
      "versionNonce": 87805747,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794914765618,
      "link": null,
      "locked": false,
      "text": "C'est quoi : le recueil des besoins demande le délai des « rentes de survivants » depuis la\nréception du certificat de consolidation. Or ce certificat concerne la victime blessée, pas\nsa veuve ni ses orphelins.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "C'est quoi : le recueil des besoins demande le délai des « rentes de survivants » depuis la\nréception du certificat de consolidation. Or ce certificat concerne la victime blessée, pas\nsa veuve ni ses orphelins.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "nKJDwtVcyMjnwr2Tjnpw",
      "type": "text",
      "x": 897.0,
      "y": 8802.5,
      "width": 794.8800000000001,
      "height": 100.0,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "m7hZh4GUFXYW6imFa63l"
      ],
