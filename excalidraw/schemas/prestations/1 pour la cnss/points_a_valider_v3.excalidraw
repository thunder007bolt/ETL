      "version": 1,
      "versionNonce": 2146903384,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794914765618,
      "link": null,
      "locked": false,
      "text": "Chiffre : l'annuaire CNSS 2024 fait pareil : il publie la majoration pour enfant (537,3 M\nen 2024) à part, hors de la pension de retraite (38,24 Md).",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Chiffre : l'annuaire CNSS 2024 fait pareil : il publie la majoration pour enfant (537,3 M\nen 2024) à part, hors de la pension de retraite (38,24 Md).",
      "autoResize": true,
      "lineHeight": 1.25
    },
