      "versionNonce": 516966184,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794914765618,
      "link": null,
      "locked": false,
      "text": "Question : une pension versée après un décès déclaré en retard devient-elle un trop-perçu ?",
