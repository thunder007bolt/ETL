    {
      "id": "4Cy96ycZiRGrtFxEbjMm",
      "type": "text",
      "x": 1818.2220650636493,
      "y": 2294.5,
      "width": 407.20000000000005,
      "height": 25.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
