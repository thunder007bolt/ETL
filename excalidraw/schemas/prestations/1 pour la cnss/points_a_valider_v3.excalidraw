      "type": "text",
      "x": 897.0,
      "y": 5366.5,
      "width": 745.2800000000001,
      "height": 40.0,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
