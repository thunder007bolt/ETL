      "id": "31NxxdaP1uNFFLm2cXMn",
      "type": "text",
      "x": 897.0,
      "y": 5338.5,
      "width": 218.56,
      "height": 20.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "V621HoTpmD6PEMTwQstP"
