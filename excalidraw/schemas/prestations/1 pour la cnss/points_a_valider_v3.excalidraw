    {
      "id": "Ste0uv9Iu09FSptl8ysa",
      "type": "text",
      "x": 1818.2220650636493,
      "y": 26912.5,
      "width": 297.6,
      "height": 25.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
