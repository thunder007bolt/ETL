      "versionNonce": 402327722,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794914765618,
      "link": null,
      "locked": false,
      "text": "Question : pour T41 à la fin d'un mois ou d'un trimestre, un enfant compte-t-il s'il a été\npayé dans les 12 mois qui précèdent ?",
      "fontSize": 16,
      "fontFamily": 5,
