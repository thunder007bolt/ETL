      "versionNonce": 309666619,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794914765618,
      "link": null,
      "locked": false,
      "text": "Dans la base : PRESTATION_ESP, PE_SAL_MOYEN, jamais étudié.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Dans la base : PRESTATION_ESP, PE_SAL_MOYEN, jamais étudié.",
      "autoResize": true,
      "lineHeight": 1.25
