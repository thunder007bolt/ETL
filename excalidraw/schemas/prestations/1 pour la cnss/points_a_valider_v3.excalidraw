    {
      "id": "8IUAUSfTXOZxuJvAdHFd",
      "type": "text",
      "x": 1820.2588401697312,
      "y": 13426.5,
      "width": 400.0,
      "height": 25.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
