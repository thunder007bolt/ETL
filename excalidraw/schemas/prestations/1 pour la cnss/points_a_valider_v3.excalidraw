    },
    {
      "id": "b2a7JMDFJ8131kiq9iDZ",
      "type": "text",
      "x": 897.0,
      "y": 8450.5,
      "width": 800.0,
      "height": 40.0,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "lsH1uE9lpNnRlzSrCTSb"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1009457417,
      "version": 1,
      "versionNonce": 1939693962,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794914765618,
      "link": null,
      "locked": false,
      "text": "Question : une déclaration d'accident qui n'a donné ni arrêt, ni soins, ni rente compte-t-elle\ncomme un dossier déposé, en attente de traitement ?",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
