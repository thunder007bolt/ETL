      "type": "text",
      "x": 39.0,
      "y": 15480.5,
      "width": 763.2,
      "height": 40.0,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "g1NGLxzQj2K0ieumXkSG"
      ],
