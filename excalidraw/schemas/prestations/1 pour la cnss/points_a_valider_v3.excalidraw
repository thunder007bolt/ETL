      "versionNonce": 1653961130,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794914765618,
      "link": null,
      "locked": false,
      "text": "À qui : DCP",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "À qui : DCP",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "lSaLr1a1SG3TgCjLLbgP",
      "type": "text",
      "x": 897.0,
      "y": 23700.5,
      "width": 786.24,
      "height": 40.0,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "mciWow783X696SP8rHmR"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 518057807,
      "version": 1,
      "versionNonce": 2057392145,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794914765618,
      "link": null,
      "locked": false,
      "text": "Question : un sinistré décédé est-il seulement la victime morte sur le coup, ou aussi celle\nqui meurt de son accident des mois après ?",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Question : un sinistré décédé est-il seulement la victime morte sur le coup, ou aussi celle\nqui meurt de son accident des mois après ?",
      "autoResize": true,
      "lineHeight": 1.25
    },
