    {
      "id": "R8Bkb5UBr8PIwCVuCx6S",
      "type": "text",
      "x": 974.9321074964639,
      "y": 19770.5,
      "width": 482.40000000000003,
      "height": 25.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
