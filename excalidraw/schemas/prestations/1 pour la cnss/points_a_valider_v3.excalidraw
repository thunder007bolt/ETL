    {
      "id": "aYWcO8mYGTOIj6iDTH0K",
      "type": "text",
      "x": 979.005657708628,
      "y": 17412.5,
      "width": 440.0,
      "height": 25.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
