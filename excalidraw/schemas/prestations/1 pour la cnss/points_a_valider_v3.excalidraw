        "jI5pfW7ynmHeDXX14Tr9"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 43864036,
      "version": 1,
      "versionNonce": 648163993,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794914765618,
      "link": null,
      "locked": false,
      "text": "Question : pour un trimestre ou un semestre, compte-t-on les dossiers payés depuis le 1er\njanvier ?",
