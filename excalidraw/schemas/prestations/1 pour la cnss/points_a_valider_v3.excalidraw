      "versionNonce": 476577053,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794914765618,
      "link": null,
      "locked": false,
      "text": "Chiffre : l'annuaire CNSS 2024 fait pareil : 831 personnes liquidées en 2024 pour une\nallocation de vieillesse (RAV), pour 833 publiées (tableau 24).",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Chiffre : l'annuaire CNSS 2024 fait pareil : 831 personnes liquidées en 2024 pour une\nallocation de vieillesse (RAV), pour 833 publiées (tableau 24).",
      "autoResize": true,
      "lineHeight": 1.25
    },
