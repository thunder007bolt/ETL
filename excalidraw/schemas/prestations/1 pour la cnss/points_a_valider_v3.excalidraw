      "roundness": null,
      "seed": 1429739059,
      "version": 1,
      "versionNonce": 851944395,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794914765618,
      "link": null,
      "locked": false,
      "text": "Question : pour une pension ou une rente de survivant, on compte bien l'ayant droit lui-même,\net non l'assuré décédé titulaire du dossier ?",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Question : pour une pension ou une rente de survivant, on compte bien l'ayant droit lui-même,\net non l'assuré décédé titulaire du dossier ?",
      "autoResize": true,
      "lineHeight": 1.25
    },
