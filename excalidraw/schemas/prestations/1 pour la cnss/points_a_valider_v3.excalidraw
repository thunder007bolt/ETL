      "isDeleted": false,
      "boundElements": [],
      "updated": 1794914765618,
      "link": null,
      "locked": false,
      "text": "Aujourd'hui : la BI ne lit pas cette vue : T57 part des tables INDIVIDU,\nPRESTATION_ESP et DOSSIER.",
