    {
      "id": "HySHJT5PLbDRlKjcwvKJ",
      "type": "text",
      "x": 102.22206506364921,
      "y": 22080.5,
      "width": 282.8,
      "height": 25.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
