      "roundness": null,
      "seed": 2028772679,
      "version": 1,
      "versionNonce": 1945418408,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794914765618,
      "link": null,
      "locked": false,
      "text": "Objectif : dans T28 à T31, les taux de contrôle et d'indus doivent rester lisibles et\ncomparables à leurs normes, 5 % au moins et 2 % au plus (Kaya 2017). La réponse permet de\nfixer le nombre de chiffres après la virgule, pour qu'un petit taux, comme celui des indus des\nprestations familiales, ne soit pas écrasé par l'arrondi.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Objectif : dans T28 à T31, les taux de contrôle et d'indus doivent rester lisibles et\ncomparables à leurs normes, 5 % au moins et 2 % au plus (Kaya 2017). La réponse permet de\nfixer le nombre de chiffres après la virgule, pour qu'un petit taux, comme celui des indus des\nprestations familiales, ne soit pas écrasé par l'arrondi.",
      "autoResize": true,
      "lineHeight": 1.25
    },
