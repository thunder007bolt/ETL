      "updated": 1794914765618,
      "link": null,
      "locked": false,
      "text": "Question : où la base garde-t-elle les décès immédiats des accidents d'avant 2025 ?",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Question : où la base garde-t-elle les décès immédiats des accidents d'avant 2025 ?",
