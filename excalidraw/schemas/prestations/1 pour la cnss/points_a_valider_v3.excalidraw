      "locked": false,
      "text": "À qui : DCP, avec les DR",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "À qui : DCP, avec les DR",
