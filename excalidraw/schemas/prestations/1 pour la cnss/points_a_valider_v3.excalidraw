      "y": 4774.5,
      "width": 101.76,
      "height": 20.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "0VluOhNa7Rc3Kty40Qqy"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 2058881388,
      "version": 1,
      "versionNonce": 1238925287,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794914765618,
      "link": null,
      "locked": false,
      "text": "À qui : DCP",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "À qui : DCP",
      "autoResize": true,
