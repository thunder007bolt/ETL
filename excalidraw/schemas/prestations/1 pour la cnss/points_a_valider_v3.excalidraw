      "versionNonce": 1748539321,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794914765618,
      "link": null,
      "locked": false,
      "text": "Dans la base : elle prend toutes les prestations notifiées dont l'ayant droit a une date de\ndécès, sans filtre de type ni d'année, avec le nom, le prénom, l'adresse et le téléphone des\ndécédés.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Dans la base : elle prend toutes les prestations notifiées dont l'ayant droit a une date de\ndécès, sans filtre de type ni d'année, avec le nom, le prénom, l'adresse et le téléphone des\ndécédés.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
