      "updated": 1794914765618,
      "link": null,
      "locked": false,
      "text": "À qui : DES et DR",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
