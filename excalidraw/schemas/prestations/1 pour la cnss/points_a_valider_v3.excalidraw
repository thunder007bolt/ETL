      "versionNonce": 515825047,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794914765618,
      "link": null,
      "locked": false,
      "text": "Question : le décès d'une veuve pensionnée, ou l'arrêt de sa pension, est-il souvent saisi\nplusieurs mois après les faits ?",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Question : le décès d'une veuve pensionnée, ou l'arrêt de sa pension, est-il souvent saisi\nplusieurs mois après les faits ?",
      "autoResize": true,
      "lineHeight": 1.25
    },
