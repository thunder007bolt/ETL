    {
      "id": "z3fj5t8gD4Ce9Q2OdD0j",
      "type": "text",
      "x": 960.2220650636492,
      "y": 14512.5,
      "width": 252.40000000000003,
      "height": 25.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
