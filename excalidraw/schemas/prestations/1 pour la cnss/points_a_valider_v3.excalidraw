      "versionNonce": 1576556733,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794914765618,
      "link": null,
      "locked": false,
      "text": "Aujourd'hui : une valeur de plus de 600 mois (50 ans) est écartée des services passés (voir\nle point 16).",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Aujourd'hui : une valeur de plus de 600 mois (50 ans) est écartée des services passés (voir\nle point 16).",
      "autoResize": true,
      "lineHeight": 1.25
