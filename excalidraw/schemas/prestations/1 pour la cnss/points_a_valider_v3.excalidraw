    {
      "id": "lHTlLPRMYNYEENjsGDHS",
      "type": "text",
      "x": 39.0,
      "y": 5610.5,
      "width": 769.9200000000001,
      "height": 80.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
