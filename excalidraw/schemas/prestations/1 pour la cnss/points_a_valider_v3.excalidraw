      "seed": 2023204679,
      "version": 1,
      "versionNonce": 1352957557,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794914765618,
      "link": null,
      "locked": false,
      "text": "Question : on garde ces règles, avec chaque trop-perçu et chaque moins-perçu compté le mois\noù il est établi ?",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Question : on garde ces règles, avec chaque trop-perçu et chaque moins-perçu compté le mois\noù il est établi ?",
      "autoResize": true,
      "lineHeight": 1.25
    },
