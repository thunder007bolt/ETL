    {
      "id": "WOHIqLpGjcLIIVf5JMhB",
      "type": "text",
      "x": 960.2220650636492,
      "y": 12262.5,
      "width": 345.6,
      "height": 25.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
