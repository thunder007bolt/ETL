      "isDeleted": false,
      "boundElements": [],
      "updated": 1794914765618,
      "link": null,
      "locked": false,
      "text": "Chiffre : 11 rachats versés en 2024 dans la base, pour 21,5 M ; l'annuaire CNSS 2024 en\npublie 25,4 M, parmi les prestations des accidents du travail (tableau 90).",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Chiffre : 11 rachats versés en 2024 dans la base, pour 21,5 M ; l'annuaire CNSS 2024 en\npublie 25,4 M, parmi les prestations des accidents du travail (tableau 90).",
      "autoResize": true,
      "lineHeight": 1.25
    },
