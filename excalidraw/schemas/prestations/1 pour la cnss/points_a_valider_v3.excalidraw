      ],
      "frameId": null,
      "roundness": null,
      "seed": 1898006088,
      "version": 1,
      "versionNonce": 1235487895,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794914765618,
      "link": null,
      "locked": false,
      "text": "À qui : DPC",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "À qui : DPC",
