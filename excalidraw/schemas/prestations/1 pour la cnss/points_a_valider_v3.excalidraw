    {
      "id": "VEKOFbNezr6zQruOeRIp",
      "type": "text",
      "x": 960.2220650636492,
      "y": 15676.5,
      "width": 378.8,
      "height": 25.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
