      "x": 897.0,
      "y": 4802.5,
      "width": 782.72,
      "height": 40.0,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "0VluOhNa7Rc3Kty40Qqy"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1668724842,
      "version": 1,
      "versionNonce": 1676661941,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794914765618,
      "link": null,
      "locked": false,
      "text": "Question : on garde cette règle : une personne compte une seule fois par tableau, même avec\ndeux prestations du même tableau ?",
