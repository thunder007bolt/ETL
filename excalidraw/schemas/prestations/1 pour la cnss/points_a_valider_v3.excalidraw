      "type": "text",
      "x": 39.0,
      "y": 29208.5,
      "width": 794.24,
      "height": 40.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
