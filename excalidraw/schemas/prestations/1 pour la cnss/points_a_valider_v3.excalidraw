      "roundness": null,
      "seed": 932089982,
      "version": 1,
      "versionNonce": 12375907,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794914765618,
      "link": null,
      "locked": false,
      "text": "Objectif : dans T26, l'indicateur du délai des rentes doit partir d'une date qui existe pour\nchaque rente comptée. Il suit la rapidité de liquidation des rentes, par direction régionale\net par agence (recueil v7, l. 1170). La réponse permet de savoir s'il vise la rente de la\nvictime, mesurée depuis le certificat de consolidation, ou celle des survivants, mesurée\ndepuis leur demande.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Objectif : dans T26, l'indicateur du délai des rentes doit partir d'une date qui existe pour\nchaque rente comptée. Il suit la rapidité de liquidation des rentes, par direction régionale\net par agence (recueil v7, l. 1170). La réponse permet de savoir s'il vise la rente de la\nvictime, mesurée depuis le certificat de consolidation, ou celle des survivants, mesurée\ndepuis leur demande.",
      "autoResize": true,
      "lineHeight": 1.25
    },
