    {
      "id": "kgD0Sd8EdmuNHwWwuzL2",
      "type": "text",
      "x": 1834.968882602546,
      "y": 25652.5,
      "width": 457.0,
      "height": 25.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
