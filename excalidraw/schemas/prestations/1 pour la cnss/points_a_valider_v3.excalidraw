      "updated": 1794914765618,
      "link": null,
      "locked": false,
      "text": "À qui : DSI",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "À qui : DSI",
