    {
      "id": "QLcDVOcU6TxT0XZ2tnmy",
      "type": "text",
      "x": 1818.2220650636493,
      "y": 22692.5,
      "width": 234.4,
      "height": 25.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
