      "roundness": null,
      "seed": 1340458881,
      "version": 1,
      "versionNonce": 140006356,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794914765618,
      "link": null,
      "locked": false,
      "text": "Question : le taux de remplacement porte-t-il sur toutes les pensions directes en cours, ou\nseulement sur les nouvelles pensions de l'année ?",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Question : le taux de remplacement porte-t-il sur toutes les pensions directes en cours, ou\nseulement sur les nouvelles pensions de l'année ?",
      "autoResize": true,
      "lineHeight": 1.25
    },
