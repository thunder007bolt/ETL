    {
      "id": "cogjERBmq9TWdKsSFwpz",
      "type": "text",
      "x": 102.22206506364921,
      "y": 10444.5,
      "width": 250.0,
      "height": 25.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
