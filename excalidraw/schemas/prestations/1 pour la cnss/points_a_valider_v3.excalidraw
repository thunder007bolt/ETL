    {
      "id": "2UIXwB9DbDXxYDGR8T4u",
      "type": "text",
      "x": 104.25884016973126,
      "y": 4998.5,
      "width": 286.0,
      "height": 25.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
