      "versionNonce": 2123481148,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794914765618,
      "link": null,
      "locked": false,
      "text": "À qui : DCP ; DP et DR pour les rentes",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "À qui : DCP ; DP et DR pour les rentes",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "xtw3jd8QQejbAKj5R2Y6",
      "type": "text",
      "x": 39.0,
      "y": 4190.5,
      "width": 799.36,
      "height": 40.0,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "5B7ymRS7FFBSZyGXEgJV"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1119241588,
      "version": 1,
      "versionNonce": 1164661927,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794914765618,
      "link": null,
      "locked": false,
      "text": "Question : on garde la règle : un pensionné compte au 31/12 même s'il n'a pas été payé en fin\nd'année ?",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Question : on garde la règle : un pensionné compte au 31/12 même s'il n'a pas été payé en fin\nd'année ?",
      "autoResize": true,
      "lineHeight": 1.25
    },
