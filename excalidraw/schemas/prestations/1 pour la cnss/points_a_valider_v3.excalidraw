      "versionNonce": 2028685402,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794914765618,
      "link": null,
      "locked": false,
      "text": "À qui : DCP, avec la DSI",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "À qui : DCP, avec la DSI",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "miQL2vAhtKFOlBCmP3xT",
      "type": "text",
      "x": 1755.0,
      "y": 20146.5,
      "width": 732.8000000000001,
      "height": 40.0,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "u7Zk935ebidI1uZwNyxP"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 452842787,
      "version": 1,
      "versionNonce": 946598560,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794914765618,
      "link": null,
      "locked": false,
      "text": "Question : quand ce module existera, l'invalide converti comptera-t-il comme nouveau\nretraité dans T42 ?",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Question : quand ce module existera, l'invalide converti comptera-t-il comme nouveau\nretraité dans T42 ?",
      "autoResize": true,
      "lineHeight": 1.25
    },
