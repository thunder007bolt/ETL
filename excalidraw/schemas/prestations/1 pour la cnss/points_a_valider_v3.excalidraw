    {
      "id": "bkmADcjHyhKzlvHiqpK7",
      "type": "text",
      "x": 39.0,
      "y": 2342.5,
      "width": 782.72,
      "height": 40.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
