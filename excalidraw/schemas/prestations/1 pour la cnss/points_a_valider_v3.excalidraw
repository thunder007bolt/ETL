    {
      "id": "aa4kEjikih44VUeKRjnv",
      "type": "text",
      "x": 1813.0,
      "y": 4386.5,
      "width": 344.0,
      "height": 25.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
