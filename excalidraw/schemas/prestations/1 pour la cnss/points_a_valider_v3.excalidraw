    {
      "id": "oeUvZCW0h4GcoHIgtpZS",
      "type": "text",
      "x": 1832.932107496464,
      "y": 29160.5,
      "width": 337.40000000000003,
      "height": 25.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
