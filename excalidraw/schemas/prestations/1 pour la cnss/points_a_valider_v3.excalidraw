    {
      "id": "IShdeDPzYP7nHLnFx1jG",
      "type": "text",
      "x": 962.2588401697312,
      "y": 2956.5,
      "width": 278.40000000000003,
      "height": 25.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
