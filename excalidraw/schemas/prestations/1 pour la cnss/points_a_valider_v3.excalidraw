      "isDeleted": false,
      "boundElements": [],
      "updated": 1794914765618,
      "link": null,
      "locked": false,
      "text": "Question : pour T51, T52 et T53, on garde la personne dont la prestation est liquidée dans\nl'année, comme pour T50 et T54 ?",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Question : pour T51, T52 et T53, on garde la personne dont la prestation est liquidée dans\nl'année, comme pour T50 et T54 ?",
      "autoResize": true,
      "lineHeight": 1.25
    },
