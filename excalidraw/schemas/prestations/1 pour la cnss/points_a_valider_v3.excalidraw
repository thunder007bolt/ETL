    {
      "id": "qHLbbJpn1uTNDoIzfYzZ",
      "type": "text",
      "x": 102.22206506364921,
      "y": 26320.5,
      "width": 264.0,
      "height": 25.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
