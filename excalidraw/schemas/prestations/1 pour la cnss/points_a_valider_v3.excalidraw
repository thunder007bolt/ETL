      "versionNonce": 1282882423,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794914765618,
      "link": null,
      "locked": false,
      "text": "C'est quoi : T45 compte les nouveaux rentiers ; le recueil dit « Nouveaux crédirentiers :\nrentiers ».",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "C'est quoi : T45 compte les nouveaux rentiers ; le recueil dit « Nouveaux crédirentiers :\nrentiers ».",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "uVdYHvr6g8C18WDyvjnl",
      "type": "text",
      "x": 897.0,
      "y": 20438.5,
      "width": 794.5600000000001,
      "height": 100.0,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
