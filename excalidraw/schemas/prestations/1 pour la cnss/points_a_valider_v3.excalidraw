    {
      "id": "J6JfVWDKl9QXUFTJwnwo",
      "type": "text",
      "x": 1818.2220650636493,
      "y": 9250.5,
      "width": 354.40000000000003,
      "height": 25.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "Urobto3JA5LIMIyNWWNE"
      ],
      "frameId": null,
