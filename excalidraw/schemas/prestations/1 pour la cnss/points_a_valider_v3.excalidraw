    {
      "id": "R5Y9Hk8VY3TNEamc3va0",
      "type": "text",
      "x": 1755.0,
      "y": 14026.5,
      "width": 791.0400000000001,
      "height": 60.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
