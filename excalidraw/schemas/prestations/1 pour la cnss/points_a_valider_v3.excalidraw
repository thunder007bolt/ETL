      "id": "wSpIxU4JvCOaTUols70a",
      "type": "text",
      "x": 897.0,
      "y": 25904.5,
      "width": 101.76,
      "height": 20.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "OlBByw9l57ouv9aENFWd"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 403445202,
      "version": 1,
      "versionNonce": 152465708,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794914765618,
      "link": null,
      "locked": false,
      "text": "À qui : DPC",
      "fontSize": 16,
      "fontFamily": 5,
