    {
      "id": "Iao9ugg4SdTRJ0SYbktH",
      "type": "text",
      "x": 1818.2220650636493,
      "y": 23304.5,
      "width": 311.6,
      "height": 25.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
