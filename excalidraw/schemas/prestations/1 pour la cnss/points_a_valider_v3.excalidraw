    {
      "id": "gzg2sye9b2Rann76dEyT",
      "type": "text",
      "x": 45,
      "y": 144,
      "width": 2491.7400000000002,
      "height": 90.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
