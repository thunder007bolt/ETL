      "versionNonce": 1684290356,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794914765618,
      "link": null,
      "locked": false,
      "text": "Aujourd'hui : on calcule sur la copie de la base du 02/02/2026. Si la réponse est oui, on\ncalculera chaque année sur la copie de la base arrêtée fin mars de l'année suivante.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Aujourd'hui : on calcule sur la copie de la base du 02/02/2026. Si la réponse est oui, on\ncalculera chaque année sur la copie de la base arrêtée fin mars de l'année suivante.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
