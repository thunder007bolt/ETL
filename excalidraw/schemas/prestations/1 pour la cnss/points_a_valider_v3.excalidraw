    {
      "id": "ta6eSfn0uzxoLRCBVyei",
      "type": "text",
      "x": 116.93210749646394,
      "y": 29692.5,
      "width": 246.8,
      "height": 25.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
