      "versionNonce": 301303457,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794914765618,
      "link": null,
      "locked": false,
      "text": "À qui : DES et DR",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "À qui : DES et DR",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "daUNYNo6Hb9tWhh6EZXj",
      "type": "text",
      "x": 897.0,
      "y": 9646.5,
      "width": 745.6,
      "height": 20.0,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
