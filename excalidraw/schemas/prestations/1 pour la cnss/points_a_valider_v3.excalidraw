    {
      "id": "bGQnZKo5wLOsU4GVQtOV",
      "type": "text",
      "x": 118.96888260254597,
      "y": 28588.5,
      "width": 303.0,
      "height": 25.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
