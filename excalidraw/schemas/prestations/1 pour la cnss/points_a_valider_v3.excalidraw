      "versionNonce": 1568356703,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794914765618,
      "link": null,
      "locked": false,
      "text": "Dans la base : les paiements des enfants comptés : DEBOURS, DEB_TYPE = PM,\nDEB_STATUT D ou P, montant DEB_MONTANT.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Dans la base : les paiements des enfants comptés : DEBOURS, DEB_TYPE = PM,\nDEB_STATUT D ou P, montant DEB_MONTANT.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "ltuLT6R5EdmRkQ42tXJe",
      "type": "text",
      "x": 39.0,
      "y": 15908.5,
      "width": 568.0,
      "height": 20.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
