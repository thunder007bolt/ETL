      "versionNonce": 2015706796,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794914765618,
      "link": null,
      "locked": false,
      "text": "Question : au-delà de combien de mois cotisés un assuré a-t-il droit à une pension plutôt qu'à\nune allocation de vieillesse ?",
