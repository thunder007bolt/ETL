      "link": null,
      "locked": false,
      "text": "Les moins-perçus sont montrés à part et n'entrent pas dans le taux d'indus. Le taux des deux\nensemble est affiché à côté.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Les moins-perçus sont montrés à part et n'entrent pas dans le taux d'indus. Le taux des deux\nensemble est affiché à côté.",
      "autoResize": true,
      "lineHeight": 1.25
