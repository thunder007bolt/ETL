      "text": "T31 — Les prestations payées et les indus, par branche et par mois : les règles de la BI",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "T31 — Les prestations payées et les indus, par branche et par mois : les règles de la BI",
      "autoResize": true,
