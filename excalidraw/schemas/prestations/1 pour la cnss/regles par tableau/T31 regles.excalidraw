      "boundElements": [],
      "updated": 1794756642047,
      "link": null,
      "locked": false,
      "text": "Avec ces règles, en 2024 : 684 trop-perçus pour 229,5 M, sur 58,73 Md payés : taux d'indus 0,39 % (pensions 0,47 %, accidents du travail 0,47 %, prestations familiales 0,045 %), sous la norme de 2 % ; moins-perçus : 414,4 M.\nL'annuaire CNSS 2024 ne publie pas d'indus ; nos payées sont à −0,26 % de ses prestations servies (58,88 Md), mais par compensation : pensions +1,3 %, prestations familiales −3,8 %, accidents du travail −20,3 %.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Avec ces règles, en 2024 : 684 trop-perçus pour 229,5 M, sur 58,73 Md payés : taux d'indus 0,39 % (pensions 0,47 %, accidents du travail 0,47 %, prestations familiales 0,045 %), sous la norme de 2 % ; moins-perçus : 414,4 M.\nL'annuaire CNSS 2024 ne publie pas d'indus ; nos payées sont à −0,26 % de ses prestations servies (58,88 Md), mais par compensation : pensions +1,3 %, prestations familiales −3,8 %, accidents du travail −20,3 %.",
      "autoResize": true,
      "lineHeight": 1.25
    }
