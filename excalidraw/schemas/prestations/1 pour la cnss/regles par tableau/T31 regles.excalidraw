      "boundElements": [],
      "updated": 1794756642047,
      "link": null,
      "locked": false,
      "text": "Un moins-perçu est une somme payée en moins, rattrapée par un rappel : un moins-perçu\nordinaire ou un rappel sur convention entre caisses. Il compte le mois où il est établi, comme\nle trop-perçu.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Un moins-perçu est une somme payée en moins, rattrapée par un rappel : un moins-perçu\nordinaire ou un rappel sur convention entre caisses. Il compte le mois où il est établi, comme\nle trop-perçu.",
      "autoResize": true,
      "lineHeight": 1.25
    },
