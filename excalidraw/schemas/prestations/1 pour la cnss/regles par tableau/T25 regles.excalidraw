      "boundElements": [],
      "updated": 1794756641922,
      "link": null,
      "locked": false,
      "text": "Délai de liquidation (indicateur) : moyenne, écart type et part liquidée en 45 jours au plus,\nsur toutes les demandes liquidées. Norme : une moyenne de moins de 45 jours. Chaque\nindicateur qui a une norme porte la mention « dans les normes » ou « hors normes ».",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Délai de liquidation (indicateur) : moyenne, écart type et part liquidée en 45 jours au plus,\nsur toutes les demandes liquidées. Norme : une moyenne de moins de 45 jours. Chaque\nindicateur qui a une norme porte la mention « dans les normes » ou « hors normes ».",
      "autoResize": true,
      "lineHeight": 1.25
    },
