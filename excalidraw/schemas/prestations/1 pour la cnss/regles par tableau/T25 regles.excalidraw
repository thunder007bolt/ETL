      "boundElements": [],
      "updated": 1794756641922,
      "link": null,
      "locked": false,
      "text": "La réversion (la pension du défunt reprise par sa veuve ou ses orphelins) est une demande à\npart, sur la ligne des survivants, qu'elle soit dans un nouveau dossier ou dans celui du défunt.\nUne veuve et ses orphelins notifiés ensemble font une seule demande.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "La réversion (la pension du défunt reprise par sa veuve ou ses orphelins) est une demande à\npart, sur la ligne des survivants, qu'elle soit dans un nouveau dossier ou dans celui du défunt.\nUne veuve et ses orphelins notifiés ensemble font une seule demande.",
      "autoResize": true,
      "lineHeight": 1.25
    },
