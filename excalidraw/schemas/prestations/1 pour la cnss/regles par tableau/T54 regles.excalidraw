      "text": "T54 — Les indemnités de maternité sur cinq ans : les règles de la BI",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "T54 — Les indemnités de maternité sur cinq ans : les règles de la BI",
