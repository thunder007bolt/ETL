      "link": null,
      "locked": false,
      "text": "DTM_CONTROLE_PRESTATION compte les payés parmi les seuls contrôlés ;\nDTM_INDICATEURS_PRESTATIONS calcule le taux sur les ajustements.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "DTM_CONTROLE_PRESTATION compte les payés parmi les seuls contrôlés ;\nDTM_INDICATEURS_PRESTATIONS calcule le taux sur les ajustements.",
      "autoResize": true,
      "lineHeight": 1.25
    },
