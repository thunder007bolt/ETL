      "isDeleted": false,
      "boundElements": [],
      "updated": 1794179732502,
      "link": null,
      "locked": false,
      "text": "L'annuaire ne publie ni contrôles a posteriori ni indus. Il sert à contrôler les payées (tableaux 28 à 34, 40 à 46, 82, 90 à 99, 106) et à voir comment la CNSS compte ses bénéficiaires (24, 35, 37, 39). Les tableaux 11, 100 à 102 et 107 à\n113 parlent d'autres contrôles et d'autres paiements.",
      "fontSize": 19,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "L'annuaire ne publie ni contrôles a posteriori ni indus. Il sert à contrôler les payées (tableaux 28 à 34, 40 à 46, 82, 90 à 99, 106) et à voir comment la CNSS compte ses bénéficiaires (24, 35, 37, 39). Les tableaux 11, 100 à 102 et 107 à\n113 parlent d'autres contrôles et d'autres paiements.",
      "autoResize": true,
      "lineHeight": 1.25
    },
