      "isDeleted": false,
      "boundElements": [],
      "updated": 1794179732502,
      "link": null,
      "locked": false,
      "text": "• Dans la base : indus 2024 = 0,39 % des sommes payées, sous la norme dans toutes les lectures ; contrôles 2025 = 0,07 % (115 pour 155 206 dossiers payés), loin des 5 %, plus rien depuis le 09/07/2025.",
      "fontSize": 21,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "• Dans la base : indus 2024 = 0,39 % des sommes payées, sous la norme dans toutes les lectures ; contrôles 2025 = 0,07 % (115 pour 155 206 dossiers payés), loin des 5 %, plus rien depuis le 09/07/2025.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "Xop3peUC1z7xqavVITiG",
      "type": "text",
      "x": 22,
      "y": 504.75,
      "width": 2485.77,
      "height": 52.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "njS4DX3JDMmsFLgAE8zg"
      ],
      "frameId": null,
