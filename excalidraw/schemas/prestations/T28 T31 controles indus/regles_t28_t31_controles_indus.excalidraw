    {
      "id": "MaqiQK3pK1v2fabE7fIY",
      "type": "text",
      "x": 47,
      "y": 10410.5,
      "width": 2451.9500000000003,
      "height": 47.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
