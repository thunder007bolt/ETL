    {
      "id": "J1hsYMsHzpSY3hZZM08q",
      "type": "text",
      "x": 47,
      "y": 1435.25,
      "width": 2481.0200000000004,
      "height": 71.25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
