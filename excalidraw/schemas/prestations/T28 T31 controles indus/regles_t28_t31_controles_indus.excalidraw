    {
      "id": "V30uCXZP9IPKqUMajNbq",
      "type": "text",
      "x": 0,
      "y": 66,
      "width": 2552.88,
      "height": 82.5,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
