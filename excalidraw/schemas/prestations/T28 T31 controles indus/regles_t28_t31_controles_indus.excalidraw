      "boundElements": [],
      "updated": 1794179732502,
      "link": null,
      "locked": false,
      "text": "Au moins un paiement dans la période : PM en général, RB pour les soins,\najustement RR pour le rachat. Une fois par ligne, une fois au TOTAL.\nCoordination payée ailleurs exclue.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Au moins un paiement dans la période : PM en général, RB pour les soins,\najustement RR pour le rachat. Une fois par ligne, une fois au TOTAL.\nCoordination payée ailleurs exclue.",
      "autoResize": true,
      "lineHeight": 1.25
    },
