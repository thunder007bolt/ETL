    {
      "id": "aNpM46OXLAQc7D5KG4Bm",
      "type": "text",
      "x": 47,
      "y": 12791.25,
      "width": 2433.5200000000004,
      "height": 47.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
