    {
      "id": "IL6uD6njPeu5HVWkhSFQ",
      "type": "text",
      "x": 47,
      "y": 1460.5,
      "width": 2504.7700000000004,
      "height": 71.25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
