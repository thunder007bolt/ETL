    {
      "id": "b8PK4b9NhE1ZZTlMqfUK",
      "type": "text",
      "x": 47,
      "y": 11253.5,
      "width": 2478.17,
      "height": 71.25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
