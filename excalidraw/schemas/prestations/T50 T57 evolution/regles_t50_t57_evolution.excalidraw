      "isDeleted": false,
      "boundElements": [],
      "updated": 1794179733010,
      "link": null,
      "locked": false,
      "text": "L'annuaire ne publie pas les effectifs de T51, T52, T53 et T55, ni les services passés, ni le sexe, ni les décès d'allocataires. Il contrôle les effectifs de T50 et T54, les montants de 2024 par prestation, les montants AT/MP et par\nbranche sur cinq ans, les décès de pensionnés et de rentiers.",
      "fontSize": 19,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "L'annuaire ne publie pas les effectifs de T51, T52, T53 et T55, ni les services passés, ni le sexe, ni les décès d'allocataires. Il contrôle les effectifs de T50 et T54, les montants de 2024 par prestation, les montants AT/MP et par\nbranche sur cinq ans, les décès de pensionnés et de rentiers.",
      "autoResize": true,
      "lineHeight": 1.25
    },
