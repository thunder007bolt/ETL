      "text": "T29 — Les dossiers d'accident du travail payés et contrôlés a posteriori : les règles de la BI",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "T29 — Les dossiers d'accident du travail payés et contrôlés a posteriori : les règles de la BI",
      "autoResize": true,
