      "text": "Les indemnités journalières sont versées sur quelques mois : on compte le dossier payé dans\nla période, pas celui liquidé.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Les indemnités journalières sont versées sur quelques mois : on compte le dossier payé dans\nla période, pas celui liquidé.",
      "autoResize": true,
      "lineHeight": 1.25
    },
