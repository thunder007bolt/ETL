    },
    {
      "id": "4ExMaIWYiHaFUX1m1s97",
      "type": "text",
      "x": 0,
      "y": 64,
      "width": 2489.0,
      "height": 75.0,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 433083567,
      "version": 1,
      "versionNonce": 958330197,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794756642005,
      "link": null,
      "locked": false,
      "text": "T29 compte, par type de prestation des accidents du travail et maladies professionnelles, les dossiers payés et les dossiers vérifiés par la DAI après le paiement (contrôlés a posteriori), trimestre par trimestre, avec le taux de\ncontrôle : 5 % au moins.\nVoici chaque règle appliquée et le champ de la base qui la porte. Une remarque ? Écrivez-la dans la dernière colonne. En orange : règle encore en question (n° du point à valider).",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "T29 compte, par type de prestation des accidents du travail et maladies professionnelles, les dossiers payés et les dossiers vérifiés par la DAI après le paiement (contrôlés a posteriori), trimestre par trimestre, avec le taux de\ncontrôle : 5 % au moins.\nVoici chaque règle appliquée et le champ de la base qui la porte. Une remarque ? Écrivez-la dans la dernière colonne. En orange : règle encore en question (n° du point à valider).",
      "autoResize": true,
      "lineHeight": 1.25
    },
