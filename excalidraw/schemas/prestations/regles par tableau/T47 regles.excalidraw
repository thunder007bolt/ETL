    {
      "id": "vhHV62jwFi8JBQfwATgo",
      "type": "text",
      "x": 86,
      "y": 368.0,
      "width": 1016.8000000000001,
      "height": 50.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
