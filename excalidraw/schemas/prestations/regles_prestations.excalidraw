      "boundElements": [],
      "updated": 1793390559696,
      "link": null,
      "locked": false,
      "text": "Pension en cours au 31/12 (effet avant, ni radiée ni suspendue), ayant droit en\nvie, payée ou non. Orphelins de moins de 25 ans. Une personne comptée une fois.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Pension en cours au 31/12 (effet avant, ni radiée ni suspendue), ayant droit en\nvie, payée ou non. Orphelins de moins de 25 ans. Une personne comptée une fois.",
      "autoResize": true,
      "lineHeight": 1.25
    },
