      "boundElements": [],
      "updated": 1793362274996,
      "link": null,
      "locked": false,
      "text": "Ils ne sont notés que dans le module des rejets, avec un motif codé, et rarement.\nNi le statut de la réception ni la fermeture du dossier ne valent refus.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Ils ne sont notés que dans le module des rejets, avec un motif codé, et rarement.\nNi le statut de la réception ni la fermeture du dossier ne valent refus.",
      "autoResize": true,
      "lineHeight": 1.25
    },
