      "roundness": null,
      "seed": 832450470,
      "version": 1,
      "versionNonce": 320489103,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793544333071,
      "link": null,
      "locked": false,
      "text": "La déclaration (NOUVEAU) est le dépôt de la première demande du dossier. Une\nréception ANCIEN avec un certificat de consolidation est le dépôt de la rente ou\nde l'allocation ; avec un certificat de décès, celui des rentes de survivants,\ncomme la réversion de T25.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "La déclaration (NOUVEAU) est le dépôt de la première demande du dossier. Une\nréception ANCIEN avec un certificat de consolidation est le dépôt de la rente ou\nde l'allocation ; avec un certificat de décès, celui des rentes de survivants,\ncomme la réversion de T25.",
      "autoResize": true,
      "lineHeight": 1.25
    },
