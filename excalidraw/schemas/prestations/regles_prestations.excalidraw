      "boundElements": [],
      "updated": 1793362274996,
      "link": null,
      "locked": false,
      "text": "D = payé par un effet décaissé ; P = payé sans effet, par un autre circuit ; V =\nvalidé mais pas décaissé ; N, A, S = jamais approuvés.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "D = payé par un effet décaissé ; P = payé sans effet, par un autre circuit ; V =\nvalidé mais pas décaissé ; N, A, S = jamais approuvés.",
      "autoResize": true,
      "lineHeight": 1.25
    },
