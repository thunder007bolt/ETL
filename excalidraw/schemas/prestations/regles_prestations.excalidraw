      "seed": 73434063,
      "version": 1,
      "versionNonce": 1001911994,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793390559696,
      "link": null,
      "locked": false,
      "text": "Les règles R1 à R12 viennent des lots 1 et 2 ; les règles D1 à D8 viennent de la fiche T25 et du lot 3 B et remplacent R10 à R12 pour les dossiers ; D9 à D14 viennent du lot 4 (T26 et T27). R1 à R7 ont été confrontées le 30/10 à l'annuaire statistique de\nla CNSS 2024.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Les règles R1 à R12 viennent des lots 1 et 2 ; les règles D1 à D8 viennent de la fiche T25 et du lot 3 B et remplacent R10 à R12 pour les dossiers ; D9 à D14 viennent du lot 4 (T26 et T27). R1 à R7 ont été confrontées le 30/10 à l'annuaire statistique de\nla CNSS 2024.",
      "autoResize": true,
      "lineHeight": 1.25
    },
