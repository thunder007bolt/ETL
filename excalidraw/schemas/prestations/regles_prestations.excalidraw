      "versionNonce": 347568108,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793544333071,
      "link": null,
      "locked": false,
      "text": "Preuve : IJ de 2025 : arrêt de 27 j en médiane, notifiée 211 j après la fin de l'arrêt et\n183 j après la déclaration ; certificat de guérison saisi pour 14 IJ sur 226",
      "fontSize": 16,
