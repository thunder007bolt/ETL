      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "hatjlMK6BLyMuzFfYxIb"
      ],
      "frameId": null,
