      "isDeleted": false,
      "boundElements": [],
      "updated": 1793544333071,
      "link": null,
      "locked": false,
      "text": "Preuve : 4 158 dossiers sur 9 106 ouverts de 2019 à 2025 ; 35 à 53 % chaque année de 2019\nà 2024 ; 0 à 7 rejets par an",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Preuve : 4 158 dossiers sur 9 106 ouverts de 2019 à 2025 ; 35 à 53 % chaque année de 2019\nà 2024 ; 0 à 7 rejets par an",
      "autoResize": true,
      "lineHeight": 1.25
    },
