    {
      "id": "fwqFxDhUh6FvyH9qvVyj",
      "type": "text",
      "x": 901.0,
      "y": 5864.5,
      "width": 767.1600000000001,
      "height": 67.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "K5gCzxDUhGxWinMlOY9C"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 2055219484,
      "version": 1,
      "versionNonce": 663675583,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793390559696,
      "link": null,
      "locked": false,
      "text": "Les soins vont en « autres prestations de la branche ». Un dossier y compte une\nfois, liquidé à la saisie de son premier remboursement (pas à son approbation,\nremplie en bloc en 2024 pour les vieux dossiers).",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Les soins vont en « autres prestations de la branche ». Un dossier y compte une\nfois, liquidé à la saisie de son premier remboursement (pas à son approbation,\nremplie en bloc en 2024 pour les vieux dossiers).",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "CUTj0xbtpe4SgBVESNaA",
      "type": "text",
      "x": 901.0,
      "y": 5944.0,
      "width": 786.24,
      "height": 40.0,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "K5gCzxDUhGxWinMlOY9C"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1421311308,
      "version": 1,
      "versionNonce": 1182793687,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793390559696,
      "link": null,
      "locked": false,
      "text": "Preuve : 650 à 960 dossiers par an, 3 à 5 mois après la déclaration ; saisie et approbation\nà moins de 10 j d'écart dans le flux normal",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Preuve : 650 à 960 dossiers par an, 3 à 5 mois après la déclaration ; saisie et approbation\nà moins de 10 j d'écart dans le flux normal",
      "autoResize": true,
      "lineHeight": 1.25
    },
