      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "AHOmpod7hskgJ23FgGyC"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1564325261,
      "version": 1,
      "versionNonce": 250375734,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793390559696,
      "link": null,
      "locked": false,
      "text": "Preuve : 13 104 des 25 541 pensions de veuve sont dans le dossier du défunt ; une seconde\nnotification arrive en médiane 9 ans après la première",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
