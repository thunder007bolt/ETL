    {
      "id": "UYyV6QpX5P0uvkF46LGY",
      "type": "text",
      "x": 1759.0,
      "y": 5492.5,
      "width": 793.08,
      "height": 90.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
