      "frameId": null,
      "roundness": null,
      "seed": 1706041018,
      "version": 1,
      "versionNonce": 2131629882,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793390559696,
      "link": null,
      "locked": false,
      "text": "Preuve : après une consolidation, 91 % des réceptions sont suivies d'une rente ou d'une\nallocation ; durée médiane 2025 depuis cette réception : 13 à 35 j",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Preuve : après une consolidation, 91 % des réceptions sont suivies d'une rente ou d'une\nallocation ; durée médiane 2025 depuis cette réception : 13 à 35 j",
      "autoResize": true,
      "lineHeight": 1.25
    },
