    {
      "id": "FLeS2twaHDxT2JiPCq1N",
      "type": "text",
      "x": 1759.0,
      "y": 4732.0,
      "width": 771.3000000000001,
      "height": 67.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "hatjlMK6BLyMuzFfYxIb"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1822564118,
      "version": 1,
      "versionNonce": 572916745,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793544333071,
      "link": null,
      "locked": false,
      "text": "L'arrêt de travail dure un mois, mais l'IJ est notifiée environ 7 mois après sa\nfin. La base ne dit pas pourquoi : la reprise du travail n'est jamais saisie, le\ncertificat de guérison presque jamais.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "L'arrêt de travail dure un mois, mais l'IJ est notifiée environ 7 mois après sa\nfin. La base ne dit pas pourquoi : la reprise du travail n'est jamais saisie, le\ncertificat de guérison presque jamais.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
