      "link": null,
      "locked": false,
      "text": "Une mère a un dossier par grossesse, déposé 3 semaines avant l'accouchement. Il\nporte l'IJ et l'allocation prénatale, notifiées ensemble.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Une mère a un dossier par grossesse, déposé 3 semaines avant l'accouchement. Il\nporte l'IJ et l'allocation prénatale, notifiées ensemble.",
      "autoResize": true,
      "lineHeight": 1.25
    },
