      "link": null,
      "locked": false,
      "text": "Les anciens dossiers n'ont pas de lien vers leur réception. Environ 8 000\nvieilles pensions radiées n'ont pas de date de notification. La date de\nnotification du dossier est toujours vide.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Les anciens dossiers n'ont pas de lien vers leur réception. Environ 8 000\nvieilles pensions radiées n'ont pas de date de notification. La date de\nnotification du dossier est toujours vide.",
      "autoResize": true,
      "lineHeight": 1.25
    },
