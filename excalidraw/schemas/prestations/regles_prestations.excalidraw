    {
      "id": "8me6K4MK7TLx8gGCcoGO",
      "type": "text",
      "x": 901.0,
      "y": 3630.0,
      "width": 789.4800000000001,
      "height": 67.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
