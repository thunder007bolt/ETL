      "text": "Un paiement = un débours de type PM au statut D ou P. Son montant est celui du\ndébours, jamais le net à payer de l'effet.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Un paiement = un débours de type PM au statut D ou P. Son montant est celui du\ndébours, jamais le net à payer de l'effet.",
      "autoResize": true,
      "lineHeight": 1.25
    },
