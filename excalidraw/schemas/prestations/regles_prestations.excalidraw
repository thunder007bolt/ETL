    {
      "id": "HRNxHJqEM7KmySStobO3",
      "type": "text",
      "x": 43.0,
      "y": 5049.5,
      "width": 782.6400000000001,
      "height": 67.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "GRh4kTEyZ4mZP94u5HxQ"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1966310003,
      "version": 1,
      "versionNonce": 1287008200,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793544333071,
      "link": null,
      "locked": false,
      "text": "Une réception ANCIEN sur un dossier AT/MP est une demande de rente ou\nd'allocation, ou de rente de survivant. Les autres portent des pièces de maintien\ndes droits (certificat de vie, de scolarité).",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Une réception ANCIEN sur un dossier AT/MP est une demande de rente ou\nd'allocation, ou de rente de survivant. Les autres portent des pièces de maintien\ndes droits (certificat de vie, de scolarité).",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "VFuM20ZfgFTBtdzZxfUI",
      "type": "text",
      "x": 43.0,
      "y": 5129.0,
      "width": 764.1600000000001,
      "height": 40.0,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "GRh4kTEyZ4mZP94u5HxQ"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1365422645,
      "version": 1,
      "versionNonce": 1776758995,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793544333071,
      "link": null,
      "locked": false,
      "text": "Preuve : 1 097 réceptions de 2019 à 2025 : 70 % suivies d'une rente ou d'une allocation\ndans l'année, 9 % d'une rente de survivant, 18 % de rien",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Preuve : 1 097 réceptions de 2019 à 2025 : 70 % suivies d'une rente ou d'une allocation\ndans l'année, 9 % d'une rente de survivant, 18 % de rien",
      "autoResize": true,
      "lineHeight": 1.25
    },
