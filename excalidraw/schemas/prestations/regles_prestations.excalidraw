      "seed": 116434439,
      "version": 1,
      "versionNonce": 1031235301,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793390559696,
      "link": null,
      "locked": false,
      "text": "Les soins se remboursent en 8 à 10 fois par dossier, sans passer par le guichet ;\nplus de la moitié des dossiers soignés n'ont rien d'autre. Les dates d'approbation\ndes vieux remboursements ont été remplies en bloc en 2024.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Les soins se remboursent en 8 à 10 fois par dossier, sans passer par le guichet ;\nplus de la moitié des dossiers soignés n'ont rien d'autre. Les dates d'approbation\ndes vieux remboursements ont été remplies en bloc en 2024.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "FG43yDNJbWH6Srb59Um9",
      "type": "text",
      "x": 901.0,
      "y": 3709.5,
      "width": 750.88,
      "height": 40.0,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "6OxF1g4IuoO2ukVjvllP"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1428443055,
      "version": 1,
      "versionNonce": 99190931,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793390559696,
      "link": null,
      "locked": false,
      "text": "Preuve : 650 à 960 dossiers par an ; en 2024, 973 vieux dossiers saisis depuis 2005 ;\naucune facture ni ordonnance reçue au guichet",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Preuve : 650 à 960 dossiers par an ; en 2024, 973 vieux dossiers saisis depuis 2005 ;\naucune facture ni ordonnance reçue au guichet",
      "autoResize": true,
      "lineHeight": 1.25
    },
