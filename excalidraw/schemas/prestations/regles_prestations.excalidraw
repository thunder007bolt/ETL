      "link": null,
      "locked": false,
      "text": "V = pensions (PVID), A = accidents du travail et maladies professionnelles, F =\nprestations familiales, M = maternité, rattachée aux prestations familiales.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "V = pensions (PVID), A = accidents du travail et maladies professionnelles, F =\nprestations familiales, M = maternité, rattachée aux prestations familiales.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "RY22d3NcqHIGWYqyzU0R",
      "type": "text",
      "x": 901.0,
      "y": 2656.5,
      "width": 769.2800000000001,
      "height": 20.0,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "5meGoqsbTpB7eqJB3Aph"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 223160300,
      "version": 1,
      "versionNonce": 1590547362,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793544333071,
      "link": null,
      "locked": false,
      "text": "Preuve : aucune prestation en nature en M : M n'est pas « maladie », comme le dit le DTM",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Preuve : aucune prestation en nature en M : M n'est pas « maladie », comme le dit le DTM",
      "autoResize": true,
      "lineHeight": 1.25
    },
