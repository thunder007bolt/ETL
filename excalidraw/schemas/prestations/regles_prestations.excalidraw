      "text": "V = pensions (PVID), A = accidents du travail et maladies professionnelles, F =\nprestations familiales, M = maternité, rattachée aux prestations familiales.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "V = pensions (PVID), A = accidents du travail et maladies professionnelles, F =\nprestations familiales, M = maternité, rattachée aux prestations familiales.",
      "autoResize": true,
      "lineHeight": 1.25
    },
