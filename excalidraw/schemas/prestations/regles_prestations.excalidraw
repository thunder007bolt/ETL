      "isDeleted": false,
      "boundElements": [],
      "updated": 1793544333071,
      "link": null,
      "locked": false,
      "text": "Preuve : après une consolidation, 91 % des réceptions sont suivies d'une rente ou d'une\nallocation ; durée médiane 2025 depuis cette réception : 13 à 35 j",
      "fontSize": 16,
      "fontFamily": 5,
