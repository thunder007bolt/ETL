    {
      "id": "7kfwqFxDhUh6FvyH9qvV",
      "type": "text",
      "x": 1759.0,
      "y": 6277.0,
      "width": 793.08,
      "height": 90.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
