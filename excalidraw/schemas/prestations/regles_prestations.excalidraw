      "version": 1,
      "versionNonce": 1080682443,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793362274996,
      "link": null,
      "locked": false,
      "text": "Preuve : 13 104 des 25 541 pensions de veuve sont dans le dossier du défunt ; une seconde\nnotification arrive en médiane 9 ans après la première",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Preuve : 13 104 des 25 541 pensions de veuve sont dans le dossier du défunt ; une seconde\nnotification arrive en médiane 9 ans après la première",
      "autoResize": true,
      "lineHeight": 1.25
    },
