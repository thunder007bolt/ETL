      "seed": 41421575,
      "version": 1,
      "versionNonce": 615628327,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793362274996,
      "link": null,
      "locked": false,
      "text": "Quand un pensionné décède, la pension de sa veuve et de ses orphelins est ajoutée\nà son dossier. Un assuré mort avant sa retraite laisse sans doute un nouveau\ndossier de survivants.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Quand un pensionné décède, la pension de sa veuve et de ses orphelins est ajoutée\nà son dossier. Un assuré mort avant sa retraite laisse sans doute un nouveau\ndossier de survivants.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "yDPVAHOmpod7hskgJ23F",
      "type": "text",
      "x": 1759.0,
      "y": 2347.0,
      "width": 771.5200000000001,
      "height": 40.0,
