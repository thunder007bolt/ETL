    {
      "id": "uSCFqTFiX9S4eicHocsd",
      "type": "text",
      "x": 45,
      "y": 174,
      "width": 1209.96,
      "height": 135.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "tcl3stlNMUpWR6ekmCii"
      ],
