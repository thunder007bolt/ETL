    {
      "id": "dnKQlg01AYrmOtewoP9e",
      "type": "text",
      "x": 1759.0,
      "y": 2267.5,
      "width": 782.6400000000001,
      "height": 67.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
