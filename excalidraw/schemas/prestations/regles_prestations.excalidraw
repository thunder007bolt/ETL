      "seed": 1615446336,
      "version": 1,
      "versionNonce": 1128560910,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793362274996,
      "link": null,
      "locked": false,
      "text": "Une réception au guichet = un dépôt. NOUVEAU va à la demande du dossier qu'elle\nouvre, ANCIEN à la réversion du dossier visé. Une réversion non enregistrée au\nguichet prend la date de demande de sa pension.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Une réception au guichet = un dépôt. NOUVEAU va à la demande du dossier qu'elle\nouvre, ANCIEN à la réversion du dossier visé. Une réversion non enregistrée au\nguichet prend la date de demande de sa pension.",
      "autoResize": true,
      "lineHeight": 1.25
    },
