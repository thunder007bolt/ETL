      "isDeleted": false,
      "boundElements": [],
      "updated": 1793544333071,
      "link": null,
      "locked": false,
      "text": "Preuve : 99,4 % des dossiers ont les deux ; notification 16 j après la réception en 2025 ; 9\nmères seulement ont deux dossiers dans l'année",
