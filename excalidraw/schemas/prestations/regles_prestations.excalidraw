    {
      "id": "g3l7YNOYT40vWNDKXAkX",
      "type": "text",
      "x": 1759.0,
      "y": 5598.0,
      "width": 786.0600000000001,
      "height": 67.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "7zBcOw6uB9o1BftghGoG"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1844846300,
      "version": 1,
      "versionNonce": 2111626072,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793544333071,
      "link": null,
      "locked": false,
      "text": "Une réception au guichet = un dépôt. NOUVEAU va à la demande du dossier qu'elle\nouvre, ANCIEN à la réversion du dossier visé. Une réversion non enregistrée au\nguichet prend la date de demande de sa pension.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Une réception au guichet = un dépôt. NOUVEAU va à la demande du dossier qu'elle\nouvre, ANCIEN à la réversion du dossier visé. Une réversion non enregistrée au\nguichet prend la date de demande de sa pension.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "DtKcidTLZUpD5faR5Ywo",
      "type": "text",
      "x": 1759.0,
      "y": 5677.5,
      "width": 720.48,
      "height": 40.0,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "7zBcOw6uB9o1BftghGoG"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 722083200,
      "version": 1,
      "versionNonce": 305668167,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793544333071,
      "link": null,
      "locked": false,
      "text": "Preuve : 4 671 réceptions de pension en 2025 : 4 055 NOUVEAU, 616 ANCIEN ; une\nréception n'ouvre qu'un dossier, sauf 11",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
