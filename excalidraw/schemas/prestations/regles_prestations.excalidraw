    },
    {
      "id": "LqpdAu6H2Nxdx6I8ZYi7",
      "type": "text",
      "x": 901.0,
      "y": 7827.0,
      "width": 766.6200000000001,
      "height": 67.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "rT7q6VH4rm5QBYaUX9l8"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 896729453,
      "version": 1,
      "versionNonce": 552333106,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793544333071,
      "link": null,
      "locked": false,
      "text": "Pension en cours au 31/12 (effet avant, ni radiée ni suspendue), ayant droit en\nvie, payée ou non. Orphelins de moins de 25 ans. Une personne comptée une fois.\nT41 : l'enfant de 21 ans au plus, payé dans l'année.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Pension en cours au 31/12 (effet avant, ni radiée ni suspendue), ayant droit en\nvie, payée ou non. Orphelins de moins de 25 ans. Une personne comptée une fois.\nT41 : l'enfant de 21 ans au plus, payé dans l'année.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "mH0gjsZaVZKij5X2W7mx",
      "type": "text",
      "x": 901.0,
      "y": 7906.5,
      "width": 786.24,
      "height": 60.0,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "rT7q6VH4rm5QBYaUX9l8"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1167454083,
      "version": 1,
      "versionNonce": 23681924,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793544333071,
      "link": null,
      "locked": false,
      "text": "Preuve : la définition de l'annuaire CNSS 2024, confirmée par le lot 5 : T32 +0,9 %, T36\nexact, T33 et T37 à T40 à quelques % ; la CNSS compte aussi les pensions de coordination\npayées par une autre caisse (sans montant)",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Preuve : la définition de l'annuaire CNSS 2024, confirmée par le lot 5 : T32 +0,9 %, T36\nexact, T33 et T37 à T40 à quelques % ; la CNSS compte aussi les pensions de coordination\npayées par une autre caisse (sans montant)",
      "autoResize": true,
      "lineHeight": 1.25
    },
