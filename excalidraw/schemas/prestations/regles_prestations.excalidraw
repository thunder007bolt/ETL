      "updated": 1793362274996,
      "link": null,
      "locked": false,
      "text": "NOUVEAU : une nouvelle demande, qui ouvre son dossier. ANCIEN : une demande\ndéposée sur un dossier existant, presque toujours une réversion.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "NOUVEAU : une nouvelle demande, qui ouvre son dossier. ANCIEN : une demande\ndéposée sur un dossier existant, presque toujours une réversion.",
      "autoResize": true,
      "lineHeight": 1.25
    },
