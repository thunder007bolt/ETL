    {
      "id": "yVCQYcGdzZDjtpFwuvRi",
      "type": "text",
      "x": 1759.0,
      "y": 3189.5,
      "width": 782.6400000000001,
      "height": 67.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "5HSvIIJ5U015isQXJEee"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 2007623079,
      "version": 1,
      "versionNonce": 890920752,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793544333071,
      "link": null,
      "locked": false,
      "text": "Quand un pensionné décède, la pension de sa veuve et de ses orphelins est ajoutée\nà son dossier. Un assuré mort avant sa retraite laisse sans doute un nouveau\ndossier de survivants.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Quand un pensionné décède, la pension de sa veuve et de ses orphelins est ajoutée\nà son dossier. Un assuré mort avant sa retraite laisse sans doute un nouveau\ndossier de survivants.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "DwBvXpMpd3oP9Z119kC0",
      "type": "text",
      "x": 1759.0,
      "y": 3269.0,
      "width": 771.5200000000001,
      "height": 40.0,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "5HSvIIJ5U015isQXJEee"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 799495329,
      "version": 1,
      "versionNonce": 1168105698,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793544333071,
      "link": null,
      "locked": false,
      "text": "Preuve : 13 104 des 25 541 pensions de veuve sont dans le dossier du défunt ; une seconde\nnotification arrive en médiane 9 ans après la première",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Preuve : 13 104 des 25 541 pensions de veuve sont dans le dossier du défunt ; une seconde\nnotification arrive en médiane 9 ans après la première",
      "autoResize": true,
      "lineHeight": 1.25
    },
