    {
      "id": "rsMyzDaormy5oNk9oxeT",
      "type": "text",
      "x": 2102,
      "y": 28858.0,
      "width": 426.88,
      "height": 240.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
