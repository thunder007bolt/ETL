      "isDeleted": false,
      "boundElements": [],
      "updated": 1793638601505,
      "link": null,
      "locked": false,
      "text": "Une seule fois, l'année de son entrée, même si elle meurt ou que sa pension s'arrête avant le 31 décembre. Une\nrévision ou une reliquidation n'en fait pas un nouveau pensionné.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Une seule fois, l'année de son entrée, même si elle meurt ou que sa pension s'arrête avant le 31 décembre. Une\nrévision ou une reliquidation n'en fait pas un nouveau pensionné.",
      "autoResize": true,
      "lineHeight": 1.25
    },
