    {
      "id": "Z96EBx6Vey7vHA0TLcZ1",
      "type": "text",
      "x": 2083,
      "y": 13377.0,
      "width": 389.76,
      "height": 180.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
