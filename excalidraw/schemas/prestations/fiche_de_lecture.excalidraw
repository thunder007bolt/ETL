      "lineHeight": 1.25
    },
    {
      "id": "ejUYkFjJ7QkSbCDYpfwC",
      "type": "text",
      "x": 39,
      "y": 26130.0,
      "width": 1071.54,
      "height": 67.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "iEqdxj3xUNVQnmSzTzpk"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1284203844,
      "version": 1,
      "versionNonce": 565923109,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793638601505,
      "link": null,
      "locked": false,
      "text": "Une pension en cours le 31 décembre : son effet a commencé, elle n'est ni radiée ni suspendue, et son titulaire\nest en vie. Qu'elle ait été payée en décembre ou non. C'est ce que fait l'annuaire CNSS 2024 : nos chiffres de\n2020 à 2024 retombent dessus à moins de 1 % près.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Une pension en cours le 31 décembre : son effet a commencé, elle n'est ni radiée ni suspendue, et son titulaire\nest en vie. Qu'elle ait été payée en décembre ou non. C'est ce que fait l'annuaire CNSS 2024 : nos chiffres de\n2020 à 2024 retombent dessus à moins de 1 % près.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "S3kL4CdgSLcjZjkg0Fm7",
      "type": "text",
      "x": 39,
      "y": 26209.5,
      "width": 892.0,
      "height": 20.0,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "iEqdxj3xUNVQnmSzTzpk"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1846864912,
      "version": 1,
      "versionNonce": 930404076,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793638601505,
      "link": null,
      "locked": false,
      "text": "Exemple : une pension suspendue le 31 octobre 2024 et pas réactivée n'est pas comptée au 31/12/2024.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Exemple : une pension suspendue le 31 octobre 2024 et pas réactivée n'est pas comptée au 31/12/2024.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
