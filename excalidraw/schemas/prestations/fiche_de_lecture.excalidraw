      "seed": 1818976056,
      "version": 1,
      "versionNonce": 489485560,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793638601505,
      "link": null,
      "locked": false,
      "text": "-- les codes des dossiers contrôlés\nSELECT c.TDOS_CODE, pe.TPE_CODE,\n       COUNT(DISTINCT c.DOS_CODE)\nFROM   USER_DWH.DOSSIERS_CONTROLES c\nJOIN   USER_DWH.PRESTATION_ESP pe\n       ON pe.DOS_CODE = c.DOS_CODE\nGROUP  BY c.TDOS_CODE, pe.TPE_CODE",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-- les codes des dossiers contrôlés\nSELECT c.TDOS_CODE, pe.TPE_CODE,\n       COUNT(DISTINCT c.DOS_CODE)\nFROM   USER_DWH.DOSSIERS_CONTROLES c\nJOIN   USER_DWH.PRESTATION_ESP pe\n       ON pe.DOS_CODE = c.DOS_CODE\nGROUP  BY c.TDOS_CODE, pe.TPE_CODE",
      "autoResize": true,
      "lineHeight": 1.25
    },
