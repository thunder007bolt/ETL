    },
    {
      "id": "yKb4kzrVWQGjXOxkFfsF",
      "type": "text",
      "x": 39,
      "y": 8655.0,
      "width": 166.08,
      "height": 20.0,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
