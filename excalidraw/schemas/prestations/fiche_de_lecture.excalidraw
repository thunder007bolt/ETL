    {
      "id": "68AP2KgcrtCxkW5aVWKs",
      "type": "text",
      "x": 2093,
      "y": 31288.5,
      "width": 399.03999999999996,
      "height": 400.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
