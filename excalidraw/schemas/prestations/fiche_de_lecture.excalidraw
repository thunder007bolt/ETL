      "link": null,
      "locked": false,
      "text": "La personne dont la prestation est liquidée dans l'année : notifiée pour la première fois, comme pour T25. Je\nl'applique à T50 à T55. Les payées s'en écartent de 25 %.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "La personne dont la prestation est liquidée dans l'année : notifiée pour la première fois, comme pour T25. Je\nl'applique à T50 à T55. Les payées s'en écartent de 25 %.",
      "autoResize": true,
      "lineHeight": 1.25
    },
