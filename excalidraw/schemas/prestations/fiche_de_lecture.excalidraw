    {
      "id": "c3BGNJuB1WTTbcpI4xba",
      "type": "text",
      "x": 2074,
      "y": 6823.5,
      "width": 389.76,
      "height": 180.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
