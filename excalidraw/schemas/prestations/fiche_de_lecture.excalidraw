      "text": "-- à coller sous le WITH des termes 4 et 5\nSELECT ligne,\n       SUM(CASE WHEN jours < 15\n                THEN 1 ELSE 0 END) AS moins_15,\n       SUM(CASE WHEN jours BETWEEN 15 AND 45\n                THEN 1 ELSE 0 END) AS de_15_a_45,\n       SUM(CASE WHEN jours > 45\n                THEN 1 ELSE 0 END) AS plus_45\nFROM   durees\nGROUP  BY ligne\n-- dossiers ouverts en 2025 : allocataires\n-- 57 %, 24 %, 19 % ; maternité 44 %,\n-- 44 %, 12 %",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-- à coller sous le WITH des termes 4 et 5\nSELECT ligne,\n       SUM(CASE WHEN jours < 15\n                THEN 1 ELSE 0 END) AS moins_15,\n       SUM(CASE WHEN jours BETWEEN 15 AND 45\n                THEN 1 ELSE 0 END) AS de_15_a_45,\n       SUM(CASE WHEN jours > 45\n                THEN 1 ELSE 0 END) AS plus_45\nFROM   durees\nGROUP  BY ligne\n-- dossiers ouverts en 2025 : allocataires\n-- 57 %, 24 %, 19 % ; maternité 44 %,\n-- 44 %, 12 %",
      "autoResize": true,
      "lineHeight": 1.25
    },
