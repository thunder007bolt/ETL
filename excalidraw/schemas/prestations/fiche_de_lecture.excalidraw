      "isDeleted": false,
      "boundElements": [],
      "updated": 1793625970010,
      "link": null,
      "locked": false,
      "text": "« Ces contrôles portent sur les dossiers déjà liquidés aux fins de s'assurer que les droits servis sont conformes aux éléments\ndu dossier » (p. 12).",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "« Ces contrôles portent sur les dossiers déjà liquidés aux fins de s'assurer que les droits servis sont conformes aux éléments\ndu dossier » (p. 12).",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "ugmVYG3gJFjLfh4vi40R",
      "type": "text",
      "x": 39,
      "y": 19223.5,
      "width": 166.08,
      "height": 20.0,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
