      "roundness": null,
      "seed": 1434266168,
      "version": 1,
      "versionNonce": 878076101,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793638601505,
      "link": null,
      "locked": false,
      "text": "Ce qui a été payé pour les mois de l'année. Une nouvelle pension est payée avec un rappel des mois d'avant : je le\nmontre à part (8 % du montant pour les retraités, 25 % pour les veuves). Une pension de coordination payée par\nl'autre caisse compte sans montant.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Ce qui a été payé pour les mois de l'année. Une nouvelle pension est payée avec un rappel des mois d'avant : je le\nmontre à part (8 % du montant pour les retraités, 25 % pour les veuves). Une pension de coordination payée par\nl'autre caisse compte sans montant.",
      "autoResize": true,
      "lineHeight": 1.25
    },
