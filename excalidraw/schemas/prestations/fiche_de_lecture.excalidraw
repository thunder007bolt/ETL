    {
      "id": "neCLUI7USdN7nzr8FWjP",
      "type": "text",
      "x": 51,
      "y": 26652.5,
      "width": 1036.16,
      "height": 40.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
