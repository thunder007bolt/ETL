    },
    {
      "id": "Y73VF31PEVjV0SRMyCJY",
      "type": "text",
      "x": 2083,
      "y": 35906.0,
      "width": 436.15999999999997,
      "height": 300.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "BwE0TAk8yip5idbd7cn3"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 2063812032,
      "version": 1,
      "versionNonce": 404961839,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793638601505,
      "link": null,
      "locked": false,
      "text": "-- payé pour les mois de 2024 aux\n-- nouveaux retraités\nSELECT SUM(deb.DEB_MONTANT)\nFROM   USER_DWH.DEBOURS deb\nJOIN   USER_DWH.PRESTATION_ESP p\n       ON p.PE_ID = deb.PE_ID\nWHERE  p.TPE_CODE IN ('RPV', 'RPRA')\nAND    p.IND_ID_PREST IN\n       (SELECT IND_ID_PREST FROM nouveaux_2024)\nAND    deb.DEB_TYPE = 'PM'\nAND    deb.DEB_STATUT IN ('D', 'P')\nAND    deb.DEB_DATE_EFFET >= DATE '2024-01-01'\nAND    deb.DEB_DATE_EFFET <  DATE '2025-01-01'\n-- 2024 : 2,86 Md ; le rappel des mois\n-- d'avant : DEB_DATE_EFFET < 2024, à part",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-- payé pour les mois de 2024 aux\n-- nouveaux retraités\nSELECT SUM(deb.DEB_MONTANT)\nFROM   USER_DWH.DEBOURS deb\nJOIN   USER_DWH.PRESTATION_ESP p\n       ON p.PE_ID = deb.PE_ID\nWHERE  p.TPE_CODE IN ('RPV', 'RPRA')\nAND    p.IND_ID_PREST IN\n       (SELECT IND_ID_PREST FROM nouveaux_2024)\nAND    deb.DEB_TYPE = 'PM'\nAND    deb.DEB_STATUT IN ('D', 'P')\nAND    deb.DEB_DATE_EFFET >= DATE '2024-01-01'\nAND    deb.DEB_DATE_EFFET <  DATE '2025-01-01'\n-- 2024 : 2,86 Md ; le rappel des mois\n-- d'avant : DEB_DATE_EFFET < 2024, à part",
      "autoResize": true,
      "lineHeight": 1.25
    },
