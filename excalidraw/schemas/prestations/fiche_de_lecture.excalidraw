    {
      "id": "8a5FTTXe1zkdvqhzBKWL",
      "type": "text",
      "x": 2112,
      "y": 39406.5,
      "width": 380.47999999999996,
      "height": 240.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "RIDTK1wwNk42FbZN3WXn"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 832403424,
      "version": 1,
      "versionNonce": 1430541104,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793704821347,
      "link": null,
      "locked": false,
      "text": "-- une personne par tableau et par année,\n-- avec son sexe ; T54 et T55 : les\n-- femmes seulement\nSELECT l.tableau, l.annee, i.IND_SEXE,\n       COUNT(DISTINCT l.IND_ID_PREST)\nFROM   liquides l\nJOIN   USER_DWH.INDIVIDU i\n       ON i.IND_ID = l.IND_ID_PREST\nWHERE  l.tableau NOT IN ('T54', 'T55')\nOR     i.IND_SEXE = '2'\nGROUP  BY l.tableau, l.annee, i.IND_SEXE\n-- 1 hommes, 2 femmes",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-- une personne par tableau et par année,\n-- avec son sexe ; T54 et T55 : les\n-- femmes seulement\nSELECT l.tableau, l.annee, i.IND_SEXE,\n       COUNT(DISTINCT l.IND_ID_PREST)\nFROM   liquides l\nJOIN   USER_DWH.INDIVIDU i\n       ON i.IND_ID = l.IND_ID_PREST\nWHERE  l.tableau NOT IN ('T54', 'T55')\nOR     i.IND_SEXE = '2'\nGROUP  BY l.tableau, l.annee, i.IND_SEXE\n-- 1 hommes, 2 femmes",
      "autoResize": true,
      "lineHeight": 1.25
    },
