    {
      "id": "s2NIDVKjmTbYGWfxLOUb",
      "type": "text",
      "x": 2102,
      "y": 28247.5,
      "width": 426.88,
      "height": 240.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "6jXixfAKWwvfmWpS5Xi0"
      ],
