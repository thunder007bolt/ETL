    {
      "id": "5BIzUnLKIwHaGRuAo1Rx",
      "type": "text",
      "x": 2130,
      "y": 19993.5,
      "width": 389.76,
      "height": 180.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
