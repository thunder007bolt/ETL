    {
      "id": "yEyrjYjCtaHbIqrvo7p9",
      "type": "text",
      "x": 45,
      "y": 775.5,
      "width": 2484.36,
      "height": 45.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "pHY6WCmKzNd1J5dhNi8I"
      ],
      "frameId": null,
