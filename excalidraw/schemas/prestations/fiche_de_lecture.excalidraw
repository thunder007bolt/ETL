    {
      "id": "nq9CubDu77xRqzQx0oWx",
      "type": "text",
      "x": 2112,
      "y": 23251.5,
      "width": 417.59999999999997,
      "height": 300.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
