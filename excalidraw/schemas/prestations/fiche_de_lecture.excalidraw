    {
      "id": "slUphd5MFWXNoIy1Wxsi",
      "type": "text",
      "x": 2093,
      "y": 32694.0,
      "width": 436.15999999999997,
      "height": 380.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "tiysQaC6VmPzp0WiU29T"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 985843970,
      "version": 1,
      "versionNonce": 443596337,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793638601505,
      "link": null,
      "locked": false,
      "text": "-- l'allocation moyenne : le montant de la\n-- terme 7 divisé par l'effectif\nSELECT ROUND(SUM(deb.DEB_MONTANT)\n         / (SELECT COUNT(*)\n            FROM   allocataires_2024))\n         AS par_allocataire,\n       ROUND(SUM(deb.DEB_MONTANT)\n         / (SELECT COUNT(DISTINCT IND_ID_PREST)\n            FROM   enfants_2024))\n         AS par_enfant\nFROM   USER_DWH.DEBOURS deb\nWHERE  deb.PE_ID IN\n       (SELECT PE_ID FROM enfants_2024)\nAND    deb.DEB_TYPE = 'PM'\nAND    deb.DEB_STATUT IN ('D', 'P')\nAND    deb.DEB_DATE_EFFET >= DATE '2024-01-01'\nAND    deb.DEB_DATE_EFFET <  DATE '2025-01-01'\n-- 2024 : environ 78 400 FCFA par\n-- allocataire et par an, 28 300 par enfant",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-- l'allocation moyenne : le montant de la\n-- terme 7 divisé par l'effectif\nSELECT ROUND(SUM(deb.DEB_MONTANT)\n         / (SELECT COUNT(*)\n            FROM   allocataires_2024))\n         AS par_allocataire,\n       ROUND(SUM(deb.DEB_MONTANT)\n         / (SELECT COUNT(DISTINCT IND_ID_PREST)\n            FROM   enfants_2024))\n         AS par_enfant\nFROM   USER_DWH.DEBOURS deb\nWHERE  deb.PE_ID IN\n       (SELECT PE_ID FROM enfants_2024)\nAND    deb.DEB_TYPE = 'PM'\nAND    deb.DEB_STATUT IN ('D', 'P')\nAND    deb.DEB_DATE_EFFET >= DATE '2024-01-01'\nAND    deb.DEB_DATE_EFFET <  DATE '2025-01-01'\n-- 2024 : environ 78 400 FCFA par\n-- allocataire et par an, 28 300 par enfant",
      "autoResize": true,
      "lineHeight": 1.25
    },
