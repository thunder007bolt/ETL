      "boundElements": [],
      "updated": 1793638601505,
      "link": null,
      "locked": false,
      "text": "Le même tableau que T25, pour les accidents du travail et les maladies professionnelles : combien de demandes arrivent, combien sont réglées et en combien de jours, combien restent à traiter. La victime a un seul dossier, qui garde\ntoutes ses prestations : IJ, soins, puis rente.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Le même tableau que T25, pour les accidents du travail et les maladies professionnelles : combien de demandes arrivent, combien sont réglées et en combien de jours, combien restent à traiter. La victime a un seul dossier, qui garde\ntoutes ses prestations : IJ, soins, puis rente.",
      "autoResize": true,
      "lineHeight": 1.25
    },
