    },
    {
      "id": "fVubYSbeZtOpUUyJUYZl",
      "type": "text",
      "x": 2083,
      "y": 10952.0,
      "width": 445.43999999999994,
      "height": 680.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "vHD9Z2uX4l3aL3wgl4NE"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1295348949,
      "version": 1,
      "versionNonce": 1923368435,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793638601505,
      "link": null,
      "locked": false,
      "text": "-- demandes AT/MP ni liquidées ni rejetées\n-- au 31/12/2025\nSELECT COUNT(*)\nFROM   USER_DWH.RECEPTION_DOSSIER r\nLEFT   JOIN USER_DWH.DOSSIER d\n       ON (d.RD_ID = r.RD_ID          -- NOUVEAU\n           OR d.DOS_CODE = r.DOS_CODE) -- ANCIEN\nWHERE  r.TDOS_CODE = 'A'\nAND    r.RD_DATE_RECEPTION < DATE '2026-01-01'\n-- sans suite après 24 mois : sorti du stock\nAND    r.RD_DATE_RECEPTION >= DATE '2024-01-01'\nAND    NOT EXISTS (     -- aucune notification\n         SELECT 1\n         FROM   USER_DWH.PRESTATION_ESP p\n         WHERE  p.DOS_CODE = d.DOS_CODE\n         AND    p.PE_DATE_NOTIFICATION\n                  >= TRUNC(r.RD_DATE_RECEPTION)\n         AND    p.PE_DATE_NOTIFICATION\n                  < DATE '2026-01-01')\nAND    NOT EXISTS (     -- aucun soin remboursé\n         SELECT 1\n         FROM   USER_DWH.DEBOURS b\n         WHERE  b.DOS_CODE = d.DOS_CODE\n         AND    b.TPN_CODE IS NOT NULL\n         AND    b.DEB_DATE_INSERT\n                  < DATE '2026-01-01')\nAND    NOT EXISTS (     -- aucun rejet\n         SELECT 1\n         FROM   USER_DWH.DOSSIER_REJETE x\n         WHERE  x.RD_ID = r.RD_ID\n         AND    x.DOSRE_DATE_REJET\n                  < DATE '2026-01-01')\n-- sans les dossiers fermés jamais liquidés\nAND    NVL(d.DOS_STATUT, '-') <> 'F'",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-- demandes AT/MP ni liquidées ni rejetées\n-- au 31/12/2025\nSELECT COUNT(*)\nFROM   USER_DWH.RECEPTION_DOSSIER r\nLEFT   JOIN USER_DWH.DOSSIER d\n       ON (d.RD_ID = r.RD_ID          -- NOUVEAU\n           OR d.DOS_CODE = r.DOS_CODE) -- ANCIEN\nWHERE  r.TDOS_CODE = 'A'\nAND    r.RD_DATE_RECEPTION < DATE '2026-01-01'\n-- sans suite après 24 mois : sorti du stock\nAND    r.RD_DATE_RECEPTION >= DATE '2024-01-01'\nAND    NOT EXISTS (     -- aucune notification\n         SELECT 1\n         FROM   USER_DWH.PRESTATION_ESP p\n         WHERE  p.DOS_CODE = d.DOS_CODE\n         AND    p.PE_DATE_NOTIFICATION\n                  >= TRUNC(r.RD_DATE_RECEPTION)\n         AND    p.PE_DATE_NOTIFICATION\n                  < DATE '2026-01-01')\nAND    NOT EXISTS (     -- aucun soin remboursé\n         SELECT 1\n         FROM   USER_DWH.DEBOURS b\n         WHERE  b.DOS_CODE = d.DOS_CODE\n         AND    b.TPN_CODE IS NOT NULL\n         AND    b.DEB_DATE_INSERT\n                  < DATE '2026-01-01')\nAND    NOT EXISTS (     -- aucun rejet\n         SELECT 1\n         FROM   USER_DWH.DOSSIER_REJETE x\n         WHERE  x.RD_ID = r.RD_ID\n         AND    x.DOSRE_DATE_REJET\n                  < DATE '2026-01-01')\n-- sans les dossiers fermés jamais liquidés\nAND    NVL(d.DOS_STATUT, '-') <> 'F'",
      "autoResize": true,
      "lineHeight": 1.25
    },
