      "updated": 1793625970010,
      "link": null,
      "locked": false,
      "text": "Exemple : une pension suspendue le 31 octobre 2024 et pas réactivée n'est pas comptée au 31/12/2024.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Exemple : une pension suspendue le 31 octobre 2024 et pas réactivée n'est pas comptée au 31/12/2024.",
      "autoResize": true,
      "lineHeight": 1.25
    },
