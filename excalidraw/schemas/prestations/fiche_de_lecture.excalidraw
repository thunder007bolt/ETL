      "versionNonce": 615177760,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793704821347,
      "link": null,
      "locked": false,
      "text": "Tu valides cette formule : en instance au 31/12, divisé par (en instance au 1er janvier + déposées dans\nl'année) ?",
