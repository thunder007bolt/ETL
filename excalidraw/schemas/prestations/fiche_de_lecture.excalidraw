    {
      "id": "FOcFzRM4Kc1GjrOiYTwx",
      "type": "text",
      "x": 2112,
      "y": 24502.5,
      "width": 184.48000000000002,
      "height": 20.0,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
