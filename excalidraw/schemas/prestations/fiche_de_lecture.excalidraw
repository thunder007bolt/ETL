    },
    {
      "id": "y37na3c0g9jB2ZI69TD0",
      "type": "text",
      "x": 39,
      "y": 15110.5,
      "width": 1066.32,
      "height": 90.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "moti7vGK67Qfhx1PDvNn"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 844468787,
      "version": 1,
      "versionNonce": 1809277398,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793704821347,
      "link": null,
      "locked": false,
      "text": "Une demande reçue au guichet dans l'année : un nouvel allocataire, ou une nouvelle grossesse, qui ouvre son\ndossier. Une grossesse est déposée une fois sur chacune de ses deux lignes (IJ et prénatale). Un enfant qui\ns'ajoute plus tard au dossier d'un allocataire (une naissance) ne passe pas au guichet : je le compte comme une\ndemande déposée à la date de sa demande dans la base.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Une demande reçue au guichet dans l'année : un nouvel allocataire, ou une nouvelle grossesse, qui ouvre son\ndossier. Une grossesse est déposée une fois sur chacune de ses deux lignes (IJ et prénatale). Un enfant qui\ns'ajoute plus tard au dossier d'un allocataire (une naissance) ne passe pas au guichet : je le compte comme une\ndemande déposée à la date de sa demande dans la base.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "9CfPmNC8bHT7Qy3IE4aq",
      "type": "text",
      "x": 39,
      "y": 15212.5,
      "width": 1063.8400000000001,
      "height": 40.0,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "moti7vGK67Qfhx1PDvNn"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1497917336,
      "version": 1,
      "versionNonce": 1208401514,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793704821347,
      "link": null,
      "locked": false,
      "text": "Exemple : un allocataire déjà payé pour deux enfants a un troisième enfant en 2025 : son ajout au dossier compte comme une\ndemande déposée en 2025.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Exemple : un allocataire déjà payé pour deux enfants a un troisième enfant en 2025 : son ajout au dossier compte comme une\ndemande déposée en 2025.",
      "autoResize": true,
      "lineHeight": 1.25
    },
