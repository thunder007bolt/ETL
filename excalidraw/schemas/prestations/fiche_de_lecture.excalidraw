      "isDeleted": false,
      "boundElements": [],
      "updated": 1793704821347,
      "link": null,
      "locked": false,
      "text": "Exemple : une pension payée en trop de janvier à août 2024, trop-perçu établi en novembre 2024 : il compte en novembre.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Exemple : une pension payée en trop de janvier à août 2024, trop-perçu établi en novembre 2024 : il compte en novembre.",
      "autoResize": true,
      "lineHeight": 1.25
    },
