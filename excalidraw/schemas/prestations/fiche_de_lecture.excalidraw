    {
      "id": "NDiwtyjUfEnVfMESKA7p",
      "type": "text",
      "x": 2112,
      "y": 40745.5,
      "width": 408.32,
      "height": 360.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
