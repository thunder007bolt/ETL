    {
      "id": "SSCBXj9PHR6JkJijK5Jg",
      "type": "text",
      "x": 2093,
      "y": 31569.0,
      "width": 463.99999999999994,
      "height": 240.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
