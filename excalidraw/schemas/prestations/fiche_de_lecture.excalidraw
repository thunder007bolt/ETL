      "isDeleted": false,
      "boundElements": [],
      "updated": 1793638601505,
      "link": null,
      "locked": false,
      "text": "Un ajustement « moins-perçu ou rappel », ou « rappel sur convention ». Il est dans le tableau, mais ce n'est pas\nun indu : la CNSS a payé trop peu.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Un ajustement « moins-perçu ou rappel », ou « rappel sur convention ». Il est dans le tableau, mais ce n'est pas\nun indu : la CNSS a payé trop peu.",
      "autoResize": true,
      "lineHeight": 1.25
    },
