      "versionNonce": 1670183603,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793638601505,
      "link": null,
      "locked": false,
      "text": "-- les demandes reçues au guichet en 2025\nSELECT RD_TYPE_RECEPTION, COUNT(*)\nFROM   USER_DWH.RECEPTION_DOSSIER\nWHERE  TDOS_CODE = 'V'\nAND    RD_DATE_RECEPTION >= DATE '2025-01-01'\nAND    RD_DATE_RECEPTION <  DATE '2026-01-01'\nGROUP  BY RD_TYPE_RECEPTION\n-- NOUVEAU : ouvre un dossier\n-- ANCIEN  : arrive sur un dossier existant\n--           (à 94 % une réversion)\n-- 2025 : 4 671 = 4 055 NOUVEAU + 616 ANCIEN",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-- les demandes reçues au guichet en 2025\nSELECT RD_TYPE_RECEPTION, COUNT(*)\nFROM   USER_DWH.RECEPTION_DOSSIER\nWHERE  TDOS_CODE = 'V'\nAND    RD_DATE_RECEPTION >= DATE '2025-01-01'\nAND    RD_DATE_RECEPTION <  DATE '2026-01-01'\nGROUP  BY RD_TYPE_RECEPTION\n-- NOUVEAU : ouvre un dossier\n-- ANCIEN  : arrive sur un dossier existant\n--           (à 94 % une réversion)\n-- 2025 : 4 671 = 4 055 NOUVEAU + 616 ANCIEN",
      "autoResize": true,
      "lineHeight": 1.25
    },
