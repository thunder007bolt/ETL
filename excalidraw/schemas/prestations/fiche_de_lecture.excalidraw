    {
      "id": "DT6kG3bCdvQKyDmB41Ru",
      "type": "text",
      "x": 2083,
      "y": 13986.5,
      "width": 417.59999999999997,
      "height": 200.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "bXizpDA1Z7LQo2iXnMvI"
      ],
