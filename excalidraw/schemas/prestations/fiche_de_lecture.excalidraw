      "isDeleted": false,
      "boundElements": [],
      "updated": 1793704821347,
      "link": null,
      "locked": false,
      "text": "« Paiement de trop, au détriment de l'organisme » (glossaire, p. 66) ; une prestation indue est une « prestation\nirrégulièrement versée » (p. 65).",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "« Paiement de trop, au détriment de l'organisme » (glossaire, p. 66) ; une prestation indue est une « prestation\nirrégulièrement versée » (p. 65).",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "wcOAEhany3rEEjGHz467",
      "type": "text",
      "x": 39,
      "y": 23248.0,
      "width": 166.08,
      "height": 20.0,
      "angle": 0,
      "strokeColor": "#495057",
