      ],
      "frameId": null,
      "roundness": null,
      "seed": 1545818177,
      "version": 1,
      "versionNonce": 2051089885,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793704821347,
      "link": null,
      "locked": false,
      "text": "Tu valides : les soins sont liquidés le jour où leur premier remboursement est saisi ?",
