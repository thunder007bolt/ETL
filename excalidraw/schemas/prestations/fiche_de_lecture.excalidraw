    },
    {
      "id": "lRA5A3ZkbSdRDdk6qB1v",
      "type": "text",
      "x": 25,
      "y": 18588.0,
      "width": 2469.4,
      "height": 50.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 2128046592,
      "version": 1,
      "versionNonce": 2108632597,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793625970010,
      "link": null,
      "locked": false,
      "text": "Pour moi, ces trois tableaux disent si la CNSS vérifie après coup les dossiers qu'elle paie : combien de dossiers sont payés, combien sont contrôlés chaque trimestre, et si la part contrôlée atteint la norme de 5 %. T28 pour les\npensions, T29 pour les AT/MP, T30 pour les prestations familiales.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Pour moi, ces trois tableaux disent si la CNSS vérifie après coup les dossiers qu'elle paie : combien de dossiers sont payés, combien sont contrôlés chaque trimestre, et si la part contrôlée atteint la norme de 5 %. T28 pour les\npensions, T29 pour les AT/MP, T30 pour les prestations familiales.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
