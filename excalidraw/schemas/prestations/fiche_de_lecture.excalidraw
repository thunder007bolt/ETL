    {
      "id": "KjKTQ1pmhdnHNUdkhcFV",
      "type": "text",
      "x": 2083,
      "y": 7754.5,
      "width": 380.47999999999996,
      "height": 300.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "Awrp8sqZUaIZf5s4Ez0Y"
