      "isDeleted": false,
      "boundElements": [],
      "updated": 1793638601505,
      "link": null,
      "locked": false,
      "text": "Pour vérifier (2025)",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Pour vérifier (2025)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "DIhA1Oy4LKz5fsZQDoTF",
      "type": "text",
      "x": 2083,
      "y": 8689.0,
      "width": 454.71999999999997,
      "height": 820.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "RBWe50QX5APcwNscyfw4"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 120330411,
      "version": 1,
      "versionNonce": 673337968,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793638601505,
      "link": null,
      "locked": false,
      "text": "-- demandes : une par dossier et par ligne\n-- du tableau, réutilisée ensuite\nWITH prest AS (\n  SELECT pe.DOS_CODE, pe.PE_DATE_DEMANDE,\n         pe.PE_DATE_NOTIFICATION AS date_liq,\n         CASE WHEN pe.TPE_CODE = 'ARI' THEN 1\n              WHEN pe.TPE_CODE IN ('ARSV','ARSF',\n                     'ARSE','ARSA')    THEN 2\n              WHEN pe.TPE_CODE = 'AIJ' THEN 3\n              WHEN pe.TPE_CODE = 'AAI' THEN 4\n              ELSE 5 END AS ligne\n  FROM   USER_DWH.PRESTATION_ESP pe\n  JOIN   USER_DWH.DOSSIER d\n         ON d.DOS_CODE = pe.DOS_CODE\n  WHERE  d.TDOS_CODE = 'A'\n  -- les soins (ligne 5) : liquidés au\n  -- premier remboursement saisi\n  UNION ALL\n  SELECT deb.DOS_CODE, NULL,\n         deb.DEB_DATE_INSERT, 5\n  FROM   USER_DWH.DEBOURS deb\n  JOIN   USER_DWH.DOSSIER d\n         ON d.DOS_CODE = deb.DOS_CODE\n  WHERE  d.TDOS_CODE = 'A'\n  AND    deb.TPN_CODE IS NOT NULL),\ndemandes AS (\n  -- liquidée à sa première notification\n  SELECT DOS_CODE, ligne,\n         MIN(PE_DATE_DEMANDE) AS date_demande,\n         MIN(date_liq)        AS date_liquidation\n  FROM   prest\n  GROUP  BY DOS_CODE, ligne)\nSELECT ligne, COUNT(*)\nFROM   demandes\nWHERE  date_liquidation >= DATE '2025-01-01'\nAND    date_liquidation <  DATE '2026-01-01'\nGROUP  BY ligne\nORDER  BY ligne\n-- 2025 : rentes 43, survivants 13, IJ 226,\n-- allocations 61 (343 hors soins) ;\n-- soins, ligne 5 : environ 650 dossiers",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-- demandes : une par dossier et par ligne\n-- du tableau, réutilisée ensuite\nWITH prest AS (\n  SELECT pe.DOS_CODE, pe.PE_DATE_DEMANDE,\n         pe.PE_DATE_NOTIFICATION AS date_liq,\n         CASE WHEN pe.TPE_CODE = 'ARI' THEN 1\n              WHEN pe.TPE_CODE IN ('ARSV','ARSF',\n                     'ARSE','ARSA')    THEN 2\n              WHEN pe.TPE_CODE = 'AIJ' THEN 3\n              WHEN pe.TPE_CODE = 'AAI' THEN 4\n              ELSE 5 END AS ligne\n  FROM   USER_DWH.PRESTATION_ESP pe\n  JOIN   USER_DWH.DOSSIER d\n         ON d.DOS_CODE = pe.DOS_CODE\n  WHERE  d.TDOS_CODE = 'A'\n  -- les soins (ligne 5) : liquidés au\n  -- premier remboursement saisi\n  UNION ALL\n  SELECT deb.DOS_CODE, NULL,\n         deb.DEB_DATE_INSERT, 5\n  FROM   USER_DWH.DEBOURS deb\n  JOIN   USER_DWH.DOSSIER d\n         ON d.DOS_CODE = deb.DOS_CODE\n  WHERE  d.TDOS_CODE = 'A'\n  AND    deb.TPN_CODE IS NOT NULL),\ndemandes AS (\n  -- liquidée à sa première notification\n  SELECT DOS_CODE, ligne,\n         MIN(PE_DATE_DEMANDE) AS date_demande,\n         MIN(date_liq)        AS date_liquidation\n  FROM   prest\n  GROUP  BY DOS_CODE, ligne)\nSELECT ligne, COUNT(*)\nFROM   demandes\nWHERE  date_liquidation >= DATE '2025-01-01'\nAND    date_liquidation <  DATE '2026-01-01'\nGROUP  BY ligne\nORDER  BY ligne\n-- 2025 : rentes 43, survivants 13, IJ 226,\n-- allocations 61 (343 hors soins) ;\n-- soins, ligne 5 : environ 650 dossiers",
      "autoResize": true,
      "lineHeight": 1.25
    },
