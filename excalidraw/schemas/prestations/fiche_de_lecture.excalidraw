      "boundElements": [],
      "updated": 1793638601505,
      "link": null,
      "locked": false,
      "text": "Le taux : les demandes en instance au 31 décembre, divisées par celles en instance au 1er janvier plus celles\ndéposées dans l'année. Ni l'Annuaire CIPRES ni l'atelier ne donnent de formule : c'est la mienne.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Le taux : les demandes en instance au 31 décembre, divisées par celles en instance au 1er janvier plus celles\ndéposées dans l'année. Ni l'Annuaire CIPRES ni l'atelier ne donnent de formule : c'est la mienne.",
      "autoResize": true,
      "lineHeight": 1.25
    },
