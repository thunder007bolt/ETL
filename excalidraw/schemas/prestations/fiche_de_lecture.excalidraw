    {
      "id": "PA9GlwJjKoQkcPfuUZDP",
      "type": "text",
      "x": 39,
      "y": 4513.5,
      "width": 1068.8400000000001,
      "height": 67.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
