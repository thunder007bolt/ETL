      "updated": 1793638601505,
      "link": null,
      "locked": false,
      "text": "Les lignes : allocations familiales, indemnités journalières de maternité, allocations prénatales, autres prestations de\nla branche, puis le TOTAL (p. 34).",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Les lignes : allocations familiales, indemnités journalières de maternité, allocations prénatales, autres prestations de\nla branche, puis le TOTAL (p. 34).",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "GQotLcQHqTAcsnNU3nmo",
      "type": "text",
      "x": 39,
      "y": 14155.5,
      "width": 166.08,
      "height": 20.0,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
