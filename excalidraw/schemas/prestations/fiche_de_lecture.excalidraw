      "isDeleted": false,
      "boundElements": [],
      "updated": 1793704821347,
      "link": null,
      "locked": false,
      "text": "T50 allocations de vieillesse, T51 allocations de survivants, T52 IJ des AT/MP, T53 allocations d'incapacité, T54\nindemnités de maternité, T55 allocations prénatales ; T56 prestations servies, T57 décédés (p. 16).",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "T50 allocations de vieillesse, T51 allocations de survivants, T52 IJ des AT/MP, T53 allocations d'incapacité, T54\nindemnités de maternité, T55 allocations prénatales ; T56 prestations servies, T57 décédés (p. 16).",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "QoHQ9mDerul02PhYwK23",
      "type": "text",
      "x": 39,
      "y": 38342.0,
      "width": 166.08,
      "height": 20.0,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
