    {
      "id": "JTvx9KoXtyPZhk0TwN0K",
      "type": "text",
      "x": 2083,
      "y": 33865.5,
      "width": 436.15999999999997,
      "height": 340.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "BSWdObULnonQXJLMV2xV"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1400032380,
      "version": 1,
      "versionNonce": 122500526,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793638601505,
      "link": null,
      "locked": false,
      "text": "-- la liste des nouveaux retraités de\n-- 2024 : leur première pension est saisie\n-- en 2024 ; réutilisée ensuite\nWITH nouveaux_2024 AS (\n  SELECT IND_ID_PREST,\n         MIN(PE_DATE_INSERT) AS premiere_saisie\n  FROM   USER_DWH.PRESTATION_ESP\n  WHERE  TPE_CODE IN ('RPV', 'RPRA')\n  GROUP  BY IND_ID_PREST\n  HAVING MIN(PE_DATE_INSERT)\n           >= DATE '2024-01-01'\n  AND    MIN(PE_DATE_INSERT)\n           <  DATE '2025-01-01')\nSELECT COUNT(*) FROM nouveaux_2024\n-- 2024 : 2 463 (l'annuaire : 2 489)\n-- de 2020 à 2025 : 1 891, 1 965, 2 127,\n-- 2 333, 2 463, 2 725",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-- la liste des nouveaux retraités de\n-- 2024 : leur première pension est saisie\n-- en 2024 ; réutilisée ensuite\nWITH nouveaux_2024 AS (\n  SELECT IND_ID_PREST,\n         MIN(PE_DATE_INSERT) AS premiere_saisie\n  FROM   USER_DWH.PRESTATION_ESP\n  WHERE  TPE_CODE IN ('RPV', 'RPRA')\n  GROUP  BY IND_ID_PREST\n  HAVING MIN(PE_DATE_INSERT)\n           >= DATE '2024-01-01'\n  AND    MIN(PE_DATE_INSERT)\n           <  DATE '2025-01-01')\nSELECT COUNT(*) FROM nouveaux_2024\n-- 2024 : 2 463 (l'annuaire : 2 489)\n-- de 2020 à 2025 : 1 891, 1 965, 2 127,\n-- 2 333, 2 463, 2 725",
      "autoResize": true,
      "lineHeight": 1.25
    },
