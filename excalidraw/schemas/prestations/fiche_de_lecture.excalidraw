    },
    {
      "id": "0WumoJacmGOwSkEpyQb5",
      "type": "text",
      "x": 2112,
      "y": 21365.5,
      "width": 426.88,
      "height": 300.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "4jLwljDT2gxI2f4Ns4d4"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 569741394,
      "version": 1,
      "versionNonce": 1436385361,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793625970010,
      "link": null,
      "locked": false,
      "text": "-- les payées de 2024 par branche : les\n-- débours de paiement (PM) au statut D\n-- (payé par effet) ou P (payé sans effet)\nSELECT d.TDOS_CODE, SUM(deb.DEB_MONTANT)\nFROM   USER_DWH.DEBOURS deb\nJOIN   USER_DWH.DOSSIER d\n       ON d.DOS_CODE = deb.DOS_CODE\nWHERE  deb.DEB_TYPE = 'PM'\nAND    deb.DEB_STATUT IN ('D', 'P')\n-- au mois payé ; au mois du versement :\n-- DEB_DATE_INSERT (réglage date_montant)\nAND    deb.DEB_DATE_EFFET >= DATE '2024-01-01'\nAND    deb.DEB_DATE_EFFET <  DATE '2025-01-01'\nGROUP  BY d.TDOS_CODE\n-- 2024 : 58,7 Md en tout",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-- les payées de 2024 par branche : les\n-- débours de paiement (PM) au statut D\n-- (payé par effet) ou P (payé sans effet)\nSELECT d.TDOS_CODE, SUM(deb.DEB_MONTANT)\nFROM   USER_DWH.DEBOURS deb\nJOIN   USER_DWH.DOSSIER d\n       ON d.DOS_CODE = deb.DOS_CODE\nWHERE  deb.DEB_TYPE = 'PM'\nAND    deb.DEB_STATUT IN ('D', 'P')\n-- au mois payé ; au mois du versement :\n-- DEB_DATE_INSERT (réglage date_montant)\nAND    deb.DEB_DATE_EFFET >= DATE '2024-01-01'\nAND    deb.DEB_DATE_EFFET <  DATE '2025-01-01'\nGROUP  BY d.TDOS_CODE\n-- 2024 : 58,7 Md en tout",
      "autoResize": true,
      "lineHeight": 1.25
    },
