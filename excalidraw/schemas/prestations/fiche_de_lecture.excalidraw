      "type": "text",
      "x": 39,
      "y": 4349.0,
      "width": 1068.8400000000001,
      "height": 67.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
