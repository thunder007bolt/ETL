      "versionNonce": 1418909408,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793638601505,
      "link": null,
      "locked": false,
      "text": "Chaque tableau a ses codes de prestation et sa grille d'âge. Je mets la retraite anticipée avec la vieillesse. Un\norphelin compte jusqu'à 24 ans.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Chaque tableau a ses codes de prestation et sa grille d'âge. Je mets la retraite anticipée avec la vieillesse. Un\norphelin compte jusqu'à 24 ans.",
      "autoResize": true,
      "lineHeight": 1.25
    },
