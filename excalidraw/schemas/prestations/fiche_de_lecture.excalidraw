    {
      "id": "vvJ8dpXoQG5lV3Ncmurc",
      "type": "text",
      "x": 39,
      "y": 6090.0,
      "width": 1078.92,
      "height": 67.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
