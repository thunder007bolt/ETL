      "type": "text",
      "x": 39,
      "y": 6057.5,
      "width": 1073.88,
      "height": 67.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
