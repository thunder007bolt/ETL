    {
      "id": "sllNO6CnioqPWzYYIJAd",
      "type": "text",
      "x": 2083,
      "y": 14372.5,
      "width": 184.48000000000002,
      "height": 20.0,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
