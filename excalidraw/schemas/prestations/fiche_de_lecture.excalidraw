      "roundness": null,
      "seed": 217906113,
      "version": 1,
      "versionNonce": 1926673127,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793704821347,
      "link": null,
      "locked": false,
      "text": "Un dossier dont le refus a été enregistré dans l'année, avec son motif : prescription, pas de bénéficiaire, pièce\nnon conforme, autre. Il n'y en a que 14 en 2025 (146 depuis 2017) : d'après l'atelier de Kaya, le module des\nrejets existe mais sert peu. Un refus qui n'y est pas saisi reste compté en instance.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Un dossier dont le refus a été enregistré dans l'année, avec son motif : prescription, pas de bénéficiaire, pièce\nnon conforme, autre. Il n'y en a que 14 en 2025 (146 depuis 2017) : d'après l'atelier de Kaya, le module des\nrejets existe mais sert peu. Un refus qui n'y est pas saisi reste compté en instance.",
      "autoResize": true,
      "lineHeight": 1.25
    },
