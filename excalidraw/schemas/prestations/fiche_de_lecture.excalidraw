      "versionNonce": 1478080649,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793625970010,
      "link": null,
      "locked": false,
      "text": "Les paiements et les remboursements de l'année, par branche. Pas les ajustements, qui sont des corrections. Les\nsoins des AT/MP ne sont pas tous dans les remboursements : l'AT/MP reste 29 % sous le publié.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Les paiements et les remboursements de l'année, par branche. Pas les ajustements, qui sont des corrections. Les\nsoins des AT/MP ne sont pas tous dans les remboursements : l'AT/MP reste 29 % sous le publié.",
      "autoResize": true,
      "lineHeight": 1.25
    },
