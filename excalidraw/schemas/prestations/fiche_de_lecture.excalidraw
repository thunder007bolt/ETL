    {
      "id": "XLVSLFpuvbwHZCYZyk4P",
      "type": "text",
      "x": 39,
      "y": 39273.5,
      "width": 1101.06,
      "height": 45.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "LRIDTK1wwNk42FbZN3WX"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 376032915,
      "version": 1,
      "versionNonce": 1179558770,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793625970010,
      "link": null,
      "locked": false,
      "text": "AVS : les titulaires d'une pension directe morts dans l'année. AT/MP : les rentiers, et les victimes mortes dans\nl'année de leur accident. PF : les allocataires. À la date du décès : la base n'a pas de date de déclaration.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "AVS : les titulaires d'une pension directe morts dans l'année. AT/MP : les rentiers, et les victimes mortes dans\nl'année de leur accident. PF : les allocataires. À la date du décès : la base n'a pas de date de déclaration.",
      "autoResize": true,
      "lineHeight": 1.25
    },
