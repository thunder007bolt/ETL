    {
      "id": "xFX11mMq3DH6AUu2ryju",
      "type": "text",
      "x": 51,
      "y": 1686.5,
      "width": 1027.2,
      "height": 60.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
