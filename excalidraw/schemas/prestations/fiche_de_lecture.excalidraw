    {
      "id": "IsvDFOcFzRM4Kc1GjrOi",
      "type": "text",
      "x": 39,
      "y": 25185.0,
      "width": 1070.64,
      "height": 67.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "vmyIv9tBQi3ZmYqLtvc7"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1679687315,
      "version": 1,
      "versionNonce": 1514373952,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793625970010,
      "link": null,
      "locked": false,
      "text": "Une pension en cours le 31 décembre : son effet a commencé, elle n'est ni radiée ni suspendue, et son titulaire\nest en vie. Qu'elle ait été payée en décembre ou non. C'est ce que fait l'annuaire de la CNSS : nos chiffres de\n2020 à 2024 retombent dessus à moins de 1 % près.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Une pension en cours le 31 décembre : son effet a commencé, elle n'est ni radiée ni suspendue, et son titulaire\nest en vie. Qu'elle ait été payée en décembre ou non. C'est ce que fait l'annuaire de la CNSS : nos chiffres de\n2020 à 2024 retombent dessus à moins de 1 % près.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "wxPA8j8ZhUO1975SwUYT",
      "type": "text",
      "x": 39,
      "y": 25264.5,
      "width": 892.0,
      "height": 20.0,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
