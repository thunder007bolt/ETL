      "roundness": null,
      "seed": 290818379,
      "version": 1,
      "versionNonce": 83355138,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793625970010,
      "link": null,
      "locked": false,
      "text": "Une demande dont les droits ont été notifiés dans l'année : la première notification de la demande. Une IJ\nprolongée donne plusieurs IJ : la demande compte une fois, à la première. Les soins n'ont pas de notification :\nje les compte liquidés au premier remboursement saisi.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Une demande dont les droits ont été notifiés dans l'année : la première notification de la demande. Une IJ\nprolongée donne plusieurs IJ : la demande compte une fois, à la première. Les soins n'ont pas de notification :\nje les compte liquidés au premier remboursement saisi.",
      "autoResize": true,
      "lineHeight": 1.25
    },
