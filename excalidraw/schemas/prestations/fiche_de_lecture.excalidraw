    {
      "id": "1Z2H64DwBBWEjusUdPaD",
      "type": "text",
      "x": 2083,
      "y": 36830.0,
      "width": 371.2,
      "height": 380.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "yXXaK5vahh8eEsoTligy"
      ],
      "frameId": null,
