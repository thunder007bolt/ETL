    {
      "id": "2NcgouWQ9Ybd9W5GZdzS",
      "type": "text",
      "x": 2083,
      "y": 13154.5,
      "width": 380.47999999999996,
      "height": 140.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "DRBD9oI08OImP5KNHFPf"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1107595735,
      "version": 1,
      "versionNonce": 1403224277,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793625970010,
      "link": null,
      "locked": false,
      "text": "-- F : prestations familiales, un dossier\n-- par allocataire ; M : maternité, un\n-- dossier par grossesse\nSELECT TDOS_CODE, COUNT(*)\nFROM   USER_DWH.DOSSIER\nWHERE  TDOS_CODE IN ('F', 'M')\nGROUP  BY TDOS_CODE",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-- F : prestations familiales, un dossier\n-- par allocataire ; M : maternité, un\n-- dossier par grossesse\nSELECT TDOS_CODE, COUNT(*)\nFROM   USER_DWH.DOSSIER\nWHERE  TDOS_CODE IN ('F', 'M')\nGROUP  BY TDOS_CODE",
