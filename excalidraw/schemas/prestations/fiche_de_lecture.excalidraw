      "seed": 725839901,
      "version": 1,
      "versionNonce": 1988471509,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793625970010,
      "link": null,
      "locked": false,
      "text": "-- les demandes reçues au guichet en 2025\nSELECT RD_TYPE_RECEPTION, COUNT(*)\nFROM   USER_DWH.RECEPTION_DOSSIER\nWHERE  TDOS_CODE = 'A'\nAND    RD_DATE_RECEPTION >= DATE '2025-01-01'\nAND    RD_DATE_RECEPTION <  DATE '2026-01-01'\nGROUP  BY RD_TYPE_RECEPTION\n-- NOUVEAU : la déclaration, dépôt des IJ\n--           et des soins\n-- ANCIEN  : la demande d'une rente, d'une\n--           allocation, d'une rente de\n--           survivant, sur le dossier\n-- 2025 : 1 481 = 1 345 NOUVEAU + 136 ANCIEN",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-- les demandes reçues au guichet en 2025\nSELECT RD_TYPE_RECEPTION, COUNT(*)\nFROM   USER_DWH.RECEPTION_DOSSIER\nWHERE  TDOS_CODE = 'A'\nAND    RD_DATE_RECEPTION >= DATE '2025-01-01'\nAND    RD_DATE_RECEPTION <  DATE '2026-01-01'\nGROUP  BY RD_TYPE_RECEPTION\n-- NOUVEAU : la déclaration, dépôt des IJ\n--           et des soins\n-- ANCIEN  : la demande d'une rente, d'une\n--           allocation, d'une rente de\n--           survivant, sur le dossier\n-- 2025 : 1 481 = 1 345 NOUVEAU + 136 ANCIEN",
      "autoResize": true,
      "lineHeight": 1.25
    },
