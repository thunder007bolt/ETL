      "roundness": null,
      "seed": 773997502,
      "version": 1,
      "versionNonce": 511391085,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793625970010,
      "link": null,
      "locked": false,
      "text": "Ce qui a été payé dans l'année pour la prestation. La date qui retombe le mieux sur l'annuaire de la CNSS est\ncelle du versement, rappels compris : 497,8 millions d'allocations de vieillesse versées en 2024 pour 497,7\npubliés, contre +3,9 % au mois payé. Le choix reste ouvert.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Ce qui a été payé dans l'année pour la prestation. La date qui retombe le mieux sur l'annuaire de la CNSS est\ncelle du versement, rappels compris : 497,8 millions d'allocations de vieillesse versées en 2024 pour 497,7\npubliés, contre +3,9 % au mois payé. Le choix reste ouvert.",
      "autoResize": true,
      "lineHeight": 1.25
    },
