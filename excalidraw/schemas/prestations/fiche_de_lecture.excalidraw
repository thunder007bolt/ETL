    {
      "id": "eusbp0ulbRaAyfoTANWi",
      "type": "text",
      "x": 2083,
      "y": 15897.5,
      "width": 473.28,
      "height": 460.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "F3vPXYJjD6mMwsL6tJIa"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 84130585,
      "version": 1,
      "versionNonce": 1212910117,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793638601505,
      "link": null,
      "locked": false,
      "text": "-- à ajouter à la suite du WITH de la\n-- terme 4 : dépôt = la réception qui a\n-- ouvert le dossier, sinon la date de\n-- demande ; une durée négative compte 0\ndurees AS (\n  SELECT dm.ligne,\n         GREATEST(TRUNC(dm.date_liquidation)\n           - TRUNC(NVL(\n               (SELECT r.RD_DATE_RECEPTION\n                FROM   USER_DWH.DOSSIER d\n                JOIN   USER_DWH.RECEPTION_DOSSIER r\n                       ON r.RD_ID = d.RD_ID\n                WHERE  d.DOS_CODE = dm.DOS_CODE),\n               dm.date_demande)), 0) AS jours\n  FROM   demandes dm\n  WHERE  dm.date_liquidation >= DATE '2025-01-01'\n  AND    dm.date_liquidation <  DATE '2026-01-01')\nSELECT ligne, MEDIAN(jours)\nFROM   durees\nGROUP  BY ligne\n-- 2025 : allocataires 13,5 j, maternité 17\n-- enfant ajouté : de sa PE_DATE_DEMANDE à\n-- sa notification, environ 11 j",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-- à ajouter à la suite du WITH de la\n-- terme 4 : dépôt = la réception qui a\n-- ouvert le dossier, sinon la date de\n-- demande ; une durée négative compte 0\ndurees AS (\n  SELECT dm.ligne,\n         GREATEST(TRUNC(dm.date_liquidation)\n           - TRUNC(NVL(\n               (SELECT r.RD_DATE_RECEPTION\n                FROM   USER_DWH.DOSSIER d\n                JOIN   USER_DWH.RECEPTION_DOSSIER r\n                       ON r.RD_ID = d.RD_ID\n                WHERE  d.DOS_CODE = dm.DOS_CODE),\n               dm.date_demande)), 0) AS jours\n  FROM   demandes dm\n  WHERE  dm.date_liquidation >= DATE '2025-01-01'\n  AND    dm.date_liquidation <  DATE '2026-01-01')\nSELECT ligne, MEDIAN(jours)\nFROM   durees\nGROUP  BY ligne\n-- 2025 : allocataires 13,5 j, maternité 17\n-- enfant ajouté : de sa PE_DATE_DEMANDE à\n-- sa notification, environ 11 j",
      "autoResize": true,
      "lineHeight": 1.25
    },
