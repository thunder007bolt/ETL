      "boundElements": [],
      "updated": 1793638601505,
      "link": null,
      "locked": false,
      "text": "Pour moi, T50 à T55 suivent sur cinq ans le nombre de bénéficiaires de six prestations et ce qu'on leur a payé ; T56 récapitule tout ce qui a été servi par branche, T57 les décès par branche.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Pour moi, T50 à T55 suivent sur cinq ans le nombre de bénéficiaires de six prestations et ce qu'on leur a payé ; T56 récapitule tout ce qui a été servi par branche, T57 les décès par branche.",
      "autoResize": true,
      "lineHeight": 1.25
    },
