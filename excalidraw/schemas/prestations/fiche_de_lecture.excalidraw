      "versionNonce": 99814964,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793638601505,
      "link": null,
      "locked": false,
      "text": "Ce que j'ai compris",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Ce que j'ai compris",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "KrLYHNEFCLMEZwvOpliR",
      "type": "text",
      "x": 39,
      "y": 14179.5,
      "width": 1089.54,
      "height": 67.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "eE6U2Ot62W9QGSMkEVyl"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1308733234,
      "version": 1,
      "versionNonce": 787342909,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793638601505,
      "link": null,
      "locked": false,
      "text": "Les allocations familiales sont celles de l'allocataire, pour ses enfants. Les IJ et l'allocation prénatale\nviennent du dossier de la grossesse. J'ajoute l'ancienne allocation prénatale des PF (33 en 2025). Aucune autre\nprestation n'est payée aujourd'hui : des frais de maternité sont prévus dans la base, jamais payés.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Les allocations familiales sont celles de l'allocataire, pour ses enfants. Les IJ et l'allocation prénatale\nviennent du dossier de la grossesse. J'ajoute l'ancienne allocation prénatale des PF (33 en 2025). Aucune autre\nprestation n'est payée aujourd'hui : des frais de maternité sont prévus dans la base, jamais payés.",
      "autoResize": true,
      "lineHeight": 1.25
    },
