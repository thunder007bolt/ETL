        "ojGOx6lInf7kveZDt8Ad"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1763538865,
      "version": 1,
      "versionNonce": 1373619305,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793625970010,
      "link": null,
      "locked": false,
      "text": "SELECT i.IND_SEXE, COUNT(*)\nFROM   nouveaux_2024 n\nJOIN   USER_DWH.INDIVIDU i\n       ON i.IND_ID = n.IND_ID_PREST\nGROUP  BY i.IND_SEXE\n-- 1 hommes, 2 femmes ; 2024 : le sexe ne\n-- retombe pas sur l'annuaire (641 femmes\n-- pour 527 publiées)",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "SELECT i.IND_SEXE, COUNT(*)\nFROM   nouveaux_2024 n\nJOIN   USER_DWH.INDIVIDU i\n       ON i.IND_ID = n.IND_ID_PREST\nGROUP  BY i.IND_SEXE\n-- 1 hommes, 2 femmes ; 2024 : le sexe ne\n-- retombe pas sur l'annuaire (641 femmes\n-- pour 527 publiées)",
      "autoResize": true,
      "lineHeight": 1.25
    },
