      "seed": 1875853398,
      "version": 1,
      "versionNonce": 900019470,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793638601505,
      "link": null,
      "locked": false,
      "text": "-- les dossiers payés en 2025, par branche\nSELECT CODE_BRANCHE,\n       COUNT(DISTINCT DOS_CODE) AS payes\nFROM   USER_DWH.DEBOURS\nWHERE  DEB_TYPE = 'PM'\nAND    DEB_STATUT IN ('D', 'P')\nAND    DEB_DATE_EFFET >= DATE '2025-01-01'\nAND    DEB_DATE_EFFET <  DATE '2026-01-01'\nGROUP  BY CODE_BRANCHE",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-- les dossiers payés en 2025, par branche\nSELECT CODE_BRANCHE,\n       COUNT(DISTINCT DOS_CODE) AS payes\nFROM   USER_DWH.DEBOURS\nWHERE  DEB_TYPE = 'PM'\nAND    DEB_STATUT IN ('D', 'P')\nAND    DEB_DATE_EFFET >= DATE '2025-01-01'\nAND    DEB_DATE_EFFET <  DATE '2026-01-01'\nGROUP  BY CODE_BRANCHE",
      "autoResize": true,
      "lineHeight": 1.25
    },
