    {
      "id": "fzAYLvslUphd5MFWXNoI",
      "type": "text",
      "x": 2083,
      "y": 32691.0,
      "width": 436.15999999999997,
      "height": 340.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
