      "seed": 873031315,
      "version": 1,
      "versionNonce": 1788926030,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793638601505,
      "link": null,
      "locked": false,
      "text": "-- en instance au 31/12/2025, divisé par\n-- (en instance au 31/12/2024 + déposés)\n-- en instance : la terme 7, une fois avec\n-- 2026-01-01, une fois avec 2025-01-01 ;\n-- déposés : la terme 3 (1 481 en 2025)\nSELECT ROUND(100 * :instance_fin_2025\n         / (:instance_fin_2024 + 1481), 1)\n         AS taux_restant_pct\nFROM   DUAL",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-- en instance au 31/12/2025, divisé par\n-- (en instance au 31/12/2024 + déposés)\n-- en instance : la terme 7, une fois avec\n-- 2026-01-01, une fois avec 2025-01-01 ;\n-- déposés : la terme 3 (1 481 en 2025)\nSELECT ROUND(100 * :instance_fin_2025\n         / (:instance_fin_2024 + 1481), 1)\n         AS taux_restant_pct\nFROM   DUAL",
      "autoResize": true,
      "lineHeight": 1.25
    },
