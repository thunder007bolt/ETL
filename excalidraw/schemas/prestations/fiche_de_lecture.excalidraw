      "boundElements": [],
      "updated": 1793704821347,
      "link": null,
      "locked": false,
      "text": "L'année de l'exercice moins l'année de naissance, sans regarder le jour d'anniversaire. 120 ans ou plus, ou pas de\ndate : âge inconnu. L'année 1900 est une date par défaut, pas un vrai âge.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "L'année de l'exercice moins l'année de naissance, sans regarder le jour d'anniversaire. 120 ans ou plus, ou pas de\ndate : âge inconnu. L'année 1900 est une date par défaut, pas un vrai âge.",
      "autoResize": true,
      "lineHeight": 1.25
    },
