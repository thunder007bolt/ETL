      "type": "text",
      "x": 39,
      "y": 18401.5,
      "width": 1079.28,
      "height": 67.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
