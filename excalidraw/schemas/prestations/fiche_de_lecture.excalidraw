      "versionNonce": 544462409,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793704821347,
      "link": null,
      "locked": false,
      "text": "Tu valides : un seul dossier par victime, qui porte toutes ses prestations ?",
