    },
    {
      "id": "il1Btd0QsrSqnnsK0V98",
      "type": "text",
      "x": 25,
      "y": 29332.5,
      "width": 363.6,
      "height": 25.0,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
