    {
      "id": "aISjqKdmvlT6hzpYbnPi",
      "type": "text",
      "x": 2083,
      "y": 16945.5,
      "width": 408.32,
      "height": 140.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "v84MYCUawB29bTpCZgnv"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1832470392,
      "version": 1,
      "versionNonce": 273406036,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793625970010,
      "link": null,
      "locked": false,
      "text": "SELECT TDOS_CODE, COUNT(*)\nFROM   USER_DWH.DOSSIER_REJETE\nWHERE  TDOS_CODE IN ('F', 'M')\nAND    DOSRE_DATE_REJET >= DATE '2025-01-01'\nAND    DOSRE_DATE_REJET <  DATE '2026-01-01'\nGROUP  BY TDOS_CODE\n-- 2025 : 21",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "SELECT TDOS_CODE, COUNT(*)\nFROM   USER_DWH.DOSSIER_REJETE\nWHERE  TDOS_CODE IN ('F', 'M')\nAND    DOSRE_DATE_REJET >= DATE '2025-01-01'\nAND    DOSRE_DATE_REJET <  DATE '2026-01-01'\nGROUP  BY TDOS_CODE\n-- 2025 : 21",
      "autoResize": true,
      "lineHeight": 1.25
    },
