      "link": null,
      "locked": false,
      "text": "SELECT COUNT(*)\nFROM   USER_DWH.DOSSIER_REJETE\nWHERE  TDOS_CODE = 'A'\nAND    DOSRE_DATE_REJET >= DATE '2025-01-01'\nAND    DOSRE_DATE_REJET <  DATE '2026-01-01'\n-- 2025 : 1 (0 à 7 par an)",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "SELECT COUNT(*)\nFROM   USER_DWH.DOSSIER_REJETE\nWHERE  TDOS_CODE = 'A'\nAND    DOSRE_DATE_REJET >= DATE '2025-01-01'\nAND    DOSRE_DATE_REJET <  DATE '2026-01-01'\n-- 2025 : 1 (0 à 7 par an)",
