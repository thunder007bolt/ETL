    },
    {
      "id": "iR5kCm7iU3XViFoNo0pO",
      "type": "text",
      "x": 39,
      "y": 17530.5,
      "width": 1083.78,
      "height": 67.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "e1clUDfVZ9NbvL6k5oWu"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1599607222,
      "version": 1,
      "versionNonce": 1791093231,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793704821347,
      "link": null,
      "locked": false,
      "text": "Une demande reçue, ni liquidée ni rejetée au 31 décembre. J'en retire deux sortes : les dossiers fermés sans\nrien avoir donné, et les demandes toujours sans suite 24 mois après leur dépôt. Beaucoup ne donnent jamais rien\net ne sont jamais fermées : sans ce tri, elles resteraient en instance pour toujours.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Une demande reçue, ni liquidée ni rejetée au 31 décembre. J'en retire deux sortes : les dossiers fermés sans\nrien avoir donné, et les demandes toujours sans suite 24 mois après leur dépôt. Beaucoup ne donnent jamais rien\net ne sont jamais fermées : sans ce tri, elles resteraient en instance pour toujours.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "44SKrYbRazLSWO5wqwLe",
      "type": "text",
      "x": 39,
      "y": 17610.0,
      "width": 1031.04,
      "height": 20.0,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "e1clUDfVZ9NbvL6k5oWu"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 2144723319,
      "version": 1,
      "versionNonce": 700541157,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793704821347,
      "link": null,
      "locked": false,
      "text": "Exemple : une demande reçue en mars 2023 qui n'a toujours rien donné en mars 2025 : elle sort du stock à ce moment-là.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Exemple : une demande reçue en mars 2023 qui n'a toujours rien donné en mars 2025 : elle sort du stock à ce moment-là.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "UHVrZl0IzBM7o45Dsvdt",
      "type": "text",
      "x": 39,
      "y": 17646.0,
      "width": 1022.4000000000001,
      "height": 22.5,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "e1clUDfVZ9NbvL6k5oWu"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 340663542,
      "version": 1,
      "versionNonce": 1065240442,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793704821347,
      "link": null,
      "locked": false,
      "text": "Tu valides : une demande qui n'a toujours rien donné 24 mois après son dépôt ne compte plus en instance ?",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Tu valides : une demande qui n'a toujours rien donné 24 mois après son dépôt ne compte plus en instance ?",
      "autoResize": true,
      "lineHeight": 1.25
    },
