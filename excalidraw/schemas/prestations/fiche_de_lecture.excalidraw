    {
      "id": "q06g2wHzVa5JG4aFEnhs",
      "type": "text",
      "x": 25,
      "y": 33894.5,
      "width": 2498.8,
      "height": 50.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
