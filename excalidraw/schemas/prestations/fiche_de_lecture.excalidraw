    {
      "id": "Jj9oRmJhOpU5NKHDQkXp",
      "type": "text",
      "x": 39,
      "y": 26323.0,
      "width": 1063.08,
      "height": 45.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "lOi8octKqkLeTqeu5VSt"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 2023291590,
      "version": 1,
      "versionNonce": 1287994389,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793704821347,
      "link": null,
      "locked": false,
      "text": "Chaque tableau a ses codes de prestation et sa grille d'âge (au milieu). Je mets la retraite anticipée avec la\nvieillesse. Un orphelin n'est compté que jusqu'à 24 ans : il sort l'année de ses 25 ans.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Chaque tableau a ses codes de prestation et sa grille d'âge (au milieu). Je mets la retraite anticipée avec la\nvieillesse. Un orphelin n'est compté que jusqu'à 24 ans : il sort l'année de ses 25 ans.",
      "autoResize": true,
      "lineHeight": 1.25
    },
