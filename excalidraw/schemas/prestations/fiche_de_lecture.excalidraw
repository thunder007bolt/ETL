    {
      "id": "wgV32OYQqpCKA8QIGOug",
      "type": "text",
      "x": 25,
      "y": 33284.0,
      "width": 2498.8,
      "height": 50.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
