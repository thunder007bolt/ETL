    {
      "id": "xEpW5bbO8WBt9ctD5BIz",
      "type": "text",
      "x": 51,
      "y": 19838.5,
      "width": 1090.4,
      "height": 40.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
