    {
      "id": "k5EBAmj548CgjwgzLRL5",
      "type": "text",
      "x": 51,
      "y": 7686.0,
      "width": 1067.8400000000001,
      "height": 40.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
