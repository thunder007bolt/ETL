      "seed": 1801587197,
      "version": 1,
      "versionNonce": 1796568294,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793638601505,
      "link": null,
      "locked": false,
      "text": "Chaque demande liquidée tombe dans une seule colonne : 0 à 14 jours, 15 à 45 jours, 46 jours et plus. 15 jours\net 45 jours vont dans la colonne du milieu ; un dossier notifié le jour du dépôt va dans « moins de 15 jours ».\nLes trois colonnes ensemble font les dossiers liquidés.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Chaque demande liquidée tombe dans une seule colonne : 0 à 14 jours, 15 à 45 jours, 46 jours et plus. 15 jours\net 45 jours vont dans la colonne du milieu ; un dossier notifié le jour du dépôt va dans « moins de 15 jours ».\nLes trois colonnes ensemble font les dossiers liquidés.",
      "autoResize": true,
      "lineHeight": 1.25
    },
