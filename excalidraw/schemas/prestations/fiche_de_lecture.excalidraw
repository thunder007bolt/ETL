    {
      "id": "If2lPhHL59Dvq6hWvh7L",
      "type": "text",
      "x": 39,
      "y": 34761.5,
      "width": 1090.44,
      "height": 67.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "uvjr4lAEgATQYtpO85pS"
      ],
