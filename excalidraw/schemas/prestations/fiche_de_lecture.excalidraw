    {
      "id": "JItFzlrlCF2wLO9J9gjR",
      "type": "text",
      "x": 2083,
      "y": 18088.5,
      "width": 399.03999999999996,
      "height": 180.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
