    {
      "id": "LBdmizvGopxq0uNkxUJH",
      "type": "text",
      "x": 2083,
      "y": 15449.0,
      "width": 184.48000000000002,
      "height": 20.0,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
