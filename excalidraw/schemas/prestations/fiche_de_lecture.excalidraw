      "updated": 1793625970010,
      "link": null,
      "locked": false,
      "text": "-- à coller sous le WITH des termes 4 et 5\nSELECT ligne,\n       SUM(CASE WHEN jours < 15\n                THEN 1 ELSE 0 END) AS moins_15,\n       SUM(CASE WHEN jours BETWEEN 15 AND 45\n                THEN 1 ELSE 0 END) AS de_15_a_45,\n       SUM(CASE WHEN jours > 45\n                THEN 1 ELSE 0 END) AS plus_45\nFROM   durees\nGROUP  BY ligne\n-- 2025 : plus de 45 jours pour au moins\n-- 85 % des IJ, 30 % des rentes",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-- à coller sous le WITH des termes 4 et 5\nSELECT ligne,\n       SUM(CASE WHEN jours < 15\n                THEN 1 ELSE 0 END) AS moins_15,\n       SUM(CASE WHEN jours BETWEEN 15 AND 45\n                THEN 1 ELSE 0 END) AS de_15_a_45,\n       SUM(CASE WHEN jours > 45\n                THEN 1 ELSE 0 END) AS plus_45\nFROM   durees\nGROUP  BY ligne\n-- 2025 : plus de 45 jours pour au moins\n-- 85 % des IJ, 30 % des rentes",
      "autoResize": true,
      "lineHeight": 1.25
    },
