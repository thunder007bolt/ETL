    {
      "id": "iwvEyfJiSo8LFwVNH2U7",
      "type": "text",
      "x": 2083,
      "y": 33862.0,
      "width": 473.28,
      "height": 340.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
