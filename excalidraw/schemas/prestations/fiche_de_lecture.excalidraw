      "versionNonce": 193021856,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793625970010,
      "link": null,
      "locked": false,
      "text": "-- T48 : le taux moyen des rentes\n-- viagères (ARI) des nouveaux de 2024\nSELECT COUNT(DISTINCT IND_ID_PREST)\n         AS nouveaux,\n       ROUND(AVG(PE_TAUX_INCAPACITE), 1)\n         AS ipp_moyen\nFROM   USER_DWH.PRESTATION_ESP\nWHERE  TPE_CODE = 'ARI'\nAND    IND_ID_PREST IN (\n         SELECT IND_ID_PREST\n         FROM   USER_DWH.PRESTATION_ESP\n         WHERE  TPE_CODE = 'ARI'\n         GROUP  BY IND_ID_PREST\n         HAVING MIN(PE_DATE_INSERT)\n                  >= DATE '2024-01-01'\n         AND    MIN(PE_DATE_INSERT)\n                  <  DATE '2025-01-01')\n-- une rente révisée compte deux fois\n-- dans la moyenne",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-- T48 : le taux moyen des rentes\n-- viagères (ARI) des nouveaux de 2024\nSELECT COUNT(DISTINCT IND_ID_PREST)\n         AS nouveaux,\n       ROUND(AVG(PE_TAUX_INCAPACITE), 1)\n         AS ipp_moyen\nFROM   USER_DWH.PRESTATION_ESP\nWHERE  TPE_CODE = 'ARI'\nAND    IND_ID_PREST IN (\n         SELECT IND_ID_PREST\n         FROM   USER_DWH.PRESTATION_ESP\n         WHERE  TPE_CODE = 'ARI'\n         GROUP  BY IND_ID_PREST\n         HAVING MIN(PE_DATE_INSERT)\n                  >= DATE '2024-01-01'\n         AND    MIN(PE_DATE_INSERT)\n                  <  DATE '2025-01-01')\n-- une rente révisée compte deux fois\n-- dans la moyenne",
      "autoResize": true,
      "lineHeight": 1.25
    },
