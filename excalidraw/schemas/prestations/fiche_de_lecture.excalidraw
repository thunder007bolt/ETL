    {
      "id": "13Jt81tAS4WDJTgYhfBn",
      "type": "text",
      "x": 2130,
      "y": 18752.0,
      "width": 389.76,
      "height": 180.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "Gd9stFugEAiv3R8d3GWb"
      ],
      "frameId": null,
