    {
      "id": "nYqU2cuxvcUas9F9qO5b",
      "type": "text",
      "x": 39,
      "y": 28373.5,
      "width": 1069.56,
      "height": 67.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "k790jDZJW3bwAPZgz3s6"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 439932741,
      "version": 1,
      "versionNonce": 755639759,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793638601505,
      "link": null,
      "locked": false,
      "text": "Ce qui a été payé dans l'année aux pensionnés comptés, pour les mois de l'année. Pas le net à payer d'un état de\npaiement : le montant de chaque paiement fait. Les pensionnés sortis avant le 31/12 ne sont pas comptés, leur\nmontant non plus.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Ce qui a été payé dans l'année aux pensionnés comptés, pour les mois de l'année. Pas le net à payer d'un état de\npaiement : le montant de chaque paiement fait. Les pensionnés sortis avant le 31/12 ne sont pas comptés, leur\nmontant non plus.",
      "autoResize": true,
      "lineHeight": 1.25
    },
