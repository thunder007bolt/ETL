      "isDeleted": false,
      "boundElements": [],
      "updated": 1793638601505,
      "link": null,
      "locked": false,
      "text": "Ce que j'ai compris, et ta réponse",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Ce que j'ai compris, et ta réponse",
