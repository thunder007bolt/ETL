      "isDeleted": false,
      "boundElements": [],
      "updated": 1793704821347,
      "link": null,
      "locked": false,
      "text": "-- le Total : toutes les demandes\n-- ensemble, la moyenne recalculée (pas la\n-- moyenne des moyennes des lignes)\nSELECT COUNT(*)          AS liquides,\n       ROUND(AVG(jours)) AS duree_moyenne,\n       MEDIAN(jours)     AS duree_mediane\nFROM   durees\n-- les réceptions sans pension créée\n-- s'ajoutent aux déposés et aux en instance",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-- le Total : toutes les demandes\n-- ensemble, la moyenne recalculée (pas la\n-- moyenne des moyennes des lignes)\nSELECT COUNT(*)          AS liquides,\n       ROUND(AVG(jours)) AS duree_moyenne,\n       MEDIAN(jours)     AS duree_mediane\nFROM   durees\n-- les réceptions sans pension créée\n-- s'ajoutent aux déposés et aux en instance",
      "autoResize": true,
      "lineHeight": 1.25
    },
