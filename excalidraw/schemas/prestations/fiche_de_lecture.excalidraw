    {
      "id": "2YN2Xrs4FqFoxCxjkgQH",
      "type": "text",
      "x": 39,
      "y": 31410.5,
      "width": 166.08,
      "height": 20.0,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
