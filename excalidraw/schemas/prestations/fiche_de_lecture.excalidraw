    {
      "id": "bvNjb0kp8x3eUgKzQjfe",
      "type": "text",
      "x": 25,
      "y": 19829.5,
      "width": 2469.4,
      "height": 50.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
