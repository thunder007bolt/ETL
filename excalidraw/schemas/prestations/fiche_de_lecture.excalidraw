      ],
      "frameId": null,
      "roundness": null,
      "seed": 1032215083,
      "version": 1,
      "versionNonce": 963343005,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793704821347,
      "link": null,
      "locked": false,
      "text": "Tu valides : un dossier payé = au moins un paiement dans l'année ?",
