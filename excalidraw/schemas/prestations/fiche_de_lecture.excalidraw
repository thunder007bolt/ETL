      "roundness": null,
      "seed": 688742497,
      "version": 1,
      "versionNonce": 257381776,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793625970010,
      "link": null,
      "locked": false,
      "text": "Exemple : accident déclaré en mars 2023 ; la victime demande sa rente au guichet le 10 juin 2025 : c'est un dépôt de 2025,\nsur la ligne rentes viagères.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Exemple : accident déclaré en mars 2023 ; la victime demande sa rente au guichet le 10 juin 2025 : c'est un dépôt de 2025,\nsur la ligne rentes viagères.",
      "autoResize": true,
      "lineHeight": 1.25
    },
