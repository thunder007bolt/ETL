    {
      "id": "kwHfY5tkU0BfUMH6Ol2R",
      "type": "text",
      "x": 2083,
      "y": 8068.0,
      "width": 380.47999999999996,
      "height": 300.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
