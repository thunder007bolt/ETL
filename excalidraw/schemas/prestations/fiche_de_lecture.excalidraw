    {
      "id": "tPG5SGjT5iU2tf3scNoc",
      "type": "text",
      "x": 2102,
      "y": 26564.5,
      "width": 184.48000000000002,
      "height": 20.0,
      "angle": 0,
      "strokeColor": "#495057",
