    {
      "id": "y95SKEIxfHUHajn2h0Yq",
      "type": "text",
      "x": 2074,
      "y": 4492.0,
      "width": 445.43999999999994,
      "height": 600.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "sjRjMjoZmHghZDXQnzpr"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1991225054,
      "version": 1,
      "versionNonce": 1543633962,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793625970010,
      "link": null,
      "locked": false,
      "text": "-- réceptions de pension ni liquidées ni\n-- rejetées au 31/12/2025\nSELECT COUNT(*)\nFROM   USER_DWH.RECEPTION_DOSSIER r\nLEFT   JOIN USER_DWH.DOSSIER d\n       ON (d.RD_ID = r.RD_ID          -- NOUVEAU\n           OR d.DOS_CODE = r.DOS_CODE) -- ANCIEN\nWHERE  r.TDOS_CODE = 'V'\nAND    r.RD_DATE_RECEPTION < DATE '2026-01-01'\nAND    NVL(d.DOS_CATEGORIE, '-') <> 'CNSS_AC'\nAND    NOT EXISTS (     -- aucune notification\n         SELECT 1\n         FROM   USER_DWH.PRESTATION_ESP p\n         WHERE  p.DOS_CODE = d.DOS_CODE\n         AND    p.PE_DATE_NOTIFICATION\n                  >= TRUNC(r.RD_DATE_RECEPTION)\n         AND    p.PE_DATE_NOTIFICATION\n                  < DATE '2026-01-01')\nAND    NOT EXISTS (     -- aucun rejet\n         SELECT 1\n         FROM   USER_DWH.DOSSIER_REJETE x\n         WHERE  x.RD_ID = r.RD_ID\n         AND    x.DOSRE_DATE_REJET\n                  < DATE '2026-01-01')\n-- sans les dossiers fermés jamais notifiés\nAND    NVL(d.DOS_STATUT, '-') <> 'F'\n-- ni les réceptions d'avant 2016 sans dossier\nAND   (r.RD_DATE_RECEPTION >= DATE '2016-01-01'\n       OR d.DOS_CODE IS NOT NULL)\n-- sans ces deux exclusions : 23 218",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-- réceptions de pension ni liquidées ni\n-- rejetées au 31/12/2025\nSELECT COUNT(*)\nFROM   USER_DWH.RECEPTION_DOSSIER r\nLEFT   JOIN USER_DWH.DOSSIER d\n       ON (d.RD_ID = r.RD_ID          -- NOUVEAU\n           OR d.DOS_CODE = r.DOS_CODE) -- ANCIEN\nWHERE  r.TDOS_CODE = 'V'\nAND    r.RD_DATE_RECEPTION < DATE '2026-01-01'\nAND    NVL(d.DOS_CATEGORIE, '-') <> 'CNSS_AC'\nAND    NOT EXISTS (     -- aucune notification\n         SELECT 1\n         FROM   USER_DWH.PRESTATION_ESP p\n         WHERE  p.DOS_CODE = d.DOS_CODE\n         AND    p.PE_DATE_NOTIFICATION\n                  >= TRUNC(r.RD_DATE_RECEPTION)\n         AND    p.PE_DATE_NOTIFICATION\n                  < DATE '2026-01-01')\nAND    NOT EXISTS (     -- aucun rejet\n         SELECT 1\n         FROM   USER_DWH.DOSSIER_REJETE x\n         WHERE  x.RD_ID = r.RD_ID\n         AND    x.DOSRE_DATE_REJET\n                  < DATE '2026-01-01')\n-- sans les dossiers fermés jamais notifiés\nAND    NVL(d.DOS_STATUT, '-') <> 'F'\n-- ni les réceptions d'avant 2016 sans dossier\nAND   (r.RD_DATE_RECEPTION >= DATE '2016-01-01'\n       OR d.DOS_CODE IS NOT NULL)\n-- sans ces deux exclusions : 23 218",
      "autoResize": true,
      "lineHeight": 1.25
    },
