    {
      "id": "XTZtnELhQlKiVMHBqILH",
      "type": "text",
      "x": 2083,
      "y": 7483.5,
      "width": 380.47999999999996,
      "height": 300.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
