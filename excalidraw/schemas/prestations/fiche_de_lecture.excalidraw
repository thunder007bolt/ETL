    {
      "id": "WRa4wAHNjKtHrdVgUsWf",
      "type": "text",
      "x": 39,
      "y": 4594.0,
      "width": 1052.64,
      "height": 90.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "fMt2ROJEMaj2w7TpQxQt"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 739361031,
      "version": 1,
      "versionNonce": 1164849840,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793625970010,
      "link": null,
      "locked": false,
      "text": "Une demande reçue, ni notifiée ni rejetée au 31 décembre, quelle que soit l'année de son dépôt. J'enlève deux\nchoses : les dossiers fermés sans avoir jamais été notifiés, et les vieilles réceptions d'avant 2016 jamais\nreliées à un dossier. Sans ça, on aurait 23 218 demandes en instance fin 2025, cinq fois les dépôts d'une\nannée.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Une demande reçue, ni notifiée ni rejetée au 31 décembre, quelle que soit l'année de son dépôt. J'enlève deux\nchoses : les dossiers fermés sans avoir jamais été notifiés, et les vieilles réceptions d'avant 2016 jamais\nreliées à un dossier. Sans ça, on aurait 23 218 demandes en instance fin 2025, cinq fois les dépôts d'une\nannée.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "vJtOiet0C7mk3w2BaVg2",
      "type": "text",
      "x": 39,
      "y": 4700.0,
      "width": 1071.3600000000001,
      "height": 45.0,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
