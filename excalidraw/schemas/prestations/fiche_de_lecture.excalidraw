      "isDeleted": false,
      "boundElements": [],
      "updated": 1793638601505,
      "link": null,
      "locked": false,
      "text": "Un trop-perçu compte le mois où il est établi, pas le mois où il a été payé en trop, ni celui où il est repris.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Un trop-perçu compte le mois où il est établi, pas le mois où il a été payé en trop, ni celui où il est repris.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "dZ4NNiHGMWXYmQayKQiO",
      "type": "text",
      "x": 39,
      "y": 24286.0,
      "width": 1039.3600000000001,
