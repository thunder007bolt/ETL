    {
      "id": "yDEDJEoxOFKCVy512d4m",
      "type": "text",
      "x": 2083,
      "y": 14473.5,
      "width": 417.59999999999997,
      "height": 200.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
