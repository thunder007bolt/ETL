    {
      "id": "M6mVWY4b4JFoUHAV55uV",
      "type": "text",
      "x": 39,
      "y": 39906.0,
      "width": 166.08,
      "height": 20.0,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
