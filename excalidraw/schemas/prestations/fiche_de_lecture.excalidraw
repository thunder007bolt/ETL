    {
      "id": "Sz1nOuwg3ZINLBz1Ln3x",
      "type": "text",
      "x": 39,
      "y": 8320.5,
      "width": 1056.96,
      "height": 90.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
