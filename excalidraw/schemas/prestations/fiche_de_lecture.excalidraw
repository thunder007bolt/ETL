    {
      "id": "7qg9SlzmzIQM6sNUS65E",
      "type": "text",
      "x": 2083,
      "y": 35084.5,
      "width": 473.28,
      "height": 340.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "a8dCmZ5Fwm5T13PYJ4VL"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1303124781,
      "version": 1,
      "versionNonce": 1224229720,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793638601505,
      "link": null,
      "locked": false,
      "text": "SELECT tranche, COUNT(*)\nFROM  (SELECT CASE\n                WHEN age IS NULL OR age < 0\n                  OR age >= 120 THEN 'Âge inconnu'\n                WHEN age < 50   THEN 'Moins de 50'\n                WHEN age >= 100 THEN '100 et plus'\n                ELSE TO_CHAR(FLOOR(age / 5) * 5)\n              END AS tranche\n       FROM  (SELECT 2024 - EXTRACT(YEAR FROM\n                       i.IND_DATE_NAISSANCE) AS age\n              FROM   nouveaux_2024 n\n              JOIN   USER_DWH.INDIVIDU i\n                     ON i.IND_ID = n.IND_ID_PREST))\nGROUP  BY tranche\nORDER  BY tranche\n-- 2024 : 55-59 ans 1 450 (l'annuaire :\n-- 1 429), 60-64 ans 941 (956)",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "SELECT tranche, COUNT(*)\nFROM  (SELECT CASE\n                WHEN age IS NULL OR age < 0\n                  OR age >= 120 THEN 'Âge inconnu'\n                WHEN age < 50   THEN 'Moins de 50'\n                WHEN age >= 100 THEN '100 et plus'\n                ELSE TO_CHAR(FLOOR(age / 5) * 5)\n              END AS tranche\n       FROM  (SELECT 2024 - EXTRACT(YEAR FROM\n                       i.IND_DATE_NAISSANCE) AS age\n              FROM   nouveaux_2024 n\n              JOIN   USER_DWH.INDIVIDU i\n                     ON i.IND_ID = n.IND_ID_PREST))\nGROUP  BY tranche\nORDER  BY tranche\n-- 2024 : 55-59 ans 1 450 (l'annuaire :\n-- 1 429), 60-64 ans 941 (956)",
      "autoResize": true,
      "lineHeight": 1.25
    },
