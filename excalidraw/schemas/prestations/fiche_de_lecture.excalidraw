      "updated": 1793625970010,
      "link": null,
      "locked": false,
      "text": "Le trimestre de la date du contrôle : janvier à mars, avril à juin, juillet à septembre, octobre à décembre. Un\ndossier contrôlé deux fois dans le même trimestre compte une fois.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Le trimestre de la date du contrôle : janvier à mars, avril à juin, juillet à septembre, octobre à décembre. Un\ndossier contrôlé deux fois dans le même trimestre compte une fois.",
      "autoResize": true,
      "lineHeight": 1.25
    },
