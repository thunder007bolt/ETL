      "link": null,
      "locked": false,
      "text": "-- les contrôles par année et branche\nSELECT EXTRACT(YEAR FROM DC_DATE_CONTROLE)\n         AS annee,\n       TDOS_CODE,\n       COUNT(DISTINCT DOS_CODE) AS controles\nFROM   USER_DWH.DOSSIERS_CONTROLES\nGROUP  BY EXTRACT(YEAR FROM DC_DATE_CONTROLE),\n          TDOS_CODE\nORDER  BY 1, 2",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-- les contrôles par année et branche\nSELECT EXTRACT(YEAR FROM DC_DATE_CONTROLE)\n         AS annee,\n       TDOS_CODE,\n       COUNT(DISTINCT DOS_CODE) AS controles\nFROM   USER_DWH.DOSSIERS_CONTROLES\nGROUP  BY EXTRACT(YEAR FROM DC_DATE_CONTROLE),\n          TDOS_CODE\nORDER  BY 1, 2",
      "autoResize": true,
      "lineHeight": 1.25
    },
