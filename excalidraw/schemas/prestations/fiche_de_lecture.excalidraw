      "link": null,
      "locked": false,
      "text": "-- les prestations saisies en 2024, par\n-- code\nSELECT TPE_CODE, COUNT(*)\nFROM   USER_DWH.PRESTATION_ESP\nWHERE  TPE_CODE IN ('RPV', 'RPRA', 'RPSV',\n         'RPSF', 'RPSE', 'ARI', 'ARSV',\n         'ARSF', 'ARSE', 'ARSA')\nAND    PE_DATE_INSERT >= DATE '2024-01-01'\nAND    PE_DATE_INSERT <  DATE '2025-01-01'\nGROUP  BY TPE_CODE",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-- les prestations saisies en 2024, par\n-- code\nSELECT TPE_CODE, COUNT(*)\nFROM   USER_DWH.PRESTATION_ESP\nWHERE  TPE_CODE IN ('RPV', 'RPRA', 'RPSV',\n         'RPSF', 'RPSE', 'ARI', 'ARSV',\n         'ARSF', 'ARSE', 'ARSA')\nAND    PE_DATE_INSERT >= DATE '2024-01-01'\nAND    PE_DATE_INSERT <  DATE '2025-01-01'\nGROUP  BY TPE_CODE",
      "autoResize": true,
      "lineHeight": 1.25
    },
