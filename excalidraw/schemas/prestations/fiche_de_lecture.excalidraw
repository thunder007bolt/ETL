      "link": null,
      "locked": false,
      "text": "-- le Total : toutes les demandes\n-- ensemble, la moyenne recalculée ; une\n-- déclaration qui donne des IJ et des soins\n-- compte deux fois\nSELECT COUNT(*)          AS liquides,\n       ROUND(AVG(jours)) AS duree_moyenne,\n       MEDIAN(jours)     AS duree_mediane\nFROM   durees\n-- les déclarations sans prestation\n-- s'ajoutent aux déposés et aux en instance",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-- le Total : toutes les demandes\n-- ensemble, la moyenne recalculée ; une\n-- déclaration qui donne des IJ et des soins\n-- compte deux fois\nSELECT COUNT(*)          AS liquides,\n       ROUND(AVG(jours)) AS duree_moyenne,\n       MEDIAN(jours)     AS duree_mediane\nFROM   durees\n-- les déclarations sans prestation\n-- s'ajoutent aux déposés et aux en instance",
      "autoResize": true,
      "lineHeight": 1.25
    },
