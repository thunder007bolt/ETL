      "boundElements": [],
      "updated": 1793625970010,
      "link": null,
      "locked": false,
      "text": "La somme des lignes : chaque demande compte une fois sur sa ligne. Les réceptions qui n'ont encore donné aucune\nprestation comptent seulement dans le Total des déposés et des en instance. La durée moyenne du Total est\nrecalculée sur toutes les demandes.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "La somme des lignes : chaque demande compte une fois sur sa ligne. Les réceptions qui n'ont encore donné aucune\nprestation comptent seulement dans le Total des déposés et des en instance. La durée moyenne du Total est\nrecalculée sur toutes les demandes.",
      "autoResize": true,
      "lineHeight": 1.25
    },
