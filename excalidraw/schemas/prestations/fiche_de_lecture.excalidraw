    {
      "id": "xBXGOhzKbtw3LZUQUXcg",
      "type": "text",
      "x": 2093,
      "y": 28729.5,
      "width": 184.48000000000002,
      "height": 20.0,
      "angle": 0,
      "strokeColor": "#495057",
