    {
      "id": "Re0krbmZQHoN3bIrP8A7",
      "type": "text",
      "x": 2083,
      "y": 35745.5,
      "width": 473.28,
      "height": 340.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
