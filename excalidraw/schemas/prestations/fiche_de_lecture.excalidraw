    {
      "id": "NYQEYTZpSamiEGwYZFoI",
      "type": "text",
      "x": 2102,
      "y": 26157.0,
      "width": 426.88,
      "height": 260.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "64irMktiwiz7onKZfwYW"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 100029703,
      "version": 1,
      "versionNonce": 1014213913,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793704821347,
      "link": null,
      "locked": false,
      "text": "-- les pensions et rentes en cours au\n-- 31/12/2024, par code (sans les autres\n-- conditions du terme 2)\nSELECT TPE_CODE, COUNT(*)\nFROM   USER_DWH.PRESTATION_ESP\nWHERE  TPE_CODE IN ('RPV', 'RPRA', 'RPI',\n         'RPSV', 'RPSF', 'RPSE', 'RPA', 'ARI',\n         'ARSV', 'ARSF', 'ARSE', 'ARSA')\nAND    PE_DATE_EFFET <= DATE '2024-12-31'\nAND   (PE_DATE_RADIATION IS NULL\n       OR PE_DATE_RADIATION\n            > DATE '2024-12-31')\nGROUP  BY TPE_CODE",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-- les pensions et rentes en cours au\n-- 31/12/2024, par code (sans les autres\n-- conditions du terme 2)\nSELECT TPE_CODE, COUNT(*)\nFROM   USER_DWH.PRESTATION_ESP\nWHERE  TPE_CODE IN ('RPV', 'RPRA', 'RPI',\n         'RPSV', 'RPSF', 'RPSE', 'RPA', 'ARI',\n         'ARSV', 'ARSF', 'ARSE', 'ARSA')\nAND    PE_DATE_EFFET <= DATE '2024-12-31'\nAND   (PE_DATE_RADIATION IS NULL\n       OR PE_DATE_RADIATION\n            > DATE '2024-12-31')\nGROUP  BY TPE_CODE",
      "autoResize": true,
      "lineHeight": 1.25
    },
