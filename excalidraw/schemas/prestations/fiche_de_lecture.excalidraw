      "boundElements": [],
      "updated": 1793625970010,
      "link": null,
      "locked": false,
      "text": "Une allocation en cours le 31 décembre, comme pour T32, pour un enfant en vie de 21 ans au plus, et payée dans\nl'année. Sans la condition de paiement, on compterait 5 % de trop.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Une allocation en cours le 31 décembre, comme pour T32, pour un enfant en vie de 21 ans au plus, et payée dans\nl'année. Sans la condition de paiement, on compterait 5 % de trop.",
      "autoResize": true,
      "lineHeight": 1.25
    },
