    {
      "id": "5Bev4n9iZOkCjg2xRGK3",
      "type": "text",
      "x": 2112,
      "y": 22331.0,
      "width": 371.2,
      "height": 140.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
