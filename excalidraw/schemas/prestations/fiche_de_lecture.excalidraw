      "isDeleted": false,
      "boundElements": [],
      "updated": 1793704821347,
      "link": null,
      "locked": false,
      "text": "Les pensionnés sont l'« ensemble des bénéficiaires de pensions au titre de l'assurance vieillesse, invalidité et décès »\n(glossaire, p. 65), comptés à la fin de l'exercice (p. 13).",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Les pensionnés sont l'« ensemble des bénéficiaires de pensions au titre de l'assurance vieillesse, invalidité et décès »\n(glossaire, p. 65), comptés à la fin de l'exercice (p. 13).",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "CkCbjUm7jYkrL83mqh5L",
      "type": "text",
      "x": 39,
      "y": 26716.5,
      "width": 166.08,
      "height": 20.0,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "qsejUYkFjJ7QkSbCDYpf"
