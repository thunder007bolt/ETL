    {
      "id": "XNTDAKqo2xcPr5oZGoyn",
      "type": "text",
      "x": 39,
      "y": 18989.5,
      "width": 1031.76,
      "height": 67.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "5fCtY0kUSGYcxEafRWqQ"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 283491766,
      "version": 1,
      "versionNonce": 1427047304,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793704821347,
      "link": null,
      "locked": false,
      "text": "La somme des lignes : chaque demande compte une fois sur sa ligne. Une demande qui n'a encore donné aucune\nprestation n'a pas de ligne : elle compte seulement dans le Total des déposés et des en instance. La durée\nmoyenne du Total est recalculée sur toutes les demandes.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "La somme des lignes : chaque demande compte une fois sur sa ligne. Une demande qui n'a encore donné aucune\nprestation n'a pas de ligne : elle compte seulement dans le Total des déposés et des en instance. La durée\nmoyenne du Total est recalculée sur toutes les demandes.",
      "autoResize": true,
      "lineHeight": 1.25
    },
