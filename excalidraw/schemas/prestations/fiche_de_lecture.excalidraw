    {
      "id": "UHdjOkWSaAZKz6fuqs20",
      "type": "text",
      "x": 39,
      "y": 2925.5,
      "width": 1079.28,
      "height": 90.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
