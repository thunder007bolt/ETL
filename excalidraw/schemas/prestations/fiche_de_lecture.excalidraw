      "isDeleted": false,
      "boundElements": [],
      "updated": 1793704821347,
      "link": null,
      "locked": false,
      "text": "-- l'année 2024 moins l'année de naissance\nSELECT 2024 - EXTRACT(YEAR FROM\n         IND_DATE_NAISSANCE) AS age,\n       COUNT(DISTINCT IND_ID_PREST)\nFROM   pensions_2024\nGROUP  BY 2024 - EXTRACT(YEAR FROM\n            IND_DATE_NAISSANCE)\nORDER  BY 1\n-- 120 ans ou plus, ou vide : âge inconnu",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-- l'année 2024 moins l'année de naissance\nSELECT 2024 - EXTRACT(YEAR FROM\n         IND_DATE_NAISSANCE) AS age,\n       COUNT(DISTINCT IND_ID_PREST)\nFROM   pensions_2024\nGROUP  BY 2024 - EXTRACT(YEAR FROM\n            IND_DATE_NAISSANCE)\nORDER  BY 1\n-- 120 ans ou plus, ou vide : âge inconnu",
      "autoResize": true,
      "lineHeight": 1.25
    },
