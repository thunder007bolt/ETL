    {
      "id": "PcK4eYncCSnRo3G4euzd",
      "type": "text",
      "x": 2112,
      "y": 23728.0,
      "width": 361.91999999999996,
      "height": 140.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
