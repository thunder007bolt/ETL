    {
      "id": "V9WHLPedCrUdvie7WCvY",
      "type": "text",
      "x": 39,
      "y": 36693.0,
      "width": 1090.44,
      "height": 67.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
