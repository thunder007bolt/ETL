      "seed": 368628066,
      "version": 1,
      "versionNonce": 758830271,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793638601505,
      "link": null,
      "locked": false,
      "text": "-- payé en 2024, au mois payé, pour les\n-- pensions comptées\nSELECT SUM(deb.DEB_MONTANT)\nFROM   USER_DWH.DEBOURS deb\nWHERE  deb.PE_ID IN\n       (SELECT PE_ID FROM pensions_2024)\nAND    deb.DEB_TYPE = 'PM'\nAND    deb.DEB_STATUT IN ('D', 'P')\nAND    deb.DEB_DATE_EFFET >= DATE '2024-01-01'\nAND    deb.DEB_DATE_EFFET <  DATE '2025-01-01'\n-- D payé par effet, P payé sans effet\n-- 2024 : 37,67 Md",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-- payé en 2024, au mois payé, pour les\n-- pensions comptées\nSELECT SUM(deb.DEB_MONTANT)\nFROM   USER_DWH.DEBOURS deb\nWHERE  deb.PE_ID IN\n       (SELECT PE_ID FROM pensions_2024)\nAND    deb.DEB_TYPE = 'PM'\nAND    deb.DEB_STATUT IN ('D', 'P')\nAND    deb.DEB_DATE_EFFET >= DATE '2024-01-01'\nAND    deb.DEB_DATE_EFFET <  DATE '2025-01-01'\n-- D payé par effet, P payé sans effet\n-- 2024 : 37,67 Md",
      "autoResize": true,
      "lineHeight": 1.25
    },
