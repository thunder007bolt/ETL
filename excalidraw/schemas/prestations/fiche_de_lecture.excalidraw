    },
    {
      "id": "EHG5XwK10MaO2W5uAePf",
      "type": "text",
      "x": 39,
      "y": 14648.0,
      "width": 1082.5200000000002,
      "height": 90.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "g1g3afLiflkNBgOGkEHK"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 773592120,
      "version": 1,
      "versionNonce": 1523340155,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793704821347,
      "link": null,
      "locked": false,
      "text": "Les allocations familiales sont celles de l'allocataire, pour ses enfants. Les IJ de maternité et l'allocation\nprénatale viennent du dossier de la grossesse. Il reste une ancienne allocation prénatale des PF, payée 33 fois\nen 2025 : je la mets avec les allocations prénatales. Aucune autre prestation n'est payée aujourd'hui : des\nfrais de maternité sont prévus dans la base, jamais payés.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Les allocations familiales sont celles de l'allocataire, pour ses enfants. Les IJ de maternité et l'allocation\nprénatale viennent du dossier de la grossesse. Il reste une ancienne allocation prénatale des PF, payée 33 fois\nen 2025 : je la mets avec les allocations prénatales. Aucune autre prestation n'est payée aujourd'hui : des\nfrais de maternité sont prévus dans la base, jamais payés.",
      "autoResize": true,
      "lineHeight": 1.25
    },
