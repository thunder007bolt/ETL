    {
      "id": "AxiUqgNjx58sZLFnnNOz",
      "type": "text",
      "x": 39,
      "y": 6477.5,
      "width": 1083.96,
      "height": 67.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "mcEUJExweA2w9xzqRc9L"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 546054483,
      "version": 1,
      "versionNonce": 1263229403,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793704821347,
      "link": null,
      "locked": false,
      "text": "La somme des lignes : chaque demande compte une fois. Une demande pas encore étudiée n'a pas de ligne, car on ne\nsait pas encore quelle pension elle donnera : elle compte seulement dans le Total des déposés et des en\ninstance. La durée moyenne du Total est recalculée sur toutes les demandes, pas tirée des moyennes des lignes.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "La somme des lignes : chaque demande compte une fois. Une demande pas encore étudiée n'a pas de ligne, car on ne\nsait pas encore quelle pension elle donnera : elle compte seulement dans le Total des déposés et des en\ninstance. La durée moyenne du Total est recalculée sur toutes les demandes, pas tirée des moyennes des lignes.",
      "autoResize": true,
      "lineHeight": 1.25
    },
