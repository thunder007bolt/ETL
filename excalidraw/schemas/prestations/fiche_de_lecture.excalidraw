    {
      "id": "jtC7lUNmfaUvrLiQmFeh",
      "type": "text",
      "x": 39,
      "y": 9739.0,
      "width": 1069.56,
      "height": 67.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
