      "type": "text",
      "x": 39,
      "y": 38809.5,
      "width": 1083.6000000000001,
      "height": 45.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
