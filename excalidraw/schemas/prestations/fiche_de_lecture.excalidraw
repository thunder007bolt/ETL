      "link": null,
      "locked": false,
      "text": "-- tous les dossiers AT/MP (type A) ; la\n-- déclaration d'accident ou de maladie est\n-- la réception qui a ouvert le dossier\nSELECT COUNT(*)       AS dossiers,\n       COUNT(RD_ID)   AS avec_declaration\nFROM   USER_DWH.DOSSIER\nWHERE  TDOS_CODE = 'A'",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-- tous les dossiers AT/MP (type A) ; la\n-- déclaration d'accident ou de maladie est\n-- la réception qui a ouvert le dossier\nSELECT COUNT(*)       AS dossiers,\n       COUNT(RD_ID)   AS avec_declaration\nFROM   USER_DWH.DOSSIER\nWHERE  TDOS_CODE = 'A'",
      "autoResize": true,
      "lineHeight": 1.25
    },
