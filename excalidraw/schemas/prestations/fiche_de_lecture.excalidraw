    {
      "id": "0yXUaWfrG7htAWHrOozk",
      "type": "text",
      "x": 2102,
      "y": 27656.0,
      "width": 389.76,
      "height": 180.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
