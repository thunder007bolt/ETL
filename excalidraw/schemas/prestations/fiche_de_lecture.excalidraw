    {
      "id": "9WzJpAAXPOnrYoCTePMk",
      "type": "text",
      "x": 2112,
      "y": 25113.0,
      "width": 184.48000000000002,
      "height": 20.0,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
