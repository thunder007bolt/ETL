        "iP1DsxJcogoBCgn3ZDOM"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 215193560,
      "version": 1,
      "versionNonce": 511977937,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793704821347,
      "link": null,
      "locked": false,
      "text": "-- T56 : paiements (PM) et remboursements\n-- (RB) de 2024 par branche, sans les\n-- ajustements\nSELECT DECODE(CODE_BRANCHE, 'V', 'AVS',\n         'A', 'AT/MP', 'F', 'PF', 'M', 'PF',\n         'AUTRES') AS branche,\n       SUM(DEB_MONTANT)\nFROM   USER_DWH.DEBOURS\nWHERE  DEB_TYPE IN ('PM', 'RB')\nAND    DEB_STATUT IN ('D', 'P')\nAND    DEB_DATE_EFFET >= DATE '2024-01-01'\nAND    DEB_DATE_EFFET <  DATE '2025-01-01'\nGROUP  BY DECODE(CODE_BRANCHE, 'V', 'AVS',\n            'A', 'AT/MP', 'F', 'PF',\n            'M', 'PF', 'AUTRES')\n-- 2024, au mois payé : AVS 47,24 Md\n-- (l'annuaire : 46,63), PF 10,75 (11,18),\n-- AT/MP 0,76 (1,07)",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-- T56 : paiements (PM) et remboursements\n-- (RB) de 2024 par branche, sans les\n-- ajustements\nSELECT DECODE(CODE_BRANCHE, 'V', 'AVS',\n         'A', 'AT/MP', 'F', 'PF', 'M', 'PF',\n         'AUTRES') AS branche,\n       SUM(DEB_MONTANT)\nFROM   USER_DWH.DEBOURS\nWHERE  DEB_TYPE IN ('PM', 'RB')\nAND    DEB_STATUT IN ('D', 'P')\nAND    DEB_DATE_EFFET >= DATE '2024-01-01'\nAND    DEB_DATE_EFFET <  DATE '2025-01-01'\nGROUP  BY DECODE(CODE_BRANCHE, 'V', 'AVS',\n            'A', 'AT/MP', 'F', 'PF',\n            'M', 'PF', 'AUTRES')\n-- 2024, au mois payé : AVS 47,24 Md\n-- (l'annuaire : 46,63), PF 10,75 (11,18),\n-- AT/MP 0,76 (1,07)",
      "autoResize": true,
      "lineHeight": 1.25
    },
