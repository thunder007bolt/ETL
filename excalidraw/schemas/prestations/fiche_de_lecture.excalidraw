    {
      "id": "yKi53cAq3kCvuJf7PraO",
      "type": "text",
      "x": 2102,
      "y": 27241.0,
      "width": 426.88,
      "height": 240.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
