    {
      "id": "E3I2p9jXk3qOcZxR4CpG",
      "type": "text",
      "x": 2083,
      "y": 34289.5,
      "width": 436.15999999999997,
      "height": 260.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "ooZJ83Pz2CBEpK9eZEHM"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1665043047,
      "version": 1,
      "versionNonce": 1754991354,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793638601505,
      "link": null,
      "locked": false,
      "text": "-- la terme 2 regroupe par personne : une\n-- seule fois, même si la pension s'arrête\n-- avant le 31/12 ; une révision n'entre\n-- pas, car la première saisie est plus\n-- ancienne. Les révisions de 2024 :\nSELECT COUNT(*)\nFROM   USER_DWH.PRESTATION_ESP\nWHERE  TPE_CODE IN ('RPV', 'RPRA')\nAND    PE_DATE_INSERT >= DATE '2024-01-01'\nAND    PE_DATE_INSERT <  DATE '2025-01-01'\nAND    IND_ID_PREST NOT IN\n       (SELECT IND_ID_PREST FROM nouveaux_2024)\n-- 18 à 47 par an jusqu'en 2024",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-- la terme 2 regroupe par personne : une\n-- seule fois, même si la pension s'arrête\n-- avant le 31/12 ; une révision n'entre\n-- pas, car la première saisie est plus\n-- ancienne. Les révisions de 2024 :\nSELECT COUNT(*)\nFROM   USER_DWH.PRESTATION_ESP\nWHERE  TPE_CODE IN ('RPV', 'RPRA')\nAND    PE_DATE_INSERT >= DATE '2024-01-01'\nAND    PE_DATE_INSERT <  DATE '2025-01-01'\nAND    IND_ID_PREST NOT IN\n       (SELECT IND_ID_PREST FROM nouveaux_2024)\n-- 18 à 47 par an jusqu'en 2024",
      "autoResize": true,
      "lineHeight": 1.25
    },
