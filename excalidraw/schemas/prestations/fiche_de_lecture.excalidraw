      "link": null,
      "locked": false,
      "text": "-- dossiers de pension (type V) par\n-- catégorie ; les transférés (CNSS_AC)\n-- sont écartés dans toutes les règles\nSELECT NVL(DOS_CATEGORIE, 'ORDINAIRE')\n         AS categorie,\n       COUNT(*)\nFROM   USER_DWH.DOSSIER\nWHERE  TDOS_CODE = 'V'\nGROUP  BY NVL(DOS_CATEGORIE, 'ORDINAIRE')\n-- COOR_AC : coordination payée par une\n--           autre caisse, gardée (3 326)\n-- CNSS_AC : transféré à une autre\n--           caisse, écarté (153)",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-- dossiers de pension (type V) par\n-- catégorie ; les transférés (CNSS_AC)\n-- sont écartés dans toutes les règles\nSELECT NVL(DOS_CATEGORIE, 'ORDINAIRE')\n         AS categorie,\n       COUNT(*)\nFROM   USER_DWH.DOSSIER\nWHERE  TDOS_CODE = 'V'\nGROUP  BY NVL(DOS_CATEGORIE, 'ORDINAIRE')\n-- COOR_AC : coordination payée par une\n--           autre caisse, gardée (3 326)\n-- CNSS_AC : transféré à une autre\n--           caisse, écarté (153)",
      "autoResize": true,
      "lineHeight": 1.25
    },
