    },
    {
      "id": "jzXxK0VevBix65kjTWb3",
      "type": "text",
      "x": 2083,
      "y": 36326.0,
      "width": 436.15999999999997,
      "height": 420.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "4nWl35PN3JoicTtZc66w"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1886627755,
      "version": 1,
      "versionNonce": 795994626,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793638601505,
      "link": null,
      "locked": false,
      "text": "-- les mois cotisés de la dernière pension\n-- saisie ; en coordination, moins les\n-- mois dans l'autre caisse (PE_COT_AUTRE)\nSELECT SUM(GREATEST(p.PE_MOIS_COTISATION\n             - NVL(p.PE_COT_AUTRE, 0), 0))\n         AS services_passes_mois\nFROM   USER_DWH.PRESTATION_ESP p\nJOIN   nouveaux_2024 n\n       ON n.IND_ID_PREST = p.IND_ID_PREST\nWHERE  p.TPE_CODE IN ('RPV', 'RPRA')\nAND    p.PE_MOIS_COTISATION BETWEEN 1 AND 600\nAND    p.PE_DATE_INSERT = (\n         SELECT MAX(x.PE_DATE_INSERT)\n         FROM   USER_DWH.PRESTATION_ESP x\n         WHERE  x.IND_ID_PREST = p.IND_ID_PREST\n         AND    x.TPE_CODE IN ('RPV', 'RPRA')\n         AND    x.PE_DATE_INSERT\n                  < DATE '2025-01-01')\n-- par tranche et par sexe : GROUP BY ;\n-- 2024 : 270 mois en médiane (22 ans et\n-- demi) pour les dossiers ordinaires",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-- les mois cotisés de la dernière pension\n-- saisie ; en coordination, moins les\n-- mois dans l'autre caisse (PE_COT_AUTRE)\nSELECT SUM(GREATEST(p.PE_MOIS_COTISATION\n             - NVL(p.PE_COT_AUTRE, 0), 0))\n         AS services_passes_mois\nFROM   USER_DWH.PRESTATION_ESP p\nJOIN   nouveaux_2024 n\n       ON n.IND_ID_PREST = p.IND_ID_PREST\nWHERE  p.TPE_CODE IN ('RPV', 'RPRA')\nAND    p.PE_MOIS_COTISATION BETWEEN 1 AND 600\nAND    p.PE_DATE_INSERT = (\n         SELECT MAX(x.PE_DATE_INSERT)\n         FROM   USER_DWH.PRESTATION_ESP x\n         WHERE  x.IND_ID_PREST = p.IND_ID_PREST\n         AND    x.TPE_CODE IN ('RPV', 'RPRA')\n         AND    x.PE_DATE_INSERT\n                  < DATE '2025-01-01')\n-- par tranche et par sexe : GROUP BY ;\n-- 2024 : 270 mois en médiane (22 ans et\n-- demi) pour les dossiers ordinaires",
      "autoResize": true,
      "lineHeight": 1.25
    },
