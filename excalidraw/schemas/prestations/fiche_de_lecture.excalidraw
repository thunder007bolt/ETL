      "isDeleted": false,
      "boundElements": [],
      "updated": 1793704821347,
      "link": null,
      "locked": false,
      "text": "Tu valides : un nouveau pensionné compte l'année où sa pension est saisie, et non l'année où la décision lui est\nenvoyée ?",
