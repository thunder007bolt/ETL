      "isDeleted": false,
      "boundElements": [],
      "updated": 1793638601505,
      "link": null,
      "locked": false,
      "text": "Pour vérifier (2024)",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Pour vérifier (2024)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "IOzUoW9cg4C3KcuwcheX",
      "type": "text",
      "x": 2093,
      "y": 29814.0,
      "width": 426.88,
      "height": 780.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "LpREqQtfJTNCcgxKpWpj"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 247967161,
      "version": 1,
      "versionNonce": 601562212,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793638601505,
      "link": null,
      "locked": false,
      "text": "-- la liste des enfants comptés en 2024,\n-- réutilisée ensuite\nWITH enfants_2024 AS (\n  SELECT p.PE_ID, p.DOS_CODE, p.IND_ID_PREST\n  FROM   USER_DWH.PRESTATION_ESP p\n  JOIN   USER_DWH.INDIVIDU i\n         ON i.IND_ID = p.IND_ID_PREST\n  WHERE  p.TPE_CODE = 'FAF'\n  -- en cours au 31/12, comme dans T32\n  AND    p.PE_DATE_EFFET <= DATE '2024-12-31'\n  AND   (p.PE_DATE_RADIATION IS NULL\n         OR p.PE_DATE_RADIATION\n              > DATE '2024-12-31')\n  AND   (p.PE_DATE_SUSPENSION IS NULL\n         OR p.PE_DATE_SUSPENSION\n              > DATE '2024-12-31'\n         OR p.PE_DATE_REACTIVATION\n              BETWEEN p.PE_DATE_SUSPENSION\n                  AND DATE '2024-12-31')\n  -- enfant en vie, de 21 ans au plus\n  AND   (i.IND_DATE_DECES IS NULL\n         OR i.IND_DATE_DECES\n              > DATE '2024-12-31')\n  AND    2024 - EXTRACT(YEAR FROM\n           i.IND_DATE_NAISSANCE) <= 21\n  -- et payé dans l'année\n  AND    p.PE_ID IN (\n           SELECT deb.PE_ID\n           FROM   USER_DWH.DEBOURS deb\n           WHERE  deb.DEB_TYPE = 'PM'\n           AND    deb.DEB_STATUT IN ('D', 'P')\n           AND    deb.DEB_DATE_EFFET\n                    >= DATE '2024-01-01'\n           AND    deb.DEB_DATE_EFFET\n                    <  DATE '2025-01-01'))\nSELECT COUNT(DISTINCT IND_ID_PREST)\nFROM   enfants_2024\n-- 2024 : 271 577 enfants (l'annuaire :\n-- 268 481)",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-- la liste des enfants comptés en 2024,\n-- réutilisée ensuite\nWITH enfants_2024 AS (\n  SELECT p.PE_ID, p.DOS_CODE, p.IND_ID_PREST\n  FROM   USER_DWH.PRESTATION_ESP p\n  JOIN   USER_DWH.INDIVIDU i\n         ON i.IND_ID = p.IND_ID_PREST\n  WHERE  p.TPE_CODE = 'FAF'\n  -- en cours au 31/12, comme dans T32\n  AND    p.PE_DATE_EFFET <= DATE '2024-12-31'\n  AND   (p.PE_DATE_RADIATION IS NULL\n         OR p.PE_DATE_RADIATION\n              > DATE '2024-12-31')\n  AND   (p.PE_DATE_SUSPENSION IS NULL\n         OR p.PE_DATE_SUSPENSION\n              > DATE '2024-12-31'\n         OR p.PE_DATE_REACTIVATION\n              BETWEEN p.PE_DATE_SUSPENSION\n                  AND DATE '2024-12-31')\n  -- enfant en vie, de 21 ans au plus\n  AND   (i.IND_DATE_DECES IS NULL\n         OR i.IND_DATE_DECES\n              > DATE '2024-12-31')\n  AND    2024 - EXTRACT(YEAR FROM\n           i.IND_DATE_NAISSANCE) <= 21\n  -- et payé dans l'année\n  AND    p.PE_ID IN (\n           SELECT deb.PE_ID\n           FROM   USER_DWH.DEBOURS deb\n           WHERE  deb.DEB_TYPE = 'PM'\n           AND    deb.DEB_STATUT IN ('D', 'P')\n           AND    deb.DEB_DATE_EFFET\n                    >= DATE '2024-01-01'\n           AND    deb.DEB_DATE_EFFET\n                    <  DATE '2025-01-01'))\nSELECT COUNT(DISTINCT IND_ID_PREST)\nFROM   enfants_2024\n-- 2024 : 271 577 enfants (l'annuaire :\n-- 268 481)",
      "autoResize": true,
      "lineHeight": 1.25
    },
