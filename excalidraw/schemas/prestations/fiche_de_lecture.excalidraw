      "updated": 1793625970010,
      "link": null,
      "locked": false,
      "text": "Un dossier dont le refus a été enregistré dans l'année, dans le module des rejets. Il sert peu (atelier de Kaya)\n: une demande sans suite n'est ni fermée ni rejetée.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Un dossier dont le refus a été enregistré dans l'année, dans le module des rejets. Il sert peu (atelier de Kaya)\n: une demande sans suite n'est ni fermée ni rejetée.",
      "autoResize": true,
      "lineHeight": 1.25
    },
