      "isDeleted": false,
      "boundElements": [],
      "updated": 1793625970010,
      "link": null,
      "locked": false,
      "text": "Ce que j'ai compris",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Ce que j'ai compris",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "OGjbuHHLh3JgL1a7rJ5F",
      "type": "text",
      "x": 39,
      "y": 13276.5,
      "width": 1084.32,
      "height": 67.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "frwcgqtBaK7oXdkc3LgD"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 196104981,
      "version": 1,
      "versionNonce": 31668540,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793625970010,
      "link": null,
      "locked": false,
      "text": "Deux sortes de dossiers dans la branche : celui de l'allocataire, pour les allocations familiales de tous ses\nenfants, et celui d'une grossesse, pour la maternité. La maternité est rattachée aux prestations familiales ; ce\nn'est pas la maladie, aucun soin n'y est payé.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Deux sortes de dossiers dans la branche : celui de l'allocataire, pour les allocations familiales de tous ses\nenfants, et celui d'une grossesse, pour la maternité. La maternité est rattachée aux prestations familiales ; ce\nn'est pas la maladie, aucun soin n'y est payé.",
      "autoResize": true,
      "lineHeight": 1.25
    },
