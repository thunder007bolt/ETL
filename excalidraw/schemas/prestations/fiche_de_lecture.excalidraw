    {
      "id": "saBEzjKnycmcLtfRybYy",
      "type": "text",
      "x": 2074,
      "y": 6607.0,
      "width": 389.76,
      "height": 180.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
