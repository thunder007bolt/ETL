      "boundElements": [],
      "updated": 1793638601505,
      "link": null,
      "locked": false,
      "text": "Cinq lignes : rentes viagères, rentes de survivants, indemnités journalières, allocation AT/MP, autres prestations de la\nbranche, puis le TOTAL (p. 34).",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Cinq lignes : rentes viagères, rentes de survivants, indemnités journalières, allocation AT/MP, autres prestations de la\nbranche, puis le TOTAL (p. 34).",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "YKc5mvCsl7a4jzaeuSO8",
      "type": "text",
      "x": 39,
      "y": 7876.5,
      "width": 166.08,
      "height": 20.0,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "nddEPqF0sGe6vzwZo1Dp"
      ],
