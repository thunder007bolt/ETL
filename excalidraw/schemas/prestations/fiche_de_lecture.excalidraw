    {
      "id": "seEd3yGnEBcpr4EGGXuV",
      "type": "text",
      "x": 39,
      "y": 22854.5,
      "width": 1106.28,
      "height": 45.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
