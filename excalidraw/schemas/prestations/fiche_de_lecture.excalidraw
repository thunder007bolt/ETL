    {
      "id": "gEAiv3R8d3GWb5GFxs8q",
      "type": "text",
      "x": 2083,
      "y": 18695.5,
      "width": 399.03999999999996,
      "height": 180.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
