    {
      "id": "yEyrjYjCtaHbIqrvo7p9",
      "type": "text",
      "x": 45,
      "y": 775.5,
      "width": 2484.36,
      "height": 45.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "pHY6WCmKzNd1J5dhNi8I"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1825552751,
      "version": 1,
      "versionNonce": 2045281234,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793704821347,
      "link": null,
      "locked": false,
      "text": "Dans l'ordre de l'Annuaire CIPRES : T25, T26 et T27 (les dossiers selon la durée de liquidation), T28 à T30 (les contrôles a posteriori), T31 (les prestations indues), T32 à T40 (pensionnés et crédirentiers au 31 décembre), T41 (allocataires), T42\nà T49 (nouveaux bénéficiaires), T50 à T57 (évolution sur 5 ans, prestations servies et décédés par branche).",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Dans l'ordre de l'Annuaire CIPRES : T25, T26 et T27 (les dossiers selon la durée de liquidation), T28 à T30 (les contrôles a posteriori), T31 (les prestations indues), T32 à T40 (pensionnés et crédirentiers au 31 décembre), T41 (allocataires), T42\nà T49 (nouveaux bénéficiaires), T50 à T57 (évolution sur 5 ans, prestations servies et décédés par branche).",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "2xAk1WZEAqjDL59IDmXy",
      "type": "text",
      "x": 45,
      "y": 830.5,
      "width": 2463.12,
      "height": 45.0,
      "angle": 0,
