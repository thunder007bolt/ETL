    {
      "id": "YnEHvhQsmfugRAgCKntY",
      "type": "text",
      "x": 2130,
      "y": 20853.5,
      "width": 408.32,
      "height": 180.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "I0hzFe2Bi1SaiWL7whOS"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1334979118,
      "version": 1,
      "versionNonce": 561091527,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793704821347,
      "link": null,
      "locked": false,
      "text": "SELECT TDOS_CODE,\n       TO_CHAR(DC_DATE_CONTROLE, 'Q')\n         AS trimestre,\n       COUNT(DISTINCT DOS_CODE) AS controles\nFROM   USER_DWH.DOSSIERS_CONTROLES\nWHERE  DC_DATE_CONTROLE >= DATE '2025-01-01'\nAND    DC_DATE_CONTROLE <  DATE '2026-01-01'\nGROUP  BY TDOS_CODE,\n          TO_CHAR(DC_DATE_CONTROLE, 'Q')",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "SELECT TDOS_CODE,\n       TO_CHAR(DC_DATE_CONTROLE, 'Q')\n         AS trimestre,\n       COUNT(DISTINCT DOS_CODE) AS controles\nFROM   USER_DWH.DOSSIERS_CONTROLES\nWHERE  DC_DATE_CONTROLE >= DATE '2025-01-01'\nAND    DC_DATE_CONTROLE <  DATE '2026-01-01'\nGROUP  BY TDOS_CODE,\n          TO_CHAR(DC_DATE_CONTROLE, 'Q')",
      "autoResize": true,
      "lineHeight": 1.25
    },
