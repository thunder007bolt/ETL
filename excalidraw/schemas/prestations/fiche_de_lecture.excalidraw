    },
    {
      "id": "qaaNIWyLCxKK6uRc0Ci9",
      "type": "text",
      "x": 2083,
      "y": 35348.0,
      "width": 389.76,
      "height": 220.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "uVS3PT7Z34HQgAptWda3"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 2065882211,
      "version": 1,
      "versionNonce": 517331571,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793704821347,
      "link": null,
      "locked": false,
      "text": "-- l'année 2024 moins l'année de naissance\nSELECT 2024 - EXTRACT(YEAR FROM\n         i.IND_DATE_NAISSANCE) AS age,\n       COUNT(*)\nFROM   nouveaux_2024 n\nJOIN   USER_DWH.INDIVIDU i\n       ON i.IND_ID = n.IND_ID_PREST\nGROUP  BY 2024 - EXTRACT(YEAR FROM\n            i.IND_DATE_NAISSANCE)\nORDER  BY 1\n-- 120 ans ou plus, ou vide : âge inconnu",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-- l'année 2024 moins l'année de naissance\nSELECT 2024 - EXTRACT(YEAR FROM\n         i.IND_DATE_NAISSANCE) AS age,\n       COUNT(*)\nFROM   nouveaux_2024 n\nJOIN   USER_DWH.INDIVIDU i\n       ON i.IND_ID = n.IND_ID_PREST\nGROUP  BY 2024 - EXTRACT(YEAR FROM\n            i.IND_DATE_NAISSANCE)\nORDER  BY 1\n-- 120 ans ou plus, ou vide : âge inconnu",
      "autoResize": true,
      "lineHeight": 1.25
    },
