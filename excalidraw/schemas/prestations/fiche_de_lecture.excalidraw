    {
      "id": "6AJ8Us5Pj7YdLUteG2vJ",
      "type": "text",
      "x": 2130,
      "y": 19383.0,
      "width": 389.76,
      "height": 180.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
