    {
      "id": "D1sGzm0LuExNvgq7r3rR",
      "type": "text",
      "x": 2112,
      "y": 23605.5,
      "width": 184.48000000000002,
      "height": 20.0,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
