    {
      "id": "UskUelW39X15RYBhCE1r",
      "type": "text",
      "x": 2083,
      "y": 33115.0,
      "width": 436.15999999999997,
      "height": 260.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "Sj1Sa7ZcHh5BCZiqhlB7"
