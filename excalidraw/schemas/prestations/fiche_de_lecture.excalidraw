      "isDeleted": false,
      "boundElements": [],
      "updated": 1793704821347,
      "link": null,
      "locked": false,
      "text": "• DOSSIER_REJETE : les refus enregistrés, avec DOSRE_DATE_REJET et le motif.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "• DOSSIER_REJETE : les refus enregistrés, avec DOSRE_DATE_REJET et le motif.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "5p63RjfE7xewqZ0ndTpQ",
