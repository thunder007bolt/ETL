      "versionNonce": 1315077511,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793625970010,
      "link": null,
      "locked": false,
      "text": "Tu valides : une demande qui attend depuis des années sort du stock (reçue avant 2016 sans dossier, ou dossier\nfermé) ?",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Tu valides : une demande qui attend depuis des années sort du stock (reçue avant 2016 sans dossier, ou dossier\nfermé) ?",
      "autoResize": true,
      "lineHeight": 1.25
    },
