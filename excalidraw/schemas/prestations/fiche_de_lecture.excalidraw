    {
      "id": "CzYURItNCFcDC9wmmdan",
      "type": "text",
      "x": 39,
      "y": 34415.5,
      "width": 1063.44,
      "height": 45.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
