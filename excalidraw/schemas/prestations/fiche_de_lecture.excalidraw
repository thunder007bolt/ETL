    {
      "id": "vOnxjtYKik6gMcKRtUn5",
      "type": "text",
      "x": 2083,
      "y": 35508.5,
      "width": 380.47999999999996,
      "height": 160.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
