      "text": "Les tables de la base des prestations (schéma USER_DWH)",
      "fontSize": 22,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Les tables de la base des prestations (schéma USER_DWH)",
      "autoResize": true,
