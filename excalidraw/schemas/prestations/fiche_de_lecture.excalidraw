    {
      "id": "tKueH1gr2MLkBsl9VyFh",
      "type": "text",
      "x": 2102,
      "y": 28667.5,
      "width": 389.76,
      "height": 400.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "IlRRbw2iv0es110JAU2L"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1814528917,
      "version": 1,
      "versionNonce": 1545547400,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793638601505,
      "link": null,
      "locked": false,
      "text": "-- le Total et la pension moyenne ; par\n-- tranche : ajouter la tranche de la\n-- terme 5 et un GROUP BY\nSELECT COUNT(DISTINCT e.IND_ID_PREST)\n         AS effectif,\n       SUM(deb.DEB_MONTANT) AS montant,\n       ROUND(SUM(deb.DEB_MONTANT)\n         / COUNT(DISTINCT e.IND_ID_PREST))\n         AS pension_moyenne\nFROM   pensions_2024 e\nLEFT   JOIN USER_DWH.DEBOURS deb\n       ON  deb.PE_ID = e.PE_ID\n       AND deb.DEB_TYPE = 'PM'\n       AND deb.DEB_STATUT IN ('D', 'P')\n       AND deb.DEB_DATE_EFFET\n             >= DATE '2024-01-01'\n       AND deb.DEB_DATE_EFFET\n             <  DATE '2025-01-01'\n-- 2024 : environ 1,2 M FCFA par retraité\n-- et par an",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-- le Total et la pension moyenne ; par\n-- tranche : ajouter la tranche de la\n-- terme 5 et un GROUP BY\nSELECT COUNT(DISTINCT e.IND_ID_PREST)\n         AS effectif,\n       SUM(deb.DEB_MONTANT) AS montant,\n       ROUND(SUM(deb.DEB_MONTANT)\n         / COUNT(DISTINCT e.IND_ID_PREST))\n         AS pension_moyenne\nFROM   pensions_2024 e\nLEFT   JOIN USER_DWH.DEBOURS deb\n       ON  deb.PE_ID = e.PE_ID\n       AND deb.DEB_TYPE = 'PM'\n       AND deb.DEB_STATUT IN ('D', 'P')\n       AND deb.DEB_DATE_EFFET\n             >= DATE '2024-01-01'\n       AND deb.DEB_DATE_EFFET\n             <  DATE '2025-01-01'\n-- 2024 : environ 1,2 M FCFA par retraité\n-- et par an",
      "autoResize": true,
      "lineHeight": 1.25
    },
