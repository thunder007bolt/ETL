      "isDeleted": false,
      "boundElements": [],
      "updated": 1793704821347,
      "link": null,
      "locked": false,
      "text": "Tu valides : l'allocation de survivants se compte par part, une par survivant (conjoint, orphelin, ascendant) ?",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Tu valides : l'allocation de survivants se compte par part, une par survivant (conjoint, orphelin, ascendant) ?",
      "autoResize": true,
      "lineHeight": 1.25
    },
