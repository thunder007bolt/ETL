    {
      "id": "XXRM9ytAyVT5QP4rTZ0S",
      "type": "text",
      "x": 2083,
      "y": 18068.5,
      "width": 408.32,
      "height": 140.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
