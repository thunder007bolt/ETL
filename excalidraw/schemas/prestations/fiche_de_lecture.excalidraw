    },
    {
      "id": "mTKK33qaAZREoW8jl8yS",
      "type": "text",
      "x": 2083,
      "y": 9593.0,
      "width": 473.28,
      "height": 900.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "PDJwyGv3gQyuI7iKF0OL"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1913041232,
      "version": 1,
      "versionNonce": 256106208,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793638601505,
      "link": null,
      "locked": false,
      "text": "-- à ajouter à la suite du WITH de la\n-- terme 4 : le dépôt et la durée\ndepots AS (\n  SELECT dm.ligne, dm.date_liquidation,\n         -- la déclaration\n         (SELECT r.RD_DATE_RECEPTION\n          FROM   USER_DWH.DOSSIER d\n          JOIN   USER_DWH.RECEPTION_DOSSIER r\n                 ON r.RD_ID = d.RD_ID\n          WHERE  d.DOS_CODE = dm.DOS_CODE)\n                             AS date_declaration,\n         -- la demande au guichet d'une rente\n         (SELECT MAX(r.RD_DATE_RECEPTION)\n          FROM   USER_DWH.RECEPTION_DOSSIER r\n          WHERE  r.DOS_CODE = dm.DOS_CODE\n          AND    r.RD_TYPE_RECEPTION = 'ANCIEN'\n          AND    r.RD_DATE_RECEPTION\n                   <= dm.date_liquidation)\n                             AS date_guichet,\n         -- le certificat pour la rente\n         (SELECT d.DOS_DATE_REC_CM_RENTE\n          FROM   USER_DWH.DOSSIER d\n          WHERE  d.DOS_CODE = dm.DOS_CODE)\n                             AS date_certificat\n  FROM   demandes dm\n  WHERE  dm.date_liquidation >= DATE '2025-01-01'\n  AND    dm.date_liquidation <  DATE '2026-01-01'),\ndurees AS (\n  -- IJ et soins (3, 5) : la déclaration ;\n  -- rentes et allocation : le guichet, sinon\n  -- le certificat, sinon la déclaration\n  SELECT ligne,\n         GREATEST(TRUNC(date_liquidation)\n           - TRUNC(CASE WHEN ligne IN (3, 5)\n                        THEN date_declaration\n                        ELSE COALESCE(date_guichet,\n                               date_certificat,\n                               date_declaration)\n                   END), 0) AS jours\n  FROM   depots)\nSELECT ligne, MEDIAN(jours)\nFROM   durees\nGROUP  BY ligne\n-- 2025 : rentes 14 j, survivants 35, IJ 251,\n-- allocations 13, soins environ 155",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-- à ajouter à la suite du WITH de la\n-- terme 4 : le dépôt et la durée\ndepots AS (\n  SELECT dm.ligne, dm.date_liquidation,\n         -- la déclaration\n         (SELECT r.RD_DATE_RECEPTION\n          FROM   USER_DWH.DOSSIER d\n          JOIN   USER_DWH.RECEPTION_DOSSIER r\n                 ON r.RD_ID = d.RD_ID\n          WHERE  d.DOS_CODE = dm.DOS_CODE)\n                             AS date_declaration,\n         -- la demande au guichet d'une rente\n         (SELECT MAX(r.RD_DATE_RECEPTION)\n          FROM   USER_DWH.RECEPTION_DOSSIER r\n          WHERE  r.DOS_CODE = dm.DOS_CODE\n          AND    r.RD_TYPE_RECEPTION = 'ANCIEN'\n          AND    r.RD_DATE_RECEPTION\n                   <= dm.date_liquidation)\n                             AS date_guichet,\n         -- le certificat pour la rente\n         (SELECT d.DOS_DATE_REC_CM_RENTE\n          FROM   USER_DWH.DOSSIER d\n          WHERE  d.DOS_CODE = dm.DOS_CODE)\n                             AS date_certificat\n  FROM   demandes dm\n  WHERE  dm.date_liquidation >= DATE '2025-01-01'\n  AND    dm.date_liquidation <  DATE '2026-01-01'),\ndurees AS (\n  -- IJ et soins (3, 5) : la déclaration ;\n  -- rentes et allocation : le guichet, sinon\n  -- le certificat, sinon la déclaration\n  SELECT ligne,\n         GREATEST(TRUNC(date_liquidation)\n           - TRUNC(CASE WHEN ligne IN (3, 5)\n                        THEN date_declaration\n                        ELSE COALESCE(date_guichet,\n                               date_certificat,\n                               date_declaration)\n                   END), 0) AS jours\n  FROM   depots)\nSELECT ligne, MEDIAN(jours)\nFROM   durees\nGROUP  BY ligne\n-- 2025 : rentes 14 j, survivants 35, IJ 251,\n-- allocations 13, soins environ 155",
      "autoResize": true,
      "lineHeight": 1.25
    },
