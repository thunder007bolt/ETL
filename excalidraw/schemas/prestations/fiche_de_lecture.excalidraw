    {
      "id": "QbEPTjMqD3y5Z3uHuYLH",
      "type": "text",
      "x": 2093,
      "y": 29784.0,
      "width": 184.48000000000002,
      "height": 20.0,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
