    {
      "id": "V9fIF1rL8tjAyMTyt10i",
      "type": "text",
      "x": 2074,
      "y": 1628.5,
      "width": 361.91999999999996,
      "height": 200.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "OhxId6D9LFrVKQbpqdEU"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 243019814,
      "version": 1,
      "versionNonce": 712027255,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793638601505,
      "link": null,
      "locked": false,
      "text": "-- les prestations de pension par code\nSELECT pe.TPE_CODE, COUNT(*)\nFROM   USER_DWH.PRESTATION_ESP pe\nJOIN   USER_DWH.DOSSIER d\n       ON d.DOS_CODE = pe.DOS_CODE\nWHERE  d.TDOS_CODE = 'V'\nGROUP  BY pe.TPE_CODE\nORDER  BY 2 DESC\n-- la ligne de chaque code : le CASE du\n-- terme 4",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-- les prestations de pension par code\nSELECT pe.TPE_CODE, COUNT(*)\nFROM   USER_DWH.PRESTATION_ESP pe\nJOIN   USER_DWH.DOSSIER d\n       ON d.DOS_CODE = pe.DOS_CODE\nWHERE  d.TDOS_CODE = 'V'\nGROUP  BY pe.TPE_CODE\nORDER  BY 2 DESC\n-- la ligne de chaque code : le CASE du\n-- terme 4",
      "autoResize": true,
      "lineHeight": 1.25
    },
