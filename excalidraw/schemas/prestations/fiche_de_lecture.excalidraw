    {
      "id": "nu53zS5YbMd9LL4YpdLq",
      "type": "text",
      "x": 2083,
      "y": 34286.0,
      "width": 380.47999999999996,
      "height": 160.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
