      "boundElements": [],
      "updated": 1793704821347,
      "link": null,
      "locked": false,
      "text": "-- à coller sous le WITH des termes 4 et 5\nSELECT ligne,\n       ROUND(AVG(jours)) AS duree_moyenne,\n       MEDIAN(jours)     AS duree_mediane\nFROM   durees\nGROUP  BY ligne\n-- 2025, toutes lignes : moyenne 82 jours,\n-- médiane 62 ; la norme : moins de 45",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-- à coller sous le WITH des termes 4 et 5\nSELECT ligne,\n       ROUND(AVG(jours)) AS duree_moyenne,\n       MEDIAN(jours)     AS duree_mediane\nFROM   durees\nGROUP  BY ligne\n-- 2025, toutes lignes : moyenne 82 jours,\n-- médiane 62 ; la norme : moins de 45",
      "autoResize": true,
      "lineHeight": 1.25
    },
