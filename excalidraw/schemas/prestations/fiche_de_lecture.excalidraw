    {
      "id": "GHnaMGpb7U0zNfUsUpc0",
      "type": "text",
      "x": 39,
      "y": 34602.0,
      "width": 1069.2,
      "height": 67.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
