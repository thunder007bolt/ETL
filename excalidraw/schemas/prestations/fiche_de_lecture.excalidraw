    },
    {
      "id": "rYo8TkqX4WcbaCiGyYTW",
      "type": "text",
      "x": 39,
      "y": 4933.5,
      "width": 1082.5200000000002,
      "height": 90.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "AHNjKtHrdVgUsWfwIvJt"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1249541424,
      "version": 1,
      "versionNonce": 1175756686,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793704821347,
      "link": null,
      "locked": false,
      "text": "Une demande reçue, ni notifiée ni rejetée au 31 décembre, quelle que soit l'année de son dépôt. J'en retire deux\nsortes, qui ne seront plus jamais traitées : les dossiers fermés sans avoir jamais été notifiés, et les vieilles\nréceptions d'avant 2016 jamais reliées à un dossier. Sans ce tri, on aurait 23 218 demandes en instance fin\n2025, cinq fois les dépôts d'une année.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Une demande reçue, ni notifiée ni rejetée au 31 décembre, quelle que soit l'année de son dépôt. J'en retire deux\nsortes, qui ne seront plus jamais traitées : les dossiers fermés sans avoir jamais été notifiés, et les vieilles\nréceptions d'avant 2016 jamais reliées à un dossier. Sans ce tri, on aurait 23 218 demandes en instance fin\n2025, cinq fois les dépôts d'une année.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "CtZAP6dGROctPnCBHBJS",
      "type": "text",
      "x": 39,
      "y": 5035.5,
      "width": 1066.88,
      "height": 20.0,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "AHNjKtHrdVgUsWfwIvJt"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1157135707,
      "version": 1,
      "versionNonce": 1082382355,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793704821347,
      "link": null,
      "locked": false,
      "text": "Exemple : une demande reçue en 2012, jamais reliée à un dossier : sans ce tri, elle serait encore « en instance » fin 2025.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Exemple : une demande reçue en 2012, jamais reliée à un dossier : sans ce tri, elle serait encore « en instance » fin 2025.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "lQxksDbPP33FYNosNoWn",
      "type": "text",
      "x": 39,
      "y": 5071.5,
      "width": 1050.8400000000001,
      "height": 45.0,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "AHNjKtHrdVgUsWfwIvJt"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1209724935,
      "version": 1,
      "versionNonce": 1919330000,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793704821347,
      "link": null,
      "locked": false,
      "text": "Tu valides : une demande abandonnée (dossier fermé sans notification, ou réception d'avant 2016 restée sans\ndossier) ne compte plus en instance ?",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Tu valides : une demande abandonnée (dossier fermé sans notification, ou réception d'avant 2016 restée sans\ndossier) ne compte plus en instance ?",
      "autoResize": true,
      "lineHeight": 1.25
    },
