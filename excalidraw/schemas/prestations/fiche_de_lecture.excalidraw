      "text": "Pour vérifier (2020 à 2024)",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Pour vérifier (2020 à 2024)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "w0PmLzuK6o4DkKTEvcEl",
      "type": "text",
      "x": 2112,
      "y": 39098.0,
      "width": 445.43999999999994,
      "height": 440.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "daohL3ehNZlspuy9U7gE"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 926642927,
      "version": 1,
      "versionNonce": 1602965578,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793638601505,
      "link": null,
      "locked": false,
      "text": "-- payé dans l'année, toutes les\n-- prestations du tableau, par code\nSELECT p.TPE_CODE,\n       EXTRACT(YEAR FROM deb.DEB_DATE_INSERT)\n         AS annee,\n       SUM(deb.DEB_MONTANT)\nFROM   USER_DWH.DEBOURS deb\nJOIN   USER_DWH.PRESTATION_ESP p\n       ON p.PE_ID = deb.PE_ID\nWHERE  p.TPE_CODE IN ('RAV', 'RAS', 'RASC',\n         'RASO', 'RASA', 'AIJ', 'AAI',\n         'MIJ', 'MAP', 'FAP')\nAND    deb.DEB_TYPE = 'PM'\nAND    deb.DEB_STATUT IN ('D', 'P')\n-- au versement (DEB_DATE_INSERT) ; au mois\n-- payé : DEB_DATE_EFFET (date_montant)\nAND    deb.DEB_DATE_INSERT >= DATE '2020-01-01'\nAND    deb.DEB_DATE_INSERT <  DATE '2025-01-01'\nGROUP  BY p.TPE_CODE,\n          EXTRACT(YEAR FROM deb.DEB_DATE_INSERT)\n-- 2024, RAV : 497,8 M (l'annuaire :\n-- 497,7 M)",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-- payé dans l'année, toutes les\n-- prestations du tableau, par code\nSELECT p.TPE_CODE,\n       EXTRACT(YEAR FROM deb.DEB_DATE_INSERT)\n         AS annee,\n       SUM(deb.DEB_MONTANT)\nFROM   USER_DWH.DEBOURS deb\nJOIN   USER_DWH.PRESTATION_ESP p\n       ON p.PE_ID = deb.PE_ID\nWHERE  p.TPE_CODE IN ('RAV', 'RAS', 'RASC',\n         'RASO', 'RASA', 'AIJ', 'AAI',\n         'MIJ', 'MAP', 'FAP')\nAND    deb.DEB_TYPE = 'PM'\nAND    deb.DEB_STATUT IN ('D', 'P')\n-- au versement (DEB_DATE_INSERT) ; au mois\n-- payé : DEB_DATE_EFFET (date_montant)\nAND    deb.DEB_DATE_INSERT >= DATE '2020-01-01'\nAND    deb.DEB_DATE_INSERT <  DATE '2025-01-01'\nGROUP  BY p.TPE_CODE,\n          EXTRACT(YEAR FROM deb.DEB_DATE_INSERT)\n-- 2024, RAV : 497,8 M (l'annuaire :\n-- 497,7 M)",
      "autoResize": true,
      "lineHeight": 1.25
    },
