      "roundness": null,
      "seed": 793839368,
      "version": 1,
      "versionNonce": 1109548633,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793704821347,
      "link": null,
      "locked": false,
      "text": "Tu valides : un bénéficiaire de l'année est une personne dont la prestation est notifiée pour la première fois\ndans l'année ?",
