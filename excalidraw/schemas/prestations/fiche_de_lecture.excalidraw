    },
    {
      "id": "hLbS2sFPtDmofBsQru32",
      "type": "text",
      "x": 2074,
      "y": 2508.0,
      "width": 482.55999999999995,
      "height": 740.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "DvGWxPneQiikiZ41V7sv"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1494057413,
      "version": 1,
      "versionNonce": 1095350927,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793625970010,
      "link": null,
      "locked": false,
      "text": "-- demandes : une par dossier et par ligne\n-- du tableau, réutilisée ensuite\nWITH prest AS (\n  SELECT pe.DOS_CODE, pe.PE_DATE_DEMANDE,\n         pe.PE_DATE_NOTIFICATION,\n         CASE WHEN pe.TPE_CODE = 'RPV'  THEN 1\n              WHEN pe.TPE_CODE = 'RPRA' THEN 2\n              WHEN pe.TPE_CODE = 'RPI'  THEN 3\n              WHEN pe.TPE_CODE IN ('RPSV','RPSF',\n                     'RPSE','RPA')      THEN 4\n              WHEN pe.TPE_CODE = 'RAV'  THEN 5\n              WHEN pe.TPE_CODE IN ('RAS','RASC',\n                     'RASO','RASA')     THEN 6\n              ELSE 7 END AS ligne\n  FROM   USER_DWH.PRESTATION_ESP pe\n  JOIN   USER_DWH.DOSSIER d\n         ON d.DOS_CODE = pe.DOS_CODE\n  WHERE  d.TDOS_CODE = 'V'\n  AND    NVL(d.DOS_CATEGORIE, '-') <> 'CNSS_AC'),\ndemandes AS (\n  -- liquidée à sa première notification\n  SELECT DOS_CODE, ligne,\n         MIN(ligne) OVER (PARTITION BY DOS_CODE)\n                                AS ligne_principale,\n         MIN(PE_DATE_DEMANDE)   AS date_demande,\n         MIN(PE_DATE_NOTIFICATION)\n                                AS date_liquidation\n  FROM   prest\n  GROUP  BY DOS_CODE, ligne)\nSELECT ligne, COUNT(*)\nFROM   demandes\nWHERE  date_liquidation >= DATE '2025-01-01'\nAND    date_liquidation <  DATE '2026-01-01'\nGROUP  BY ligne\nORDER  BY ligne\n-- 2025 : environ 4 800 demandes liquidées,\n-- dont environ 900 réversions",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-- demandes : une par dossier et par ligne\n-- du tableau, réutilisée ensuite\nWITH prest AS (\n  SELECT pe.DOS_CODE, pe.PE_DATE_DEMANDE,\n         pe.PE_DATE_NOTIFICATION,\n         CASE WHEN pe.TPE_CODE = 'RPV'  THEN 1\n              WHEN pe.TPE_CODE = 'RPRA' THEN 2\n              WHEN pe.TPE_CODE = 'RPI'  THEN 3\n              WHEN pe.TPE_CODE IN ('RPSV','RPSF',\n                     'RPSE','RPA')      THEN 4\n              WHEN pe.TPE_CODE = 'RAV'  THEN 5\n              WHEN pe.TPE_CODE IN ('RAS','RASC',\n                     'RASO','RASA')     THEN 6\n              ELSE 7 END AS ligne\n  FROM   USER_DWH.PRESTATION_ESP pe\n  JOIN   USER_DWH.DOSSIER d\n         ON d.DOS_CODE = pe.DOS_CODE\n  WHERE  d.TDOS_CODE = 'V'\n  AND    NVL(d.DOS_CATEGORIE, '-') <> 'CNSS_AC'),\ndemandes AS (\n  -- liquidée à sa première notification\n  SELECT DOS_CODE, ligne,\n         MIN(ligne) OVER (PARTITION BY DOS_CODE)\n                                AS ligne_principale,\n         MIN(PE_DATE_DEMANDE)   AS date_demande,\n         MIN(PE_DATE_NOTIFICATION)\n                                AS date_liquidation\n  FROM   prest\n  GROUP  BY DOS_CODE, ligne)\nSELECT ligne, COUNT(*)\nFROM   demandes\nWHERE  date_liquidation >= DATE '2025-01-01'\nAND    date_liquidation <  DATE '2026-01-01'\nGROUP  BY ligne\nORDER  BY ligne\n-- 2025 : environ 4 800 demandes liquidées,\n-- dont environ 900 réversions",
      "autoResize": true,
      "lineHeight": 1.25
    },
