    {
      "id": "aOHipwjB5BbwxvWwVmgj",
      "type": "text",
      "x": 39,
      "y": 1255.5,
      "width": 1079.28,
      "height": 67.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
