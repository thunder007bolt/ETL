    {
      "id": "tubDhRCPagojGOx6lInf",
      "type": "text",
      "x": 2083,
      "y": 34950.5,
      "width": 436.15999999999997,
      "height": 260.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
