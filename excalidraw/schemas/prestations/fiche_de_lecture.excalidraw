      "versionNonce": 1171339424,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793704821347,
      "link": null,
      "locked": false,
      "text": "Tu valides : on ajoute une ligne « pension de retraite anticipée », que l'Annuaire CIPRES n'a pas mais que\nl'atelier de Kaya a demandée ?",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Tu valides : on ajoute une ligne « pension de retraite anticipée », que l'Annuaire CIPRES n'a pas mais que\nl'atelier de Kaya a demandée ?",
      "autoResize": true,
      "lineHeight": 1.25
    },
