      "isDeleted": false,
      "boundElements": [],
      "updated": 1793638601505,
      "link": null,
      "locked": false,
      "text": "Tu valides : un dossier par allocataire, et un dossier par grossesse ?",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Tu valides : un dossier par allocataire, et un dossier par grossesse ?",
