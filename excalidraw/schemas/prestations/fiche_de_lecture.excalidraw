      "seed": 369888027,
      "version": 1,
      "versionNonce": 2105949336,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793625970010,
      "link": null,
      "locked": false,
      "text": "La somme des lignes : chaque demande compte une fois. Une demande reçue qui n'a encore aucune pension créée n'a\npas de ligne : elle compte seulement dans le Total des déposés et des en instance. La durée moyenne du Total\nest recalculée sur toutes les demandes, pas tirée des moyennes des lignes.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "La somme des lignes : chaque demande compte une fois. Une demande reçue qui n'a encore aucune pension créée n'a\npas de ligne : elle compte seulement dans le Total des déposés et des en instance. La durée moyenne du Total\nest recalculée sur toutes les demandes, pas tirée des moyennes des lignes.",
      "autoResize": true,
      "lineHeight": 1.25
    },
