    },
    {
      "id": "ftHiouHQUVpyjdEUGEtw",
      "type": "text",
      "x": 2130,
      "y": 20353.5,
      "width": 426.88,
      "height": 280.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "11Cxm1UfGwtFhVPwpRz7"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 755946898,
      "version": 1,
      "versionNonce": 1878848733,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793625970010,
      "link": null,
      "locked": false,
      "text": "SELECT ROUND(100 * (\n         SELECT COUNT(DISTINCT DOS_CODE)\n         FROM   USER_DWH.DOSSIERS_CONTROLES\n         WHERE  EXTRACT(YEAR FROM\n                  DC_DATE_CONTROLE) = 2025)\n       / (SELECT COUNT(DISTINCT DOS_CODE)\n          FROM   USER_DWH.DEBOURS\n          WHERE  DEB_TYPE = 'PM'\n          AND    DEB_STATUT IN ('D', 'P')\n          AND    EXTRACT(YEAR FROM\n                   DEB_DATE_EFFET) = 2025), 2)\n         AS ratio_controle_pct\nFROM   DUAL\n-- 2025 : 0,07 % (norme : au moins 5 %)",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "SELECT ROUND(100 * (\n         SELECT COUNT(DISTINCT DOS_CODE)\n         FROM   USER_DWH.DOSSIERS_CONTROLES\n         WHERE  EXTRACT(YEAR FROM\n                  DC_DATE_CONTROLE) = 2025)\n       / (SELECT COUNT(DISTINCT DOS_CODE)\n          FROM   USER_DWH.DEBOURS\n          WHERE  DEB_TYPE = 'PM'\n          AND    DEB_STATUT IN ('D', 'P')\n          AND    EXTRACT(YEAR FROM\n                   DEB_DATE_EFFET) = 2025), 2)\n         AS ratio_controle_pct\nFROM   DUAL\n-- 2025 : 0,07 % (norme : au moins 5 %)",
      "autoResize": true,
      "lineHeight": 1.25
    },
