      "isDeleted": false,
      "boundElements": [],
      "updated": 1793625970010,
      "link": null,
      "locked": false,
      "text": "-- les prestations AT/MP par code\nSELECT pe.TPE_CODE, COUNT(*)\nFROM   USER_DWH.PRESTATION_ESP pe\nJOIN   USER_DWH.DOSSIER d\n       ON d.DOS_CODE = pe.DOS_CODE\nWHERE  d.TDOS_CODE = 'A'\nGROUP  BY pe.TPE_CODE\n-- les soins remboursés, par type de soin\nSELECT deb.TPN_CODE, COUNT(*)\nFROM   USER_DWH.DEBOURS deb\nJOIN   USER_DWH.DOSSIER d\n       ON d.DOS_CODE = deb.DOS_CODE\nWHERE  d.TDOS_CODE = 'A'\nAND    deb.TPN_CODE IS NOT NULL\nGROUP  BY deb.TPN_CODE",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-- les prestations AT/MP par code\nSELECT pe.TPE_CODE, COUNT(*)\nFROM   USER_DWH.PRESTATION_ESP pe\nJOIN   USER_DWH.DOSSIER d\n       ON d.DOS_CODE = pe.DOS_CODE\nWHERE  d.TDOS_CODE = 'A'\nGROUP  BY pe.TPE_CODE\n-- les soins remboursés, par type de soin\nSELECT deb.TPN_CODE, COUNT(*)\nFROM   USER_DWH.DEBOURS deb\nJOIN   USER_DWH.DOSSIER d\n       ON d.DOS_CODE = deb.DOS_CODE\nWHERE  d.TDOS_CODE = 'A'\nAND    deb.TPN_CODE IS NOT NULL\nGROUP  BY deb.TPN_CODE",
      "autoResize": true,
      "lineHeight": 1.25
    },
