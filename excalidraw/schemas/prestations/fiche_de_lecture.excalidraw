    {
      "id": "Rh5vHTpOM2oxP2lrGFoL",
      "type": "text",
      "x": 2083,
      "y": 12931.0,
      "width": 389.76,
      "height": 180.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
