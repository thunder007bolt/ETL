    {
      "id": "CmzLIf1q97qBFtZEGm8a",
      "type": "text",
      "x": 2130,
      "y": 21251.0,
      "width": 334.08,
      "height": 140.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
