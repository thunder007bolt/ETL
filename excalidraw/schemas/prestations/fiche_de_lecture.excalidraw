    {
      "id": "l5vmPFdMVWWzCSvhfeqq",
      "type": "text",
      "x": 39,
      "y": 40871.5,
      "width": 1068.8400000000001,
      "height": 67.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "UK4t18CjeCSUD4mjsaRJ"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 693685149,
      "version": 1,
      "versionNonce": 164557895,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793704821347,
      "link": null,
      "locked": false,
      "text": "Tous les paiements et remboursements de l'année, par branche. Je laisse de côté les ajustements, qui sont des\ncorrections (trop-perçus, rappels), et les rachats de rente des AT/MP (21,5 millions en 2024). Les soins des\nAT/MP ne sont pas tous dans les remboursements : l'AT/MP reste 29 % sous le chiffre publié.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Tous les paiements et remboursements de l'année, par branche. Je laisse de côté les ajustements, qui sont des\ncorrections (trop-perçus, rappels), et les rachats de rente des AT/MP (21,5 millions en 2024). Les soins des\nAT/MP ne sont pas tous dans les remboursements : l'AT/MP reste 29 % sous le chiffre publié.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "b4BqaFROYQ3LFcg663hy",
      "type": "text",
      "x": 39,
      "y": 40955.0,
      "width": 1104.1200000000001,
      "height": 45.0,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "UK4t18CjeCSUD4mjsaRJ"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 804637564,
      "version": 1,
      "versionNonce": 371378568,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793704821347,
      "link": null,
      "locked": false,
      "text": "Tu valides : les prestations servies sont les paiements et remboursements de l'année, sans les ajustements ni les\nrachats de rente ?",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Tu valides : les prestations servies sont les paiements et remboursements de l'année, sans les ajustements ni les\nrachats de rente ?",
      "autoResize": true,
      "lineHeight": 1.25
    },
