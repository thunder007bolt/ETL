      "text": "Pour vérifier (2025)",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Pour vérifier (2025)",
      "autoResize": true,
