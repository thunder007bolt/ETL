    {
      "id": "bNpCWarFjP5iWn2VEZsk",
      "type": "text",
      "x": 2083,
      "y": 18863.5,
      "width": 389.76,
      "height": 180.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
