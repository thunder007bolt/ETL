    {
      "id": "rJJ3DzozoEV8cD6skHtT",
      "type": "text",
      "x": 39,
      "y": 37892.0,
      "width": 1061.28,
      "height": 67.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
