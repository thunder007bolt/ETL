      "updated": 1793704821347,
      "link": null,
      "locked": false,
      "text": "Les dossiers « déposés » au cours de l'exercice (p. 12) ; l'atelier de Kaya : le dépôt, c'est la réception du dossier complet\nau guichet.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Les dossiers « déposés » au cours de l'exercice (p. 12) ; l'atelier de Kaya : le dépôt, c'est la réception du dossier complet\nau guichet.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "DyRl6hUCYoTNzoOLJ3pK",
      "type": "text",
      "x": 39,
      "y": 15086.5,
      "width": 166.08,
      "height": 20.0,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "moti7vGK67Qfhx1PDvNn"
