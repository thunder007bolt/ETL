    },
    {
      "id": "QqomnsYqpKJbCauU1z0M",
      "type": "text",
      "x": 2074,
      "y": 3332.0,
      "width": 473.28,
      "height": 680.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "kQJ2X9LZS4H18qCfr9tW"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 485790418,
      "version": 1,
      "versionNonce": 731304150,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793625970010,
      "link": null,
      "locked": false,
      "text": "-- à ajouter à la suite du WITH de la\n-- terme 4 : le dépôt et la durée\ndepots AS (\n  SELECT dm.ligne, dm.date_demande,\n         dm.date_liquidation,\n         CASE WHEN dm.ligne = dm.ligne_principale\n         -- la réception qui a ouvert le dossier\n         THEN (SELECT r.RD_DATE_RECEPTION\n               FROM   USER_DWH.DOSSIER d\n               JOIN   USER_DWH.RECEPTION_DOSSIER r\n                      ON r.RD_ID = d.RD_ID\n               WHERE  d.DOS_CODE = dm.DOS_CODE)\n         -- une réversion : sa réception ANCIEN\n         ELSE (SELECT MAX(r.RD_DATE_RECEPTION)\n               FROM   USER_DWH.RECEPTION_DOSSIER r\n               WHERE  r.DOS_CODE = dm.DOS_CODE\n               AND    r.RD_TYPE_RECEPTION\n                        = 'ANCIEN'\n               AND    r.RD_DATE_RECEPTION\n                        <= dm.date_liquidation)\n         END AS date_reception\n  FROM   demandes dm\n  WHERE  dm.date_liquidation >= DATE '2025-01-01'\n  AND    dm.date_liquidation <  DATE '2026-01-01'),\ndurees AS (\n  -- sans réception : la date de demande ;\n  -- une durée négative compte 0\n  SELECT ligne,\n         GREATEST(TRUNC(date_liquidation)\n           - TRUNC(NVL(date_reception,\n                       date_demande)), 0) AS jours\n  FROM   depots)\nSELECT MEDIAN(jours) FROM durees\n-- 2025 : 62 jours (médiane)",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-- à ajouter à la suite du WITH de la\n-- terme 4 : le dépôt et la durée\ndepots AS (\n  SELECT dm.ligne, dm.date_demande,\n         dm.date_liquidation,\n         CASE WHEN dm.ligne = dm.ligne_principale\n         -- la réception qui a ouvert le dossier\n         THEN (SELECT r.RD_DATE_RECEPTION\n               FROM   USER_DWH.DOSSIER d\n               JOIN   USER_DWH.RECEPTION_DOSSIER r\n                      ON r.RD_ID = d.RD_ID\n               WHERE  d.DOS_CODE = dm.DOS_CODE)\n         -- une réversion : sa réception ANCIEN\n         ELSE (SELECT MAX(r.RD_DATE_RECEPTION)\n               FROM   USER_DWH.RECEPTION_DOSSIER r\n               WHERE  r.DOS_CODE = dm.DOS_CODE\n               AND    r.RD_TYPE_RECEPTION\n                        = 'ANCIEN'\n               AND    r.RD_DATE_RECEPTION\n                        <= dm.date_liquidation)\n         END AS date_reception\n  FROM   demandes dm\n  WHERE  dm.date_liquidation >= DATE '2025-01-01'\n  AND    dm.date_liquidation <  DATE '2026-01-01'),\ndurees AS (\n  -- sans réception : la date de demande ;\n  -- une durée négative compte 0\n  SELECT ligne,\n         GREATEST(TRUNC(date_liquidation)\n           - TRUNC(NVL(date_reception,\n                       date_demande)), 0) AS jours\n  FROM   depots)\nSELECT MEDIAN(jours) FROM durees\n-- 2025 : 62 jours (médiane)",
      "autoResize": true,
      "lineHeight": 1.25
    },
