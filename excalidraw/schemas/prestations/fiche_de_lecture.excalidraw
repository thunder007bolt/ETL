    {
      "id": "ZYLJYhXv5jM2MVC83ogM",
      "type": "text",
      "x": 39,
      "y": 38828.5,
      "width": 1094.04,
      "height": 67.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "yyhMnD3D6rpWCSCJJ1rJ"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1583059087,
      "version": 1,
      "versionNonce": 637704805,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793704821347,
      "link": null,
      "locked": false,
      "text": "La personne dont la prestation est liquidée dans l'année, c'est-à-dire notifiée pour la première fois, comme pour\nT25. Je l'applique à T50 à T55. Compter plutôt les personnes payées dans l'année donnerait des chiffres 25 %\ndifférents.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "La personne dont la prestation est liquidée dans l'année, c'est-à-dire notifiée pour la première fois, comme pour\nT25. Je l'applique à T50 à T55. Compter plutôt les personnes payées dans l'année donnerait des chiffres 25 %\ndifférents.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "k9rvZuHlOQaMVVpQEB2N",
      "type": "text",
      "x": 39,
      "y": 38908.0,
      "width": 925.9200000000001,
      "height": 20.0,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "yyhMnD3D6rpWCSCJJ1rJ"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1410831016,
      "version": 1,
      "versionNonce": 223791772,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793704821347,
      "link": null,
      "locked": false,
      "text": "Exemple : une allocation de vieillesse demandée en 2023 et notifiée en mars 2024 : bénéficiaire de 2024.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Exemple : une allocation de vieillesse demandée en 2023 et notifiée en mars 2024 : bénéficiaire de 2024.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "vK3nyI9xM1M2LYGkoa1r",
      "type": "text",
      "x": 39,
      "y": 38944.0,
      "width": 1065.96,
      "height": 45.0,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
