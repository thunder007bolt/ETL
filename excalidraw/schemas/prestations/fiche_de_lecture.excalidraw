    {
      "id": "YsefoJUwZoCMUlCkQxRL",
      "type": "text",
      "x": 2102,
      "y": 26506.0,
      "width": 454.71999999999997,
      "height": 300.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "XSFTwjFSwoO2GRauX2hw"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 245778104,
      "version": 1,
      "versionNonce": 1965256725,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793625970010,
      "link": null,
      "locked": false,
      "text": "SELECT tranche, COUNT(DISTINCT IND_ID_PREST)\nFROM  (SELECT IND_ID_PREST,\n         CASE WHEN age IS NULL OR age < 0\n                OR age >= 120 THEN 'Âge inconnu'\n              WHEN age < 55   THEN 'Moins de 55'\n              WHEN age >= 100 THEN '100 et plus'\n              ELSE TO_CHAR(FLOOR(age / 5) * 5)\n         END AS tranche\n       FROM  (SELECT IND_ID_PREST,\n                     2024 - EXTRACT(YEAR FROM\n                       IND_DATE_NAISSANCE) AS age\n              FROM   pensions_2024))\nGROUP  BY tranche\nORDER  BY tranche\n-- 55 = 55-59 ans, 60 = 60-64 ans, …",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "SELECT tranche, COUNT(DISTINCT IND_ID_PREST)\nFROM  (SELECT IND_ID_PREST,\n         CASE WHEN age IS NULL OR age < 0\n                OR age >= 120 THEN 'Âge inconnu'\n              WHEN age < 55   THEN 'Moins de 55'\n              WHEN age >= 100 THEN '100 et plus'\n              ELSE TO_CHAR(FLOOR(age / 5) * 5)\n         END AS tranche\n       FROM  (SELECT IND_ID_PREST,\n                     2024 - EXTRACT(YEAR FROM\n                       IND_DATE_NAISSANCE) AS age\n              FROM   pensions_2024))\nGROUP  BY tranche\nORDER  BY tranche\n-- 55 = 55-59 ans, 60 = 60-64 ans, …",
      "autoResize": true,
      "lineHeight": 1.25
    },
