    {
      "id": "5MJgJksLBdiItRptvR5B",
      "type": "text",
      "x": 39,
      "y": 5617.5,
      "width": 1083.6000000000001,
      "height": 67.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
