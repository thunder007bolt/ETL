    {
      "id": "r3fvZOBkN1RTSs6Wchgt",
      "type": "text",
      "x": 45,
      "y": 720.5,
      "width": 2461.6800000000003,
      "height": 45.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "5p63RjfE7xewqZ0ndTpQ"
      ],
      "frameId": null,
