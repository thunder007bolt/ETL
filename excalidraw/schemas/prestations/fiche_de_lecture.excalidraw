      "link": null,
      "locked": false,
      "text": "Un trop-perçu compte le mois où il est établi, pas le mois où il a été payé en trop, ni celui où il est repris.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Un trop-perçu compte le mois où il est établi, pas le mois où il a été payé en trop, ni celui où il est repris.",
      "autoResize": true,
      "lineHeight": 1.25
    },
