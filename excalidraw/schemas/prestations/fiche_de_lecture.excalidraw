      "link": null,
      "locked": false,
      "text": "SELECT COUNT(*)\nFROM   USER_DWH.DOSSIER_REJETE\nWHERE  TDOS_CODE = 'V'\nAND    DOSRE_DATE_REJET >= DATE '2025-01-01'\nAND    DOSRE_DATE_REJET <  DATE '2026-01-01'\n-- 2025 : 14 (146 depuis 2017)",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "SELECT COUNT(*)\nFROM   USER_DWH.DOSSIER_REJETE\nWHERE  TDOS_CODE = 'V'\nAND    DOSRE_DATE_REJET >= DATE '2025-01-01'\nAND    DOSRE_DATE_REJET <  DATE '2026-01-01'\n-- 2025 : 14 (146 depuis 2017)",
      "autoResize": true,
      "lineHeight": 1.25
