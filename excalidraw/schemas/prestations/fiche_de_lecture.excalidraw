      "updated": 1793704821347,
      "link": null,
      "locked": false,
      "text": "-- en instance au 31/12/2025, divisé par\n-- (en instance au 31/12/2024 + déposés)\n-- en instance : la terme 7, une fois avec\n-- 2026-01-01, une fois avec 2025-01-01 ;\n-- déposés : la terme 3 (4 671 en 2025)\nSELECT ROUND(100 * :instance_fin_2025\n         / (:instance_fin_2024 + 4671), 1)\n         AS taux_restant_pct\nFROM   DUAL",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-- en instance au 31/12/2025, divisé par\n-- (en instance au 31/12/2024 + déposés)\n-- en instance : la terme 7, une fois avec\n-- 2026-01-01, une fois avec 2025-01-01 ;\n-- déposés : la terme 3 (4 671 en 2025)\nSELECT ROUND(100 * :instance_fin_2025\n         / (:instance_fin_2024 + 4671), 1)\n         AS taux_restant_pct\nFROM   DUAL",
      "autoResize": true,
