    {
      "id": "Me8tzAGderegs159JRqU",
      "type": "text",
      "x": 2083,
      "y": 8194.5,
      "width": 417.59999999999997,
      "height": 260.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
