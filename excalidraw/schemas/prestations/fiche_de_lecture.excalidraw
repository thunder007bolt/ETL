    {
      "id": "15Tb2qaaVhMTle4UxMK8",
      "type": "text",
      "x": 2112,
      "y": 24736.0,
      "width": 417.59999999999997,
      "height": 300.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "d9rbnKuGdUi6n0nNlmiA"
