    {
      "id": "qFURA6dpniH8p1tNnR1h",
      "type": "text",
      "x": 25,
      "y": 32133.5,
      "width": 2498.8,
      "height": 50.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
