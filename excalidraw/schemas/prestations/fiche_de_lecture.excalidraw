    {
      "id": "nrzRTqIzjMhTfF56uD9s",
      "type": "text",
      "x": 2083,
      "y": 17480.5,
      "width": 408.32,
      "height": 140.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
