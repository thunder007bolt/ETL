    {
      "id": "bXDFGcK73YV5nlFswhqs",
      "type": "text",
      "x": 2112,
      "y": 36288.5,
      "width": 408.32,
      "height": 320.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "BikqPwZT8jsc3qZTGesS"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1624402008,
      "version": 1,
      "versionNonce": 1676387034,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793625970010,
      "link": null,
      "locked": false,
      "text": "-- le tableau de chaque code (TPE_CODE)\nSELECT TPE_CODE,\n       CASE WHEN TPE_CODE = 'RAV' THEN 'T50'\n            WHEN TPE_CODE IN ('RAS','RASC',\n                   'RASO','RASA') THEN 'T51'\n            WHEN TPE_CODE = 'AIJ' THEN 'T52'\n            WHEN TPE_CODE = 'AAI' THEN 'T53'\n            WHEN TPE_CODE = 'MIJ' THEN 'T54'\n            ELSE 'T55' END AS tableau,\n       COUNT(*)\nFROM   USER_DWH.PRESTATION_ESP\nWHERE  TPE_CODE IN ('RAV', 'RAS', 'RASC',\n         'RASO', 'RASA', 'AIJ', 'AAI',\n         'MIJ', 'MAP', 'FAP')\nGROUP  BY TPE_CODE\n-- T55 : FAP et MAP (prénatales)",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-- le tableau de chaque code (TPE_CODE)\nSELECT TPE_CODE,\n       CASE WHEN TPE_CODE = 'RAV' THEN 'T50'\n            WHEN TPE_CODE IN ('RAS','RASC',\n                   'RASO','RASA') THEN 'T51'\n            WHEN TPE_CODE = 'AIJ' THEN 'T52'\n            WHEN TPE_CODE = 'AAI' THEN 'T53'\n            WHEN TPE_CODE = 'MIJ' THEN 'T54'\n            ELSE 'T55' END AS tableau,\n       COUNT(*)\nFROM   USER_DWH.PRESTATION_ESP\nWHERE  TPE_CODE IN ('RAV', 'RAS', 'RASC',\n         'RASO', 'RASA', 'AIJ', 'AAI',\n         'MIJ', 'MAP', 'FAP')\nGROUP  BY TPE_CODE\n-- T55 : FAP et MAP (prénatales)",
      "autoResize": true,
      "lineHeight": 1.25
    },
