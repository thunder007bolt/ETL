    {
      "id": "WuyuGGyURgDsPXOM6CRK",
      "type": "text",
      "x": 39,
      "y": 2162.0,
      "width": 1081.2600000000002,
      "height": 67.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
