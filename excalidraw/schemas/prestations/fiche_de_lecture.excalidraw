    {
      "id": "JcJceU8ssqrNnIca2WHh",
      "type": "text",
      "x": 25,
      "y": 21604.0,
      "width": 1647.8,
      "height": 25.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 85353269,
      "version": 1,
      "versionNonce": 392561095,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793638601505,
      "link": null,
      "locked": false,
      "text": "Pour moi, ce tableau suit chaque mois ce que la CNSS a payé de trop, face à ce qu'elle a payé, par branche, et le compare à la norme : au plus 2 % d'indus.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Pour moi, ce tableau suit chaque mois ce que la CNSS a payé de trop, face à ce qu'elle a payé, par branche, et le compare à la norme : au plus 2 % d'indus.",
      "autoResize": true,
      "lineHeight": 1.25
