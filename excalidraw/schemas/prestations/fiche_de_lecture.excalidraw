      "versionNonce": 164208010,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793704821347,
      "link": null,
      "locked": false,
      "text": "Tous les paiements de la branche, rangés par le mois qu'ils paient : la pension de janvier compte en janvier, même\nsi elle est versée en février. Rangés par date de versement, le taux de l'année ne change pas.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Tous les paiements de la branche, rangés par le mois qu'ils paient : la pension de janvier compte en janvier, même\nsi elle est versée en février. Rangés par date de versement, le taux de l'année ne change pas.",
      "autoResize": true,
      "lineHeight": 1.25
    },
