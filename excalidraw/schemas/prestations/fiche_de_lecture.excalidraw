    {
      "id": "fu0eLyrneqn89nQxYeQj",
      "type": "text",
      "x": 2083,
      "y": 12516.0,
      "width": 389.76,
      "height": 180.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
