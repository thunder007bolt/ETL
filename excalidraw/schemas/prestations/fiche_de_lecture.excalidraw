      "isDeleted": false,
      "boundElements": [],
      "updated": 1793704821347,
      "link": null,
      "locked": false,
      "text": "Un dossier qui a reçu au moins un paiement dans l'année. Je compte des dossiers, pas des paiements : une pension\npayée douze fois est un dossier payé.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Un dossier qui a reçu au moins un paiement dans l'année. Je compte des dossiers, pas des paiements : une pension\npayée douze fois est un dossier payé.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "cRH1MaSlE1WBjWsjKzYb",
      "type": "text",
      "x": 39,
      "y": 20180.5,
