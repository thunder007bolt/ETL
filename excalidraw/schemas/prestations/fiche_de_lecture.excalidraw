    },
    {
      "id": "EKQ8fMrRuBuyr0Z3ZF3s",
      "type": "text",
      "x": 2102,
      "y": 26594.5,
      "width": 417.59999999999997,
      "height": 580.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "2R7td0smGp8AwW7tPfYh"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 89020146,
      "version": 1,
      "versionNonce": 996789419,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793704821347,
      "link": null,
      "locked": false,
      "text": "-- la liste des pensions en cours au\n-- 31/12/2024, réutilisée ensuite\nWITH pensions_2024 AS (\n  SELECT p.PE_ID, p.TPE_CODE, p.IND_ID_PREST,\n         i.IND_SEXE, i.IND_DATE_NAISSANCE\n  FROM   USER_DWH.PRESTATION_ESP p\n  JOIN   USER_DWH.INDIVIDU i\n         ON i.IND_ID = p.IND_ID_PREST\n  WHERE  p.TPE_CODE IN ('RPV', 'RPRA')\n  -- effet avant le 31/12, pas radiée\n  AND    p.PE_DATE_EFFET <= DATE '2024-12-31'\n  AND   (p.PE_DATE_RADIATION IS NULL\n         OR p.PE_DATE_RADIATION\n              > DATE '2024-12-31')\n  -- pas suspendue, ou réactivée avant\n  AND   (p.PE_DATE_SUSPENSION IS NULL\n         OR p.PE_DATE_SUSPENSION\n              > DATE '2024-12-31'\n         OR p.PE_DATE_REACTIVATION\n              BETWEEN p.PE_DATE_SUSPENSION\n                  AND DATE '2024-12-31')\n  -- titulaire en vie au 31/12\n  AND   (i.IND_DATE_DECES IS NULL\n         OR i.IND_DATE_DECES\n              > DATE '2024-12-31'))\nSELECT TPE_CODE, COUNT(*)\nFROM   pensions_2024\nGROUP  BY TPE_CODE\n-- 2024 : RPV 31 180, RPRA 87",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-- la liste des pensions en cours au\n-- 31/12/2024, réutilisée ensuite\nWITH pensions_2024 AS (\n  SELECT p.PE_ID, p.TPE_CODE, p.IND_ID_PREST,\n         i.IND_SEXE, i.IND_DATE_NAISSANCE\n  FROM   USER_DWH.PRESTATION_ESP p\n  JOIN   USER_DWH.INDIVIDU i\n         ON i.IND_ID = p.IND_ID_PREST\n  WHERE  p.TPE_CODE IN ('RPV', 'RPRA')\n  -- effet avant le 31/12, pas radiée\n  AND    p.PE_DATE_EFFET <= DATE '2024-12-31'\n  AND   (p.PE_DATE_RADIATION IS NULL\n         OR p.PE_DATE_RADIATION\n              > DATE '2024-12-31')\n  -- pas suspendue, ou réactivée avant\n  AND   (p.PE_DATE_SUSPENSION IS NULL\n         OR p.PE_DATE_SUSPENSION\n              > DATE '2024-12-31'\n         OR p.PE_DATE_REACTIVATION\n              BETWEEN p.PE_DATE_SUSPENSION\n                  AND DATE '2024-12-31')\n  -- titulaire en vie au 31/12\n  AND   (i.IND_DATE_DECES IS NULL\n         OR i.IND_DATE_DECES\n              > DATE '2024-12-31'))\nSELECT TPE_CODE, COUNT(*)\nFROM   pensions_2024\nGROUP  BY TPE_CODE\n-- 2024 : RPV 31 180, RPRA 87",
      "autoResize": true,
      "lineHeight": 1.25
    },
