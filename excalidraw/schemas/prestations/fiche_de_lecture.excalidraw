      "y": 2049.5,
      "width": 1041.8400000000001,
      "height": 45.0,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
