      "versionNonce": 1170904061,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793704821347,
      "link": null,
      "locked": false,
      "text": "Tu valides : la durée d'une rente part de sa demande au guichet, et non du certificat de consolidation ?",
