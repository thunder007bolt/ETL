    {
      "id": "MpxXkF2i1ewgxbnRweA0",
      "type": "text",
      "x": 39,
      "y": 2610.0,
      "width": 1079.28,
      "height": 90.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
