    },
    {
      "id": "2WcfFWd4nnrTdKwUELn7",
      "type": "text",
      "x": 2112,
      "y": 38682.5,
      "width": 417.59999999999997,
      "height": 640.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "gX7qXU94ffu4XqYYEJhO"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 806946086,
      "version": 1,
      "versionNonce": 2063364715,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793704821347,
      "link": null,
      "locked": false,
      "text": "-- la liste des prestations liquidées\n-- (première notification) de 2020 à 2024,\n-- réutilisée ensuite\nWITH liquides AS (\n  SELECT CASE\n           WHEN p.TPE_CODE = 'RAV' THEN 'T50'\n           WHEN p.TPE_CODE IN ('RAS','RASC',\n                  'RASO','RASA') THEN 'T51'\n           WHEN p.TPE_CODE = 'AIJ' THEN 'T52'\n           WHEN p.TPE_CODE = 'AAI' THEN 'T53'\n           WHEN p.TPE_CODE = 'MIJ' THEN 'T54'\n           ELSE 'T55' END AS tableau,\n         EXTRACT(YEAR FROM\n           p.PE_DATE_NOTIFICATION) AS annee,\n         p.PE_ID, p.IND_ID_PREST,\n         p.PE_MOIS_COTISATION, p.PE_COT_AUTRE\n  FROM   USER_DWH.PRESTATION_ESP p\n  WHERE  p.TPE_CODE IN ('RAV', 'RAS', 'RASC',\n           'RASO', 'RASA', 'AIJ', 'AAI',\n           'MIJ', 'MAP', 'FAP')\n  AND    p.PE_DATE_NOTIFICATION\n           >= DATE '2020-01-01'\n  AND    p.PE_DATE_NOTIFICATION\n           <  DATE '2025-01-01')\nSELECT tableau, annee,\n       COUNT(DISTINCT IND_ID_PREST)\nFROM   liquides\nGROUP  BY tableau, annee\nORDER  BY tableau, annee\n-- 2024 : T50 831 (l'annuaire : 833) ;\n-- T54 3 890 (3 893), à moins de 1 % de\n-- 2020 à 2024 sauf 2022",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-- la liste des prestations liquidées\n-- (première notification) de 2020 à 2024,\n-- réutilisée ensuite\nWITH liquides AS (\n  SELECT CASE\n           WHEN p.TPE_CODE = 'RAV' THEN 'T50'\n           WHEN p.TPE_CODE IN ('RAS','RASC',\n                  'RASO','RASA') THEN 'T51'\n           WHEN p.TPE_CODE = 'AIJ' THEN 'T52'\n           WHEN p.TPE_CODE = 'AAI' THEN 'T53'\n           WHEN p.TPE_CODE = 'MIJ' THEN 'T54'\n           ELSE 'T55' END AS tableau,\n         EXTRACT(YEAR FROM\n           p.PE_DATE_NOTIFICATION) AS annee,\n         p.PE_ID, p.IND_ID_PREST,\n         p.PE_MOIS_COTISATION, p.PE_COT_AUTRE\n  FROM   USER_DWH.PRESTATION_ESP p\n  WHERE  p.TPE_CODE IN ('RAV', 'RAS', 'RASC',\n           'RASO', 'RASA', 'AIJ', 'AAI',\n           'MIJ', 'MAP', 'FAP')\n  AND    p.PE_DATE_NOTIFICATION\n           >= DATE '2020-01-01'\n  AND    p.PE_DATE_NOTIFICATION\n           <  DATE '2025-01-01')\nSELECT tableau, annee,\n       COUNT(DISTINCT IND_ID_PREST)\nFROM   liquides\nGROUP  BY tableau, annee\nORDER  BY tableau, annee\n-- 2024 : T50 831 (l'annuaire : 833) ;\n-- T54 3 890 (3 893), à moins de 1 % de\n-- 2020 à 2024 sauf 2022",
      "autoResize": true,
      "lineHeight": 1.25
    },
