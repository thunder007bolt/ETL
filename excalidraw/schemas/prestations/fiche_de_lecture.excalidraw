      "link": null,
      "locked": false,
      "text": "AVS : les titulaires d'une pension directe morts dans l'année. AT/MP : les rentiers, et les victimes mortes dans\nl'année de leur accident. PF : les allocataires. À la date du décès : la base n'a pas de date de déclaration.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "AVS : les titulaires d'une pension directe morts dans l'année. AT/MP : les rentiers, et les victimes mortes dans\nl'année de leur accident. PF : les allocataires. À la date du décès : la base n'a pas de date de déclaration.",
      "autoResize": true,
      "lineHeight": 1.25
    },
