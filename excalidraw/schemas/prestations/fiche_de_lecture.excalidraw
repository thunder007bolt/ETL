      "isDeleted": false,
      "boundElements": [],
      "updated": 1793704821347,
      "link": null,
      "locked": false,
      "text": "-- les prestations PF par code\nSELECT d.TDOS_CODE, pe.TPE_CODE, COUNT(*)\nFROM   USER_DWH.PRESTATION_ESP pe\nJOIN   USER_DWH.DOSSIER d\n       ON d.DOS_CODE = pe.DOS_CODE\nWHERE  d.TDOS_CODE IN ('F', 'M')\nGROUP  BY d.TDOS_CODE, pe.TPE_CODE",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-- les prestations PF par code\nSELECT d.TDOS_CODE, pe.TPE_CODE, COUNT(*)\nFROM   USER_DWH.PRESTATION_ESP pe\nJOIN   USER_DWH.DOSSIER d\n       ON d.DOS_CODE = pe.DOS_CODE\nWHERE  d.TDOS_CODE IN ('F', 'M')\nGROUP  BY d.TDOS_CODE, pe.TPE_CODE",
      "autoResize": true,
      "lineHeight": 1.25
    },
