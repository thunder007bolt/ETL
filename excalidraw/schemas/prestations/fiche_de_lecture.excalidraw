      "link": null,
      "locked": false,
      "text": "« Évolution du nombre des bénéficiaires » (p. 16) ; l'atelier de Kaya : pour T54 et T55, on compte les liquidées, pas les\npayées.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "« Évolution du nombre des bénéficiaires » (p. 16) ; l'atelier de Kaya : pour T54 et T55, on compte les liquidées, pas les\npayées.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "NwZgNyPBX2ODiq9z99Ta",
      "type": "text",
      "x": 39,
      "y": 38804.5,
      "width": 166.08,
      "height": 20.0,
      "angle": 0,
      "strokeColor": "#495057",
