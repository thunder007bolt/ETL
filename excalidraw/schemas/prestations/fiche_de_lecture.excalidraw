    {
      "id": "vTazxOO852bxxMVmpBpK",
      "type": "text",
      "x": 2083,
      "y": 7899.5,
      "width": 417.59999999999997,
      "height": 260.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
