    {
      "id": "vVP84t6L5a3avx3KQh0g",
      "type": "text",
      "x": 39,
      "y": 8472.0,
      "width": 1073.16,
      "height": 67.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "JOMTNkquB1Jt6wOFDc0f"
      ],
