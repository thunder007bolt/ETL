      "text": "Pour vérifier (2020 à 2024)",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Pour vérifier (2020 à 2024)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "1wzA2TmbcVzT3cMWxRn7",
      "type": "text",
      "x": 2112,
      "y": 41189.5,
      "width": 426.88,
      "height": 520.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "y8qBdyLPYs8GVBAaQIs8"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1352988012,
      "version": 1,
      "versionNonce": 173454434,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793704821347,
      "link": null,
      "locked": false,
      "text": "-- T57, AVS : titulaires d'une pension\n-- directe en cours, morts en 2024\nSELECT COUNT(DISTINCT i.IND_ID)\nFROM   USER_DWH.INDIVIDU i\nJOIN   USER_DWH.PRESTATION_ESP p\n       ON p.IND_ID_PREST = i.IND_ID\nWHERE  p.TPE_CODE IN ('RPV', 'RPRA', 'RPI')\nAND    p.PE_DATE_EFFET <= i.IND_DATE_DECES\nAND    i.IND_DATE_DECES >= DATE '2024-01-01'\nAND    i.IND_DATE_DECES <  DATE '2025-01-01'\n-- retraités : 619 aujourd'hui, 444 sur le\n-- cliché de fin mars 2025 (447 publiés)\n-- AT/MP, sinistrés : victime du dossier A\n-- morte dans l'année de son accident\nSELECT COUNT(DISTINCT i.IND_ID)\nFROM   USER_DWH.DOSSIER d\nJOIN   USER_DWH.INDIVIDU i\n       ON i.IND_ID = d.IND_ID\nWHERE  d.TDOS_CODE = 'A'\nAND    i.IND_DATE_DECES >= d.DOS_DATE_ACCIDENT\nAND    i.IND_DATE_DECES\n         < d.DOS_DATE_ACCIDENT + 366\nAND    i.IND_DATE_DECES >= DATE '2024-01-01'\nAND    i.IND_DATE_DECES <  DATE '2025-01-01'\n-- 8 à 23 par an ; PF : les allocataires\n-- (titulaires des dossiers F) morts en 2024",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-- T57, AVS : titulaires d'une pension\n-- directe en cours, morts en 2024\nSELECT COUNT(DISTINCT i.IND_ID)\nFROM   USER_DWH.INDIVIDU i\nJOIN   USER_DWH.PRESTATION_ESP p\n       ON p.IND_ID_PREST = i.IND_ID\nWHERE  p.TPE_CODE IN ('RPV', 'RPRA', 'RPI')\nAND    p.PE_DATE_EFFET <= i.IND_DATE_DECES\nAND    i.IND_DATE_DECES >= DATE '2024-01-01'\nAND    i.IND_DATE_DECES <  DATE '2025-01-01'\n-- retraités : 619 aujourd'hui, 444 sur le\n-- cliché de fin mars 2025 (447 publiés)\n-- AT/MP, sinistrés : victime du dossier A\n-- morte dans l'année de son accident\nSELECT COUNT(DISTINCT i.IND_ID)\nFROM   USER_DWH.DOSSIER d\nJOIN   USER_DWH.INDIVIDU i\n       ON i.IND_ID = d.IND_ID\nWHERE  d.TDOS_CODE = 'A'\nAND    i.IND_DATE_DECES >= d.DOS_DATE_ACCIDENT\nAND    i.IND_DATE_DECES\n         < d.DOS_DATE_ACCIDENT + 366\nAND    i.IND_DATE_DECES >= DATE '2024-01-01'\nAND    i.IND_DATE_DECES <  DATE '2025-01-01'\n-- 8 à 23 par an ; PF : les allocataires\n-- (titulaires des dossiers F) morts en 2024",
      "autoResize": true,
      "lineHeight": 1.25
    },
