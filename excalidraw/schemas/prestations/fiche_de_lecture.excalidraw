      "link": null,
      "locked": false,
      "text": "AJUSTEMENT.TAJ_CODE : REM-TP remboursement, AV avance, MPG mois gratuits, et les\nautres types ; libellés dans TYPE_AJUSTEMENT.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
