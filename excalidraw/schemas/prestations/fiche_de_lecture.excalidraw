      "boundElements": [],
      "updated": 1793704821347,
      "link": null,
      "locked": false,
      "text": "Une allocation en cours le 31 décembre (ni suspendue, ni radiée), pour un enfant en vie de 21 ans au plus, et\npayée dans l'année. Sans la condition de paiement, on compterait 5 % de trop.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Une allocation en cours le 31 décembre (ni suspendue, ni radiée), pour un enfant en vie de 21 ans au plus, et\npayée dans l'année. Sans la condition de paiement, on compterait 5 % de trop.",
      "autoResize": true,
      "lineHeight": 1.25
    },
