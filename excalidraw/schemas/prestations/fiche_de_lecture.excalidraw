    {
      "id": "C8MAaPW8zigbcfPIDlYF",
      "type": "text",
      "x": 2112,
      "y": 40328.0,
      "width": 426.88,
      "height": 280.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "PoRzv0lGX72iGkw8IluF"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1584975736,
      "version": 1,
      "versionNonce": 542196481,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793704821347,
      "link": null,
      "locked": false,
      "text": "-- T50 : la moyenne des mois cotisés à la\n-- CNSS, par sexe (en coordination, moins\n-- les mois dans l'autre caisse)\nSELECT l.annee, i.IND_SEXE,\n       ROUND(AVG(GREATEST(l.PE_MOIS_COTISATION\n             - NVL(l.PE_COT_AUTRE, 0), 0)))\n         AS services_moyens\nFROM   liquides l\nJOIN   USER_DWH.INDIVIDU i\n       ON i.IND_ID = l.IND_ID_PREST\nWHERE  l.tableau = 'T50'\nAND    l.PE_MOIS_COTISATION BETWEEN 1 AND 600\nGROUP  BY l.annee, i.IND_SEXE\n-- 2024 : 96 mois en moyenne",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-- T50 : la moyenne des mois cotisés à la\n-- CNSS, par sexe (en coordination, moins\n-- les mois dans l'autre caisse)\nSELECT l.annee, i.IND_SEXE,\n       ROUND(AVG(GREATEST(l.PE_MOIS_COTISATION\n             - NVL(l.PE_COT_AUTRE, 0), 0)))\n         AS services_moyens\nFROM   liquides l\nJOIN   USER_DWH.INDIVIDU i\n       ON i.IND_ID = l.IND_ID_PREST\nWHERE  l.tableau = 'T50'\nAND    l.PE_MOIS_COTISATION BETWEEN 1 AND 600\nGROUP  BY l.annee, i.IND_SEXE\n-- 2024 : 96 mois en moyenne",
      "autoResize": true,
      "lineHeight": 1.25
    },
