      "versionNonce": 366283811,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793293669653,
      "link": null,
      "locked": false,
      "text": "La CIPRES est l'organisme régional qui contrôle les caisses de sécurité sociale. Chaque année, la CNSS lui remplit ces tableaux (l'Annuaire statistique).",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "La CIPRES est l'organisme régional qui contrôle les caisses de sécurité sociale. Chaque année, la CNSS lui remplit ces tableaux (l'Annuaire statistique).",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b0P"
    },
