    {
      "id": "FAoVOI6Si42WQvaiuezF",
      "type": "text",
      "x": 47,
      "y": 9800,
      "width": 2489.1900000000005,
      "height": 47.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "QynBEV76yyTOQtZ2E9Kw"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1295561328,
      "version": 2,
      "versionNonce": 1497086832,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794209947917,
      "link": null,
      "locked": false,
      "text": "Confirme : la liquidation à la notification (D4), l'accessoire avec la pension (A1), la maternité dans les PF (R1), l'anticipée à part (R2), le calcul du taux de variation (N8). Contredit : la fiche T27 (« frais de maternité jamais payés »). À\nexpliquer : les soins AT/MP et les rentes viagères. Pas publié : dépôts, instances, rejets, durées.",
      "fontSize": 19,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Confirme : la liquidation à la notification (D4), l'accessoire avec la pension (A1), la maternité dans les PF (R1), l'anticipée à part (R2), le calcul du taux de variation (N8). Contredit : la fiche T27 (« frais de maternité jamais payés »). À\nexpliquer : les soins AT/MP et les rentes viagères. Pas publié : dépôts, instances, rejets, durées.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "bJE"
    },
