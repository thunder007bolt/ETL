      "updated": 1794209947917,
      "link": null,
      "locked": false,
      "text": "Une IJ est déposée avec la déclaration, liquidée à sa première notification : un\narrêt prolongé ne fait qu'une demande. Durée depuis la déclaration.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Une IJ est déposée avec la déclaration, liquidée à sa première notification : un\narrêt prolongé ne fait qu'une demande. Durée depuis la déclaration.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "bA5"
    },
