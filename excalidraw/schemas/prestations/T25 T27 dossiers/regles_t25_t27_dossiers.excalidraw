      "isDeleted": false,
      "boundElements": [],
      "updated": 1794209947917,
      "link": null,
      "locked": false,
      "text": "L'annuaire ne publie ni dépôts, ni dossiers en instance, ni rejets, ni durées. Il sert à trois contrôles directs (tableaux 24 ; 35 et 39 ; 47, 48, 72), à des contrôles indirects en personnes (23, 75, 77) et comme modèle de découpage par agence\n(73, 74).",
      "fontSize": 19,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "L'annuaire ne publie ni dépôts, ni dossiers en instance, ni rejets, ni durées. Il sert à trois contrôles directs (tableaux 24 ; 35 et 39 ; 47, 48, 72), à des contrôles indirects en personnes (23, 75, 77) et comme modèle de découpage par agence\n(73, 74).",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "bE8"
    },
