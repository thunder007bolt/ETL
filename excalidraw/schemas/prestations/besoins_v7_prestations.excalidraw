      "isDeleted": false,
      "boundElements": [],
      "updated": 1794178839508,
      "link": null,
      "locked": false,
      "text": "Document : regles_t25_t27_dossiers.md. Liquidé : les droits sont calculés et notifiés à l'assuré ; en instance : déposé, ni liquidé ni rejeté. T26 n'a aucune ligne dans le recueil (partie 7). Les indicateurs de délai et de restes à traiter sont\nen partie 6.",
      "fontSize": 19,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Document : regles_t25_t27_dossiers.md. Liquidé : les droits sont calculés et notifiés à l'assuré ; en instance : déposé, ni liquidé ni rejeté. T26 n'a aucune ligne dans le recueil (partie 7). Les indicateurs de délai et de restes à traiter sont\nen partie 6.",
      "autoResize": true,
      "lineHeight": 1.25
    },
