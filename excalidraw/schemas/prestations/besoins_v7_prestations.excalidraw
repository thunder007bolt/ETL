    },
    {
      "id": "NmLOhlNJUjJyS1ZEBCFU",
      "type": "text",
      "x": 1337.0,
      "y": 28307.75,
      "width": 570.6,
      "height": 112.5,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "CdanNiGLchcKYTZAJEcv"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1514597038,
      "version": 1,
      "versionNonce": 1612095520,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794178839508,
      "link": null,
      "locked": false,
      "text": "La date d'un paiement : T32-T41 Q2 et T50-T57 Q1\nprennent la formulation de T28-T31 Q24 (le mois payé, la\nsaisie ou le versement) et disent qu'elles en sont la\nreprise (DPC 1). Les autres reprises (DPC 2, DPC 5, DCP\n15, DCP 23, DSI 9) le disent aussi.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "La date d'un paiement : T32-T41 Q2 et T50-T57 Q1\nprennent la formulation de T28-T31 Q24 (le mois payé, la\nsaisie ou le versement) et disent qu'elles en sont la\nreprise (DPC 1). Les autres reprises (DPC 2, DPC 5, DCP\n15, DCP 23, DSI 9) le disent aussi.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "pocJmTC3GwN9VprnfJ7t",
      "type": "rectangle",
      "x": 1960.0,
      "y": 28255.5,
      "width": 615.0,
      "height": 209.0,
      "angle": 0,
      "strokeColor": "#c92a2a",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 3,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
