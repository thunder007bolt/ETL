      "text": "Corrigé : une même question posée de trois façons",
      "fontSize": 21,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Corrigé : une même question posée de trois façons",
