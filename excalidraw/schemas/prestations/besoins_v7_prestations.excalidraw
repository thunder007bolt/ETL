      "updated": 1794178839508,
      "link": null,
      "locked": false,
      "text": "Dans T41, on compte une fois la personne au nom de qui le\ndossier d'allocations familiales est ouvert (l'assuré) : pas\nles enfants, pas celui qui encaisse",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Dans T41, on compte une fois la personne au nom de qui le\ndossier d'allocations familiales est ouvert (l'assuré) : pas\nles enfants, pas celui qui encaisse",
      "autoResize": true,
      "lineHeight": 1.25
    },
