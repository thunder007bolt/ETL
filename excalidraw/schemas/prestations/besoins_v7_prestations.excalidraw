      "boundElements": [],
      "updated": 1794178839508,
      "link": null,
      "locked": false,
      "text": "« Les informaticiens doivent développer un nouveau module pour la gestion\ndes pensions d'invalidité qui sont convertis en pension normale dès que\nl'assuré atteint l'âge de départ à la retraite »",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "« Les informaticiens doivent développer un nouveau module pour la gestion\ndes pensions d'invalidité qui sont convertis en pension normale dès que\nl'assuré atteint l'âge de départ à la retraite »",
      "autoResize": true,
      "lineHeight": 1.25
    },
