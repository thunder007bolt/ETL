      "isDeleted": false,
      "boundElements": [],
      "updated": 1794178839508,
      "link": null,
      "locked": false,
      "text": "Une ligne = une demande du recueil telle qu'une ou plusieurs familles la traitent, avec un seul statut. Le statut et la question sont ceux du document de famille, sans rien changer.",
      "fontSize": 19,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Une ligne = une demande du recueil telle qu'une ou plusieurs familles la traitent, avec un seul statut. Le statut et la question sont ceux du document de famille, sans rien changer.",
      "autoResize": true,
      "lineHeight": 1.25
    },
