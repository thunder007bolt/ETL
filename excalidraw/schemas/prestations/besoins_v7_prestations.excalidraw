    {
      "id": "fJBd0Kh8oOOL8dKLzdoc",
      "type": "text",
      "x": 0,
      "y": 66,
      "width": 2533.5200000000004,
      "height": 82.5,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
