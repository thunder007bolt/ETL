      "locked": false
    },
    {
      "id": "kOBSzyoya3b5542TmEMc",
      "type": "text",
      "x": 1982.0,
      "y": 28271.5,
      "width": 563.6400000000001,
      "height": 52.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "8tcaDqQ7eDQiwOkUcMzC"
      ],
