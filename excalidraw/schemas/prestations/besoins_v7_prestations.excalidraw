      "isDeleted": false,
      "boundElements": [],
      "updated": 1794178839508,
      "link": null,
      "locked": false,
      "text": "Reste, justifié : une même valeur par défaut, deux\npropositions",
      "fontSize": 21,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Reste, justifié : une même valeur par défaut, deux\npropositions",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "6BVugYEkS0acGIFlhskw",
      "type": "text",
      "x": 1982.0,
      "y": 28334.0,
      "width": 564.48,
      "height": 112.5,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "8tcaDqQ7eDQiwOkUcMzC"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 54367500,
      "version": 1,
      "versionNonce": 1217721190,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794178839508,
      "link": null,
      "locked": false,
      "text": "Pour la date d'un paiement, toutes les familles gardent le\nmois payé (date_montant = MOIS) ; T50-T57 propose en\nplus de passer à la saisie. Ce réglage est dans quatre\nrequêtes et se décide une fois pour tout le domaine (DPC\n1).",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Pour la date d'un paiement, toutes les familles gardent le\nmois payé (date_montant = MOIS) ; T50-T57 propose en\nplus de passer à la saisie. Ce réglage est dans quatre\nrequêtes et se décide une fois pour tout le domaine (DPC\n1).",
      "autoResize": true,
      "lineHeight": 1.25
    },
