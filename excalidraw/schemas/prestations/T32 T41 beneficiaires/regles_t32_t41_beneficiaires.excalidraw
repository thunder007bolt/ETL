      "versionNonce": 1224215801,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794178592238,
      "link": null,
      "locked": false,
      "text": "• À faire : exécuter t32_t41 et les comparaisons A06 à A08 ; un lot de contrôle (âge des allocataires, montants mois par mois pour Q2, veuves, enfants par âge) ; réglages après visa ; table de l'entrepôt à choisir avec\nJules.",
      "fontSize": 21,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "• À faire : exécuter t32_t41 et les comparaisons A06 à A08 ; un lot de contrôle (âge des allocataires, montants mois par mois pour Q2, veuves, enfants par âge) ; réglages après visa ; table de l'entrepôt à choisir avec\nJules.",
      "autoResize": true,
      "lineHeight": 1.25
    },
