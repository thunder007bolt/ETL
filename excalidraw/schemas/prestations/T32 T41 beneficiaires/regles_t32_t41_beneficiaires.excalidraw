      "seed": 779506546,
      "version": 1,
      "versionNonce": 1267333627,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794178592238,
      "link": null,
      "locked": false,
      "text": "L'annuaire publie presque tous ces effectifs, sauf l'âge des allocataires. Seule 2024 a été publiée sur une base proche de la nôtre ; quand 2020 à 2023 s'écartent, c'est dit. Les modèles de ratios de la CNSS (feuilles 03 à 06) n'apportent\nrien de direct ici.",
      "fontSize": 19,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "L'annuaire publie presque tous ces effectifs, sauf l'âge des allocataires. Seule 2024 a été publiée sur une base proche de la nôtre ; quand 2020 à 2023 s'écartent, c'est dit. Les modèles de ratios de la CNSS (feuilles 03 à 06) n'apportent\nrien de direct ici.",
      "autoResize": true,
      "lineHeight": 1.25
    },
