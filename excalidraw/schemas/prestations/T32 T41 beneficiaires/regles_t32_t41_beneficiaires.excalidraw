      "isDeleted": false,
      "boundElements": [],
      "updated": 1794178592238,
      "link": null,
      "locked": false,
      "text": "Année du calcul moins année de naissance ; grille de chaque maquette ; sexe 1\nhommes, 2 femmes. Proposé : 120 ans et plus dans « 100 ans et plus ».",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Année du calcul moins année de naissance ; grille de chaque maquette ; sexe 1\nhommes, 2 femmes. Proposé : 120 ans et plus dans « 100 ans et plus ».",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "nsgJ3tG2uA9l5g7SeiIK",
      "type": "text",
      "x": 1767.0,
      "y": 4390.0,
      "width": 742.7300000000001,
      "height": 21.25,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "D1uYLHB7WPQYUY0duiMm"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 995816321,
      "version": 1,
      "versionNonce": 1973855910,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794178592238,
      "link": null,
      "locked": false,
      "text": "Exemple : né en 1960 : 64 ans en 2024 ; veuve « née en 1900 » : 100 ans et plus.",
      "fontSize": 17,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Exemple : né en 1960 : 64 ans en 2024 ; veuve « née en 1900 » : 100 ans et plus.",
