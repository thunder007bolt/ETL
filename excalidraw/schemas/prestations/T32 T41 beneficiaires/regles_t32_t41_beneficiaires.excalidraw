    {
      "id": "Hyim0TSDPeppU5Q7sHRt",
      "type": "text",
      "x": 47,
      "y": 10661.25,
      "width": 2456.51,
      "height": 47.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
