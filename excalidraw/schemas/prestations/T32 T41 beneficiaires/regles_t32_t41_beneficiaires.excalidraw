    {
      "id": "1dAV9hnnyCJUSfmu6nOW",
      "type": "text",
      "x": 47,
      "y": 7808.75,
      "width": 2460.1200000000003,
      "height": 47.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
