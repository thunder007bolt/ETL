    {
      "id": "84NZvOrCcYMbbYjKOgNz",
      "type": "text",
      "x": 47,
      "y": 10391.0,
      "width": 2470.38,
      "height": 71.25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "AEWI8hNKmqycFxRNqirH"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 451255544,
      "version": 1,
      "versionNonce": 539227019,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794178592238,
      "link": null,
      "locked": false,
      "text": "Confirme : le bénéficiaire payé ou non (R6), l'orphelin à son âge, T41 en 2024, les grilles et le sexe (R8), l'accessoire pas compté à part (A1), l'invalidité gardée (N5). Tranche : l'anticipée à part (N4), « 1900 » dans « 100 ans et plus »\n(R8), 21 ans pour les enfants, accessoires hors du montant (N13). Précise : la DR du dossier (N3), le montant, les séries mensuelles. À expliquer : veuves, orphelins, rentes d'orphelins, historiques de T36, T40, T41, forme par âge, montants\ndes rentes. Pas publié : âge des allocataires, T34, T36, T38 à T40 par âge.",
      "fontSize": 19,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Confirme : le bénéficiaire payé ou non (R6), l'orphelin à son âge, T41 en 2024, les grilles et le sexe (R8), l'accessoire pas compté à part (A1), l'invalidité gardée (N5). Tranche : l'anticipée à part (N4), « 1900 » dans « 100 ans et plus »\n(R8), 21 ans pour les enfants, accessoires hors du montant (N13). Précise : la DR du dossier (N3), le montant, les séries mensuelles. À expliquer : veuves, orphelins, rentes d'orphelins, historiques de T36, T40, T41, forme par âge, montants\ndes rentes. Pas publié : âge des allocataires, T34, T36, T38 à T40 par âge.",
      "autoResize": true,
      "lineHeight": 1.25
    },
