      "text": "AVG(CASE WHEN mois BETWEEN 1 AND 600\n         THEN GREATEST(mois\n              - NVL(mois_autre_caisse, 0), 0)\n    END)          AS services_moyens",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
