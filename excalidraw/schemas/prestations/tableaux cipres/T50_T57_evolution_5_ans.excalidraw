      "isDeleted": false,
      "boundElements": [],
      "updated": 1793533399254,
      "link": null,
      "locked": false,
      "text": "SELECT 'T50' AS tableau, 'RAV' AS code\nFROM DUAL\nUNION ALL SELECT 'T51', 'RASC' FROM DUAL\nUNION ALL SELECT 'T51', 'RASO' FROM DUAL\n-- … T52 AIJ, T53 AAI, T54 MIJ,\n-- T55 FAP et MAP",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "SELECT 'T50' AS tableau, 'RAV' AS code\nFROM DUAL\nUNION ALL SELECT 'T51', 'RASC' FROM DUAL\nUNION ALL SELECT 'T51', 'RASO' FROM DUAL\n-- … T52 AIJ, T53 AAI, T54 MIJ,\n-- T55 FAP et MAP",
      "autoResize": true,
      "lineHeight": 1.25
