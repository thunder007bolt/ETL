      "link": null,
      "locked": false,
      "text": "-- pension directe en cours au décès\np.TPE_CODE IN ('RPV', 'RPRA', 'RPI')\nAND p.PE_DATE_EFFET <= de.date_deces\n-- sinistré : mort dans l'année\nds.DOS_DATE_ACCIDENT <= de.date_deces\nAND de.date_deces\n    < ds.DOS_DATE_ACCIDENT + 366",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-- pension directe en cours au décès\np.TPE_CODE IN ('RPV', 'RPRA', 'RPI')\nAND p.PE_DATE_EFFET <= de.date_deces\n-- sinistré : mort dans l'année\nds.DOS_DATE_ACCIDENT <= de.date_deces\nAND de.date_deces\n    < ds.DOS_DATE_ACCIDENT + 366",
      "autoResize": true,
      "lineHeight": 1.25
