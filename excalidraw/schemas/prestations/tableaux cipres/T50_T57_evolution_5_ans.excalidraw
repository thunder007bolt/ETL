      "type": "text",
      "x": 844.4000000000001,
      "y": 3898.5,
      "width": 389.76,
      "height": 140.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
