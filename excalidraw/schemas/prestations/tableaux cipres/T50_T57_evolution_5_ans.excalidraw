    {
      "id": "oWiUF5S7MxeVgzqkqFJL",
      "type": "text",
      "x": 25,
      "y": 3374.0,
      "width": 2460.0600000000004,
      "height": 45.0,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 132262248,
      "version": 1,
      "versionNonce": 820552748,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793533399254,
      "link": null,
      "locked": false,
      "text": "À droite de chaque règle, sa traduction en SQL, pour la DSI et l'équipe BI : un extrait de la requête commune à T50-T57 (analyses/prestations/t50_t57_requete_proposee.sql), en trois parties : T50 à T55, T56, T57. Elle lit les copies de l'entrepôt\n(DWH.FAIT_…) du cliché choisi ; l'année N est un paramètre.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "À droite de chaque règle, sa traduction en SQL, pour la DSI et l'équipe BI : un extrait de la requête commune à T50-T57 (analyses/prestations/t50_t57_requete_proposee.sql), en trois parties : T50 à T55, T56, T57. Elle lit les copies de l'entrepôt\n(DWH.FAIT_…) du cliché choisi ; l'année N est un paramètre.",
      "autoResize": true,
      "lineHeight": 1.25
    },
