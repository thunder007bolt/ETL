      "seed": 303192353,
      "version": 1,
      "versionNonce": 1305423165,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793533399254,
      "link": null,
      "locked": false,
      "text": "CASE deb.CODE_BRANCHE\n     WHEN 'V' THEN 'AVS'\n     WHEN 'A' THEN 'AT/MP'\n     WHEN 'F' THEN 'PF'\n     WHEN 'M' THEN 'PF'\n     ELSE          'AUTRES'\nEND AS branche\n-- paiements et remboursements\nWHERE deb.DEB_TYPE IN ('PM', 'RB')",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "CASE deb.CODE_BRANCHE\n     WHEN 'V' THEN 'AVS'\n     WHEN 'A' THEN 'AT/MP'\n     WHEN 'F' THEN 'PF'\n     WHEN 'M' THEN 'PF'\n     ELSE          'AUTRES'\nEND AS branche\n-- paiements et remboursements\nWHERE deb.DEB_TYPE IN ('PM', 'RB')",
      "autoResize": true,
      "lineHeight": 1.25
    },
