      "seed": 1617080700,
      "version": 1,
      "versionNonce": 262171808,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793533399254,
      "link": null,
      "locked": false,
      "text": "ROW_NUMBER() OVER (\n  PARTITION BY tableau, annee_liquidation,\n               IND_ID_PREST\n  ORDER BY PE_DATE_NOTIFICATION DESC)\n                  AS rang\n-- une personne par tableau et par année\nWHERE rang = 1",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "ROW_NUMBER() OVER (\n  PARTITION BY tableau, annee_liquidation,\n               IND_ID_PREST\n  ORDER BY PE_DATE_NOTIFICATION DESC)\n                  AS rang\n-- une personne par tableau et par année\nWHERE rang = 1",
      "autoResize": true,
      "lineHeight": 1.25
    },
