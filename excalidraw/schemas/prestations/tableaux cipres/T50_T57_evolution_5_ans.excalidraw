      "versionNonce": 481451116,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793533399254,
      "link": null,
      "locked": false,
      "text": "T50 à T55 suivent chacun une prestation sur 5 ans : combien de\nbénéficiaires chaque année, par sexe, et ce qui leur a été servi. T56\nrécapitule les montants par branche, T57 les assurés décédés par branche.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "T50 à T55 suivent chacun une prestation sur 5 ans : combien de\nbénéficiaires chaque année, par sexe, et ce qui leur a été servi. T56\nrécapitule les montants par branche, T57 les assurés décédés par branche.",
      "autoResize": true,
      "lineHeight": 1.25
    },
