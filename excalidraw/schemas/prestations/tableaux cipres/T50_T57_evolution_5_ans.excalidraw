      "versionNonce": 1963039336,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793533399254,
      "link": null,
      "locked": false,
      "text": "Ce qui a été payé dans l'année : les débours de paiement au statut D ou P.\nL'année d'un paiement est celle du mois qu'il paie, ou celle où il est versé.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
