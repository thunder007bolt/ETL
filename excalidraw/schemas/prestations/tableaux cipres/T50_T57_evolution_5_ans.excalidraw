    {
      "id": "1AzNZiBYesanof7LwlMH",
      "type": "text",
      "x": 2139.4,
      "y": 3898.5,
      "width": 417.59999999999997,
      "height": 160.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "KTsv4cy2SPuzqWrvfAlt"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1888475104,
      "version": 1,
      "versionNonce": 1578282667,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793533399254,
      "link": null,
      "locked": false,
      "text": "-- date_montant : 'MOIS' ou 'SAISIE'\nEXTRACT(YEAR FROM\n  CASE pr.date_montant\n       WHEN 'SAISIE' THEN deb.DEB_DATE_INSERT\n       ELSE deb.DEB_DATE_EFFET END) AS annee\n-- débours de paiement D ou P\nWHERE deb.DEB_TYPE = 'PM'\n  AND deb.DEB_STATUT IN ('D', 'P')",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-- date_montant : 'MOIS' ou 'SAISIE'\nEXTRACT(YEAR FROM\n  CASE pr.date_montant\n       WHEN 'SAISIE' THEN deb.DEB_DATE_INSERT\n       ELSE deb.DEB_DATE_EFFET END) AS annee\n-- débours de paiement D ou P\nWHERE deb.DEB_TYPE = 'PM'\n  AND deb.DEB_STATUT IN ('D', 'P')",
      "autoResize": true,
      "lineHeight": 1.25
    },
