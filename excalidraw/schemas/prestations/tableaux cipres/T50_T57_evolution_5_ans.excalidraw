      "link": null,
      "locked": false,
      "text": "-- l'année de la première notification\nEXTRACT(YEAR FROM p.PE_DATE_NOTIFICATION)\n                  AS annee_liquidation\n-- … dans les 5 années\nWHERE annee_liquidation IN\n      (SELECT annee FROM annees)",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-- l'année de la première notification\nEXTRACT(YEAR FROM p.PE_DATE_NOTIFICATION)\n                  AS annee_liquidation\n-- … dans les 5 années\nWHERE annee_liquidation IN\n      (SELECT annee FROM annees)",
      "autoResize": true,
      "lineHeight": 1.25
    },
