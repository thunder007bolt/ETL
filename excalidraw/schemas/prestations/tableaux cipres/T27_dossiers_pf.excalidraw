      "isDeleted": false,
      "boundElements": [],
      "updated": 1793576376919,
      "link": null,
      "locked": false,
      "text": "La somme des lignes : chaque demande compte une fois. Une grossesse\ncompte donc deux fois, un allocataire une fois, plus une fois par enfant\najouté. Les réceptions sans prestation s'ajoutent aux déposés et aux en\ninstance.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "La somme des lignes : chaque demande compte une fois. Une grossesse\ncompte donc deux fois, un allocataire une fois, plus une fois par enfant\najouté. Les réceptions sans prestation s'ajoutent aux déposés et aux en\ninstance.",
      "autoResize": true,
      "lineHeight": 1.25
    },
