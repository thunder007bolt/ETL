      "text": "Règle 5 en SQL",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Règle 5 en SQL",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "BC9CBs6168pD09pyz0D0",
      "type": "text",
      "x": 788.72,
      "y": 4315.5,
      "width": 454.71999999999997,
      "height": 260.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "jJsv3yApA4bKjEjQO9M8"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1716882735,
      "version": 1,
      "versionNonce": 1367504773,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793576376919,
      "link": null,
      "locked": false,
      "text": "-- à coller sous le WITH des règles 3 et 4\nSELECT ligne,\n       SUM(CASE WHEN jours < 15\n                THEN 1 ELSE 0 END) AS moins_15,\n       SUM(CASE WHEN jours BETWEEN 15 AND 45\n                THEN 1 ELSE 0 END) AS de_15_a_45,\n       SUM(CASE WHEN jours > 45\n                THEN 1 ELSE 0 END) AS plus_45\nFROM   durees\nGROUP  BY ligne\n-- dossiers ouverts en 2025 : allocataires\n-- 57 %, 24 %, 19 % ; maternité 44 %,\n-- 44 %, 12 %",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-- à coller sous le WITH des règles 3 et 4\nSELECT ligne,\n       SUM(CASE WHEN jours < 15\n                THEN 1 ELSE 0 END) AS moins_15,\n       SUM(CASE WHEN jours BETWEEN 15 AND 45\n                THEN 1 ELSE 0 END) AS de_15_a_45,\n       SUM(CASE WHEN jours > 45\n                THEN 1 ELSE 0 END) AS plus_45\nFROM   durees\nGROUP  BY ligne\n-- dossiers ouverts en 2025 : allocataires\n-- 57 %, 24 %, 19 % ; maternité 44 %,\n-- 44 %, 12 %",
      "autoResize": true,
      "lineHeight": 1.25
    },
