      "updated": 1793576376919,
      "link": null,
      "locked": false,
      "text": "-- à coller sous le WITH des règles 3 et 4\nSELECT ligne,\n       ROUND(AVG(jours)) AS duree_moyenne,\n       MEDIAN(jours)     AS duree_mediane\nFROM   durees\nGROUP  BY ligne\n-- la norme : moins de 45 jours",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-- à coller sous le WITH des règles 3 et 4\nSELECT ligne,\n       ROUND(AVG(jours)) AS duree_moyenne,\n       MEDIAN(jours)     AS duree_mediane\nFROM   durees\nGROUP  BY ligne\n-- la norme : moins de 45 jours",
      "autoResize": true,
      "lineHeight": 1.25
    },
