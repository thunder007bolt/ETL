      "link": null,
      "locked": false,
      "text": "Règle 3 en SQL",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Règle 3 en SQL",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "jhu9r9dw8rN33kszUXrs",
      "type": "text",
      "x": 788.72,
      "y": 3331.5,
      "width": 473.28,
      "height": 900.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "ANveV1O9D7XKjVOpGOHf"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 722468367,
      "version": 1,
      "versionNonce": 1881599873,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793576376919,
      "link": null,
      "locked": false,
      "text": "-- demandes : une par dossier et par ligne\n-- du tableau, réutilisée ensuite\nWITH prest AS (\n  SELECT pe.DOS_CODE, pe.PE_DATE_DEMANDE,\n         pe.PE_DATE_NOTIFICATION,\n         CASE WHEN pe.TPE_CODE = 'FAF' THEN 1\n              WHEN pe.TPE_CODE = 'MIJ' THEN 2\n              WHEN pe.TPE_CODE IN ('MAP','FAP')\n                                       THEN 3\n              ELSE 4 END AS ligne\n  FROM   USER_DWH.PRESTATION_ESP pe\n  JOIN   USER_DWH.DOSSIER d\n         ON d.DOS_CODE = pe.DOS_CODE\n  WHERE  d.TDOS_CODE IN ('F', 'M')),\ndemandes AS (\n  -- liquidée à sa première notification\n  SELECT DOS_CODE, ligne,\n         MIN(PE_DATE_DEMANDE)   AS date_demande,\n         MIN(PE_DATE_NOTIFICATION)\n                                AS date_liquidation\n  FROM   prest\n  GROUP  BY DOS_CODE, ligne)\nSELECT ligne, COUNT(*)\nFROM   demandes\nWHERE  date_liquidation >= DATE '2025-01-01'\nAND    date_liquidation <  DATE '2026-01-01'\nGROUP  BY ligne\nORDER  BY ligne\n-- 2025 : allocataires 8 246, IJ de\n-- maternité 4 273, prénatales 4 245\n-- enfant ajouté, sous le même WITH :\n-- chaque autre date de notification FAF\nSELECT COUNT(DISTINCT p.DOS_CODE)\nFROM   prest p\nJOIN   demandes dm\n       ON  dm.DOS_CODE = p.DOS_CODE\n       AND dm.ligne = 1\nWHERE  p.ligne = 1\nAND    p.PE_DATE_NOTIFICATION\n         > dm.date_liquidation\nAND    p.PE_DATE_NOTIFICATION\n         >= DATE '2025-01-01'\nAND    p.PE_DATE_NOTIFICATION\n         <  DATE '2026-01-01'\n-- 2025 : environ 8 100 dossiers",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-- demandes : une par dossier et par ligne\n-- du tableau, réutilisée ensuite\nWITH prest AS (\n  SELECT pe.DOS_CODE, pe.PE_DATE_DEMANDE,\n         pe.PE_DATE_NOTIFICATION,\n         CASE WHEN pe.TPE_CODE = 'FAF' THEN 1\n              WHEN pe.TPE_CODE = 'MIJ' THEN 2\n              WHEN pe.TPE_CODE IN ('MAP','FAP')\n                                       THEN 3\n              ELSE 4 END AS ligne\n  FROM   USER_DWH.PRESTATION_ESP pe\n  JOIN   USER_DWH.DOSSIER d\n         ON d.DOS_CODE = pe.DOS_CODE\n  WHERE  d.TDOS_CODE IN ('F', 'M')),\ndemandes AS (\n  -- liquidée à sa première notification\n  SELECT DOS_CODE, ligne,\n         MIN(PE_DATE_DEMANDE)   AS date_demande,\n         MIN(PE_DATE_NOTIFICATION)\n                                AS date_liquidation\n  FROM   prest\n  GROUP  BY DOS_CODE, ligne)\nSELECT ligne, COUNT(*)\nFROM   demandes\nWHERE  date_liquidation >= DATE '2025-01-01'\nAND    date_liquidation <  DATE '2026-01-01'\nGROUP  BY ligne\nORDER  BY ligne\n-- 2025 : allocataires 8 246, IJ de\n-- maternité 4 273, prénatales 4 245\n-- enfant ajouté, sous le même WITH :\n-- chaque autre date de notification FAF\nSELECT COUNT(DISTINCT p.DOS_CODE)\nFROM   prest p\nJOIN   demandes dm\n       ON  dm.DOS_CODE = p.DOS_CODE\n       AND dm.ligne = 1\nWHERE  p.ligne = 1\nAND    p.PE_DATE_NOTIFICATION\n         > dm.date_liquidation\nAND    p.PE_DATE_NOTIFICATION\n         >= DATE '2025-01-01'\nAND    p.PE_DATE_NOTIFICATION\n         <  DATE '2026-01-01'\n-- 2025 : environ 8 100 dossiers",
      "autoResize": true,
      "lineHeight": 1.25
    },
