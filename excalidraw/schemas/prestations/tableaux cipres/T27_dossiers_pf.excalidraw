      "text": "-- F : prestations familiales, un dossier\n-- par allocataire ; M : maternité, un\n-- dossier par grossesse\nSELECT TDOS_CODE, COUNT(*)\nFROM   USER_DWH.DOSSIER\nWHERE  TDOS_CODE IN ('F', 'M')\nGROUP  BY TDOS_CODE",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-- F : prestations familiales, un dossier\n-- par allocataire ; M : maternité, un\n-- dossier par grossesse\nSELECT TDOS_CODE, COUNT(*)\nFROM   USER_DWH.DOSSIER\nWHERE  TDOS_CODE IN ('F', 'M')\nGROUP  BY TDOS_CODE",
      "autoResize": true,
      "lineHeight": 1.25
