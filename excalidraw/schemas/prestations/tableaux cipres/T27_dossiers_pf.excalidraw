      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Règle 4 en SQL",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "cod9KQrDubBeKZm1UwHz",
      "type": "text",
      "x": 2083.7200000000003,
      "y": 3331.5,
      "width": 473.28,
      "height": 460.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "QvRKc77WwMPZSu8FGm9i"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 143699362,
      "version": 1,
      "versionNonce": 70562588,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793576376919,
      "link": null,
      "locked": false,
      "text": "-- à ajouter à la suite du WITH de la\n-- règle 3 : dépôt = la réception qui a\n-- ouvert le dossier, sinon la date de\n-- demande ; une durée négative compte 0\ndurees AS (\n  SELECT dm.ligne,\n         GREATEST(TRUNC(dm.date_liquidation)\n           - TRUNC(NVL(\n               (SELECT r.RD_DATE_RECEPTION\n                FROM   USER_DWH.DOSSIER d\n                JOIN   USER_DWH.RECEPTION_DOSSIER r\n                       ON r.RD_ID = d.RD_ID\n                WHERE  d.DOS_CODE = dm.DOS_CODE),\n               dm.date_demande)), 0) AS jours\n  FROM   demandes dm\n  WHERE  dm.date_liquidation >= DATE '2025-01-01'\n  AND    dm.date_liquidation <  DATE '2026-01-01')\nSELECT ligne, MEDIAN(jours)\nFROM   durees\nGROUP  BY ligne\n-- 2025 : allocataires 13,5 j, maternité 17\n-- enfant ajouté : de sa PE_DATE_DEMANDE à\n-- sa notification, environ 11 j",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-- à ajouter à la suite du WITH de la\n-- règle 3 : dépôt = la réception qui a\n-- ouvert le dossier, sinon la date de\n-- demande ; une durée négative compte 0\ndurees AS (\n  SELECT dm.ligne,\n         GREATEST(TRUNC(dm.date_liquidation)\n           - TRUNC(NVL(\n               (SELECT r.RD_DATE_RECEPTION\n                FROM   USER_DWH.DOSSIER d\n                JOIN   USER_DWH.RECEPTION_DOSSIER r\n                       ON r.RD_ID = d.RD_ID\n                WHERE  d.DOS_CODE = dm.DOS_CODE),\n               dm.date_demande)), 0) AS jours\n  FROM   demandes dm\n  WHERE  dm.date_liquidation >= DATE '2025-01-01'\n  AND    dm.date_liquidation <  DATE '2026-01-01')\nSELECT ligne, MEDIAN(jours)\nFROM   durees\nGROUP  BY ligne\n-- 2025 : allocataires 13,5 j, maternité 17\n-- enfant ajouté : de sa PE_DATE_DEMANDE à\n-- sa notification, environ 11 j",
      "autoResize": true,
      "lineHeight": 1.25
    },
