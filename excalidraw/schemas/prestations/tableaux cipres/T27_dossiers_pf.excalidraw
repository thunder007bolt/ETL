    },
    {
      "id": "bEd7yBxrYKfOFwCSWpnL",
      "type": "text",
      "x": 25,
      "y": 2636.0,
      "width": 2478.6000000000004,
      "height": 67.5,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 395878081,
      "version": 1,
      "versionNonce": 1544970462,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793576376919,
      "link": null,
      "locked": false,
      "text": "À droite de chaque règle, une requête courte sur les vraies tables de l'application (schéma USER_DWH), pour l'année 2025, à copier dans SQL Developer. La règle 3 construit la liste des demandes (une par dossier et par ligne du tableau, avec sa première\nnotification) ; la règle 4 y ajoute leur durée (durees). Pour les règles 5, 8 et 9, on colle leur requête sous ce WITH, à la place de sa dernière requête. Le commentaire en fin de requête donne le chiffre à retrouver. La requête complète, sur les copies de\nl'entrepôt, est dans analyses/prestations/t27_requete_proposee.sql.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "À droite de chaque règle, une requête courte sur les vraies tables de l'application (schéma USER_DWH), pour l'année 2025, à copier dans SQL Developer. La règle 3 construit la liste des demandes (une par dossier et par ligne du tableau, avec sa première\nnotification) ; la règle 4 y ajoute leur durée (durees). Pour les règles 5, 8 et 9, on colle leur requête sous ce WITH, à la place de sa dernière requête. Le commentaire en fin de requête donne le chiffre à retrouver. La requête complète, sur les copies de\nl'entrepôt, est dans analyses/prestations/t27_requete_proposee.sql.",
      "autoResize": true,
      "lineHeight": 1.25
    },
