    {
      "id": "doOq0pLm1gGhaoCImiIe",
      "type": "text",
      "x": 788.72,
      "y": 4979.5,
      "width": 408.32,
      "height": 140.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "nqrArAlIMwJEjQTQ92Zg"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 967503330,
      "version": 1,
      "versionNonce": 1971410357,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793576376919,
      "link": null,
      "locked": false,
      "text": "SELECT TDOS_CODE, COUNT(*)\nFROM   USER_DWH.DOSSIER_REJETE\nWHERE  TDOS_CODE IN ('F', 'M')\nAND    DOSRE_DATE_REJET >= DATE '2025-01-01'\nAND    DOSRE_DATE_REJET <  DATE '2026-01-01'\nGROUP  BY TDOS_CODE\n-- 2025 : 21",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "SELECT TDOS_CODE, COUNT(*)\nFROM   USER_DWH.DOSSIER_REJETE\nWHERE  TDOS_CODE IN ('F', 'M')\nAND    DOSRE_DATE_REJET >= DATE '2025-01-01'\nAND    DOSRE_DATE_REJET <  DATE '2026-01-01'\nGROUP  BY TDOS_CODE\n-- 2025 : 21",
      "autoResize": true,
      "lineHeight": 1.25
    },
