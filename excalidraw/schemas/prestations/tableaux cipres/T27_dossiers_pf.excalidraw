      "seed": 965516056,
      "version": 1,
      "versionNonce": 1748235347,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793576376919,
      "link": null,
      "locked": false,
      "text": "-- le Total : toutes les demandes\n-- ensemble, la moyenne recalculée ; une\n-- grossesse compte deux fois (lignes 2 et\n-- 3), un allocataire une fois, plus une\n-- fois par enfant ajouté (règle 3)\nSELECT COUNT(*)          AS liquides,\n       ROUND(AVG(jours)) AS duree_moyenne,\n       MEDIAN(jours)     AS duree_mediane\nFROM   durees",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-- le Total : toutes les demandes\n-- ensemble, la moyenne recalculée ; une\n-- grossesse compte deux fois (lignes 2 et\n-- 3), un allocataire une fois, plus une\n-- fois par enfant ajouté (règle 3)\nSELECT COUNT(*)          AS liquides,\n       ROUND(AVG(jours)) AS duree_moyenne,\n       MEDIAN(jours)     AS duree_mediane\nFROM   durees",
      "autoResize": true,
      "lineHeight": 1.25
    },
