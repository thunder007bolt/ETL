    {
      "id": "7jHPbx8zoTzscwz4Okz8",
      "type": "text",
      "x": 788.72,
      "y": 3301.5,
      "width": 132.96,
      "height": 20.0,
      "angle": 0,
      "strokeColor": "#495057",
