    {
      "id": "3fDI9PjP4WHeJllzWM9k",
      "type": "text",
      "x": 2083.7200000000003,
      "y": 2767.5,
      "width": 417.59999999999997,
      "height": 200.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "GeiaYZk0VWlCwgSilG40"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 561473951,
      "version": 1,
      "versionNonce": 509437150,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793576376919,
      "link": null,
      "locked": false,
      "text": "-- les demandes reçues au guichet en 2025\nSELECT TDOS_CODE, COUNT(*)\nFROM   USER_DWH.RECEPTION_DOSSIER\nWHERE  TDOS_CODE IN ('F', 'M')\nAND    RD_DATE_RECEPTION >= DATE '2025-01-01'\nAND    RD_DATE_RECEPTION <  DATE '2026-01-01'\nGROUP  BY TDOS_CODE\n-- 2025 : 14 306 = 9 968 F + 4 338 M\n-- un enfant ajouté ne passe pas au guichet :\n-- il est déposé à sa PE_DATE_DEMANDE",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-- les demandes reçues au guichet en 2025\nSELECT TDOS_CODE, COUNT(*)\nFROM   USER_DWH.RECEPTION_DOSSIER\nWHERE  TDOS_CODE IN ('F', 'M')\nAND    RD_DATE_RECEPTION >= DATE '2025-01-01'\nAND    RD_DATE_RECEPTION <  DATE '2026-01-01'\nGROUP  BY TDOS_CODE\n-- 2025 : 14 306 = 9 968 F + 4 338 M\n-- un enfant ajouté ne passe pas au guichet :\n-- il est déposé à sa PE_DATE_DEMANDE",
      "autoResize": true,
      "lineHeight": 1.25
    },
