      "updated": 1793576376919,
      "link": null,
      "locked": false,
      "text": "« Allocations familiales » compte environ 16 400 liquidations\nen 2025 au lieu de 8 246 ; chacune est déposée à la date de sa\ndemande, liquidée en 11 jours en médiane.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "« Allocations familiales » compte environ 16 400 liquidations\nen 2025 au lieu de 8 246 ; chacune est déposée à la date de sa\ndemande, liquidée en 11 jours en médiane.",
      "autoResize": true,
      "lineHeight": 1.25
