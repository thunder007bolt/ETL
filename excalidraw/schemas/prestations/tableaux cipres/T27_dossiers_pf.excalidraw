    },
    {
      "id": "MSDupbR9eiegDRMLxyYw",
      "type": "text",
      "x": 45,
      "y": 6540.0,
      "width": 1077.6000000000001,
      "height": 80.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "WLqlDAZQa78wudieiNzk"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 2111508277,
      "version": 1,
      "versionNonce": 347679128,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793576376919,
      "link": null,
      "locked": false,
      "text": "Un dossier de maternité = une grossesse : une mère n'en a qu'un par an.\nLa grossesse est déposée environ 3 semaines avant l'accouchement : la durée ne compte pas l'attente de la naissance.\nL'allocation prénatale est notifiée, en même temps que l'IJ, 15 jours après la demande.\nUn enfant ajouté ne passe pas au guichet : 6 réceptions sur un dossier existant en 2025, pour environ 9 000 enfants ajoutés.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Un dossier de maternité = une grossesse : une mère n'en a qu'un par an.\nLa grossesse est déposée environ 3 semaines avant l'accouchement : la durée ne compte pas l'attente de la naissance.\nL'allocation prénatale est notifiée, en même temps que l'IJ, 15 jours après la demande.\nUn enfant ajouté ne passe pas au guichet : 6 réceptions sur un dossier existant en 2025, pour environ 9 000 enfants ajoutés.",
      "autoResize": true,
      "lineHeight": 1.25
    }
