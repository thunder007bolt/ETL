    {
      "id": "Ohng8RbvKbace0tDXdad",
      "type": "text",
      "x": 798.0,
      "y": 4345.5,
      "width": 463.99999999999994,
      "height": 240.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "xbeH5xU1xtwju9AzeW85"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 477849134,
      "version": 1,
      "versionNonce": 1863509878,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793576377196,
      "link": null,
      "locked": false,
      "text": "SELECT tranche, COUNT(*)\nFROM  (SELECT CASE\n                WHEN age IS NULL OR age < 0\n                  OR age >= 120 THEN 'Âge inconnu'\n                WHEN age < 20  THEN 'Moins de 20'\n                WHEN age >= 80 THEN '80 et plus'\n                ELSE TO_CHAR(FLOOR(age / 5) * 5)\n              END AS tranche\n       FROM   allocataires_2024)\nGROUP  BY tranche\nORDER  BY tranche\n-- 20 = 20-24 ans, 25 = 25-29 ans, …",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "SELECT tranche, COUNT(*)\nFROM  (SELECT CASE\n                WHEN age IS NULL OR age < 0\n                  OR age >= 120 THEN 'Âge inconnu'\n                WHEN age < 20  THEN 'Moins de 20'\n                WHEN age >= 80 THEN '80 et plus'\n                ELSE TO_CHAR(FLOOR(age / 5) * 5)\n              END AS tranche\n       FROM   allocataires_2024)\nGROUP  BY tranche\nORDER  BY tranche\n-- 20 = 20-24 ans, 25 = 25-29 ans, …",
      "autoResize": true,
      "lineHeight": 1.25
    },
