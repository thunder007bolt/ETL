    },
    {
      "id": "AZ0juJLm8MfM7Zil2jv8",
      "type": "text",
      "x": 25,
      "y": 2866.0,
      "width": 2478.78,
      "height": 67.5,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 490473470,
      "version": 1,
      "versionNonce": 1656009649,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793576377196,
      "link": null,
      "locked": false,
      "text": "À droite de chaque règle, une requête courte sur les vraies tables de l'application (schéma USER_DWH), pour l'année 2024, à copier dans SQL Developer. La règle 2 construit la liste des enfants comptés (enfants_2024), la règle 3 celle des allocataires\n(allocataires_2024) ; pour les règles 4 à 8, on colle leur requête sous ce WITH, à la place de sa dernière requête. Le commentaire en fin de requête donne le chiffre à retrouver. La requête complète, sur les copies de l'entrepôt, est dans\nanalyses/prestations/t32_t41_requete_proposee.sql.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "À droite de chaque règle, une requête courte sur les vraies tables de l'application (schéma USER_DWH), pour l'année 2024, à copier dans SQL Developer. La règle 2 construit la liste des enfants comptés (enfants_2024), la règle 3 celle des allocataires\n(allocataires_2024) ; pour les règles 4 à 8, on colle leur requête sous ce WITH, à la place de sa dernière requête. Le commentaire en fin de requête donne le chiffre à retrouver. La requête complète, sur les copies de l'entrepôt, est dans\nanalyses/prestations/t32_t41_requete_proposee.sql.",
      "autoResize": true,
      "lineHeight": 1.25
    },
