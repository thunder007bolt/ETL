      "isDeleted": false,
      "boundElements": [],
      "updated": 1793576377196,
      "link": null,
      "locked": false,
      "text": "-- les allocations familiales (TPE_CODE)\nSELECT TPE_CODE, COUNT(*)\nFROM   USER_DWH.PRESTATION_ESP\nWHERE  TPE_CODE = 'FAF'\nGROUP  BY TPE_CODE\n-- les prénatales (FAP, MAP) vont dans T55,\n-- la maternité (MIJ) dans T54",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-- les allocations familiales (TPE_CODE)\nSELECT TPE_CODE, COUNT(*)\nFROM   USER_DWH.PRESTATION_ESP\nWHERE  TPE_CODE = 'FAF'\nGROUP  BY TPE_CODE\n-- les prénatales (FAP, MAP) vont dans T55,\n-- la maternité (MIJ) dans T54",
      "autoResize": true,
      "lineHeight": 1.25
    },
