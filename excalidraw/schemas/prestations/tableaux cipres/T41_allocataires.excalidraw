    {
      "id": "v4X1lmfagzryz9Tchrcu",
      "type": "text",
      "x": 798.0,
      "y": 4682.5,
      "width": 426.88,
      "height": 220.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "3Ob1OKOjNtrYkiIfZLam"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1441266019,
      "version": 1,
      "versionNonce": 1180048051,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793576377196,
      "link": null,
      "locked": false,
      "text": "-- payé en 2024, au mois payé, pour les\n-- enfants comptés\nSELECT SUM(deb.DEB_MONTANT)\nFROM   USER_DWH.DEBOURS deb\nWHERE  deb.PE_ID IN\n       (SELECT PE_ID FROM enfants_2024)\nAND    deb.DEB_TYPE = 'PM'\nAND    deb.DEB_STATUT IN ('D', 'P')\nAND    deb.DEB_DATE_EFFET >= DATE '2024-01-01'\nAND    deb.DEB_DATE_EFFET <  DATE '2025-01-01'\n-- 2024 : 7,69 Md",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-- payé en 2024, au mois payé, pour les\n-- enfants comptés\nSELECT SUM(deb.DEB_MONTANT)\nFROM   USER_DWH.DEBOURS deb\nWHERE  deb.PE_ID IN\n       (SELECT PE_ID FROM enfants_2024)\nAND    deb.DEB_TYPE = 'PM'\nAND    deb.DEB_STATUT IN ('D', 'P')\nAND    deb.DEB_DATE_EFFET >= DATE '2024-01-01'\nAND    deb.DEB_DATE_EFFET <  DATE '2025-01-01'\n-- 2024 : 7,69 Md",
      "autoResize": true,
      "lineHeight": 1.25
    },
