      "link": null,
      "locked": false,
      "text": "-- l'âge du titulaire : 2024 moins son\n-- année de naissance\nSELECT age, COUNT(*)\nFROM   allocataires_2024\nGROUP  BY age\nORDER  BY age\n-- 120 ans ou plus, ou vide : âge inconnu",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-- l'âge du titulaire : 2024 moins son\n-- année de naissance\nSELECT age, COUNT(*)\nFROM   allocataires_2024\nGROUP  BY age\nORDER  BY age\n-- 120 ans ou plus, ou vide : âge inconnu",
      "autoResize": true,
      "lineHeight": 1.25
    },
