    {
      "id": "1F98QzHc1FBhm9PuBRxA",
      "type": "text",
      "x": 798.0,
      "y": 3861.5,
      "width": 399.03999999999996,
      "height": 400.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "W5lbvmiZWHW6wMe8pSRf"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1107044604,
      "version": 1,
      "versionNonce": 27516298,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793576377196,
      "link": null,
      "locked": false,
      "text": "-- un allocataire par dossier : son\n-- titulaire (DOSSIER.IND_ID) ; à ajouter\n-- à la suite du WITH de la règle 2\nallocataires_2024 AS (\n  SELECT e.DOS_CODE, t.IND_SEXE,\n         2024 - EXTRACT(YEAR FROM\n           t.IND_DATE_NAISSANCE) AS age,\n         COUNT(*)                AS enfants\n  FROM   enfants_2024 e\n  JOIN   USER_DWH.DOSSIER d\n         ON d.DOS_CODE = e.DOS_CODE\n  JOIN   USER_DWH.INDIVIDU t\n         ON t.IND_ID = d.IND_ID\n  GROUP  BY e.DOS_CODE, t.IND_SEXE,\n            t.IND_DATE_NAISSANCE)\nSELECT COUNT(*) AS allocataires,\n       SUM(enfants)\nFROM   allocataires_2024\n-- 2024 : 98 048 allocataires, 2,8 enfants\n-- chacun (l'annuaire : 97 378)",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-- un allocataire par dossier : son\n-- titulaire (DOSSIER.IND_ID) ; à ajouter\n-- à la suite du WITH de la règle 2\nallocataires_2024 AS (\n  SELECT e.DOS_CODE, t.IND_SEXE,\n         2024 - EXTRACT(YEAR FROM\n           t.IND_DATE_NAISSANCE) AS age,\n         COUNT(*)                AS enfants\n  FROM   enfants_2024 e\n  JOIN   USER_DWH.DOSSIER d\n         ON d.DOS_CODE = e.DOS_CODE\n  JOIN   USER_DWH.INDIVIDU t\n         ON t.IND_ID = d.IND_ID\n  GROUP  BY e.DOS_CODE, t.IND_SEXE,\n            t.IND_DATE_NAISSANCE)\nSELECT COUNT(*) AS allocataires,\n       SUM(enfants)\nFROM   allocataires_2024\n-- 2024 : 98 048 allocataires, 2,8 enfants\n-- chacun (l'annuaire : 97 378)",
      "autoResize": true,
      "lineHeight": 1.25
    },
