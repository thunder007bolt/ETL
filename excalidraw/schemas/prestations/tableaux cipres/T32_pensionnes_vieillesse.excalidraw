      "boundElements": [],
      "updated": 1793525833151,
      "link": null,
      "locked": false,
      "text": "Fin 2025, 2 901 pensions de vieillesse de coordination sont payées par une autre\ncaisse : la CNSS ne leur verse rien. Elles comptent dans l'effectif ; faut-il aussi\nles compter dans la pension moyenne ?",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Fin 2025, 2 901 pensions de vieillesse de coordination sont payées par une autre\ncaisse : la CNSS ne leur verse rien. Elles comptent dans l'effectif ; faut-il aussi\nles compter dans la pension moyenne ?",
      "autoResize": true,
      "lineHeight": 1.25
    },
