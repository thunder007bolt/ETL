      "text": "SUM(CASE WHEN sexe = '1'\n         THEN 1 ELSE 0 END) AS eff_h,\nSUM(CASE WHEN sexe = '2'\n         THEN 1 ELSE 0 END) AS eff_f",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "SUM(CASE WHEN sexe = '1'\n         THEN 1 ELSE 0 END) AS eff_h,\nSUM(CASE WHEN sexe = '2'\n         THEN 1 ELSE 0 END) AS eff_f",
