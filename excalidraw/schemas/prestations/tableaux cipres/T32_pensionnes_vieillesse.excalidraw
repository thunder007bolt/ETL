      "link": null,
      "locked": false,
      "text": "-- une personne par tableau, avec le\n-- montant de toutes ses pensions du tableau\nSELECT tableau,\n       IND_ID_PREST     AS personne,\n       SUM(montant)     AS montant\nFROM   en_cours\nGROUP BY tableau, IND_ID_PREST",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-- une personne par tableau, avec le\n-- montant de toutes ses pensions du tableau\nSELECT tableau,\n       IND_ID_PREST     AS personne,\n       SUM(montant)     AS montant\nFROM   en_cours\nGROUP BY tableau, IND_ID_PREST",
      "autoResize": true,
      "lineHeight": 1.25
    },
