      "boundElements": [],
      "updated": 1793525833151,
      "link": null,
      "locked": false,
      "text": "les pensions suspendues, rares (253 en T32 en 2024), ne comptent pas\n(lot 6, P81). T41 fait exception : un enfant ne compte que s'il a été payé\ndans l'année (lot 6, P79)",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "les pensions suspendues, rares (253 en T32 en 2024), ne comptent pas\n(lot 6, P81). T41 fait exception : un enfant ne compte que s'il a été payé\ndans l'année (lot 6, P79)",
      "autoResize": true,
      "lineHeight": 1.25
    },
