    {
      "id": "bETHR16J1GYyMcq6iUmq",
      "type": "text",
      "x": 2120.84,
      "y": 3195.0,
      "width": 380.47999999999996,
      "height": 240.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "FPoi9alIT45ikq5KyAsp"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 67150048,
      "version": 1,
      "versionNonce": 1734961834,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793525833151,
      "link": null,
      "locked": false,
      "text": "-- fin = le 31/12 de l'exercice\nWHERE pe.PE_DATE_EFFET <= fin\n  AND (pe.PE_DATE_RADIATION IS NULL\n       OR pe.PE_DATE_RADIATION > fin)\n  AND (   pe.PE_DATE_SUSPENSION IS NULL\n       OR pe.PE_DATE_SUSPENSION > fin\n       OR pe.PE_DATE_REACTIVATION\n            BETWEEN pe.PE_DATE_SUSPENSION\n                AND fin)\n  -- titulaire en vie au 31/12\n  AND (i.IND_DATE_DECES IS NULL\n       OR i.IND_DATE_DECES > fin)",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-- fin = le 31/12 de l'exercice\nWHERE pe.PE_DATE_EFFET <= fin\n  AND (pe.PE_DATE_RADIATION IS NULL\n       OR pe.PE_DATE_RADIATION > fin)\n  AND (   pe.PE_DATE_SUSPENSION IS NULL\n       OR pe.PE_DATE_SUSPENSION > fin\n       OR pe.PE_DATE_REACTIVATION\n            BETWEEN pe.PE_DATE_SUSPENSION\n                AND fin)\n  -- titulaire en vie au 31/12\n  AND (i.IND_DATE_DECES IS NULL\n       OR i.IND_DATE_DECES > fin)",
      "autoResize": true,
      "lineHeight": 1.25
    },
