      "updated": 1793525833151,
      "link": null,
      "locked": false,
      "text": "-- T32 : bas = 55, haut = 100\nCASE WHEN age IS NULL OR age < 0\n       OR age >= 120  THEN 'Âge inconnu'\n     WHEN age < bas   THEN 'Moins de 55 ans'\n     WHEN age >= haut THEN '100 ans et plus'\n     ELSE FLOOR(age / 5) * 5 || ' – '\n          || (FLOOR(age / 5) * 5 + 4) || ' ans'\nEND AS libelle",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-- T32 : bas = 55, haut = 100\nCASE WHEN age IS NULL OR age < 0\n       OR age >= 120  THEN 'Âge inconnu'\n     WHEN age < bas   THEN 'Moins de 55 ans'\n     WHEN age >= haut THEN '100 ans et plus'\n     ELSE FLOOR(age / 5) * 5 || ' – '\n          || (FLOOR(age / 5) * 5 + 4) || ' ans'\nEND AS libelle",
      "autoResize": true,
      "lineHeight": 1.25
    },
