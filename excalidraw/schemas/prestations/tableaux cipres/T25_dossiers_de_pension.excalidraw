      "boundElements": [],
      "updated": 1793360881188,
      "link": null,
      "locked": false,
      "text": "telle quelle, la règle donne 23 218 demandes en instance fin\n2025, cinq fois les dépôts d'une année : surtout des réceptions\nd'avant 2016 sans lien vers leur dossier, et des pensions radiées\nsans date de notification",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "telle quelle, la règle donne 23 218 demandes en instance fin\n2025, cinq fois les dépôts d'une année : surtout des réceptions\nd'avant 2016 sans lien vers leur dossier, et des pensions radiées\nsans date de notification",
      "autoResize": true,
      "lineHeight": 1.25
    },
