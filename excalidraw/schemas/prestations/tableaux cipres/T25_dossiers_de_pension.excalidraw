    {
      "id": "26ECjuhrtrtxFhuxsoWg",
      "type": "text",
      "x": 751.6,
      "y": 3428.0,
      "width": 454.71999999999997,
      "height": 160.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
