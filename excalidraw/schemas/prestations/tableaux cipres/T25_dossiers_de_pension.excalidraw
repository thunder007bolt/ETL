    {
      "id": "bAn4X5oBd6FdEBhZ0oT5",
      "type": "text",
      "x": 751.6,
      "y": 4475.0,
      "width": 510.4,
      "height": 160.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "0encteaBh4p9BKDw4rjS"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 921077489,
      "version": 1,
      "versionNonce": 129439140,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793360881188,
      "link": null,
      "locked": false,
      "text": "-- compté l'année du rejet ; ligne de la demande\n-- principale du dossier, sinon rang 8\nSELECT EXTRACT(YEAR FROM dr.DOSRE_DATE_REJET) AS annee,\n       NVL(dm.rang, 8)                         AS rang\nFROM      DWH.FAIT_DOSSIER_REJETE dr\nLEFT JOIN demande dm ON dm.DOS_CODE = dr.DOS_CODE\n                    AND dm.principale = 1\nWHERE dr.TDOS_CODE = 'V'",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-- compté l'année du rejet ; ligne de la demande\n-- principale du dossier, sinon rang 8\nSELECT EXTRACT(YEAR FROM dr.DOSRE_DATE_REJET) AS annee,\n       NVL(dm.rang, 8)                         AS rang\nFROM      DWH.FAIT_DOSSIER_REJETE dr\nLEFT JOIN demande dm ON dm.DOS_CODE = dr.DOS_CODE\n                    AND dm.principale = 1\nWHERE dr.TDOS_CODE = 'V'",
      "autoResize": true,
      "lineHeight": 1.25
    },
