      "isDeleted": false,
      "boundElements": [],
      "updated": 1793360881188,
      "link": null,
      "locked": false,
      "text": "Une demande en attente depuis des années\nreste-t-elle « en instance » ? Faut-il une date\nde départ, une limite d'ancienneté ou une\nclôture ?",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Une demande en attente depuis des années\nreste-t-elle « en instance » ? Faut-il une date\nde départ, une limite d'ancienneté ou une\nclôture ?",
