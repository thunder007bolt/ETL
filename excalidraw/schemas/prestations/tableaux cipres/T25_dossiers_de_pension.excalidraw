    {
      "id": "g63lUtDnh5JzxJXj4vy1",
      "type": "text",
      "x": 751.6,
      "y": 2878.0,
      "width": 436.15999999999997,
      "height": 180.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "PF62D9SXBRuAoOGMRMxS"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 284075120,
      "version": 1,
      "versionNonce": 452661432,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793360881188,
      "link": null,
      "locked": false,
      "text": "-- pensions (V), sans les dossiers transférés à\n-- une autre caisse ; la coordination payée par\n-- une autre caisse (COOR_AC) est gardée\nFROM  DWH.FAIT_PRESTATION_ESP pe\nJOIN  DWH.FAIT_DOSSIER d\n      ON d.DOS_CODE = pe.DOS_CODE\nWHERE d.TDOS_CODE = 'V'\n  AND NVL(d.DOS_CATEGORIE, 'ORDINAIRE')\n      <> 'CNSS_AC'",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-- pensions (V), sans les dossiers transférés à\n-- une autre caisse ; la coordination payée par\n-- une autre caisse (COOR_AC) est gardée\nFROM  DWH.FAIT_PRESTATION_ESP pe\nJOIN  DWH.FAIT_DOSSIER d\n      ON d.DOS_CODE = pe.DOS_CODE\nWHERE d.TDOS_CODE = 'V'\n  AND NVL(d.DOS_CATEGORIE, 'ORDINAIRE')\n      <> 'CNSS_AC'",
      "autoResize": true,
      "lineHeight": 1.25
    },
