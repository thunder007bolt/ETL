    },
    {
      "id": "p9tYasuWuNQmf3pWL47r",
      "type": "text",
      "x": 2046.6,
      "y": 2878.0,
      "width": 482.55999999999995,
      "height": 220.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "qJEnppzimG8sTZH8Y4Yr"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 284494439,
      "version": 1,
      "versionNonce": 914270149,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793360881188,
      "link": null,
      "locked": false,
      "text": "-- une réception = un dépôt, rattaché à sa demande :\n-- celle du dossier qu'elle ouvre (type NOUVEAU),\n-- sinon la réversion du dossier visé (type ANCIEN)\nFROM      DWH.FAIT_RECEPTION_DOSSIER r\nLEFT JOIN DWH.FAIT_DOSSIER o\n       ON o.RD_ID = r.RD_ID\nLEFT JOIN demande dm\n       ON dm.DOS_CODE = NVL(o.DOS_CODE, r.DOS_CODE)\n      AND dm.principale =\n          CASE WHEN o.DOS_CODE IS NOT NULL\n               THEN 1 ELSE 0 END",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-- une réception = un dépôt, rattaché à sa demande :\n-- celle du dossier qu'elle ouvre (type NOUVEAU),\n-- sinon la réversion du dossier visé (type ANCIEN)\nFROM      DWH.FAIT_RECEPTION_DOSSIER r\nLEFT JOIN DWH.FAIT_DOSSIER o\n       ON o.RD_ID = r.RD_ID\nLEFT JOIN demande dm\n       ON dm.DOS_CODE = NVL(o.DOS_CODE, r.DOS_CODE)\n      AND dm.principale =\n          CASE WHEN o.DOS_CODE IS NOT NULL\n               THEN 1 ELSE 0 END",
      "autoResize": true,
      "lineHeight": 1.25
    },
