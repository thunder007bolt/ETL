      "link": null,
      "locked": false,
      "text": "Quand un pensionné décède, la pension de sa\nveuve est-elle ouverte dans un nouveau dossier,\nou ajoutée au dossier du défunt ? Même question\npour les orphelins.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Quand un pensionné décède, la pension de sa\nveuve est-elle ouverte dans un nouveau dossier,\nou ajoutée au dossier du défunt ? Même question\npour les orphelins.",
      "autoResize": true,
      "lineHeight": 1.25
    },
