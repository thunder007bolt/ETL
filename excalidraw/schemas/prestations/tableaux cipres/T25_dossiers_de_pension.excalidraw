    {
      "id": "ho0sISYDwJCAYImVZRAw",
      "type": "text",
      "x": 751.6,
      "y": 3951.5,
      "width": 408.32,
      "height": 120.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "QFY1eO5Px9wD5UdBwpSj"
      ],
