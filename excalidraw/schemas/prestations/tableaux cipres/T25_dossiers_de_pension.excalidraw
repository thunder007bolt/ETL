      "updated": 1793360881188,
      "link": null,
      "locked": false,
      "text": "-- en instance au 31/12/N\n-- / (en instance au 31/12/N-1 + déposés en N)\nROUND(NVL(it.nb, 0)\n      / NULLIF(NVL(i0.nb, 0) + NVL(dp.nb, 0), 0), 4)\n                            AS TAUX_RESTANT_A_TRAITER\n-- it : en instance de N ; i0 : de N-1 ; dp : déposés",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-- en instance au 31/12/N\n-- / (en instance au 31/12/N-1 + déposés en N)\nROUND(NVL(it.nb, 0)\n      / NULLIF(NVL(i0.nb, 0) + NVL(dp.nb, 0), 0), 4)\n                            AS TAUX_RESTANT_A_TRAITER\n-- it : en instance de N ; i0 : de N-1 ; dp : déposés",
      "autoResize": true,
      "lineHeight": 1.25
    },
