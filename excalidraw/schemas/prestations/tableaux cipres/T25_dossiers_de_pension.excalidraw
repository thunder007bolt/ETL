      "seed": 1768636436,
      "version": 1,
      "versionNonce": 1301841748,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793360881188,
      "link": null,
      "locked": false,
      "text": "SUM(CASE WHEN duree <= 14\n         THEN 1 ELSE 0 END)  AS nb_moins_15,\nSUM(CASE WHEN duree BETWEEN 15 AND 45\n         THEN 1 ELSE 0 END)  AS nb_15_45,\nSUM(CASE WHEN duree > 45\n         THEN 1 ELSE 0 END)  AS nb_plus_45",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "SUM(CASE WHEN duree <= 14\n         THEN 1 ELSE 0 END)  AS nb_moins_15,\nSUM(CASE WHEN duree BETWEEN 15 AND 45\n         THEN 1 ELSE 0 END)  AS nb_15_45,\nSUM(CASE WHEN duree > 45\n         THEN 1 ELSE 0 END)  AS nb_plus_45",
      "autoResize": true,
      "lineHeight": 1.25
    },
