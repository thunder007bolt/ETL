    },
    {
      "id": "nHX57EbheWrwd20k8GQR",
      "type": "text",
      "x": 45,
      "y": 6249.0,
      "width": 955.0400000000001,
      "height": 80.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "E3r7V8pEaMSl9uQFPq7e"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 338968289,
      "version": 1,
      "versionNonce": 493246444,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793360881188,
      "link": null,
      "locked": false,
      "text": "Une demande reçue au guichet ouvre un seul dossier : oui, sauf 11 cas.\nUne seconde notification arrive en médiane 9 ans après la première : ce sont des réversions, pas des révisions.\nLes réversions sont enregistrées au guichet comme demandes sur un dossier existant : 616 en 2025.\nLe stock en instance, tel quel, est faussé par de vieilles réceptions sans dossier : voir Q3.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Une demande reçue au guichet ouvre un seul dossier : oui, sauf 11 cas.\nUne seconde notification arrive en médiane 9 ans après la première : ce sont des réversions, pas des révisions.\nLes réversions sont enregistrées au guichet comme demandes sur un dossier existant : 616 en 2025.\nLe stock en instance, tel quel, est faussé par de vieilles réceptions sans dossier : voir Q3.",
      "autoResize": true,
      "lineHeight": 1.25
    }
  ],
