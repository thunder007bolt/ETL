      "isDeleted": false,
      "boundElements": [],
      "updated": 1793360881188,
      "link": null,
      "locked": false,
      "text": "-- jours entre le dépôt (sinon la date de demande\n-- de la pension) et la liquidation ; négatif = 0\nGREATEST(dm.date_liquidation\n         - NVL(dp.date_depot, dm.date_demande),\n         0) AS duree",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-- jours entre le dépôt (sinon la date de demande\n-- de la pension) et la liquidation ; négatif = 0\nGREATEST(dm.date_liquidation\n         - NVL(dp.date_depot, dm.date_demande),\n         0) AS duree",
      "autoResize": true,
      "lineHeight": 1.25
    },
