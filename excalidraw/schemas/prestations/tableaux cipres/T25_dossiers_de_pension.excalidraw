    {
      "id": "Zlnp570mxAzCQJgQPqVV",
      "type": "text",
      "x": 2046.6,
      "y": 3951.5,
      "width": 454.71999999999997,
      "height": 280.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "34DcFWlHTPhgdiC52USo"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1344001190,
      "version": 1,
      "versionNonce": 1187453305,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793360881188,
      "link": null,
      "locked": false,
      "text": "-- fin_N = TO_DATE(N || '1231', 'YYYYMMDD')\nWHERE dp.date_depot <= fin_N\n  AND (dp.date_liquidation IS NULL\n       OR dp.date_liquidation > fin_N)\n  -- pas un dossier fermé jamais notifié\n  AND NOT (dp.ouvre_dossier = 1\n           AND dp.DOS_STATUT = 'F'\n           AND dp.date_liquidation IS NULL)\n  -- pas une vieille réception sans dossier\n  AND NOT (dp.DOS_CODE IS NULL\n           AND dp.date_depot < DATE '2016-01-01')\n  AND NOT EXISTS (SELECT 1 FROM rej x\n        WHERE x.RD_ID = dp.RD_ID\n          AND x.date_rejet <= fin_N)",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-- fin_N = TO_DATE(N || '1231', 'YYYYMMDD')\nWHERE dp.date_depot <= fin_N\n  AND (dp.date_liquidation IS NULL\n       OR dp.date_liquidation > fin_N)\n  -- pas un dossier fermé jamais notifié\n  AND NOT (dp.ouvre_dossier = 1\n           AND dp.DOS_STATUT = 'F'\n           AND dp.date_liquidation IS NULL)\n  -- pas une vieille réception sans dossier\n  AND NOT (dp.DOS_CODE IS NULL\n           AND dp.date_depot < DATE '2016-01-01')\n  AND NOT EXISTS (SELECT 1 FROM rej x\n        WHERE x.RD_ID = dp.RD_ID\n          AND x.date_rejet <= fin_N)",
      "autoResize": true,
      "lineHeight": 1.25
    },
