      "seed": 263322068,
      "version": 1,
      "versionNonce": 1313496229,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793360881188,
      "link": null,
      "locked": false,
      "text": "-- une demande = un dossier × une ligne, liquidée\n-- à la 1re notification de CETTE ligne (un\n-- complément suit la pension du dossier)\nSELECT DOS_CODE, rang,\n       TRUNC(MIN(PE_DATE_NOTIFICATION))\n                          AS date_liquidation\nFROM   prest\nGROUP BY DOS_CODE, rang",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-- une demande = un dossier × une ligne, liquidée\n-- à la 1re notification de CETTE ligne (un\n-- complément suit la pension du dossier)\nSELECT DOS_CODE, rang,\n       TRUNC(MIN(PE_DATE_NOTIFICATION))\n                          AS date_liquidation\nFROM   prest\nGROUP BY DOS_CODE, rang",
      "autoResize": true,
      "lineHeight": 1.25
    },
