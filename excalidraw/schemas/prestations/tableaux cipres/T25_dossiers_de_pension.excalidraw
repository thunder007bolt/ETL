      "boundElements": [],
      "updated": 1793360881188,
      "link": null,
      "locked": false,
      "text": "Les demandes reçues, ni notifiées ni rejetées au 31 décembre,\nquelle que soit l'année du dépôt. Sans les dossiers fermés jamais\nnotifiés, ni les vieilles réceptions jamais reliées à un dossier.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Les demandes reçues, ni notifiées ni rejetées au 31 décembre,\nquelle que soit l'année du dépôt. Sans les dossiers fermés jamais\nnotifiés, ni les vieilles réceptions jamais reliées à un dossier.",
      "autoResize": true,
      "lineHeight": 1.25
    },
