    {
      "id": "azEYDiNLVGU1ULpDTYC1",
      "type": "text",
      "x": 751.6,
      "y": 4918.0,
      "width": 436.15999999999997,
      "height": 160.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "7IdqZ03XO8MD5CMSmFAe"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1068005841,
      "version": 1,
      "versionNonce": 672884025,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793360881188,
      "link": null,
      "locked": false,
      "text": "-- rang 9 : le Total, recalculé sur toutes les\n-- demandes de l'année, rang 8 compris : jamais\n-- une moyenne des moyennes des lignes\nSELECT annee, 9 AS rang,\n       COUNT(*)             AS nb_liquides,\n       ROUND(AVG(duree), 1) AS duree_moy\nFROM   liq\nGROUP BY annee",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-- rang 9 : le Total, recalculé sur toutes les\n-- demandes de l'année, rang 8 compris : jamais\n-- une moyenne des moyennes des lignes\nSELECT annee, 9 AS rang,\n       COUNT(*)             AS nb_liquides,\n       ROUND(AVG(duree), 1) AS duree_moy\nFROM   liq\nGROUP BY annee",
      "autoResize": true,
      "lineHeight": 1.25
    },
