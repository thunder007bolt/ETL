    },
    {
      "id": "dw5t11RBNGHg18Ds1XWx",
      "type": "text",
      "x": 770.1600000000001,
      "y": 4382.5,
      "width": 426.88,
      "height": 180.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "UL6cD50RewyVTwcgZYMG"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 768283863,
      "version": 1,
      "versionNonce": 1110409004,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793386789699,
      "link": null,
      "locked": false,
      "text": "-- compté l'année du rejet ; ligne de la\n-- 1re demande liquidée, sinon rang 6\nSELECT EXTRACT(YEAR FROM dr.DOSRE_DATE_REJET),\n       NVL(dm.rang, 6) AS rang\nFROM      DWH.FAIT_DOSSIER_REJETE dr\nLEFT JOIN demande_rg dm\n       ON dm.DOS_CODE = dr.DOS_CODE\n      AND dm.ordre = 1\nWHERE dr.TDOS_CODE = 'A'",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-- compté l'année du rejet ; ligne de la\n-- 1re demande liquidée, sinon rang 6\nSELECT EXTRACT(YEAR FROM dr.DOSRE_DATE_REJET),\n       NVL(dm.rang, 6) AS rang\nFROM      DWH.FAIT_DOSSIER_REJETE dr\nLEFT JOIN demande_rg dm\n       ON dm.DOS_CODE = dr.DOS_CODE\n      AND dm.ordre = 1\nWHERE dr.TDOS_CODE = 'A'",
      "autoResize": true,
      "lineHeight": 1.25
    },
