      "isDeleted": false,
      "boundElements": [],
      "updated": 1793386789699,
      "link": null,
      "locked": false,
      "text": "-- tous les dossiers AT/MP (type A) ; la\n-- déclaration est la réception qui a\n-- ouvert le dossier\nFROM      DWH.FAIT_DOSSIER d\nLEFT JOIN DWH.FAIT_RECEPTION_DOSSIER r\n       ON r.RD_ID = d.RD_ID\nWHERE d.TDOS_CODE = 'A'",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-- tous les dossiers AT/MP (type A) ; la\n-- déclaration est la réception qui a\n-- ouvert le dossier\nFROM      DWH.FAIT_DOSSIER d\nLEFT JOIN DWH.FAIT_RECEPTION_DOSSIER r\n       ON r.RD_ID = d.RD_ID\nWHERE d.TDOS_CODE = 'A'",
      "autoResize": true,
      "lineHeight": 1.25
    },
