      "isDeleted": false,
      "boundElements": [],
      "updated": 1793386789699,
      "link": null,
      "locked": false,
      "text": "-- rang 7 : le Total, recalculé sur toutes\n-- les demandes de l'année, rang 6 compris\nSELECT annee, 7 AS rang,\n       COUNT(*)             AS nb_liquides,\n       ROUND(AVG(duree), 1) AS duree_moy\nFROM   liq\nGROUP BY annee",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-- rang 7 : le Total, recalculé sur toutes\n-- les demandes de l'année, rang 6 compris\nSELECT annee, 7 AS rang,\n       COUNT(*)             AS nb_liquides,\n       ROUND(AVG(duree), 1) AS duree_moy\nFROM   liq\nGROUP BY annee",
      "autoResize": true,
      "lineHeight": 1.25
    },
