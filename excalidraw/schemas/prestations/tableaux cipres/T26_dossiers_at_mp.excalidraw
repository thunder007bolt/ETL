    },
    {
      "id": "FyYvgzdoZMCeIR5wuBIw",
      "type": "text",
      "x": 770.1600000000001,
      "y": 3877.0,
      "width": 408.32,
      "height": 120.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "nDszAihoUusFGodz72aE"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 729282730,
      "version": 1,
      "versionNonce": 759202913,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793386789699,
      "link": null,
      "locked": false,
      "text": "SUM(CASE WHEN duree <= 14\n         THEN 1 ELSE 0 END)  AS nb_moins_15,\nSUM(CASE WHEN duree BETWEEN 15 AND 45\n         THEN 1 ELSE 0 END)  AS nb_15_45,\nSUM(CASE WHEN duree > 45\n         THEN 1 ELSE 0 END)  AS nb_plus_45",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "SUM(CASE WHEN duree <= 14\n         THEN 1 ELSE 0 END)  AS nb_moins_15,\nSUM(CASE WHEN duree BETWEEN 15 AND 45\n         THEN 1 ELSE 0 END)  AS nb_15_45,\nSUM(CASE WHEN duree > 45\n         THEN 1 ELSE 0 END)  AS nb_plus_45",
      "autoResize": true,
      "lineHeight": 1.25
    },
