    {
      "id": "sjtHabvjDcMkJa6a5rOZ",
      "type": "text",
      "x": 25,
      "y": 2636.0,
      "width": 2520.54,
      "height": 45.0,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
