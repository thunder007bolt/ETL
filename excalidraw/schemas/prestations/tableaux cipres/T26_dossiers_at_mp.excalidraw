    {
      "id": "u5khlRzGjOqNaujA2uAe",
      "type": "text",
      "x": 2065.16,
      "y": 2745.0,
      "width": 380.47999999999996,
      "height": 220.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "dOhISyAMnZkhHEHE5gJf"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 262489587,
      "version": 1,
      "versionNonce": 1268383253,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793386789699,
      "link": null,
      "locked": false,
      "text": "-- IJ (3) et soins (5) : la déclaration ;\n-- rente, survivants, allocation : leur\n-- demande au guichet (ancien), sinon le\n-- certificat pour la rente, sinon la\n-- déclaration\nCASE WHEN dm.rang IN (3, 5)\n     THEN d.date_declaration\n     ELSE COALESCE(a.date_reception,\n                   d.date_cm_rente,\n                   d.date_declaration)\nEND AS date_depot",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-- IJ (3) et soins (5) : la déclaration ;\n-- rente, survivants, allocation : leur\n-- demande au guichet (ancien), sinon le\n-- certificat pour la rente, sinon la\n-- déclaration\nCASE WHEN dm.rang IN (3, 5)\n     THEN d.date_declaration\n     ELSE COALESCE(a.date_reception,\n                   d.date_cm_rente,\n                   d.date_declaration)\nEND AS date_depot",
      "autoResize": true,
      "lineHeight": 1.25
    },
