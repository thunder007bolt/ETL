    },
    {
      "id": "AAWesp0hRq86m7SAWxnV",
      "type": "text",
      "x": 2065.16,
      "y": 3877.0,
      "width": 417.59999999999997,
      "height": 240.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "SViOdQXQVPmO6TSA90rB"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1628191732,
      "version": 1,
      "versionNonce": 542774158,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793386789699,
      "link": null,
      "locked": false,
      "text": "-- fin_N = TO_DATE(N || '1231', 'YYYYMMDD')\nWHERE dp.date_depot <= fin_N\n  AND (dp.date_liquidation IS NULL\n       OR dp.date_liquidation > fin_N)\n  -- pas un dossier fermé jamais liquidé\n  AND NOT (NVL(dp.DOS_STATUT, '-') = 'F'\n           AND dp.date_liquidation IS NULL)\n  -- au plus 24 mois sans suite\n  AND dp.date_depot >= ADD_MONTHS(fin_N, -24)\n  AND NOT EXISTS (SELECT 1 FROM rej x\n        WHERE x.DOS_CODE = dp.DOS_CODE\n          AND x.date_rejet <= fin_N)",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-- fin_N = TO_DATE(N || '1231', 'YYYYMMDD')\nWHERE dp.date_depot <= fin_N\n  AND (dp.date_liquidation IS NULL\n       OR dp.date_liquidation > fin_N)\n  -- pas un dossier fermé jamais liquidé\n  AND NOT (NVL(dp.DOS_STATUT, '-') = 'F'\n           AND dp.date_liquidation IS NULL)\n  -- au plus 24 mois sans suite\n  AND dp.date_depot >= ADD_MONTHS(fin_N, -24)\n  AND NOT EXISTS (SELECT 1 FROM rej x\n        WHERE x.DOS_CODE = dp.DOS_CODE\n          AND x.date_rejet <= fin_N)",
      "autoResize": true,
      "lineHeight": 1.25
    },
