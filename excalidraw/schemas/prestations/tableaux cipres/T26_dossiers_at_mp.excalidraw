    {
      "id": "I5m7F0WPAtiAYncXcuvf",
      "type": "text",
      "x": 770.1600000000001,
      "y": 3311.0,
      "width": 389.76,
      "height": 240.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "vF0HQGNdMCrP6r8K0DjG"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 346742268,
      "version": 1,
      "versionNonce": 1080731122,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793386789699,
      "link": null,
      "locked": false,
      "text": "-- 1re notification de chaque ligne\nSELECT pe.DOS_CODE, rang,\n       TRUNC(MIN(pe.PE_DATE_NOTIFICATION))\nFROM   DWH.FAIT_PRESTATION_ESP pe\nGROUP BY pe.DOS_CODE, rang\nUNION ALL\n-- soins : 1re saisie d'un remboursement\nSELECT deb.DOS_CODE, 5,\n       TRUNC(MIN(deb.DEB_DATE_INSERT))\nFROM   DWH.FAIT_DEBOURS deb\nWHERE  deb.TPN_CODE IS NOT NULL\nGROUP BY deb.DOS_CODE",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-- 1re notification de chaque ligne\nSELECT pe.DOS_CODE, rang,\n       TRUNC(MIN(pe.PE_DATE_NOTIFICATION))\nFROM   DWH.FAIT_PRESTATION_ESP pe\nGROUP BY pe.DOS_CODE, rang\nUNION ALL\n-- soins : 1re saisie d'un remboursement\nSELECT deb.DOS_CODE, 5,\n       TRUNC(MIN(deb.DEB_DATE_INSERT))\nFROM   DWH.FAIT_DEBOURS deb\nWHERE  deb.TPN_CODE IS NOT NULL\nGROUP BY deb.DOS_CODE",
      "autoResize": true,
      "lineHeight": 1.25
    },
