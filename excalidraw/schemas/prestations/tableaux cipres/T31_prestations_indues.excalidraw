      "boundElements": [],
      "updated": 1793576377012,
      "link": null,
      "locked": false,
      "text": "-- la branche vient du type de dossier\nSELECT TDOS_CODE, COUNT(*)\nFROM   USER_DWH.DOSSIER\nWHERE  TDOS_CODE IN ('V', 'A', 'F', 'M')\nGROUP  BY TDOS_CODE\n-- V : PVID (pensions) ; A : AT/MP ;\n-- F et M : PF (la maternité comprise)",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-- la branche vient du type de dossier\nSELECT TDOS_CODE, COUNT(*)\nFROM   USER_DWH.DOSSIER\nWHERE  TDOS_CODE IN ('V', 'A', 'F', 'M')\nGROUP  BY TDOS_CODE\n-- V : PVID (pensions) ; A : AT/MP ;\n-- F et M : PF (la maternité comprise)",
      "autoResize": true,
      "lineHeight": 1.25
    },
