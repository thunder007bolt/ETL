    {
      "id": "x9unMCByWWQ33MaetvS5",
      "type": "text",
      "x": 816.5600000000001,
      "y": 4110.0,
      "width": 417.59999999999997,
      "height": 300.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "Dx4M8EMKyXqJVuHHRqKE"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 645656221,
      "version": 1,
      "versionNonce": 988943078,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793576377012,
      "link": null,
      "locked": false,
      "text": "-- un trop-perçu compte le mois où il est\n-- établi, pas celui où il est repris\nSELECT EXTRACT(MONTH FROM\n         AJ_DATE_ETABLISSEMENT) AS mois,\n       SUM(AJ_MONTANT)          AS trop_percu\nFROM   USER_DWH.AJUSTEMENT\nWHERE  TAJ_CODE IN ('TP', 'TP-CONV')\nAND    AJ_STATUT <> 'R'\nAND    AJ_DATE_ETABLISSEMENT\n         >= DATE '2024-01-01'\nAND    AJ_DATE_ETABLISSEMENT\n         <  DATE '2025-01-01'\nGROUP  BY EXTRACT(MONTH FROM\n            AJ_DATE_ETABLISSEMENT)\nORDER  BY 1",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-- un trop-perçu compte le mois où il est\n-- établi, pas celui où il est repris\nSELECT EXTRACT(MONTH FROM\n         AJ_DATE_ETABLISSEMENT) AS mois,\n       SUM(AJ_MONTANT)          AS trop_percu\nFROM   USER_DWH.AJUSTEMENT\nWHERE  TAJ_CODE IN ('TP', 'TP-CONV')\nAND    AJ_STATUT <> 'R'\nAND    AJ_DATE_ETABLISSEMENT\n         >= DATE '2024-01-01'\nAND    AJ_DATE_ETABLISSEMENT\n         <  DATE '2025-01-01'\nGROUP  BY EXTRACT(MONTH FROM\n            AJ_DATE_ETABLISSEMENT)\nORDER  BY 1",
      "autoResize": true,
      "lineHeight": 1.25
    },
