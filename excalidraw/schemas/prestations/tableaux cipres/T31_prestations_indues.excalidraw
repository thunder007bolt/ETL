    },
    {
      "id": "qaOBbrAbp0IWukgRIgyi",
      "type": "text",
      "x": 2111.56,
      "y": 4110.0,
      "width": 445.43999999999994,
      "height": 640.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "LdrHjzxI6ITQlDwPfGAG"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 886317015,
      "version": 1,
      "versionNonce": 1390562208,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793576377012,
      "link": null,
      "locked": false,
      "text": "-- trop-perçus (règle 3) / payées\n-- (règle 2), par branche, en %\nSELECT branche,\n       ROUND(100 * SUM(tp) / SUM(paye), 2)\n         AS taux_indus_pct\nFROM  (SELECT DECODE(d.TDOS_CODE, 'V', 'PVID',\n                'A', 'AT/MP', 'F', 'PF',\n                'M', 'PF') AS branche,\n              aj.AJ_MONTANT AS tp, 0 AS paye\n       FROM   USER_DWH.AJUSTEMENT aj\n       JOIN   USER_DWH.DOSSIER d\n              ON d.DOS_CODE = aj.DOS_CODE\n       WHERE  aj.TAJ_CODE IN ('TP', 'TP-CONV')\n       AND    aj.AJ_STATUT <> 'R'\n       AND    EXTRACT(YEAR FROM\n                aj.AJ_DATE_ETABLISSEMENT) = 2024\n       UNION ALL\n       SELECT DECODE(d.TDOS_CODE, 'V', 'PVID',\n                'A', 'AT/MP', 'F', 'PF',\n                'M', 'PF'),\n              0, deb.DEB_MONTANT\n       FROM   USER_DWH.DEBOURS deb\n       JOIN   USER_DWH.DOSSIER d\n              ON d.DOS_CODE = deb.DOS_CODE\n       WHERE  deb.DEB_TYPE = 'PM'\n       AND    deb.DEB_STATUT IN ('D', 'P')\n       AND    EXTRACT(YEAR FROM\n                deb.DEB_DATE_EFFET) = 2024)\nWHERE  branche IS NOT NULL\nGROUP  BY branche\n-- 2024 : PVID 0,47 %, AT/MP 0,47 %,\n-- PF 0,05 % ; en tout 0,39 %",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-- trop-perçus (règle 3) / payées\n-- (règle 2), par branche, en %\nSELECT branche,\n       ROUND(100 * SUM(tp) / SUM(paye), 2)\n         AS taux_indus_pct\nFROM  (SELECT DECODE(d.TDOS_CODE, 'V', 'PVID',\n                'A', 'AT/MP', 'F', 'PF',\n                'M', 'PF') AS branche,\n              aj.AJ_MONTANT AS tp, 0 AS paye\n       FROM   USER_DWH.AJUSTEMENT aj\n       JOIN   USER_DWH.DOSSIER d\n              ON d.DOS_CODE = aj.DOS_CODE\n       WHERE  aj.TAJ_CODE IN ('TP', 'TP-CONV')\n       AND    aj.AJ_STATUT <> 'R'\n       AND    EXTRACT(YEAR FROM\n                aj.AJ_DATE_ETABLISSEMENT) = 2024\n       UNION ALL\n       SELECT DECODE(d.TDOS_CODE, 'V', 'PVID',\n                'A', 'AT/MP', 'F', 'PF',\n                'M', 'PF'),\n              0, deb.DEB_MONTANT\n       FROM   USER_DWH.DEBOURS deb\n       JOIN   USER_DWH.DOSSIER d\n              ON d.DOS_CODE = deb.DOS_CODE\n       WHERE  deb.DEB_TYPE = 'PM'\n       AND    deb.DEB_STATUT IN ('D', 'P')\n       AND    EXTRACT(YEAR FROM\n                deb.DEB_DATE_EFFET) = 2024)\nWHERE  branche IS NOT NULL\nGROUP  BY branche\n-- 2024 : PVID 0,47 %, AT/MP 0,47 %,\n-- PF 0,05 % ; en tout 0,39 %",
      "autoResize": true,
      "lineHeight": 1.25
    },
