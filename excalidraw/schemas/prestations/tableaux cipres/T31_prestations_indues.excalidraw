    {
      "id": "wHXZIWghiV1OLROPErms",
      "type": "text",
      "x": 2111.56,
      "y": 3719.5,
      "width": 361.91999999999996,
      "height": 140.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
