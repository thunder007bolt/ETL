        "VxSS53zCbPHvfdGQ9Bmy"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 622092106,
      "version": 1,
      "versionNonce": 1467289708,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793576377012,
      "link": null,
      "locked": false,
      "text": "SELECT AJ_STATUT, COUNT(*)\nFROM   USER_DWH.AJUSTEMENT\nWHERE  TAJ_CODE IN ('TP', 'TP-CONV',\n                    'MP', 'RC')\nGROUP  BY AJ_STATUT\n-- C soldé, A en cours : gardés\n-- R annulé : écarté (AJ_STATUT <> 'R')",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "SELECT AJ_STATUT, COUNT(*)\nFROM   USER_DWH.AJUSTEMENT\nWHERE  TAJ_CODE IN ('TP', 'TP-CONV',\n                    'MP', 'RC')\nGROUP  BY AJ_STATUT\n-- C soldé, A en cours : gardés\n-- R annulé : écarté (AJ_STATUT <> 'R')",
      "autoResize": true,
      "lineHeight": 1.25
    },
