      "updated": 1793576377012,
      "link": null,
      "locked": false,
      "text": "C = soldé (rappel payé, trop-perçu repris) ; A = en cours ; R = annulé\n(presque rien payé) ; depuis 2017, les trop-perçus restent en cours,\nrepris par retenues (P103)",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "C = soldé (rappel payé, trop-perçu repris) ; A = en cours ; R = annulé\n(presque rien payé) ; depuis 2017, les trop-perçus restent en cours,\nrepris par retenues (P103)",
      "autoResize": true,
      "lineHeight": 1.25
    },
