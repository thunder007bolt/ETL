    },
    {
      "id": "hF9QgzZVJALAqXUdrkto",
      "type": "text",
      "x": 25,
      "y": 2746.0,
      "width": 2518.7400000000002,
      "height": 45.0,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1502157994,
      "version": 1,
      "versionNonce": 1091493349,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793576377012,
      "link": null,
      "locked": false,
      "text": "À droite de chaque règle, une requête courte sur les vraies tables de l'application (schéma USER_DWH), pour l'année 2024, à copier dans SQL Developer ; chacune se lance seule. Les payées viennent des débours (DEBOURS), les trop-perçus et les moins-perçus\ndes ajustements (AJUSTEMENT), la branche du type de dossier (DOSSIER). Le commentaire en fin de requête donne le chiffre à retrouver. La requête complète, sur les copies de l'entrepôt, est dans analyses/prestations/t31_requete_proposee.sql.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "À droite de chaque règle, une requête courte sur les vraies tables de l'application (schéma USER_DWH), pour l'année 2024, à copier dans SQL Developer ; chacune se lance seule. Les payées viennent des débours (DEBOURS), les trop-perçus et les moins-perçus\ndes ajustements (AJUSTEMENT), la branche du type de dossier (DOSSIER). Le commentaire en fin de requête donne le chiffre à retrouver. La requête complète, sur les copies de l'entrepôt, est dans analyses/prestations/t31_requete_proposee.sql.",
      "autoResize": true,
      "lineHeight": 1.25
    },
