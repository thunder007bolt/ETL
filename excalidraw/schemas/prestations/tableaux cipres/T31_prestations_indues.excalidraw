      "boundElements": [],
      "updated": 1793576377012,
      "link": null,
      "locked": false,
      "text": "Un trop-perçu ou un moins-perçu compte le mois où il est établi, pas le\nmois où il a été payé en trop, ni celui où il est repris.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Un trop-perçu ou un moins-perçu compte le mois où il est établi, pas le\nmois où il a été payé en trop, ni celui où il est repris.",
      "autoResize": true,
      "lineHeight": 1.25
    },
