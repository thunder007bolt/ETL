      "lineHeight": 1.25
    },
    {
      "id": "Kjj52D045W0d5ptoSdlS",
      "type": "text",
      "x": 816.5600000000001,
      "y": 3266.0,
      "width": 371.2,
      "height": 280.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "ZhtIYW3gmB1keJnvlqE5"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1628032520,
      "version": 1,
      "versionNonce": 2113497850,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793576377012,
      "link": null,
      "locked": false,
      "text": "SELECT d.TDOS_CODE, COUNT(*),\n       SUM(aj.AJ_MONTANT) AS trop_percu\nFROM   USER_DWH.AJUSTEMENT aj\nJOIN   USER_DWH.DOSSIER d\n       ON d.DOS_CODE = aj.DOS_CODE\n-- trop-perçu, trop-perçu sur convention\nWHERE  aj.TAJ_CODE IN ('TP', 'TP-CONV')\nAND    aj.AJ_STATUT <> 'R'\nAND    aj.AJ_DATE_ETABLISSEMENT\n         >= DATE '2024-01-01'\nAND    aj.AJ_DATE_ETABLISSEMENT\n         <  DATE '2025-01-01'\nGROUP  BY d.TDOS_CODE\n-- 2024 : 684 trop-perçus, 229,5 M",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "SELECT d.TDOS_CODE, COUNT(*),\n       SUM(aj.AJ_MONTANT) AS trop_percu\nFROM   USER_DWH.AJUSTEMENT aj\nJOIN   USER_DWH.DOSSIER d\n       ON d.DOS_CODE = aj.DOS_CODE\n-- trop-perçu, trop-perçu sur convention\nWHERE  aj.TAJ_CODE IN ('TP', 'TP-CONV')\nAND    aj.AJ_STATUT <> 'R'\nAND    aj.AJ_DATE_ETABLISSEMENT\n         >= DATE '2024-01-01'\nAND    aj.AJ_DATE_ETABLISSEMENT\n         <  DATE '2025-01-01'\nGROUP  BY d.TDOS_CODE\n-- 2024 : 684 trop-perçus, 229,5 M",
      "autoResize": true,
      "lineHeight": 1.25
    },
