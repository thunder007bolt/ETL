    {
      "id": "h8muoySZxPG2be7nPQoi",
      "type": "text",
      "x": 2111.56,
      "y": 3266.0,
      "width": 371.2,
      "height": 300.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "znKPY0NFeML8q11RnWOI"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 2146922501,
      "version": 1,
      "versionNonce": 854726046,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793576377012,
      "link": null,
      "locked": false,
      "text": "SELECT d.TDOS_CODE, COUNT(*),\n       SUM(aj.AJ_MONTANT) AS moins_percu\nFROM   USER_DWH.AJUSTEMENT aj\nJOIN   USER_DWH.DOSSIER d\n       ON d.DOS_CODE = aj.DOS_CODE\n-- moins-perçu ou rappel, rappel sur\n-- convention : montrés, pas des indus\nWHERE  aj.TAJ_CODE IN ('MP', 'RC')\nAND    aj.AJ_STATUT <> 'R'\nAND    aj.AJ_DATE_ETABLISSEMENT\n         >= DATE '2024-01-01'\nAND    aj.AJ_DATE_ETABLISSEMENT\n         <  DATE '2025-01-01'\nGROUP  BY d.TDOS_CODE\n-- 2024 : 414 M",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "SELECT d.TDOS_CODE, COUNT(*),\n       SUM(aj.AJ_MONTANT) AS moins_percu\nFROM   USER_DWH.AJUSTEMENT aj\nJOIN   USER_DWH.DOSSIER d\n       ON d.DOS_CODE = aj.DOS_CODE\n-- moins-perçu ou rappel, rappel sur\n-- convention : montrés, pas des indus\nWHERE  aj.TAJ_CODE IN ('MP', 'RC')\nAND    aj.AJ_STATUT <> 'R'\nAND    aj.AJ_DATE_ETABLISSEMENT\n         >= DATE '2024-01-01'\nAND    aj.AJ_DATE_ETABLISSEMENT\n         <  DATE '2025-01-01'\nGROUP  BY d.TDOS_CODE\n-- 2024 : 414 M",
      "autoResize": true,
      "lineHeight": 1.25
    },
