    {
      "id": "ov29N5XToDVnw7yQjiIH",
      "type": "text",
      "x": 816.5600000000001,
      "y": 3719.5,
      "width": 389.76,
      "height": 260.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "FXo0ODtC7JEu9m828rYc"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1879416772,
      "version": 1,
      "versionNonce": 2132176084,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793576377012,
      "link": null,
      "locked": false,
      "text": "-- tous les types d'ajustement de 2024 ;\n-- seuls TP, TP-CONV, MP et RC entrent\nSELECT TAJ_CODE, COUNT(*), SUM(AJ_MONTANT)\nFROM   USER_DWH.AJUSTEMENT\nWHERE  AJ_DATE_ETABLISSEMENT\n         >= DATE '2024-01-01'\nAND    AJ_DATE_ETABLISSEMENT\n         <  DATE '2025-01-01'\nGROUP  BY TAJ_CODE\n-- hors T31 : REM-TP remboursement d'un\n-- trop-perçu, AV avance, MPG mois de\n-- pension gratuits, …\n-- libellés : USER_DWH.TYPE_AJUSTEMENT",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-- tous les types d'ajustement de 2024 ;\n-- seuls TP, TP-CONV, MP et RC entrent\nSELECT TAJ_CODE, COUNT(*), SUM(AJ_MONTANT)\nFROM   USER_DWH.AJUSTEMENT\nWHERE  AJ_DATE_ETABLISSEMENT\n         >= DATE '2024-01-01'\nAND    AJ_DATE_ETABLISSEMENT\n         <  DATE '2025-01-01'\nGROUP  BY TAJ_CODE\n-- hors T31 : REM-TP remboursement d'un\n-- trop-perçu, AV avance, MPG mois de\n-- pension gratuits, …\n-- libellés : USER_DWH.TYPE_AJUSTEMENT",
      "autoResize": true,
      "lineHeight": 1.25
    },
