      "updated": 1793529298200,
      "link": null,
      "locked": false,
      "text": "-- T42 : pension de vieillesse et\n-- retraite anticipée\nSELECT 'T42' AS tableau, 'RPV' AS code\nFROM DUAL\nUNION ALL SELECT 'T42', 'RPRA' FROM DUAL",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
