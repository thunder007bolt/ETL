    {
      "id": "idHZBE8IcGwz3RXlDhSH",
      "type": "text",
      "x": 2120.84,
      "y": 2935.0,
      "width": 417.59999999999997,
      "height": 160.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "Krl8VR76mFVmpVp3qnom"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 987994076,
      "version": 1,
      "versionNonce": 677855936,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793529298200,
      "link": null,
      "locked": false,
      "text": "-- la première pension de la personne\nSELECT tableau, IND_ID_PREST,\n       MIN(PE_DATE_INSERT) AS premiere_saisie\nFROM   pe\nGROUP BY tableau, IND_ID_PREST\n-- … saisie dans l'exercice\nWHERE premiere_saisie >= debut\n  AND premiere_saisie <  fin + 1",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-- la première pension de la personne\nSELECT tableau, IND_ID_PREST,\n       MIN(PE_DATE_INSERT) AS premiere_saisie\nFROM   pe\nGROUP BY tableau, IND_ID_PREST\n-- … saisie dans l'exercice\nWHERE premiere_saisie >= debut\n  AND premiere_saisie <  fin + 1",
      "autoResize": true,
      "lineHeight": 1.25
    },
