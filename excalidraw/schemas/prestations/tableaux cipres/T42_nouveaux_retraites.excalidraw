      "boundElements": [],
      "updated": 1793529298200,
      "link": null,
      "locked": false,
      "text": "Une seule fois, l'année de son entrée, même si elle meurt ou que sa pension\nest arrêtée avant le 31 décembre. Une révision ou une reliquidation n'en\nfait pas un nouveau retraité.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Une seule fois, l'année de son entrée, même si elle meurt ou que sa pension\nest arrêtée avant le 31 décembre. Une révision ou une reliquidation n'en\nfait pas un nouveau retraité.",
      "autoResize": true,
      "lineHeight": 1.25
    },
