      "updated": 1793529298200,
      "link": null,
      "locked": false,
      "text": "-- T42 : bas = 50, haut = 100\nCASE WHEN age IS NULL OR age < 0\n       OR age >= 120  THEN 'Âge inconnu'\n     WHEN age < bas   THEN 'Moins de 50 ans'\n     WHEN age >= haut THEN '100 ans et plus'\n     ELSE FLOOR(age / 5) * 5 || ' – '\n          || (FLOOR(age / 5) * 5 + 4) || ' ans'\nEND AS libelle",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-- T42 : bas = 50, haut = 100\nCASE WHEN age IS NULL OR age < 0\n       OR age >= 120  THEN 'Âge inconnu'\n     WHEN age < bas   THEN 'Moins de 50 ans'\n     WHEN age >= haut THEN '100 ans et plus'\n     ELSE FLOOR(age / 5) * 5 || ' – '\n          || (FLOOR(age / 5) * 5 + 4) || ' ans'\nEND AS libelle",
      "autoResize": true,
      "lineHeight": 1.25
    },
