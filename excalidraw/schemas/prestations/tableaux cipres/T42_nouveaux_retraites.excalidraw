      "isDeleted": false,
      "boundElements": [],
      "updated": 1793529298200,
      "link": null,
      "locked": false,
      "text": "-- la part CNSS des mois cotisés\nCASE WHEN rang = 1\n      AND mois BETWEEN 1 AND 600\n     THEN GREATEST(mois\n          - NVL(mois_autre_caisse, 0), 0)\nEND AS mois\n-- additionnés par tranche et par sexe\nSUM(CASE WHEN sexe = '1' THEN mois END)",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-- la part CNSS des mois cotisés\nCASE WHEN rang = 1\n      AND mois BETWEEN 1 AND 600\n     THEN GREATEST(mois\n          - NVL(mois_autre_caisse, 0), 0)\nEND AS mois\n-- additionnés par tranche et par sexe\nSUM(CASE WHEN sexe = '1' THEN mois END)",
      "autoResize": true,
      "lineHeight": 1.25
    },
