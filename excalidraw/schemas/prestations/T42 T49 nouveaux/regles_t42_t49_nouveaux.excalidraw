      "boundElements": [],
      "updated": 1794179732782,
      "link": null,
      "locked": false,
      "text": "• En écart : rentes de victimes 39 pour 44 (−11,4 %) ; parents de rente 15 pour 13 (+15,4 %) ; 641 femmes parmi les retraités saisis pour 527 (+21,6 %) ; rentes payées 12 à 25 % sous l'annuaire : montants de T45 à T49\ntrop bas.",
      "fontSize": 21,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "• En écart : rentes de victimes 39 pour 44 (−11,4 %) ; parents de rente 15 pour 13 (+15,4 %) ; 641 femmes parmi les retraités saisis pour 527 (+21,6 %) ; rentes payées 12 à 25 % sous l'annuaire : montants de T45 à T49\ntrop bas.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "wBwWI7TF0YDNqbmhgBkR",
      "type": "text",
      "x": 22,
      "y": 470.5,
