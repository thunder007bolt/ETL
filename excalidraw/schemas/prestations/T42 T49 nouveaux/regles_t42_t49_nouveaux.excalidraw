    {
      "id": "1aXBzZjSp3QJAqlV7Uit",
      "type": "text",
      "x": 47,
      "y": 10271.5,
      "width": 2482.35,
      "height": 47.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
