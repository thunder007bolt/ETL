      "versionNonce": 1420327508,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794179732782,
      "link": null,
      "locked": false,
      "text": "L'ayant droit (IND_ID_PREST), une fois par tableau : la veuve, l'orphelin\nlui-même (pas son tuteur), le parent, la victime. On n'additionne jamais deux\ntableaux.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "L'ayant droit (IND_ID_PREST), une fois par tableau : la veuve, l'orphelin\nlui-même (pas son tuteur), le parent, la victime. On n'additionne jamais deux\ntableaux.",
      "autoResize": true,
      "lineHeight": 1.25
    },
