      "link": null,
      "locked": false,
      "text": "Réglage date_montant. 'MOIS' (retenu) : paiements des mois de la période.\n'SAISIE' : paiements saisis dans la période, rappel et janvier suivant compris.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Réglage date_montant. 'MOIS' (retenu) : paiements des mois de la période.\n'SAISIE' : paiements saisis dans la période, rappel et janvier suivant compris.",
      "autoResize": true,
      "lineHeight": 1.25
    },
