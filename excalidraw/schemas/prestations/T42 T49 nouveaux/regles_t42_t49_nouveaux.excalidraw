      "seed": 1530577277,
      "version": 1,
      "versionNonce": 875173896,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794179732782,
      "link": null,
      "locked": false,
      "text": "L'annuaire publie les nouveaux par type et par DR (tableau 23), l'âge et le sexe des nouveaux retraités (25) et des nouvelles rentes viagères (75), les nouveaux ayants droit de rentes (77). Aucun montant de nouveaux, ni services passés, ni IPP.\nIl tranche la date d'entrée et la « première fois », que les sources plus fortes ne disent pas.",
      "fontSize": 19,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "L'annuaire publie les nouveaux par type et par DR (tableau 23), l'âge et le sexe des nouveaux retraités (25) et des nouvelles rentes viagères (75), les nouveaux ayants droit de rentes (77). Aucun montant de nouveaux, ni services passés, ni IPP.\nIl tranche la date d'entrée et la « première fois », que les sources plus fortes ne disent pas.",
      "autoResize": true,
      "lineHeight": 1.25
    },
