      "isDeleted": false,
      "boundElements": [],
      "updated": 1794179732782,
      "link": null,
      "locked": false,
      "text": "Pour T43 à T49, « Idem. Tab 41 » = même périodicité. La définition de\nl'allocataire (titulaire du dossier) ne change pas la personne comptée.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Pour T43 à T49, « Idem. Tab 41 » = même périodicité. La définition de\nl'allocataire (titulaire du dossier) ne change pas la personne comptée.",
      "autoResize": true,
      "lineHeight": 1.25
    },
