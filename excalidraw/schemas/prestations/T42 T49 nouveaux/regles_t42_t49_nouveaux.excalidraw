    {
      "id": "mrbIaSqfreh14W30SAPf",
      "type": "text",
      "x": 47,
      "y": 7176.75,
      "width": 2492.8,
      "height": 47.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
