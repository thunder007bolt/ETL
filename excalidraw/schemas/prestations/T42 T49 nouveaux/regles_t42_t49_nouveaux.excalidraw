      "boundElements": [],
      "updated": 1794179732782,
      "link": null,
      "locked": false,
      "text": "• Décisions attendues : qui compte pour un survivant (Q1) ; saisie ou notification (Q2) ; le rappel dans le montant (Q3) ; où sont les rentes qui manquent (Q5) ; les 44 rentes de victimes (Q6, après un dernier test).",
      "fontSize": 21,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "• Décisions attendues : qui compte pour un survivant (Q1) ; saisie ou notification (Q2) ; le rappel dans le montant (Q3) ; où sont les rentes qui manquent (Q5) ; les 44 rentes de victimes (Q6, après un dernier test).",
      "autoResize": true,
      "lineHeight": 1.25
    },
