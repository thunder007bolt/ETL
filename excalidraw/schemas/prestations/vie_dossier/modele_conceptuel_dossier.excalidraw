      "seed": 792024416,
      "version": 1,
      "versionNonce": 811600046,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793362221175,
      "link": null,
      "locked": false,
      "text": "clé : IND_ID · sexe (1 ou 2), date de naissance, date de décès\nRôles dans le parcours : l'assuré (dossier), l'ayant droit et la personne payée (droit), la personne payée (effet), le tuteur d'un orphelin,\nun membre de la famille (LIEN). Pour un orphelin, l'ayant droit et la personne payée sont deux personnes différentes (P16).",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "clé : IND_ID · sexe (1 ou 2), date de naissance, date de décès\nRôles dans le parcours : l'assuré (dossier), l'ayant droit et la personne payée (droit), la personne payée (effet), le tuteur d'un orphelin,\nun membre de la famille (LIEN). Pour un orphelin, l'ayant droit et la personne payée sont deux personnes différentes (P16).",
      "autoResize": true,
      "lineHeight": 1.25
    },
