      "type": "text",
      "x": 2013,
      "y": 2106.5,
      "width": 327.96,
      "height": 112.5,
      "angle": 0,
      "strokeColor": "#c92a2a",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "kjNffqaLXhXjkwOpxMfo"
