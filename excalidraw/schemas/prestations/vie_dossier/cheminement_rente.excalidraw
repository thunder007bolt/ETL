      "link": null,
      "locked": false,
      "text": "DEBOURS · lien PE_ID · DEB_TYPE = 'PM'\nDEB_DATE_EFFET : le mois payé\nDEB_MONTANT : la somme\nDEB_STATUT D ou P : vraiment versé (R3)\nEFFET · clé EFP_ID : le titre de paiement\nBORDEREAU_PREST · clé BO_ID : le lot",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "DEBOURS · lien PE_ID · DEB_TYPE = 'PM'\nDEB_DATE_EFFET : le mois payé\nDEB_MONTANT : la somme\nDEB_STATUT D ou P : vraiment versé (R3)\nEFFET · clé EFP_ID : le titre de paiement\nBORDEREAU_PREST · clé BO_ID : le lot",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b08"
