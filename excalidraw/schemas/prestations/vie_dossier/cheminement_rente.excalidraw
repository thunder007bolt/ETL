      "seed": 1123144076,
      "version": 2,
      "versionNonce": 983340713,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793702401137,
      "link": null,
      "locked": false,
      "text": "Un orphelin est compté\n(IND_ID_PREST) mais peut être\npayé à sa mère ou à son\ntuteur (IND_ID_BENEF) : on\ncompte l'ayant droit (R5).",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Un orphelin est compté\n(IND_ID_PREST) mais peut être\npayé à sa mère ou à son\ntuteur (IND_ID_BENEF) : on\ncompte l'ayant droit (R5).",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b0O"
    },
