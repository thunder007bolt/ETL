      "updated": 1793702401137,
      "link": null,
      "locked": false,
      "text": "L'employeur déclare l'accident au\nguichet. La CNSS ouvre le dossier\nde la victime. Ce dépôt suffit pour\npayer les IJ et rembourser les\nsoins.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "L'employeur déclare l'accident au\nguichet. La CNSS ouvre le dossier\nde la victime. Ce dépôt suffit pour\npayer les IJ et rembourser les\nsoins.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "af"
    },
