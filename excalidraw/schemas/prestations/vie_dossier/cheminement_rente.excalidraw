      "isDeleted": false,
      "boundElements": [],
      "updated": 1793702401137,
      "link": null,
      "locked": false,
      "text": "La CNSS fixe le taux d'incapacité\net crée une ligne pour la rente,\nsur le dossier de l'accident.\nEn dessous de 15 %, ce n'est pas\nune rente mais une allocation\nd'incapacité, payée une seule fois.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "La CNSS fixe le taux d'incapacité\net crée une ligne pour la rente,\nsur le dossier de l'accident.\nEn dessous de 15 %, ce n'est pas\nune rente mais une allocation\nd'incapacité, payée une seule fois.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "at"
    },
