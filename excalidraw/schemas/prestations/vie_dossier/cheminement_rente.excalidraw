      "updated": 1793702401137,
      "link": null,
      "locked": false,
      "text": "Réceptions ANCIEN avec un\ncertificat de décès : 53 (P60)\nARSE 1 121 · ARSV 388\nARSA 350 · ARSF 4 (P61)",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Réceptions ANCIEN avec un\ncertificat de décès : 53 (P60)\nARSE 1 121 · ARSV 388\nARSA 350 · ARSF 4 (P61)",
