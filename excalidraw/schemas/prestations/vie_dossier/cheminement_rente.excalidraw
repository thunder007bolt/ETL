      "isDeleted": false,
      "boundElements": [],
      "updated": 1793702401137,
      "link": null,
      "locked": false,
      "text": "Chaque mois, une somme due est\npréparée pour la rente, puis\nréunie dans un titre de paiement\n(l'effet) et dans un lot remis à\nla banque.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Chaque mois, une somme due est\npréparée pour la rente, puis\nréunie dans un titre de paiement\n(l'effet) et dans un lot remis à\nla banque.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b07"
    },
    {
      "id": "evdt0kvoWNhAkIN8HUZ7",
