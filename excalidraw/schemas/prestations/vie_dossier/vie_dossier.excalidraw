      "isDeleted": false,
      "boundElements": [],
      "updated": 1793362260397,
      "link": null,
      "locked": false,
      "text": "Liquidation = 1re notification des droits\nde chaque demande (D4) : une réversion\ncompte à part. Norme CIPRES : 45 jours\nau plus, dépassée pour 61 % des dossiers\nV et 98 % des AT/MP. La date de\nnotification du dossier est vide (P54).",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Liquidation = 1re notification des droits\nde chaque demande (D4) : une réversion\ncompte à part. Norme CIPRES : 45 jours\nau plus, dépassée pour 61 % des dossiers\nV et 98 % des AT/MP. La date de\nnotification du dossier est vide (P54).",
      "autoResize": true,
      "lineHeight": 1.25
    },
