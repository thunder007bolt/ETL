      "versionNonce": 727032045,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793362260397,
      "link": null,
      "locked": false,
      "text": "La CNSS ouvre un dossier pour l'assuré\ndans une branche, ou rejette la\ndemande. Une demande ANCIEN n'ouvre\npas de dossier : elle complète celui\nqui existe.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "La CNSS ouvre un dossier pour l'assuré\ndans une branche, ou rejette la\ndemande. Une demande ANCIEN n'ouvre\npas de dossier : elle complète celui\nqui existe.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
