      "versionNonce": 1651544236,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793362260397,
      "link": null,
      "locked": false,
      "text": "8,7 millions d'effets : virement\n4,30 M, espèces 4,24 M (P37)\n2025 : 507 631 effets décaissés\n(statut D, P21)",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "8,7 millions d'effets : virement\n4,30 M, espèces 4,24 M (P37)\n2025 : 507 631 effets décaissés\n(statut D, P21)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "Yzhc8M1sMbLuTXzZQ700",
      "type": "text",
      "x": 1983,
      "y": 1750.0,
      "width": 438.48,
      "height": 112.5,
      "angle": 0,
      "strokeColor": "#c92a2a",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "UQnYII8qyfjlyK4PSAgV"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 41598121,
      "version": 1,
      "versionNonce": 2029318585,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793362260397,
      "link": null,
      "locked": false,
      "text": "62 % des paiements PF de 2025 n'ont pas\nd'effet : statut P, autre circuit (P23).\nLe débours prend le statut de son effet.\nNET_A_PAYER est répété sur chaque débours\nde l'effet : ne jamais l'additionner.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "62 % des paiements PF de 2025 n'ont pas\nd'effet : statut P, autre circuit (P23).\nLe débours prend le statut de son effet.\nNET_A_PAYER est répété sur chaque débours\nde l'effet : ne jamais l'additionner.",
      "autoResize": true,
      "lineHeight": 1.25
    },
