      "versionNonce": 1877935920,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793362260397,
      "link": null,
      "locked": false,
      "text": "La date d'effet remonte souvent avant la\ndécision : un tiers des pensions de\nvieillesse notifiées en 2025 ont un effet\nen 2024 ou avant (P28).",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "La date d'effet remonte souvent avant la\ndécision : un tiers des pensions de\nvieillesse notifiées en 2025 ont un effet\nen 2024 ou avant (P28).",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "emL729J088pkayCXH3bQ",
      "type": "rectangle",
