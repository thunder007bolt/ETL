      "versionNonce": 1887494449,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793362260397,
      "link": null,
      "locked": false,
      "text": "A veut dire actif, pas « en instance » :\n61 632 dossiers de vieillesse sont\nactifs (P02). Les refus ne sont notés que\ndans DOSSIER_REJETE : une quinzaine\npar an en pensions (P56). TSINISTRE\nn'est plus alimentée depuis fin 2024.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A veut dire actif, pas « en instance » :\n61 632 dossiers de vieillesse sont\nactifs (P02). Les refus ne sont notés que\ndans DOSSIER_REJETE : une quinzaine\npar an en pensions (P56). TSINISTRE\nn'est plus alimentée depuis fin 2024.",
      "autoResize": true,
      "lineHeight": 1.25
    },
