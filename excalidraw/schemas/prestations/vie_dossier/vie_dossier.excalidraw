      "version": 1,
      "versionNonce": 1887389410,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793362260397,
      "link": null,
      "locked": false,
      "text": "PRESTATION_ESP · clé PE_ID · lien DOS_CODE\nTPE_CODE : le droit (28 codes)\nPE_DATE_DEMANDE, PE_DATE_EFFET (début)\nIND_ID_PREST : l'ayant droit\nIND_ID_BENEF : la personne payée\nETAPE · lien PE_ID : CIP, calcul initial",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "PRESTATION_ESP · clé PE_ID · lien DOS_CODE\nTPE_CODE : le droit (28 codes)\nPE_DATE_DEMANDE, PE_DATE_EFFET (début)\nIND_ID_PREST : l'ayant droit\nIND_ID_BENEF : la personne payée\nETAPE · lien PE_ID : CIP, calcul initial",
      "autoResize": true,
      "lineHeight": 1.25
    },
