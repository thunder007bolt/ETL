      "version": 1,
      "versionNonce": 2013647591,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793362260397,
      "link": null,
      "locked": false,
      "text": "PRESTATION_ESP : PE_DATE_SUSPENSION,\nPE_DATE_REACTIVATION, PE_DATE_RADIATION\nPE_STATUT : A active, S suspendue, F fermée\nETAPE : RP révision, MAJ majoration\nAJUSTEMENT (via PE_AJ) : trop-perçu, rappel…\nDOSSIERS_CONTROLES : contrôles",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "PRESTATION_ESP : PE_DATE_SUSPENSION,\nPE_DATE_REACTIVATION, PE_DATE_RADIATION\nPE_STATUT : A active, S suspendue, F fermée\nETAPE : RP révision, MAJ majoration\nAJUSTEMENT (via PE_AJ) : trop-perçu, rappel…\nDOSSIERS_CONTROLES : contrôles",
      "autoResize": true,
      "lineHeight": 1.25
    },
