      "isDeleted": false,
      "boundElements": [],
      "updated": 1793362260397,
      "link": null,
      "locked": false,
      "text": "273 005 réceptions en tout\n2025 : V 4 671 · A 1 481\nF 9 968 · M 4 338 (P09)\nPensions 2025 : 4 055 NOUVEAU,\n616 ANCIEN (P52)",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "273 005 réceptions en tout\n2025 : V 4 671 · A 1 481\nF 9 968 · M 4 338 (P09)\nPensions 2025 : 4 055 NOUVEAU,\n616 ANCIEN (P52)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "ln3XlAOLRCi7FenVD1n9",
      "type": "text",
      "x": 1983,
      "y": 810,
      "width": 407.34000000000003,
      "height": 112.5,
      "angle": 0,
      "strokeColor": "#c92a2a",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "3hYrxqGXFiTaNWLavFfy"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1123297924,
      "version": 1,
      "versionNonce": 65958993,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793362260397,
      "link": null,
      "locked": false,
      "text": "Une réception = un dépôt (D3). 96 % des\npièces sont saisies le jour même : la\ndate de réception est celle du dossier\ncomplet (P49). 94 % des demandes ANCIEN\nsont suivies d'une réversion (P58).",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Une réception = un dépôt (D3). 96 % des\npièces sont saisies le jour même : la\ndate de réception est celle du dossier\ncomplet (P49). 94 % des demandes ANCIEN\nsont suivies d'une réversion (P58).",
      "autoResize": true,
      "lineHeight": 1.25
    },
