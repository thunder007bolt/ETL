      "version": 1,
      "versionNonce": 948960217,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793362260397,
      "link": null,
      "locked": false,
      "text": "RECEPTION_DOSSIER · clé RD_ID\nRD_DATE_RECEPTION : date du dépôt\nRD_TYPE_RECEPTION : NOUVEAU ou ANCIEN\nDOS_CODE : le dossier visé (ANCIEN)\nTDOS_CODE : la branche demandée\nRD_STATUT : E presque toujours\nRECEPTION_DOS_PIECE : les pièces fournies\n(86 types de pièce, TYPE_PIECE)",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "RECEPTION_DOSSIER · clé RD_ID\nRD_DATE_RECEPTION : date du dépôt\nRD_TYPE_RECEPTION : NOUVEAU ou ANCIEN\nDOS_CODE : le dossier visé (ANCIEN)\nTDOS_CODE : la branche demandée\nRD_STATUT : E presque toujours\nRECEPTION_DOS_PIECE : les pièces fournies\n(86 types de pièce, TYPE_PIECE)",
      "autoResize": true,
      "lineHeight": 1.25
    },
