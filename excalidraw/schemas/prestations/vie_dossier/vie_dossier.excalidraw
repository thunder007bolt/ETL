    {
      "id": "NHsiy6LpXylIFGr0VmaD",
      "type": "text",
      "x": 363,
      "y": 1929.0,
      "width": 352.8,
      "height": 135.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
