    },
    {
      "id": "4ok68kxDelB3rmzwqfi4",
      "type": "text",
      "x": 1983,
      "y": 1213.0,
      "width": 409.5,
      "height": 90.0,
      "angle": 0,
      "strokeColor": "#c92a2a",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
