      "versionNonce": 1054638253,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794253553496,
      "link": null,
      "locked": false,
      "text": "Question : un dossier de coordination, payé par une autre caisse mais reçu et étudié par la\nCNSS, compte-t-il dans T25 à T27 ?",
