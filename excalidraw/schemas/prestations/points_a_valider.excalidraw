      "roundness": null,
      "seed": 1995763289,
      "version": 2,
      "versionNonce": 850699939,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794253553496,
      "link": null,
      "locked": false,
      "text": "Question : quand DEB_DATE_DECAISSEMENT est vide, où la base garde-t-elle le jour du\nversement ?",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Question : quand DEB_DATE_DECAISSEMENT est vide, où la base garde-t-elle le jour du\nversement ?",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "bVY"
    },
