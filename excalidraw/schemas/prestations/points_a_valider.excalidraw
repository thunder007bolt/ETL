    {
      "id": "UR4F4qYUvmViDIUtdRMC",
      "type": "text",
      "x": 102.22206506364921,
      "y": 18596.5,
      "width": 282.8,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
