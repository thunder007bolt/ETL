    {
      "id": "0fKVVPK12WCGDaDAClOY",
      "type": "text",
      "x": 897.0,
      "y": 5526.5,
      "width": 798.08,
      "height": 40.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
