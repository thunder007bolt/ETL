      "versionNonce": 1442528109,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794253553496,
      "link": null,
      "locked": false,
      "text": "Dans la base : aucun soin remboursé (DEBOURS, DEB_TYPE = RB) en 2024 sur les dossiers\nde maternité (TDOS_CODE = M).",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Dans la base : aucun soin remboursé (DEBOURS, DEB_TYPE = RB) en 2024 sur les dossiers\nde maternité (TDOS_CODE = M).",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "bBz"
    },
    {
      "id": "gnQSzL24dOgjfeCikdkX",
      "type": "text",
      "x": 1755,
      "y": 10124.5,
      "width": 787.6800000000001,
      "height": 40,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
