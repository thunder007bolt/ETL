      "boundElements": [],
      "updated": 1793571984644,
      "link": null,
      "locked": false,
      "text": "Question : on garde ces règles, et le statut R veut-il bien dire annulé ?",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Question : on garde ces règles, et le statut R veut-il bien dire annulé ?",
      "autoResize": true,
      "lineHeight": 1.25
    },
