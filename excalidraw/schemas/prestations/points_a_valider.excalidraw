    {
      "id": "UYMOjWsB6OKwaPHs4BFI",
      "type": "text",
      "x": 1755,
      "y": 8766.5,
      "width": 677.44,
      "height": 20,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
