      "isDeleted": false,
      "boundElements": [],
      "updated": 1793570031210,
      "link": null,
      "locked": false,
      "text": "T56 : où sont payées les prestations en nature des AT/MP (139,7 M publiés\nen 2024, rien dans les débours) et les rentes AT/MP, 12 % sous le publié\ndans les débours ? Les rachats de rente (21,5 M) et les rappels de\nmoins-perçus sont-ils des prestations servies ? Que met-on dans la ligne «\nAutres » ?",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "T56 : où sont payées les prestations en nature des AT/MP (139,7 M publiés\nen 2024, rien dans les débours) et les rentes AT/MP, 12 % sous le publié\ndans les débours ? Les rachats de rente (21,5 M) et les rappels de\nmoins-perçus sont-ils des prestations servies ? Que met-on dans la ligne «\nAutres » ?",
      "autoResize": true,
      "lineHeight": 1.25
    },
