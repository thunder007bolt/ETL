      "text": "Qui suit le taux d'indus (T31)",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Qui suit le taux d'indus (T31)",
      "autoResize": true,
