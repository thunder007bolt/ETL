      "frameId": null,
      "roundness": null,
      "seed": 1379352538,
      "version": 1,
      "versionNonce": 1067442591,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794218137525,
      "link": null,
      "locked": false,
      "text": "Aujourd'hui : comme pour les pensions (voir le point 10), on ne compte que les orphelins de\nmoins de 25 ans.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Aujourd'hui : comme pour les pensions (voir le point 10), on ne compte que les orphelins de\nmoins de 25 ans.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "4dTMKcpdzYn2CkOjczn8",
      "type": "text",
      "x": 897.0,
      "y": 14944.5,
      "width": 735.6800000000001,
      "height": 60.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
