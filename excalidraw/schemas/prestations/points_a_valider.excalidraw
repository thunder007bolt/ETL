    {
      "id": "CBunNbA3tNXfDVEO4JDQ",
      "type": "text",
      "x": 39.0,
      "y": 4022.5,
      "width": 748.8000000000001,
      "height": 40.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "rYULU7urXZPcTdDdBg8E"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 807446136,
      "version": 1,
      "versionNonce": 1455695581,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794218137525,
      "link": null,
      "locked": false,
      "text": "C'est quoi : la CNSS a trois branches : les pensions, les risques professionnels et les\nprestations familiales.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "C'est quoi : la CNSS a trois branches : les pensions, les risques professionnels et les\nprestations familiales.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "5GZY7z4QeVosoUM8MPQD",
      "type": "text",
      "x": 39.0,
      "y": 4070.5,
      "width": 745.6,
      "height": 60.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "rYULU7urXZPcTdDdBg8E"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 934387599,
      "version": 1,
      "versionNonce": 456775030,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794218137525,
      "link": null,
      "locked": false,
      "text": "Dans la base : la branche du dossier (DOSSIER, TDOS_CODE) : V pensions, A risques\nprofessionnels, F prestations familiales, M maternité, qui va avec les prestations\nfamiliales. Un trop-perçu prend la branche de son dossier.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Dans la base : la branche du dossier (DOSSIER, TDOS_CODE) : V pensions, A risques\nprofessionnels, F prestations familiales, M maternité, qui va avec les prestations\nfamiliales. Un trop-perçu prend la branche de son dossier.",
      "autoResize": true,
      "lineHeight": 1.25
    },
