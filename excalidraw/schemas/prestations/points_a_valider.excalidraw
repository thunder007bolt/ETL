      "seed": 1818745001,
      "version": 1,
      "versionNonce": 1577699624,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794218137525,
      "link": null,
      "locked": false,
      "text": "Dans la base : les paiements des enfants comptés : DEBOURS, DEB_TYPE = PM,\nDEB_STATUT D ou P, montant DEB_MONTANT.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Dans la base : les paiements des enfants comptés : DEBOURS, DEB_TYPE = PM,\nDEB_STATUT D ou P, montant DEB_MONTANT.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "8rKoC4L6nKGWtkDz6t2M",
      "type": "text",
      "x": 39.0,
      "y": 13464.5,
      "width": 568.0,
      "height": 20.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "v9coThVQXYhV4phx0HED"
      ],
