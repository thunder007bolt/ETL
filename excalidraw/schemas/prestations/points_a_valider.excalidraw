    },
    {
      "id": "6W7tOJ80JE2qF4z69vQJ",
      "type": "text",
      "x": 39.0,
      "y": 1322.5,
      "width": 726.5600000000001,
      "height": 20.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "W6HvWDzwvZ9vRiFFIZUe"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1657171017,
      "version": 1,
      "versionNonce": 2055183396,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793571984644,
      "link": null,
      "locked": false,
      "text": "C'est quoi : les tableaux T42 à T49 comptent les nouveaux bénéficiaires de l'année.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "C'est quoi : les tableaux T42 à T49 comptent les nouveaux bénéficiaires de l'année.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "fE3ozdn8iZZyHYHXrYdQ",
      "type": "text",
      "x": 39.0,
      "y": 1350.5,
      "width": 781.76,
      "height": 60.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "W6HvWDzwvZ9vRiFFIZUe"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1984826754,
      "version": 1,
      "versionNonce": 510272150,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793571984644,
      "link": null,
      "locked": false,
      "text": "Dans la base : la première prestation de la personne dans le tableau, saisie dans l'année\n(PE_DATE_INSERT). Une révision ou une reliquidation d'une pension existante ne compte\npas.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Dans la base : la première prestation de la personne dans le tableau, saisie dans l'année\n(PE_DATE_INSERT). Une révision ou une reliquidation d'une pension existante ne compte\npas.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "5a3E5xCYpTAM3kAkXujq",
      "type": "text",
      "x": 39.0,
      "y": 1418.5,
      "width": 789.2800000000001,
      "height": 40.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
