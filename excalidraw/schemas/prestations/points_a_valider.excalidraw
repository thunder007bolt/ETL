      "roundness": null,
      "seed": 394332263,
      "version": 2,
      "versionNonce": 1602048269,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794253553496,
      "link": null,
      "locked": false,
      "text": "C'est quoi : les tableaux par âge de l'annuaire CNSS (19, 25 et 36) ne disent pas comment\nl'âge est calculé.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "C'est quoi : les tableaux par âge de l'annuaire CNSS (19, 25 et 36) ne disent pas comment\nl'âge est calculé.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "bLF"
    },
    {
      "id": "lD12iYOuRAfg8y3i9gJN",
      "type": "text",
      "x": 897,
      "y": 15866.5,
      "width": 654.4,
      "height": 20,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "bwUu1mxpuGkAI1BsJkcz"
      ],
      "frameId": null,
      "roundness": null,
