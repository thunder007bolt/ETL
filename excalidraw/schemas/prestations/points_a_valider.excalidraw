    {
      "id": "h3aOCayZsKUOakwGCz6x",
      "type": "text",
      "x": 897.0,
      "y": 21568.5,
      "width": 772.96,
      "height": 60.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "4Ik6TFPH4Z1f7laGd1Yy"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1230441492,
      "version": 1,
      "versionNonce": 1577420665,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794218137525,
      "link": null,
      "locked": false,
      "text": "C'est quoi : le recueil des besoins annonce un « document de référence des tableaux de la\nCNSS », sans le nommer ni le joindre. S'il définit des tableaux, il pourrait passer avant\nl'Annuaire CIPRES, pour tous les tableaux.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "C'est quoi : le recueil des besoins annonce un « document de référence des tableaux de la\nCNSS », sans le nommer ni le joindre. S'il définit des tableaux, il pourrait passer avant\nl'Annuaire CIPRES, pour tous les tableaux.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "JOoKC3PD7MH4r6kD9bi1",
