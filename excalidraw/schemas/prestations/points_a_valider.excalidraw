    },
    {
      "id": "8QWdIQmV4DiDClbAdmsb",
      "type": "text",
      "x": 39,
      "y": 21568.5,
      "width": 789.9200000000001,
      "height": 60,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "8mzdl7Jk1pGtAFglFhwm"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1671048278,
      "version": 2,
      "versionNonce": 1538853005,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794253553496,
      "link": null,
      "locked": false,
      "text": "C'est quoi : le recueil des besoins demande un indicateur annuel, la « proportion de\nnouvelles prestations promues », suivi par la DCP. Il donne son nom et sa fréquence, pas sa\nformule, et écrit lui-même qu'il est à confirmer avec la DAI et la DPC.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "C'est quoi : le recueil des besoins demande un indicateur annuel, la « proportion de\nnouvelles prestations promues », suivi par la DCP. Il donne son nom et sa fréquence, pas sa\nformule, et écrit lui-même qu'il est à confirmer avec la DAI et la DPC.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "bU9"
    },
