      "seed": 1736677064,
      "version": 1,
      "versionNonce": 1500555570,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794218137525,
      "link": null,
      "locked": false,
      "text": "Chiffre : en 2024, 3 857 femmes ont une allocation MAP et 56 une allocation FAP, pour 3\n890 mères qui ont une indemnité de maternité.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Chiffre : en 2024, 3 857 femmes ont une allocation MAP et 56 une allocation FAP, pour 3\n890 mères qui ont une indemnité de maternité.",
      "autoResize": true,
      "lineHeight": 1.25
    },
