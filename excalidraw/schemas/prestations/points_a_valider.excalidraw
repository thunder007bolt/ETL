      "id": "kunvJLnC9ENKxWwjzn1i",
      "type": "text",
      "x": 1755.0,
      "y": 8130.5,
      "width": 740.8000000000001,
      "height": 40.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
