    {
      "id": "ITJScBOn61NS9bbaUKS0",
      "type": "text",
      "x": 116.93210749646394,
      "y": 24864.5,
      "width": 246.8,
      "height": 25.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
