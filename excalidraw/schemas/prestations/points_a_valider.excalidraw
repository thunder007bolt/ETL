    {
      "id": "ynbcxsCiwbFdTgmnrgFt",
      "type": "text",
      "x": 102.22206506364921,
      "y": 9960.5,
      "width": 349.6,
      "height": 25.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
