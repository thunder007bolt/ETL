    {
      "id": "vZJ6DCHQzknJMJ0dgFsR",
      "type": "text",
      "x": 974.9321074964639,
      "y": 16698.5,
      "width": 482.40000000000003,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
