      "width": 632.6400000000001,
      "height": 20.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "vLmKnCSfOKnkBYEQaIGZ"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 343048493,
      "version": 1,
      "versionNonce": 1153501594,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794218137525,
      "link": null,
      "locked": false,
      "text": "C'est quoi : le décaissement est le jour où l'argent est réellement versé.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "C'est quoi : le décaissement est le jour où l'argent est réellement versé.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "xWsyEhfYRTLxcHOD2UQ3",
      "type": "text",
      "x": 1755.0,
      "y": 22156.5,
      "width": 753.6,
      "height": 60.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "vLmKnCSfOKnkBYEQaIGZ"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1696195319,
      "version": 1,
      "versionNonce": 1326884255,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794218137525,
      "link": null,
      "locked": false,
      "text": "Dans la base : DEBOURS, DEB_DATE_DECAISSEMENT, et EFFET,\nEFP_DATE_DECAISSEMENT. Seuls des paiements au statut D l'ont ; ceux au statut P\njamais.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Dans la base : DEBOURS, DEB_DATE_DECAISSEMENT, et EFFET,\nEFP_DATE_DECAISSEMENT. Seuls des paiements au statut D l'ont ; ceux au statut P\njamais.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "VJ8rUt62lSkXkKqY5GoY",
      "type": "text",
      "x": 1755.0,
      "y": 22224.5,
      "width": 624.96,
      "height": 20.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "vLmKnCSfOKnkBYEQaIGZ"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1029837888,
      "version": 1,
      "versionNonce": 1550237790,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794218137525,
      "link": null,
      "locked": false,
      "text": "Aujourd'hui : on ne s'en sert pas : un paiement compte au mois qu'il paie.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Aujourd'hui : on ne s'en sert pas : un paiement compte au mois qu'il paie.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "sn2nsOCaRSc2OH2WwtY5",
      "type": "text",
      "x": 1755.0,
      "y": 22252.5,
      "width": 794.4000000000001,
      "height": 80.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "vLmKnCSfOKnkBYEQaIGZ"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 2105465706,
      "version": 1,
      "versionNonce": 271820251,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794218137525,
      "link": null,
      "locked": false,
      "text": "Chiffre : elle manque pour 80 % des paiements des prestations familiales et 43 % de ceux de\nvieillesse de 2025. Là où elle existe, elle colle parfois mieux : en 2024, les indemnités\njournalières d'accident du travail font 60,8 M au versement, plus près des 65,4 M de\nl'annuaire CNSS 2024 que la date de saisie.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Chiffre : elle manque pour 80 % des paiements des prestations familiales et 43 % de ceux de\nvieillesse de 2025. Là où elle existe, elle colle parfois mieux : en 2024, les indemnités\njournalières d'accident du travail font 60,8 M au versement, plus près des 65,4 M de\nl'annuaire CNSS 2024 que la date de saisie.",
      "autoResize": true,
      "lineHeight": 1.25
    },
