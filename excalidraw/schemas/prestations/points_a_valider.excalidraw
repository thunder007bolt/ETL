      "type": "text",
      "x": 39.0,
      "y": 23296.5,
      "width": 794.88,
      "height": 40.0,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
