      "isDeleted": false,
      "boundElements": [],
      "updated": 1794218137525,
      "link": null,
      "locked": false,
      "text": "Les dossiers transférés à une autre caisse",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Les dossiers transférés à une autre caisse",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "GieIYcoDvXkkLeo9YlzV",
      "type": "text",
      "x": 39.0,
      "y": 14800.5,
      "width": 786.5600000000001,
      "height": 40.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "jGwT5qe6A2BuesFaSOJQ"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1560205916,
      "version": 1,
      "versionNonce": 345963981,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794218137525,
      "link": null,
      "locked": false,
      "text": "C'est quoi : un dossier de pension peut être transféré à une autre caisse, qui le gère alors.\nT25 à T27 retirent ces dossiers (voir le point 19).",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "C'est quoi : un dossier de pension peut être transféré à une autre caisse, qui le gère alors.\nT25 à T27 retirent ces dossiers (voir le point 19).",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "j79LTNe482zbJkwdblNY",
      "type": "text",
      "x": 39.0,
      "y": 14848.5,
      "width": 804.0,
      "height": 40.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "jGwT5qe6A2BuesFaSOJQ"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1830230798,
      "version": 1,
      "versionNonce": 1483137015,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794218137525,
      "link": null,
      "locked": false,
      "text": "Dans la base : DOSSIER, DOS_CATEGORIE = CNSS_AC, lu « transféré à une autre caisse »\n; son sens est demandé à la DSI.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Dans la base : DOSSIER, DOS_CATEGORIE = CNSS_AC, lu « transféré à une autre caisse »\n; son sens est demandé à la DSI.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "dizwZSjG0A4p7YE9paii",
      "type": "text",
      "x": 39.0,
      "y": 14896.5,
      "width": 464.32000000000005,
      "height": 20.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "jGwT5qe6A2BuesFaSOJQ"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1147976965,
      "version": 1,
      "versionNonce": 1480759711,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794218137525,
      "link": null,
      "locked": false,
      "text": "Aujourd'hui : ces pensions restent comptées au 31/12.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Aujourd'hui : ces pensions restent comptées au 31/12.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "y3jQ7kgk2Li1rjbp6SyD",
      "type": "text",
      "x": 39.0,
      "y": 14924.5,
      "width": 756.64,
      "height": 40.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "jGwT5qe6A2BuesFaSOJQ"
      ],
