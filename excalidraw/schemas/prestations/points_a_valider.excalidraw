      "version": 2,
      "versionNonce": 922474317,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794253553496,
      "link": null,
      "locked": false,
      "text": "C'est quoi : une pension d'orphelin s'arrête à 25 ans ; elle devrait alors être radiée, arrêtée\npour de bon.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "C'est quoi : une pension d'orphelin s'arrête à 25 ans ; elle devrait alors être radiée, arrêtée\npour de bon.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "bKP"
    },
    {
      "id": "4rIU0ddSxA0mHBxPj0I6",
      "type": "text",
      "x": 39,
      "y": 15312.5,
      "width": 604.48,
      "height": 40,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
