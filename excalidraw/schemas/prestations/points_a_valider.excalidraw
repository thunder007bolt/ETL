      "boundElements": [],
      "updated": 1794218137525,
      "link": null,
      "locked": false,
      "text": "Aujourd'hui : on applique la part CNSS aux deux.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Aujourd'hui : on applique la part CNSS aux deux.",
