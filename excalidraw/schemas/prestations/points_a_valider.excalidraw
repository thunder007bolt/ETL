      "link": null,
      "locked": false,
      "text": "La réception au statut A (T25)",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "La réception au statut A (T25)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "pabxEfRCW3LaMgGd5Zj0",
      "type": "text",
      "x": 1755.0,
      "y": 24468.5,
      "width": 776.96,
      "height": 40.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "BxQtUNT4m23NbKxP6NRC"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1253407431,
      "version": 1,
      "versionNonce": 47047477,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794218137525,
      "link": null,
      "locked": false,
      "text": "C'est quoi : le statut d'une réception est un code de l'application dont le sens n'est écrit\nnulle part.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "C'est quoi : le statut d'une réception est un code de l'application dont le sens n'est écrit\nnulle part.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "WQZFMuXjrkdjUj75g3MG",
      "type": "text",
      "x": 1755.0,
      "y": 24516.5,
      "width": 761.12,
      "height": 40.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "BxQtUNT4m23NbKxP6NRC"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 772441354,
      "version": 1,
      "versionNonce": 1143736759,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794218137525,
      "link": null,
      "locked": false,
      "text": "Dans la base : RECEPTION_DOSSIER, RD_STATUT = A, pour une réception de pension\nreliée à aucun dossier.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Dans la base : RECEPTION_DOSSIER, RD_STATUT = A, pour une réception de pension\nreliée à aucun dossier.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "rtxJLH9Qx8JDA6cSgwxO",
      "type": "text",
      "x": 1755.0,
      "y": 24564.5,
      "width": 791.5200000000001,
      "height": 40.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "BxQtUNT4m23NbKxP6NRC"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 273067103,
      "version": 1,
      "versionNonce": 2020149587,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794218137525,
      "link": null,
      "locked": false,
      "text": "Aujourd'hui : on la compte en instance au 31/12 dans T25 ; annulée, elle en sortirait. Pour\nles autres réceptions sans dossier, voir le point 64.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Aujourd'hui : on la compte en instance au 31/12 dans T25 ; annulée, elle en sortirait. Pour\nles autres réceptions sans dossier, voir le point 64.",
      "autoResize": true,
      "lineHeight": 1.25
    },
