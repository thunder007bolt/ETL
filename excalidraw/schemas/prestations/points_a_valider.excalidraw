      "isDeleted": false,
      "boundElements": [],
      "updated": 1794218137525,
      "link": null,
      "locked": false,
      "text": "C'est quoi : un dossier peut porter plusieurs prestations, par exemple la pension du défunt et\ncelle de sa veuve. T28 à T30 rangent chaque contrôle sur la ligne d'un type de prestation.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "C'est quoi : un dossier peut porter plusieurs prestations, par exemple la pension du défunt et\ncelle de sa veuve. T28 à T30 rangent chaque contrôle sur la ligne d'un type de prestation.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "H7d7LolJe3koz39t0Ly9",
      "type": "text",
      "x": 39.0,
      "y": 9088.5,
      "width": 721.28,
