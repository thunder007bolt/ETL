    {
      "id": "8p3MJag6hdBLxrIaq0lQ",
      "type": "text",
      "x": 39.0,
      "y": 8882.5,
      "width": 726.4000000000001,
      "height": 60.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "VQ2MZ2kiq7lhjtzCXf1I"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1132133774,
      "version": 1,
      "versionNonce": 1936678236,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793571984644,
      "link": null,
      "locked": false,
      "text": "Dans la base : les statuts n'ont pas de liste de libellés : dossier (DOS_STATUT),\nprestation (PE_STATUT), débours (DEB_STATUT), effet, réception, notification,\najustement ; pas plus que les drapeaux *_VERIFIE.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Dans la base : les statuts n'ont pas de liste de libellés : dossier (DOS_STATUT),\nprestation (PE_STATUT), débours (DEB_STATUT), effet, réception, notification,\najustement ; pas plus que les drapeaux *_VERIFIE.",
      "autoResize": true,
      "lineHeight": 1.25
    },
