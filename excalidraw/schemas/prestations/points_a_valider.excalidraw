      "link": null,
      "locked": false,
      "text": "À qui : DAI",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "À qui : DAI",
