    },
    {
      "id": "QuK9qnyybxBAtnBAef8E",
      "type": "text",
      "x": 897,
      "y": 7606.5,
      "width": 789.44,
      "height": 60,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "JputmA1d5fiJcpaoHZnE"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1118462245,
      "version": 2,
      "versionNonce": 128979629,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794253553496,
      "link": null,
      "locked": false,
      "text": "C'est quoi : le recueil des besoins demande le délai des « rentes de survivants » depuis la\nréception du certificat de consolidation. Or ce certificat concerne la victime blessée, pas\nsa veuve ni ses orphelins.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "C'est quoi : le recueil des besoins demande le délai des « rentes de survivants » depuis la\nréception du certificat de consolidation. Or ce certificat concerne la victime blessée, pas\nsa veuve ni ses orphelins.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b7n"
    },
    {
      "id": "sJJcL8yBZD37bXCSMkVT",
      "type": "text",
      "x": 897,
