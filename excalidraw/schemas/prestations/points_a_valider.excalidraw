    },
    {
      "id": "aCWXolU0Y8fmmyuEXfV1",
      "type": "text",
      "x": 39.0,
      "y": 3740.5,
      "width": 792.32,
      "height": 40.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "MmKIILFa9n1PyOkE0QCl"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 650391550,
      "version": 1,
      "versionNonce": 94538819,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793571984644,
      "link": null,
      "locked": false,
      "text": "C'est quoi : un dossier de coordination payé par une autre caisse est reçu et instruit par la\nCNSS, mais payé ailleurs.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "C'est quoi : un dossier de coordination payé par une autre caisse est reçu et instruit par la\nCNSS, mais payé ailleurs.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "CFwfEgY9q7Ze6tMv9H8g",
      "type": "text",
      "x": 39.0,
      "y": 3788.5,
      "width": 707.0400000000001,
      "height": 20.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "MmKIILFa9n1PyOkE0QCl"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 367518683,
      "version": 1,
      "versionNonce": 1830136750,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793571984644,
      "link": null,
      "locked": false,
      "text": "Aujourd'hui : on le compte dans T25. Un dossier transféré à une autre caisse, non.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Aujourd'hui : on le compte dans T25. Un dossier transféré à une autre caisse, non.",
      "autoResize": true,
      "lineHeight": 1.25
    },
