    {
      "id": "acBoq90FeVKs8Q81T3xf",
      "type": "text",
      "x": 104.25884016973126,
      "y": 19100.5,
      "width": 290,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "SD2lOAabhVfOgSDJcFmH"
      ],
