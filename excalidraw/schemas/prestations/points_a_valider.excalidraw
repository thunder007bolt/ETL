      "boundElements": [],
      "updated": 1793571984644,
      "link": null,
      "locked": false,
      "text": "Aujourd'hui : chaque étape compte dans son année. Un dossier déposé en 2024 et liquidé en\n2025 compte dans les déposés de 2024 et dans les liquidés de 2025.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Aujourd'hui : chaque étape compte dans son année. Un dossier déposé en 2024 et liquidé en\n2025 compte dans les déposés de 2024 et dans les liquidés de 2025.",
