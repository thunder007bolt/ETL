      "text": "Les nouvelles prestations promues",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Les nouvelles prestations promues",
      "autoResize": true,
