      "type": "text",
      "x": 897,
      "y": 2398.5,
      "width": 218.56,
      "height": 20,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
