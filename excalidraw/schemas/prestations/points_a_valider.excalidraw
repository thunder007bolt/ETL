    {
      "id": "gSU7PlOz32vWqhJhVA3R",
      "type": "text",
      "x": 1813.0,
      "y": 3974.5,
      "width": 344.0,
      "height": 25.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
