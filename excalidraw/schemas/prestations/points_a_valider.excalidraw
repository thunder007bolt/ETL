      "versionNonce": 1670902886,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794218137525,
      "link": null,
      "locked": false,
      "text": "Question : une réception NOUVEAU qui n'a ouvert aucun dossier est-elle abandonnée, refusée\nsans saisie du refus, ou en attente d'une pièce ?",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Question : une réception NOUVEAU qui n'a ouvert aucun dossier est-elle abandonnée, refusée\nsans saisie du refus, ou en attente d'une pièce ?",
      "autoResize": true,
      "lineHeight": 1.25
    },
