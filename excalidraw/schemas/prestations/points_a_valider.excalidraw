    {
      "id": "J01BAf6W9HrNLL99t25G",
      "type": "text",
      "x": 1818.2220650636493,
      "y": 8014.5,
      "width": 354.40000000000003,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
