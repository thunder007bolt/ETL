      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "t6VFbLDO9V4nBwCJ3OpU"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 975202340,
      "version": 2,
      "versionNonce": 117063139,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794253553496,
      "link": null,
      "locked": false,
      "text": "Aujourd'hui : la ligne est renommée comme dans T27 et reste vide. Pour savoir où ces frais\nsont enregistrés, voir le point 129.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Aujourd'hui : la ligne est renommée comme dans T27 et reste vide. Pour savoir où ces frais\nsont enregistrés, voir le point 129.",
