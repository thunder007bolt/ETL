      "seed": 1364846182,
      "version": 1,
      "versionNonce": 1463590124,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794218137525,
      "link": null,
      "locked": false,
      "text": "Chiffre : l'annuaire CNSS 2024 compte autrement : 3 893 bénéficiaires d'indemnités de\nmaternité en 2024 (tableaux 35 et 39), soit les 3 890 liquidées et non les 4 881 payées.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Chiffre : l'annuaire CNSS 2024 compte autrement : 3 893 bénéficiaires d'indemnités de\nmaternité en 2024 (tableaux 35 et 39), soit les 3 890 liquidées et non les 4 881 payées.",
      "autoResize": true,
      "lineHeight": 1.25
    },
