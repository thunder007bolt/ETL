      "updated": 1794218137525,
      "link": null,
      "locked": false,
      "text": "Dans la base : PRESTATION_ESP, codes ARSV et ARSF, en cours à la date d'arrêté.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
