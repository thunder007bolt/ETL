      "text": "Les ascendants de rente (T47)",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Les ascendants de rente (T47)",
      "autoResize": true,
