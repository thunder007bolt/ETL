      "type": "text",
      "x": 897,
      "y": 24564.5,
      "width": 767.0400000000001,
      "height": 40,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
