    {
      "id": "r6qnzfkex2dvwqinmrOM",
      "type": "text",
      "x": 960.2220650636492,
      "y": 13824.5,
      "width": 373.6,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "oLaWdUqWi0F0kSButyjt"
      ],
