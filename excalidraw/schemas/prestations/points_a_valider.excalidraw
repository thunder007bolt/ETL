    {
      "id": "6r1kwAykqRFBRigBlbEn",
      "type": "text",
      "x": 1820.2588401697312,
      "y": 7054.5,
      "width": 174.20000000000002,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
