      "seed": 1092379419,
      "version": 1,
      "versionNonce": 1444338067,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794218137525,
      "link": null,
      "locked": false,
      "text": "Chiffre : 16 rentiers décédés en 2024 dans la base ; l'annuaire CNSS 2024 en compte 24\n(tableau 81).",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Chiffre : 16 rentiers décédés en 2024 dans la base ; l'annuaire CNSS 2024 en compte 24\n(tableau 81).",
