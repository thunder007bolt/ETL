      "text": "Les départs à la retraite de l'annuaire (T25)",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Les départs à la retraite de l'annuaire (T25)",
