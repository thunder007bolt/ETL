      "boundElements": [],
      "updated": 1794218137525,
      "link": null,
      "locked": false,
      "text": "Aujourd'hui : pour 2025, il manque les décès, radiations et notifications saisis en février\net mars 2026. Si l'annuaire est arrêté vers la fin mars (voir le point 2), chaque année se\ncalculera sur la copie de la base arrêtée fin mars de l'année suivante.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Aujourd'hui : pour 2025, il manque les décès, radiations et notifications saisis en février\net mars 2026. Si l'annuaire est arrêté vers la fin mars (voir le point 2), chaque année se\ncalculera sur la copie de la base arrêtée fin mars de l'année suivante.",
      "autoResize": true,
      "lineHeight": 1.25
    },
