    },
    {
      "id": "IUdfAAvxMB5UfAIKDXyU",
      "type": "text",
      "x": 39,
      "y": 9524.5,
      "width": 805.44,
      "height": 60,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
