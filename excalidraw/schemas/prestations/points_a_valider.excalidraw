    {
      "id": "QzjYtO317Npnlbh6fOYb",
      "type": "text",
      "x": 39.0,
      "y": 2888.5,
      "width": 799.0400000000001,
      "height": 60.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
