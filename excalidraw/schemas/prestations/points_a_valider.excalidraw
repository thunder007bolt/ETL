    {
      "id": "sNNOrzCPcjKZVPkoeRoN",
      "type": "text",
      "x": 897,
      "y": 24004.5,
      "width": 801.6,
      "height": 60,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "dY2vnV0byRcE4ACkDare"
      ],
