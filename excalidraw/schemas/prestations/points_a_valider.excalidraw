      "version": 2,
      "versionNonce": 2042228547,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794253553496,
      "link": null,
      "locked": false,
      "text": "Chiffre : 195 victimes ont eu une indemnité journalière liquidée en 2024, pour 371\nindemnités.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Chiffre : 195 victimes ont eu une indemnité journalière liquidée en 2024, pour 371\nindemnités.",
