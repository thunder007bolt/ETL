      "version": 2,
      "versionNonce": 1961401987,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794253553496,
      "link": null,
      "locked": false,
      "text": "Aujourd'hui : le montant est ce que la CNSS a payé.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Aujourd'hui : le montant est ce que la CNSS a payé.",
