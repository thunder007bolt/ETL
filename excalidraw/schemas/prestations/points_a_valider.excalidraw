      "updated": 1794218137525,
      "link": null,
      "locked": false,
      "text": "Aujourd'hui : on mesure le délai sur toutes les demandes liquidées, enfants ajoutés et\nindemnités journalières compris.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Aujourd'hui : on mesure le délai sur toutes les demandes liquidées, enfants ajoutés et\nindemnités journalières compris.",
      "autoResize": true,
      "lineHeight": 1.25
    },
