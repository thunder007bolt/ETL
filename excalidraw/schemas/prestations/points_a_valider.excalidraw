      "isDeleted": false,
      "boundElements": [],
      "updated": 1794253553496,
      "link": null,
      "locked": false,
      "text": "Dans la base : les codes MAP et FAP (PRESTATION_ESP, TPE_CODE).",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Dans la base : les codes MAP et FAP (PRESTATION_ESP, TPE_CODE).",
