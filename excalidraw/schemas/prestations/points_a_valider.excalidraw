      "updated": 1793571984644,
      "link": null,
      "locked": false,
      "text": "Ce qu'est un paiement",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Ce qu'est un paiement",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "YTYUpqFIo2LMFqcmMTdK",
      "type": "text",
      "x": 39.0,
      "y": 1856.5,
      "width": 784.96,
      "height": 60.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "GQsYrxZQH4hLHot57lQo"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 962887952,
      "version": 1,
      "versionNonce": 1874495211,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793571984644,
      "link": null,
      "locked": false,
      "text": "Dans la base : un débours de type PM (DEB_TYPE = PM) au statut D, payé par effet, ou P,\npayé sans effet (DEB_STATUT). On prend le montant du débours (DEB_MONTANT), jamais\nle net à payer de l'effet, qui se répète sur chaque débours.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Dans la base : un débours de type PM (DEB_TYPE = PM) au statut D, payé par effet, ou P,\npayé sans effet (DEB_STATUT). On prend le montant du débours (DEB_MONTANT), jamais\nle net à payer de l'effet, qui se répète sur chaque débours.",
      "autoResize": true,
      "lineHeight": 1.25
    },
