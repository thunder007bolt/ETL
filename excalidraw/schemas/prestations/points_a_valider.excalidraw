      "seed": 1026818015,
      "version": 2,
      "versionNonce": 519460003,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794253553496,
      "link": null,
      "locked": false,
      "text": "C'est quoi : quand un allocataire déclare un nouvel enfant, l'allocation est ajoutée à son\ndossier, sans passer au guichet.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "C'est quoi : quand un allocataire déclare un nouvel enfant, l'allocation est ajoutée à son\ndossier, sans passer au guichet.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b8K"
    },
    {
      "id": "oheYACgGoQXqFmoAvWNU",
      "type": "text",
      "x": 39,
      "y": 8110.5,
      "width": 749.44,
      "height": 40,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "WIzJI2upeQ7VfNxR2EtG"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 581713845,
      "version": 2,
      "versionNonce": 834730765,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794253553496,
      "link": null,
      "locked": false,
      "text": "Dans la base : une allocation familiale de plus (code FAF, PRESTATION_ESP) sur le\ndossier, sans nouvelle réception au guichet (RECEPTION_DOSSIER).",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Dans la base : une allocation familiale de plus (code FAF, PRESTATION_ESP) sur le\ndossier, sans nouvelle réception au guichet (RECEPTION_DOSSIER).",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b8L"
    },
    {
      "id": "dMq78uOmZdxILUTI1Wsr",
      "type": "text",
      "x": 39,
      "y": 8158.5,
      "width": 768.32,
      "height": 40,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "WIzJI2upeQ7VfNxR2EtG"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1312484765,
      "version": 2,
      "versionNonce": 53069891,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794253553496,
      "link": null,
      "locked": false,
      "text": "Aujourd'hui : chaque enfant ajouté compte comme une demande de plus, déposée à la date de\ndemande de son allocation et liquidée à sa notification.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Aujourd'hui : chaque enfant ajouté compte comme une demande de plus, déposée à la date de\ndemande de son allocation et liquidée à sa notification.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b8M"
    },
