      "seed": 1576802705,
      "version": 2,
      "versionNonce": 1513236205,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794253553496,
      "link": null,
      "locked": false,
      "text": "Chiffre : 15 nouveaux ascendants de rente en 2024 dans la base, 13 dans le tableau 77 (voir\nle point 114).",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
