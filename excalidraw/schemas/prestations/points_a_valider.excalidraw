      "boundElements": [],
      "updated": 1793571984644,
      "link": null,
      "locked": false,
      "text": "Chiffre : pour T32 en 2024, ce qui a été payé aux pensionnés comptés au 31/12 fait 37,67\nMd ; tout ce qui a été payé dans l'année, décédés compris, 38,63 Md. L'annuaire publie 38,24\nMd, entre les deux.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Chiffre : pour T32 en 2024, ce qui a été payé aux pensionnés comptés au 31/12 fait 37,67\nMd ; tout ce qui a été payé dans l'année, décédés compris, 38,63 Md. L'annuaire publie 38,24\nMd, entre les deux.",
      "autoResize": true,
      "lineHeight": 1.25
    },
