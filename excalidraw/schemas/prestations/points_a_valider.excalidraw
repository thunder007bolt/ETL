      "boundElements": [],
      "updated": 1794253553496,
      "link": null,
      "locked": false,
      "text": "Les dossiers sans catégorie",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Les dossiers sans catégorie",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "bWG"
    },
    {
      "id": "6XHExjAshdGKFg68CyqS",
      "type": "text",
      "x": 1755,
      "y": 22612.5,
      "width": 768,
      "height": 40,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "2u2s4tAx1CO3czymTKv9"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1146484945,
      "version": 2,
      "versionNonce": 2143101261,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794253553496,
      "link": null,
      "locked": false,
      "text": "C'est quoi : la catégorie d'un dossier dit s'il est partagé avec une autre caisse, dans une\ncoordination.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "C'est quoi : la catégorie d'un dossier dit s'il est partagé avec une autre caisse, dans une\ncoordination.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "bWH"
    },
    {
      "id": "H1ZS84mOUOjUpRSeBjkk",
      "type": "text",
      "x": 1755,
      "y": 22660.5,
      "width": 740.48,
      "height": 40,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "2u2s4tAx1CO3czymTKv9"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1118792849,
      "version": 2,
      "versionNonce": 1058678275,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794253553496,
      "link": null,
      "locked": false,
      "text": "Dans la base : DOSSIER, DOS_CATEGORIE vide. Les autres valeurs sont COOR_AC,\nCOOR_CNSS et CNSS_AC (voir le point 136).",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Dans la base : DOSSIER, DOS_CATEGORIE vide. Les autres valeurs sont COOR_AC,\nCOOR_CNSS et CNSS_AC (voir le point 136).",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "bWI"
    },
    {
      "id": "SEVyu402kx9EVBXQsMeq",
      "type": "text",
      "x": 1755,
      "y": 22708.5,
      "width": 768,
      "height": 40,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "2u2s4tAx1CO3czymTKv9"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1403555040,
      "version": 2,
      "versionNonce": 1938124717,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794253553496,
      "link": null,
      "locked": false,
      "text": "Aujourd'hui : un dossier sans catégorie est traité comme un dossier ordinaire : il compte\npartout.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Aujourd'hui : un dossier sans catégorie est traité comme un dossier ordinaire : il compte\npartout.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "bWJ"
    },
    {
      "id": "npNgo7dd5KVlhJecVr5R",
      "type": "text",
      "x": 1755,
      "y": 22756.5,
      "width": 435.84000000000003,
      "height": 20,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "2u2s4tAx1CO3czymTKv9"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 548375543,
      "version": 2,
      "versionNonce": 93089187,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794253553496,
      "link": null,
      "locked": false,
      "text": "Chiffre : 120 518 dossiers n'ont pas de catégorie.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Chiffre : 120 518 dossiers n'ont pas de catégorie.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "bWK"
    },
    {
      "id": "8c6G2K2vMpB3fJhuVyy6",
      "type": "text",
      "x": 1755,
      "y": 22784.5,
      "width": 101.76,
      "height": 20,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "2u2s4tAx1CO3czymTKv9"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 870622299,
      "version": 2,
      "versionNonce": 972354061,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794253553496,
      "link": null,
      "locked": false,
      "text": "À qui : DSI",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "À qui : DSI",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "bWL"
    },
    {
      "id": "M6sIBo1KkSmrdC0NexEC",
      "type": "text",
      "x": 1755,
      "y": 22812.5,
      "width": 794.24,
      "height": 40,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "2u2s4tAx1CO3czymTKv9"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1551575375,
      "version": 2,
      "versionNonce": 1100267843,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794253553496,
      "link": null,
      "locked": false,
      "text": "Question : un dossier sans catégorie est-il toujours un dossier ordinaire, sans coordination\navec une autre caisse ?",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
