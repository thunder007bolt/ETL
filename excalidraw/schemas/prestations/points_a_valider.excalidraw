      "seed": 1613385747,
      "version": 1,
      "versionNonce": 993917681,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794218137525,
      "link": null,
      "locked": false,
      "text": "Chiffre : environ 4 nouvelles retraites anticipées par an dans la base. L'annuaire CNSS\n2024 en publie 3 à part en 2024 ; avec elles, il compte 2 489 nouveaux retraités, la base 2\n463.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Chiffre : environ 4 nouvelles retraites anticipées par an dans la base. L'annuaire CNSS\n2024 en publie 3 à part en 2024 ; avec elles, il compte 2 489 nouveaux retraités, la base 2\n463.",
      "autoResize": true,
      "lineHeight": 1.25
    },
