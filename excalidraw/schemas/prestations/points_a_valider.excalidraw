      "seed": 509477392,
      "version": 2,
      "versionNonce": 1192223981,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794253553496,
      "link": null,
      "locked": false,
      "text": "Question : pour un tableau du mois ou du trimestre, le montant est-il celui de la période\nseule, ou le cumul depuis le 1er janvier ?",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Question : pour un tableau du mois ou du trimestre, le montant est-il celui de la période\nseule, ou le cumul depuis le 1er janvier ?",
      "autoResize": true,
