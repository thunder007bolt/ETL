    },
    {
      "id": "FL4Bakci5yMykwVpIDpt",
      "type": "text",
      "x": 39.0,
      "y": 12440.5,
      "width": 672.6400000000001,
      "height": 20.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "enKDpZCoR2aC0IdhHv46"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1549143516,
      "version": 1,
      "versionNonce": 1445594390,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794218137525,
      "link": null,
      "locked": false,
      "text": "C'est quoi : une pension de vieillesse prise avant l'âge normal de la retraite.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "C'est quoi : une pension de vieillesse prise avant l'âge normal de la retraite.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "KyObsjNaJzD1tIJIUEDo",
      "type": "text",
      "x": 39.0,
      "y": 12468.5,
      "width": 753.6,
      "height": 20.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "enKDpZCoR2aC0IdhHv46"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1256520609,
      "version": 1,
      "versionNonce": 52352529,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794218137525,
      "link": null,
      "locked": false,
      "text": "Dans la base : PRESTATION_ESP, code RPRA ; la vieillesse ordinaire a le code RPV.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Dans la base : PRESTATION_ESP, code RPRA ; la vieillesse ordinaire a le code RPV.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "6TagqvgyJh04MiXfz78y",
      "type": "text",
      "x": 39.0,
      "y": 12496.5,
      "width": 780.32,
      "height": 40.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "enKDpZCoR2aC0IdhHv46"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1473558623,
      "version": 1,
      "versionNonce": 546175964,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794218137525,
      "link": null,
      "locked": false,
      "text": "Aujourd'hui : une ligne à part sous T32 ; les tranches d'âge ne comptent que la vieillesse.\nPour la maquette CIPRES d'origine, on additionne les deux.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Aujourd'hui : une ligne à part sous T32 ; les tranches d'âge ne comptent que la vieillesse.\nPour la maquette CIPRES d'origine, on additionne les deux.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "2ej9nTgnUTDJkREzHhv5",
      "type": "text",
      "x": 39.0,
      "y": 12544.5,
      "width": 772.6400000000001,
      "height": 60.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "enKDpZCoR2aC0IdhHv46"
      ],
