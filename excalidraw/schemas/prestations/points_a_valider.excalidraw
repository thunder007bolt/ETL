      "isDeleted": false,
      "boundElements": [],
      "updated": 1794218137525,
      "link": null,
      "locked": false,
      "text": "Aujourd'hui : pas encore calculé. On prévoit de prendre toutes les pensions directes en cours\nà la date du tableau.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Aujourd'hui : pas encore calculé. On prévoit de prendre toutes les pensions directes en cours\nà la date du tableau.",
