      "isDeleted": false,
      "boundElements": [],
      "updated": 1794218137525,
      "link": null,
      "locked": false,
      "text": "Dans la base : DOS_CATEGORIE = COOR_CNSS ; le montant est la somme des paiements\n(DEBOURS).",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Dans la base : DOS_CATEGORIE = COOR_CNSS ; le montant est la somme des paiements\n(DEBOURS).",
