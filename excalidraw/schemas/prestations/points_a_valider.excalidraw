      "version": 1,
      "versionNonce": 1866690661,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793571984644,
      "link": null,
      "locked": false,
      "text": "Chiffre : 2 463 nouveaux retraités en 2024 dans la base, 2 489 dans l'annuaire. En prenant\nla date de notification (PE_DATE_NOTIFICATION), on tomberait à 2 397.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Chiffre : 2 463 nouveaux retraités en 2024 dans la base, 2 489 dans l'annuaire. En prenant\nla date de notification (PE_DATE_NOTIFICATION), on tomberait à 2 397.",
      "autoResize": true,
      "lineHeight": 1.25
    },
