    {
      "id": "PeDblvaktcvq2NJxSEqN",
      "type": "text",
      "x": 1818.2220650636493,
      "y": 1920.0,
      "width": 733.6800000000001,
      "height": 112.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "3elUwRdhtulLhrHHI0KC"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1595298710,
      "version": 1,
      "versionNonce": 680971786,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793570031210,
      "link": null,
      "locked": false,
      "text": "Indus (T31) : trop-perçus (TP, TP-CONV) au mois où ils sont établis. Les\nmoins-perçus (MP, RC) sont montrés à part, hors du taux, puisque Kaya 2017\ndit que ce ne sont pas des indus. On écarte les remboursements de\ntrop-perçu, les avances, les mois gratuits, les dons COVID et le statut R\n(annulé ?).",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Indus (T31) : trop-perçus (TP, TP-CONV) au mois où ils sont établis. Les\nmoins-perçus (MP, RC) sont montrés à part, hors du taux, puisque Kaya 2017\ndit que ce ne sont pas des indus. On écarte les remboursements de\ntrop-perçu, les avances, les mois gratuits, les dons COVID et le statut R\n(annulé ?).",
      "autoResize": true,
      "lineHeight": 1.25
    },
