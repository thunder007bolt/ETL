      "seed": 1570022998,
      "version": 1,
      "versionNonce": 1947206552,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794218137525,
      "link": null,
      "locked": false,
      "text": "Aujourd'hui : le contrôle va sur la ligne de la prestation contrôlée.",
