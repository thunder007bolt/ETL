      "roundness": null,
      "seed": 701135755,
      "version": 1,
      "versionNonce": 1944368524,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794218137525,
      "link": null,
      "locked": false,
      "text": "Aujourd'hui : on date le dépôt du jour de la réception, comme si le dossier était complet ce\njour-là. Une demande sans réception prend sa date de demande.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Aujourd'hui : on date le dépôt du jour de la réception, comme si le dossier était complet ce\njour-là. Une demande sans réception prend sa date de demande.",
      "autoResize": true,
      "lineHeight": 1.25
    },
