      "isDeleted": false,
      "boundElements": [],
      "updated": 1794218137525,
      "link": null,
      "locked": false,
      "text": "Question : pour ces prestations, le dossier compté dans T28 à T30 est-il celui payé dans la\npériode, ou celui liquidé dans la période ?",
      "fontSize": 16,
      "fontFamily": 5,
