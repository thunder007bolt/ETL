      "boundElements": [],
      "updated": 1794218137525,
      "link": null,
      "locked": false,
      "text": "C'est quoi : un dossier de coordination dont la pension est payée par l'autre caisse est quand\nmême reçu et étudié par la CNSS.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "C'est quoi : un dossier de coordination dont la pension est payée par l'autre caisse est quand\nmême reçu et étudié par la CNSS.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "GsiDxDfFzbCXEzvIfkvl",
      "type": "text",
      "x": 897.0,
      "y": 6646.5,
      "width": 771.0400000000001,
      "height": 60.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
