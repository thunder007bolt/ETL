      "link": null,
      "locked": false,
      "text": "Le total des branches (T57)",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Le total des branches (T57)",
