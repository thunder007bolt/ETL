      "boundElements": [],
      "updated": 1794218137525,
      "link": null,
      "locked": false,
      "text": "Chiffre : 5 % des 155 206 dossiers qui ont reçu au moins un débours en 2025, ce serait\nenviron 7 760 contrôles dans l'année.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
