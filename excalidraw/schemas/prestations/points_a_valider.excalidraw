    },
    {
      "id": "B8FAsHzMtxHsEPrJ7sQT",
      "type": "text",
      "x": 897,
      "y": 1700.5,
      "width": 780.1600000000001,
      "height": 40,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "zi5v4ISxXBWlznUleZvt"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1605777939,
      "version": 2,
      "versionNonce": 303551683,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794253553495,
      "link": null,
      "locked": false,
      "text": "C'est quoi : un décès ou une radiation est souvent saisi des mois après : les chiffres d'une\nannée dépendent du jour où la base a été copiée.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "C'est quoi : un décès ou une radiation est souvent saisi des mois après : les chiffres d'une\nannée dépendent du jour où la base a été copiée.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "ai"
    },
    {
      "id": "baXpLcOkAWRyd5uVzdLU",
      "type": "text",
      "x": 897,
      "y": 1748.5,
      "width": 743.6800000000001,
      "height": 60,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "zi5v4ISxXBWlznUleZvt"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 2028206695,
      "version": 2,
      "versionNonce": 462359789,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794253553495,
      "link": null,
      "locked": false,
      "text": "Dans la base : INDIVIDU, IND_DATE_DECES donne la date du décès, pas celle de sa\ndéclaration. On s'en approche par la dernière modification de la pension\n(PRESTATION_ESP, PE_DATE_UPDATE).",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Dans la base : INDIVIDU, IND_DATE_DECES donne la date du décès, pas celle de sa\ndéclaration. On s'en approche par la dernière modification de la pension\n(PRESTATION_ESP, PE_DATE_UPDATE).",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "aj"
    },
    {
      "id": "eZ5oBUEqWpcHg7ZU6Dj9",
      "type": "text",
      "x": 897,
      "y": 1816.5,
      "width": 777.44,
      "height": 40,
      "angle": 0,
      "strokeColor": "#1e1e1e",
