    {
      "id": "VurfN3jHfLcxiOVq8XxN",
      "type": "text",
      "x": 1755,
      "y": 11006.5,
      "width": 801.9200000000001,
      "height": 60,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
