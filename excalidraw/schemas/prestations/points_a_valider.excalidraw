      "isDeleted": false,
      "boundElements": [],
      "updated": 1794253553496,
      "link": null,
      "locked": false,
      "text": "La date de décaissement",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "La date de décaissement",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "bVS"
    },
    {
      "id": "icxanIstgrEj7eUVFSVg",
      "type": "text",
      "x": 1755,
      "y": 22128.5,
      "width": 632.6400000000001,
      "height": 20,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "vLmKnCSfOKnkBYEQaIGZ"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 343048493,
      "version": 2,
      "versionNonce": 1990655469,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794253553496,
      "link": null,
      "locked": false,
      "text": "C'est quoi : le décaissement est le jour où l'argent est réellement versé.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "C'est quoi : le décaissement est le jour où l'argent est réellement versé.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "bVT"
    },
    {
      "id": "xWsyEhfYRTLxcHOD2UQ3",
      "type": "text",
      "x": 1755,
      "y": 22156.5,
      "width": 753.6,
      "height": 60,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "vLmKnCSfOKnkBYEQaIGZ"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1696195319,
      "version": 2,
      "versionNonce": 1774314339,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794253553496,
      "link": null,
      "locked": false,
      "text": "Dans la base : DEBOURS, DEB_DATE_DECAISSEMENT, et EFFET,\nEFP_DATE_DECAISSEMENT. Seuls des paiements au statut D l'ont ; ceux au statut P\njamais.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Dans la base : DEBOURS, DEB_DATE_DECAISSEMENT, et EFFET,\nEFP_DATE_DECAISSEMENT. Seuls des paiements au statut D l'ont ; ceux au statut P\njamais.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "bVU"
    },
    {
      "id": "VJ8rUt62lSkXkKqY5GoY",
      "type": "text",
      "x": 1755,
      "y": 22224.5,
      "width": 624.96,
      "height": 20,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "vLmKnCSfOKnkBYEQaIGZ"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1029837888,
      "version": 2,
      "versionNonce": 1984608333,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794253553496,
      "link": null,
      "locked": false,
      "text": "Aujourd'hui : on ne s'en sert pas : un paiement compte au mois qu'il paie.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Aujourd'hui : on ne s'en sert pas : un paiement compte au mois qu'il paie.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "bVV"
    },
    {
      "id": "sn2nsOCaRSc2OH2WwtY5",
      "type": "text",
      "x": 1755,
      "y": 22252.5,
      "width": 794.4000000000001,
      "height": 80,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "vLmKnCSfOKnkBYEQaIGZ"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 2105465706,
      "version": 2,
      "versionNonce": 1930788611,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794253553496,
      "link": null,
      "locked": false,
      "text": "Chiffre : elle manque pour 80 % des paiements des prestations familiales et 43 % de ceux de\nvieillesse de 2025. Là où elle existe, elle colle parfois mieux : en 2024, les indemnités\njournalières d'accident du travail font 60,8 M au versement, plus près des 65,4 M de\nl'annuaire CNSS 2024 que la date de saisie.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Chiffre : elle manque pour 80 % des paiements des prestations familiales et 43 % de ceux de\nvieillesse de 2025. Là où elle existe, elle colle parfois mieux : en 2024, les indemnités\njournalières d'accident du travail font 60,8 M au versement, plus près des 65,4 M de\nl'annuaire CNSS 2024 que la date de saisie.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "bVW"
    },
    {
      "id": "pREnwrAo1FpjIKp1Owlw",
      "type": "text",
      "x": 1755,
      "y": 22340.5,
      "width": 101.76,
      "height": 20,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
