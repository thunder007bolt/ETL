      "version": 2,
      "versionNonce": 61725763,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794253553496,
      "link": null,
      "locked": false,
      "text": "Aujourd'hui : on prend la notification des droits (PE_DATE_NOTIFICATION), en\nattendant.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Aujourd'hui : on prend la notification des droits (PE_DATE_NOTIFICATION), en\nattendant.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "bYA"
    },
