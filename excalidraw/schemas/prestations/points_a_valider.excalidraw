    },
    {
      "id": "qOQzy7RidkTh3cmswUIZ",
      "type": "text",
      "x": 1755.0,
      "y": 1856.5,
      "width": 790.4000000000001,
      "height": 40.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "kkvNSFZKsxAsxVQIFpPp"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 258010547,
      "version": 1,
      "versionNonce": 868818753,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793571984644,
      "link": null,
      "locked": false,
      "text": "C'est quoi : l'ayant droit est la personne qui a droit à la prestation ; ce n'est pas toujours\ncelle qui est payée. Pour un orphelin, c'est son tuteur qui est payé.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "C'est quoi : l'ayant droit est la personne qui a droit à la prestation ; ce n'est pas toujours\ncelle qui est payée. Pour un orphelin, c'est son tuteur qui est payé.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "v5b1I2EkxetCZ31PsozU",
      "type": "text",
      "x": 1755.0,
      "y": 1904.5,
      "width": 794.24,
      "height": 40.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "kkvNSFZKsxAsxVQIFpPp"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1326635032,
      "version": 1,
      "versionNonce": 876572980,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793571984644,
      "link": null,
      "locked": false,
      "text": "Dans la base : on compte l'ayant droit (PRESTATION_ESP, IND_ID_PREST), une fois par\ntableau. Pour T41, l'allocataire est le dossier, comme décidé à Kaya en 2017.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Dans la base : on compte l'ayant droit (PRESTATION_ESP, IND_ID_PREST), une fois par\ntableau. Pour T41, l'allocataire est le dossier, comme décidé à Kaya en 2017.",
      "autoResize": true,
      "lineHeight": 1.25
    },
