    {
      "id": "ZRo7SClk7TjfeIEsFxCL",
      "type": "text",
      "x": 979.005657708628,
      "y": 14752.5,
      "width": 440,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "zbqqcdgMI1WuDUNMu6e4"
      ],
