      "versionNonce": 1142172077,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794253553496,
      "link": null,
      "locked": false,
      "text": "Question : le taux de prestations indues est-il suivi par la DCR, ou par la DAI ?",
