      "versionNonce": 1908589456,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794218137525,
      "link": null,
      "locked": false,
      "text": "Aujourd'hui : T55 compte les deux codes : la réponse aide seulement à lire le tableau.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Aujourd'hui : T55 compte les deux codes : la réponse aide seulement à lire le tableau.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
