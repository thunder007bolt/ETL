      "updated": 1794218137525,
      "link": null,
      "locked": false,
      "text": "L'allocation prénatale de l'épouse (T55)",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "L'allocation prénatale de l'épouse (T55)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "xvqQnr4OKrbO4m37lQsj",
      "type": "text",
      "x": 897.0,
      "y": 20136.5,
      "width": 760.6400000000001,
      "height": 40.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "zwkWT9T0MM8xAGNeTziR"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1678743085,
      "version": 1,
      "versionNonce": 493587224,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794218137525,
      "link": null,
      "locked": false,
      "text": "C'est quoi : l'allocation prénatale va à la salariée enceinte, ou à l'épouse enceinte d'un\nsalarié. L'épouse non salariée n'a pas droit à l'indemnité de maternité.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "C'est quoi : l'allocation prénatale va à la salariée enceinte, ou à l'épouse enceinte d'un\nsalarié. L'épouse non salariée n'a pas droit à l'indemnité de maternité.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "ytMEhwOcsdVLP1amRh5h",
      "type": "text",
      "x": 897.0,
      "y": 20184.5,
      "width": 627.2,
      "height": 20.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "zwkWT9T0MM8xAGNeTziR"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 856859454,
      "version": 1,
      "versionNonce": 1169062418,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794218137525,
      "link": null,
      "locked": false,
      "text": "Dans la base : les codes MAP et FAP (PRESTATION_ESP, TPE_CODE).",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Dans la base : les codes MAP et FAP (PRESTATION_ESP, TPE_CODE).",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "Ra8j2chVfnO2jTmqXa6q",
      "type": "text",
      "x": 897.0,
      "y": 20212.5,
      "width": 741.7600000000001,
      "height": 20.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
