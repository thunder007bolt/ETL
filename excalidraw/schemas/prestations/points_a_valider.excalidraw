    {
      "id": "Qq8NHhnpD72UuHBT0m0D",
      "type": "text",
      "x": 960.2220650636492,
      "y": 12856.5,
      "width": 255.60000000000002,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
