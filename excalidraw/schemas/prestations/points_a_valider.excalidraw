      "link": null,
      "locked": false,
      "text": "Chiffre : l'annuaire CNSS 2024 fait pareil : ses 11,18 Md de prestations familiales de\n2024 comprennent la maternité.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Chiffre : l'annuaire CNSS 2024 fait pareil : ses 11,18 Md de prestations familiales de\n2024 comprennent la maternité.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b2S"
    },
