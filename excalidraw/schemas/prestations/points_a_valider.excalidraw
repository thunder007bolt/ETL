      "isDeleted": false,
      "boundElements": [],
      "updated": 1794218137525,
      "link": null,
      "locked": false,
      "text": "Aujourd'hui : il ne compte pas comme un dossier liquidé de T26. Pour T56, voir le point 52.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Aujourd'hui : il ne compte pas comme un dossier liquidé de T26. Pour T56, voir le point 52.",
