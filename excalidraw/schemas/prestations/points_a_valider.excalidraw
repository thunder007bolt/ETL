      "text": "La date de validation (T27)",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "La date de validation (T27)",
      "autoResize": true,
      "lineHeight": 1.25,
