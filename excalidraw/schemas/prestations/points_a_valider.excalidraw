      "version": 1,
      "versionNonce": 1474474840,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794218137525,
      "link": null,
      "locked": false,
      "text": "Chiffre : sans les enfants ajoutés, 8 246 allocations familiales liquidées en 2025 ; avec\neux, environ 16 400.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Chiffre : sans les enfants ajoutés, 8 246 allocations familiales liquidées en 2025 ; avec\neux, environ 16 400.",
      "autoResize": true,
      "lineHeight": 1.25
    },
