    },
    {
      "id": "2jBN5iQbslyxUuV6VS79",
      "type": "text",
      "x": 897,
      "y": 15264.5,
      "width": 782.24,
      "height": 60,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
