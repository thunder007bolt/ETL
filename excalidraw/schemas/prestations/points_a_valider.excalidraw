      "seed": 186942300,
      "version": 2,
      "versionNonce": 98861187,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794253553496,
      "link": null,
      "locked": false,
      "text": "Question : si le titulaire du dossier est décédé et que ses enfants touchent encore,\nl'allocataire de T41 est-il le titulaire décédé, ou la personne qui touche les allocations\npour les enfants ?",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Question : si le titulaire du dossier est décédé et que ses enfants touchent encore,\nl'allocataire de T41 est-il le titulaire décédé, ou la personne qui touche les allocations\npour les enfants ?",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "bGw"
    },
