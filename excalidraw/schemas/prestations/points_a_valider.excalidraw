    },
    {
      "id": "wWsUwNHDX4LTKk6eYA46",
      "type": "text",
      "x": 39,
      "y": 24912.5,
      "width": 789.9200000000001,
      "height": 40,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "6wkxE1zKvu3f7naBwDbv"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1759330522,
      "version": 2,
      "versionNonce": 1504356931,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794253553496,
      "link": null,
      "locked": false,
      "text": "C'est quoi : une catégorie de dossier, à côté de celles de la coordination, qu'on lit comme «\ndossier transféré à une autre caisse », qui le gère alors.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "C'est quoi : une catégorie de dossier, à côté de celles de la coordination, qu'on lit comme «\ndossier transféré à une autre caisse », qui le gère alors.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "bZi"
    },
    {
      "id": "jw5CX5i7F7jnkrBnBH5R",
      "type": "text",
      "x": 39,
      "y": 24960.5,
      "width": 497.12,
      "height": 20,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "6wkxE1zKvu3f7naBwDbv"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 274513271,
      "version": 2,
      "versionNonce": 1801342829,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794253553496,
      "link": null,
      "locked": false,
      "text": "Dans la base : DOSSIER, DOS_CATEGORIE = CNSS_AC.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Dans la base : DOSSIER, DOS_CATEGORIE = CNSS_AC.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "bZj"
    },
    {
      "id": "raGFrcpycQycqHmIVMcI",
      "type": "text",
      "x": 39,
      "y": 24988.5,
      "width": 770.88,
      "height": 40,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "6wkxE1zKvu3f7naBwDbv"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1547486008,
      "version": 2,
      "versionNonce": 1006791139,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794253553496,
      "link": null,
      "locked": false,
      "text": "Aujourd'hui : ces dossiers sont retirés de T25 à T27. Les pensions au 31/12 les gardent\nencore : ce choix est posé à la DCP (voir le point 101).",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Aujourd'hui : ces dossiers sont retirés de T25 à T27. Les pensions au 31/12 les gardent\nencore : ce choix est posé à la DCP (voir le point 101).",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "bZk"
    },
    {
      "id": "K6eFHWlSqND4TnShGjuq",
