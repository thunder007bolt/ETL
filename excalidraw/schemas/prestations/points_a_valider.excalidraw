      "isDeleted": false,
      "boundElements": [],
      "updated": 1794253553495,
      "link": null,
      "locked": false,
      "text": "Question : les débours aux autres statuts (A, I, N, S, V) ne sont jamais des paiements versés\n?",
      "fontSize": 16,
      "fontFamily": 5,
