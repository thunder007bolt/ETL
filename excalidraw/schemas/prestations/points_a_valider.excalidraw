      "seed": 301478114,
      "version": 1,
      "versionNonce": 2100817820,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794218137525,
      "link": null,
      "locked": false,
      "text": "Dans la base : PRESTATION_ESP, codes RPV, RPRA, RPI, et le salaire moyen de chaque\npension (PE_SAL_MOYEN), jamais étudié (voir le point 133).",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Dans la base : PRESTATION_ESP, codes RPV, RPRA, RPI, et le salaire moyen de chaque\npension (PE_SAL_MOYEN), jamais étudié (voir le point 133).",
      "autoResize": true,
      "lineHeight": 1.25
    },
