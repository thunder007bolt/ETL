      "versionNonce": 1972776033,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794218137525,
      "link": null,
      "locked": false,
      "text": "Chiffre : en 2024, 454 rentiers orphelins de moins de 25 ans, 531 sans limite d'âge.\nL'annuaire CNSS 2024 compte autrement : 485, entre les deux. De 2021 à 2023, ses\nchiffres sont sous les nôtres, comme avec une limite plus basse.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Chiffre : en 2024, 454 rentiers orphelins de moins de 25 ans, 531 sans limite d'âge.\nL'annuaire CNSS 2024 compte autrement : 485, entre les deux. De 2021 à 2023, ses\nchiffres sont sous les nôtres, comme avec une limite plus basse.",
      "autoResize": true,
      "lineHeight": 1.25
    },
