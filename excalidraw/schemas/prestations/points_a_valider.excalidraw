    },
    {
      "id": "xL8CFt3yeGy3Sm1cFW2r",
      "type": "text",
      "x": 1755,
      "y": 6598.5,
      "width": 785.6,
      "height": 40,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "xkvDi06RCrLcpP7tgTSK"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1631823704,
      "version": 2,
      "versionNonce": 1267817197,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794253553496,
      "link": null,
      "locked": false,
      "text": "C'est quoi : le dépôt d'un dossier, c'est sa réception au guichet. L'atelier de Kaya en 2017\ndemandait de ne plus recevoir de dossiers incomplets.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "C'est quoi : le dépôt d'un dossier, c'est sa réception au guichet. L'atelier de Kaya en 2017\ndemandait de ne plus recevoir de dossiers incomplets.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b6R"
    },
    {
      "id": "AiTSHUhx5C2a55ppXIcr",
      "type": "text",
      "x": 1755,
      "y": 6646.5,
      "width": 756.48,
      "height": 20,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "xkvDi06RCrLcpP7tgTSK"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1073367745,
      "version": 2,
      "versionNonce": 1962399331,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794253553496,
      "link": null,
      "locked": false,
      "text": "Dans la base : la date de réception (RECEPTION_DOSSIER, RD_DATE_RECEPTION).",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Dans la base : la date de réception (RECEPTION_DOSSIER, RD_DATE_RECEPTION).",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b6S"
    },
    {
      "id": "t8G6yBJgBVWnQVrvmDpU",
      "type": "text",
      "x": 1755,
      "y": 6674.5,
      "width": 788.1600000000001,
      "height": 40,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
