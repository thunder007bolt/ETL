      "lineHeight": 1.25,
      "index": "bQg"
    },
    {
      "id": "xVmWKP2l5ef41wiQ5lq1",
      "type": "text",
      "x": 1755,
      "y": 19148.5,
      "width": 739.2,
      "height": 40,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "ky4kP603tBJ7azSZNFDc"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 682506264,
      "version": 2,
      "versionNonce": 1699997293,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794253553496,
      "link": null,
      "locked": false,
      "text": "C'est quoi : T57 compte, par année et par branche, les assurés décédés. Le recueil des\nbesoins veut un filtre « assuré ou ayant droit ».",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "C'est quoi : T57 compte, par année et par branche, les assurés décédés. Le recueil des\nbesoins veut un filtre « assuré ou ayant droit ».",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "bQh"
    },
    {
      "id": "J4OOaVhw0wFlysMf0nkj",
      "type": "text",
      "x": 1755,
      "y": 19196.5,
      "width": 783.36,
      "height": 60,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "ky4kP603tBJ7azSZNFDc"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 266697316,
      "version": 2,
      "versionNonce": 924173027,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794253553496,
      "link": null,
      "locked": false,
      "text": "Dans la base : la date du décès (INDIVIDU, IND_DATE_DECES) et, en vieillesse, les\ntitulaires d'une pension directe en cours (PRESTATION_ESP, RPV, RPRA, RPI) ; avec le\nfiltre « ayant droit », aussi RPSV, RPSF, RPSE et RPA.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Dans la base : la date du décès (INDIVIDU, IND_DATE_DECES) et, en vieillesse, les\ntitulaires d'une pension directe en cours (PRESTATION_ESP, RPV, RPRA, RPI) ; avec le\nfiltre « ayant droit », aussi RPSV, RPSF, RPSE et RPA.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "bQi"
    },
    {
      "id": "WCpl2kZ2wN6R82tTezup",
      "type": "text",
