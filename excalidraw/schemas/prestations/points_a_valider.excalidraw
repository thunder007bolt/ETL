      "version": 1,
      "versionNonce": 13037286,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793571984644,
      "link": null,
      "locked": false,
      "text": "C'est quoi : un enfant peut avoir droit à l'allocation au 31/12 sans avoir rien touché dans\nl'année (un certificat attendu, par exemple).",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "C'est quoi : un enfant peut avoir droit à l'allocation au 31/12 sans avoir rien touché dans\nl'année (un certificat attendu, par exemple).",
      "autoResize": true,
      "lineHeight": 1.25
    },
