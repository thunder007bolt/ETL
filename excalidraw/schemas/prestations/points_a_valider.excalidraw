      "updated": 1794218137525,
      "link": null,
      "locked": false,
      "text": "Les accessoires de pension",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Les accessoires de pension",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "A0SL6iRZbQ3TMlUtNlwf",
      "type": "text",
      "x": 1755.0,
      "y": 4526.5,
      "width": 718.08,
      "height": 40.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "3qJgC9r6TLEiVwX6GWr9"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 728505503,
      "version": 1,
      "versionNonce": 1372893881,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794218137525,
      "link": null,
      "locked": false,
      "text": "C'est quoi : la bonification pour enfant à charge, les majorations pour enfant et la\ncontribution aux charges du ménage s'ajoutent à une pension.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "C'est quoi : la bonification pour enfant à charge, les majorations pour enfant et la\ncontribution aux charges du ménage s'ajoutent à une pension.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "ewQd2RJ6dQDMFZe9600D",
      "type": "text",
      "x": 1755.0,
      "y": 4574.5,
      "width": 639.68,
      "height": 20.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "3qJgC9r6TLEiVwX6GWr9"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 986998705,
      "version": 1,
      "versionNonce": 1667675459,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794218137525,
      "link": null,
      "locked": false,
      "text": "Dans la base : PRESTATION_ESP, codes RBEC, RME et RME-COL, RCCM.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Dans la base : PRESTATION_ESP, codes RBEC, RME et RME-COL, RCCM.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "aMNMOk31NxxdaP1uNFFL",
      "type": "text",
      "x": 1755.0,
      "y": 4602.5,
      "width": 794.24,
      "height": 40.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "3qJgC9r6TLEiVwX6GWr9"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 425044132,
      "version": 1,
      "versionNonce": 1831203400,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794218137525,
      "link": null,
      "locked": false,
      "text": "Aujourd'hui : elles ne font pas un pensionné de plus. Leur argent n'entre pas dans le montant\nde T32 ; il peut aller sur une ligne à part.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Aujourd'hui : elles ne font pas un pensionné de plus. Leur argent n'entre pas dans le montant\nde T32 ; il peut aller sur une ligne à part.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "cXMnD55OzTaJu6wdKzur",
      "type": "text",
      "x": 1755.0,
      "y": 4650.5,
      "width": 787.6800000000001,
      "height": 40.0,
