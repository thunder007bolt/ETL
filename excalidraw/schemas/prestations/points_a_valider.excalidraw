    {
      "id": "osuilKxZNC0AjUsRSkzp",
      "type": "text",
      "x": 976.9688826025459,
      "y": 15216.5,
      "width": 341.0,
      "height": 25.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
