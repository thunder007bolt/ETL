      "text": "La durée d'une rente (T26)",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "La durée d'une rente (T26)",
      "autoResize": true,
