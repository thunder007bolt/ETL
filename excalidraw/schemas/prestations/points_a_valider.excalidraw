    },
    {
      "id": "txWBFV5UJlw9jGFHvNky",
      "type": "text",
      "x": 897.0,
      "y": 4040.5,
      "width": 758.08,
      "height": 40.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "oLNugyMKspPz3kU3oQbp"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 942139138,
      "version": 1,
      "versionNonce": 186750234,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793571984644,
      "link": null,
      "locked": false,
      "text": "C'est quoi : après un accident du travail, l'employeur le déclare. Il s'ensuit, ou non, un\narrêt payé en indemnités journalières, des soins, puis une rente.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "C'est quoi : après un accident du travail, l'employeur le déclare. Il s'ensuit, ou non, un\narrêt payé en indemnités journalières, des soins, puis une rente.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "hbuLWT2NoYXBVFM1ORJx",
      "type": "text",
      "x": 897.0,
      "y": 4088.5,
      "width": 700.48,
      "height": 20.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "oLNugyMKspPz3kU3oQbp"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1432569915,
      "version": 1,
      "versionNonce": 1818690345,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793571984644,
      "link": null,
      "locked": false,
      "text": "Chiffre : environ 550 déclarations par an ne donnent ni arrêt, ni soins, ni rente.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Chiffre : environ 550 déclarations par an ne donnent ni arrêt, ni soins, ni rente.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "Jrf3RJTdBEUEVkzGNwtk",
      "type": "text",
      "x": 897.0,
      "y": 4116.5,
