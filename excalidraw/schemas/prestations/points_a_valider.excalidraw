      "text": "L'âge dans l'annuaire CNSS",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "L'âge dans l'annuaire CNSS",
      "autoResize": true,
