      "versionNonce": 292310921,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794218137525,
      "link": null,
      "locked": false,
      "text": "C'est quoi : selon le recueil des besoins, la colonne TOTAL de T28 à T30 additionne les\ncontrôles des quatre trimestres ; sa formule du taux compte des « dossiers contrôlés après\npaiement ».",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "C'est quoi : selon le recueil des besoins, la colonne TOTAL de T28 à T30 additionne les\ncontrôles des quatre trimestres ; sa formule du taux compte des « dossiers contrôlés après\npaiement ».",
      "autoResize": true,
      "lineHeight": 1.25
    },
