      "id": "kXLumaw0kPwyLZHRyCKL",
      "type": "text",
      "x": 39,
      "y": 3750.5,
      "width": 339.2,
      "height": 20,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
