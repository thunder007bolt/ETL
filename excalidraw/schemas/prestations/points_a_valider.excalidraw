    },
    {
      "id": "tENaPlAd2wvq5ene2lmd",
      "type": "text",
      "x": 1755,
      "y": 9524.5,
      "width": 780.96,
      "height": 60,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "1tV81MjUBILXgsuyvQgd"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 513139640,
      "version": 2,
      "versionNonce": 1160582979,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794253553496,
      "link": null,
      "locked": false,
      "text": "C'est quoi : selon le recueil des besoins, la colonne TOTAL de T28 à T30 additionne les\ncontrôles des quatre trimestres ; sa formule du taux compte des « dossiers contrôlés après\npaiement ».",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "C'est quoi : selon le recueil des besoins, la colonne TOTAL de T28 à T30 additionne les\ncontrôles des quatre trimestres ; sa formule du taux compte des « dossiers contrôlés après\npaiement ».",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "bBC"
    },
    {
      "id": "u1BBWfp3olqoGcj1CCyL",
      "type": "text",
      "x": 1755,
      "y": 9592.5,
      "width": 803.84,
      "height": 40,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "1tV81MjUBILXgsuyvQgd"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1687489659,
      "version": 2,
      "versionNonce": 1095053933,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794253553496,
      "link": null,
      "locked": false,
      "text": "Aujourd'hui : un dossier contrôlé le 12/02/2025 puis le 20/10/2025 compte deux fois dans\nla colonne TOTAL, une seule fois dans le taux de l'année.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Aujourd'hui : un dossier contrôlé le 12/02/2025 puis le 20/10/2025 compte deux fois dans\nla colonne TOTAL, une seule fois dans le taux de l'année.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "bBD"
    },
