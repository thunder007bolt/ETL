    {
      "id": "AS2uJgpo3vaoh3yld7pj",
      "type": "text",
      "x": 39,
      "y": 13388.5,
      "width": 594.24,
      "height": 20,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
