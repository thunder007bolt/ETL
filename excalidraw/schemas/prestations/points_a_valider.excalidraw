      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "rersngZSanIJcqKDvp6n"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1448215698,
      "version": 2,
      "versionNonce": 1520489901,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794253553496,
      "link": null,
      "locked": false,
      "text": "C'est quoi : l'indemnité journalière remplace le salaire pendant l'arrêt de travail qui suit\nun accident.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "C'est quoi : l'indemnité journalière remplace le salaire pendant l'arrêt de travail qui suit\nun accident.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b83"
    },
    {
      "id": "2TOMJbtYL3wkSy0Jw0U1",
      "type": "text",
      "x": 1755,
      "y": 7654.5,
      "width": 721.2800000000001,
      "height": 20,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "rersngZSanIJcqKDvp6n"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 145687032,
      "version": 2,
      "versionNonce": 1019373475,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794253553496,
      "link": null,
      "locked": false,
      "text": "Dans la base : ni la reprise du travail, ni le certificat de guérison ne sont saisis.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Dans la base : ni la reprise du travail, ni le certificat de guérison ne sont saisis.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b84"
    },
    {
      "id": "r4b0dmZ6k086e57f9k0Z",
      "type": "text",
      "x": 1755,
      "y": 7682.5,
      "width": 756.1600000000001,
      "height": 40,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "rersngZSanIJcqKDvp6n"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1745316241,
      "version": 2,
      "versionNonce": 884185101,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794253553496,
      "link": null,
      "locked": false,
      "text": "Aujourd'hui : la durée de liquidation est comptée depuis la déclaration de l'accident et\npubliée telle quelle.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Aujourd'hui : la durée de liquidation est comptée depuis la déclaration de l'accident et\npubliée telle quelle.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b85"
    },
    {
