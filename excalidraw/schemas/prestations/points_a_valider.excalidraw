    {
      "id": "0mamQflHTlLPRMYNYEEN",
      "type": "text",
      "x": 960.2220650636492,
      "y": 4954.5,
      "width": 393.2,
      "height": 25.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
