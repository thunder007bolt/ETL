      "updated": 1794218137525,
      "link": null,
      "locked": false,
      "text": "Question : pouvez-vous nous donner la liste des libellés de ces statuts ?",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Question : pouvez-vous nous donner la liste des libellés de ces statuts ?",
