      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "JiuJheE80uFupdWFdJli"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 2027577706,
      "version": 1,
      "versionNonce": 1860057143,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794218137525,
      "link": null,
      "locked": false,
      "text": "Dans la base : DOSSIERS_CONTROLES a une colonne pour le code de la prestation\ncontrôlée ; on ne sait pas encore si elle est remplie.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Dans la base : DOSSIERS_CONTROLES a une colonne pour le code de la prestation\ncontrôlée ; on ne sait pas encore si elle est remplie.",
      "autoResize": true,
      "lineHeight": 1.25
    },
