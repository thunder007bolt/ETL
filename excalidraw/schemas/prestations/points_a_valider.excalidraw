    },
    {
      "id": "DHER7mrIy4pR6sinmRaJ",
      "type": "text",
      "x": 39.0,
      "y": 14336.5,
      "width": 786.5600000000001,
      "height": 60.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "jg9joq53OJTo6roW4wN5"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 550019309,
      "version": 1,
      "versionNonce": 201622174,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794218137525,
      "link": null,
      "locked": false,
      "text": "C'est quoi : la part du dernier salaire que la pension remplace : la pension divisée par le\nsalaire moyen des cinq meilleures années, selon le recueil des besoins de la CNSS. Il vise\nles pensions directes.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "C'est quoi : la part du dernier salaire que la pension remplace : la pension divisée par le\nsalaire moyen des cinq meilleures années, selon le recueil des besoins de la CNSS. Il vise\nles pensions directes.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "K4qq91I742Tnn4Le1Xou",
      "type": "text",
      "x": 39.0,
      "y": 14404.5,
      "width": 770.88,
      "height": 40.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "jg9joq53OJTo6roW4wN5"
      ],
