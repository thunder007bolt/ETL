    },
    {
      "id": "Bvx9QahqSj3Vxn9hx6zW",
      "type": "text",
      "x": 39,
      "y": 11994.5,
      "width": 785.9200000000001,
      "height": 40,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "qRM0zKfIwwfOPsYwe5z4"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1982120947,
      "version": 2,
      "versionNonce": 267220579,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794253553496,
      "link": null,
      "locked": false,
      "text": "C'est quoi : le recueil des besoins demande les taux d'indus par type de prestation (pension\nde vieillesse, allocation familiale…).",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
