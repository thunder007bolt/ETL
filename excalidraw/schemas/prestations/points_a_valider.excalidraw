      "isDeleted": false,
      "boundElements": [],
      "updated": 1794218137525,
      "link": null,
      "locked": false,
      "text": "Aujourd'hui : comptés comme les autres trop-perçus, dans la colonne des pensions.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Aujourd'hui : comptés comme les autres trop-perçus, dans la colonne des pensions.",
      "autoResize": true,
      "lineHeight": 1.25
    },
