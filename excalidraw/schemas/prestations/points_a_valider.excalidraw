      "boundElements": [],
      "updated": 1794218137525,
      "link": null,
      "locked": false,
      "text": "C'est quoi : les mois de travail cotisés à la CNSS, additionnés pour les services passés de\nT42 et T50.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "C'est quoi : les mois de travail cotisés à la CNSS, additionnés pour les services passés de\nT42 et T50.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "4U52F1PIGizT2eA5SJS2",
      "type": "text",
      "x": 897.0,
      "y": 22660.5,
      "width": 800.0,
      "height": 40.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
