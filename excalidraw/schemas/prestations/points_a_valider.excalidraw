    {
      "id": "H82U6d7bIO13OqtfR9la",
      "type": "text",
      "x": 1818.2220650636493,
      "y": 12856.5,
      "width": 302,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "odxtfcHSeBcs5UxJSZTD"
      ],
