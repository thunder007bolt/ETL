      "versionNonce": 1738802620,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794218137525,
      "link": null,
      "locked": false,
      "text": "Question : par quel circuit passent les paiements au statut P : virement, téléphone mobile,\nou un autre ?",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Question : par quel circuit passent les paiements au statut P : virement, téléphone mobile,\nou un autre ?",
