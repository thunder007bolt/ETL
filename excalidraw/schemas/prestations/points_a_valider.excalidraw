    {
      "id": "r5LhCw43MHzTNkE2fBKD",
      "type": "text",
      "x": 1755.0,
      "y": 10008.5,
      "width": 804.32,
      "height": 60.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
