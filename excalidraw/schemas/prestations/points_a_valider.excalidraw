    },
    {
      "id": "B8FAsHzMtxHsEPrJ7sQT",
      "type": "text",
      "x": 897.0,
      "y": 1700.5,
      "width": 780.1600000000001,
      "height": 40.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "zi5v4ISxXBWlznUleZvt"
      ],
