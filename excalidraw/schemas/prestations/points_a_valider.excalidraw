      "boundElements": [],
      "updated": 1793571984644,
      "link": null,
      "locked": false,
      "text": "Chiffre : depuis la demande au guichet, une rente est liquidée en 14 jours (médiane) ; depuis\nla réception du certificat de consolidation, en 64 jours, comme le dit Kaya 2017.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Chiffre : depuis la demande au guichet, une rente est liquidée en 14 jours (médiane) ; depuis\nla réception du certificat de consolidation, en 64 jours, comme le dit Kaya 2017.",
      "autoResize": true,
      "lineHeight": 1.25
    },
