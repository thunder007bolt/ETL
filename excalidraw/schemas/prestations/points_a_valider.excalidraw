      "boundElements": [],
      "updated": 1793571984644,
      "link": null,
      "locked": false,
      "text": "Dans la base : chaque prestation a un code (TPE_CODE), par exemple RPV pour une pension de\nvieillesse. La liste des codes de chaque tableau est à la fin du document.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Dans la base : chaque prestation a un code (TPE_CODE), par exemple RPV pour une pension de\nvieillesse. La liste des codes de chaque tableau est à la fin du document.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
