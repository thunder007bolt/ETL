    {
      "id": "SLDcirhq8wNNwtmaeSnV",
      "type": "text",
      "x": 962.2588401697312,
      "y": 2760.5,
      "width": 278.40000000000003,
      "height": 25.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
