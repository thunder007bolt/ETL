      "versionNonce": 1539354420,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794218137525,
      "link": null,
      "locked": false,
      "text": "Chiffre : en 2024, 11 rachats pour 21,5 M dans la base ; l'annuaire CNSS 2024 en publie\n25,4 M (tableaux 90, 96 et 97), un écart pas encore expliqué.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Chiffre : en 2024, 11 rachats pour 21,5 M dans la base ; l'annuaire CNSS 2024 en publie\n25,4 M (tableaux 90, 96 et 97), un écart pas encore expliqué.",
      "autoResize": true,
      "lineHeight": 1.25
    },
