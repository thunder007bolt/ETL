      "roundness": null,
      "seed": 287571501,
      "version": 1,
      "versionNonce": 1510896556,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794218137525,
      "link": null,
      "locked": false,
      "text": "Chiffre : nouveaux retraités saisis en 2024, révisions comprises : 2,86 Md payés pour les\nmois de 2024 ; le rappel saisi en 2024, 0,23 Md, vaut 8 % de ce montant.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
