      "type": "text",
      "x": 39.0,
      "y": 2350.5,
      "width": 455.04,
      "height": 20.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
