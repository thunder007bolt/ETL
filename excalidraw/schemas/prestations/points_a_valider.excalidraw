      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "8riL8Qq9LO0EqePMU4J2",
      "type": "text",
      "x": 39.0,
      "y": 16746.5,
      "width": 799.0400000000001,
      "height": 40.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "dlgKObOiwuFaXasvezQS"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 2138048833,
      "version": 1,
      "versionNonce": 2017359821,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794218137525,
      "link": null,
      "locked": false,
      "text": "C'est quoi : la CNSS peut verser toute une pension de coordination, puis se faire rembourser\nla part de l'autre caisse. Le montant de T42 serait alors trop haut.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "C'est quoi : la CNSS peut verser toute une pension de coordination, puis se faire rembourser\nla part de l'autre caisse. Le montant de T42 serait alors trop haut.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "Ycck2Xy2jQqpxX8tv7wS",
