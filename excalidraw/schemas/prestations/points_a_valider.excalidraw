    {
      "id": "71XXCBiV35DpScJYJhnz",
      "type": "text",
      "x": 1820.2588401697312,
      "y": 7558.5,
      "width": 481.80000000000007,
      "height": 25.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
