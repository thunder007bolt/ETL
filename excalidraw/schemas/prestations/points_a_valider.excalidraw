      "boundElements": [],
      "updated": 1793571984644,
      "link": null,
      "locked": false,
      "text": "C'est quoi : le premier paiement d'un nouveau retraité couvre souvent des mois d'avant\nl'année.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "C'est quoi : le premier paiement d'un nouveau retraité couvre souvent des mois d'avant\nl'année.",
      "autoResize": true,
      "lineHeight": 1.25
    },
