      "isDeleted": false,
      "boundElements": [],
      "updated": 1794218137525,
      "link": null,
      "locked": false,
      "text": "Question : quand DEB_DATE_DECAISSEMENT est vide, où la base garde-t-elle le jour du\nversement ?",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Question : quand DEB_DATE_DECAISSEMENT est vide, où la base garde-t-elle le jour du\nversement ?",
