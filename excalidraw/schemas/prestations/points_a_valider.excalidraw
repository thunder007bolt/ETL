      "versionNonce": 1255581710,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794218137525,
      "link": null,
      "locked": false,
      "text": "Question : les sommes versées par un ajustement (rappels de moins-perçus, avances)\nsont-elles des prestations payées ?",
