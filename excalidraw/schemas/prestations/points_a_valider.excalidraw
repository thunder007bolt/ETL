      "roundness": null,
      "seed": 380579444,
      "version": 1,
      "versionNonce": 1741010309,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794218137525,
      "link": null,
      "locked": false,
      "text": "À qui : DAI, avec la DCP",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "À qui : DAI, avec la DCP",
      "autoResize": true,
