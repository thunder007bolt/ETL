      "seed": 1532553106,
      "version": 1,
      "versionNonce": 1459738968,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794218137525,
      "link": null,
      "locked": false,
      "text": "Dans la base : la catégorie du dossier (DOSSIER, DOS_CATEGORIE) vaut COOR_AC : 3\n326 dossiers, dont 76 % reçus au guichet de la CNSS. Les dossiers transférés à une autre\ncaisse (CNSS_AC, sens à confirmer) sont écartés.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Dans la base : la catégorie du dossier (DOSSIER, DOS_CATEGORIE) vaut COOR_AC : 3\n326 dossiers, dont 76 % reçus au guichet de la CNSS. Les dossiers transférés à une autre\ncaisse (CNSS_AC, sens à confirmer) sont écartés.",
      "autoResize": true,
      "lineHeight": 1.25
    },
