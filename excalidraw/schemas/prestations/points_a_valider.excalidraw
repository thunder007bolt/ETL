      "type": "text",
      "x": 897,
      "y": 2426.5,
      "width": 804.8000000000001,
      "height": 40,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
