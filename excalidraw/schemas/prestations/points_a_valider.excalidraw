      "seed": 830723699,
      "version": 2,
      "versionNonce": 262131725,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794253553496,
      "link": null,
      "locked": false,
      "text": "C'est quoi : pour le taux de remplacement (voir le point 98), le recueil des besoins prend le\nsalaire moyen des cinq meilleures années.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "C'est quoi : pour le taux de remplacement (voir le point 98), le recueil des besoins prend le\nsalaire moyen des cinq meilleures années.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "bYv"
    },
    {
      "id": "DcbpSDRYWLG9Hd8sg9FS",
      "type": "text",
      "x": 39,
      "y": 24516.5,
      "width": 591.04,
      "height": 20,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "ZQZwYh1FmfY7uT9Z3ehl"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1960818906,
      "version": 2,
      "versionNonce": 386843459,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794253553496,
      "link": null,
      "locked": false,
      "text": "Dans la base : PRESTATION_ESP, PE_SAL_MOYEN, jamais étudié.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Dans la base : PRESTATION_ESP, PE_SAL_MOYEN, jamais étudié.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "bYw"
    },
    {
      "id": "ZBHtBz9guynBVgW1M58p",
      "type": "text",
