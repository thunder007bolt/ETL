    {
      "id": "stpbz2JHWDRJYNlnGuPZ",
      "type": "text",
      "x": 960.2220650636492,
      "y": 22080.5,
      "width": 267.20000000000005,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
