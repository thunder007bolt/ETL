      "versionNonce": 1297553320,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794218137525,
      "link": null,
      "locked": false,
      "text": "Chiffre : fin 2025, 34 pensions de vieillesse dans ce cas (2 payées par la CNSS) et 79\npensions de veuve ou de veuf.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Chiffre : fin 2025, 34 pensions de vieillesse dans ce cas (2 payées par la CNSS) et 79\npensions de veuve ou de veuf.",
      "autoResize": true,
      "lineHeight": 1.25
    },
