    {
      "id": "oEXQFamyOyfIcefLXLxS",
      "type": "text",
      "x": 960.2220650636492,
      "y": 23492.5,
      "width": 362,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
