      "boundElements": [],
      "updated": 1793570031210,
      "link": null,
      "locked": false,
      "text": "T57 : seulement les titulaires d'une pension directe (Kaya), ou tous les\npensionnés décédés ? À la date du décès ou à celle de sa déclaration ? Un\nsinistré est-il une victime morte de son accident ? L'annuaire publie 89\ndécès d'ascendants pour 59 pensions d'ascendant en cours.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "T57 : seulement les titulaires d'une pension directe (Kaya), ou tous les\npensionnés décédés ? À la date du décès ou à celle de sa déclaration ? Un\nsinistré est-il une victime morte de son accident ? L'annuaire publie 89\ndécès d'ascendants pour 59 pensions d'ascendant en cours.",
      "autoResize": true,
      "lineHeight": 1.25
    },
