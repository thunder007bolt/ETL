    },
    {
      "id": "oPIShdeDPzYP7nHLnFx1",
      "type": "text",
      "x": 897.0,
      "y": 2176.5,
      "width": 589.44,
      "height": 20.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
