    },
    {
      "id": "ABILDqv86FoR7N254QkD",
      "type": "text",
      "x": 897.0,
      "y": 2536.5,
      "width": 803.52,
      "height": 120.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "tulLhrHHI0KCWZHq8ffP"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1092751190,
      "version": 1,
      "versionNonce": 1205628258,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793571984644,
      "link": null,
      "locked": false,
      "text": "Dans la base : un dossier est déposé le jour de sa réception au guichet\n(RD_DATE_RECEPTION) ; liquidé à la première notification des droits\n(PE_DATE_NOTIFICATION) ; en instance s'il n'est ni liquidé ni rejeté au 31/12 ; rejeté\ns'il est dans DOSSIER_REJETE. La durée de liquidation va de la réception à la\nnotification, en trois tranches : moins de 15 jours, de 15 à 45, plus de 45 (norme : 45\njours).",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Dans la base : un dossier est déposé le jour de sa réception au guichet\n(RD_DATE_RECEPTION) ; liquidé à la première notification des droits\n(PE_DATE_NOTIFICATION) ; en instance s'il n'est ni liquidé ni rejeté au 31/12 ; rejeté\ns'il est dans DOSSIER_REJETE. La durée de liquidation va de la réception à la\nnotification, en trois tranches : moins de 15 jours, de 15 à 45, plus de 45 (norme : 45\njours).",
      "autoResize": true,
      "lineHeight": 1.25
    },
