    {
      "id": "DLe6uJxbSXQ34Ua6Jeu8",
      "type": "text",
      "x": 102.22206506364921,
      "y": 23492.5,
      "width": 233.60000000000002,
      "height": 25.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
