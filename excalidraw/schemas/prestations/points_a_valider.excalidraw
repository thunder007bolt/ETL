      "seed": 1511323030,
      "version": 2,
      "versionNonce": 1873174797,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794253553495,
      "link": null,
      "locked": false,
      "text": "Question : pouvez-vous nous donner vos contrôles des cinq dernières années, un par ligne, sous\ncette forme ?",
