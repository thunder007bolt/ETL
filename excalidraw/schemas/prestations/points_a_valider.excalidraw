      "updated": 1794218137525,
      "link": null,
      "locked": false,
      "text": "Aujourd'hui : on ne compte que les allocataires : avec le filtre « ayant droit », la colonne\ndes prestations familiales reste vide.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Aujourd'hui : on ne compte que les allocataires : avec le filtre « ayant droit », la colonne\ndes prestations familiales reste vide.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "5bhNGVwQO2RE20Nd5QA6",
      "type": "text",
      "x": 1755.0,
      "y": 20320.5,
      "width": 781.2800000000001,
      "height": 60.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
