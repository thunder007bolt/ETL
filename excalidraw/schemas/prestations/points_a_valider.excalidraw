      "isDeleted": false,
      "boundElements": [],
      "updated": 1794218137525,
      "link": null,
      "locked": false,
      "text": "Chiffre : en 2024, 684 trop-perçus pour 229,5 M, et 414,4 M de moins-perçus.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Chiffre : en 2024, 684 trop-perçus pour 229,5 M, et 414,4 M de moins-perçus.",
      "autoResize": true,
      "lineHeight": 1.25
    },
