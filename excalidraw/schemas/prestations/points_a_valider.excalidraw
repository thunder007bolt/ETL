      "seed": 1596704134,
      "version": 2,
      "versionNonce": 1283913731,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794253553496,
      "link": null,
      "locked": false,
      "text": "Question : la réversion compte-t-elle comme une demande à part, qu'elle soit dans un nouveau\ndossier ou dans celui du défunt ?",
