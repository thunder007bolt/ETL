      "type": "text",
      "x": 897.0,
      "y": 24216.5,
      "width": 791.6800000000001,
      "height": 40.0,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "dY2vnV0byRcE4ACkDare"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1600536512,
      "version": 1,
      "versionNonce": 429062865,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794218137525,
      "link": null,
      "locked": false,
