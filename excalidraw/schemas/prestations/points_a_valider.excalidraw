      "id": "uZoYu3tQaTGYzp54Ah0z",
      "type": "text",
      "x": 1755,
      "y": 17354.5,
      "width": 791.5200000000001,
      "height": 40,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
