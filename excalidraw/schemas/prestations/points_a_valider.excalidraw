      "frameId": null,
      "roundness": null,
      "seed": 1244445403,
      "version": 2,
      "versionNonce": 645447341,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794253553495,
      "link": null,
      "locked": false,
      "text": "Aujourd'hui : rien, la vue est seulement proposée.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Aujourd'hui : rien, la vue est seulement proposée.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b0Z"
    },
    {
