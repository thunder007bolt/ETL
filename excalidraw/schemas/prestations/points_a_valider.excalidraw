      "seed": 1903404407,
      "version": 1,
      "versionNonce": 495434137,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794218137525,
      "link": null,
      "locked": false,
      "text": "Chiffre : fin 2024, 87 pensions de retraite anticipée en cours dans la base (le nombre de\npersonnes reste à mesurer). L'annuaire CNSS 2024 fait pareil : il publie à part ses 78\nretraités en retraite anticipée.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Chiffre : fin 2024, 87 pensions de retraite anticipée en cours dans la base (le nombre de\npersonnes reste à mesurer). L'annuaire CNSS 2024 fait pareil : il publie à part ses 78\nretraités en retraite anticipée.",
      "autoResize": true,
      "lineHeight": 1.25
    },
