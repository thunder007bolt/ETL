      "versionNonce": 324683383,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794218137525,
      "link": null,
      "locked": false,
      "text": "C'est quoi : le dépôt d'un dossier, c'est sa réception au guichet. L'atelier de Kaya en 2017\ndemandait de ne plus recevoir de dossiers incomplets.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "C'est quoi : le dépôt d'un dossier, c'est sa réception au guichet. L'atelier de Kaya en 2017\ndemandait de ne plus recevoir de dossiers incomplets.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "AiTSHUhx5C2a55ppXIcr",
      "type": "text",
      "x": 1755.0,
      "y": 6646.5,
      "width": 756.48,
      "height": 20.0,
