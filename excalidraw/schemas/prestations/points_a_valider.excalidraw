    {
      "id": "E2xTk1023sLH18EM2fO7",
      "type": "text",
      "x": 1818.2220650636493,
      "y": 13824.5,
      "width": 474.40000000000003,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
