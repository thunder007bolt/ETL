      "versionNonce": 268350541,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794253553496,
      "link": null,
      "locked": false,
      "text": "Dans la base : PRESTATION_ESP, codes ARSV et ARSF, en cours à la date d'arrêté.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Dans la base : PRESTATION_ESP, codes ARSV et ARSF, en cours à la date d'arrêté.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "bK9"
    },
    {
      "id": "tOGgPSsnle48xb2rfzcT",
      "type": "text",
      "x": 1755,
      "y": 14896.5,
      "width": 738.24,
      "height": 20,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
