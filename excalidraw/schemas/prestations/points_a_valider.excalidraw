      "isDeleted": false,
      "boundElements": [],
      "updated": 1794218137525,
      "link": null,
      "locked": false,
      "text": "Dans la base : la date de réception (RECEPTION_DOSSIER, RD_DATE_RECEPTION).",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Dans la base : la date de réception (RECEPTION_DOSSIER, RD_DATE_RECEPTION).",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
