      "roundness": null,
      "seed": 2094100101,
      "version": 1,
      "versionNonce": 33502815,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794218137525,
      "link": null,
      "locked": false,
      "text": "Dans la base : AJUSTEMENT, TAJ_CODE = TP ou TP-CONV, par date d'établissement\n(AJ_DATE_ETABLISSEMENT).",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Dans la base : AJUSTEMENT, TAJ_CODE = TP ou TP-CONV, par date d'établissement\n(AJ_DATE_ETABLISSEMENT).",
      "autoResize": true,
      "lineHeight": 1.25
    },
