    {
      "id": "fZcRph6bDqik9rBQ6kmE",
      "type": "text",
      "x": 1834.968882602546,
      "y": 21056.5,
      "width": 479.6,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
