    {
      "id": "PNlppNbQJ37423u8Wcr3",
      "type": "text",
      "x": 1834.968882602546,
      "y": 15770.5,
      "width": 322,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
