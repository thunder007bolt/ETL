      "link": null,
      "locked": false,
      "text": "Le résultat d'un contrôle",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Le résultat d'un contrôle",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "zCirYnl523Xz3BKAPxbz",
      "type": "text",
      "x": 897.0,
      "y": 9040.5,
      "width": 784.32,
      "height": 40.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "mQiq3DGe2RSBHnfTTZ8n"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 600050414,
      "version": 1,
      "versionNonce": 1685851260,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794218137525,
      "link": null,
      "locked": false,
      "text": "C'est quoi : un contrôle peut finir conforme, trouver une anomalie, ou être encore en cours.\nLe résultat sert à relier les contrôles aux indus.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "C'est quoi : un contrôle peut finir conforme, trouver une anomalie, ou être encore en cours.\nLe résultat sert à relier les contrôles aux indus.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "hOeqIQdoFxkSm3ZG7OhN",
      "type": "text",
      "x": 897.0,
      "y": 9088.5,
      "width": 634.5600000000001,
      "height": 20.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
