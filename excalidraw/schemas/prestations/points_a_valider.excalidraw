    },
    {
      "id": "LaGa7ltry0JAiSIddbiS",
      "type": "text",
      "x": 1755.0,
      "y": 17210.5,
      "width": 773.76,
      "height": 40.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "luctJsTwlmTEPpVaCzXz"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1185405394,
      "version": 1,
      "versionNonce": 928212002,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794218137525,
      "link": null,
      "locked": false,
      "text": "C'est quoi : un ascendant est le père ou la mère d'une victime décédée. Le titre de T47 ne\nnomme pas la branche, mais « crédirentier » veut dire rente, donc accident du travail.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "C'est quoi : un ascendant est le père ou la mère d'une victime décédée. Le titre de T47 ne\nnomme pas la branche, mais « crédirentier » veut dire rente, donc accident du travail.",
      "autoResize": true,
      "lineHeight": 1.25
    },
