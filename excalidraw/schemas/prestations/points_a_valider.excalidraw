      "boundElements": [],
      "updated": 1793571984644,
      "link": null,
      "locked": false,
      "text": "Chiffre : le tableau 25 de l'annuaire compte 527 femmes parmi les nouveaux retraités de\n2024, la base 641. Âge par âge les chiffres se décalent, mais les tranches de 5 ans\nretombent.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Chiffre : le tableau 25 de l'annuaire compte 527 femmes parmi les nouveaux retraités de\n2024, la base 641. Âge par âge les chiffres se décalent, mais les tranches de 5 ans\nretombent.",
      "autoResize": true,
      "lineHeight": 1.25
