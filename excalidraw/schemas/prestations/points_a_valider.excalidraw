    },
    {
      "id": "F41hg50bu08RLiXCie8d",
      "type": "text",
      "x": 1755.0,
      "y": 11994.5,
      "width": 791.0400000000001,
      "height": 60.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "ZRxkpLnuujkmM4mjkgRz"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 88355915,
      "version": 1,
      "versionNonce": 250477339,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794218137525,
      "link": null,
      "locked": false,
      "text": "C'est quoi : le recueil des besoins range le taux de prestations indues avec les indicateurs\ndes prestations et avec ceux du recouvrement, suivis par la DCR. L'atelier de Kaya en 2017\nle rangeait déjà sous le recouvrement.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "C'est quoi : le recueil des besoins range le taux de prestations indues avec les indicateurs\ndes prestations et avec ceux du recouvrement, suivis par la DCR. L'atelier de Kaya en 2017\nle rangeait déjà sous le recouvrement.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "OFWFUYpTMon8qiWf0KnK",
      "type": "text",
      "x": 1755.0,
      "y": 12062.5,
      "width": 442.24,
      "height": 20.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "ZRxkpLnuujkmM4mjkgRz"
