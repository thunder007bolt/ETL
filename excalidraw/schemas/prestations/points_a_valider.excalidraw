      "seed": 1680092345,
      "version": 2,
      "versionNonce": 2019438211,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794253553496,
      "link": null,
      "locked": false,
      "text": "Question : un contrôle compte-t-il dans le taux quel que soit son résultat, même s'il est\nencore en cours ?",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Question : un contrôle compte-t-il dans le taux quel que soit son résultat, même s'il est\nencore en cours ?",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "bAE"
    },
