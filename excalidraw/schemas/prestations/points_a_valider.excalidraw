      "seed": 1466031657,
      "version": 1,
      "versionNonce": 2047496306,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794218137525,
      "link": null,
      "locked": false,
      "text": "Question : une déclaration d'accident qui n'a donné ni arrêt, ni soins, ni rente compte-t-elle\ncomme un dossier déposé, en attente de traitement ?",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
