    {
      "id": "3GP1ubEQdihpIZCLXMla",
      "type": "text",
      "x": 897.0,
      "y": 15818.5,
      "width": 774.24,
      "height": 40.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "bwUu1mxpuGkAI1BsJkcz"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 394332263,
      "version": 1,
      "versionNonce": 1896510779,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794218137525,
      "link": null,
      "locked": false,
      "text": "C'est quoi : les tableaux par âge de l'annuaire CNSS (19, 25 et 36) ne disent pas comment\nl'âge est calculé.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "C'est quoi : les tableaux par âge de l'annuaire CNSS (19, 25 et 36) ne disent pas comment\nl'âge est calculé.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "lD12iYOuRAfg8y3i9gJN",
      "type": "text",
      "x": 897.0,
      "y": 15866.5,
      "width": 654.4,
      "height": 20.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
