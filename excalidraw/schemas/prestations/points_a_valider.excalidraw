    {
      "id": "gx85E46mGs7cwALrHouj",
      "type": "text",
      "x": 102.22206506364921,
      "y": 23028.5,
      "width": 297.6,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
