      "versionNonce": 420575907,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794253553496,
      "link": null,
      "locked": false,
      "text": "Aujourd'hui : une rente de survivant part de la demande du survivant au guichet, avec le\ncertificat de décès.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Aujourd'hui : une rente de survivant part de la demande du survivant au guichet, avec le\ncertificat de décès.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b7o"
    },
    {
      "id": "801crsmaQQA4vR2QzI3U",
