      "isDeleted": false,
      "boundElements": [],
      "updated": 1794218137525,
      "link": null,
      "locked": false,
      "text": "La catégorie CNSS_AC",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "La catégorie CNSS_AC",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "wWsUwNHDX4LTKk6eYA46",
      "type": "text",
      "x": 39.0,
      "y": 24912.5,
      "width": 789.9200000000001,
      "height": 40.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "6wkxE1zKvu3f7naBwDbv"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1759330522,
      "version": 1,
      "versionNonce": 492688064,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794218137525,
      "link": null,
      "locked": false,
      "text": "C'est quoi : une catégorie de dossier, à côté de celles de la coordination, qu'on lit comme «\ndossier transféré à une autre caisse », qui le gère alors.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "C'est quoi : une catégorie de dossier, à côté de celles de la coordination, qu'on lit comme «\ndossier transféré à une autre caisse », qui le gère alors.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "jw5CX5i7F7jnkrBnBH5R",
      "type": "text",
      "x": 39.0,
      "y": 24960.5,
      "width": 497.12,
      "height": 20.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "6wkxE1zKvu3f7naBwDbv"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 274513271,
      "version": 1,
      "versionNonce": 1699961510,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794218137525,
      "link": null,
      "locked": false,
      "text": "Dans la base : DOSSIER, DOS_CATEGORIE = CNSS_AC.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Dans la base : DOSSIER, DOS_CATEGORIE = CNSS_AC.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "raGFrcpycQycqHmIVMcI",
      "type": "text",
      "x": 39.0,
      "y": 24988.5,
      "width": 770.88,
      "height": 40.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "6wkxE1zKvu3f7naBwDbv"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1547486008,
      "version": 1,
      "versionNonce": 1674005415,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794218137525,
      "link": null,
      "locked": false,
      "text": "Aujourd'hui : ces dossiers sont retirés de T25 à T27. Les pensions au 31/12 les gardent\nencore : ce choix est posé à la DCP (voir le point 101).",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Aujourd'hui : ces dossiers sont retirés de T25 à T27. Les pensions au 31/12 les gardent\nencore : ce choix est posé à la DCP (voir le point 101).",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "K6eFHWlSqND4TnShGjuq",
      "type": "text",
      "x": 39.0,
      "y": 25036.5,
      "width": 747.84,
      "height": 40.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "6wkxE1zKvu3f7naBwDbv"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 202377615,
      "version": 1,
      "versionNonce": 1544464052,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794218137525,
      "link": null,
      "locked": false,
      "text": "Chiffre : fin 2025, 34 pensions de vieillesse (T32, dont 2 payées par la CNSS) et 79\npensions de veuves et de veufs (T34) sont dans des dossiers CNSS_AC.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Chiffre : fin 2025, 34 pensions de vieillesse (T32, dont 2 payées par la CNSS) et 79\npensions de veuves et de veufs (T34) sont dans des dossiers CNSS_AC.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "HOzAmq9fuoyPKrOgUjt4",
      "type": "text",
      "x": 39.0,
      "y": 25084.5,
      "width": 101.76,
      "height": 20.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "6wkxE1zKvu3f7naBwDbv"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 513230043,
      "version": 1,
      "versionNonce": 1672794058,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794218137525,
      "link": null,
      "locked": false,
      "text": "À qui : DSI",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "À qui : DSI",
      "autoResize": true,
      "lineHeight": 1.25
    },
