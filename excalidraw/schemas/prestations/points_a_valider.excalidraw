      "isDeleted": false,
      "boundElements": [],
      "updated": 1794253553496,
      "link": null,
      "locked": false,
      "text": "C'est quoi : l'allocation prénatale est versée à une future mère pendant sa grossesse.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "C'est quoi : l'allocation prénatale est versée à une future mère pendant sa grossesse.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "bHP"
    },
    {
      "id": "z34zzSsLHy2oh3AedsNm",
      "type": "text",
      "x": 897,
      "y": 13416.5,
      "width": 799.6800000000001,
      "height": 40,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
