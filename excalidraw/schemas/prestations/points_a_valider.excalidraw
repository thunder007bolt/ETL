      "lineHeight": 1.25,
      "index": "b96"
    },
    {
      "id": "VA1oG6Bdvz5BJM4gfQ0i",
      "type": "text",
      "x": 39,
      "y": 8526.5,
      "width": 790.88,
      "height": 40,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "1FmVO4mXuNYI7ba0X1TC"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1447719763,
      "version": 2,
      "versionNonce": 32973837,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794253553496,
      "link": null,
      "locked": false,
      "text": "C'est quoi : l'annuaire CNSS 2024 ne publie aucun chiffre de dossiers déposés. Son tableau\n27, « départs à la retraite », pourrait en être un.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "C'est quoi : l'annuaire CNSS 2024 ne publie aucun chiffre de dossiers déposés. Son tableau\n27, « départs à la retraite », pourrait en être un.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b97"
    },
    {
      "id": "RuWeoSd85VR87yLLJqCA",
      "type": "text",
      "x": 39,
      "y": 8574.5,
      "width": 805.44,
      "height": 40,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "1FmVO4mXuNYI7ba0X1TC"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1179436044,
      "version": 2,
      "versionNonce": 394702659,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794253553496,
      "link": null,
      "locked": false,
      "text": "Aujourd'hui : on n'en tire rien, mais on y comparera les demandes de pension directe reçues en\n2024, sans l'allocation de vieillesse.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Aujourd'hui : on n'en tire rien, mais on y comparera les demandes de pension directe reçues en\n2024, sans l'allocation de vieillesse.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b98"
    },
    {
      "id": "vrlDLlYVc60MknXJ1k93",
      "type": "text",
      "x": 39,
      "y": 8622.5,
      "width": 802.08,
      "height": 40,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "1FmVO4mXuNYI7ba0X1TC"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1170952647,
      "version": 2,
      "versionNonce": 217127533,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794253553496,
      "link": null,
      "locked": false,
      "text": "Chiffre : 3 729 départs publiés en 2024, soit 12,3 % de plus que les 3 322 entrées publiées\n(nouveaux retraités et allocations de vieillesse).",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Chiffre : 3 729 départs publiés en 2024, soit 12,3 % de plus que les 3 322 entrées publiées\n(nouveaux retraités et allocations de vieillesse).",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b99"
    },
