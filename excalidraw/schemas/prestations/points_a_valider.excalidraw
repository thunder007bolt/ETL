      "isDeleted": false,
      "boundElements": [],
      "updated": 1793571984644,
      "link": null,
      "locked": false,
      "text": "Chiffre : depuis 2023, nos veuves (T34) et nos orphelins (T35) restent sous l'annuaire,\nalors que la vieillesse retombe juste.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Chiffre : depuis 2023, nos veuves (T34) et nos orphelins (T35) restent sous l'annuaire,\nalors que la vieillesse retombe juste.",
      "autoResize": true,
      "lineHeight": 1.25
    },
