      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "mQiq3DGe2RSBHnfTTZ8n"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 2004129611,
      "version": 1,
      "versionNonce": 384545873,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794218137525,
      "link": null,
      "locked": false,
      "text": "Aujourd'hui : tout contrôle enregistré compte, quel que soit son résultat.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Aujourd'hui : tout contrôle enregistré compte, quel que soit son résultat.",
      "autoResize": true,
      "lineHeight": 1.25
    },
