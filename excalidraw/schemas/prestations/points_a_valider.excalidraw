    },
    {
      "id": "bo5mKIPj9gtAf9D5CYOs",
      "type": "text",
      "x": 39.0,
      "y": 10762.5,
      "width": 783.2,
      "height": 20.0,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
