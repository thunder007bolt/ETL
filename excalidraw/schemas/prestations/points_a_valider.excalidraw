      "boundElements": [],
      "updated": 1794218137525,
      "link": null,
      "locked": false,
      "text": "Dans la base : les paiements : DEBOURS, DEB_TYPE = PM, DEB_STATUT D ou P, montant\nDEB_MONTANT.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Dans la base : les paiements : DEBOURS, DEB_TYPE = PM, DEB_STATUT D ou P, montant\nDEB_MONTANT.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "TLTcyzfxgQ67BcNN9MpQ",
      "type": "text",
      "x": 897.0,
      "y": 12536.5,
      "width": 798.4000000000001,
      "height": 40.0,
