      "version": 1,
      "versionNonce": 2092435602,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794218137525,
      "link": null,
      "locked": false,
      "text": "Aujourd'hui : on compte le dossier payé dans la période.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Aujourd'hui : on compte le dossier payé dans la période.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "9eXwAfkm8GTeaOMTXVvl",
      "type": "text",
      "x": 39.0,
      "y": 9688.5,
      "width": 772.8000000000001,
      "height": 40.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "34YHburP26TpNxkQUtM3"
      ],
