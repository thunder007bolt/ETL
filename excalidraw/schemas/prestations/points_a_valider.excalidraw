    {
      "id": "uHQIj3uQ61GhUtnnuGDq",
      "type": "text",
      "x": 102.22206506364921,
      "y": 8992.5,
      "width": 250,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
