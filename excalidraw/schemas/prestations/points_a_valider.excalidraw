    },
    {
      "id": "eXkLodbevkUeffwFlprO",
      "type": "text",
      "x": 39,
      "y": 20660.5,
      "width": 804.48,
      "height": 60,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "aoMs4rq4F6klpXlTDCF2"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1231905802,
      "version": 2,
      "versionNonce": 1923921549,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794253553496,
      "link": null,
      "locked": false,
      "text": "C'est quoi : le recueil des besoins remplace la colonne « Autres » de T57 par un TOTAL des\nbranches. Une même personne peut être dans deux branches : par exemple un retraité qui touche\nencore des allocations familiales.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "C'est quoi : le recueil des besoins remplace la colonne « Autres » de T57 par un TOTAL des\nbranches. Une même personne peut être dans deux branches : par exemple un retraité qui touche\nencore des allocations familiales.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "bSb"
    },
    {
      "id": "dsgYFMGKtwSXM2Nw0QJa",
      "type": "text",
      "x": 39,
      "y": 20728.5,
      "width": 747.84,
      "height": 20,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "aoMs4rq4F6klpXlTDCF2"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1420771199,
      "version": 2,
      "versionNonce": 1686734019,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794253553496,
      "link": null,
      "locked": false,
      "text": "Aujourd'hui : le TOTAL est la somme des branches : cette personne y compte deux fois.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Aujourd'hui : le TOTAL est la somme des branches : cette personne y compte deux fois.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "bSc"
    },
