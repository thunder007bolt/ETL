      "versionNonce": 2094239555,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794253553496,
      "link": null,
      "locked": false,
      "text": "Chiffre : l'annuaire CNSS 2024 en publie 25,0 M payés en 2024 (tableaux 40 et 41).",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Chiffre : l'annuaire CNSS 2024 en publie 25,0 M payés en 2024 (tableaux 40 et 41).",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "bXu"
    },
