      "roundness": null,
      "seed": 78113968,
      "version": 2,
      "versionNonce": 23163235,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794253553495,
      "link": null,
      "locked": false,
      "text": "Dans la base : la table DOSSIERS_CONTROLES n'a que 1 542 lignes en tout, la dernière\nsaisie le 09/07/2025.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Dans la base : la table DOSSIERS_CONTROLES n'a que 1 542 lignes en tout, la dernière\nsaisie le 09/07/2025.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b00"
    },
    {
      "id": "gmlwnLpMTEMGoCl5rzl6",
      "type": "text",
      "x": 1755,
      "y": 1836.5,
      "width": 802.5600000000001,
      "height": 40,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "mVKxZyIj1LKllfWD42sZ"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1626727169,
      "version": 2,
      "versionNonce": 1421019725,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794253553495,
      "link": null,
      "locked": false,
      "text": "Aujourd'hui : T28 à T30 ne sont pas produits. Une vue avec une ligne par contrôle, à remplir\ndepuis cette table ou les fichiers de la DAI, est proposée à la DSI (voir le point 70).",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Aujourd'hui : T28 à T30 ne sont pas produits. Une vue avec une ligne par contrôle, à remplir\ndepuis cette table ou les fichiers de la DAI, est proposée à la DSI (voir le point 70).",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b01"
    },
    {
      "id": "tOJ80JE2qF4z69vQJX9f",
      "type": "text",
      "x": 1755,
      "y": 1884.5,
      "width": 782.24,
      "height": 40,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "mVKxZyIj1LKllfWD42sZ"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1036404567,
      "version": 2,
      "versionNonce": 1267944707,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794253553495,
      "link": null,
      "locked": false,
      "text": "Chiffre : en 2025, 115 contrôles notés (jusqu'au 9 juillet) pour 155 206 dossiers qui ont\nreçu au moins un débours (DEBOURS) dans l'année, soit 0,07 %.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Chiffre : en 2025, 115 contrôles notés (jusqu'au 9 juillet) pour 155 206 dossiers qui ont\nreçu au moins un débours (DEBOURS) dans l'année, soit 0,07 %.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b02"
    },
