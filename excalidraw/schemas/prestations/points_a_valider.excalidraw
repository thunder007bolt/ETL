    },
    {
      "id": "r5LhCw43MHzTNkE2fBKD",
      "type": "text",
      "x": 1755,
      "y": 10008.5,
      "width": 804.32,
      "height": 60,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "t6VFbLDO9V4nBwCJ3OpU"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1958478963,
      "version": 2,
      "versionNonce": 2081226307,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794253553496,
      "link": null,
      "locked": false,
      "text": "C'est quoi : la dernière ligne de T30 s'appelle « Autres prestations de la branche ». Pour la\nmême ligne de T27, le recueil des besoins demande « Frais médicaux de maternité » ; il ne\ndit rien pour T30.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "C'est quoi : la dernière ligne de T30 s'appelle « Autres prestations de la branche ». Pour la\nmême ligne de T27, le recueil des besoins demande « Frais médicaux de maternité » ; il ne\ndit rien pour T30.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "bBy"
    },
    {
      "id": "bdtrAdMt1YIcfU9flcZQ",
      "type": "text",
      "x": 1755,
      "y": 10076.5,
      "width": 792,
      "height": 40,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "t6VFbLDO9V4nBwCJ3OpU"
      ],
