      "versionNonce": 1802943203,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794253553496,
      "link": null,
      "locked": false,
      "text": "Question : le décès d'une veuve pensionnée, ou l'arrêt de sa pension, est-il souvent saisi\nplusieurs mois après les faits ?",
      "fontSize": 16,
