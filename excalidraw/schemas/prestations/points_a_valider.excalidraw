      "versionNonce": 1005539149,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793571984644,
      "link": null,
      "locked": false,
      "text": "Chiffre : fin 2025, 2 901 pensions de vieillesse sont payées par une autre caisse\n(COOR_AC) : la CNSS ne leur verse rien. Les garder dans la pension moyenne la fait baisser\nde près de 9 %.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Chiffre : fin 2025, 2 901 pensions de vieillesse sont payées par une autre caisse\n(COOR_AC) : la CNSS ne leur verse rien. Les garder dans la pension moyenne la fait baisser\nde près de 9 %.",
      "autoResize": true,
      "lineHeight": 1.25
    },
