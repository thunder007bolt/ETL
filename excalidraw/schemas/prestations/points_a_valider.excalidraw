      "isDeleted": false,
      "boundElements": [],
      "updated": 1794218137525,
      "link": null,
      "locked": false,
      "text": "Question : un assuré mort en activité, dont le décès ouvre une pension ou une allocation de\nsurvivants, compte-t-il dans T57 ?",
