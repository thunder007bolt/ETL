      "versionNonce": 962853276,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794218137525,
      "link": null,
      "locked": false,
      "text": "Question : votre nombre d'orphelins de fin 2024 compte-t-il des orphelins qui ne sont pas\nparmi vos 769 nouveaux orphelins de 2024 ?",
