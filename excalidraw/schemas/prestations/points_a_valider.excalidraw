      "link": null,
      "locked": false,
      "text": "Les années passées d'un tableau",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Les années passées d'un tableau",
