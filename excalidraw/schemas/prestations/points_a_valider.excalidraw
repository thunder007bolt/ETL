    {
      "id": "JlPYOOh0JLAQEskfhKBW",
      "type": "text",
      "x": 1755,
      "y": 17666.5,
      "width": 794.24,
      "height": 60,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
