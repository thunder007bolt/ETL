      "isDeleted": false,
      "boundElements": [],
      "updated": 1794218137525,
      "link": null,
      "locked": false,
      "text": "Dans la base : aucun soin remboursé (DEBOURS, DEB_TYPE = RB) en 2024 sur les dossiers\nde maternité (TDOS_CODE = M).",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Dans la base : aucun soin remboursé (DEBOURS, DEB_TYPE = RB) en 2024 sur les dossiers\nde maternité (TDOS_CODE = M).",
