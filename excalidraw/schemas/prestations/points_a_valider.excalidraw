      "isDeleted": false,
      "boundElements": [],
      "updated": 1794253553496,
      "link": null,
      "locked": false,
      "text": "Question : pour vos 44 nouvelles rentes viagères de 2024, une victime compte-t-elle l'année\noù sa première rente est saisie, notifiée, ou prend effet ?",
      "fontSize": 16,
      "fontFamily": 5,
