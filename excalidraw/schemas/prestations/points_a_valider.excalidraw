      "versionNonce": 764409869,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794253553496,
      "link": null,
      "locked": false,
      "text": "Aujourd'hui : on compte sur la copie de la base du 02/02/2026. Prendre la copie arrêtée fin\nmars de l'année suivante est proposé (voir le point 2).",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Aujourd'hui : on compte sur la copie de la base du 02/02/2026. Prendre la copie arrêtée fin\nmars de l'année suivante est proposé (voir le point 2).",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "bGL"
    },
