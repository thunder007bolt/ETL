      "boundElements": [],
      "updated": 1794253553495,
      "link": null,
      "locked": false,
      "text": "À qui : DCP ; DES et DR pour T27",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "À qui : DCP ; DES et DR pour T27",
