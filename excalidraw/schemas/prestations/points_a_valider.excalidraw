      "type": "text",
      "x": 1755.0,
      "y": 6674.5,
      "width": 788.1600000000001,
      "height": 40.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "xkvDi06RCrLcpP7tgTSK"
      ],
