      "isDeleted": false,
      "boundElements": [],
      "updated": 1794218137525,
      "link": null,
      "locked": false,
      "text": "À qui : DP et DR, avec la DCP",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "À qui : DP et DR, avec la DCP",
      "autoResize": true,
      "lineHeight": 1.25
    },
