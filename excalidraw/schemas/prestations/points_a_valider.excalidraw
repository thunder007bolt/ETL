    {
      "id": "Iao9ugg4SdTRJ0SYbktH",
      "type": "text",
      "x": 1755.0,
      "y": 20660.5,
      "width": 790.88,
      "height": 40.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "sgDjG3dbnVSCuKwEfsPU"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1683761450,
      "version": 1,
      "versionNonce": 1892045577,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794218137525,
      "link": null,
      "locked": false,
      "text": "C'est quoi : T50 à T57 montrent l'année calculée et les quatre d'avant. En recalculant, les\nannées passées bougent, à cause des décès, radiations et rappels saisis tard.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "C'est quoi : T50 à T57 montrent l'année calculée et les quatre d'avant. En recalculant, les\nannées passées bougent, à cause des décès, radiations et rappels saisis tard.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "RVAkmvAWLsXyirATJRFA",
      "type": "text",
      "x": 1755.0,
      "y": 20708.5,
      "width": 781.12,
      "height": 20.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "sgDjG3dbnVSCuKwEfsPU"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1757746029,
      "version": 1,
      "versionNonce": 475273431,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794218137525,
      "link": null,
      "locked": false,
      "text": "Aujourd'hui : les quatre années passées sont recalculées sur la copie de la base du moment.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Aujourd'hui : les quatre années passées sont recalculées sur la copie de la base du moment.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "Hukpx1JrT3B215xkif1U",
      "type": "text",
      "x": 1755.0,
      "y": 20736.5,
      "width": 774.72,
      "height": 60.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "sgDjG3dbnVSCuKwEfsPU"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1144260832,
      "version": 1,
      "versionNonce": 1753513560,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794218137525,
      "link": null,
      "locked": false,
      "text": "Chiffre : indemnités de maternité de 2020 : 1,53 Md publiés dans l'annuaire CNSS 2024\n(tableau 35), 2,19 Md en recalculant sur la base d'aujourd'hui. L'annuaire signale parfois\nune année passée corrigée, avec une note (tableau 114).",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Chiffre : indemnités de maternité de 2020 : 1,53 Md publiés dans l'annuaire CNSS 2024\n(tableau 35), 2,19 Md en recalculant sur la base d'aujourd'hui. L'annuaire signale parfois\nune année passée corrigée, avec une note (tableau 114).",
      "autoResize": true,
      "lineHeight": 1.25
    },
