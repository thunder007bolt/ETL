      "isDeleted": false,
      "boundElements": [],
      "updated": 1794253553496,
      "link": null,
      "locked": false,
      "text": "Chiffre : 15 en 2024 pour 12,1 M ; 758 en 2025 pour 54,8 M.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Chiffre : 15 en 2024 pour 12,1 M ; 758 en 2025 pour 54,8 M.",
