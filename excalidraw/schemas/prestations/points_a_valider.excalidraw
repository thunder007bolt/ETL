      "seed": 1755591697,
      "version": 1,
      "versionNonce": 718770493,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794218137525,
      "link": null,
      "locked": false,
      "text": "C'est quoi : si la table des contrôles de l'application a un jour contenu tous les contrôles\nde la DAI, elle peut remplir T28 à T30 pour les années passées.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "C'est quoi : si la table des contrôles de l'application a un jour contenu tous les contrôles\nde la DAI, elle peut remplir T28 à T30 pour les années passées.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "Mjh70asR5xpWKx1klMJZ",
      "type": "text",
      "x": 39.0,
      "y": 2302.5,
      "width": 727.52,
      "height": 40.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "DLTfgockhBAXev60B7Gi"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 163791484,
      "version": 1,
      "versionNonce": 975711908,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794218137525,
      "link": null,
      "locked": false,
      "text": "Dans la base : la table DOSSIERS_CONTROLES a 1 542 lignes en tout, de 1 à 212\ncontrôles par an et par branche ; la dernière saisie date du 09/07/2025.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Dans la base : la table DOSSIERS_CONTROLES a 1 542 lignes en tout, de 1 à 212\ncontrôles par an et par branche ; la dernière saisie date du 09/07/2025.",
      "autoResize": true,
      "lineHeight": 1.25
    },
