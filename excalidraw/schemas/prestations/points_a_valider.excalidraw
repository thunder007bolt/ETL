      "versionNonce": 1119629837,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794253553496,
      "link": null,
      "locked": false,
      "text": "À qui : DCP pour les pensions ; DP et DR pour les rentes ; DES et DR pour T41",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "À qui : DCP pour les pensions ; DP et DR pour les rentes ; DES et DR pour T41",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "bFp"
    },
    {
