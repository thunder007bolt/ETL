    {
      "id": "tENaPlAd2wvq5ene2lmd",
      "type": "text",
      "x": 1755.0,
      "y": 9524.5,
      "width": 780.96,
      "height": 60.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
