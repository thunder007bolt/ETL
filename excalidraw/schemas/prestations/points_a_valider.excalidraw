    {
      "id": "C572oA5Q5LY9PvP0dB9Y",
      "type": "text",
      "x": 1755.0,
      "y": 15818.5,
      "width": 794.5600000000001,
      "height": 40.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "36Uc1Y4DNAR9njmIGOZ7"
      ],
