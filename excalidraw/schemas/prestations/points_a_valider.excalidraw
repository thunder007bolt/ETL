    {
      "id": "h3aOCayZsKUOakwGCz6x",
      "type": "text",
      "x": 897,
      "y": 21568.5,
      "width": 772.96,
      "height": 60,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
