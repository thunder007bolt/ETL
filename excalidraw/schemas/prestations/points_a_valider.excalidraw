    {
      "id": "k5S2RzfxEupQhQYNPHEQ",
      "type": "text",
      "x": 897.0,
      "y": 6374.5,
      "width": 782.08,
      "height": 40.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
