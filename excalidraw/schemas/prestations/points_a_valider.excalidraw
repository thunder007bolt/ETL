      "seed": 827901364,
      "version": 2,
      "versionNonce": 1622119811,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794253553496,
      "link": null,
      "locked": false,
      "text": "Dans la base : les pensions d'ascendant (PRESTATION_ESP, code RPA) et le décès de leur\ntitulaire (INDIVIDU, IND_DATE_DECES).",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Dans la base : les pensions d'ascendant (PRESTATION_ESP, code RPA) et le décès de leur\ntitulaire (INDIVIDU, IND_DATE_DECES).",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "bRW"
    },
    {
      "id": "Elrr1KdabMVQNeo8g0uG",
      "type": "text",
      "x": 1755,
      "y": 19700.5,
      "width": 796.8000000000001,
      "height": 20,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "2Dj2kVN01WC72h0mtFXY"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 392592112,
      "version": 2,
      "versionNonce": 1944107053,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794253553496,
      "link": null,
      "locked": false,
      "text": "Aujourd'hui : sans effet sur T57 : avec le filtre « assuré », les ascendants ne comptent pas.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Aujourd'hui : sans effet sur T57 : avec le filtre « assuré », les ascendants ne comptent pas.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "bRX"
    },
    {
      "id": "n4ats2lZCeU7P4Mfjuz4",
      "type": "text",
      "x": 1755,
      "y": 19728.5,
      "width": 789.44,
      "height": 60,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "2Dj2kVN01WC72h0mtFXY"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1517958170,
      "version": 2,
      "versionNonce": 1103621411,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794253553496,
      "link": null,
      "locked": false,
      "text": "Chiffre : l'annuaire CNSS 2024 publie 89 décès de pensionnés ascendants en 2024 (tableau\n26), alors qu'il compte 54 pensions d'ascendant fin 2023 et 7 nouvelles en 2024 (tableaux\n18 et 23).",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Chiffre : l'annuaire CNSS 2024 publie 89 décès de pensionnés ascendants en 2024 (tableau\n26), alors qu'il compte 54 pensions d'ascendant fin 2023 et 7 nouvelles en 2024 (tableaux\n18 et 23).",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "bRY"
    },
