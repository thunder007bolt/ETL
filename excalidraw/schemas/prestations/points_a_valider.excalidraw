      "link": null,
      "locked": false,
      "text": "C'est quoi : ce qui a été payé dans l'année en allocations familiales.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "C'est quoi : ce qui a été payé dans l'année en allocations familiales.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "NDVtG5txmh0siH1OdB5Z",
      "type": "text",
      "x": 39.0,
      "y": 13416.5,
      "width": 689.12,
      "height": 40.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
