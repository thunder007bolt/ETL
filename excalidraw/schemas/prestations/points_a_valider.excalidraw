    {
      "id": "u7c21j5dbUJ6tRTUFs2R",
      "type": "text",
      "x": 960.2220650636492,
      "y": 10494.5,
      "width": 345.6,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "5imckgJAiMJCKdTi1bgN"
      ],
