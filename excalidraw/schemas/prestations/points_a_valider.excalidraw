      "isDeleted": false,
      "boundElements": [],
      "updated": 1794253553496,
      "link": null,
      "locked": false,
      "text": "Le résultat d'un contrôle",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Le résultat d'un contrôle",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "bAA"
    },
    {
      "id": "zCirYnl523Xz3BKAPxbz",
      "type": "text",
      "x": 897,
      "y": 9040.5,
      "width": 784.32,
      "height": 40,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "mQiq3DGe2RSBHnfTTZ8n"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 600050414,
      "version": 2,
      "versionNonce": 1521690221,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794253553496,
      "link": null,
      "locked": false,
      "text": "C'est quoi : un contrôle peut finir conforme, trouver une anomalie, ou être encore en cours.\nLe résultat sert à relier les contrôles aux indus.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "C'est quoi : un contrôle peut finir conforme, trouver une anomalie, ou être encore en cours.\nLe résultat sert à relier les contrôles aux indus.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "bAB"
    },
    {
      "id": "hOeqIQdoFxkSm3ZG7OhN",
      "type": "text",
      "x": 897,
      "y": 9088.5,
      "width": 634.5600000000001,
      "height": 20,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "mQiq3DGe2RSBHnfTTZ8n"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 2004129611,
      "version": 2,
      "versionNonce": 977961699,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794253553496,
      "link": null,
      "locked": false,
      "text": "Aujourd'hui : tout contrôle enregistré compte, quel que soit son résultat.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Aujourd'hui : tout contrôle enregistré compte, quel que soit son résultat.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "bAC"
    },
    {
      "id": "4Bb49eNyjpbotjFUJvYd",
      "type": "text",
      "x": 897,
      "y": 9116.5,
      "width": 101.76,
      "height": 20,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "mQiq3DGe2RSBHnfTTZ8n"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 691009697,
      "version": 2,
      "versionNonce": 1203622093,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794253553496,
      "link": null,
      "locked": false,
      "text": "À qui : DAI",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "À qui : DAI",
      "autoResize": true,
