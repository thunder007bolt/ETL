      "versionNonce": 2085290046,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794218137525,
      "link": null,
      "locked": false,
      "text": "Question : T45 compte-t-il toutes les nouvelles rentes d'accident du travail, celles des\nvictimes et celles de leurs ayants droit ?",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Question : T45 compte-t-il toutes les nouvelles rentes d'accident du travail, celles des\nvictimes et celles de leurs ayants droit ?",
      "autoResize": true,
      "lineHeight": 1.25
    },
