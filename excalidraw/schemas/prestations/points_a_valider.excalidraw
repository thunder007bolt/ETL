      "isDeleted": false,
      "boundElements": [],
      "updated": 1794218137525,
      "link": null,
      "locked": false,
      "text": "Chiffre : pour T32 en 2024, 37,67 Md payés aux pensionnés comptés, 38,63 Md en tout.\nL'annuaire CNSS 2024 publie 38,24 Md, entre les deux.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Chiffre : pour T32 en 2024, 37,67 Md payés aux pensionnés comptés, 38,63 Md en tout.\nL'annuaire CNSS 2024 publie 38,24 Md, entre les deux.",
      "autoResize": true,
      "lineHeight": 1.25
    },
