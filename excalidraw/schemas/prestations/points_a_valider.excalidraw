      "text": "Le nouveau pensionné ou rentier",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Le nouveau pensionné ou rentier",
      "autoResize": true,
