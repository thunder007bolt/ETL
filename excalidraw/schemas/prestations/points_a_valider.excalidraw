      "frameId": null,
      "roundness": null,
      "seed": 1785184907,
      "version": 2,
      "versionNonce": 2075083523,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794253553496,
      "link": null,
      "locked": false,
      "text": "Aujourd'hui : un stock à la date d'arrêté, quelle que soit l'année de début de la rente.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Aujourd'hui : un stock à la date d'arrêté, quelle que soit l'année de début de la rente.",
