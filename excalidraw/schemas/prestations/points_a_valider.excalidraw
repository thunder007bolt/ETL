      "versionNonce": 305698185,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793571984644,
      "link": null,
      "locked": false,
      "text": "Question : on garde ce calcul, et 1900 est-elle bien une date par défaut ?",
      "fontSize": 16,
      "fontFamily": 5,
