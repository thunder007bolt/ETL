      "seed": 1384030941,
      "version": 1,
      "versionNonce": 1674817561,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794218137525,
      "link": null,
      "locked": false,
      "text": "Aujourd'hui : on s'appuie sur le recueil des besoins, l'atelier de Kaya en 2017, l'Annuaire\nCIPRES et l'annuaire CNSS 2024.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Aujourd'hui : on s'appuie sur le recueil des besoins, l'atelier de Kaya en 2017, l'Annuaire\nCIPRES et l'annuaire CNSS 2024.",
      "autoResize": true,
      "lineHeight": 1.25
    },
