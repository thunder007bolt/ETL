      "updated": 1793571984644,
      "link": null,
      "locked": false,
      "text": "Chiffre : fin 2025, 8 447 pensions d'orphelin (code RPSE) sont encore actives sans aucun\npaiement au dernier trimestre : sans doute des orphelins de 25 ans et plus, jamais radiés.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Chiffre : fin 2025, 8 447 pensions d'orphelin (code RPSE) sont encore actives sans aucun\npaiement au dernier trimestre : sans doute des orphelins de 25 ans et plus, jamais radiés.",
      "autoResize": true,
      "lineHeight": 1.25
    },
