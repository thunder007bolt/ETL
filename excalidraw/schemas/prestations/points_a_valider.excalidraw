      "updated": 1794253553496,
      "link": null,
      "locked": false,
      "text": "Les dossiers transférés à une autre caisse",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Les dossiers transférés à une autre caisse",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "bJZ"
    },
    {
      "id": "GieIYcoDvXkkLeo9YlzV",
      "type": "text",
      "x": 39,
      "y": 14800.5,
      "width": 786.5600000000001,
      "height": 40,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "jGwT5qe6A2BuesFaSOJQ"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1560205916,
      "version": 2,
      "versionNonce": 2043379139,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794253553496,
      "link": null,
      "locked": false,
      "text": "C'est quoi : un dossier de pension peut être transféré à une autre caisse, qui le gère alors.\nT25 à T27 retirent ces dossiers (voir le point 19).",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "C'est quoi : un dossier de pension peut être transféré à une autre caisse, qui le gère alors.\nT25 à T27 retirent ces dossiers (voir le point 19).",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "bJa"
    },
    {
      "id": "j79LTNe482zbJkwdblNY",
      "type": "text",
      "x": 39,
      "y": 14848.5,
      "width": 804,
      "height": 40,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "jGwT5qe6A2BuesFaSOJQ"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1830230798,
      "version": 2,
      "versionNonce": 2030466029,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794253553496,
      "link": null,
      "locked": false,
      "text": "Dans la base : DOSSIER, DOS_CATEGORIE = CNSS_AC, lu « transféré à une autre caisse »\n; son sens est demandé à la DSI.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Dans la base : DOSSIER, DOS_CATEGORIE = CNSS_AC, lu « transféré à une autre caisse »\n; son sens est demandé à la DSI.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "bJb"
    },
    {
      "id": "dizwZSjG0A4p7YE9paii",
      "type": "text",
      "x": 39,
      "y": 14896.5,
      "width": 464.32000000000005,
      "height": 20,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "jGwT5qe6A2BuesFaSOJQ"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1147976965,
      "version": 2,
      "versionNonce": 1471991139,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794253553496,
      "link": null,
      "locked": false,
      "text": "Aujourd'hui : ces pensions restent comptées au 31/12.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Aujourd'hui : ces pensions restent comptées au 31/12.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "bJc"
    },
