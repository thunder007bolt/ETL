    },
    {
      "id": "xMAwc0kxVnbwT72z20t8",
      "type": "text",
      "x": 39,
      "y": 22612.5,
      "width": 689.2800000000001,
      "height": 20,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "gt7m0BAT6y0VmIUt6Ojm"
      ],
