    {
      "id": "dfuFOEdPjbrICdfrZdpL",
      "type": "text",
      "x": 1813,
      "y": 3470.5,
      "width": 230,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
