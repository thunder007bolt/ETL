      "text": "Le délai des rentes de survivants (T26)",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Le délai des rentes de survivants (T26)",
