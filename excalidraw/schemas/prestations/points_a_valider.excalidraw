      "index": "bGv"
    },
    {
      "id": "wS1YEdaHL8tORgaKxYes",
      "type": "text",
      "x": 1755,
      "y": 13124.5,
      "width": 778.24,
      "height": 60,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
