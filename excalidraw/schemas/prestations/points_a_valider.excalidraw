    },
    {
      "id": "3tXAmjeOrBx0NArDiGh8",
      "type": "text",
      "x": 897,
      "y": 2808.5,
      "width": 768.96,
      "height": 40,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
