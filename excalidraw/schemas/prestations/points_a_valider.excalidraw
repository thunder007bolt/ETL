    {
      "id": "gaoede8zsYDWwGJDGmjC",
      "type": "text",
      "x": 39,
      "y": 24468.5,
      "width": 794.24,
      "height": 40,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
