      "version": 2,
      "versionNonce": 2012656205,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794253553496,
      "link": null,
      "locked": false,
      "text": "Aujourd'hui : comptés comme les autres trop-perçus, dans la colonne des pensions.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Aujourd'hui : comptés comme les autres trop-perçus, dans la colonne des pensions.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "bET"
    },
    {
      "id": "umgnhtQ9wpBV5ohu3s49",
      "type": "text",
      "x": 1755,
      "y": 11654.5,
      "width": 531.52,
      "height": 20,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
