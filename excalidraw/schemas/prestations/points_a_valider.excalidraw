      "versionNonce": 1080491792,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794218137525,
      "link": null,
      "locked": false,
      "text": "Question : PE_COT_AUTRE donne-t-il bien les mois cotisés dans l'autre caisse, déjà\ncompris dans le total des mois ?",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Question : PE_COT_AUTRE donne-t-il bien les mois cotisés dans l'autre caisse, déjà\ncompris dans le total des mois ?",
      "autoResize": true,
      "lineHeight": 1.25
    },
