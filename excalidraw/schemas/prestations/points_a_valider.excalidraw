      "link": null,
      "locked": false,
      "text": "Chiffre : l'annuaire CNSS 2024 met l'action sanitaire et sociale dans cette ligne (tableau\n106), et donne un autre montant de ses dépenses (tableau 114).",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Chiffre : l'annuaire CNSS 2024 met l'action sanitaire et sociale dans cette ligne (tableau\n106), et donne un autre montant de ses dépenses (tableau 114).",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "bQT"
    },
