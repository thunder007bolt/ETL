    {
      "id": "HV8IlMXXkhMBpQCJXqYT",
      "type": "text",
      "x": 897.0,
      "y": 2254.5,
      "width": 758.4000000000001,
      "height": 40.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
