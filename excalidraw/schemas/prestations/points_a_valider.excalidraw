      "isDeleted": false,
      "boundElements": [],
      "updated": 1794218137525,
      "link": null,
      "locked": false,
      "text": "Aujourd'hui : on prend ce qui a été payé aux personnes comptées : c'est le seul montant qui se\nrange par âge et par sexe.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Aujourd'hui : on prend ce qui a été payé aux personnes comptées : c'est le seul montant qui se\nrange par âge et par sexe.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "lTXRZva5mLRGrHQcZ1Wm",
      "type": "text",
      "x": 897.0,
      "y": 12584.5,
      "width": 746.88,
      "height": 40.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
