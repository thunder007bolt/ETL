      "boundElements": [],
      "updated": 1794218137525,
      "link": null,
      "locked": false,
      "text": "La personne comptée",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "La personne comptée",
      "autoResize": true,
