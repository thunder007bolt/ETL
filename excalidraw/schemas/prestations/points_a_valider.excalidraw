      "frameId": null,
      "roundness": null,
      "seed": 214387857,
      "version": 2,
      "versionNonce": 424293741,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794253553496,
      "link": null,
      "locked": false,
      "text": "Aujourd'hui : seuls les taux sont diffusés ; le détail par dossier reste réservé.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Aujourd'hui : seuls les taux sont diffusés ; le détail par dossier reste réservé.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "bBT"
    },
    {
      "id": "5hkcuw6cEhhGIGsft85v",
      "type": "text",
      "x": 39,
      "y": 10132.5,
      "width": 218.56,
      "height": 20,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
