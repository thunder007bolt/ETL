      "boundElements": [],
      "updated": 1794253553495,
      "link": null,
      "locked": false,
      "text": "À qui : DCP ; DP et DR pour les rentes",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "À qui : DCP ; DP et DR pour les rentes",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b1h"
