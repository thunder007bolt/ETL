      "type": "text",
      "x": 39.0,
      "y": 17390.5,
      "width": 783.2,
      "height": 40.0,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "ricbsLYASrRUD2k05P2v"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 2133761670,
      "version": 1,
      "versionNonce": 1559137655,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794218137525,
      "link": null,
      "locked": false,
      "text": "Question : pour T43, on garde la tranche « 60 ans et plus », ou on la détaille par tranches\nde 5 ans ?",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Question : pour T43, on garde la tranche « 60 ans et plus », ou on la détaille par tranches\nde 5 ans ?",
