      "isDeleted": false,
      "boundElements": [],
      "updated": 1793571984644,
      "link": null,
      "locked": false,
      "text": "Question : cette liste est-elle juste, en particulier la retraite anticipée (RPRA) avec la\nvieillesse, et les accessoires ?",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Question : cette liste est-elle juste, en particulier la retraite anticipée (RPRA) avec la\nvieillesse, et les accessoires ?",
