    },
    {
      "id": "yWfpI1ekWE0s1K3qiIOq",
      "type": "text",
      "x": 39,
      "y": 8062.5,
      "width": 766.4000000000001,
      "height": 40,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "WIzJI2upeQ7VfNxR2EtG"
      ],
