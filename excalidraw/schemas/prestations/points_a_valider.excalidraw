      "boundElements": [],
      "updated": 1794218137525,
      "link": null,
      "locked": false,
      "text": "C'est quoi : la dernière ligne de T25, T26 et T27.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "C'est quoi : la dernière ligne de T25, T26 et T27.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "aCNEuoU7D4mFZDw6WvXh",
      "type": "text",
      "x": 1755.0,
      "y": 5554.5,
      "width": 802.4000000000001,
      "height": 60.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "BOwd7LNCmyDjaUGweuiz"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 755930292,
      "version": 1,
      "versionNonce": 303384821,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794218137525,
      "link": null,
      "locked": false,
      "text": "Aujourd'hui : le Total additionne toutes les demandes, y compris celles qui n'ont pas de\nligne, par exemple une déclaration d'accident sans suite (voir le point 23). Sa durée moyenne\nest recalculée sur toutes les demandes ; elle n'est pas la moyenne des lignes.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Aujourd'hui : le Total additionne toutes les demandes, y compris celles qui n'ont pas de\nligne, par exemple une déclaration d'accident sans suite (voir le point 23). Sa durée moyenne\nest recalculée sur toutes les demandes ; elle n'est pas la moyenne des lignes.",
      "autoResize": true,
      "lineHeight": 1.25
    },
