      "version": 2,
      "versionNonce": 1585828419,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794253553496,
      "link": null,
      "locked": false,
      "text": "Dans la base : la date de naissance (INDIVIDU, IND_DATE_NAISSANCE).",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Dans la base : la date de naissance (INDIVIDU, IND_DATE_NAISSANCE).",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "bLG"
    },
    {
      "id": "yDtTM4LY1wO3JTw0bFoL",
      "type": "text",
      "x": 897,
      "y": 15894.5,
      "width": 804.1600000000001,
      "height": 40,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "bwUu1mxpuGkAI1BsJkcz"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1536081957,
      "version": 2,
      "versionNonce": 321496941,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794253553496,
      "link": null,
      "locked": false,
      "text": "Aujourd'hui : l'âge est l'année du tableau moins l'année de naissance, comme dans le glossaire\nde l'Annuaire CIPRES (voir le point 9).",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Aujourd'hui : l'âge est l'année du tableau moins l'année de naissance, comme dans le glossaire\nde l'Annuaire CIPRES (voir le point 9).",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "bLH"
    },
    {
      "id": "fKrZfl5Q8PXiSW34q2qd",
      "type": "text",
      "x": 897,
      "y": 15942.5,
      "width": 795.5200000000001,
      "height": 60,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "bwUu1mxpuGkAI1BsJkcz"
      ],
