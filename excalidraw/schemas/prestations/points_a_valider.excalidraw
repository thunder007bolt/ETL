      "text": "Le délai sur la première demande",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Le délai sur la première demande",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "CgVzqQTnmzKKKXmuqS1U",
      "type": "text",
      "x": 1755.0,
      "y": 8062.5,
      "width": 799.6800000000001,
      "height": 60.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "RbJAuivr1X7lXI1mka10"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 695402110,
      "version": 1,
      "versionNonce": 1665753427,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794218137525,
      "link": null,
      "locked": false,
      "text": "C'est quoi : les indicateurs de délai du recueil des besoins donnent le nombre moyen de jours\npour liquider un dossier. La grille des ratios de la CNSS (feuille 03) ne le mesure que sur\nla première demande : nouvel allocataire, première demande de rente ou de pension.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "C'est quoi : les indicateurs de délai du recueil des besoins donnent le nombre moyen de jours\npour liquider un dossier. La grille des ratios de la CNSS (feuille 03) ne le mesure que sur\nla première demande : nouvel allocataire, première demande de rente ou de pension.",
      "autoResize": true,
      "lineHeight": 1.25
    },
