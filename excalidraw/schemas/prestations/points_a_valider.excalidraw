    },
    {
      "id": "3GP1ubEQdihpIZCLXMla",
      "type": "text",
      "x": 897,
      "y": 15818.5,
      "width": 774.24,
      "height": 40,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
