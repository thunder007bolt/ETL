    {
      "id": "9LE1Ki3ylOjt6o0NpUmk",
      "type": "text",
      "x": 45,
      "y": 392,
      "width": 2470.32,
      "height": 90,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "ar3ZLt4bnlz2MPKgcjnC"
      ],
      "frameId": null,
