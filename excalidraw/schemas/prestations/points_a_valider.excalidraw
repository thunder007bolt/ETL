    {
      "id": "ThNzieHHfds5CHICP27z",
      "type": "text",
      "x": 102.22206506364921,
      "y": 6002.5,
      "width": 426.0,
      "height": 25.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
