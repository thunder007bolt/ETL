      "id": "xoHv0cjQ97C82Bg3IGUa",
      "type": "text",
      "x": 897.0,
      "y": 15496.5,
      "width": 101.76,
      "height": 20.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "Aun5wV4ZIzptTq1riKqn"
