      "roundness": null,
      "seed": 1584827161,
      "version": 1,
      "versionNonce": 1337582138,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793571984644,
      "link": null,
      "locked": false,
      "text": "Dans la base : année de l'exercice moins année de naissance (IND_DATE_NAISSANCE),\ncomme dans le glossaire de l'Annuaire, avec la grille de tranches propre à chaque tableau.\nL'année de naissance 1900 ressemble à une date par défaut (503 personnes, presque toutes des\nveuves) : on la met en « âge inconnu ».",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Dans la base : année de l'exercice moins année de naissance (IND_DATE_NAISSANCE),\ncomme dans le glossaire de l'Annuaire, avec la grille de tranches propre à chaque tableau.\nL'année de naissance 1900 ressemble à une date par défaut (503 personnes, presque toutes des\nveuves) : on la met en « âge inconnu ».",
      "autoResize": true,
      "lineHeight": 1.25
    },
