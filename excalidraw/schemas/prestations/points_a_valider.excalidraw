      "seed": 886673584,
      "version": 1,
      "versionNonce": 682009818,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794218137525,
      "link": null,
      "locked": false,
      "text": "Dans la base : PRESTATION_ESP, PE_MOIS_COTISATION, recopié sur chaque prestation\ndu dossier. Il vaut parfois 999.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Dans la base : PRESTATION_ESP, PE_MOIS_COTISATION, recopié sur chaque prestation\ndu dossier. Il vaut parfois 999.",
      "autoResize": true,
      "lineHeight": 1.25
    },
