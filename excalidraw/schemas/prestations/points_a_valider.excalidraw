      "isDeleted": false,
      "boundElements": [],
      "updated": 1794218137525,
      "link": null,
      "locked": false,
      "text": "Dans la base : AJUSTEMENT, TAJ_CODE = MP, sur un dossier de prestations familiales\n(TDOS_CODE = F), compté l'année où il est établi (AJ_DATE_ETABLISSEMENT).",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Dans la base : AJUSTEMENT, TAJ_CODE = MP, sur un dossier de prestations familiales\n(TDOS_CODE = F), compté l'année où il est établi (AJ_DATE_ETABLISSEMENT).",
      "autoResize": true,
      "lineHeight": 1.25
    },
