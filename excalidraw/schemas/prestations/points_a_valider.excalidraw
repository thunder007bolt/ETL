      "versionNonce": 552360749,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794253553496,
      "link": null,
      "locked": false,
      "text": "À qui : DSI",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
