    },
    {
      "id": "pabxEfRCW3LaMgGd5Zj0",
      "type": "text",
      "x": 1755,
      "y": 24468.5,
      "width": 776.96,
      "height": 40,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
