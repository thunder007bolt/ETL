      "versionNonce": 1676661955,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794218137525,
      "link": null,
      "locked": false,
      "text": "À qui : DCP, avec la DPC",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "À qui : DCP, avec la DPC",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
