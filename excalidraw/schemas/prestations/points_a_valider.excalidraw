      "isDeleted": false,
      "boundElements": [],
      "updated": 1794218137525,
      "link": null,
      "locked": false,
      "text": "L'attente des indemnités journalières (T26)",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "L'attente des indemnités journalières (T26)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "qbRbSo1nr0QQxtsg9RIV",
      "type": "text",
      "x": 1755.0,
      "y": 7606.5,
      "width": 791.6800000000001,
      "height": 40.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "rersngZSanIJcqKDvp6n"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1448215698,
      "version": 1,
      "versionNonce": 1377701779,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794218137525,
      "link": null,
      "locked": false,
      "text": "C'est quoi : l'indemnité journalière remplace le salaire pendant l'arrêt de travail qui suit\nun accident.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "C'est quoi : l'indemnité journalière remplace le salaire pendant l'arrêt de travail qui suit\nun accident.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "2TOMJbtYL3wkSy0Jw0U1",
      "type": "text",
      "x": 1755.0,
      "y": 7654.5,
      "width": 721.2800000000001,
      "height": 20.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "rersngZSanIJcqKDvp6n"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 145687032,
      "version": 1,
      "versionNonce": 337680051,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794218137525,
      "link": null,
      "locked": false,
      "text": "Dans la base : ni la reprise du travail, ni le certificat de guérison ne sont saisis.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Dans la base : ni la reprise du travail, ni le certificat de guérison ne sont saisis.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "r4b0dmZ6k086e57f9k0Z",
      "type": "text",
      "x": 1755.0,
      "y": 7682.5,
      "width": 756.1600000000001,
      "height": 40.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "rersngZSanIJcqKDvp6n"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1745316241,
      "version": 1,
      "versionNonce": 371775783,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794218137525,
      "link": null,
      "locked": false,
      "text": "Aujourd'hui : la durée de liquidation est comptée depuis la déclaration de l'accident et\npubliée telle quelle.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Aujourd'hui : la durée de liquidation est comptée depuis la déclaration de l'accident et\npubliée telle quelle.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "UwEYe1zxAXS04OewApBl",
      "type": "text",
      "x": 1755.0,
      "y": 7730.5,
      "width": 794.88,
      "height": 40.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "rersngZSanIJcqKDvp6n"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 510550506,
      "version": 1,
      "versionNonce": 1313063147,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794218137525,
      "link": null,
      "locked": false,
      "text": "Chiffre : en 2025, en médiane, l'indemnité est notifiée 211 jours (environ 7 mois) après la\nfin de l'arrêt et 251 jours après la déclaration.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Chiffre : en 2025, en médiane, l'indemnité est notifiée 211 jours (environ 7 mois) après la\nfin de l'arrêt et 251 jours après la déclaration.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "iU8oKV8MK8HtAAaNI8QE",
      "type": "text",
      "x": 1755.0,
      "y": 7778.5,
      "width": 146.24,
      "height": 20.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "rersngZSanIJcqKDvp6n"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1905908570,
      "version": 1,
      "versionNonce": 1877496626,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794218137525,
      "link": null,
      "locked": false,
      "text": "À qui : DP et DR",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "À qui : DP et DR",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "9PIkr2NAN9J8OfedKdGR",
      "type": "text",
      "x": 1755.0,
      "y": 7806.5,
      "width": 775.0400000000001,
      "height": 40.0,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "rersngZSanIJcqKDvp6n"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1253331273,
      "version": 1,
      "versionNonce": 1056612093,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794218137525,
      "link": null,
      "locked": false,
      "text": "Question : entre la fin de l'arrêt et la notification, attend-on le certificat de guérison,\nl'attestation de salaire de l'employeur, ou autre chose ?",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Question : entre la fin de l'arrêt et la notification, attend-on le certificat de guérison,\nl'attestation de salaire de l'employeur, ou autre chose ?",
      "autoResize": true,
      "lineHeight": 1.25
    },
