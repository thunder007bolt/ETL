    {
      "id": "KSy2nkxgVsRNC8txisWN",
      "type": "text",
      "x": 960.2220650636492,
      "y": 8478.5,
      "width": 414.0,
      "height": 25.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
