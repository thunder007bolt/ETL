      "versionNonce": 1889195718,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794218137525,
      "link": null,
      "locked": false,
      "text": "Chiffre : l'annuaire CNSS 2024 fait pareil : son tableau 77 range les nouveaux rentiers\nselon qui ils sont, pas selon la victime ; 44 orphelins de rente en 2024 dans la base pour 44\npubliés.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Chiffre : l'annuaire CNSS 2024 fait pareil : son tableau 77 range les nouveaux rentiers\nselon qui ils sont, pas selon la victime ; 44 orphelins de rente en 2024 dans la base pour 44\npubliés.",
      "autoResize": true,
      "lineHeight": 1.25
    },
