      "version": 1,
      "versionNonce": 1107166515,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793571984644,
      "link": null,
      "locked": false,
      "text": "C'est quoi : un orphelin a droit à une pension jusqu'à un certain âge.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "C'est quoi : un orphelin a droit à une pension jusqu'à un certain âge.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "zgVYfak9PSNYV5qQZUEX",
      "type": "text",
      "x": 897.0,
      "y": 2204.5,
      "width": 611.36,
      "height": 20.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "GTApFLhsh34s82fRPDo7"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1898412603,
      "version": 1,
      "versionNonce": 257028109,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793571984644,
      "link": null,
      "locked": false,
      "text": "Aujourd'hui : on compte les orphelins jusqu'à 24 ans, comme l'annuaire.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Aujourd'hui : on compte les orphelins jusqu'à 24 ans, comme l'annuaire.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
