      "boundElements": [],
      "updated": 1795175548428,
      "link": null,
      "locked": false,
      "text": "OUI\nLes projets BI en lots (chaque nuit, chaque mois), à partir de bases relationnelles et de\nfichiers, jusqu'à des dizaines de millions de lignes par table, sur site ou dans le cloud. C'est\nl'essentiel des projets BI des entreprises et des administrations.",
      "fontSize": 21,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "OUI\nLes projets BI en lots (chaque nuit, chaque mois), à partir de bases relationnelles et de\nfichiers, jusqu'à des dizaines de millions de lignes par table, sur site ou dans le cloud. C'est\nl'essentiel des projets BI des entreprises et des administrations.",
      "autoResize": true,
      "lineHeight": 1.25
    },
