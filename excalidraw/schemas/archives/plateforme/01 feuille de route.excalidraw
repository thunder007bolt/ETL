      "seed": 1462635231,
      "version": 1,
      "versionNonce": 2071503169,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795174762366,
      "link": null,
      "locked": false,
      "text": "pipeline: grh_faits\nsource: oracle_grh        # connexion déclarée à part,\n                          # mot de passe dans le coffre\ncible: dwh\nplanning: \"0 2 1 * *\"     # le 1er du mois à 2 h\napres: [grh_dims]         # attend les dimensions\n\ntables:\n  - cible: FAIT_GRH_SITUATION\n    sql: grh_situation.sql\n    chargement: cliche    # ODS, TRUNCATE, ajout en masse\n    tests: [non_vide, meme_nombre_que_la_source]\n\n  - cible: FAIT_GRH_MOUVEMENT\n    sql: grh_mouvement.sql\n    chargement: cliche\n    tests: [non_vide]",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "pipeline: grh_faits\nsource: oracle_grh        # connexion déclarée à part,\n                          # mot de passe dans le coffre\ncible: dwh\nplanning: \"0 2 1 * *\"     # le 1er du mois à 2 h\napres: [grh_dims]         # attend les dimensions\n\ntables:\n  - cible: FAIT_GRH_SITUATION\n    sql: grh_situation.sql\n    chargement: cliche    # ODS, TRUNCATE, ajout en masse\n    tests: [non_vide, meme_nombre_que_la_source]\n\n  - cible: FAIT_GRH_MOUVEMENT\n    sql: grh_mouvement.sql\n    chargement: cliche\n    tests: [non_vide]",
      "autoResize": true,
      "lineHeight": 1.25
    },
