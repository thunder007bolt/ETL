    {
      "id": "T0APYfI15ty9OKfwN87R",
      "type": "text",
      "x": 62,
      "y": 257.0,
      "width": 2227.6800000000003,
      "height": 90.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
