      "isDeleted": false,
      "boundElements": [],
      "updated": 1795174762345,
      "link": null,
      "locked": false,
      "text": "DÉCLARER PLUTÔT QUE CODER\nUn pipeline = un manifeste lisible : source,\ntables, mode de chargement, cible, tests,\nplanning. Avec Airflow, chaque DAG s'écrit\nen Python.",
      "fontSize": 21,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "DÉCLARER PLUTÔT QUE CODER\nUn pipeline = un manifeste lisible : source,\ntables, mode de chargement, cible, tests,\nplanning. Avec Airflow, chaque DAG s'écrit\nen Python.",
      "autoResize": true,
      "lineHeight": 1.25
    },
