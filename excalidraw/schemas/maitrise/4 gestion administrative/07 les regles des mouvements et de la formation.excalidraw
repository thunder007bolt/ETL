    {
      "id": "HMSbylClyAQIVwE82S1x",
      "type": "text",
      "x": 45.0,
      "y": 5113.0,
      "width": 765.7200000000001,
      "height": 90.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
