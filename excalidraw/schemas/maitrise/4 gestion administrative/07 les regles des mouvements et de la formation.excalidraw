    {
      "id": "DjTM8eMoo3aIg56fzZ96",
      "type": "text",
      "x": 1345.0,
      "y": 2090.0,
      "width": 1164.6000000000001,
      "height": 45.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
