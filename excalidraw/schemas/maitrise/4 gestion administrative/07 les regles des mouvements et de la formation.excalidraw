      "boundElements": [],
      "updated": 1794974047884,
      "link": null,
      "locked": false,
      "text": "En août et septembre 2019, 84 personnes ont été engagées comme permanents (décision 51), en service depuis 2018. Leur\nfiche est inactive, sans aucune décision de départ, et aucune n'a de fiche plus récente.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "En août et septembre 2019, 84 personnes ont été engagées comme permanents (décision 51), en service depuis 2018. Leur\nfiche est inactive, sans aucune décision de départ, et aucune n'a de fiche plus récente.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "rzTgkqpKIu6QySwEontk",
      "type": "text",
      "x": 1345.0,
      "y": 2151.0,
      "width": 90.24000000000001,
      "height": 20.0,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "LM9tDBBbETdWXKGLKPbZ"
