      "boundElements": [],
      "updated": 1794974047884,
      "link": null,
      "locked": false,
      "text": "Pourquoi ça compte",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Pourquoi ça compte",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "C5Wcp78YXCvL0LR9DC45",
      "type": "text",
      "x": 1778.3333333333333,
      "y": 3320.5,
      "width": 751.6800000000001,
      "height": 67.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "WdM00dU9DVIroSuGSeTd"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 263890152,
      "version": 1,
      "versionNonce": 10143867,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794974047884,
      "link": null,
      "locked": false,
      "text": "Les chiffres publiés sont sans doute des participations et non des agents, ou\nviennent d'un autre fichier que l'application. On demande sa source à la DRH,\navec la liste de ses colonnes (point 4).",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Les chiffres publiés sont sans doute des participations et non des agents, ou\nviennent d'un autre fichier que l'application. On demande sa source à la DRH,\navec la liste de ses colonnes (point 4).",
      "autoResize": true,
      "lineHeight": 1.25
    },
