      "type": "text",
      "x": 1778.3333333333333,
      "y": 3083.0,
      "width": 720.54,
      "height": 67.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
