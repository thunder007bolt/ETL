    {
      "id": "pKwsP0Sblum2KS6jIMlf",
      "type": "text",
      "x": 1778.3333333333333,
      "y": 630.5,
      "width": 751.6800000000001,
      "height": 135.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "KIiR3uDXkYdgDwATa6yT"
      ],
