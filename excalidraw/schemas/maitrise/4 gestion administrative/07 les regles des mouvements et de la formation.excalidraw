      "isDeleted": false,
      "boundElements": [],
      "updated": 1794974047884,
      "link": null,
      "locked": false,
      "text": "Si on te demande : pourquoi aucun détachement ?",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Si on te demande : pourquoi aucun détachement ?",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "xsQuAzP0YtscJVHLmJls",
      "type": "text",
      "x": 45.0,
      "y": 1655.5,
      "width": 765.7200000000001,
      "height": 67.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "AL0TKBfZ4Z3Z08ysLkmX"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1677995354,
      "version": 1,
      "versionNonce": 1650831302,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794974047884,
      "link": null,
      "locked": false,
      "text": "La base n'a aucune décision 37 chez les permanents, alors que l'annuaire publie\n2 détachements en 2023 et 1 en 2024. On demande à la DRH où ils sont saisis\n(point 23).",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "La base n'a aucune décision 37 chez les permanents, alors que l'annuaire publie\n2 détachements en 2023 et 1 en 2024. On demande à la DRH où ils sont saisis\n(point 23).",
      "autoResize": true,
      "lineHeight": 1.25
    },
