      "seed": 452230901,
      "version": 1,
      "versionNonce": 2130752681,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794974047884,
      "link": null,
      "locked": false,
      "text": "Une formation est « avec promotion » quand le classement de l'agent a changé\naprès elle : l'inscription garde son classement avant et après (CLA_AVANT et\nCLA_APRES). Sinon, elle est « sans promotion ». C'est la finalité demandée\npar la maquette de l'Annuaire.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Une formation est « avec promotion » quand le classement de l'agent a changé\naprès elle : l'inscription garde son classement avant et après (CLA_AVANT et\nCLA_APRES). Sinon, elle est « sans promotion ». C'est la finalité demandée\npar la maquette de l'Annuaire.",
      "autoResize": true,
      "lineHeight": 1.25
    },
