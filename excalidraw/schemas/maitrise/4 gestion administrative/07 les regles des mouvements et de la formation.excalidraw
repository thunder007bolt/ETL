      "versionNonce": 634660108,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794974047884,
      "link": null,
      "locked": false,
      "text": "Le tableau des temporaires s'équilibre lui aussi, mais presque personne n'en sort : les fins de contrat ne sont pas saisies,\net le stock grossit d'année en année.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Le tableau des temporaires s'équilibre lui aussi, mais presque personne n'en sort : les fins de contrat ne sont pas saisies,\net le stock grossit d'année en année.",
      "autoResize": true,
      "lineHeight": 1.25
    },
