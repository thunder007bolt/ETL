    {
      "id": "YWKflBorTfaSt2UvBcqi",
      "type": "text",
      "x": 45.0,
      "y": 868.0,
      "width": 750.78,
      "height": 67.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "hzQaQBvx79GMiXADxe3F"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 515158241,
      "version": 1,
      "versionNonce": 997353833,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794974047884,
      "link": null,
      "locked": false,
      "text": "le contrôle du 17/11/2026 le vérifie de 2020 à 2025 : l'égalité tient\nchaque année, et la fin d'une année est le début de la suivante. 2024 : 670 au\ndébut, 741 à la fin.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "le contrôle du 17/11/2026 le vérifie de 2020 à 2025 : l'égalité tient\nchaque année, et la fin d'une année est le début de la suivante. 2024 : 670 au\ndébut, 741 à la fin.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "Xl1gOL5KH8sIuRcSAMzy",
      "type": "text",
      "x": 45.0,
      "y": 951.5,
      "width": 593.44,
      "height": 20.0,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "hzQaQBvx79GMiXADxe3F"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1194280882,
      "version": 1,
      "versionNonce": 1301803238,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794974047884,
      "link": null,
      "locked": false,
      "text": "Si on te demande : un agent qui change d'unité fait-il un mouvement ?",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Si on te demande : un agent qui change d'unité fait-il un mouvement ?",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "Jbth2lex9wA7g2OK9UWg",
      "type": "text",
      "x": 45.0,
      "y": 975.5,
      "width": 752.04,
      "height": 45.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "hzQaQBvx79GMiXADxe3F"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 161816789,
      "version": 1,
      "versionNonce": 865938591,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794974047884,
      "link": null,
      "locked": false,
      "text": "Non : il est présent aux deux photos, il n'entre ni ne sort. Pour une direction\nou une agence, l'effectif de fin se lit donc dans T58, pas dans T60.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Non : il est présent aux deux photos, il n'entre ni ne sort. Pour une direction\nou une agence, l'effectif de fin se lit donc dans T58, pas dans T60.",
      "autoResize": true,
      "lineHeight": 1.25
    },
