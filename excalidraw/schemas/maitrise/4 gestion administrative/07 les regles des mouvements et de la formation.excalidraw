      "type": "text",
      "x": 1345.0,
      "y": 2505.0,
      "width": 1192.3200000000002,
      "height": 45.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
