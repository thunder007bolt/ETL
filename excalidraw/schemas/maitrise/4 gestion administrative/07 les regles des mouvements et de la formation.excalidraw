      "versionNonce": 1729852451,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794974047884,
      "link": null,
      "locked": false,
      "text": "Les affectations, mutations, promotions, rétrogradations et nominations\nrestent reprises de la table des mouvements de l'application comme avant\n(lignes validées, sur l'année de leur date de début), mais elles n'entrent pas\ndans T60.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Les affectations, mutations, promotions, rétrogradations et nominations\nrestent reprises de la table des mouvements de l'application comme avant\n(lignes validées, sur l'année de leur date de début), mais elles n'entrent pas\ndans T60.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "RVZwoimUVmwm27MUBhF4",
