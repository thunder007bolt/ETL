    {
      "id": "2fg6KJGSFF550ZlcyEK2",
      "type": "text",
      "x": 1778.3333333333333,
      "y": 805.5,
      "width": 734.76,
      "height": 45.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
