      "isDeleted": false,
      "boundElements": [],
      "updated": 1794974047884,
      "link": null,
      "locked": false,
      "text": "Tant que les fins de contrat ne sont pas saisies, le tableau des temporaires ne veut rien dire, ni en effectif ni en\nmouvements. C'est le premier point à trancher avec la DRH (point 20).",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Tant que les fins de contrat ne sont pas saisies, le tableau des temporaires ne veut rien dire, ni en effectif ni en\nmouvements. C'est le premier point à trancher avec la DRH (point 20).",
      "autoResize": true,
      "lineHeight": 1.25
    },
