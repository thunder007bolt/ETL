      "isDeleted": false,
      "boundElements": [],
      "updated": 1794974047884,
      "link": null,
      "locked": false,
      "text": "De 2020 à 2025 : 1 à 5 sorties par an pour 5 à 39 entrées. 2024 : 268 au début, 35 recrutements, 1 autre entrée, 5\nsorties, 299 à la fin — pour 46 contractuels publiés.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "De 2020 à 2025 : 1 à 5 sorties par an pour 5 à 39 entrées. 2024 : 268 au début, 35 recrutements, 1 autre entrée, 5\nsorties, 299 à la fin — pour 46 contractuels publiés.",
      "autoResize": true,
      "lineHeight": 1.25
    },
