      "seed": 1627738982,
      "version": 1,
      "versionNonce": 169490564,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794974047884,
      "link": null,
      "locked": false,
      "text": "T63 = frais de personnel ÷ charges de fonctionnement ; la norme CIPRES est\nde 85 % au plus. T64 = dépenses de formation ÷ masse salariale ; la norme est\nde 1 à 5 %. T64 montre aussi la formation rapportée au budget. Un taux dont le\ndénominateur manque reste vide, jamais à zéro.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "T63 = frais de personnel ÷ charges de fonctionnement ; la norme CIPRES est\nde 85 % au plus. T64 = dépenses de formation ÷ masse salariale ; la norme est\nde 1 à 5 %. T64 montre aussi la formation rapportée au budget. Un taux dont le\ndénominateur manque reste vide, jamais à zéro.",
      "autoResize": true,
      "lineHeight": 1.25
    },
