      "versionNonce": 1543381296,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794974047884,
      "link": null,
      "locked": false,
      "text": "T63 et T64 ne se lisent pas dans l'application du personnel, mais dans la comptabilité. Aucun chiffre n'est mesurable aujourd'hui : la source n'existe pas encore. Tout le reste est écrit et n'attend que les montants.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "T63 et T64 ne se lisent pas dans l'application du personnel, mais dans la comptabilité. Aucun chiffre n'est mesurable aujourd'hui : la source n'existe pas encore. Tout le reste est écrit et n'attend que les montants.",
      "autoResize": true,
      "lineHeight": 1.25
    },
