      "seed": 1644338222,
      "version": 1,
      "versionNonce": 1817704788,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794974047884,
      "link": null,
      "locked": false,
      "text": "Pour un permanent, c'est son premier départ ; pour un temporaire, le dernier\ndépart de l'année, celui qui a fini son dernier contrat.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Pour un permanent, c'est son premier départ ; pour un temporaire, le dernier\ndépart de l'année, celui qui a fini son dernier contrat.",
      "autoResize": true,
      "lineHeight": 1.25
    },
