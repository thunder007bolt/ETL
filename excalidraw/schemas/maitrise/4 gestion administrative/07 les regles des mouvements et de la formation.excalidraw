    {
      "id": "m1bfVZGCJ1vMiJERG6x6",
      "type": "text",
      "x": 911.6666666666666,
      "y": 3860.0,
      "width": 761.4000000000001,
      "height": 90.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "ra2iq1YGFtkfX3FALvtP"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1815107062,
      "version": 1,
      "versionNonce": 2018829207,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794974047884,
      "link": null,
      "locked": false,
      "text": "Une rubrique est une liste de débuts de compte et une liste de gestions : frais\nde personnel = comptes 65 ; charges de fonctionnement = comptes 61 à 66 ;\ndépenses de formation = comptes 63, 86 et 87 ; masse salariale = comptes 651\net 652 ; budget = comptes 6 et 2 budgétés.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Une rubrique est une liste de débuts de compte et une liste de gestions : frais\nde personnel = comptes 65 ; charges de fonctionnement = comptes 61 à 66 ;\ndépenses de formation = comptes 63, 86 et 87 ; masse salariale = comptes 651\net 652 ; budget = comptes 6 et 2 budgétés.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "xCQC18OgvNfhTe9J5sPd",
      "type": "text",
      "x": 911.6666666666666,
      "y": 3966.0,
      "width": 74.56,
      "height": 20.0,
      "angle": 0,
      "strokeColor": "#f08c00",
