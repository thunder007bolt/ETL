      "type": "text",
      "x": 45.0,
      "y": 1548.0,
      "width": 754.02,
      "height": 67.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "AL0TKBfZ4Z3Z08ysLkmX"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 549674808,
      "version": 1,
      "versionNonce": 740618109,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794974047884,
      "link": null,
      "locked": false,
      "text": "les 18 codes sont bien dans la table des types de mouvement, aucun en double\n(lot 26, Q152). De 2020 à 2025, T60 ne remplit que REM, DISP, DEM, LIC\net FIN_CTRAT : aucun détachement, aucune mise à disposition.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "les 18 codes sont bien dans la table des types de mouvement, aucun en double\n(lot 26, Q152). De 2020 à 2025, T60 ne remplit que REM, DISP, DEM, LIC\net FIN_CTRAT : aucun détachement, aucune mise à disposition.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "O2gnCCa0qP40fypmjS6x",
      "type": "text",
      "x": 45.0,
      "y": 1631.5,
      "width": 409.44000000000005,
      "height": 20.0,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
