      "seed": 1245680518,
      "version": 1,
      "versionNonce": 1576283937,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794974047884,
      "link": null,
      "locked": false,
      "text": "T62 est le seul tableau du personnel qui ne retombe pas sur l'annuaire, et\naucune des pistes essayées ne l'explique : ni la date retenue, ni le type\nd'agent, ni les formations longues.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "T62 est le seul tableau du personnel qui ne retombe pas sur l'annuaire, et\naucune des pistes essayées ne l'explique : ni la date retenue, ni le type\nd'agent, ni les formations longues.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "RSv6Tge2XeTVnfxq2Nuw",
      "type": "text",
      "x": 1778.3333333333333,
      "y": 3166.5,
      "width": 90.24000000000001,
      "height": 20.0,
