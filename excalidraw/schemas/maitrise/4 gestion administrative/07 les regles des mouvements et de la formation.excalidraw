      "boundElements": [],
      "updated": 1794974047884,
      "link": null,
      "locked": false,
      "text": "Un formé est un agent permanent de la CNSS inscrit à une formation commencée\ndans l'année. Il compte une fois, même s'il a suivi plusieurs formations. Sa\ncatégorie et son sexe sont ceux de sa situation au 31/12.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Un formé est un agent permanent de la CNSS inscrit à une formation commencée\ndans l'année. Il compte une fois, même s'il a suivi plusieurs formations. Sa\ncatégorie et son sexe sont ceux de sa situation au 31/12.",
      "autoResize": true,
      "lineHeight": 1.25
    },
