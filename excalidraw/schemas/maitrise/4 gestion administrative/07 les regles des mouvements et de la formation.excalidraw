      "seed": 1753211988,
      "version": 1,
      "versionNonce": 1449944779,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794974047884,
      "link": null,
      "locked": false,
      "text": "Pourquoi",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Pourquoi",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "E7LNsqh2uc2OvQa2m1T4",
      "type": "text",
      "x": 45.0,
      "y": 760.5,
      "width": 739.8000000000001,
      "height": 67.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "hzQaQBvx79GMiXADxe3F"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1106339156,
      "version": 1,
      "versionNonce": 401569213,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794974047884,
      "link": null,
      "locked": false,
      "text": "Un mouvement n'est pas une ligne saisie quelque part : c'est la différence\nentre deux photos. C'est la seule façon d'avoir un tableau qui tombe juste et\ndont la fin est l'effectif de T58.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Un mouvement n'est pas une ligne saisie quelque part : c'est la différence\nentre deux photos. C'est la seule façon d'avoir un tableau qui tombe juste et\ndont la fin est l'effectif de T58.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "YVeTlX2iMBXLyRkBELK6",
      "type": "text",
      "x": 45.0,
      "y": 844.0,
      "width": 81.28,
      "height": 20.0,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "hzQaQBvx79GMiXADxe3F"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 584844290,
      "version": 1,
      "versionNonce": 1977326675,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794974047884,
      "link": null,
      "locked": false,
      "text": "La preuve",
      "fontSize": 16,
