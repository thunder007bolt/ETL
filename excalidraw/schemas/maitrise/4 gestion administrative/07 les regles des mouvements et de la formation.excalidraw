      "versionNonce": 1307524721,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794974047884,
      "link": null,
      "locked": false,
      "text": "Ce ne sont pas des entrées ni des sorties : l'agent reste au personnel. C'est\nd'ailleurs presque tout ce que contient cette table : 94 à 95 % de mouvements\ninternes (lot 1 ; réunion du 03/11/2026).",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Ce ne sont pas des entrées ni des sorties : l'agent reste au personnel. C'est\nd'ailleurs presque tout ce que contient cette table : 94 à 95 % de mouvements\ninternes (lot 1 ; réunion du 03/11/2026).",
      "autoResize": true,
      "lineHeight": 1.25
    },
