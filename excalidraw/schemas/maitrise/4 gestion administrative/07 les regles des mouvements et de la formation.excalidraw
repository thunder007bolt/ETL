      "type": "text",
      "x": 45.0,
      "y": 1440.5,
      "width": 758.52,
      "height": 67.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "AL0TKBfZ4Z3Z08ysLkmX"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 195886958,
      "version": 1,
      "versionNonce": 991142661,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794974047884,
      "link": null,
      "locked": false,
      "text": "Le recueil des besoins v7 (RH ligne 3) demande de détailler les « autres » et\nd'en donner la liste à la CNSS. Cette liste n'est pas inventée : c'est celle de\nl'application, la même que le tableau 121 de l'annuaire.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Le recueil des besoins v7 (RH ligne 3) demande de détailler les « autres » et\nd'en donner la liste à la CNSS. Cette liste n'est pas inventée : c'est celle de\nl'application, la même que le tableau 121 de l'annuaire.",
      "autoResize": true,
      "lineHeight": 1.25
    },
