    {
      "id": "4b8shNYTu3PzOfqFPNJc",
      "type": "text",
      "x": 1345.0,
      "y": 2260.0,
      "width": 1144.6200000000001,
      "height": 45.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
