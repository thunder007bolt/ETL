    },
    {
      "id": "OVQhNJbVP0AAMtmVP3Uk",
      "type": "text",
      "x": 911.6666666666666,
      "y": 1265.5,
      "width": 726.1200000000001,
      "height": 45.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "BQz905rLAvKrufRyUs9b"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1617639403,
      "version": 1,
      "versionNonce": 1615775067,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794974047884,
      "link": null,
      "locked": false,
      "text": "Un agent embauché en février et parti en octobre n'est présent à aucune des\ndeux photos : il n'est pas compté (réglage passages_annee = NON).",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Un agent embauché en février et parti en octobre n'est présent à aucune des\ndeux photos : il n'est pas compté (réglage passages_annee = NON).",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "d8CuhcwAe8TMvlmqAZC1",
      "type": "text",
      "x": 911.6666666666666,
      "y": 1326.5,
      "width": 74.56,
      "height": 20.0,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "BQz905rLAvKrufRyUs9b"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1824894470,
      "version": 1,
      "versionNonce": 1367847856,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794974047884,
      "link": null,
      "locked": false,
      "text": "Pourquoi",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Pourquoi",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "n6BBgz3OAKc7fdHdX8kK",
      "type": "text",
      "x": 911.6666666666666,
      "y": 1350.5,
      "width": 760.86,
      "height": 67.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "BQz905rLAvKrufRyUs9b"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 967974496,
      "version": 1,
      "versionNonce": 74971050,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794974047884,
      "link": null,
      "locked": false,
      "text": "C'est la conséquence des deux photos. Le réglage OUI le compterait une fois\nen entrée et une fois en sortie ; dans les deux cas, début + entrées − sorties =\nfin reste vrai.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "C'est la conséquence des deux photos. Le réglage OUI le compterait une fois\nen entrée et une fois en sortie ; dans les deux cas, début + entrées − sorties =\nfin reste vrai.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "zqhR2QeDisXSAt8e5ows",
      "type": "text",
      "x": 911.6666666666666,
      "y": 1434.0,
      "width": 81.28,
      "height": 20.0,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "BQz905rLAvKrufRyUs9b"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 518602220,
      "version": 1,
      "versionNonce": 617609319,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794974047884,
      "link": null,
      "locked": false,
      "text": "La preuve",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "La preuve",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "kIbAfGKgJ7U3iLTo29ER",
      "type": "text",
      "x": 911.6666666666666,
      "y": 1458.0,
      "width": 736.3800000000001,
      "height": 45.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "BQz905rLAvKrufRyUs9b"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 911117213,
      "version": 1,
      "versionNonce": 1708699684,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794974047884,
      "link": null,
      "locked": false,
      "text": "2 permanents sont entrés et partis en 2024, aucun autre depuis 2019. C'est\nune partie de l'écart sur les recrutements : 101 comptés pour 104 publiés.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "2 permanents sont entrés et partis en 2024, aucun autre depuis 2019. C'est\nune partie de l'écart sur les recrutements : 101 comptés pour 104 publiés.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "5y20o1GemujQ7WzLIgRl",
      "type": "text",
      "x": 911.6666666666666,
      "y": 1519.0,
      "width": 413.92,
      "height": 20.0,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "BQz905rLAvKrufRyUs9b"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 645524878,
      "version": 1,
      "versionNonce": 428066104,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794974047884,
      "link": null,
      "locked": false,
      "text": "Si on te demande : pourquoi ne pas les compter ?",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Si on te demande : pourquoi ne pas les compter ?",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "BlxPysyxmTi6rQy7q4Y9",
      "type": "text",
      "x": 911.6666666666666,
      "y": 1543.0,
      "width": 740.8800000000001,
      "height": 45.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "BQz905rLAvKrufRyUs9b"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 462498117,
      "version": 1,
      "versionNonce": 992520103,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794974047884,
      "link": null,
      "locked": false,
      "text": "C'est la proposition de la BI, pour que le tableau se lise entre deux photos.\nLa DRH tranchera (point 24) ; c'est un réglage, pas une réécriture.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "C'est la proposition de la BI, pour que le tableau se lise entre deux photos.\nLa DRH tranchera (point 24) ; c'est un réglage, pas une réécriture.",
      "autoResize": true,
      "lineHeight": 1.25
    },
