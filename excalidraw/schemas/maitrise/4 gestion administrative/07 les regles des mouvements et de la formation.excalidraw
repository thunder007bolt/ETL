      "type": "text",
      "x": 911.6666666666666,
      "y": 890.5,
      "width": 759.24,
      "height": 67.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "uLJMy7AutTZgtOKb8vrV"
      ],
