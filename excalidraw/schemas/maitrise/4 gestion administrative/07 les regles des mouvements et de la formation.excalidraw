    {
      "id": "fKfreOpui6WZDjW4tA3V",
      "type": "text",
      "x": 1345.0,
      "y": 2175.0,
      "width": 1177.7400000000002,
      "height": 45.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "LM9tDBBbETdWXKGLKPbZ"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 105429128,
      "version": 1,
      "versionNonce": 1715982027,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794974047884,
      "link": null,
      "locked": false,
      "text": "L'annuaire les fait entrer en 2019 (84 « autres entrées ») et les sort en 2024 (84 des 94 « autres sorties »). Sans date\nde départ, la base ne les compte dans aucune année : 670 permanents fin 2023 pour 767 publiés.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "L'annuaire les fait entrer en 2019 (84 « autres entrées ») et les sort en 2024 (84 des 94 « autres sorties »). Sans date\nde départ, la base ne les compte dans aucune année : 670 permanents fin 2023 pour 767 publiés.",
      "autoResize": true,
      "lineHeight": 1.25
    },
