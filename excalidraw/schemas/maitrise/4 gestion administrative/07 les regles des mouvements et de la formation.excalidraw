    {
      "id": "GP1WB59wM0oV7sLmR3aO",
      "type": "text",
      "x": 1778.3333333333333,
      "y": 3860.0,
      "width": 762.3000000000001,
      "height": 90.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
