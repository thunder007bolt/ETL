    },
    {
      "id": "RsfW6y58IDRTq8crwJW1",
      "type": "text",
      "x": 45.0,
      "y": 2505.0,
      "width": 1182.96,
      "height": 45.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "nUZVdLhZBKXhBOwbq60j"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1126071498,
      "version": 1,
      "versionNonce": 1969465884,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794974047884,
      "link": null,
      "locked": false,
      "text": "La base a bien les décisions de mise en disponibilité (07), au niveau de l'annuaire : 3, 4, 2, 5 et 6 de 2020 à 2024, pour\n5, 3, 2, 4 et 7 publiées. Mais T60 n'en montre que 0 à 1 par an.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "La base a bien les décisions de mise en disponibilité (07), au niveau de l'annuaire : 3, 4, 2, 5 et 6 de 2020 à 2024, pour\n5, 3, 2, 4 et 7 publiées. Mais T60 n'en montre que 0 à 1 par an.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "LBGi0SkPrpbVtInJMtUx",
      "type": "text",
      "x": 45.0,
      "y": 2566.0,
      "width": 90.24000000000001,
      "height": 20.0,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "nUZVdLhZBKXhBOwbq60j"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1792589030,
      "version": 1,
      "versionNonce": 1239773832,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794974047884,
      "link": null,
      "locked": false,
      "text": "Le chiffre",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Le chiffre",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "Z2Z3lw5UGuPnyVr9eZPl",
      "type": "text",
      "x": 45.0,
      "y": 2590.0,
      "width": 1189.6200000000001,
      "height": 67.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "nUZVdLhZBKXhBOwbq60j"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1774167385,
      "version": 1,
      "versionNonce": 1043893784,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794974047884,
      "link": null,
      "locked": false,
      "text": "12 agents mis en disponibilité de 2021 à 2025 ne sont jamais revenus, et leur fiche est passée à inactive sans aucun\ndépart daté : notre règle ne les compte alors à aucune date, même les années où ils travaillaient. Il manque 12 permanents\nfin 2020, et encore 3 fin 2024.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "12 agents mis en disponibilité de 2021 à 2025 ne sont jamais revenus, et leur fiche est passée à inactive sans aucun\ndépart daté : notre règle ne les compte alors à aucune date, même les années où ils travaillaient. Il manque 12 permanents\nfin 2020, et encore 3 fin 2024.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "qMiQkGNt6GDdjPoBnUyp",
      "type": "text",
      "x": 45.0,
      "y": 2673.5,
      "width": 162.24,
      "height": 20.0,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "nUZVdLhZBKXhBOwbq60j"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 671372100,
      "version": 1,
      "versionNonce": 387739634,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794974047884,
      "link": null,
      "locked": false,
      "text": "Pourquoi ça compte",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Pourquoi ça compte",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "3xzmhpV5hszlPVaA933v",
      "type": "text",
      "x": 45.0,
      "y": 2697.5,
      "width": 1193.4,
      "height": 67.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "nUZVdLhZBKXhBOwbq60j"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1119113767,
      "version": 1,
      "versionNonce": 6790485,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794974047884,
      "link": null,
      "locked": false,
      "text": "C'est une erreur de notre requête, pas de la CNSS : « inactif » ne veut pas dire « parti ». Correction trouvée : pour une\nfiche inactive sans départ daté, la dernière mise en disponibilité sert de date de sortie. T60 donnerait alors 2, 1, 3 et 3\ndisponibilités de plus de 2021 à 2024.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "C'est une erreur de notre requête, pas de la CNSS : « inactif » ne veut pas dire « parti ». Correction trouvée : pour une\nfiche inactive sans départ daté, la dernière mise en disponibilité sert de date de sortie. T60 donnerait alors 2, 1, 3 et 3\ndisponibilités de plus de 2021 à 2024.",
      "autoResize": true,
      "lineHeight": 1.25
    },
