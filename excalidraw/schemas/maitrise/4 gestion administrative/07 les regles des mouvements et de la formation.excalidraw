      "roundness": null,
      "seed": 1412180581,
      "version": 1,
      "versionNonce": 1076938412,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794974047884,
      "link": null,
      "locked": false,
      "text": "2024 : 101 recrutements pour 104 publiés ; 2 des 3 manquants sont des agents\nentrés et repartis dans l'année. 2025 : 159 recrutements. Aucune entrée\nDETAC ni AUTRE_ENT depuis 2020.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "2024 : 101 recrutements pour 104 publiés ; 2 des 3 manquants sont des agents\nentrés et repartis dans l'année. 2025 : 159 recrutements. Aucune entrée\nDETAC ni AUTRE_ENT depuis 2020.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "NtMaLN1uKMQEHgKs5Mrl",
      "type": "text",
      "x": 911.6666666666666,
      "y": 974.0,
      "width": 636.96,
      "height": 20.0,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "uLJMy7AutTZgtOKb8vrV"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 600323833,
      "version": 1,
      "versionNonce": 1689604721,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794974047884,
      "link": null,
      "locked": false,
      "text": "Si on te demande : un temporaire devenu permanent est-il un recrutement ?",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Si on te demande : un temporaire devenu permanent est-il un recrutement ?",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "HAig6giI7rxwqQxtBSq3",
      "type": "text",
      "x": 911.6666666666666,
      "y": 998.0,
      "width": 752.4000000000001,
      "height": 67.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "uLJMy7AutTZgtOKb8vrV"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1100169263,
      "version": 1,
      "versionNonce": 729545778,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794974047884,
      "link": null,
      "locked": false,
      "text": "Non. Il sort du tableau des temporaires et entre dans celui des permanents en\n« autre entrée ». Il n'est compté qu'une fois en recrutement, à son premier\nengagement.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Non. Il sort du tableau des temporaires et entre dans celui des permanents en\n« autre entrée ». Il n'est compté qu'une fois en recrutement, à son premier\nengagement.",
      "autoResize": true,
      "lineHeight": 1.25
    },
