      "versionNonce": 479413657,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794974048121,
      "link": null,
      "locked": false,
      "text": "La règle : le domaine vient de l'unité de l'agent, pas du code de la situation.\nLa colonne est ajoutée à la table, et le fichier des 432 unités est préparé et\nenvoyé à la CNSS.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "La règle : le domaine vient de l'unité de l'agent, pas du code de la situation.\nLa colonne est ajoutée à la table, et le fichier des 432 unités est préparé et\nenvoyé à la CNSS.",
      "autoResize": true,
      "lineHeight": 1.25
    },
