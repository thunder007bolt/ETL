      "isDeleted": false,
      "boundElements": [],
      "updated": 1794974048121,
      "link": null,
      "locked": false,
      "text": "Tout le reste : la CNSS doit remplir le domaine de chaque unité, d'abord 132\nlignes « À décider ». Sans elles, chaque agent tombe dans « Domaine non\nrenseigné ».",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Tout le reste : la CNSS doit remplir le domaine de chaque unité, d'abord 132\nlignes « À décider ». Sans elles, chaque agent tombe dans « Domaine non\nrenseigné ».",
      "autoResize": true,
      "lineHeight": 1.25
    },
