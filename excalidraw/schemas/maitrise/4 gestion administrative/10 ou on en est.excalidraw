      "versionNonce": 1824067452,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794974048121,
      "link": null,
      "locked": false,
      "text": "L'égalité tient chaque année : en 2024, 670 au début, 101 recrutements, 24\nretraites, 5 décès, 1 autre sortie, 741 à la fin. La fin d'une année est bien le\ndébut de la suivante.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "L'égalité tient chaque année : en 2024, 670 au début, 101 recrutements, 24\nretraites, 5 décès, 1 autre sortie, 741 à la fin. La fin d'une année est bien le\ndébut de la suivante.",
      "autoResize": true,
      "lineHeight": 1.25
    },
