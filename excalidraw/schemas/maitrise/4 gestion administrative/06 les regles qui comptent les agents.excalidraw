      "locked": false,
      "text": "Si on te demande : pourquoi la prise de service avant l'embauche ?",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Si on te demande : pourquoi la prise de service avant l'embauche ?",
