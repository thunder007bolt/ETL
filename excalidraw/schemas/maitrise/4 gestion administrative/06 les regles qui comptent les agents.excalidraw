    },
    {
      "id": "sqlYmcRj2eCtHg1ICvhB",
      "type": "text",
      "x": 1778.3333333333333,
      "y": 2176.5,
      "width": 764.4600000000002,
      "height": 67.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "KHEKW0oQesUE2PhOXwnZ"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 616175377,
      "version": 1,
      "versionNonce": 1432609129,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794974047771,
      "link": null,
      "locked": false,
      "text": "au 31/12/2024, les trois premières tranches sont exactes (12, 28 et 70\nagents) et les autres à 9 près. Seule vraie différence : 5 permanents de 60 ans\net plus, pour 0 publiés — les 5 vieilles fiches sans état.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "au 31/12/2024, les trois premières tranches sont exactes (12, 28 et 70\nagents) et les autres à 9 près. Seule vraie différence : 5 permanents de 60 ans\net plus, pour 0 publiés — les 5 vieilles fiches sans état.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "Jofbw8H2sAmcDlQfCicX",
      "type": "text",
      "x": 1778.3333333333333,
      "y": 2260.0,
      "width": 667.6800000000001,
      "height": 20.0,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "KHEKW0oQesUE2PhOXwnZ"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 663133050,
      "version": 1,
      "versionNonce": 1304959219,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794974047771,
      "link": null,
      "locked": false,
      "text": "Si on te demande : et l'âge atteint dans l'année, comme pour les prestations ?",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Si on te demande : et l'âge atteint dans l'année, comme pour les prestations ?",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "R0W7DlqBCV0aoNGPZrmJ",
      "type": "text",
      "x": 1778.3333333333333,
      "y": 2284.0,
      "width": 738.9000000000001,
      "height": 67.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "KHEKW0oQesUE2PhOXwnZ"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1091765913,
      "version": 1,
      "versionNonce": 1674826952,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794974047771,
      "link": null,
      "locked": false,
      "text": "Non. La GRH compte les années pleines à la date d'arrêté ; les prestations\nprennent l'année moins l'année de naissance (règle R8). Les deux domaines ne\ncomptent pas pareil.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Non. La GRH compte les années pleines à la date d'arrêté ; les prestations\nprennent l'année moins l'année de naissance (règle R8). Les deux domaines ne\ncomptent pas pareil.",
      "autoResize": true,
      "lineHeight": 1.25
    },
