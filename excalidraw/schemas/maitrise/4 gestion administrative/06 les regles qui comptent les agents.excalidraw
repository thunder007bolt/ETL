      "isDeleted": false,
      "boundElements": [],
      "updated": 1794974047771,
      "link": null,
      "locked": false,
      "text": "Les chiffres de l'année N viennent de la photo de la base prise à la fin de janvier N+1 : les directions font leurs\ncorrections de l'année N dans l'application avant cette date, et seul ce qui est saisi dans l'application compte.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Les chiffres de l'année N viennent de la photo de la base prise à la fin de janvier N+1 : les directions font leurs\ncorrections de l'année N dans l'application avant cette date, et seul ce qui est saisi dans l'application compte.",
      "autoResize": true,
      "lineHeight": 1.25
    },
