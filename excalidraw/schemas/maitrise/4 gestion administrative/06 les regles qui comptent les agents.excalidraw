    {
      "id": "NzN6GtwLRmKLyfw93zSi",
      "type": "text",
      "x": 45.0,
      "y": 3922.5,
      "width": 1164.96,
      "height": 67.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
