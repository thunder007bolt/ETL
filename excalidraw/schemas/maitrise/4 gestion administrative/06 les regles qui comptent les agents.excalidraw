      "boundElements": [],
      "updated": 1794974047771,
      "link": null,
      "locked": false,
      "text": "Taux d'encadrement = nombre de cadres (catégories 04, 05, 06 et HC) ÷ effectif, à chaque 31/12, sur les cinq derniers\nexercices. La norme CIPRES est de 10 % au plus.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Taux d'encadrement = nombre de cadres (catégories 04, 05, 06 et HC) ÷ effectif, à chaque 31/12, sur les cinq derniers\nexercices. La norme CIPRES est de 10 % au plus.",
      "autoResize": true,
      "lineHeight": 1.25
    },
