      "updated": 1794974047771,
      "link": null,
      "locked": false,
      "text": "La règle",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "La règle",
      "autoResize": true,
