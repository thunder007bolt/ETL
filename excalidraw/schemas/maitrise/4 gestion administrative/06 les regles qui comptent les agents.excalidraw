      "boundElements": [],
      "updated": 1794974047771,
      "link": null,
      "locked": false,
      "text": "48,3 % en 2024 (358 cadres sur 741 permanents) pour 49,2 % publiés ; environ 42 % de 2020 à 2023 ; 50,1 % fin 2025.\nAvec les seuls cadres supérieurs, on tomberait à 7,8 %.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "48,3 % en 2024 (358 cadres sur 741 permanents) pour 49,2 % publiés ; environ 42 % de 2020 à 2023 ; 50,1 % fin 2025.\nAvec les seuls cadres supérieurs, on tomberait à 7,8 %.",
      "autoResize": true,
      "lineHeight": 1.25
    },
