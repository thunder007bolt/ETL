    {
      "id": "Ild06RmD7eKlYDgHGUBT",
      "type": "text",
      "x": 1778.3333333333333,
      "y": 594.5,
      "width": 763.02,
      "height": 90.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "RAjBm3yqVWBzh7LtDAqL"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 327757659,
      "version": 1,
      "versionNonce": 160911009,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794974047771,
      "link": null,
      "locked": false,
      "text": "Un départ est une décision : 02 l'admission à la retraite, 34 la liquidation\ndes droits après un décès, 35 la fin de contrat, 36 la démission, 52 la rupture\ndu contrat, 54 le licenciement. Annulée par une décision 40, elle ne compte\npas. Sans décision, c'est la date de décès de la fiche.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Un départ est une décision : 02 l'admission à la retraite, 34 la liquidation\ndes droits après un décès, 35 la fin de contrat, 36 la démission, 52 la rupture\ndu contrat, 54 le licenciement. Annulée par une décision 40, elle ne compte\npas. Sans décision, c'est la date de décès de la fiche.",
      "autoResize": true,
      "lineHeight": 1.25
    },
