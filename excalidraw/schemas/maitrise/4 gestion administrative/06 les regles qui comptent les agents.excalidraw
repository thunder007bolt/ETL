      "versionNonce": 998814823,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794974047771,
      "link": null,
      "locked": false,
      "text": "Parce que l'ancienneté se compte depuis le jour où l'agent a commencé à\ntravailler. L'entrée dans l'effectif, elle, part de l'embauche : c'est le point\n50, posé à la DRH.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Parce que l'ancienneté se compte depuis le jour où l'agent a commencé à\ntravailler. L'entrée dans l'effectif, elle, part de l'embauche : c'est le point\n50, posé à la DRH.",
      "autoResize": true,
      "lineHeight": 1.25
    },
