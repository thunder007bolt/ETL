      "versionNonce": 761013221,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794974047771,
      "link": null,
      "locked": false,
      "text": "Les départs ne sont écrits nulle part ailleurs : la situation de l'agent n'est\njamais fermée, et la table des mouvements n'a ni retraite ni décès.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Les départs ne sont écrits nulle part ailleurs : la situation de l'agent n'est\njamais fermée, et la table des mouvements n'a ni retraite ni décès.",
      "autoResize": true,
      "lineHeight": 1.25
    },
