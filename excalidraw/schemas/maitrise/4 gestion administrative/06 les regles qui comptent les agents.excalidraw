      "isDeleted": false,
      "boundElements": [],
      "updated": 1794974047771,
      "link": null,
      "locked": false,
      "text": "Un encadrant est un cadre, moyen ou supérieur : c'est ce qu'a dit la réunion du 03/11/2026, et c'est ce que publie\nl'annuaire de la CNSS.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Un encadrant est un cadre, moyen ou supérieur : c'est ce qu'a dit la réunion du 03/11/2026, et c'est ce que publie\nl'annuaire de la CNSS.",
      "autoResize": true,
      "lineHeight": 1.25
    },
