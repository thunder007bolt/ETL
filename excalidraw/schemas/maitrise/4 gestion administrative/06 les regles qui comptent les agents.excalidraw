      "versionNonce": 1793941334,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794974047771,
      "link": null,
      "locked": false,
      "text": "HORS_EFFECTIF : il sort de l'effectif, et T60 montre une sortie DISP\npuis une entrée REM à son retour. Même valeur dans la requête de l'effectif et\ndans celle de T60, sinon la fin de T60 ne retombe plus sur T58.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "HORS_EFFECTIF : il sort de l'effectif, et T60 montre une sortie DISP\npuis une entrée REM à son retour. Même valeur dans la requête de l'effectif et\ndans celle de T60, sinon la fin de T60 ne retombe plus sur T58.",
      "autoResize": true,
      "lineHeight": 1.25
    },
