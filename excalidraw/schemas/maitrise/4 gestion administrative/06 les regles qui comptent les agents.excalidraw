      "versionNonce": 1894456222,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794974047771,
      "link": null,
      "locked": false,
      "text": "Si on te demande : et un agent détaché ou suspendu ?",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Si on te demande : et un agent détaché ou suspendu ?",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "eVqzPFSCr9VEHxkhnJHf",
      "type": "text",
      "x": 1345.0,
      "y": 3559.5,
      "width": 1134.3600000000001,
      "height": 45.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "DB9zqroGkIvuAIqP39p8"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1733961385,
      "version": 1,
      "versionNonce": 1474945606,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794974047771,
      "link": null,
      "locked": false,
      "text": "Il reste compté, et compté actif : ces absences n'ont pas de paire de décisions début et fin. Au 31/12/2024, un seul\npermanent est dans ce cas (point 14).",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Il reste compté, et compté actif : ces absences n'ont pas de paire de décisions début et fin. Au 31/12/2024, un seul\npermanent est dans ce cas (point 14).",
      "autoResize": true,
      "lineHeight": 1.25
    },
