    },
    {
      "id": "TDv3odrKTE5fa05o0ZTl",
      "type": "text",
      "x": 45.0,
      "y": 1289.5,
      "width": 751.32,
      "height": 45.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "6jOOiAB0eJaWLQXpnFcP"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1392747340,
      "version": 1,
      "versionNonce": 2026980292,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794974047771,
      "link": null,
      "locked": false,
      "text": "Avant le 05/11/2026, la requête exigeait une fiche ACTIF : ces agents\nn'étaient comptés nulle part, et les recrutements de fin d'année se perdaient.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Avant le 05/11/2026, la requête exigeait une fiche ACTIF : ces agents\nn'étaient comptés nulle part, et les recrutements de fin d'année se perdaient.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "4QL1vCM4VOFzM89Z7Gq9",
      "type": "text",
      "x": 45.0,
      "y": 1350.5,
      "width": 81.28,
      "height": 20.0,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "6jOOiAB0eJaWLQXpnFcP"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 167515251,
      "version": 1,
      "versionNonce": 394296460,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794974047771,
      "link": null,
      "locked": false,
      "text": "La preuve",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "La preuve",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "NAloLttNu7gxwc3LniAF",
      "type": "text",
      "x": 45.0,
      "y": 1374.5,
      "width": 723.6,
      "height": 67.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "6jOOiAB0eJaWLQXpnFcP"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 970370192,
      "version": 1,
      "versionNonce": 275719148,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794974047771,
      "link": null,
      "locked": false,
      "text": "67 fiches sans état. Mais 5 sont de vieilles fiches jamais fermées : elles\najoutent 5 permanents de 69 à 80 ans au 31/12/2024, alors que l'annuaire\nn'en publie aucun de 60 ans et plus. Sans elles : 736 permanents.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "67 fiches sans état. Mais 5 sont de vieilles fiches jamais fermées : elles\najoutent 5 permanents de 69 à 80 ans au 31/12/2024, alors que l'annuaire\nn'en publie aucun de 60 ans et plus. Sans elles : 736 permanents.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "2rQs1p7bzYQgNTTvEr7D",
      "type": "text",
      "x": 45.0,
      "y": 1458.0,
      "width": 340.32,
      "height": 20.0,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "6jOOiAB0eJaWLQXpnFcP"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1124691086,
      "version": 1,
      "versionNonce": 641744625,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794974047771,
      "link": null,
      "locked": false,
      "text": "Si on te demande : comment on corrige ?",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Si on te demande : comment on corrige ?",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "AQDY8Na5xOecatPx6Lry",
      "type": "text",
      "x": 45.0,
      "y": 1482.0,
      "width": 754.9200000000001,
      "height": 67.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "6jOOiAB0eJaWLQXpnFcP"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1352364011,
      "version": 1,
      "versionNonce": 1153858037,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794974047771,
      "link": null,
      "locked": false,
      "text": "Une fiche sans état ne comptera que si l'entrée est récente. La DRH doit dire\nau bout de combien de temps une fiche sans état est celle d'un agent parti\n(point 45).",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Une fiche sans état ne comptera que si l'entrée est récente. La DRH doit dire\nau bout de combien de temps une fiche sans état est celle d'un agent parti\n(point 45).",
      "autoResize": true,
      "lineHeight": 1.25
    },
