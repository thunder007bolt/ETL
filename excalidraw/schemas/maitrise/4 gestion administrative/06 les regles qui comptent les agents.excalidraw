    },
    {
      "id": "4W2DQPU3hCJJLTcUnXsM",
      "type": "text",
      "x": 911.6666666666666,
      "y": 1204.5,
      "width": 759.6,
      "height": 90.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "q47eQbmwompzQWdyJYTf"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1537149691,
      "version": 1,
      "versionNonce": 1267469875,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794974047771,
      "link": null,
      "locked": false,
      "text": "Un temporaire est compté si la date d'arrêté tombe dans un de ses contrats. Un\ncontrat commence à la décision 50, l'engagement d'un temporaire. Il finit au\npremier départ saisi après ce début ; sinon la veille du contrat suivant ;\nsinon aucune fin n'est connue et l'agent reste compté.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Un temporaire est compté si la date d'arrêté tombe dans un de ses contrats. Un\ncontrat commence à la décision 50, l'engagement d'un temporaire. Il finit au\npremier départ saisi après ce début ; sinon la veille du contrat suivant ;\nsinon aucune fin n'est connue et l'agent reste compté.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "wIrdg6Pd5CuNgFwBVE2y",
      "type": "text",
      "x": 911.6666666666666,
      "y": 1310.5,
      "width": 74.56,
      "height": 20.0,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
