    },
    {
      "id": "9hMTwES4mRk1B1hCowUW",
      "type": "text",
      "x": 1778.3333333333333,
      "y": 2091.5,
      "width": 729.36,
      "height": 45.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "KHEKW0oQesUE2PhOXwnZ"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1826914767,
      "version": 1,
      "versionNonce": 807834432,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794974047771,
      "link": null,
      "locked": false,
      "text": "Avant, un âge inconnu faisait disparaître l'agent du tableau : on perdait un\nagent pour une date manquante.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Avant, un âge inconnu faisait disparaître l'agent du tableau : on perdait un\nagent pour une date manquante.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "bhLAFVlcpjzs2jGlVOTz",
      "type": "text",
      "x": 1778.3333333333333,
      "y": 2152.5,
      "width": 81.28,
      "height": 20.0,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
