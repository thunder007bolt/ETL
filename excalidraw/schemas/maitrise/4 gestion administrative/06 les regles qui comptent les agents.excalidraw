      "roundness": null,
      "seed": 753495171,
      "version": 1,
      "versionNonce": 1655908814,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794974047771,
      "link": null,
      "locked": false,
      "text": "299 temporaires au 31/12/2024 pour 46 contractuels publiés, et le stock\nmonte chaque année : 237 fin 2020, 338 fin 2025. En ne gardant que les\nfiches non inactives : 47 fin 2024.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "299 temporaires au 31/12/2024 pour 46 contractuels publiés, et le stock\nmonte chaque année : 237 fin 2020, 338 fin 2025. En ne gardant que les\nfiches non inactives : 47 fin 2024.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "nL59Ksz9Bq6wOEbBsHkC",
      "type": "text",
      "x": 911.6666666666666,
      "y": 1525.5,
      "width": 368.8,
      "height": 20.0,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "q47eQbmwompzQWdyJYTf"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1244980832,
      "version": 1,
      "versionNonce": 1005136124,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794974047771,
      "link": null,
      "locked": false,
      "text": "Si on te demande : pourquoi six fois trop ?",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Si on te demande : pourquoi six fois trop ?",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "HfuFo3lnZ3XPQSpfkSTb",
      "type": "text",
      "x": 911.6666666666666,
      "y": 1549.5,
      "width": 737.6400000000001,
      "height": 45.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "q47eQbmwompzQWdyJYTf"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 688000072,
      "version": 1,
      "versionNonce": 789247797,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794974047771,
      "link": null,
      "locked": false,
      "text": "Parce que les fins de contrat ne sont pas saisies : presque personne ne sort.\nC'est le premier point à trancher avec la DRH (point 20).",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Parce que les fins de contrat ne sont pas saisies : presque personne ne sort.\nC'est le premier point à trancher avec la DRH (point 20).",
      "autoResize": true,
      "lineHeight": 1.25
    },
