      "isDeleted": false,
      "boundElements": [],
      "updated": 1794974047771,
      "link": null,
      "locked": false,
      "text": "Chaque agent est rangé d'après sa dernière situation commencée au plus tard à\nla date d'arrêté : permanent ou temporaire. Les tableaux CIPRES ne gardent\nque les agents de la CNSS (qualité A) ; la fonction publique (B) et les agents\naffectés (C) restent dans la table, écartés par un filtre.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Chaque agent est rangé d'après sa dernière situation commencée au plus tard à\nla date d'arrêté : permanent ou temporaire. Les tableaux CIPRES ne gardent\nque les agents de la CNSS (qualité A) ; la fonction publique (B) et les agents\naffectés (C) restent dans la table, écartés par un filtre.",
      "autoResize": true,
      "lineHeight": 1.25
    },
