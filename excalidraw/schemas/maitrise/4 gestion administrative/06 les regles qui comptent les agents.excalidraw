      "versionNonce": 633475783,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794974047771,
      "link": null,
      "locked": false,
      "text": "Ne pas confondre avec la date de la copie de la base : la date d'arrêté est une date de calcul, la copie est l'état de la base\nle jour où on l'a prise.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Ne pas confondre avec la date de la copie de la base : la date d'arrêté est une date de calcul, la copie est l'état de la base\nle jour où on l'a prise.",
      "autoResize": true,
      "lineHeight": 1.25
    },
