    },
    {
      "id": "Yb46m4v93rOgF8x96GoN",
      "type": "text",
      "x": 911.6666666666666,
      "y": 1334.5,
      "width": 761.04,
      "height": 67.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "q47eQbmwompzQWdyJYTf"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 931455794,
      "version": 1,
      "versionNonce": 445796847,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794974047771,
      "link": null,
      "locked": false,
      "text": "La base ne garde pas la fin prévue d'un contrat, et la BI ne fixe pas une durée\nà la place de la CNSS (réunion du 03/11/2026 : l'ancien réglage de 18 mois a\nété supprimé).",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "La base ne garde pas la fin prévue d'un contrat, et la BI ne fixe pas une durée\nà la place de la CNSS (réunion du 03/11/2026 : l'ancien réglage de 18 mois a\nété supprimé).",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "IqwF1KQhMRcu6iXfQxwI",
      "type": "text",
      "x": 911.6666666666666,
      "y": 1418.0,
      "width": 81.28,
      "height": 20.0,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
