      "type": "text",
      "x": 911.6666666666666,
      "y": 4807.0,
      "width": 743.94,
      "height": 90.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
