      "boundElements": [],
      "updated": 1794974047771,
      "link": null,
      "locked": false,
      "text": "Avec cette règle, chaque tranche de T61 est à 4 agents près de l'annuaire au\n31/12/2024. Exemple : prise de service en 2008, disponibilité de 2015 à\n2018 ; fin 2024, l'agent a 13 ans d'ancienneté et non 17.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Avec cette règle, chaque tranche de T61 est à 4 agents près de l'annuaire au\n31/12/2024. Exemple : prise de service en 2008, disponibilité de 2015 à\n2018 ; fin 2024, l'agent a 13 ans d'ancienneté et non 17.",
      "autoResize": true,
      "lineHeight": 1.25
    },
