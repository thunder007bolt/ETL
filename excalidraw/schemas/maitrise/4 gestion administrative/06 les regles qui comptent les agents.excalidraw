      "boundElements": [],
      "updated": 1794974047771,
      "link": null,
      "locked": false,
      "text": "une retraite qui prend effet le 15/12/2024 : l'agent n'est pas compté au 31/12/2024. Si elle prend effet le\n15/01/2025, il est compté.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "une retraite qui prend effet le 15/12/2024 : l'agent n'est pas compté au 31/12/2024. Si elle prend effet le\n15/01/2025, il est compté.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "FbBCcRtZj0B2HCbDKEEg",
