    {
      "id": "LV8gcrLDnyo5VZhZhkfy",
      "type": "text",
      "x": 911.6666666666666,
      "y": 1442.0,
      "width": 721.8000000000001,
      "height": 67.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "q47eQbmwompzQWdyJYTf"
      ],
