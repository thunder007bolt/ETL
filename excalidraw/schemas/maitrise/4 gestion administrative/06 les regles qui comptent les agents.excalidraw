    },
    {
      "id": "LEwmzgHEBHZ43UVDjeZj",
      "type": "text",
      "x": 911.6666666666666,
      "y": 2874.0,
      "width": 748.8000000000001,
      "height": 67.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
