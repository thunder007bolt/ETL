      "isDeleted": false,
      "boundElements": [],
      "updated": 1794974047771,
      "link": null,
      "locked": false,
      "text": "Sans date d'arrêt commune, le même tableau change à chaque nouveau chargement. C'est la règle 2 de la fiche des règles\nCIPRES, valable pour tous les tableaux, prestations comprises.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Sans date d'arrêt commune, le même tableau change à chaque nouveau chargement. C'est la règle 2 de la fiche des règles\nCIPRES, valable pour tous les tableaux, prestations comprises.",
      "autoResize": true,
      "lineHeight": 1.25
    },
