    },
    {
      "id": "2hqvAACK6K7yCQcHVsfM",
      "type": "text",
      "x": 1778.3333333333333,
      "y": 1961.5,
      "width": 729.18,
      "height": 90.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "KHEKW0oQesUE2PhOXwnZ"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1781263390,
      "version": 1,
      "versionNonce": 563322334,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794974047771,
      "link": null,
      "locked": false,
      "text": "L'âge est le nombre d'années pleines à la date d'arrêté. Les tranches sont\ncelles de l'Annuaire CIPRES : moins de 20 ans, 20-24… 55-59, 60 et plus.\nSans date de naissance, ou avec un âge hors de 0 à 119 ans, l'agent reste\ncompté, avec une tranche vide.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "L'âge est le nombre d'années pleines à la date d'arrêté. Les tranches sont\ncelles de l'Annuaire CIPRES : moins de 20 ans, 20-24… 55-59, 60 et plus.\nSans date de naissance, ou avec un âge hors de 0 à 119 ans, l'agent reste\ncompté, avec une tranche vide.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "eLww8jhXlZnncWIPvFBd",
      "type": "text",
      "x": 1778.3333333333333,
      "y": 2067.5,
      "width": 74.56,
      "height": 20.0,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
