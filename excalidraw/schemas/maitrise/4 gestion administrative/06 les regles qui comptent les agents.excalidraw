      "seed": 1367203550,
      "version": 1,
      "versionNonce": 1774122929,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794974047771,
      "link": null,
      "locked": false,
      "text": "Une fiche dont l'état est vide compte comme encore là. Ce sont en général des\nembauches récentes, que l'application n'a pas encore passées à ACTIF.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Une fiche dont l'état est vide compte comme encore là. Ce sont en général des\nembauches récentes, que l'application n'a pas encore passées à ACTIF.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "JXEa5aP6qpphT5JMLgyB",
      "type": "text",
      "x": 45.0,
      "y": 1265.5,
      "width": 74.56,
