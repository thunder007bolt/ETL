      "isDeleted": false,
      "boundElements": [],
      "updated": 1794974047771,
      "link": null,
      "locked": false,
      "text": "qui est compté dans l'effectif à une date, comment chaque agent est rangé par catégorie, âge, sexe, ancienneté et domaine, d'où vient le taux d'encadrement, et\nce qu'un réglage de la requête permet de changer sans la réécrire.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "qui est compté dans l'effectif à une date, comment chaque agent est rangé par catégorie, âge, sexe, ancienneté et domaine, d'où vient le taux d'encadrement, et\nce qu'un réglage de la requête permet de changer sans la réécrire.",
      "autoResize": true,
      "lineHeight": 1.25
    },
