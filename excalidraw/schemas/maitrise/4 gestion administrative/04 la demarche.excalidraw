      "seed": 404453565,
      "version": 1,
      "versionNonce": 1922926032,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794974047640,
      "link": null,
      "locked": false,
      "text": "Toute décision en attente devient un réglage écrit en tête de la requête, dans\nla partie « parametres » : la disponibilité dans ou hors de l'effectif, la fin\nd'un contrat inconnue, le regroupement des catégories, la périodicité.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Toute décision en attente devient un réglage écrit en tête de la requête, dans\nla partie « parametres » : la disponibilité dans ou hors de l'effectif, la fin\nd'un contrat inconnue, le regroupement des catégories, la périodicité.",
      "autoResize": true,
      "lineHeight": 1.25
    },
