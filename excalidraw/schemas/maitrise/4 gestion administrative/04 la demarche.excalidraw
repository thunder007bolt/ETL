      "versionNonce": 1058574020,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794974047640,
      "link": null,
      "locked": false,
      "text": "Les requêtes corrigées enveloppées dans un comptage (Q70 à Q74), un\ndiagnostic des résultats vides (Q75 à Q79), un nouveau test avec le cliché\nécrit en clair (Q80 à Q84), puis les temporaires et l'axe « type d'agent »\n(Q85 à Q94).",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Les requêtes corrigées enveloppées dans un comptage (Q70 à Q74), un\ndiagnostic des résultats vides (Q75 à Q79), un nouveau test avec le cliché\nécrit en clair (Q80 à Q84), puis les temporaires et l'axe « type d'agent »\n(Q85 à Q94).",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "3TizaWqvEzVszHeq6cwY",
      "type": "text",
      "x": 1778.3333333333333,
      "y": 810.5,
      "width": 145.60000000000002,
      "height": 20.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
