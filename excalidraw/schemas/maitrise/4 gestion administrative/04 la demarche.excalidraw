      "type": "text",
      "x": 45.0,
      "y": 2411.5,
      "width": 756.36,
      "height": 67.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
