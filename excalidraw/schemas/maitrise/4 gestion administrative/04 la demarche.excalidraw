      "versionNonce": 861475489,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794974047640,
      "link": null,
      "locked": false,
      "text": "T60 ne peut pas venir de cette table : il faudra la réécrire. L'effectif se\nrecalcule depuis la fiche de l'agent et les décisions.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
