        "9KPpsu3XJjxe6n3D9IiW"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1787246077,
      "version": 1,
      "versionNonce": 1819879401,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794974047640,
      "link": null,
      "locked": false,
      "text": "Ce que ça a changé",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Ce que ça a changé",
