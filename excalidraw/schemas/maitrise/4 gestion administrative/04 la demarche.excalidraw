      "boundElements": [],
      "updated": 1794974047640,
      "link": null,
      "locked": false,
      "text": "Un fichier par lot, numéroté dans l'ordre d'exécution. Les requêtes portent un\nnuméro, Q01 à Q159, jamais réutilisé. L'en-tête de chacune donne son\nobjectif, les tableaux visés, le résultat obtenu et le constat.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Un fichier par lot, numéroté dans l'ordre d'exécution. Les requêtes portent un\nnuméro, Q01 à Q159, jamais réutilisé. L'en-tête de chacune donne son\nobjectif, les tableaux visés, le résultat obtenu et le constat.",
      "autoResize": true,
      "lineHeight": 1.25
    },
