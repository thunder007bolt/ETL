      "updated": 1794974047640,
      "link": null,
      "locked": false,
      "text": "25 requêtes (Q118 à Q142) du 02 au 07/11/2026 : classement avant et après\nune formation, unités administratives, décisions face aux situations, agents\npartis puis revenus.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "25 requêtes (Q118 à Q142) du 02 au 07/11/2026 : classement avant et après\nune formation, unités administratives, décisions face aux situations, agents\npartis puis revenus.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "FRbqSKJAuekv5i3EjEMu",
      "type": "text",
      "x": 911.6666666666666,
      "y": 1423.0,
      "width": 145.60000000000002,
      "height": 20.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
