    {
      "id": "lvs9F8eqXKNB2e83cIQv",
      "type": "text",
      "x": 45.0,
      "y": 812.0,
      "width": 757.44,
      "height": 157.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "9bFPRj3xdfnHcBkIdPlY"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1459359642,
      "version": 1,
      "versionNonce": 1284623005,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794974047640,
      "link": null,
      "locked": false,
      "text": "GRH_MOUVEMENT ne contient presque que des mouvements internes : 6 127\nlignes, dont 4 040 validées, et aucune ligne de recrutement, de retraite ni de\ndécès. Les entrées se lisent sur la fiche de l'agent (GRH_PERSONNE, la date\nd'embauche), les sorties dans les décisions. Des codes trompent : REC veut\ndire reclassement, RET rétrogradation, DIS mise à disposition. La règle\nd'effectif du DTM compte 2 845 agents au 31/12/2025, pour 879 agents\nréellement actifs.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "GRH_MOUVEMENT ne contient presque que des mouvements internes : 6 127\nlignes, dont 4 040 validées, et aucune ligne de recrutement, de retraite ni de\ndécès. Les entrées se lisent sur la fiche de l'agent (GRH_PERSONNE, la date\nd'embauche), les sorties dans les décisions. Des codes trompent : REC veut\ndire reclassement, RET rétrogradation, DIS mise à disposition. La règle\nd'effectif du DTM compte 2 845 agents au 31/12/2025, pour 879 agents\nréellement actifs.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "FNh3FyigQ7gj1iTP6Yk0",
