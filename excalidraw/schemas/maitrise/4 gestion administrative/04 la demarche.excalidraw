      "link": null,
      "locked": false,
      "text": "Toutes les requêtes de profilage lisent USER_GRH, la copie de la base de\nl'application du personnel. Les contrôles du 17/11 sont des copies des\nrequêtes proposées, réécrites sur ces mêmes tables.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Toutes les requêtes de profilage lisent USER_GRH, la copie de la base de\nl'application du personnel. Les contrôles du 17/11 sont des copies des\nrequêtes proposées, réécrites sur ces mêmes tables.",
      "autoResize": true,
      "lineHeight": 1.25
    },
