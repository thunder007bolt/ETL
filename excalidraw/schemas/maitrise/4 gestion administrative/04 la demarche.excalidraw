      "isDeleted": false,
      "boundElements": [],
      "updated": 1794974047640,
      "link": null,
      "locked": false,
      "text": "La réponse de la CNSS change une valeur, pas la requête. On continue à avancer\nsans attendre, et la question reste visible dans les points à valider.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "La réponse de la CNSS change une valeur, pas la requête. On continue à avancer\nsans attendre, et la question reste visible dans les points à valider.",
      "autoResize": true,
      "lineHeight": 1.25
    },
