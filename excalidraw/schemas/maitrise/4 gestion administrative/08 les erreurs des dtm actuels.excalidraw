      "updated": 1794974047989,
      "link": null,
      "locked": false,
      "text": "Elle appelle inactif un agent dont la position de situation vaut détaché, mis à\ndisposition, en disponibilité, suspendu ou sous les drapeaux.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Elle appelle inactif un agent dont la position de situation vaut détaché, mis à\ndisposition, en disponibilité, suspendu ou sous les drapeaux.",
      "autoResize": true,
      "lineHeight": 1.25
    },
