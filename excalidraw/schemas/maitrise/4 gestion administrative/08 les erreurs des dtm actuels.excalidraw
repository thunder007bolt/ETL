      "roundness": null,
      "seed": 560982841,
      "version": 1,
      "versionNonce": 361412351,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794974047989,
      "link": null,
      "locked": false,
      "text": "Le total des jours de formation reste approximatif. La correction E15 n'est\npas faite : il faut d'abord savoir si certaines durées sont de vrais mois.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Le total des jours de formation reste approximatif. La correction E15 n'est\npas faite : il faut d'abord savoir si certaines durées sont de vrais mois.",
      "autoResize": true,
      "lineHeight": 1.25
    },
