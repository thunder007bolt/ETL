      "type": "text",
      "x": 1778.3333333333333,
      "y": 2194.5,
      "width": 753.6600000000001,
      "height": 67.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "ELQhWJ3zcBjOdzq7cWtA"
      ],
