      "type": "text",
      "x": 45.0,
      "y": 2547.0,
      "width": 726.48,
      "height": 45.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
