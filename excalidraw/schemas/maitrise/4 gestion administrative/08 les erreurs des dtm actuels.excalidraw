      "type": "text",
      "x": 1778.3333333333333,
      "y": 1272.0,
      "width": 736.3800000000001,
      "height": 90.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "adKQB0JOw18uBbAFeAXy"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1389318242,
      "version": 1,
      "versionNonce": 2138756200,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794974047989,
      "link": null,
      "locked": false,
      "text": "704 agents perdus sur 2 822 au 31/12/2025 : 329 par l'âge, 461 par\nl'ancienneté. La tranche « moins d'un an » (de 0 à 0) ne reçoit jamais\npersonne, donc aucun recruté de l'année n'est compté. 2 822 moins 704 donne\nexactement les 2 118 publiés.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "704 agents perdus sur 2 822 au 31/12/2025 : 329 par l'âge, 461 par\nl'ancienneté. La tranche « moins d'un an » (de 0 à 0) ne reçoit jamais\npersonne, donc aucun recruté de l'année n'est compté. 2 822 moins 704 donne\nexactement les 2 118 publiés.",
      "autoResize": true,
      "lineHeight": 1.25
    },
