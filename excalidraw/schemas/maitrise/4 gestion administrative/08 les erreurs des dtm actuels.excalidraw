    },
    {
      "id": "BtWvJQzKX0AHa1bceB1o",
      "type": "text",
      "x": 45.0,
      "y": 3029.5,
      "width": 699.84,
      "height": 90.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "0snY9JII3kfCIkBqwDuj"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 383256598,
      "version": 1,
      "versionNonce": 2069535202,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794974047989,
      "link": null,
      "locked": false,
      "text": "Elle va chercher les inscriptions dans la base de l'application\n(USER_GRH.GRH_INSCRIPTION) au lieu des faits de l'entrepôt, et sa\ndimension des catégories vient d'une table GRH_CAT_FORMATION qui\nn'existe pas.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Elle va chercher les inscriptions dans la base de l'application\n(USER_GRH.GRH_INSCRIPTION) au lieu des faits de l'entrepôt, et sa\ndimension des catégories vient d'une table GRH_CAT_FORMATION qui\nn'existe pas.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "kMGm5ZnBxmmz5iuBRCme",
      "type": "text",
      "x": 45.0,
      "y": 3135.5,
      "width": 154.56,
      "height": 20.0,
      "angle": 0,
      "strokeColor": "#c92a2a",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "0snY9JII3kfCIkBqwDuj"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1214793608,
      "version": 1,
      "versionNonce": 1021685222,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794974047989,
      "link": null,
      "locked": false,
      "text": "Ce qu'on a vérifié",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Ce qu'on a vérifié",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "57XFah7myzbNC091Jsn8",
      "type": "text",
      "x": 45.0,
      "y": 3159.5,
      "width": 730.44,
      "height": 67.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "0snY9JII3kfCIkBqwDuj"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1276451289,
      "version": 1,
      "versionNonce": 1145741376,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794974047989,
      "link": null,
      "locked": false,
      "text": "la table n'existe pas dans la base : la dimension du DTM a été remplie à la\nmain. L'application ne connaît que deux catégories (perfectionnement et\ndiplômante), alors que quatre sont saisies.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "la table n'existe pas dans la base : la dimension du DTM a été remplie à la\nmain. L'application ne connaît que deux catégories (perfectionnement et\ndiplômante), alors que quatre sont saisies.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "Yv0l091xbzUrMIaVxeVm",
      "type": "text",
      "x": 45.0,
      "y": 3243.0,
      "width": 139.52,
      "height": 20.0,
      "angle": 0,
      "strokeColor": "#c92a2a",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "0snY9JII3kfCIkBqwDuj"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 2147031004,
      "version": 1,
      "versionNonce": 1483731288,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794974047989,
      "link": null,
      "locked": false,
      "text": "Ce que ça change",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Ce que ça change",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "V9zz3cIfHG6UDNiuyNlQ",
      "type": "text",
      "x": 45.0,
      "y": 3267.0,
      "width": 712.44,
      "height": 45.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "0snY9JII3kfCIkBqwDuj"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1941020563,
      "version": 1,
      "versionNonce": 989469756,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794974047989,
      "link": null,
      "locked": false,
      "text": "Une table du DTM ne devrait pas dépendre de la base de production, et le\nchiffre ne suit plus le cliché. C'est la correction E17, pas encore faite.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Une table du DTM ne devrait pas dépendre de la base de production, et le\nchiffre ne suit plus le cliché. C'est la correction E17, pas encore faite.",
      "autoResize": true,
      "lineHeight": 1.25
    },
