      "isDeleted": false,
      "boundElements": [],
      "updated": 1794974047989,
      "link": null,
      "locked": false,
      "text": "cette table n'a que des mouvements internes : 6 127 lignes, aucune de\nrecrutement, de retraite, de décès, de démission ni de licenciement. Et DIS\nveut dire mise à disposition, pas disponibilité.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "cette table n'a que des mouvements internes : 6 127 lignes, aucune de\nrecrutement, de retraite, de décès, de démission ni de licenciement. Et DIS\nveut dire mise à disposition, pas disponibilité.",
      "autoResize": true,
      "lineHeight": 1.25
    },
