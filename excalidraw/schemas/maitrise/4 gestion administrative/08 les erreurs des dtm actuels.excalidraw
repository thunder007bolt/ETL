    },
    {
      "id": "muBYtJFJxJ4hMUeVI70V",
      "type": "text",
      "x": 45.0,
      "y": 2632.0,
      "width": 752.4000000000001,
      "height": 67.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "ln51VVbb9Y2ddZWmhf5x"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 696857707,
      "version": 1,
      "versionNonce": 761486886,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794974047989,
      "link": null,
      "locked": false,
      "text": "9 357 inscriptions sont en jours, 139 en mois, 11 en années, 1 en KG et 1 en\nCFA ; les « mois » et les « années » sont en fait des jours mal saisis, et une\ndurée vaut −17.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "9 357 inscriptions sont en jours, 139 en mois, 11 en années, 1 en KG et 1 en\nCFA ; les « mois » et les « années » sont en fait des jours mal saisis, et une\ndurée vaut −17.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "XzhttEIRBNvv99nBAHPY",
      "type": "text",
      "x": 45.0,
      "y": 2715.5,
      "width": 139.52,
      "height": 20.0,
      "angle": 0,
      "strokeColor": "#c92a2a",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
