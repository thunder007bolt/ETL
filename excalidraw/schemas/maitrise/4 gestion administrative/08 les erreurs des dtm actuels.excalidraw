      "isDeleted": false,
      "boundElements": [],
      "updated": 1794974047989,
      "link": null,
      "locked": false,
      "text": "Le coût des formations de T64 était sous-estimé d'un montant inconnu. Un\nfrais vide compte maintenant pour zéro (correction E13).",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Le coût des formations de T64 était sous-estimé d'un montant inconnu. Un\nfrais vide compte maintenant pour zéro (correction E13).",
