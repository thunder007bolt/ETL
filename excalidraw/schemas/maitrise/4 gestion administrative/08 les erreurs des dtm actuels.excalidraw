      "versionNonce": 863897585,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794974047989,
      "link": null,
      "locked": false,
      "text": "la formule est bien celle-là, et les frais sont souvent incomplets ; mais la\nmesure de l'effet (Q62) n'a pas été reçue, le filtre du statut T ayant vidé le\npremier essai.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "la formule est bien celle-là, et les frais sont souvent incomplets ; mais la\nmesure de l'effet (Q62) n'a pas été reçue, le filtre du statut T ayant vidé le\npremier essai.",
      "autoResize": true,
      "lineHeight": 1.25
    },
