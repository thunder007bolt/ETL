      "boundElements": [],
      "updated": 1794974047989,
      "link": null,
      "locked": false,
      "text": "Elle lit la table des mouvements de l'application (GRH_MOUVEMENT), ne\ngarde que les lignes validées, et convertit DIS en DISP (disponibilité) et\nDET en DETAC (détachement).",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Elle lit la table des mouvements de l'application (GRH_MOUVEMENT), ne\ngarde que les lignes validées, et convertit DIS en DISP (disponibilité) et\nDET en DETAC (détachement).",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
