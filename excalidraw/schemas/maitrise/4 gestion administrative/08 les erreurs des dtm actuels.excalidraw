      "boundElements": [],
      "updated": 1794974047989,
      "link": null,
      "locked": false,
      "text": "T62 et T64 ne publiaient aucune ligne depuis 2019, alors que la base a,\ndepuis cette année-là, 30 à 45 formations et 435 à 886 inscriptions par an.\nC'est la correction E12.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "T62 et T64 ne publiaient aucune ligne depuis 2019, alors que la base a,\ndepuis cette année-là, 30 à 45 formations et 435 à 886 inscriptions par an.\nC'est la correction E12.",
      "autoResize": true,
      "lineHeight": 1.25
    },
