      "seed": 61429985,
      "version": 1,
      "versionNonce": 624499725,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794974047989,
      "link": null,
      "locked": false,
      "text": "Elle additionne les durées des inscriptions comme des jours, sans regarder\nl'unité saisie à côté.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Elle additionne les durées des inscriptions comme des jours, sans regarder\nl'unité saisie à côté.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
