      "version": 1,
      "versionNonce": 859518607,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794974047989,
      "link": null,
      "locked": false,
      "text": "Elle additionnait les sept frais d'une inscription avec un simple « + », ce qui\ndonne un total vide dès qu'un seul frais manque.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Elle additionnait les sept frais d'une inscription avec un simple « + », ce qui\ndonne un total vide dès qu'un seul frais manque.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
