      "type": "text",
      "x": 1778.3333333333333,
      "y": 1187.0,
      "width": 753.1200000000001,
      "height": 45.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
