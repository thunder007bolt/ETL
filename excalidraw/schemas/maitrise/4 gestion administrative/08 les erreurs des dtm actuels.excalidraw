    },
    {
      "id": "JKhTBxqOVzqgeq9OMFG3",
      "type": "text",
      "x": 45.0,
      "y": 1647.0,
      "width": 740.34,
      "height": 45.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "iVE21UxjdtXvlMCweYGK"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 339088497,
      "version": 1,
      "versionNonce": 1111819365,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794974047989,
      "link": null,
      "locked": false,
      "text": "Les tranches d'âge de l'entrepôt vont de « moins de 25 » à « 55 et plus », et\nles tranches d'ancienneté s'arrêtent à « 30 et plus ».",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Les tranches d'âge de l'entrepôt vont de « moins de 25 » à « 55 et plus », et\nles tranches d'ancienneté s'arrêtent à « 30 et plus ».",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "2ODeDypix1gO7uT4GdB1",
      "type": "text",
      "x": 45.0,
      "y": 1708.0,
      "width": 154.56,
      "height": 20.0,
      "angle": 0,
      "strokeColor": "#c92a2a",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "iVE21UxjdtXvlMCweYGK"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1575457949,
      "version": 1,
      "versionNonce": 677028933,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794974047989,
      "link": null,
      "locked": false,
      "text": "Ce qu'on a vérifié",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Ce qu'on a vérifié",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "p0VGWU3pIdoa6IPOigE8",
      "type": "text",
      "x": 45.0,
      "y": 1732.0,
      "width": 757.98,
      "height": 67.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "iVE21UxjdtXvlMCweYGK"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 25956647,
      "version": 1,
      "versionNonce": 256417712,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794974047989,
      "link": null,
      "locked": false,
      "text": "l'Annuaire CIPRES demande, pour T58, « moins de 20 », 20-24, puis 55-59 et\n« 60 ans et plus » ; pour T61, il va jusqu'à 30-34, 35-39 et « 40 ans et plus\n».",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "l'Annuaire CIPRES demande, pour T58, « moins de 20 », 20-24, puis 55-59 et\n« 60 ans et plus » ; pour T61, il va jusqu'à 30-34, 35-39 et « 40 ans et plus\n».",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "OXw1245ikNPswrE6N7ys",
      "type": "text",
      "x": 45.0,
      "y": 1815.5,
      "width": 139.52,
      "height": 20.0,
      "angle": 0,
      "strokeColor": "#c92a2a",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "iVE21UxjdtXvlMCweYGK"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 2140940059,
      "version": 1,
      "versionNonce": 577878720,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794974047989,
      "link": null,
      "locked": false,
      "text": "Ce que ça change",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Ce que ça change",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "r7n4vK8agvGvsmT44jfD",
      "type": "text",
      "x": 45.0,
      "y": 1839.5,
      "width": 756.72,
      "height": 67.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "iVE21UxjdtXvlMCweYGK"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 762564580,
      "version": 1,
      "versionNonce": 1124143135,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794974047989,
      "link": null,
      "locked": false,
      "text": "Quatre lignes manquent à T58 et trois à T61 : les maquettes de l'Annuaire ne\npeuvent pas être remplies telles quelles. Les tranches CIPRES sont écrites\ndans les requêtes proposées.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Quatre lignes manquent à T58 et trois à T61 : les maquettes de l'Annuaire ne\npeuvent pas être remplies telles quelles. Les tranches CIPRES sont écrites\ndans les requêtes proposées.",
      "autoResize": true,
      "lineHeight": 1.25
    },
