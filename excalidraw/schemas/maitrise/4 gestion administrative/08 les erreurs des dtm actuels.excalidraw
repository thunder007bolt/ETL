      "isDeleted": false,
      "boundElements": [],
      "updated": 1794974047989,
      "link": null,
      "locked": false,
      "text": "Le budget de T64 était faux deux fois : mauvaise donnée, et comptée autant de\nfois qu'il y a d'inscrits. Il est désormais laissé vide, en attendant la\ncomptabilité.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Le budget de T64 était faux deux fois : mauvaise donnée, et comptée autant de\nfois qu'il y a d'inscrits. Il est désormais laissé vide, en attendant la\ncomptabilité.",
      "autoResize": true,
      "lineHeight": 1.25
    },
