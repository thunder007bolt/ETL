      "isDeleted": false,
      "boundElements": [],
      "updated": 1794974047989,
      "link": null,
      "locked": false,
      "text": "T60 n'a aucune de ses lignes principales : ni effectif de début ou de fin, ni\nrecrutements, ni retraites, ni décès. La requête est à réécrire entièrement.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "T60 n'a aucune de ses lignes principales : ni effectif de début ou de fin, ni\nrecrutements, ni retraites, ni décès. La requête est à réécrire entièrement.",
