      "version": 1,
      "versionNonce": 2061154328,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794974047989,
      "link": null,
      "locked": false,
      "text": "Elle compare l'âge et l'ancienneté à la borne haute de chaque tranche avec « <\n», alors que cette borne est incluse dans la table des tranches.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Elle compare l'âge et l'ancienneté à la borne haute de chaque tranche avec « <\n», alors que cette borne est incluse dans la table des tranches.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "jipM18oB9R6bpOUZm0Mj",
      "type": "text",
      "x": 1778.3333333333333,
      "y": 1248.0,
      "width": 154.56,
      "height": 20.0,
      "angle": 0,
