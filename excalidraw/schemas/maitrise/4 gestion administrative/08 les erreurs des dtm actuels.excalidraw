      "boundElements": [],
      "updated": 1794974047989,
      "link": null,
      "locked": false,
      "text": "2 845 agents comptés au 31/12/2025, pour 879 actifs réels, dont 1 915\nfiches inactives ; et l'effectif publié monte chaque année, de 2 472 en 2019 à\n2 845 en 2025, parce que les partants s'y accumulent.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "2 845 agents comptés au 31/12/2025, pour 879 actifs réels, dont 1 915\nfiches inactives ; et l'effectif publié monte chaque année, de 2 472 en 2019 à\n2 845 en 2025, parce que les partants s'y accumulent.",
      "autoResize": true,
      "lineHeight": 1.25
    },
