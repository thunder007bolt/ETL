      "link": null,
      "locked": false,
      "text": "Ne pas confondre la qualité (A, B, C) avec la nature de\nl'emploi (permanent ou temporaire) : un agent de la\nfonction publique est permanent, mais pas compté.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Ne pas confondre la qualité (A, B, C) avec la nature de\nl'emploi (permanent ou temporaire) : un agent de la\nfonction publique est permanent, mais pas compté.",
      "autoResize": true,
      "lineHeight": 1.25
    },
