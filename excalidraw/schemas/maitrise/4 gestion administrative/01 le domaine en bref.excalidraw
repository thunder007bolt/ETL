      "isDeleted": false,
      "boundElements": [],
      "updated": 1794974047436,
      "link": null,
      "locked": false,
      "text": "Chaque année, effectif de début + entrées − sorties = effectif de fin, et la\nfin d'une année est le début de la suivante.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Chaque année, effectif de début + entrées − sorties = effectif de fin, et la\nfin d'une année est le début de la suivante.",
      "autoResize": true,
      "lineHeight": 1.25
    },
