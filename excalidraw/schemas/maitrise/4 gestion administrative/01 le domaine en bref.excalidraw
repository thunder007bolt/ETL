      "boundElements": [],
      "updated": 1794974047436,
      "link": null,
      "locked": false,
      "text": "2024 : 670 au début, 101 recrutements, 0 autre entrée, 24 retraites, 5 décès,\n1 autre sortie, 741 à la fin. L'annuaire : 767, 104, 7, 23, 3, 94, 758.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "2024 : 670 au début, 101 recrutements, 0 autre entrée, 24 retraites, 5 décès,\n1 autre sortie, 741 à la fin. L'annuaire : 767, 104, 7, 23, 3, 94, 758.",
      "autoResize": true,
      "lineHeight": 1.25
    },
