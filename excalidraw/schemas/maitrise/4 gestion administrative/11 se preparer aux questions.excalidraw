      "versionNonce": 1326778509,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794974048175,
      "link": null,
      "locked": false,
      "text": "La date de décès n'est plus saisie depuis 2010 : 59 dates pour 435 agents\ndécédés. On prend donc la décision de liquidation des droits, qui vient environ\n8 mois après. Sur cinq ans, le total est le bon à deux près, mais décalé d'un\nan.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "La date de décès n'est plus saisie depuis 2010 : 59 dates pour 435 agents\ndécédés. On prend donc la décision de liquidation des droits, qui vient environ\n8 mois après. Sur cinq ans, le total est le bon à deux près, mais décalé d'un\nan.",
      "autoResize": true,
      "lineHeight": 1.25
    },
