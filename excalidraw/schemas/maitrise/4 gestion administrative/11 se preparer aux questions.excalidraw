    {
      "id": "TWWr0eIJB4XxGJQQTiMH",
      "type": "text",
      "x": 1778.3333333333333,
      "y": 1926.0,
      "width": 764.28,
      "height": 90.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
