    {
      "id": "Rm1aOac8LGtfjvrigR4w",
      "type": "text",
      "x": 911.6666666666666,
      "y": 2271.5,
      "width": 763.2,
      "height": 90.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
