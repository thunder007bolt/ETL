      "boundElements": [],
      "updated": 1794974048175,
      "link": null,
      "locked": false,
      "text": "L'égalité tient chaque année : en 2024, 670 au début, 101 recrutements, 24\nretraites, 5 décès, 1 autre sortie, 741 à la fin, et la fin d'une année est le\ndébut de la suivante. Manquent les disponibilités et les détachements, qui ne\nsont pas tous saisis.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "L'égalité tient chaque année : en 2024, 670 au début, 101 recrutements, 24\nretraites, 5 décès, 1 autre sortie, 741 à la fin, et la fin d'une année est le\ndébut de la suivante. Manquent les disponibilités et les détachements, qui ne\nsont pas tous saisis.",
      "autoResize": true,
      "lineHeight": 1.25
    },
