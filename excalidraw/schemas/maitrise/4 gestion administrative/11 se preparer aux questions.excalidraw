    {
      "id": "LmazZMz1kDYOovNUDg7b",
      "type": "text",
      "x": 45.0,
      "y": 1951.0,
      "width": 740.1600000000001,
      "height": 90.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "dllSds2Vm2puzGaKmmm0"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1106899208,
      "version": 1,
      "versionNonce": 1975066509,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794974048175,
      "link": null,
      "locked": false,
      "text": "Parce qu'ici un cadre est un agent des catégories 04, 05, 06 et HC, cadres\nmoyens compris : c'est ce que la CNSS a retenu le 03/11, et c'est ce qu'elle\npublie elle-même (49,2 %). Sans les cadres moyens, le taux tombe à 7,8 %. Le\ncalcul est juste ; c'est la structure du personnel qu'il interroge.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Parce qu'ici un cadre est un agent des catégories 04, 05, 06 et HC, cadres\nmoyens compris : c'est ce que la CNSS a retenu le 03/11, et c'est ce qu'elle\npublie elle-même (49,2 %). Sans les cadres moyens, le taux tombe à 7,8 %. Le\ncalcul est juste ; c'est la structure du personnel qu'il interroge.",
      "autoResize": true,
      "lineHeight": 1.25
    },
