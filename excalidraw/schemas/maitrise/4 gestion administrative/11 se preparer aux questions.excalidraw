    {
      "id": "98Zab9YahWOA0LSSf1V4",
      "type": "text",
      "x": 45.0,
      "y": 2271.5,
      "width": 756.0,
      "height": 112.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
