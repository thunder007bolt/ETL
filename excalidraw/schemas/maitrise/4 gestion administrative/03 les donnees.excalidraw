    {
      "id": "3L5uDesaRiX4txceF6Yd",
      "type": "text",
      "x": 911.6666666666666,
      "y": 5315.5,
      "width": 750.24,
      "height": 90.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
