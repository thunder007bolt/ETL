      "versionNonce": 1285364489,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794974047570,
      "link": null,
      "locked": false,
      "text": "DWH porte les faits, copies des tables source par cliché mensuel. DTM porte\nles tables calculées que lit OBIEE : DTM_GRH_EFFECTIF,\nDTM_GRH_MOUVEMENT, DTM_GRH_FORMATION, DTM_GRH_RATIO,\nDTM_INDICATEURS_FINANCES_GRH.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "DWH porte les faits, copies des tables source par cliché mensuel. DTM porte\nles tables calculées que lit OBIEE : DTM_GRH_EFFECTIF,\nDTM_GRH_MOUVEMENT, DTM_GRH_FORMATION, DTM_GRH_RATIO,\nDTM_INDICATEURS_FINANCES_GRH.",
      "autoResize": true,
      "lineHeight": 1.25
    },
