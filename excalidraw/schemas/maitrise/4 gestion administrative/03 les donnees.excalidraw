      "link": null,
      "locked": false,
      "text": "rien pour l'instant : l'entrepôt n'est pas chargé pour la GRH. Les requêtes\nproposées sont écrites pour lui, et leurs contrôles sont des copies qui lisent\nla source.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "rien pour l'instant : l'entrepôt n'est pas chargé pour la GRH. Les requêtes\nproposées sont écrites pour lui, et leurs contrôles sont des copies qui lisent\nla source.",
      "autoResize": true,
      "lineHeight": 1.25
    },
