      "link": null,
      "locked": false,
      "text": "la position dit l'état d'aujourd'hui, pas celui de la date d'arrêté. Les\nabsences et les retours se lisent donc dans les décisions (07 et 18), pas dans\nles situations.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "la position dit l'état d'aujourd'hui, pas celui de la date d'arrêté. Les\nabsences et les retours se lisent donc dans les décisions (07 et 18), pas dans\nles situations.",
      "autoResize": true,
      "lineHeight": 1.25
    },
