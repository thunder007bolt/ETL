      "boundElements": [],
      "updated": 1794974047570,
      "link": null,
      "locked": false,
      "text": "La position (STATUT_EMPLOYE) n'est pas datée : l'application la modifie\nsur la situation en cours. Et le code de domaine (CODE_DOMAINE_ACT) n'est\npas fiable : 66 unités sur 139 portent des codes différents selon l'agent.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "La position (STATUT_EMPLOYE) n'est pas datée : l'application la modifie\nsur la situation en cours. Et le code de domaine (CODE_DOMAINE_ACT) n'est\npas fiable : 66 unités sur 139 portent des codes différents selon l'agent.",
      "autoResize": true,
      "lineHeight": 1.25
    },
