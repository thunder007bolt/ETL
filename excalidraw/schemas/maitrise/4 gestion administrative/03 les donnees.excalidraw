      "text": "SITU_ID, PERS_ID, DATE_DEBUT, NATURE_EMPLOIE (PERMANENT ou\nTEMPORAIRE), CATEGORIE (01 à 06, HC), UA_CODE (l'unité), QUAL_CODE\n(la qualification), STATUT_EMPLOYE (la position).",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "SITU_ID, PERS_ID, DATE_DEBUT, NATURE_EMPLOIE (PERMANENT ou\nTEMPORAIRE), CATEGORIE (01 à 06, HC), UA_CODE (l'unité), QUAL_CODE\n(la qualification), STATUT_EMPLOYE (la position).",
      "autoResize": true,
