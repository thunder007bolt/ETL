      "link": null,
      "locked": false,
      "text": "Le point tombe. Si un cas arrive un jour, l'agent avait déjà quitté l'effectif :\nil ne comptera pas dans les décès.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Le point tombe. Si un cas arrive un jour, l'agent avait déjà quitté l'effectif :\nil ne comptera pas dans les décès.",
