    {
      "id": "FsXTYUS8DiI1SGbN9XJG",
      "type": "text",
      "x": 45.0,
      "y": 4674.5,
      "width": 764.28,
      "height": 67.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
