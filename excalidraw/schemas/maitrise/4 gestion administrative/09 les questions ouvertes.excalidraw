      "boundElements": [],
      "updated": 1794974048054,
      "link": null,
      "locked": false,
      "text": "Le domaine se lit sur l'unité où travaille l'agent (UA_CODE). Le code de\ndomaine de la situation n'est pas fiable : dans 66 unités sur 139, les agents\nd'une même unité ont des codes différents.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Le domaine se lit sur l'unité où travaille l'agent (UA_CODE). Le code de\ndomaine de la situation n'est pas fiable : dans 66 unités sur 139, les agents\nd'une même unité ont des codes différents.",
      "autoResize": true,
      "lineHeight": 1.25
    },
