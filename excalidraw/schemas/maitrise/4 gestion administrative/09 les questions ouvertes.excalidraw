      "version": 1,
      "versionNonce": 1300588370,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794974048054,
      "link": null,
      "locked": false,
      "text": "On se demandait si un agent mort après son départ à la retraite devait compter\ndans les décès de T60. Le comptage a compté, année par année depuis 2019, les\ndécès survenus avant et après une retraite.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "On se demandait si un agent mort après son départ à la retraite devait compter\ndans les décès de T60. Le comptage a compté, année par année depuis 2019, les\ndécès survenus avant et après une retraite.",
      "autoResize": true,
      "lineHeight": 1.25
    },
