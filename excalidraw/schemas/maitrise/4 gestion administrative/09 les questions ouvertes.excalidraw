      "link": null,
      "locked": false,
      "text": "817 personnes sont parties sans aucune date : ni décision de départ, ni date de\ndécès. Leur fiche dit seulement « inactif ».",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "817 personnes sont parties sans aucune date : ni décision de départ, ni date de\ndécès. Leur fiche dit seulement « inactif ».",
      "autoResize": true,
      "lineHeight": 1.25
    },
