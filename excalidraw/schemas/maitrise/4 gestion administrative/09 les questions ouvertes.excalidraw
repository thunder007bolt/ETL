      "isDeleted": false,
      "boundElements": [],
      "updated": 1794974048054,
      "link": null,
      "locked": false,
      "text": "La comptabilité de la copie de la base n'est pas valide : la CNSS l'a dit le\n07/11. Tout passe par une vue commune, V_BI_BALANCE_COMPTABLE, que la\nDSI doit créer.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "La comptabilité de la copie de la base n'est pas valide : la CNSS l'a dit le\n07/11. Tout passe par une vue commune, V_BI_BALANCE_COMPTABLE, que la\nDSI doit créer.",
      "autoResize": true,
      "lineHeight": 1.25
    },
