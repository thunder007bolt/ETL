    {
      "id": "ESmXMBDYCuYknCAerBEb",
      "type": "text",
      "x": 45.0,
      "y": 2295.5,
      "width": 731.52,
      "height": 45.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "pjBB8lCO2IXNVyaGNgZP"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 453013644,
      "version": 1,
      "versionNonce": 293333255,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794974048054,
      "link": null,
      "locked": false,
      "text": "Une fiche sans état entrée depuis plus de deux ans est-elle celle d'un agent\nparti, à ne plus compter ?",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Une fiche sans état entrée depuis plus de deux ans est-elle celle d'un agent\nparti, à ne plus compter ?",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "ItUpx9hhfOeftVUWB1U0",
      "type": "text",
      "x": 45.0,
      "y": 2356.5,
      "width": 166.4,
      "height": 20.0,
      "angle": 0,
      "strokeColor": "#e8590c",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "pjBB8lCO2IXNVyaGNgZP"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1834001040,
      "version": 1,
      "versionNonce": 1560233843,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794974048054,
      "link": null,
      "locked": false,
      "text": "Pourquoi on la pose",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Pourquoi on la pose",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "GWlVGP0VMEgteADbnIoB",
      "type": "text",
      "x": 45.0,
      "y": 2380.5,
      "width": 763.2,
      "height": 67.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "pjBB8lCO2IXNVyaGNgZP"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1319728972,
      "version": 1,
      "versionNonce": 1053544915,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794974048054,
      "link": null,
      "locked": false,
      "text": "Quand un agent vient d'être embauché, sa fiche n'a pas encore d'état : ni\nactive, ni inactive. Depuis le 05/11, elle compte comme encore là, pour ne pas\nperdre les recrutements de fin d'année.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Quand un agent vient d'être embauché, sa fiche n'a pas encore d'état : ni\nactive, ni inactive. Depuis le 05/11, elle compte comme encore là, pour ne pas\nperdre les recrutements de fin d'année.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "caLiaT3e80K4AY4rDhGx",
      "type": "text",
      "x": 45.0,
      "y": 2464.0,
      "width": 208.96,
      "height": 20.0,
      "angle": 0,
      "strokeColor": "#e8590c",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "pjBB8lCO2IXNVyaGNgZP"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1392631643,
      "version": 1,
      "versionNonce": 2077450031,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794974048054,
      "link": null,
      "locked": false,
      "text": "Ce que change la réponse",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Ce que change la réponse",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "bDytvxf3db8BA8pdGDmH",
      "type": "text",
      "x": 45.0,
      "y": 2488.0,
      "width": 709.2,
      "height": 45.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "pjBB8lCO2IXNVyaGNgZP"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 4542654,
      "version": 1,
      "versionNonce": 775140531,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794974048054,
      "link": null,
      "locked": false,
      "text": "67 fiches sont sans état ; au moins 11 sont anciennes. Elles ajoutent 5\npermanents de 60 ans et plus fin 2024, alors que l'annuaire n'en a aucun.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "67 fiches sont sans état ; au moins 11 sont anciennes. Elles ajoutent 5\npermanents de 60 ans et plus fin 2024, alors que l'annuaire n'en a aucun.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "E3fipGWbibNw5WS9AlzG",
      "type": "text",
      "x": 45.0,
      "y": 2549.0,
      "width": 152.96,
      "height": 20.0,
      "angle": 0,
