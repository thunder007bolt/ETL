      "boundElements": [],
      "updated": 1794974048054,
      "link": null,
      "locked": false,
      "text": "Une formation diplômante peut durer plus d'un an : il aurait fallu décider dans\nquelle année la compter. Le comptage a mesuré, pour chaque année depuis 2019,\nles formations finies une autre année et celles de plus de 365 jours.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Une formation diplômante peut durer plus d'un an : il aurait fallu décider dans\nquelle année la compter. Le comptage a mesuré, pour chaque année depuis 2019,\nles formations finies une autre année et celles de plus de 365 jours.",
      "autoResize": true,
      "lineHeight": 1.25
    },
