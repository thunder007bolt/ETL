      "link": null,
      "locked": false,
      "text": "Aucun décès après la retraite depuis 2019 : les 21 décès connus sont tous\nsurvenus en activité.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Aucun décès après la retraite depuis 2019 : les 21 décès connus sont tous\nsurvenus en activité.",
