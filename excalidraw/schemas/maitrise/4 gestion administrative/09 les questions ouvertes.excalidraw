    {
      "id": "2BOepWb7cNP1Fr1jm5eJ",
      "type": "text",
      "x": 911.6666666666666,
      "y": 2380.5,
      "width": 760.32,
      "height": 67.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "M00SQKyILmoboUwWyPOM"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 544538037,
      "version": 1,
      "versionNonce": 818405184,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794974048054,
      "link": null,
      "locked": false,
      "text": "On lisait « inactif » comme « parti ». Or 12 agents mis en disponibilité de\n2021 à 2025 ne sont pas revenus, et leur fiche est inactive sans aucun départ\ndaté.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "On lisait « inactif » comme « parti ». Or 12 agents mis en disponibilité de\n2021 à 2025 ne sont pas revenus, et leur fiche est inactive sans aucun départ\ndaté.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "YMzM02fRAM5xgf87cojf",
      "type": "text",
      "x": 911.6666666666666,
      "y": 2464.0,
      "width": 208.96,
      "height": 20.0,
      "angle": 0,
      "strokeColor": "#e8590c",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "M00SQKyILmoboUwWyPOM"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1537149617,
      "version": 1,
      "versionNonce": 160619644,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794974048054,
      "link": null,
      "locked": false,
      "text": "Ce que change la réponse",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Ce que change la réponse",
