      "boundElements": [],
      "updated": 1794974048054,
      "link": null,
      "locked": false,
      "text": "Aucune formation de plus d'un an en sept ans. Une seule est à cheval sur deux\nannées : commencée en 2023, finie en 2024, avec 2 agents.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Aucune formation de plus d'un an en sept ans. Une seule est à cheval sur deux\nannées : commencée en 2023, finie en 2024, avec 2 agents.",
      "autoResize": true,
      "lineHeight": 1.25
    },
