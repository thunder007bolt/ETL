      "version": 1,
      "versionNonce": 332986841,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794974048054,
      "link": null,
      "locked": false,
      "text": "La fiche d'un agent passe-t-elle bien à « inactif » pendant sa disponibilité,\net pour quelles autres absences ?",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "La fiche d'un agent passe-t-elle bien à « inactif » pendant sa disponibilité,\net pour quelles autres absences ?",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "r1NokahuY8d5kqvpRmqF",
      "type": "text",
      "x": 911.6666666666666,
      "y": 2356.5,
      "width": 166.4,
      "height": 20.0,
      "angle": 0,
      "strokeColor": "#e8590c",
