      "boundElements": [],
      "updated": 1794974048054,
      "link": null,
      "locked": false,
      "text": "Un temporaire n'est compté que pendant ses contrats, qui commencent à la\ndécision d'engagement (50) : ceux qui n'en ont aucune ne sont comptés nulle\npart. Le comptage les a rangés par état de fiche et par période d'entrée.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Un temporaire n'est compté que pendant ses contrats, qui commencent à la\ndécision d'engagement (50) : ceux qui n'en ont aucune ne sont comptés nulle\npart. Le comptage les a rangés par état de fiche et par période d'entrée.",
      "autoResize": true,
      "lineHeight": 1.25
    },
