      "boundElements": [],
      "updated": 1794974048054,
      "link": null,
      "locked": false,
      "text": "Ni la date retenue ni le type d'agent n'expliquent l'écart : aucun temporaire\nni externe n'est formé.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Ni la date retenue ni le type d'agent n'expliquent l'écart : aucun temporaire\nni externe n'est formé.",
      "autoResize": true,
      "lineHeight": 1.25
    },
