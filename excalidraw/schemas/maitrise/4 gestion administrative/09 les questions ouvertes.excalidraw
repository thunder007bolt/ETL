    },
    {
      "id": "a1rM4STM0xQxKpuXofyU",
      "type": "text",
      "x": 911.6666666666666,
      "y": 2488.0,
      "width": 756.36,
      "height": 45.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "M00SQKyILmoboUwWyPOM"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 851069202,
      "version": 1,
      "versionNonce": 1193257450,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794974048054,
      "link": null,
      "locked": false,
      "text": "Ces 12 agents sont effacés de toutes les années : il manque 12 permanents fin\n2020 et encore 3 fin 2024, et T60 ne voit aucune de leurs sorties.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Ces 12 agents sont effacés de toutes les années : il manque 12 permanents fin\n2020 et encore 3 fin 2024, et T60 ne voit aucune de leurs sorties.",
      "autoResize": true,
      "lineHeight": 1.25
    },
