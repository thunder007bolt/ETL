      "versionNonce": 1996156958,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794974048054,
      "link": null,
      "locked": false,
      "text": "Garder les fiches récentes, écarter celles entrées depuis plus de deux ans.\nCorrection à faire de notre côté.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Garder les fiches récentes, écarter celles entrées depuis plus de deux ans.\nCorrection à faire de notre côté.",
