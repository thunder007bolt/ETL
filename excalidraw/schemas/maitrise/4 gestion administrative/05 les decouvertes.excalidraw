      "versionNonce": 2034686413,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794974047690,
      "link": null,
      "locked": false,
      "text": "L'annuaire range les agents par la catégorie de la grille de salaire\n(GRH_SITUATION.CATEGORIE : 01 à 06 et HC), et non par le niveau de\nqualification, qui est un autre champ de la base.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
