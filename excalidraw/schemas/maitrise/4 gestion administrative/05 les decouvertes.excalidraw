      "seed": 1512994987,
      "version": 1,
      "versionNonce": 1011760006,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794974047690,
      "link": null,
      "locked": false,
      "text": "817 agents sur 2 234 fiches inactives, soit 37 % des départs : surtout des\nradiés (272), des décédés (200) et des agents restés en position « activité »\n(201).",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "817 agents sur 2 234 fiches inactives, soit 37 % des départs : surtout des\nradiés (272), des décédés (200) et des agents restés en position « activité »\n(201).",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "xjes3BNRpL5xmQLzFZ9F",
      "type": "text",
      "x": 45.0,
      "y": 1847.0,
      "width": 162.24,
      "height": 20.0,
