      "roundness": null,
      "seed": 1042246717,
      "version": 1,
      "versionNonce": 251702736,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794974047690,
      "link": null,
      "locked": false,
      "text": "Leur fiche est inactive, mais elles n'ont ni décision de départ, ni date de\ndécès, ni indemnité de fin de contrat : rien ne dit quand elles sont parties.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Leur fiche est inactive, mais elles n'ont ni décision de départ, ni date de\ndécès, ni indemnité de fin de contrat : rien ne dit quand elles sont parties.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "Or7xv55J1f1Je12CyyxA",
      "type": "text",
      "x": 45.0,
      "y": 1739.5,
      "width": 90.24000000000001,
      "height": 20.0,
      "angle": 0,
