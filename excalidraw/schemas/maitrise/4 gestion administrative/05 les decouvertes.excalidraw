      "link": null,
      "locked": false,
      "text": "Une fiche sans état (ni active, ni inactive) est comptée comme encore là, parce\nque c'est le cas d'une embauche récente. Mais quelques fiches anciennes n'ont\njamais été fermées.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Une fiche sans état (ni active, ni inactive) est comptée comme encore là, parce\nque c'est le cas d'une embauche récente. Mais quelques fiches anciennes n'ont\njamais été fermées.",
      "autoResize": true,
      "lineHeight": 1.25
    },
