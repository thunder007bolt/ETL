      "versionNonce": 594328025,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794974047690,
      "link": null,
      "locked": false,
      "text": "La base ne garde pas la fin prévue d'un contrat. Sans départ saisi et sans\ncontrat suivant, la règle laisse le temporaire compté pour toujours, et le\nstock grossit chaque année.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "La base ne garde pas la fin prévue d'un contrat. Sans départ saisi et sans\ncontrat suivant, la règle laisse le temporaire compté pour toujours, et le\nstock grossit chaque année.",
      "autoResize": true,
      "lineHeight": 1.25
    },
