      "type": "text",
      "x": 45.0,
      "y": 2248.5,
      "width": 737.1,
      "height": 67.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "vptnw0zru4Ndz9TDEiEw"
      ],
      "frameId": null,
