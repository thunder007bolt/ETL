      "seed": 1478025190,
      "version": 1,
      "versionNonce": 275845151,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794974047690,
      "link": null,
      "locked": false,
      "text": "Pourquoi ça compte",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Pourquoi ça compte",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "b7dzX8UI4oHUzuQtpJF2",
      "type": "text",
      "x": 45.0,
      "y": 2356.0,
      "width": 741.24,
      "height": 67.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "vptnw0zru4Ndz9TDEiEw"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 242043046,
      "version": 1,
      "versionNonce": 1490637378,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794974047690,
      "link": null,
      "locked": false,
      "text": "C'est une erreur de notre côté, à corriger : la mise en disponibilité sans\nretour servira de date de sortie. T60 montrerait alors 2 à 3 disponibilités\nde plus par an, au niveau de l'annuaire.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "C'est une erreur de notre côté, à corriger : la mise en disponibilité sans\nretour servira de date de sortie. T60 montrerait alors 2 à 3 disponibilités\nde plus par an, au niveau de l'annuaire.",
      "autoResize": true,
      "lineHeight": 1.25
    },
