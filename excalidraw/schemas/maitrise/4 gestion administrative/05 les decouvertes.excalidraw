      "versionNonce": 1230577129,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794974047690,
      "link": null,
      "locked": false,
      "text": "Avec les deux photos du 31/12 (règle G14), effectif de début plus entrées\nmoins sorties donne toujours l'effectif de fin, et la fin d'une année est le\ndébut de la suivante.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Avec les deux photos du 31/12 (règle G14), effectif de début plus entrées\nmoins sorties donne toujours l'effectif de fin, et la fin d'une année est le\ndébut de la suivante.",
      "autoResize": true,
      "lineHeight": 1.25
    },
