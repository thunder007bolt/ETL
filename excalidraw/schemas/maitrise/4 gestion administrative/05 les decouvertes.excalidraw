      "boundElements": [],
      "updated": 1794974047690,
      "link": null,
      "locked": false,
      "text": "La date de décès de la fiche n'est plus remplie depuis 2010. Un décès ne se\nvoit plus que par la décision 34, la liquidation des droits des ayants droit,\nprise longtemps après.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "La date de décès de la fiche n'est plus remplie depuis 2010. Un décès ne se\nvoit plus que par la décision 34, la liquidation des droits des ayants droit,\nprise longtemps après.",
      "autoResize": true,
      "lineHeight": 1.25
    },
