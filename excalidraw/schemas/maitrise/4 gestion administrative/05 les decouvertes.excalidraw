      "versionNonce": 2008222625,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794974047690,
      "link": null,
      "locked": false,
      "text": "Quelques agents n'ont aucune situation : ils n'ont donc ni nature d'emploi ni\ncatégorie, et n'apparaissent dans aucun des deux tableaux, celui des permanents\ncomme celui des temporaires.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Quelques agents n'ont aucune situation : ils n'ont donc ni nature d'emploi ni\ncatégorie, et n'apparaissent dans aucun des deux tableaux, celui des permanents\ncomme celui des temporaires.",
      "autoResize": true,
      "lineHeight": 1.25
    },
