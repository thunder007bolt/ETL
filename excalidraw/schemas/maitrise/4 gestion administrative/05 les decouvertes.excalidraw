      "seed": 1545800345,
      "version": 1,
      "versionNonce": 1596716748,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794974047690,
      "link": null,
      "locked": false,
      "text": "12 agents mis en disponibilité de 2021 à 2025 ne sont jamais revenus : il\nmanque 12 permanents fin 2020, 10 fin 2021, 9 fin 2022, 6 fin 2023 et 3\nfin 2024.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "12 agents mis en disponibilité de 2021 à 2025 ne sont jamais revenus : il\nmanque 12 permanents fin 2020, 10 fin 2021, 9 fin 2022, 6 fin 2023 et 3\nfin 2024.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "2dTSw3aESNPDfseQATao",
      "type": "text",
      "x": 45.0,
      "y": 2332.0,
      "width": 162.24,
      "height": 20.0,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "vptnw0zru4Ndz9TDEiEw"
      ],
      "frameId": null,
