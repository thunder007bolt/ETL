      "versionNonce": 2132456131,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794974047690,
      "link": null,
      "locked": false,
      "text": "Elles ne sont comptées dans aucune année. L'effectif des années passées n'est\npas reconstituable : entre 621 et 1 613 agents en 2019.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Elles ne sont comptées dans aucune année. L'effectif des années passées n'est\npas reconstituable : entre 621 et 1 613 agents en 2019.",
      "autoResize": true,
      "lineHeight": 1.25
    },
