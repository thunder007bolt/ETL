    {
      "id": "CSrfn8AXhp3bQTumTsfl",
      "type": "text",
      "x": 45.0,
      "y": 2141.0,
      "width": 738.72,
      "height": 67.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "vptnw0zru4Ndz9TDEiEw"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 345489430,
      "version": 1,
      "versionNonce": 715156325,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794974047690,
      "link": null,
      "locked": false,
      "text": "La fiche d'un agent mis en disponibilité passe à « inactif ». Comme elle n'a\naucun départ daté, notre règle ne le compte à aucune date, même pendant les\nannées où il travaillait. « Inactif » ne veut donc pas dire « parti ».",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "La fiche d'un agent mis en disponibilité passe à « inactif ». Comme elle n'a\naucun départ daté, notre règle ne le compte à aucune date, même pendant les\nannées où il travaillait. « Inactif » ne veut donc pas dire « parti ».",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "BcuuohxoJRZdomOH0m31",
