    {
      "id": "okbcpaqilsJChQpknoC9",
      "type": "text",
      "x": 45.0,
      "y": 1678.5,
      "width": 734.04,
      "height": 45.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
