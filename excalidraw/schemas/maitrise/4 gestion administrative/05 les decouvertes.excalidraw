      "x": 911.6666666666666,
      "y": 546.5,
      "width": 765.1800000000001,
      "height": 90.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
