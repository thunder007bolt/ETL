    {
      "id": "E53T3iZA4mTHzQmwCIov",
      "type": "text",
      "x": 911.6666666666666,
      "y": 2790.5,
      "width": 720.36,
      "height": 67.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
