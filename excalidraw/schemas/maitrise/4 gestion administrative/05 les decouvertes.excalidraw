      "link": null,
      "locked": false,
      "text": "Avec les règles G1 et G2, le nombre de permanents au 31/12/2024 retombe\npresque sur le chiffre publié, et la case des employés est exacte.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Avec les règles G1 et G2, le nombre de permanents au 31/12/2024 retombe\npresque sur le chiffre publié, et la case des employés est exacte.",
      "autoResize": true,
      "lineHeight": 1.25
    },
