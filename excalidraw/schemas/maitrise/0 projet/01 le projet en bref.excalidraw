      "boundElements": [],
      "updated": 1793392158486,
      "link": null,
      "locked": false,
      "text": "les pensions (vieillesse, invalidité, décès), les risques professionnels\n(accidents du travail, maladies professionnelles), les prestations familiales\n(avec la maternité), et une action sanitaire et sociale.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "les pensions (vieillesse, invalidité, décès), les risques professionnels\n(accidents du travail, maladies professionnelles), les prestations familiales\n(avec la maternité), et une action sanitaire et sociale.",
      "autoResize": true,
      "lineHeight": 1.25
    },
