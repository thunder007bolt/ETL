      "boundElements": [],
      "updated": 1793392158486,
      "link": null,
      "locked": false,
      "text": "La Caisse nationale de sécurité sociale du Burkina Faso. Elle immatricule\nles employeurs et les travailleurs, recouvre les cotisations (21,5 % des\nsalaires) et verse les prestations.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "La Caisse nationale de sécurité sociale du Burkina Faso. Elle immatricule\nles employeurs et les travailleurs, recouvre les cotisations (21,5 % des\nsalaires) et verse les prestations.",
      "autoResize": true,
      "lineHeight": 1.25
    },
