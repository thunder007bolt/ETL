      "link": null,
      "locked": false,
      "text": "La Conférence interafricaine de la prévoyance sociale. Elle fixe un Annuaire\nstatistique commun aux caisses : 76 tableaux, de T1 à T76, que chaque caisse\ndoit remplir.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "La Conférence interafricaine de la prévoyance sociale. Elle fixe un Annuaire\nstatistique commun aux caisses : 76 tableaux, de T1 à T76, que chaque caisse\ndoit remplir.",
      "autoResize": true,
      "lineHeight": 1.25
    },
