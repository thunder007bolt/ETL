      "isDeleted": false,
      "boundElements": [],
      "updated": 1793392158486,
      "link": null,
      "locked": false,
      "text": "On garde les tables DTM existantes. On corrige leurs requêtes, avec des\nchangements compatibles, et on ne les met en production qu'après le visa du\nmétier.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "On garde les tables DTM existantes. On corrige leurs requêtes, avec des\nchangements compatibles, et on ne les met en production qu'après le visa du\nmétier.",
      "autoResize": true,
      "lineHeight": 1.25
    },
