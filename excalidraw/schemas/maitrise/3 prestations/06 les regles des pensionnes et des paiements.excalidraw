    {
      "id": "qvD2JeEWfnHh2D1Um10u",
      "type": "text",
      "x": 45.0,
      "y": 1218.0,
      "width": 1194.3000000000002,
      "height": 45.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "r4bkV3VkJHAXkveQRMgb"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 529399893,
      "version": 1,
      "versionNonce": 1030953725,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793392158623,
      "link": null,
      "locked": false,
      "text": "61,35 Md payés en 2025 ; le DTM, avec le net à payer, trouve 222,9 Md pour 58,5 Md (3,8 fois trop). Montants à 0,7–2,5 %\nde l'annuaire de la CNSS.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "61,35 Md payés en 2025 ; le DTM, avec le net à payer, trouve 222,9 Md pour 58,5 Md (3,8 fois trop). Montants à 0,7–2,5 %\nde l'annuaire de la CNSS.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "QWcgdMpfrejj1z82uSOb",
      "type": "text",
      "x": 45.0,
      "y": 1279.0,
      "width": 387.36,
      "height": 20.0,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "r4bkV3VkJHAXkveQRMgb"
