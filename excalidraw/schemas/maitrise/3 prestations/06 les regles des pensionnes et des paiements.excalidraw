      "isDeleted": false,
      "boundElements": [],
      "updated": 1793392158623,
      "link": null,
      "locked": false,
      "text": "Si on te demande : pourquoi pas le statut V ?",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Si on te demande : pourquoi pas le statut V ?",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "4X7NfIWwkdE7xWtTH1MV",
      "type": "text",
      "x": 45.0,
      "y": 1303.0,
      "width": 853.02,
      "height": 22.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "r4bkV3VkJHAXkveQRMgb"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 256381503,
      "version": 1,
      "versionNonce": 1665106015,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793392158623,
      "link": null,
      "locked": false,
      "text": "Validé ne veut pas dire décaissé ; l'atelier de Kaya dit « payées = sommes décaissées ».",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Validé ne veut pas dire décaissé ; l'atelier de Kaya dit « payées = sommes décaissées ».",
      "autoResize": true,
      "lineHeight": 1.25
    },
