    },
    {
      "id": "QoNw2SnXpRles8DoKmhK",
      "type": "text",
      "x": 45.0,
      "y": 1093.0,
      "width": 1175.94,
      "height": 22.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "r4bkV3VkJHAXkveQRMgb"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1350523853,
      "version": 1,
      "versionNonce": 1232108477,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793392158623,
      "link": null,
      "locked": false,
      "text": "Un paiement = un débours de type PM au statut D ou P. Son montant est celui du débours, jamais le net à payer de l'effet.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Un paiement = un débours de type PM au statut D ou P. Son montant est celui du débours, jamais le net à payer de l'effet.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "B0jZULHlEFRccfd5casJ",
      "type": "text",
      "x": 45.0,
      "y": 1131.5,
      "width": 74.56,
      "height": 20.0,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "r4bkV3VkJHAXkveQRMgb"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1766475711,
      "version": 1,
      "versionNonce": 832366755,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793392158623,
      "link": null,
      "locked": false,
      "text": "Pourquoi",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Pourquoi",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "F5ms9I3mET66a2vlDXSO",
      "type": "text",
      "x": 45.0,
      "y": 1155.5,
      "width": 934.5600000000001,
      "height": 22.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "r4bkV3VkJHAXkveQRMgb"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1933954095,
      "version": 1,
      "versionNonce": 631520466,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793392158623,
      "link": null,
      "locked": false,
      "text": "V n'est pas encore payé ; le net à payer est le total de l'effet, répété sur chacun de ses débours.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "V n'est pas encore payé ; le net à payer est le total de l'effet, répété sur chacun de ses débours.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "DX4KxEkyE1hQh9USn3oH",
      "type": "text",
      "x": 45.0,
      "y": 1194.0,
      "width": 81.28,
      "height": 20.0,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
