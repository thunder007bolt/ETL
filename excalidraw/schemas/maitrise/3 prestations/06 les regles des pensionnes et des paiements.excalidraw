      "text": "Bonification ou majoration pour enfant, charges du ménage : ils s'ajoutent à\nune pension, ne font pas un pensionné de plus et suivent sa ligne.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Bonification ou majoration pour enfant, charges du ménage : ils s'ajoutent à\nune pension, ne font pas un pensionné de plus et suivent sa ligne.",
      "autoResize": true,
      "lineHeight": 1.25
    },
