      "boundElements": [],
      "updated": 1793392158644,
      "link": null,
      "locked": false,
      "text": "Pour chaque type de prestation : les dossiers déposés, liquidés (en moins de 15\njours, de 15 à 45, plus de 45), en instance au 31/12, rejetés. Plus la durée\nmoyenne, comparée à la norme de 45 jours (Annuaire p. 12, 34).",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Pour chaque type de prestation : les dossiers déposés, liquidés (en moins de 15\njours, de 15 à 45, plus de 45), en instance au 31/12, rejetés. Plus la durée\nmoyenne, comparée à la norme de 45 jours (Annuaire p. 12, 34).",
      "autoResize": true,
      "lineHeight": 1.25
    },
