      "isDeleted": false,
      "boundElements": [],
      "updated": 1793392158644,
      "link": null,
      "locked": false,
      "text": "Les soins n'ont pas de notification ; les vieilles dates d'approbation ont été remplies en bloc en 2024.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Les soins n'ont pas de notification ; les vieilles dates d'approbation ont été remplies en bloc en 2024.",
