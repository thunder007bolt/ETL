      "versionNonce": 190595655,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793392158644,
      "link": null,
      "locked": false,
      "text": "Une réception au guichet = un dépôt. NOUVEAU va à la demande du dossier\nqu'elle ouvre, ANCIEN à la réversion du dossier visé. Une réversion sans\nréception prend la date de demande de sa pension.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Une réception au guichet = un dépôt. NOUVEAU va à la demande du dossier\nqu'elle ouvre, ANCIEN à la réversion du dossier visé. Une réversion sans\nréception prend la date de demande de sa pension.",
      "autoResize": true,
      "lineHeight": 1.25
    },
