      "isDeleted": false,
      "boundElements": [],
      "updated": 1793392158644,
      "link": null,
      "locked": false,
      "text": "Déposée, ni liquidée ni rejetée au 31/12. Sans les dossiers fermés jamais\nnotifiés, ni les vieilles réceptions jamais reliées à un dossier.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Déposée, ni liquidée ni rejetée au 31/12. Sans les dossiers fermés jamais\nnotifiés, ni les vieilles réceptions jamais reliées à un dossier.",
      "autoResize": true,
      "lineHeight": 1.25
    },
