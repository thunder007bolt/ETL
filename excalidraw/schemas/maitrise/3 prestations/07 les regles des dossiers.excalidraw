      "versionNonce": 1647588762,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793392158644,
      "link": null,
      "locked": false,
      "text": "Les soins vont en « autres prestations de la branche ». Un dossier y compte une fois, liquidé à la saisie de son premier\nremboursement.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Les soins vont en « autres prestations de la branche ». Un dossier y compte une fois, liquidé à la saisie de son premier\nremboursement.",
      "autoResize": true,
      "lineHeight": 1.25
    },
