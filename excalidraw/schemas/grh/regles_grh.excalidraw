      "boundElements": [],
      "updated": 1793551945364,
      "link": null,
      "locked": false,
      "text": "Agent CNSS de nature TEMPORAIRE au 31/12, engagé (décision 50 non annulée)\ndans l'année ou au second semestre de l'année d'avant, sans sortie au 31/12. Une\nfin de contrat (35) n'est pas une sortie si un nouveau contrat suit.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Agent CNSS de nature TEMPORAIRE au 31/12, engagé (décision 50 non annulée)\ndans l'année ou au second semestre de l'année d'avant, sans sortie au 31/12. Une\nfin de contrat (35) n'est pas une sortie si un nouveau contrat suit.",
      "autoResize": true,
      "lineHeight": 1.25
    },
