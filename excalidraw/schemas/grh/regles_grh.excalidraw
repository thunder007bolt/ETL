    {
      "id": "58iiBXUxtEhSsm6NH6Pr",
      "type": "text",
      "x": 901.0,
      "y": 3395.0,
      "width": 797.58,
      "height": 67.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "DKoJreEko1cZBwQGjYw9"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 868388529,
      "version": 1,
      "versionNonce": 1696161177,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793551945364,
      "link": null,
      "locked": false,
      "text": "Les 84 agents engagés en 2019 (décision 51), inactifs sans sortie datée, ne sont\njamais comptés présents par la base. L'annuaire les compte de 2019 à 2023 et les\nsort en 2024 (« autres »).",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Les 84 agents engagés en 2019 (décision 51), inactifs sans sortie datée, ne sont\njamais comptés présents par la base. L'annuaire les compte de 2019 à 2023 et les\nsort en 2024 (« autres »).",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "OTh7X9mvFI0e8pKy4XLJ",
      "type": "text",
      "x": 901.0,
      "y": 3474.5,
      "width": 767.2,
      "height": 40.0,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "DKoJreEko1cZBwQGjYw9"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1779618221,
      "version": 1,
      "versionNonce": 453014337,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793551945364,
      "link": null,
      "locked": false,
      "text": "Preuve : en 2019, 84 recrutés et 84 de moins en fin d'année ; 10 radiés dès 2019, les 74\nautres sans trace de départ",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Preuve : en 2019, 84 recrutés et 84 de moins en fin d'année ; 10 radiés dès 2019, les 74\nautres sans trace de départ",
      "autoResize": true,
      "lineHeight": 1.25
    },
