      "versionNonce": 1077422568,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793551945364,
      "link": null,
      "locked": false,
      "text": "4. 84 agents engagés en 2019 n'ont aucune date de départ : la base les perd dès 2019, l'annuaire les garde jusqu'en 2023. Sans effet sur les exercices calculés à partir de 2025 (G11).",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "4. 84 agents engagés en 2019 n'ont aucune date de départ : la base les perd dès 2019, l'annuaire les garde jusqu'en 2023. Sans effet sur les exercices calculés à partir de 2025 (G11).",
      "autoResize": true,
      "lineHeight": 1.25
    },
