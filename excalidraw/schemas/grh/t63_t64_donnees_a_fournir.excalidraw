      "seed": 1931054030,
      "version": 1,
      "versionNonce": 1420690399,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794090540561,
      "link": null,
      "locked": false,
      "text": "LA BI REGROUPE LES COMPTES (recueil des besoins v7)\n· frais de personnel : comptes 65, gestions G et S\n· masse salariale : comptes 651 et 652\n· dépenses de formation : « 63, 86 et 87 », gestions G et S\n· charges de fonctionnement : comptes 61 à 66, gestion G\n· total budget : les lignes BUDGET\nPuis elle calcule T63 et T64, par année et par unité.\nUn compte changé ne demande aucune nouvelle extraction.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "LA BI REGROUPE LES COMPTES (recueil des besoins v7)\n· frais de personnel : comptes 65, gestions G et S\n· masse salariale : comptes 651 et 652\n· dépenses de formation : « 63, 86 et 87 », gestions G et S\n· charges de fonctionnement : comptes 61 à 66, gestion G\n· total budget : les lignes BUDGET\nPuis elle calcule T63 et T64, par année et par unité.\nUn compte changé ne demande aucune nouvelle extraction.",
      "autoResize": true,
      "lineHeight": 1.25
    },
