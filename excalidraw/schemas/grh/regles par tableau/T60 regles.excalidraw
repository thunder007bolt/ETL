      "text": "T60 — Le mouvement du personnel sur cinq ans : les règles de la BI",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "T60 — Le mouvement du personnel sur cinq ans : les règles de la BI",
