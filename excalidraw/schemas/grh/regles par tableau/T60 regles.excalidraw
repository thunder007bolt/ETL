      "link": null,
      "locked": false,
      "text": "Un temporaire est présent si le 31 décembre tombe dans un de ses contrats. La fin d'un\ncontrat n'est pas saisie : sans départ ni nouveau contrat, il reste compté.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Un temporaire est présent si le 31 décembre tombe dans un de ses contrats. La fin d'un\ncontrat n'est pas saisie : sans départ ni nouveau contrat, il reste compté.",
      "autoResize": true,
      "lineHeight": 1.25
    },
