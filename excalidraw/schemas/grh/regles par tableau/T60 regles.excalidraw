      "link": null,
      "locked": false,
      "text": "Décès : la date de décès de la fiche. Elle n'est plus saisie depuis 2010 : on prend la\nliquidation des droits après décès, qui vient environ 8 mois plus tard.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Décès : la date de décès de la fiche. Elle n'est plus saisie depuis 2010 : on prend la\nliquidation des droits après décès, qui vient environ 8 mois plus tard.",
      "autoResize": true,
      "lineHeight": 1.25
    },
