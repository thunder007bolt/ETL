    },
    {
      "id": "4ExMaIWYiHaFUX1m1s97",
      "type": "text",
      "x": 0,
      "y": 64,
      "width": 1922.2000000000003,
      "height": 50.0,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
