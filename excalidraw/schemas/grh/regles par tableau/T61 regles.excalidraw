    {
      "id": "4ExMaIWYiHaFUX1m1s97",
      "type": "text",
      "x": 0,
      "y": 64,
      "width": 1918.4,
      "height": 50.0,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
