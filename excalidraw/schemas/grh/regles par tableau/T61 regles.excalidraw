      "boundElements": [],
      "updated": 1794925215988,
      "link": null,
      "locked": false,
      "text": "Un départ est une retraite, une liquidation des droits après décès, une fin de contrat, une\ndémission, une rupture du contrat ou un licenciement, à sa date d'effet. Sans décision, on\nprend la date de décès.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Un départ est une retraite, une liquidation des droits après décès, une fin de contrat, une\ndémission, une rupture du contrat ou un licenciement, à sa date d'effet. Sans décision, on\nprend la date de décès.",
      "autoResize": true,
      "lineHeight": 1.25
    },
