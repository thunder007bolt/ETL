      "isDeleted": false,
      "boundElements": [],
      "updated": 1794162910288,
      "link": null,
      "locked": false,
      "text": "MIN(date_depart) AS date_depart   -- parti puis revenu : seul le 1er départ\n…\nAND (p.etat <> 'INACTIF'          -- fiche active malgré un départ :\n     OR …)                        -- vrai, le OR s'arrête là",
      "fontSize": 17,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "MIN(date_depart) AS date_depart   -- parti puis revenu : seul le 1er départ\n…\nAND (p.etat <> 'INACTIF'          -- fiche active malgré un départ :\n     OR …)                        -- vrai, le OR s'arrête là",
      "autoResize": true,
      "lineHeight": 1.25
    },
