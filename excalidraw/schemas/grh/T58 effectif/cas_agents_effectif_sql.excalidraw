      "text": "2. Le cœur : le WHERE de base (l. 443 à 458) décide qui est compté à chaque date",
      "fontSize": 30,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "2. Le cœur : le WHERE de base (l. 443 à 458) décide qui est compté à chaque date",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "8VUQmrfHOjpNfiX2wMm5",
      "type": "rectangle",
      "x": 40,
      "y": 1455,
      "width": 1080,
      "height": 396.25,
      "angle": 0,
      "strokeColor": "#868e96",
