    {
      "id": "fPuzPwwxFou3Lk0byGMi",
      "type": "text",
      "x": 1229,
      "y": 4195.5,
      "width": 798.66,
      "height": 106.25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
