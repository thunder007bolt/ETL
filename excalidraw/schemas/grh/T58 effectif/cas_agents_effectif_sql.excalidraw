      "locked": false
    },
    {
      "id": "gO7ONGfNC1E5VOZHINYH",
      "type": "text",
      "x": 62,
      "y": 1471,
      "width": 793.4399999999999,
      "height": 356.25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "zLHOfSLR11X5kc3HF7EP"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1614147220,
      "version": 1,
      "versionNonce": 238017285,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794162910288,
      "link": null,
      "locked": false,
      "text": "WHERE\n    -- G2 : permanent présent (ou agent sans situation)\n    (NVL(si.nature, '-') <> 'TEMPORAIRE'                          -- [1]\n     AND p.date_entree <= da.date_arrete                          -- [2]\n     AND (p.etat <> 'INACTIF' OR pd.date_depart > da.date_arrete) -- [3]\n     AND NOT (pr.disponibilite = 'HORS_EFFECTIF'                  -- [4]\n              AND NVL(po.date_dispo, DATE '1900-01-01')\n                  > NVL(po.date_remise, DATE '1900-01-01')))\n OR\n    -- G7 : temporaire sous contrat\n    (si.nature = 'TEMPORAIRE'                                     -- [5]\n     AND tc.PERS_ID IS NOT NULL                                   -- [6]\n     AND NOT (pr.fin_contrat_inconnue = 'FICHE'                   -- [7]\n              AND tc.fin_inconnue = 1\n              AND p.etat = 'INACTIF'))",
      "fontSize": 19,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "WHERE\n    -- G2 : permanent présent (ou agent sans situation)\n    (NVL(si.nature, '-') <> 'TEMPORAIRE'                          -- [1]\n     AND p.date_entree <= da.date_arrete                          -- [2]\n     AND (p.etat <> 'INACTIF' OR pd.date_depart > da.date_arrete) -- [3]\n     AND NOT (pr.disponibilite = 'HORS_EFFECTIF'                  -- [4]\n              AND NVL(po.date_dispo, DATE '1900-01-01')\n                  > NVL(po.date_remise, DATE '1900-01-01')))\n OR\n    -- G7 : temporaire sous contrat\n    (si.nature = 'TEMPORAIRE'                                     -- [5]\n     AND tc.PERS_ID IS NOT NULL                                   -- [6]\n     AND NOT (pr.fin_contrat_inconnue = 'FICHE'                   -- [7]\n              AND tc.fin_inconnue = 1\n              AND p.etat = 'INACTIF'))",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
