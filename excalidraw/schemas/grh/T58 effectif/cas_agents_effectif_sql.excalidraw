      "text": "AND NOT EXISTS (SELECT 1\n                FROM DWH.FAIT_GRH_DECISION a\n                WHERE a.CLICHE = :1\n                  AND TO_CHAR(a.CDEC_CODE) = cd.annulation          -- '40'\n                  AND TO_CHAR(a.NO_DECI_MODIF) = TO_CHAR(d.DECI_NO))",
      "fontSize": 17,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "AND NOT EXISTS (SELECT 1\n                FROM DWH.FAIT_GRH_DECISION a\n                WHERE a.CLICHE = :1\n                  AND TO_CHAR(a.CDEC_CODE) = cd.annulation          -- '40'\n                  AND TO_CHAR(a.NO_DECI_MODIF) = TO_CHAR(d.DECI_NO))",
      "autoResize": true,
