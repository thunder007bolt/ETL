    {
      "id": "xS9amSKCvxOjNafs3pu2",
      "type": "text",
      "x": 1229,
      "y": 4486.75,
      "width": 739.5,
      "height": 127.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "4gzWl1k499anjUmlDYEU"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 522651187,
      "version": 1,
      "versionNonce": 1397384134,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794162910288,
      "link": null,
      "locked": false,
      "text": "SELECT dep.PERS_ID, dep.date_depart AS debut,       -- la 35\n       (SELECT MIN(e.date_decision)\n        FROM decisions e, codes_decision c3\n        WHERE e.PERS_ID = dep.PERS_ID\n          AND e.code IN (c3.engagement_temporaire, c3.engagement_permanent)\n          AND e.date_decision > dep.date_depart) AS fin   -- la 50 suivante",
      "fontSize": 17,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "SELECT dep.PERS_ID, dep.date_depart AS debut,       -- la 35\n       (SELECT MIN(e.date_decision)\n        FROM decisions e, codes_decision c3\n        WHERE e.PERS_ID = dep.PERS_ID\n          AND e.code IN (c3.engagement_temporaire, c3.engagement_permanent)\n          AND e.date_decision > dep.date_depart) AS fin   -- la 50 suivante",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "oOa2ekOQgSM0c2a41Sno",
      "type": "text",
      "x": 2424,
      "y": 4486.75,
      "width": 548.28,
      "height": 67.5,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "4gzWl1k499anjUmlDYEU"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 146957725,
      "version": 1,
      "versionNonce": 569497021,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794162910288,
      "link": null,
      "locked": false,
      "text": "Chaque 50 ouvre un contrat ; entre la 35 et la 50\nsuivante, aucun contrat, donc pas compté. Ce trou est une\ninterruption, retirée de l'ancienneté.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Chaque 50 ouvre un contrat ; entre la 35 et la 50\nsuivante, aucun contrat, donc pas compté. Ce trou est une\ninterruption, retirée de l'ancienneté.",
      "autoResize": true,
      "lineHeight": 1.25
    },
