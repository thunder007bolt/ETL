      "updated": 1794162910288,
      "link": null,
      "locked": false,
      "text": "[1] Aiguillage vers les permanents : situation pas TEMPORAIRE, ou pas de situation (NULL devient '-').",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "[1] Aiguillage vers les permanents : situation pas TEMPORAIRE, ou pas de situation (NULL devient '-').",
      "autoResize": true,
      "lineHeight": 1.25
    },
