      "isDeleted": false,
      "boundElements": [],
      "updated": 1794162910288,
      "link": null,
      "locked": false,
      "text": "LEAST(NVL(MIN(dep.date_depart), DATE '9999-12-31'),\n      NVL(g.debut_suivant,      DATE '9999-12-31'))  AS fin\n…\nLEFT JOIN departs dep ON dep.PERS_ID     = g.PERS_ID\n                     AND dep.date_depart > g.debut   -- 1er départ après le début",
      "fontSize": 17,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "LEAST(NVL(MIN(dep.date_depart), DATE '9999-12-31'),\n      NVL(g.debut_suivant,      DATE '9999-12-31'))  AS fin\n…\nLEFT JOIN departs dep ON dep.PERS_ID     = g.PERS_ID\n                     AND dep.date_depart > g.debut   -- 1er départ après le début",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
