      "isDeleted": false,
      "boundElements": [],
      "updated": 1794162910288,
      "link": null,
      "locked": false,
      "text": "CASE WHEN FLOOR(MONTHS_BETWEEN(da.date_arrete, p.DATE_NAISS) / 12)\n          BETWEEN 0 AND 119\n     THEN FLOOR(MONTHS_BETWEEN(da.date_arrete, p.DATE_NAISS) / 12) END AS age\nLEFT JOIN DTM.DIM_GRH_TRANCHE_AGE ta ON b.age >= ta.AGE_MIN\n     AND (b.age <= ta.AGE_MAX OR ta.AGE_MAX IS NULL)",
      "fontSize": 17,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "CASE WHEN FLOOR(MONTHS_BETWEEN(da.date_arrete, p.DATE_NAISS) / 12)\n          BETWEEN 0 AND 119\n     THEN FLOOR(MONTHS_BETWEEN(da.date_arrete, p.DATE_NAISS) / 12) END AS age\nLEFT JOIN DTM.DIM_GRH_TRANCHE_AGE ta ON b.age >= ta.AGE_MIN\n     AND (b.age <= ta.AGE_MAX OR ta.AGE_MAX IS NULL)",
      "autoResize": true,
      "lineHeight": 1.25
    },
