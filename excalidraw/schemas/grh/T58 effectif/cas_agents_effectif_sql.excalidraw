      "boundElements": [],
      "updated": 1794162910288,
      "link": null,
      "locked": false,
      "text": "ROW_NUMBER() OVER (PARTITION BY da.date_arrete, s.PERS_ID\n                   ORDER BY s.DATE_DEBUT DESC, s.SITU_ID DESC) AS rn\n…   AND si.rn = 1                            -- la dernière situation\nNVL(si.nature, '-') <> 'TEMPORAIRE'          -- branche G2, après\nsi.nature = 'TEMPORAIRE'                     -- branche G7, avant",
      "fontSize": 17,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "ROW_NUMBER() OVER (PARTITION BY da.date_arrete, s.PERS_ID\n                   ORDER BY s.DATE_DEBUT DESC, s.SITU_ID DESC) AS rn\n…   AND si.rn = 1                            -- la dernière situation\nNVL(si.nature, '-') <> 'TEMPORAIRE'          -- branche G2, après\nsi.nature = 'TEMPORAIRE'                     -- branche G7, avant",
      "autoResize": true,
      "lineHeight": 1.25
    },
