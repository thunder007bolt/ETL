      "link": null,
      "locked": false,
      "text": "Actif au 31/12. Les jours de disponibilité (ia.jours)\nsont retirés de son ancienneté, car\nretirer_interruptions = 'OUI'.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
