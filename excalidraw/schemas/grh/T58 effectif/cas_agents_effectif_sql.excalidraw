      "isDeleted": false,
      "boundElements": [],
      "updated": 1794162910288,
      "link": null,
      "locked": false,
      "text": "Parti puis revenu : G2 ne lit que le premier départ.\nFiche active malgré un départ saisi : la fiche\nl'emporterait. Aucun des deux n'existe.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Parti puis revenu : G2 ne lit que le premier départ.\nFiche active malgré un départ saisi : la fiche\nl'emporterait. Aucun des deux n'existe.",
      "autoResize": true,
      "lineHeight": 1.25
