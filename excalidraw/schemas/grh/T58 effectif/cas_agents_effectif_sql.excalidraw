    {
      "id": "Ppn9kQIAZVx7B8Ga9Obs",
      "type": "text",
      "x": 1229,
      "y": 3062.0,
      "width": 788.8,
      "height": 127.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "wFAqZPw1HRXxSHq0SxXq"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1331036762,
      "version": 1,
      "versionNonce": 1311888801,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794162910288,
      "link": null,
      "locked": false,
      "text": "MAX(CASE WHEN d.code = cd.mise_en_disponibilite THEN d.date_decision END)  -- 07\nMAX(CASE WHEN d.code = cd.remise_en_activite    THEN d.date_decision END)  -- 18\n…\nAND NOT (pr.disponibilite = 'HORS_EFFECTIF'          -- vrai : valeur retenue\n         AND NVL(po.date_dispo, DATE '1900-01-01')\n             > NVL(po.date_remise, DATE '1900-01-01')))   -- vrai : 07 après 18",
      "fontSize": 17,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "MAX(CASE WHEN d.code = cd.mise_en_disponibilite THEN d.date_decision END)  -- 07\nMAX(CASE WHEN d.code = cd.remise_en_activite    THEN d.date_decision END)  -- 18\n…\nAND NOT (pr.disponibilite = 'HORS_EFFECTIF'          -- vrai : valeur retenue\n         AND NVL(po.date_dispo, DATE '1900-01-01')\n             > NVL(po.date_remise, DATE '1900-01-01')))   -- vrai : 07 après 18",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "b0NERZcFxOn9U48JvmF3",
      "type": "text",
      "x": 2424,
      "y": 3062.0,
      "width": 537.66,
      "height": 112.5,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "wFAqZPw1HRXxSHq0SxXq"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1833147334,
      "version": 1,
      "versionNonce": 939391832,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794162910288,
      "link": null,
      "locked": false,
      "text": "Au 31/12, sa dernière 07 est plus récente que sa\ndernière 18. Avec disponibilite = 'HORS_EFFECTIF'\n(retenu le 08/11/2026, comme l'annuaire CNSS 2024),\nla ligne [4] du WHERE l'écarte. Avec 'PRESENT', il\nserait compté inactif.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Au 31/12, sa dernière 07 est plus récente que sa\ndernière 18. Avec disponibilite = 'HORS_EFFECTIF'\n(retenu le 08/11/2026, comme l'annuaire CNSS 2024),\nla ligne [4] du WHERE l'écarte. Avec 'PRESENT', il\nserait compté inactif.",
      "autoResize": true,
      "lineHeight": 1.25
    },
