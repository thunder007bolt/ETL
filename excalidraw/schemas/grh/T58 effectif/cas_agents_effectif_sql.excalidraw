      "boundElements": [],
      "updated": 1794162910288,
      "link": null,
      "locked": false,
      "text": "LEFT JOIN premier_depart pd ON pd.PERS_ID = p.PERS_ID   -- rien : pd.* = NULL\n…\nAND (p.etat <> 'INACTIF'                 -- faux\n     OR pd.date_depart > da.date_arrete) -- NULL > date : jamais vrai",
      "fontSize": 17,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "LEFT JOIN premier_depart pd ON pd.PERS_ID = p.PERS_ID   -- rien : pd.* = NULL\n…\nAND (p.etat <> 'INACTIF'                 -- faux\n     OR pd.date_depart > da.date_arrete) -- NULL > date : jamais vrai",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "QVqvYJBB5Fn91yfX9gpT",
