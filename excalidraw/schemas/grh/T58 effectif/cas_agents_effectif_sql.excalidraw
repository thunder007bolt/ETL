    {
      "id": "icJZUtbcO9Cbsy1r7p1S",
      "type": "text",
      "x": 1229,
      "y": 3239.5,
      "width": 650.7599999999999,
      "height": 170.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
