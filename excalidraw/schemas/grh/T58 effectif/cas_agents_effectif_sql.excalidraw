      "updated": 1794162910288,
      "link": null,
      "locked": false,
      "text": "LEAD(e.date_decision) OVER (PARTITION BY e.PERS_ID\n                            ORDER BY e.date_decision) AS debut_suivant\n…\nNVL(g.debut_suivant, DATE '9999-12-31')      -- fin du contrat 1",
      "fontSize": 17,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "LEAD(e.date_decision) OVER (PARTITION BY e.PERS_ID\n                            ORDER BY e.date_decision) AS debut_suivant\n…\nNVL(g.debut_suivant, DATE '9999-12-31')      -- fin du contrat 1",
      "autoResize": true,
      "lineHeight": 1.25
    },
