      "verticalAlign": "top",
      "containerId": null,
      "originalText": "CASE WHEN pr.inactifs = 'STATUT'            -- faux : réglage 'DECISIONS'\n     THEN CASE WHEN si.STATUT_EMPLOYE IN ('B','D','E','F','H')\n               THEN 1 ELSE 0 END\n     ELSE …                                 -- seules 07 et 18 comptent",
      "autoResize": true,
      "lineHeight": 1.25
