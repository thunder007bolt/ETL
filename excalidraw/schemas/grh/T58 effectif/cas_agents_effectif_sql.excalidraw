      "link": null,
      "locked": false,
      "text": "8 · SELECT final (l. 465 à 527) : GROUP BY des axes (date, catégorie, sexe, tranches, unité, domaine, nature, qualité…), COUNT(DISTINCT PERS_ID) et les autres mesures\n→ une ligne par date d'arrêté et par combinaison d'axes : la table DTM_GRH_EFFECTIF, que lit OBIEE (filtres qualité A et nature d'emploi)",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "8 · SELECT final (l. 465 à 527) : GROUP BY des axes (date, catégorie, sexe, tranches, unité, domaine, nature, qualité…), COUNT(DISTINCT PERS_ID) et les autres mesures\n→ une ligne par date d'arrêté et par combinaison d'axes : la table DTM_GRH_EFFECTIF, que lit OBIEE (filtres qualité A et nature d'emploi)",
      "autoResize": true,
      "lineHeight": 1.25
    },
