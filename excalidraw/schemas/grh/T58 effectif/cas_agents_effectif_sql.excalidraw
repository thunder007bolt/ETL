      "text": "COALESCE(p.DATE_PRISE_SERVICE, p.DATE_EMBAUCHE) AS debut_anciennete\n…\nGREATEST(FLOOR((da.date_arrete - p.debut_anciennete\n                - NVL(ia.jours, 0)) / 365.25), 0) AS anciennete",
      "fontSize": 17,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "COALESCE(p.DATE_PRISE_SERVICE, p.DATE_EMBAUCHE) AS debut_anciennete\n…\nGREATEST(FLOOR((da.date_arrete - p.debut_anciennete\n                - NVL(ia.jours, 0)) / 365.25), 0) AS anciennete",
      "autoResize": true,
