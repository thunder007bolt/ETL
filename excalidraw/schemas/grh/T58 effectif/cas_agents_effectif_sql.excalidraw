      "text": "fin = DATE '9999-12-31'                         -- ni départ, ni contrat suivant\nMAX(CASE WHEN c.fin = DATE '9999-12-31' THEN 1 ELSE 0 END) AS fin_inconnue\n…\nAND NOT (pr.fin_contrat_inconnue = 'FICHE'    -- faux : réglage 'PRESENT'\n         AND tc.fin_inconnue = 1\n         AND p.etat = 'INACTIF')",
      "fontSize": 17,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "fin = DATE '9999-12-31'                         -- ni départ, ni contrat suivant\nMAX(CASE WHEN c.fin = DATE '9999-12-31' THEN 1 ELSE 0 END) AS fin_inconnue\n…\nAND NOT (pr.fin_contrat_inconnue = 'FICHE'    -- faux : réglage 'PRESENT'\n         AND tc.fin_inconnue = 1\n         AND p.etat = 'INACTIF')",
      "autoResize": true,
      "lineHeight": 1.25
    },
