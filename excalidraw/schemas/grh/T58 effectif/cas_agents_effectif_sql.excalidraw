      "isDeleted": false,
      "boundElements": [],
      "updated": 1794162910288,
      "link": null,
      "locked": false,
      "text": "4 · contrats (une ligne par 50)\n5 · interruptions (l. 355 à 363)\n7 · base, anciennete",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "4 · contrats (une ligne par 50)\n5 · interruptions (l. 355 à 363)\n7 · base, anciennete",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "qMF4ZuOFHXb1dS15AimH",
      "type": "rectangle",
      "x": 1215,
      "y": 4478.75,
      "width": 1180,
