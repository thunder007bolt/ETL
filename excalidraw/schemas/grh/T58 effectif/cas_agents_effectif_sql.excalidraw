      "boundElements": [],
      "updated": 1794162910288,
      "link": null,
      "locked": false,
      "text": "LEFT JOIN regroupement_categorie rc ON rc.code = si.categorie\nNVL(rc.groupe, 'SANS_CATEGORIE')  AS GROUPE_CATEGORIE\nNVL(rc.cadre, 'NON')              AS cadre\nCOUNT(DISTINCT CASE WHEN b.cadre = 'OUI' THEN b.PERS_ID END) AS NB_CADRES",
      "fontSize": 17,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "LEFT JOIN regroupement_categorie rc ON rc.code = si.categorie\nNVL(rc.groupe, 'SANS_CATEGORIE')  AS GROUPE_CATEGORIE\nNVL(rc.cadre, 'NON')              AS cadre\nCOUNT(DISTINCT CASE WHEN b.cadre = 'OUI' THEN b.PERS_ID END) AS NB_CADRES",
      "autoResize": true,
      "lineHeight": 1.25
    },
