      "boundElements": [],
      "updated": 1794162910288,
      "link": null,
      "locked": false,
      "text": "WHERE code IN (SELECT code FROM decisions_depart)   -- 02 34 35 36 52 54\nSELECT PERS_ID, MIN(date_depart) AS date_depart     -- le premier départ\n…\nAND (p.etat <> 'INACTIF'                 -- faux : fiche INACTIF\n     OR pd.date_depart > da.date_arrete) -- faux : parti avant ou le 31/12",
      "fontSize": 17,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "WHERE code IN (SELECT code FROM decisions_depart)   -- 02 34 35 36 52 54\nSELECT PERS_ID, MIN(date_depart) AS date_depart     -- le premier départ\n…\nAND (p.etat <> 'INACTIF'                 -- faux : fiche INACTIF\n     OR pd.date_depart > da.date_arrete) -- faux : parti avant ou le 31/12",
      "autoResize": true,
      "lineHeight": 1.25
    },
