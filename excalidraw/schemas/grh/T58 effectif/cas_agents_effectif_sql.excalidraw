      "isDeleted": false,
      "boundElements": [],
      "updated": 1794162910288,
      "link": null,
      "locked": false,
      "text": "ELSE CASE WHEN NVL(po.date_dispo,  DATE '1900-01-01')\n             > NVL(po.date_remise, DATE '1900-01-01')\n          THEN 1 ELSE 0 END          -- 18 plus récente : 0, actif\n…\nGREATEST(FLOOR((da.date_arrete - p.debut_anciennete\n                - CASE pr.retirer_interruptions\n                      WHEN 'OUI' THEN NVL(ia.jours, 0) ELSE 0 END)\n               / 365.25), 0)                AS anciennete",
      "fontSize": 17,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "ELSE CASE WHEN NVL(po.date_dispo,  DATE '1900-01-01')\n             > NVL(po.date_remise, DATE '1900-01-01')\n          THEN 1 ELSE 0 END          -- 18 plus récente : 0, actif\n…\nGREATEST(FLOOR((da.date_arrete - p.debut_anciennete\n                - CASE pr.retirer_interruptions\n                      WHEN 'OUI' THEN NVL(ia.jours, 0) ELSE 0 END)\n               / 365.25), 0)                AS anciennete",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
