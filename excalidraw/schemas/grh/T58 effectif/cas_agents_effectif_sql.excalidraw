      "text": "WHERE e.PERS_ID IS NOT NULL\n  AND e.code = cd.engagement_temporaire      -- '50' : aucune ligne\n…\nLEFT JOIN temporaires_sous_contrat tc …       -- rien : tc.* = NULL\nAND tc.PERS_ID IS NOT NULL                    -- faux",
      "fontSize": 17,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "WHERE e.PERS_ID IS NOT NULL\n  AND e.code = cd.engagement_temporaire      -- '50' : aucune ligne\n…\nLEFT JOIN temporaires_sous_contrat tc …       -- rien : tc.* = NULL\nAND tc.PERS_ID IS NOT NULL                    -- faux",
      "autoResize": true,
