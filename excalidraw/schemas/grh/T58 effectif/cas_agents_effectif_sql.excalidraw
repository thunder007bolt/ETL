    {
      "id": "z6dp3lR1KbCV4Rtz9I0F",
      "type": "text",
      "x": 62,
      "y": 6937.75,
      "width": 762.1199999999999,
      "height": 247.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "4ZH2QTHrddXctcydwBPA"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1565871561,
      "version": 1,
      "versionNonce": 404842384,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794162910288,
      "link": null,
      "locked": false,
      "text": "SELECT TO_NUMBER(TO_CHAR(b.date_arrete, 'YYYYMMDD')) AS ID_TEMPS,\n       b.QUAL_CODE, ta.TRANCHE_AGE_CODE, tan.TRANCHE_ANC_CODE, b.SEXE, …,\n       COUNT(DISTINCT b.PERS_ID)                          AS NB_AGENTS,\n       …,\n       COUNT(DISTINCT CASE WHEN b.cadre = 'OUI'\n                           THEN b.PERS_ID END)            AS NB_CADRES\nFROM base b\nLEFT JOIN DTM.DIM_GRH_UNITE_ADMINISTRATIVE u ON u.UA_CODE = b.UA_CODE\nLEFT JOIN DTM.DIM_GRH_TRANCHE_AGE ta …\nLEFT JOIN DTM.DIM_GRH_TRANCHE_ANCIENNETE tan …\nGROUP BY …les mêmes axes…",
      "fontSize": 18,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "SELECT TO_NUMBER(TO_CHAR(b.date_arrete, 'YYYYMMDD')) AS ID_TEMPS,\n       b.QUAL_CODE, ta.TRANCHE_AGE_CODE, tan.TRANCHE_ANC_CODE, b.SEXE, …,\n       COUNT(DISTINCT b.PERS_ID)                          AS NB_AGENTS,\n       …,\n       COUNT(DISTINCT CASE WHEN b.cadre = 'OUI'\n                           THEN b.PERS_ID END)            AS NB_CADRES\nFROM base b\nLEFT JOIN DTM.DIM_GRH_UNITE_ADMINISTRATIVE u ON u.UA_CODE = b.UA_CODE\nLEFT JOIN DTM.DIM_GRH_TRANCHE_AGE ta …\nLEFT JOIN DTM.DIM_GRH_TRANCHE_ANCIENNETE tan …\nGROUP BY …les mêmes axes…",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
