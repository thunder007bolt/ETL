      "seed": 1067800295,
      "version": 2,
      "versionNonce": 1895940375,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794069461631,
      "link": null,
      "locked": false,
      "text": "RÈGLE : un permanent est compté s'il est ENTRÉ au plus tard le 31/12 (date d'embauche, sinon de prise de service) ET s'il n'est PAS ENCORE PARTI :\nsa fiche n'est pas INACTIF, ou son premier départ tombe après le 31/12. Départ = décision 02, 34, 35, 36, 52 ou 54 non annulée par une 40, sinon la date de décès.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "RÈGLE : un permanent est compté s'il est ENTRÉ au plus tard le 31/12 (date d'embauche, sinon de prise de service) ET s'il n'est PAS ENCORE PARTI :\nsa fiche n'est pas INACTIF, ou son premier départ tombe après le 31/12. Départ = décision 02, 34, 35, 36, 52 ou 54 non annulée par une 40, sinon la date de décès.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "aT"
    },
