    {
      "id": "DmaQtCbscsq9m6GKlPRT",
      "type": "text",
      "x": 62,
      "y": 3256,
      "width": 758.6,
      "height": 125.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
