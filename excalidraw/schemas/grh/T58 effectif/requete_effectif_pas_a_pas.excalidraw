      "seed": 1318988823,
      "version": 1,
      "versionNonce": 1585391790,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794162910405,
      "link": null,
      "locked": false,
      "text": "ATTENDU AU CONTRÔLE (lots 17 à 25 ; la requête reste à exécuter)\nenviron 741 permanents au 31/12/2024 (annuaire de la CNSS : 758)\ntaux d'encadrement (T65) : 48,8 % en 2024 (publié : 49,2 %),\nenviron 42 % de 2020 à 2023 (publié : 41 %) : l'écart vient des\n84 engagés de 2019, comme l'agent C",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "ATTENDU AU CONTRÔLE (lots 17 à 25 ; la requête reste à exécuter)\nenviron 741 permanents au 31/12/2024 (annuaire de la CNSS : 758)\ntaux d'encadrement (T65) : 48,8 % en 2024 (publié : 49,2 %),\nenviron 42 % de 2020 à 2023 (publié : 41 %) : l'écart vient des\n84 engagés de 2019, comme l'agent C",
      "autoResize": true,
      "lineHeight": 1.25
    },
