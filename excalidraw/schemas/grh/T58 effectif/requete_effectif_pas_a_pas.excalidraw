    {
      "id": "Gtk7dehIRmc5ZoljvOWy",
      "type": "text",
      "x": 62,
      "y": 2986,
      "width": 871.8000000000001,
      "height": 175.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "qNOtls54dGL9PvsCMO1L"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 533448903,
      "version": 1,
      "versionNonce": 549185257,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794162910405,
      "link": null,
      "locked": false,
      "text": "OÙ TOMBE L'AGENT A AU 31/12/2021\ndans la ligne : 20211231 · PERMANENT · qualité A · CADRES_MOYENS · M\n· tranche de ses 56 ans · tranche de ses 2 ans d'ancienneté\nil y ajoute 1 à NB_AGENTS et 1 à NB_CADRES (04 est une catégorie de cadres)\n\nUn agent ne compte qu'une fois par 31/12 : on additionne\nsur tous les axes, mais jamais d'une date à l'autre.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "OÙ TOMBE L'AGENT A AU 31/12/2021\ndans la ligne : 20211231 · PERMANENT · qualité A · CADRES_MOYENS · M\n· tranche de ses 56 ans · tranche de ses 2 ans d'ancienneté\nil y ajoute 1 à NB_AGENTS et 1 à NB_CADRES (04 est une catégorie de cadres)\n\nUn agent ne compte qu'une fois par 31/12 : on additionne\nsur tous les axes, mais jamais d'une date à l'autre.",
      "autoResize": true,
      "lineHeight": 1.25
    },
