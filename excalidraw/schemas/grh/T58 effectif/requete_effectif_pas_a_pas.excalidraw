      "link": null,
      "locked": false,
      "text": "4. LES CONTRATS\nchaque engagement 50 ouvre\nun contrat, fini au premier\ndépart qui suit, sinon la veille\ndu contrat suivant, sinon\nfin inconnue\nlit : FAIT_GRH_DECISION",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "Ja3lYbz49OC8tdwb6WJ8",
      "originalText": "4. LES CONTRATS\nchaque engagement 50 ouvre\nun contrat, fini au premier\ndépart qui suit, sinon la veille\ndu contrat suivant, sinon\nfin inconnue\nlit : FAIT_GRH_DECISION",
      "autoResize": true,
      "lineHeight": 1.25
    },
