    {
      "id": "GvvRWJUuKHNErIMH2xOZ",
      "type": "text",
      "x": 1303.27575633128,
      "y": 2550.25,
      "width": 861.84,
      "height": 67.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
