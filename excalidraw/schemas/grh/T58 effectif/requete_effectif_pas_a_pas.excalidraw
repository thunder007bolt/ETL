      "roundness": null,
      "seed": 899174382,
      "version": 1,
      "versionNonce": 248383974,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794162910405,
      "link": null,
      "locked": false,
      "text": "jamais compté, à aucun 31/12 : sa fiche dit INACTIF, et rien ne dit quand il est parti.\nC'est le cas des 84 engagés de 2019 (règle G11, question QG2 à la DRH) :\nde 2020 à 2023, la base compte 92 à 99 permanents de moins que l'annuaire de la CNSS.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "FKZrsdNYKd9NGTdI2BUg",
      "originalText": "jamais compté, à aucun 31/12 : sa fiche dit INACTIF, et rien ne dit quand il est parti.\nC'est le cas des 84 engagés de 2019 (règle G11, question QG2 à la DRH) :\nde 2020 à 2023, la base compte 92 à 99 permanents de moins que l'annuaire de la CNSS.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "xmvj19vWPxMH7El2Xhz7",
      "type": "rectangle",
      "x": 40,
      "y": 2680,
      "width": 2520,
