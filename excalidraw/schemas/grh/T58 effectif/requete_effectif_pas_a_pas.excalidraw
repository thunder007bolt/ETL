    {
      "id": "HvujXLRQjCiFwqYMtHtc",
      "type": "text",
      "x": 1362,
      "y": 2986,
      "width": 726.8,
      "height": 300.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
