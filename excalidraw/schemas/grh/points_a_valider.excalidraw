      "text": "La fin d'un contrat temporaire",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "La fin d'un contrat temporaire",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "n4V6Tq50wfMLZeEgG8Si",
      "type": "text",
      "x": 897.0,
      "y": 4451.0,
      "width": 757.7600000000001,
      "height": 40.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "reS4gKtVzVhfMGBwZcvN"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 480478792,
      "version": 1,
      "versionNonce": 1540170695,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793571984768,
      "link": null,
      "locked": false,
      "text": "Dans la base : aucune date de fin de contrat n'est saisie. La seule trace est la décision\nd'indemnité de fin de contrat (35), prise environ 9 mois après la fin réelle.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Dans la base : aucune date de fin de contrat n'est saisie. La seule trace est la décision\nd'indemnité de fin de contrat (35), prise environ 9 mois après la fin réelle.",
      "autoResize": true,
