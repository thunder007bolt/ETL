    {
      "id": "Z9NsJFDGnjwqZOJxkvDi",
      "type": "text",
      "x": 39.0,
      "y": 6281.0,
      "width": 792.32,
      "height": 60.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "xJVqAASGIOz6t4qECyeT"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1765120284,
      "version": 1,
      "versionNonce": 1969551706,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793571984768,
      "link": null,
      "locked": false,
      "text": "Dans la base : chaque inscription (GRH_INSCRIPTION) porte sept frais : inscription,\nscolarité, transport, séjour, dossier, assurance et frais accessoires. On les additionne, un\nfrais vide comptant pour zéro, et on rattache la dépense à l'année où la formation commence.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Dans la base : chaque inscription (GRH_INSCRIPTION) porte sept frais : inscription,\nscolarité, transport, séjour, dossier, assurance et frais accessoires. On les additionne, un\nfrais vide comptant pour zéro, et on rattache la dépense à l'année où la formation commence.",
      "autoResize": true,
      "lineHeight": 1.25
    },
