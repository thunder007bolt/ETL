    {
      "id": "us4jowQUux6huTCKM658",
      "type": "text",
      "x": 955.0,
      "y": 704.0,
      "width": 733.5,
      "height": 90.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
