    {
      "id": "gSU7PlOz32vWqhJhVA3R",
      "type": "text",
      "x": 1755.0,
      "y": 3175.0,
      "width": 804.48,
      "height": 40.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "o2BNyVkWxU4dw0ejrkNc"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 777609352,
      "version": 1,
      "versionNonce": 1268350147,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793571984768,
      "link": null,
      "locked": false,
      "text": "C'est quoi : pour savoir si un contractuel est encore là au 31/12, il faut connaître la fin de\nson contrat.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "C'est quoi : pour savoir si un contractuel est encore là au 31/12, il faut connaître la fin de\nson contrat.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "MR9K54K44ro1EPr9Kjqz",
      "type": "text",
      "x": 1755.0,
      "y": 3223.0,
      "width": 789.7600000000001,
      "height": 40.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "o2BNyVkWxU4dw0ejrkNc"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1066628520,
      "version": 1,
      "versionNonce": 1211347318,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793571984768,
      "link": null,
      "locked": false,
      "text": "Dans la base : la date de fin du contrat n'est pas saisie. On suppose donc qu'un contrat dure\n18 mois à partir de la décision d'engagement (50).",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Dans la base : la date de fin du contrat n'est pas saisie. On suppose donc qu'un contrat dure\n18 mois à partir de la décision d'engagement (50).",
      "autoResize": true,
      "lineHeight": 1.25
    },
