      "boundElements": [],
      "updated": 1793571984768,
      "link": null,
      "locked": false,
      "text": "Aujourd'hui : on trouve les entrées et les sorties en comparant l'effectif d'un 31/12 au\nsuivant. Un agent recruté puis parti dans la même année n'y apparaît pas.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Aujourd'hui : on trouve les entrées et les sorties en comparant l'effectif d'un 31/12 au\nsuivant. Un agent recruté puis parti dans la même année n'y apparaît pas.",
      "autoResize": true,
