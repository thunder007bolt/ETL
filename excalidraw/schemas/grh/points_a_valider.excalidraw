      "seed": 641400846,
      "version": 1,
      "versionNonce": 433841644,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793571984768,
      "link": null,
      "locked": false,
      "text": "Dans la base : en 2020, 1 247 états de sortie ont été changés en une seule fois.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Dans la base : en 2020, 1 247 états de sortie ont été changés en une seule fois.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "A1d5fiJcpaoHZnEcKiPZ",
      "type": "text",
      "x": 897.0,
      "y": 7095.0,
      "width": 787.6800000000001,
      "height": 40.0,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
