      "roundness": null,
      "seed": 1594546249,
      "version": 1,
      "versionNonce": 1677524995,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793571984768,
      "link": null,
      "locked": false,
      "text": "Question : les vraies dates de sortie ont-elles été gardées quelque part ? Elles dateraient\nune partie des 817 départs sans date.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Question : les vraies dates de sortie ont-elles été gardées quelque part ? Elles dateraient\nune partie des 817 départs sans date.",
