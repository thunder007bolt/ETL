        "lHg1OtVr9HUWrtg8lsqR"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1105114231,
      "version": 1,
      "versionNonce": 1322505606,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793570031272,
      "link": null,
      "locked": false,
      "text": "Les statuts de fin de carrière (R retraite, X radié, Y décédé) ne sont\npresque jamais saisis, la date d'état de la fiche n'est plus remplie depuis\n2020, et la situation d'un agent qui part n'est jamais clôturée : 691\npersonnes parties gardent le statut « activité normale ». Est-ce voulu ?",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Les statuts de fin de carrière (R retraite, X radié, Y décédé) ne sont\npresque jamais saisis, la date d'état de la fiche n'est plus remplie depuis\n2020, et la situation d'un agent qui part n'est jamais clôturée : 691\npersonnes parties gardent le statut « activité normale ». Est-ce voulu ?",
      "autoResize": true,
      "lineHeight": 1.25
    },
