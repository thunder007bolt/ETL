      "seed": 398517083,
      "version": 1,
      "versionNonce": 1283297432,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793570031272,
      "link": null,
      "locked": false,
      "text": "Présent au 31/12 : entré au plus tard le 31/12 (embauche, sinon prise de\nservice), et fiche active ou départ après le 31/12. Le départ est la\npremière décision 02, 34, 35, 36, 52 ou 54 non annulée par une 40, sinon la\ndate de décès. Un agent inactif sans aucune décision n'est compté nulle part.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Présent au 31/12 : entré au plus tard le 31/12 (embauche, sinon prise de\nservice), et fiche active ou départ après le 31/12. Le départ est la\npremière décision 02, 34, 35, 36, 52 ou 54 non annulée par une 40, sinon la\ndate de décès. Un agent inactif sans aucune décision n'est compté nulle part.",
      "autoResize": true,
      "lineHeight": 1.25
    },
