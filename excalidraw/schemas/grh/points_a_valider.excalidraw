    },
    {
      "id": "zQX6uSAueH1w2zoXwaYE",
      "type": "text",
      "x": 897.0,
      "y": 4791.0,
      "width": 777.2800000000001,
      "height": 40.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "mkFWZFroLdfNpdlvGzSg"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 644269236,
      "version": 1,
      "versionNonce": 1099256482,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793571984768,
      "link": null,
      "locked": false,
      "text": "C'est quoi : un détachement est l'arrivée à la CNSS d'un agent d'une autre administration,\npour un temps, ou le départ pour un temps d'un agent de la CNSS dans un autre organisme.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "C'est quoi : un détachement est l'arrivée à la CNSS d'un agent d'une autre administration,\npour un temps, ou le départ pour un temps d'un agent de la CNSS dans un autre organisme.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "1jDULq4zbpuMHBTRIBHY",
      "type": "text",
      "x": 897.0,
      "y": 4839.0,
      "width": 731.5200000000001,
      "height": 40.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "mkFWZFroLdfNpdlvGzSg"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 791849178,
      "version": 1,
      "versionNonce": 1183473258,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793571984768,
      "link": null,
      "locked": false,
      "text": "Chiffre : l'annuaire compte 2 détachements et 2 fins de détachement en 2023, puis 1\ndétachement en 2024.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Chiffre : l'annuaire compte 2 détachements et 2 fins de détachement en 2023, puis 1\ndétachement en 2024.",
      "autoResize": true,
      "lineHeight": 1.25
    },
