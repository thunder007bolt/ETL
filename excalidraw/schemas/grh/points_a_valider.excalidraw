    {
      "id": "byOA0HNkIn3OIOnHn2IN",
      "type": "text",
      "x": 1813.0,
      "y": 361.5,
      "width": 731.8800000000001,
      "height": 112.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
