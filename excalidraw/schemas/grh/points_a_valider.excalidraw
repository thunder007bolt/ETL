      "boundElements": [],
      "updated": 1793570031272,
      "link": null,
      "locked": false,
      "text": "Mouvements (T60) : recrutement = embauche dans l'année (104 en 2024, des\ndeux côtés) ; retraite = décision 02, à sa date ; démission 36 ;\nlicenciement 54 ; mise en disponibilité 07 ; remise en activité 18. Les\nchangements de poste (affectation, mutation, nomination, promotion) restent\nen dehors de T60.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Mouvements (T60) : recrutement = embauche dans l'année (104 en 2024, des\ndeux côtés) ; retraite = décision 02, à sa date ; démission 36 ;\nlicenciement 54 ; mise en disponibilité 07 ; remise en activité 18. Les\nchangements de poste (affectation, mutation, nomination, promotion) restent\nen dehors de T60.",
      "autoResize": true,
      "lineHeight": 1.25
    },
