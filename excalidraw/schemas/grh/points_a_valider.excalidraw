    {
      "id": "fwrNTHg4ESDf9VLI2Gtb",
      "type": "text",
      "x": 97.0,
      "y": 1140.0,
      "width": 713.8800000000001,
      "height": 67.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "7tOJ80JE2qF4z69vQJX9"
