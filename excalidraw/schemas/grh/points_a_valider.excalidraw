    {
      "id": "gzg2sye9b2Rann76dEyT",
      "type": "text",
      "x": 45,
      "y": 144,
      "width": 2474.1000000000004,
      "height": 67.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
