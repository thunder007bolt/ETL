      "text": "Les entrées et les sorties (T60)",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Les entrées et les sorties (T60)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "WwZtgpYjnm3IVNwhkWmL",
      "type": "text",
      "x": 1755.0,
      "y": 2315.0,
      "width": 775.0400000000001,
      "height": 80.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "5B7ymRS7FFBSZyGXEgJV"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 361643368,
      "version": 1,
      "versionNonce": 1931410522,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793571984768,
      "link": null,
      "locked": false,
      "text": "Dans la base : un recrutement est un agent embauché dans l'année (DATE_EMBAUCHE). Une\nretraite est une décision 02, une démission une 36, un licenciement une 54, une mise en\ndisponibilité une 07, une remise en activité une 18, chacune à sa date d'effet\n(DATE_VIGUEUR).",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Dans la base : un recrutement est un agent embauché dans l'année (DATE_EMBAUCHE). Une\nretraite est une décision 02, une démission une 36, un licenciement une 54, une mise en\ndisponibilité une 07, une remise en activité une 18, chacune à sa date d'effet\n(DATE_VIGUEUR).",
      "autoResize": true,
      "lineHeight": 1.25
    },
