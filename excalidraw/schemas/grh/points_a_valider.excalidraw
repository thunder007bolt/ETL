    {
      "id": "fdulA7vKkLeaPe90OM6i",
      "type": "text",
      "x": 102.22206506364921,
      "y": 4926.0,
      "width": 721.8000000000001,
      "height": 90.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
