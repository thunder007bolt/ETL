      "link": null,
      "locked": false,
      "text": "Les frais de personnel et les charges de fonctionnement",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Les frais de personnel et les charges de fonctionnement",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "v4f9veoMO8PxOq6PafnH",
      "type": "text",
      "x": 39.0,
      "y": 5891.0,
      "width": 780.0,
      "height": 40.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "p4fcInvw8eOiB6kCdfSv"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 214372184,
      "version": 1,
      "versionNonce": 354074107,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793571984768,
      "link": null,
      "locked": false,
      "text": "C'est quoi : T63 compare les frais de personnel (salaires, charges sociales…) à l'ensemble\ndes charges de fonctionnement de la CNSS ; la norme CIPRES est de 85 % au plus.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "C'est quoi : T63 compare les frais de personnel (salaires, charges sociales…) à l'ensemble\ndes charges de fonctionnement de la CNSS ; la norme CIPRES est de 85 % au plus.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "xk6XDPZRl6wjZ3spUxM9",
      "type": "text",
      "x": 39.0,
      "y": 5939.0,
      "width": 802.5600000000001,
      "height": 40.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "p4fcInvw8eOiB6kCdfSv"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1407750749,
      "version": 1,
      "versionNonce": 39703248,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793571984768,
      "link": null,
      "locked": false,
      "text": "Dans la base : la paie n'est pas dans notre copie. Kaya 2017 dit que ces montants viennent de\nl'application comptable.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Dans la base : la paie n'est pas dans notre copie. Kaya 2017 dit que ces montants viennent de\nl'application comptable.",
      "autoResize": true,
      "lineHeight": 1.25
    },
