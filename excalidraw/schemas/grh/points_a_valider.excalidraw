        "yyLaMeffOhq4AUvy7VSL"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 603593978,
      "version": 1,
      "versionNonce": 1225315437,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793571984768,
      "link": null,
      "locked": false,
      "text": "C'est quoi : chaque agent a une catégorie dans la grille de salaire de la CNSS, de la 1re à la\n6e. Les tableaux T58, T62 et T65 regroupent les agents en employés, agents de maîtrise,\ncadres moyens et cadres supérieurs.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "C'est quoi : chaque agent a une catégorie dans la grille de salaire de la CNSS, de la 1re à la\n6e. Les tableaux T58, T62 et T65 regroupent les agents en employés, agents de maîtrise,\ncadres moyens et cadres supérieurs.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "wtPYKbPizDmbX1rpXjYd",
      "type": "text",
      "x": 39.0,
      "y": 963.0,
      "width": 674.24,
      "height": 40.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "yyLaMeffOhq4AUvy7VSL"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 2113151004,
      "version": 1,
      "versionNonce": 1351154430,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793571984768,
      "link": null,
      "locked": false,
      "text": "Dans la base : la catégorie est dans la dernière situation de l'agent au 31/12\n(GRH_SITUATION, champ CATEGORIE, codes 01 à 06).",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Dans la base : la catégorie est dans la dernière situation de l'agent au 31/12\n(GRH_SITUATION, champ CATEGORIE, codes 01 à 06).",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "hCgOIPOZx9eRmm0EqlTa",
      "type": "text",
      "x": 39.0,
      "y": 1011.0,
      "width": 805.2800000000001,
      "height": 60.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "yyLaMeffOhq4AUvy7VSL"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1621459593,
      "version": 1,
      "versionNonce": 1014040706,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793571984768,
      "link": null,
      "locked": false,
      "text": "Aujourd'hui : 01 et 02 employés ; 03 agents de maîtrise ; 04 et 05 cadres moyens ; 06 cadres\nsupérieurs. Avec ce rangement, on retrouve l'annuaire 2024 : 173, 207, 304 et 58 agents\npour 177, 208, 311 et 62 publiés.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Aujourd'hui : 01 et 02 employés ; 03 agents de maîtrise ; 04 et 05 cadres moyens ; 06 cadres\nsupérieurs. Avec ce rangement, on retrouve l'annuaire 2024 : 173, 207, 304 et 58 agents\npour 177, 208, 311 et 62 publiés.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "ITclorXwIS8HGNWkz2YS",
      "type": "text",
      "x": 39.0,
      "y": 1079.0,
      "width": 772.8000000000001,
      "height": 40.0,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
