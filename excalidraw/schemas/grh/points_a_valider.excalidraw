      "boundElements": [],
      "updated": 1793571984768,
      "link": null,
      "locked": false,
      "text": "C'est quoi : la masse salariale est le total des salaires versés ; T64 y rapporte la dépense\nde formation (norme : entre 1 et 5 %).",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "C'est quoi : la masse salariale est le total des salaires versés ; T64 y rapporte la dépense\nde formation (norme : entre 1 et 5 %).",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "Ff92NUTtEAV4cYQi3BAS",
