      "isDeleted": false,
      "boundElements": [],
      "updated": 1793571984768,
      "link": null,
      "locked": false,
      "text": "C'est quoi : l'annuaire range ses 46 contractuels de 2024 en 18 employés, 13 agents de\nmaîtrise, 10 cadres moyens et 5 cadres supérieurs.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "C'est quoi : l'annuaire range ses 46 contractuels de 2024 en 18 employés, 13 agents de\nmaîtrise, 10 cadres moyens et 5 cadres supérieurs.",
      "autoResize": true,
      "lineHeight": 1.25
    },
