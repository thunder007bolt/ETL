      "link": null,
      "locked": false,
      "text": "Mis à jour le 01/11/2026. Base consultée : copie de USER_GRH du 18/02/2026, comparée à l'annuaire statistique CNSS 2024 (partie IX, tableaux 119 à 124).",
      "fontSize": 22,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Mis à jour le 01/11/2026. Base consultée : copie de USER_GRH du 18/02/2026, comparée à l'annuaire statistique CNSS 2024 (partie IX, tableaux 119 à 124).",
      "autoResize": true,
