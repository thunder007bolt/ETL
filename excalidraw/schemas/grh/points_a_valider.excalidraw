    {
      "id": "HTT17mK8bOQmXfipEKAS",
      "type": "text",
      "x": 955.0,
      "y": 1305.0,
      "width": 263.2,
      "height": 25.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
