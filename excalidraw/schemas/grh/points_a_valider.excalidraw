    {
      "id": "2qmBq6UCs05IGwAUoPZy",
      "type": "text",
      "x": 1755.0,
      "y": 6281.0,
      "width": 791.36,
      "height": 40.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
