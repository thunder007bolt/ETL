    {
      "id": "rZtZ4lh0EtTpc6Zb9GQv",
      "type": "text",
      "x": 897.0,
      "y": 2703.0,
      "width": 805.12,
      "height": 80.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "6sWk7UupJLzkS8vsOgOR"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1011259936,
      "version": 1,
      "versionNonce": 1700285311,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793571984768,
      "link": null,
      "locked": false,
      "text": "Dans la base : un agent inscrit (GRH_INSCRIPTION) à une formation qui commence dans\nl'année (GRH_FORMATION, date de début), comme décidé à Kaya en 2017. Il compte une fois,\nmême s'il a suivi plusieurs formations. Toutes les formations comptent, quel que soit leur\nstatut. Sa catégorie est celle de sa situation au 31/12, comme dans T58.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Dans la base : un agent inscrit (GRH_INSCRIPTION) à une formation qui commence dans\nl'année (GRH_FORMATION, date de début), comme décidé à Kaya en 2017. Il compte une fois,\nmême s'il a suivi plusieurs formations. Toutes les formations comptent, quel que soit leur\nstatut. Sa catégorie est celle de sa situation au 31/12, comme dans T58.",
      "autoResize": true,
      "lineHeight": 1.25
    },
