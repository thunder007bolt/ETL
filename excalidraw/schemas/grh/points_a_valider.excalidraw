      "boundElements": [],
      "updated": 1793571984768,
      "link": null,
      "locked": false,
      "text": "Question : pouvez-vous nous donner l'effectif officiel au 31/12/2019 et au 31/12/2025,\npour comparer ?",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Question : pouvez-vous nous donner l'effectif officiel au 31/12/2019 et au 31/12/2025,\npour comparer ?",
      "autoResize": true,
      "lineHeight": 1.25
    },
