      "isDeleted": false,
      "boundElements": [],
      "updated": 1793571984768,
      "link": null,
      "locked": false,
      "text": "Question : la 5e catégorie, ce sont des cadres moyens, comme dans l'annuaire 2024, ou des\ncadres supérieurs, comme à l'atelier de Kaya en 2017 ?",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Question : la 5e catégorie, ce sont des cadres moyens, comme dans l'annuaire 2024, ou des\ncadres supérieurs, comme à l'atelier de Kaya en 2017 ?",
      "autoResize": true,
      "lineHeight": 1.25
    },
