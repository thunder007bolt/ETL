    {
      "id": "G77NeJq2grp2mIaJYLeN",
      "type": "text",
      "x": 62,
      "y": 786,
      "width": 1776.6,
      "height": 50.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
