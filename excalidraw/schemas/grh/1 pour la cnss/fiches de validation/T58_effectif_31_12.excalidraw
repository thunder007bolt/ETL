    {
      "id": "dtxJ0dLJMdmPoTQeyWEL",
      "type": "text",
      "x": 39.0,
      "y": 6976.5,
      "width": 785.8800000000001,
      "height": 67.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
