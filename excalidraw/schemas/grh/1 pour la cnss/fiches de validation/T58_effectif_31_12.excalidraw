    {
      "id": "gVNJT4PKwEY7p8VhNQHG",
      "type": "text",
      "x": 2074.44,
      "y": 3958.0,
      "width": 445.43999999999994,
      "height": 240.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "eMWVSmsI8PKwg3a7xQTo"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 165209523,
      "version": 1,
      "versionNonce": 1984284368,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794932908224,
      "link": null,
      "locked": false,
      "text": "-- âge en années pleines au 31/12/2024,\n-- par tranche de 5 ans (20 = 20 à 24 ans)\nSELECT tranche, COUNT(*)\nFROM  (SELECT FLOOR(FLOOR((DATE '2024-12-31'\n                - DATE_NAISS) / 365.25) / 5) * 5\n                AS tranche\n       FROM   permanents_2024)\nGROUP  BY tranche\nORDER  BY tranche\n-- 2024, de 20-24 à 55-59 ans : 12, 28, 70,\n-- 115, 139, 152, 150, 70 ; 5 de 60 ans et\n-- plus : des fiches sans état anciennes",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-- âge en années pleines au 31/12/2024,\n-- par tranche de 5 ans (20 = 20 à 24 ans)\nSELECT tranche, COUNT(*)\nFROM  (SELECT FLOOR(FLOOR((DATE '2024-12-31'\n                - DATE_NAISS) / 365.25) / 5) * 5\n                AS tranche\n       FROM   permanents_2024)\nGROUP  BY tranche\nORDER  BY tranche\n-- 2024, de 20-24 à 55-59 ans : 12, 28, 70,\n-- 115, 139, 152, 150, 70 ; 5 de 60 ans et\n-- plus : des fiches sans état anciennes",
      "autoResize": true,
      "lineHeight": 1.25
    },
