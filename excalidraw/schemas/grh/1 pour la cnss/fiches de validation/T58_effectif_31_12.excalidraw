    {
      "id": "aFcYqd5w2cVHPGFQKflw",
      "type": "text",
      "x": 1334.0,
      "y": 3198.0,
      "width": 690.84,
      "height": 112.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "dUZi2b8QIEFmzUbLOwkq"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 445745848,
      "version": 1,
      "versionNonce": 954981227,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794932908224,
      "link": null,
      "locked": false,
      "text": "Entré au plus tard le 31 décembre (embauche, à défaut prise de service)\net pas encore parti : sa fiche n'est pas inactive, ou son premier départ\ntombe après le 31 décembre. Un départ est une décision de retraite, de\nliquidation après décès, de fin de contrat, de démission, de rupture ou\nde licenciement, non annulée ; à défaut, la date de décès.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Entré au plus tard le 31 décembre (embauche, à défaut prise de service)\net pas encore parti : sa fiche n'est pas inactive, ou son premier départ\ntombe après le 31 décembre. Un départ est une décision de retraite, de\nliquidation après décès, de fin de contrat, de démission, de rupture ou\nde licenciement, non annulée ; à défaut, la date de décès.",
      "autoResize": true,
      "lineHeight": 1.25
    },
