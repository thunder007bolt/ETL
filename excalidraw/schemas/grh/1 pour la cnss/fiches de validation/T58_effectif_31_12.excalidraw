    {
      "id": "JyvGw7Fqy4WWf8l6p0PR",
      "type": "text",
      "x": 779.44,
      "y": 5336.0,
      "width": 389.76,
      "height": 320.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "Ejh5j6KvPMjOZNPLgnZQ"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 736075932,
      "version": 1,
      "versionNonce": 1012475371,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794932908224,
      "link": null,
      "locked": false,
      "text": "-- ancienneté en années pleines au\n-- 31/12/2024, depuis la prise de service\n-- (à défaut, depuis l'embauche)\nSELECT anciennete, COUNT(*)\nFROM  (SELECT FLOOR((DATE '2024-12-31'\n                - NVL(DATE_PRISE_SERVICE,\n                      DATE_EMBAUCHE))\n                / 365.25) AS anciennete\n       FROM   permanents_2024)\nGROUP  BY anciennete\nORDER  BY anciennete\n-- puis regrouper : moins de 1, 1-4, 5-9…\n-- 2024 : moins d'un an 102, 10-14 ans 225\n-- (la requête complète retire aussi les\n-- disponibilités et les départs suivis\n-- d'un nouvel engagement)",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-- ancienneté en années pleines au\n-- 31/12/2024, depuis la prise de service\n-- (à défaut, depuis l'embauche)\nSELECT anciennete, COUNT(*)\nFROM  (SELECT FLOOR((DATE '2024-12-31'\n                - NVL(DATE_PRISE_SERVICE,\n                      DATE_EMBAUCHE))\n                / 365.25) AS anciennete\n       FROM   permanents_2024)\nGROUP  BY anciennete\nORDER  BY anciennete\n-- puis regrouper : moins de 1, 1-4, 5-9…\n-- 2024 : moins d'un an 102, 10-14 ans 225\n-- (la requête complète retire aussi les\n-- disponibilités et les départs suivis\n-- d'un nouvel engagement)",
      "autoResize": true,
      "lineHeight": 1.25
    },
