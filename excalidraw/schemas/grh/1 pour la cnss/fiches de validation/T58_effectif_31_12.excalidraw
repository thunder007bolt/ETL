      "boundElements": [],
      "updated": 1794932908224,
      "link": null,
      "locked": false,
      "text": "« Effectif des travailleurs de l'organisme à la clôture de l'exercice par catégorie professionnelle, âge et sexe » · fiche pilote de T58, T59, T61 et T65 · ce que l'équipe BI a compris, à valider · état au 17/11/2026",
      "fontSize": 22,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
