      "roundness": null,
      "seed": 1565316386,
      "version": 1,
      "versionNonce": 1421406529,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794932908224,
      "link": null,
      "locked": false,
      "text": "67 fiches n'ont pas d'état. La plupart sont des embauches récentes, mais au moins\n11 sont anciennes, dont 5 permanents de 69 à 80 ans. Une fiche sans état entrée\ndepuis plus de deux ans est-elle celle d'un agent parti ?",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "67 fiches n'ont pas d'état. La plupart sont des embauches récentes, mais au moins\n11 sont anciennes, dont 5 permanents de 69 à 80 ans. Une fiche sans état entrée\ndepuis plus de deux ans est-elle celle d'un agent parti ?",
      "autoResize": true,
      "lineHeight": 1.25
    },
