    {
      "id": "u0i4bHkhXSQ5k3lXJnbg",
      "type": "text",
      "x": 1334.0,
      "y": 4476.0,
      "width": 677.8800000000001,
      "height": 90.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "VLKQRv736E1VypYRkUkN"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1862154686,
      "version": 1,
      "versionNonce": 1591002526,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794932908224,
      "link": null,
      "locked": false,
      "text": "Un temporaire est présent si le 31 décembre tombe dans un de ses\ncontrats. Un contrat commence à la décision d'engagement temporaire ;\nil finit au premier départ saisi, sinon la veille du contrat suivant.\nSans fin connue, l'agent reste compté.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Un temporaire est présent si le 31 décembre tombe dans un de ses\ncontrats. Un contrat commence à la décision d'engagement temporaire ;\nil finit au premier départ saisi, sinon la veille du contrat suivant.\nSans fin connue, l'agent reste compté.",
      "autoResize": true,
      "lineHeight": 1.25
    },
