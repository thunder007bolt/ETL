    },
    {
      "id": "7xfB44t2enz0ZEwPezIU",
      "type": "text",
      "x": 39.0,
      "y": 6401.0,
      "width": 776.52,
      "height": 67.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "DUhGxWinMlOY9C2QFKPU"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1134255874,
      "version": 1,
      "versionNonce": 2139695666,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794932908224,
      "link": null,
      "locked": false,
      "text": "La base ne garde pas la fin d'un contrat temporaire : un temporaire reste compté\ntant qu'aucun départ n'est saisi. En attendant la saisie des fins de contrat,\ncompte-t-on seulement ceux dont la fiche n'est pas inactive ?",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "La base ne garde pas la fin d'un contrat temporaire : un temporaire reste compté\ntant qu'aucun départ n'est saisi. En attendant la saisie des fins de contrat,\ncompte-t-on seulement ceux dont la fiche n'est pas inactive ?",
      "autoResize": true,
      "lineHeight": 1.25
    },
