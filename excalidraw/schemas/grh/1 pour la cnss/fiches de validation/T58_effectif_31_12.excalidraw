      "isDeleted": false,
      "boundElements": [],
      "updated": 1794932908224,
      "link": null,
      "locked": false,
      "text": "SELECT ROUND(100 * SUM(CASE\n         WHEN CATEGORIE IN ('04','05','06','HC')\n         THEN 1 ELSE 0 END) / COUNT(*), 1)\n         AS taux_encadrement\nFROM   permanents_2024\n-- 2024 : 48,3 % (l'annuaire : 49,2 %)\n-- pour une autre année : refaire la\n-- règle 2 avec le 31/12 de cette année",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "SELECT ROUND(100 * SUM(CASE\n         WHEN CATEGORIE IN ('04','05','06','HC')\n         THEN 1 ELSE 0 END) / COUNT(*), 1)\n         AS taux_encadrement\nFROM   permanents_2024\n-- 2024 : 48,3 % (l'annuaire : 49,2 %)\n-- pour une autre année : refaire la\n-- règle 2 avec le 31/12 de cette année",
      "autoResize": true,
      "lineHeight": 1.25
    },
