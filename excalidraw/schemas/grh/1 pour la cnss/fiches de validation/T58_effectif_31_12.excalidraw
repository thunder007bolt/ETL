    },
    {
      "id": "kEd4ONH6JOZXNhXEcouM",
      "type": "text",
      "x": 2074.44,
      "y": 4452.0,
      "width": 463.99999999999994,
      "height": 800.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "HfcPD2rjDla7BLwKtMqV"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1899994184,
      "version": 1,
      "versionNonce": 1934712539,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794932908224,
      "link": null,
      "locked": false,
      "text": "-- les temporaires au 31/12/2024 : un\n-- engagement (50), aucun départ depuis\nSELECT COUNT(*) AS regle_actuelle,\n       SUM(CASE WHEN NVL(p.ETAT_EMPLOYE, '-')\n                     <> 'INACTIF'\n                THEN 1 ELSE 0 END)\n         AS fiche_non_inactive\nFROM   USER_GRH.GRH_PERSONNE p\nJOIN   USER_GRH.GRH_SITUATION s\n       ON s.PERS_ID = p.PERS_ID\nWHERE  p.QUALITE = 'A'\nAND    s.NATURE_EMPLOIE = 'TEMPORAIRE'\nAND    s.DATE_DEBUT = (  -- dernière situation\n         SELECT MAX(x.DATE_DEBUT)\n         FROM   USER_GRH.GRH_SITUATION x\n         WHERE  x.PERS_ID = p.PERS_ID\n         AND    x.DATE_DEBUT <= DATE '2024-12-31')\nAND    EXISTS (\n  SELECT 1\n  FROM   USER_GRH.GRH_DECISION e\n  WHERE  e.PERS_ID = p.PERS_ID\n  AND    e.CDEC_CODE = '50'\n  AND    e.DATE_VIGUEUR <= DATE '2024-12-31')\n-- aucun départ après le dernier engagement\nAND    NOT EXISTS (\n  SELECT 1\n  FROM   USER_GRH.GRH_DECISION f\n  WHERE  f.PERS_ID = p.PERS_ID\n  AND    f.CDEC_CODE IN\n         ('02','34','35','36','52','54')\n  AND    f.DATE_VIGUEUR <= DATE '2024-12-31'\n  AND    f.DATE_VIGUEUR >= (\n           SELECT MAX(e.DATE_VIGUEUR)\n           FROM   USER_GRH.GRH_DECISION e\n           WHERE  e.PERS_ID = f.PERS_ID\n           AND    e.CDEC_CODE = '50'\n           AND    e.DATE_VIGUEUR\n                  <= DATE '2024-12-31'))\n-- 2024 : 299, dont 47 fiches non inactives\n-- (l'annuaire : 46 contractuels)",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-- les temporaires au 31/12/2024 : un\n-- engagement (50), aucun départ depuis\nSELECT COUNT(*) AS regle_actuelle,\n       SUM(CASE WHEN NVL(p.ETAT_EMPLOYE, '-')\n                     <> 'INACTIF'\n                THEN 1 ELSE 0 END)\n         AS fiche_non_inactive\nFROM   USER_GRH.GRH_PERSONNE p\nJOIN   USER_GRH.GRH_SITUATION s\n       ON s.PERS_ID = p.PERS_ID\nWHERE  p.QUALITE = 'A'\nAND    s.NATURE_EMPLOIE = 'TEMPORAIRE'\nAND    s.DATE_DEBUT = (  -- dernière situation\n         SELECT MAX(x.DATE_DEBUT)\n         FROM   USER_GRH.GRH_SITUATION x\n         WHERE  x.PERS_ID = p.PERS_ID\n         AND    x.DATE_DEBUT <= DATE '2024-12-31')\nAND    EXISTS (\n  SELECT 1\n  FROM   USER_GRH.GRH_DECISION e\n  WHERE  e.PERS_ID = p.PERS_ID\n  AND    e.CDEC_CODE = '50'\n  AND    e.DATE_VIGUEUR <= DATE '2024-12-31')\n-- aucun départ après le dernier engagement\nAND    NOT EXISTS (\n  SELECT 1\n  FROM   USER_GRH.GRH_DECISION f\n  WHERE  f.PERS_ID = p.PERS_ID\n  AND    f.CDEC_CODE IN\n         ('02','34','35','36','52','54')\n  AND    f.DATE_VIGUEUR <= DATE '2024-12-31'\n  AND    f.DATE_VIGUEUR >= (\n           SELECT MAX(e.DATE_VIGUEUR)\n           FROM   USER_GRH.GRH_DECISION e\n           WHERE  e.PERS_ID = f.PERS_ID\n           AND    e.CDEC_CODE = '50'\n           AND    e.DATE_VIGUEUR\n                  <= DATE '2024-12-31'))\n-- 2024 : 299, dont 47 fiches non inactives\n-- (l'annuaire : 46 contractuels)",
      "autoResize": true,
      "lineHeight": 1.25
    },
