      "version": 1,
      "versionNonce": 1153364315,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794932908224,
      "link": null,
      "locked": false,
      "text": "-- à coller sous la règle 2, à la place\n-- de sa dernière ligne\nSELECT CATEGORIE, COUNT(*)\nFROM   permanents_2024\nGROUP  BY CATEGORIE\nORDER  BY CATEGORIE\n-- 2024 : 01 + 02 employés      177\n--        03      maîtrise      206\n--        04 + 05 cadres moyens 301\n--        06 + HC cadres sup.    57",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-- à coller sous la règle 2, à la place\n-- de sa dernière ligne\nSELECT CATEGORIE, COUNT(*)\nFROM   permanents_2024\nGROUP  BY CATEGORIE\nORDER  BY CATEGORIE\n-- 2024 : 01 + 02 employés      177\n--        03      maîtrise      206\n--        04 + 05 cadres moyens 301\n--        06 + HC cadres sup.    57",
      "autoResize": true,
      "lineHeight": 1.25
    },
