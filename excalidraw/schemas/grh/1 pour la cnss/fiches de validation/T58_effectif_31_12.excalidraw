      "containerId": null,
      "originalText": "Règle 2 en SQL",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "7ORw3vGROxDtk2SJ8XyI",
      "type": "text",
      "x": 2074.44,
      "y": 3174.0,
      "width": 482.55999999999995,
      "height": 700.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "C0qSZdQBmXsPpf9CEjos"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1540336487,
      "version": 1,
      "versionNonce": 813327612,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794932908224,
      "link": null,
      "locked": false,
      "text": "-- la liste des permanents présents\n-- au 31/12/2024, réutilisée ensuite\nWITH permanents_2024 AS (\n  SELECT p.PERS_ID, p.SEXE, p.DATE_NAISS,\n         p.DATE_EMBAUCHE, p.DATE_PRISE_SERVICE,\n         s.CATEGORIE, s.UA_CODE\n  FROM   USER_GRH.GRH_PERSONNE p\n  JOIN   USER_GRH.GRH_SITUATION s\n         ON s.PERS_ID = p.PERS_ID\n  -- règle 1 : agent CNSS, permanent\n  WHERE  p.QUALITE = 'A'\n  AND    s.NATURE_EMPLOIE = 'PERMANENT'\n  AND    s.DATE_DEBUT = (\n           SELECT MAX(x.DATE_DEBUT)\n           FROM   USER_GRH.GRH_SITUATION x\n           WHERE  x.PERS_ID = p.PERS_ID\n           AND    x.DATE_DEBUT <= DATE '2024-12-31')\n  -- entré au plus tard le 31/12/2024\n  AND    NVL(p.DATE_EMBAUCHE, p.DATE_PRISE_SERVICE)\n           <= DATE '2024-12-31'\n  -- pas parti : fiche pas inactive, ou\n  -- premier départ (02, 34, 35, 36, 52, 54)\n  -- après le 31/12/2024\n  AND   (NVL(p.ETAT_EMPLOYE, '-') <> 'INACTIF'\n         OR (SELECT MIN(d.DATE_VIGUEUR)\n             FROM   USER_GRH.GRH_DECISION d\n             WHERE  d.PERS_ID = p.PERS_ID\n             AND    d.CDEC_CODE IN\n                    ('02','34','35','36','52','54'))\n            > DATE '2024-12-31'))\nSELECT COUNT(*) FROM permanents_2024\n-- la requête complète écarte aussi les\n-- décisions annulées par une 40, lit les\n-- décisions collectives et sort les agents\n-- en disponibilité : 741 en 2024",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-- la liste des permanents présents\n-- au 31/12/2024, réutilisée ensuite\nWITH permanents_2024 AS (\n  SELECT p.PERS_ID, p.SEXE, p.DATE_NAISS,\n         p.DATE_EMBAUCHE, p.DATE_PRISE_SERVICE,\n         s.CATEGORIE, s.UA_CODE\n  FROM   USER_GRH.GRH_PERSONNE p\n  JOIN   USER_GRH.GRH_SITUATION s\n         ON s.PERS_ID = p.PERS_ID\n  -- règle 1 : agent CNSS, permanent\n  WHERE  p.QUALITE = 'A'\n  AND    s.NATURE_EMPLOIE = 'PERMANENT'\n  AND    s.DATE_DEBUT = (\n           SELECT MAX(x.DATE_DEBUT)\n           FROM   USER_GRH.GRH_SITUATION x\n           WHERE  x.PERS_ID = p.PERS_ID\n           AND    x.DATE_DEBUT <= DATE '2024-12-31')\n  -- entré au plus tard le 31/12/2024\n  AND    NVL(p.DATE_EMBAUCHE, p.DATE_PRISE_SERVICE)\n           <= DATE '2024-12-31'\n  -- pas parti : fiche pas inactive, ou\n  -- premier départ (02, 34, 35, 36, 52, 54)\n  -- après le 31/12/2024\n  AND   (NVL(p.ETAT_EMPLOYE, '-') <> 'INACTIF'\n         OR (SELECT MIN(d.DATE_VIGUEUR)\n             FROM   USER_GRH.GRH_DECISION d\n             WHERE  d.PERS_ID = p.PERS_ID\n             AND    d.CDEC_CODE IN\n                    ('02','34','35','36','52','54'))\n            > DATE '2024-12-31'))\nSELECT COUNT(*) FROM permanents_2024\n-- la requête complète écarte aussi les\n-- décisions annulées par une 40, lit les\n-- décisions collectives et sort les agents\n-- en disponibilité : 741 en 2024",
      "autoResize": true,
      "lineHeight": 1.25
    },
