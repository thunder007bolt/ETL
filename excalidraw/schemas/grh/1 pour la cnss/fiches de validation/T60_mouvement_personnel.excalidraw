    {
      "id": "iQsi4g48lXGxFRd3UEjV",
      "type": "text",
      "x": 779.44,
      "y": 4346.0,
      "width": 417.59999999999997,
      "height": 180.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "x3HOY69WY2nj45pZweuL"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 183472867,
      "version": 1,
      "versionNonce": 127110306,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794932908352,
      "link": null,
      "locked": false,
      "text": "-- une entrée embauchée en 2024 (à défaut\n-- d'embauche, la prise de service)\nSELECT COUNT(*)\nFROM   permanents_2024\nWHERE  PERS_ID NOT IN\n       (SELECT PERS_ID FROM permanents_2023)\nAND    NVL(DATE_EMBAUCHE, DATE_PRISE_SERVICE)\n         >= DATE '2024-01-01'\n-- 2024 : 101 (l'annuaire : 104)",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-- une entrée embauchée en 2024 (à défaut\n-- d'embauche, la prise de service)\nSELECT COUNT(*)\nFROM   permanents_2024\nWHERE  PERS_ID NOT IN\n       (SELECT PERS_ID FROM permanents_2023)\nAND    NVL(DATE_EMBAUCHE, DATE_PRISE_SERVICE)\n         >= DATE '2024-01-01'\n-- 2024 : 101 (l'annuaire : 104)",
      "autoResize": true,
      "lineHeight": 1.25
    },
