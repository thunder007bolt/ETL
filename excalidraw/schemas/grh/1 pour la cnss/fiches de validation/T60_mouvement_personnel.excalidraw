    {
      "id": "pKcgaygPuqq6Xm6cd304",
      "type": "text",
      "x": 2074.44,
      "y": 3042.0,
      "width": 436.15999999999997,
      "height": 280.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "g9xNO7aHAFndd9x3ZcF4"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 271938324,
      "version": 1,
      "versionNonce": 58719422,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794932908352,
      "link": null,
      "locked": false,
      "text": "-- entrée : dans la liste de fin, pas\n-- dans celle du début ; sortie : l'inverse\nSELECT\n  (SELECT COUNT(*) FROM permanents_2024\n   WHERE  PERS_ID NOT IN\n          (SELECT PERS_ID\n           FROM   permanents_2023)) AS entrees,\n  (SELECT COUNT(*) FROM permanents_2023\n   WHERE  PERS_ID NOT IN\n          (SELECT PERS_ID\n           FROM   permanents_2024)) AS sorties\nFROM   DUAL\n-- 2024 : 101 entrées et 30 sorties ;\n-- 741 − 670 = 71",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-- entrée : dans la liste de fin, pas\n-- dans celle du début ; sortie : l'inverse\nSELECT\n  (SELECT COUNT(*) FROM permanents_2024\n   WHERE  PERS_ID NOT IN\n          (SELECT PERS_ID\n           FROM   permanents_2023)) AS entrees,\n  (SELECT COUNT(*) FROM permanents_2023\n   WHERE  PERS_ID NOT IN\n          (SELECT PERS_ID\n           FROM   permanents_2024)) AS sorties\nFROM   DUAL\n-- 2024 : 101 entrées et 30 sorties ;\n-- 741 − 670 = 71",
      "autoResize": true,
      "lineHeight": 1.25
    },
