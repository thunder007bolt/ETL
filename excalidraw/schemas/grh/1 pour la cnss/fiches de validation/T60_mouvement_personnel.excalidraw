    {
      "id": "QvRZkS9NCuvNh4sVosBp",
      "type": "text",
      "x": 830,
      "y": 1017,
      "width": 1722.06,
      "height": 45.0,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
