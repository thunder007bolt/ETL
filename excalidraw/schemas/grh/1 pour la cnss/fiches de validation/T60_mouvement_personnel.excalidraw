    {
      "id": "KHFq5zZ77TNPLbX61Mhv",
      "type": "text",
      "x": 779.44,
      "y": 5341.5,
      "width": 417.59999999999997,
      "height": 480.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "wgC4UfAOAkKzyv1AuqIm"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 596966296,
      "version": 1,
      "versionNonce": 578437847,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794932908352,
      "link": null,
      "locked": false,
      "text": "-- même liste sorties_2024 (règle 5)\nSELECT CDEC_CODE, COUNT(*)\nFROM   sorties_2024\nWHERE  CDEC_CODE IN ('35','36','52','54')\nGROUP  BY CDEC_CODE\n-- 36 démission, 54 licenciement,\n-- 35 et 52 fin de contrat\n-- 2024 : 36 = 2 ; 54 = 1 (comme l'annuaire)\n-- les sorties sans départ daté en 2024\nSELECT COUNT(*)\nFROM   permanents_2023\nWHERE  PERS_ID NOT IN\n       (SELECT PERS_ID FROM permanents_2024)\nAND    PERS_ID NOT IN\n       (SELECT PERS_ID FROM sorties_2024)\n-- 2024 : environ 6 : 5 mises en\n-- disponibilité, 1 sans départ daté\n-- à part : les mises en disponibilité (07)\nSELECT COUNT(DISTINCT PERS_ID)\nFROM   USER_GRH.GRH_DECISION\nWHERE  CDEC_CODE = '07'\nAND    DATE_VIGUEUR BETWEEN DATE '2024-01-01'\n                        AND DATE '2024-12-31'\n-- 2024 : 5 (l'annuaire : 7)",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-- même liste sorties_2024 (règle 5)\nSELECT CDEC_CODE, COUNT(*)\nFROM   sorties_2024\nWHERE  CDEC_CODE IN ('35','36','52','54')\nGROUP  BY CDEC_CODE\n-- 36 démission, 54 licenciement,\n-- 35 et 52 fin de contrat\n-- 2024 : 36 = 2 ; 54 = 1 (comme l'annuaire)\n-- les sorties sans départ daté en 2024\nSELECT COUNT(*)\nFROM   permanents_2023\nWHERE  PERS_ID NOT IN\n       (SELECT PERS_ID FROM permanents_2024)\nAND    PERS_ID NOT IN\n       (SELECT PERS_ID FROM sorties_2024)\n-- 2024 : environ 6 : 5 mises en\n-- disponibilité, 1 sans départ daté\n-- à part : les mises en disponibilité (07)\nSELECT COUNT(DISTINCT PERS_ID)\nFROM   USER_GRH.GRH_DECISION\nWHERE  CDEC_CODE = '07'\nAND    DATE_VIGUEUR BETWEEN DATE '2024-01-01'\n                        AND DATE '2024-12-31'\n-- 2024 : 5 (l'annuaire : 7)",
      "autoResize": true,
      "lineHeight": 1.25
    },
