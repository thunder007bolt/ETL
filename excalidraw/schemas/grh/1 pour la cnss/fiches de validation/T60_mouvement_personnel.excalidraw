    {
      "id": "5fblGqfVf2mkzQtAAvyu",
      "type": "text",
      "x": 137.88,
      "y": 5497.0,
      "width": 573.12,
      "height": 80.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
