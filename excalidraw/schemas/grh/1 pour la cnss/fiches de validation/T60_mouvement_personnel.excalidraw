      "seed": 1306292050,
      "version": 1,
      "versionNonce": 1347969335,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794932908352,
      "link": null,
      "locked": false,
      "text": "La disponibilité fait sortir l'agent de l'effectif, comme dans l'annuaire (retenu\nle 08/11). Mais 12 agents mis en disponibilité de 2021 à 2025 ont une fiche\ninactive sans départ daté : la requête ne les voit pas. La fiche passe-t-elle bien à\n« inactif » pendant une disponibilité, et pour quelles autres absences ?",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "La disponibilité fait sortir l'agent de l'effectif, comme dans l'annuaire (retenu\nle 08/11). Mais 12 agents mis en disponibilité de 2021 à 2025 ont une fiche\ninactive sans départ daté : la requête ne les voit pas. La fiche passe-t-elle bien à\n« inactif » pendant une disponibilité, et pour quelles autres absences ?",
      "autoResize": true,
      "lineHeight": 1.25
    },
