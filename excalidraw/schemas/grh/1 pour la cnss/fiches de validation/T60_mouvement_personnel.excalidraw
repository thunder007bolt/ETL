        "Trn45toxLf2yzTewBsjY"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 699663040,
      "version": 1,
      "versionNonce": 1030963508,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794932908352,
      "link": null,
      "locked": false,
      "text": "T60 montre 1, 1, 0, 1 et 0 disponibilité de 2020 à 2024, pour 5,\n3, 2, 4 et 7 publiées, alors que la base a 3, 4, 2, 5 et 6 décisions\n07 : 12 agents en disponibilité ont une fiche inactive sans départ\ndaté, que la règle ne voit pas (question Q2)",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "T60 montre 1, 1, 0, 1 et 0 disponibilité de 2020 à 2024, pour 5,\n3, 2, 4 et 7 publiées, alors que la base a 3, 4, 2, 5 et 6 décisions\n07 : 12 agents en disponibilité ont une fiche inactive sans départ\ndaté, que la règle ne voit pas (question Q2)",
      "autoResize": true,
      "lineHeight": 1.25
    },
