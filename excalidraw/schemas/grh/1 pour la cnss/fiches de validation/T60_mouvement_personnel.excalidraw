    {
      "id": "TOmP5Ke5KHqurEQuOZUD",
      "type": "text",
      "x": 1752.3333333333333,
      "y": 7574.5,
      "width": 808.3800000000001,
      "height": 90.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "aa82O6JAP1SXfBgCrWLG"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1129510714,
      "version": 1,
      "versionNonce": 968959971,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794932908352,
      "link": null,
      "locked": false,
      "text": "L'annuaire compte 84 « autres entrées » en 2019 et 84 « autres sorties » en 2024.\nCes 84 permanents, en service depuis 2018 et engagés en 2019, ont une fiche\ninactive sans aucun départ. Que sont-ils devenus, et pouvez-vous saisir leur départ\ndans l'application ?",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "L'annuaire compte 84 « autres entrées » en 2019 et 84 « autres sorties » en 2024.\nCes 84 permanents, en service depuis 2018 et engagés en 2019, ont une fiche\ninactive sans aucun départ. Que sont-ils devenus, et pouvez-vous saisir leur départ\ndans l'application ?",
      "autoResize": true,
      "lineHeight": 1.25
    },
