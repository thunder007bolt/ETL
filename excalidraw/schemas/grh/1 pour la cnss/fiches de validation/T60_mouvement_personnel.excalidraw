      "boundElements": [],
      "updated": 1794932908352,
      "link": null,
      "locked": false,
      "text": "Dans cet ordre : un agent classé comme détaché (décision 37) ; un agent\nrevenu de disponibilité (décision 18), comme dans l'annuaire de la\nCNSS ; un agent qui était dans l'autre nature au 31 décembre d'avant,\ncomme un temporaire devenu permanent ; sinon, une entrée sans\nexplication, à vérifier.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Dans cet ordre : un agent classé comme détaché (décision 37) ; un agent\nrevenu de disponibilité (décision 18), comme dans l'annuaire de la\nCNSS ; un agent qui était dans l'autre nature au 31 décembre d'avant,\ncomme un temporaire devenu permanent ; sinon, une entrée sans\nexplication, à vérifier.",
      "autoResize": true,
      "lineHeight": 1.25
    },
