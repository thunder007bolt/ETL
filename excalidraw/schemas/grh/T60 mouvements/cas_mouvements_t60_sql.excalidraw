      "seed": 10177135,
      "version": 1,
      "versionNonce": 1676880578,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794158206751,
      "link": null,
      "locked": false,
      "text": "LES ENTRÉES (partie 9, l. 449 à 506) : qui entre, et avec quel cas",
      "fontSize": 22,
