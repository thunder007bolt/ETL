      "seed": 895601894,
      "version": 1,
      "versionNonce": 1379160682,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794158206751,
      "link": null,
      "locked": false,
      "text": "SELECT annee, 'DEBUT' AS CODE_TYPE_MVT, PERS_ID AS id_mvt, PERS_ID, SEXE,\n…\nSELECT annee, CODE_TYPE_MVT, MVT_ID, PERS_ID, SEXE,        -- internes : id_mvt = MVT_ID\n…\nCOUNT(m.id_mvt)                                       AS NB_MOUVEMENTS,\nCOUNT(DISTINCT m.PERS_ID)                             AS NB_AGENTS,",
      "fontSize": 17,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "SELECT annee, 'DEBUT' AS CODE_TYPE_MVT, PERS_ID AS id_mvt, PERS_ID, SEXE,\n…\nSELECT annee, CODE_TYPE_MVT, MVT_ID, PERS_ID, SEXE,        -- internes : id_mvt = MVT_ID\n…\nCOUNT(m.id_mvt)                                       AS NB_MOUVEMENTS,\nCOUNT(DISTINCT m.PERS_ID)                             AS NB_AGENTS,",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "C1Fx5pdaUFENsE1ofqR7",
      "type": "text",
      "x": 2444,
      "y": 9466.5,
      "width": 513.54,
      "height": 90.0,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
