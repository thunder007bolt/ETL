      "text": "ADD_MONTHS(da.date_arrete, -12)                            AS d0,\nda.date_arrete                                             AS d1\n…\nTO_NUMBER(TO_CHAR(m.annee) || '1231')                 AS ID_TEMPS,",
      "fontSize": 17,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "ADD_MONTHS(da.date_arrete, -12)                            AS d0,\nda.date_arrete                                             AS d1\n…\nTO_NUMBER(TO_CHAR(m.annee) || '1231')                 AS ID_TEMPS,",
      "autoResize": true,
      "lineHeight": 1.25
