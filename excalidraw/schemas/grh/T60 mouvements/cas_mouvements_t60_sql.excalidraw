      "versionNonce": 367588851,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794158206751,
      "link": null,
      "locked": false,
      "text": "JOIN decisions d ON d.date_decision >  e.d0\n                AND d.date_decision <= e.d1\n…\n  AND d.code = cd.classement_detache                  -- '37'\n…\nWHEN NVL(f.NATURE_EMPLOI, '-') <> 'TEMPORAIRE'\n AND dt.PERS_ID IS NOT NULL        THEN 'DETACHEMENT'  -- le premier WHEN",
      "fontSize": 17,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "JOIN decisions d ON d.date_decision >  e.d0\n                AND d.date_decision <= e.d1\n…\n  AND d.code = cd.classement_detache                  -- '37'\n…\nWHEN NVL(f.NATURE_EMPLOI, '-') <> 'TEMPORAIRE'\n AND dt.PERS_ID IS NOT NULL        THEN 'DETACHEMENT'  -- le premier WHEN",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
