    {
      "id": "RY92hw9UYiSgcBFC1lGr",
      "type": "text",
      "x": 1249,
      "y": 7144.25,
      "width": 897.2599999999999,
      "height": 106.25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
