      "seed": 1925992725,
      "version": 1,
      "versionNonce": 1315208786,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794158206751,
      "link": null,
      "locked": false,
      "text": "ROW_NUMBER() OVER (PARTITION BY e.annee, dep.PERS_ID\n                   ORDER BY dep.date_depart DESC, dep.motif DESC) AS rn   -- le dernier\n…\nJOIN departs dep ON dep.date_depart >  e.d0\n                AND dep.date_depart <= e.d1\n…\nWHEN dbt.NATURE_EMPLOI = 'TEMPORAIRE'\n AND dda.PERS_ID IS NOT NULL                     THEN 'DEPART_TEMPORAIRE'",
      "fontSize": 17,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "ROW_NUMBER() OVER (PARTITION BY e.annee, dep.PERS_ID\n                   ORDER BY dep.date_depart DESC, dep.motif DESC) AS rn   -- le dernier\n…\nJOIN departs dep ON dep.date_depart >  e.d0\n                AND dep.date_depart <= e.d1\n…\nWHEN dbt.NATURE_EMPLOI = 'TEMPORAIRE'\n AND dda.PERS_ID IS NOT NULL                     THEN 'DEPART_TEMPORAIRE'",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "Iga9LZ2M0gOelmhMEity",
      "type": "text",
      "x": 2444,
      "y": 5992.0,
      "width": 519.12,
      "height": 90.0,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "kSW1VxAKUsSNg3WGEfKc"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1147193502,
      "version": 1,
      "versionNonce": 714404715,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794158206751,
      "link": null,
      "locked": false,
      "text": "Pour un temporaire, le dernier départ de l'année, pas\nle premier de sa vie. Une 35 en mars, un contrat en\nmai, une 52 en octobre : la sortie est DECISION_52\n(vérifié).",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Pour un temporaire, le dernier départ de l'année, pas\nle premier de sa vie. Une 35 en mars, un contrat en\nmai, une 52 en octobre : la sortie est DECISION_52\n(vérifié).",
      "autoResize": true,
      "lineHeight": 1.25
    },
