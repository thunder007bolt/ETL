      "boundElements": [],
      "updated": 1794158206751,
      "link": null,
      "locked": false,
      "text": "SELECT '36', 'DEM',       'démission'          FROM DUAL UNION ALL\n…\nSELECT '54', 'LIC',       'licenciement'       FROM DUAL\n…\nSELECT NVL(d.PERS_ID, dp.PERS_ID) AS PERS_ID,    -- l'agent, ou la liste de la décision\n…\nLEFT JOIN DWH.FAIT_GRH_DECISION_PERSONNE dp\n       ON dp.DECI_NO = d.DECI_NO",
      "fontSize": 17,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "SELECT '36', 'DEM',       'démission'          FROM DUAL UNION ALL\n…\nSELECT '54', 'LIC',       'licenciement'       FROM DUAL\n…\nSELECT NVL(d.PERS_ID, dp.PERS_ID) AS PERS_ID,    -- l'agent, ou la liste de la décision\n…\nLEFT JOIN DWH.FAIT_GRH_DECISION_PERSONNE dp\n       ON dp.DECI_NO = d.DECI_NO",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "JgjKvKmkPtC8Fhmaa0k1",
      "type": "text",
      "x": 2444,
      "y": 5772.0,
