      "versionNonce": 2083385638,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794158206751,
      "link": null,
      "locked": false,
      "text": "JOIN contrats c ON c.debut       <= da.date_arrete\n               AND da.date_arrete <  c.fin           -- le contrat de juin couvre le 31/12\n…\nWHERE fin.PERS_ID IS NULL                            -- faux : présent à la fin\n   OR NVL(fin.NATURE_EMPLOI, '-') <> NVL(dbt.NATURE_EMPLOI, '-')   -- faux",
      "fontSize": 17,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "JOIN contrats c ON c.debut       <= da.date_arrete\n               AND da.date_arrete <  c.fin           -- le contrat de juin couvre le 31/12\n…\nWHERE fin.PERS_ID IS NULL                            -- faux : présent à la fin\n   OR NVL(fin.NATURE_EMPLOI, '-') <> NVL(dbt.NATURE_EMPLOI, '-')   -- faux",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
