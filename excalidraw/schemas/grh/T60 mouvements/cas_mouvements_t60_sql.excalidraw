    {
      "id": "0mORNDCRklXG1iCCQyqS",
      "type": "text",
      "x": 1249,
      "y": 6432.0,
      "width": 907.12,
      "height": 127.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
