    {
      "id": "1bxTvKoiv2JIs8pMEDjd",
      "type": "text",
      "x": 62,
      "y": 9798.0,
      "width": 847.9599999999999,
      "height": 680.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "WhFonvoRwTKlffsHBYpF"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1871737219,
      "version": 1,
      "versionNonce": 1458375289,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794158206751,
      "link": null,
      "locked": false,
      "text": "mouvements AS (\n    SELECT annee, 'DEBUT' AS CODE_TYPE_MVT, PERS_ID AS id_mvt, PERS_ID, SEXE,   -- G14\n    …\n    FROM au_debut\n    UNION ALL\n    …\n    FROM entrees                     -- G8\n    UNION ALL\n    …\n    FROM sorties                     -- G9\n    UNION ALL\n    …\n    FROM passages                    -- G16 : l'entrée (RECRU)…\n    UNION ALL\n    …\n    FROM passages                    -- … puis la sortie\n    UNION ALL\n    …\n    FROM internes                    -- G17\n)\nSELECT\n    TO_NUMBER(TO_CHAR(m.annee) || '1231')                 AS ID_TEMPS,\n    m.CODE_TYPE_MVT,\n    tm.CODE_NAT_MVT,\n    …\n    COUNT(m.id_mvt)                                       AS NB_MOUVEMENTS,\n    COUNT(DISTINCT m.PERS_ID)                             AS NB_AGENTS,\n    …\nFROM mouvements m\nLEFT JOIN DTM.DIM_GRH_TYPE_MOUVEMENT tm\n       ON tm.CODE_TYPE_MVT = m.CODE_TYPE_MVT\nGROUP BY …                           -- les mêmes axes",
      "fontSize": 17,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "mouvements AS (\n    SELECT annee, 'DEBUT' AS CODE_TYPE_MVT, PERS_ID AS id_mvt, PERS_ID, SEXE,   -- G14\n    …\n    FROM au_debut\n    UNION ALL\n    …\n    FROM entrees                     -- G8\n    UNION ALL\n    …\n    FROM sorties                     -- G9\n    UNION ALL\n    …\n    FROM passages                    -- G16 : l'entrée (RECRU)…\n    UNION ALL\n    …\n    FROM passages                    -- … puis la sortie\n    UNION ALL\n    …\n    FROM internes                    -- G17\n)\nSELECT\n    TO_NUMBER(TO_CHAR(m.annee) || '1231')                 AS ID_TEMPS,\n    m.CODE_TYPE_MVT,\n    tm.CODE_NAT_MVT,\n    …\n    COUNT(m.id_mvt)                                       AS NB_MOUVEMENTS,\n    COUNT(DISTINCT m.PERS_ID)                             AS NB_AGENTS,\n    …\nFROM mouvements m\nLEFT JOIN DTM.DIM_GRH_TYPE_MOUVEMENT tm\n       ON tm.CODE_TYPE_MVT = m.CODE_TYPE_MVT\nGROUP BY …                           -- les mêmes axes",
      "autoResize": true,
      "lineHeight": 1.25
    },
