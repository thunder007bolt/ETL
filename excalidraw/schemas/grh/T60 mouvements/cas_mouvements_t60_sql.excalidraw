      "versionNonce": 1974893464,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794158206751,
      "link": null,
      "locked": false,
      "text": "WHERE fin.PERS_ID IS NULL                                        -- faux : présent à la fin…\n   OR NVL(fin.NATURE_EMPLOI, '-') <> NVL(dbt.NATURE_EMPLOI, '-') -- vrai : …mais permanent\n…\nWHEN fin.PERS_ID IS NOT NULL                      THEN 'NATURE'\n…\nWHEN 'NATURE'            THEN 'DEVIENT_' || NVL(x.nature_fin, 'SANS_SITUATION')",
      "fontSize": 17,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "WHERE fin.PERS_ID IS NULL                                        -- faux : présent à la fin…\n   OR NVL(fin.NATURE_EMPLOI, '-') <> NVL(dbt.NATURE_EMPLOI, '-') -- vrai : …mais permanent\n…\nWHEN fin.PERS_ID IS NOT NULL                      THEN 'NATURE'\n…\nWHEN 'NATURE'            THEN 'DEVIENT_' || NVL(x.nature_fin, 'SANS_SITUATION')",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
