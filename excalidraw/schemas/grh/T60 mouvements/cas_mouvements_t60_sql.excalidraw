    {
      "id": "5BLY84x0W6zrX2r2OGh1",
      "type": "text",
      "x": 1249,
      "y": 6212.0,
      "width": 769.0799999999999,
      "height": 170.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "1i75mrqlccSituJegaqk"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 103283695,
      "version": 1,
      "versionNonce": 1604205856,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794158206751,
      "link": null,
      "locked": false,
      "text": "WHEN NVL(dbt.NATURE_EMPLOI, '-') <> 'TEMPORAIRE'\n AND pr.disponibilite = 'HORS_EFFECTIF'               -- faux avec 'PRESENT'\n AND NVL(po.date_dispo, DATE '1900-01-01')\n     > NVL(po.date_remise, DATE '1900-01-01')   THEN 'DISPONIBILITE'\n…\nLEFT JOIN positions po ON po.date_arrete = dbt.d1     -- ses 07 et 18 au 31/12\n…\nWHEN 'DISPONIBILITE'     THEN 'DECISION_' || x.code_dispo   -- '07'",
      "fontSize": 17,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "WHEN NVL(dbt.NATURE_EMPLOI, '-') <> 'TEMPORAIRE'\n AND pr.disponibilite = 'HORS_EFFECTIF'               -- faux avec 'PRESENT'\n AND NVL(po.date_dispo, DATE '1900-01-01')\n     > NVL(po.date_remise, DATE '1900-01-01')   THEN 'DISPONIBILITE'\n…\nLEFT JOIN positions po ON po.date_arrete = dbt.d1     -- ses 07 et 18 au 31/12\n…\nWHEN 'DISPONIBILITE'     THEN 'DECISION_' || x.code_dispo   -- '07'",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "eqoFfTuZBtwtODVTtHeN",
      "type": "text",
      "x": 2444,
      "y": 6212.0,
      "width": 527.4,
      "height": 90.0,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "1i75mrqlccSituJegaqk"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1871944237,
      "version": 1,
      "versionNonce": 866627156,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794158206751,
      "link": null,
      "locked": false,
      "text": "Avec 'HORS_EFFECTIF', base l'écarte au 31/12 de\nl'année ; sans départ daté, sa 07 sans 18 donne DISP.\nAvec 'PRESENT', il reste sur les deux photos : aucune\nsortie. 2024 : 5 décisions 07.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Avec 'HORS_EFFECTIF', base l'écarte au 31/12 de\nl'année ; sans départ daté, sa 07 sans 18 donne DISP.\nAvec 'PRESENT', il reste sur les deux photos : aucune\nsortie. 2024 : 5 décisions 07.",
      "autoResize": true,
      "lineHeight": 1.25
    },
