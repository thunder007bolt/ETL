    {
      "id": "R8JeldBhyNUxLdSlVzAF",
      "type": "text",
      "x": 1542,
      "y": 9838.0,
      "width": 778.94,
      "height": 297.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "zP8KxXNaZHOmrbsjbr0p"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1769964870,
      "version": 1,
      "versionNonce": 920318817,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794158206751,
      "link": null,
      "locked": false,
      "text": "SUM(CASE WHEN CODE_TYPE_MVT = 'DEBUT' THEN NB_AGENTS ELSE 0 END) AS debut,\nSUM(CASE WHEN CODE_TYPE_MVT = 'RECRU' THEN NB_AGENTS ELSE 0 END) AS recrut,\nSUM(CASE WHEN CODE_NAT_MVT = 'ENTREES' AND CODE_TYPE_MVT <> 'RECRU'\n         THEN NB_AGENTS ELSE 0 END)                             AS autres_ent,\nSUM(CASE WHEN CODE_TYPE_MVT = 'RET' THEN NB_AGENTS ELSE 0 END)   AS retraite,\nSUM(CASE WHEN CODE_TYPE_MVT = 'DEC' THEN NB_AGENTS ELSE 0 END)   AS deces,\nSUM(CASE WHEN CODE_NAT_MVT = 'SORTIES'\n          AND CODE_TYPE_MVT NOT IN ('RET', 'DEC')\n         THEN NB_AGENTS ELSE 0 END)                             AS autres_sort,\nSUM(CASE WHEN CODE_NAT_MVT IN ('INITIAL', 'ENTREES') THEN NB_AGENTS\n         WHEN CODE_NAT_MVT = 'SORTIES' THEN -NB_AGENTS\n         ELSE 0 END)                                            AS fin\nFROM ( …la requête… )\nWHERE QUALITE_EMPLOYE = 'A' AND NATURE_EMPLOI = 'PERMANENT'",
      "fontSize": 17,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "SUM(CASE WHEN CODE_TYPE_MVT = 'DEBUT' THEN NB_AGENTS ELSE 0 END) AS debut,\nSUM(CASE WHEN CODE_TYPE_MVT = 'RECRU' THEN NB_AGENTS ELSE 0 END) AS recrut,\nSUM(CASE WHEN CODE_NAT_MVT = 'ENTREES' AND CODE_TYPE_MVT <> 'RECRU'\n         THEN NB_AGENTS ELSE 0 END)                             AS autres_ent,\nSUM(CASE WHEN CODE_TYPE_MVT = 'RET' THEN NB_AGENTS ELSE 0 END)   AS retraite,\nSUM(CASE WHEN CODE_TYPE_MVT = 'DEC' THEN NB_AGENTS ELSE 0 END)   AS deces,\nSUM(CASE WHEN CODE_NAT_MVT = 'SORTIES'\n          AND CODE_TYPE_MVT NOT IN ('RET', 'DEC')\n         THEN NB_AGENTS ELSE 0 END)                             AS autres_sort,\nSUM(CASE WHEN CODE_NAT_MVT IN ('INITIAL', 'ENTREES') THEN NB_AGENTS\n         WHEN CODE_NAT_MVT = 'SORTIES' THEN -NB_AGENTS\n         ELSE 0 END)                                            AS fin\nFROM ( …la requête… )\nWHERE QUALITE_EMPLOYE = 'A' AND NATURE_EMPLOI = 'PERMANENT'",
      "autoResize": true,
      "lineHeight": 1.25
    },
