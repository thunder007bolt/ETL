      "versionNonce": 564663462,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794158206751,
      "link": null,
      "locked": false,
      "text": "WHERE pr.passages_annee = 'OUI'           -- faux avec 'NON' : aucune ligne\n  AND p.etat = 'INACTIF'\n  AND NVL(si.nature, '-') <> 'TEMPORAIRE'\n  AND dbt.PERS_ID IS NULL                 -- absent de la photo du début\n  AND fin.PERS_ID IS NULL                 -- et de celle de la fin",
      "fontSize": 17,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "WHERE pr.passages_annee = 'OUI'           -- faux avec 'NON' : aucune ligne\n  AND p.etat = 'INACTIF'\n  AND NVL(si.nature, '-') <> 'TEMPORAIRE'\n  AND dbt.PERS_ID IS NULL                 -- absent de la photo du début\n  AND fin.PERS_ID IS NULL                 -- et de celle de la fin",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "QT7x4YsmCBiVcs73hs29",
      "type": "text",
      "x": 2444,
      "y": 7925.5,
      "width": 504.0,
      "height": 90.0,
      "angle": 0,
      "strokeColor": "#495057",
