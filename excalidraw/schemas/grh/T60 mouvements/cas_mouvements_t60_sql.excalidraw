      "boundElements": [],
      "updated": 1794158206751,
      "link": null,
      "locked": false,
      "text": "AND (TO_CHAR(d.CDEC_CODE) IN (SELECT code FROM decisions_depart)   -- 02 34 35 36 52 54\n     OR TO_CHAR(d.CDEC_CODE) IN (cd.engagement_temporaire, cd.engagement_permanent,\n                                 cd.mise_en_disponibilite, cd.remise_en_activite,\n                                 cd.classement_detache))      -- 50 51 07 18 37 : pas 14",
      "fontSize": 17,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "AND (TO_CHAR(d.CDEC_CODE) IN (SELECT code FROM decisions_depart)   -- 02 34 35 36 52 54\n     OR TO_CHAR(d.CDEC_CODE) IN (cd.engagement_temporaire, cd.engagement_permanent,\n                                 cd.mise_en_disponibilite, cd.remise_en_activite,\n                                 cd.classement_detache))      -- 50 51 07 18 37 : pas 14",
