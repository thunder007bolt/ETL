    {
      "id": "KlccHmoxbR1qdLfzXAXz",
      "type": "text",
      "x": 1249,
      "y": 5289.5,
      "width": 857.8199999999999,
      "height": 233.75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "uOkJIdxJ1mbJ7VdVl8Hc"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1964201775,
      "version": 1,
      "versionNonce": 603369329,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794158206751,
      "link": null,
      "locked": false,
      "text": "SELECT '02' AS code, 'RET' AS type_mvt, …          -- partie 0 : le type de chaque code\n…\ndd.type_mvt, 'DECISION_' || dc.code AS motif       -- partie 3 : departs\n…\nJOIN decisions_depart dd ON dd.code = dc.code\n…\nWHEN NVL(dbt.NATURE_EMPLOI, '-') <> 'TEMPORAIRE'\n AND pd.date_depart >  dbt.d0\n AND pd.date_depart <= dbt.d1          THEN 'DEPART_PERMANENT'   -- vrai : 30/06/2024\n…\nWHEN 'DEPART_PERMANENT'  THEN x.type_premier       -- 'RET'",
      "fontSize": 17,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "SELECT '02' AS code, 'RET' AS type_mvt, …          -- partie 0 : le type de chaque code\n…\ndd.type_mvt, 'DECISION_' || dc.code AS motif       -- partie 3 : departs\n…\nJOIN decisions_depart dd ON dd.code = dc.code\n…\nWHEN NVL(dbt.NATURE_EMPLOI, '-') <> 'TEMPORAIRE'\n AND pd.date_depart >  dbt.d0\n AND pd.date_depart <= dbt.d1          THEN 'DEPART_PERMANENT'   -- vrai : 30/06/2024\n…\nWHEN 'DEPART_PERMANENT'  THEN x.type_premier       -- 'RET'",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
