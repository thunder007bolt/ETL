      "versionNonce": 638092130,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794158206751,
      "link": null,
      "locked": false,
      "text": "WHEN f.NATURE_EMPLOI = 'TEMPORAIRE'                   -- vrai : temporaire à la fin\n AND tc0.PERS_ID IS NULL           THEN 'ENGAGEMENT'  -- vrai : aucun contrat au début\n…\nLEFT JOIN temporaires_sous_contrat tc0 ON tc0.date_arrete = f.d0\n…\nWHEN 'ENGAGEMENT'  THEN 'ENGAGEMENT_' || x.code_engagement     -- '50'",
      "fontSize": 17,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "WHEN f.NATURE_EMPLOI = 'TEMPORAIRE'                   -- vrai : temporaire à la fin\n AND tc0.PERS_ID IS NULL           THEN 'ENGAGEMENT'  -- vrai : aucun contrat au début\n…\nLEFT JOIN temporaires_sous_contrat tc0 ON tc0.date_arrete = f.d0\n…\nWHEN 'ENGAGEMENT'  THEN 'ENGAGEMENT_' || x.code_engagement     -- '50'",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "Tu3BKuhXVsK5uiLgW4a2",
      "type": "text",
      "x": 2444,
      "y": 3916.0,
      "width": 510.84000000000003,
      "height": 67.5,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
