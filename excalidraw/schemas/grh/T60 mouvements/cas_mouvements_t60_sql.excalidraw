      "roundness": null,
      "seed": 1665719475,
      "version": 1,
      "versionNonce": 604732896,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794158206751,
      "link": null,
      "locked": false,
      "text": "Rien ne l'explique : MOTIF_MVT le signale.\nSeulement si sa fiche garde la date d'embauche de son\npremier contrat ; sinon, c'est un RECRU. À lister\npour la DRH.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Rien ne l'explique : MOTIF_MVT le signale.\nSeulement si sa fiche garde la date d'embauche de son\npremier contrat ; sinon, c'est un RECRU. À lister\npour la DRH.",
      "autoResize": true,
      "lineHeight": 1.25
    },
