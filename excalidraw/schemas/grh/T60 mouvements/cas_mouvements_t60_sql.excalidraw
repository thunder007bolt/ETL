      "versionNonce": 1671379954,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794158206751,
      "link": null,
      "locked": false,
      "text": "Aucun contrat ne couvrait le 31/12 d'avant : tc0 est\nvide. Son engagement 50 est un recrutement, dans le\ntableau des temporaires.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Aucun contrat ne couvrait le 31/12 d'avant : tc0 est\nvide. Son engagement 50 est un recrutement, dans le\ntableau des temporaires.",
      "autoResize": true,
      "lineHeight": 1.25
    },
