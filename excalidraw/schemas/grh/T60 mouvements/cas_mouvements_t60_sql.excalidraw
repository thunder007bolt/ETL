      "updated": 1794158206751,
      "link": null,
      "locked": false,
      "text": "LEAD(e.date_decision) OVER (PARTITION BY e.PERS_ID\n                            ORDER BY e.date_decision) AS debut_suivant\n…\nLEAST(NVL(MIN(dep.date_depart), DATE '9999-12-31'),\n      NVL(g.debut_suivant, DATE '9999-12-31'))         AS fin   -- = début du suivant",
      "fontSize": 17,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "LEAD(e.date_decision) OVER (PARTITION BY e.PERS_ID\n                            ORDER BY e.date_decision) AS debut_suivant\n…\nLEAST(NVL(MIN(dep.date_depart), DATE '9999-12-31'),\n      NVL(g.debut_suivant, DATE '9999-12-31'))         AS fin   -- = début du suivant",
      "autoResize": true,
      "lineHeight": 1.25
    },
