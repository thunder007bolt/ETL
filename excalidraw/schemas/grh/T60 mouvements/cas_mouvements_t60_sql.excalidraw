      "updated": 1794158206751,
      "link": null,
      "locked": false,
      "text": "SELECT da.date_arrete, s.PERS_ID, s.QUAL_CODE, s.UA_CODE,\n…\nCASE m.SEXE\n    WHEN 'M' THEN 'Masculin'\n    WHEN 'F' THEN 'Féminin'\n    ELSE 'NON RENSEIGNE'\nEND                                                   AS LIBELLE_SEXE,",
      "fontSize": 17,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "SELECT da.date_arrete, s.PERS_ID, s.QUAL_CODE, s.UA_CODE,\n…\nCASE m.SEXE\n    WHEN 'M' THEN 'Masculin'\n    WHEN 'F' THEN 'Féminin'\n    ELSE 'NON RENSEIGNE'\nEND                                                   AS LIBELLE_SEXE,",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "ZigfKslIt3DpIBTxSQug",
      "type": "text",
      "x": 2444,
      "y": 9111.5,
      "width": 526.32,
