    {
      "id": "OjRrmSuXNnzVydnNyd5F",
      "type": "text",
      "x": 1249,
      "y": 7456.75,
      "width": 887.4,
      "height": 106.25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
