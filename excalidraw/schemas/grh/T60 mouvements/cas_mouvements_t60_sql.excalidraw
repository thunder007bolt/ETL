    {
      "id": "YVaFJW304r9v2vlIYtMz",
      "type": "text",
      "x": 1249,
      "y": 4533.5,
      "width": 719.78,
      "height": 148.75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
