      "seed": 1199853389,
      "version": 1,
      "versionNonce": 2126806420,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794158206751,
      "link": null,
      "locked": false,
      "text": "WHERE dbt.PERS_ID IS NULL                                        -- faux : présent au début\n   OR NVL(dbt.NATURE_EMPLOI, '-') <> NVL(f.NATURE_EMPLOI, '-')   -- faux : même nature\n…\nWHERE pr.mouvements_internes = 'COMME_AVANT'          -- partie 12, GRH_MOUVEMENT\n  AND NVL(tm.CODE_NAT_MVT, '-') NOT IN ('INITIAL', 'ENTREES', 'SORTIES')",
      "fontSize": 17,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "WHERE dbt.PERS_ID IS NULL                                        -- faux : présent au début\n   OR NVL(dbt.NATURE_EMPLOI, '-') <> NVL(f.NATURE_EMPLOI, '-')   -- faux : même nature\n…\nWHERE pr.mouvements_internes = 'COMME_AVANT'          -- partie 12, GRH_MOUVEMENT\n  AND NVL(tm.CODE_NAT_MVT, '-') NOT IN ('INITIAL', 'ENTREES', 'SORTIES')",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "RPIj5U5FZ0S2Igmf9eB5",
      "type": "text",
      "x": 2444,
      "y": 7144.25,
      "width": 529.2,
      "height": 90.0,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
