      "seed": 1833031302,
      "version": 1,
      "versionNonce": 1118110498,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794158206751,
      "link": null,
      "locked": false,
      "text": "Seules la présence et la nature sont comparées, pas\nl'unité ni la qualification. Ses mutations viennent de\nGRH_MOUVEMENT, comme avant, en lignes INTERNE :\ndeux mutations font 2 mouvements, 1 agent (vérifié).",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Seules la présence et la nature sont comparées, pas\nl'unité ni la qualification. Ses mutations viennent de\nGRH_MOUVEMENT, comme avant, en lignes INTERNE :\ndeux mutations font 2 mouvements, 1 agent (vérifié).",
      "autoResize": true,
      "lineHeight": 1.25
    },
