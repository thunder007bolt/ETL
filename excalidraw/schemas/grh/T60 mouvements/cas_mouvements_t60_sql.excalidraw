    {
      "id": "qsvW8JvJkPk1TxWXgw9A",
      "type": "text",
      "x": 1249,
      "y": 5573.25,
      "width": 877.54,
      "height": 148.75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
