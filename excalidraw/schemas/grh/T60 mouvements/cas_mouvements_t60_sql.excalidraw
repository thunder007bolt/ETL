      "boundElements": [],
      "updated": 1794158206751,
      "link": null,
      "locked": false,
      "text": "SELECT '34', 'DEC',       'liquidation des droits après décès'   …   -- partie 0\n…\nUNION ALL                                          -- partie 3, departs :\nSELECT PERS_ID, DATE_DECES, 'DEC', 'DATE_DECES'    -- la date de décès, un départ de plus\nFROM DWH.FAIT_GRH_PERSONNE\nWHERE CLICHE = :1\n  AND DATE_DECES IS NOT NULL",
      "fontSize": 17,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "SELECT '34', 'DEC',       'liquidation des droits après décès'   …   -- partie 0\n…\nUNION ALL                                          -- partie 3, departs :\nSELECT PERS_ID, DATE_DECES, 'DEC', 'DATE_DECES'    -- la date de décès, un départ de plus\nFROM DWH.FAIT_GRH_PERSONNE\nWHERE CLICHE = :1\n  AND DATE_DECES IS NOT NULL",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "T0BxpaVnKfAFVV1zC0AP",
      "type": "text",
      "x": 2444,
      "y": 5573.25,
      "width": 517.6800000000001,
      "height": 90.0,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "9KDrpg82NcnWO9HIEIvi"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1575599,
      "version": 1,
      "versionNonce": 1721807456,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794158206751,
      "link": null,
      "locked": false,
      "text": "La date de décès est un départ comme un autre. Sans\nelle, l'agent sort à la 34, environ 8 mois après,\nsouvent l'année suivante : aucune date de décès depuis\n2010 (QG3). 2024 : 5, pour 3 publiés.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "La date de décès est un départ comme un autre. Sans\nelle, l'agent sort à la 34, environ 8 mois après,\nsouvent l'année suivante : aucune date de décès depuis\n2010 (QG3). 2024 : 5, pour 3 publiés.",
      "autoResize": true,
      "lineHeight": 1.25
    },
