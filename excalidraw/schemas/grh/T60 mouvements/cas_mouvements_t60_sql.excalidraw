      "versionNonce": 2007216718,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794158206751,
      "link": null,
      "locked": false,
      "text": "LEFT JOIN premier_depart pd ON pd.PERS_ID = p.PERS_ID          -- rien : pd.* = NULL\n…\nAND (p.etat <> 'INACTIF' OR pd.date_depart > da.date_arrete)   -- faux OR NULL : faux\n…\nJOIN base b ON b.date_arrete = e.d0                            -- partie 8 : aucune photo",
      "fontSize": 17,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "LEFT JOIN premier_depart pd ON pd.PERS_ID = p.PERS_ID          -- rien : pd.* = NULL\n…\nAND (p.etat <> 'INACTIF' OR pd.date_depart > da.date_arrete)   -- faux OR NULL : faux\n…\nJOIN base b ON b.date_arrete = e.d0                            -- partie 8 : aucune photo",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "uJqu6dWH0roEXOuAMJBk",
      "type": "text",
      "x": 2444,
      "y": 8081.75,
      "width": 525.6,
      "height": 90.0,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "4ojGyaQq49eQYdLREylP"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 420882328,
      "version": 1,
      "versionNonce": 126729555,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794158206751,
      "link": null,
      "locked": false,
      "text": "Jamais dans base, donc sur aucune photo : ni entrée, ni\nsortie. Ce sont surtout les 84 engagés de 2019 (G11),\nque l'annuaire CNSS sort tous en 2024 : 84 de ses 94\nautres sorties.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Jamais dans base, donc sur aucune photo : ni entrée, ni\nsortie. Ce sont surtout les 84 engagés de 2019 (G11),\nque l'annuaire CNSS sort tous en 2024 : 84 de ses 94\nautres sorties.",
      "autoResize": true,
      "lineHeight": 1.25
    },
