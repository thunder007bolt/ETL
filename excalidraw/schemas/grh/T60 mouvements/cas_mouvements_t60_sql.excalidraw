      "seed": 432863329,
      "version": 1,
      "versionNonce": 654389924,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794158206751,
      "link": null,
      "locked": false,
      "text": "Au 31/12/2023, il est compté sans nature : RECRU,\nNATURE_EMPLOI vide, dans aucun tableau. En 2024,\nil quitte cette population (AUTRE_SORT) et entre\nchez les permanents. Sans le NVL, il ne bougerait\njamais (vérifié).",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Au 31/12/2023, il est compté sans nature : RECRU,\nNATURE_EMPLOI vide, dans aucun tableau. En 2024,\nil quitte cette population (AUTRE_SORT) et entre\nchez les permanents. Sans le NVL, il ne bougerait\njamais (vérifié).",
      "autoResize": true,
      "lineHeight": 1.25
    },
