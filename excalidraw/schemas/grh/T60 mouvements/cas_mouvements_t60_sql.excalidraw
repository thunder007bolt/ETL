    {
      "id": "vun6zSkM2UOTeKgpgJn0",
      "type": "text",
      "x": 1542,
      "y": 1930.5,
      "width": 1403.6000000000001,
      "height": 150.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
