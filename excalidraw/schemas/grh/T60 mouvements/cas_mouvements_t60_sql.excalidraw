      "isDeleted": false,
      "boundElements": [],
      "updated": 1794158206751,
      "link": null,
      "locked": false,
      "text": "WHERE dbt.PERS_ID IS NULL                         -- vrai : sans contrat, absent au début\n…\n-- [E3] à [E7] faux : ni 37, ni embauche dans l'année (sa date d'entrée est celle\n-- de son premier contrat), ni dispo, permanent à la fin, absent au début\nELSE                                                   'SANS_MOTIF'\n…\nELSE                    'AUTRE_ENT'",
      "fontSize": 17,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "WHERE dbt.PERS_ID IS NULL                         -- vrai : sans contrat, absent au début\n…\n-- [E3] à [E7] faux : ni 37, ni embauche dans l'année (sa date d'entrée est celle\n-- de son premier contrat), ni dispo, permanent à la fin, absent au début\nELSE                                                   'SANS_MOTIF'\n…\nELSE                    'AUTRE_ENT'",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "PDYob8ywceGF8Mw95ukk",
      "type": "text",
      "x": 2444,
      "y": 4894.75,
      "width": 517.32,
      "height": 90.0,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "DJRVKRaPfvIh3LQHfxac"
      ],
