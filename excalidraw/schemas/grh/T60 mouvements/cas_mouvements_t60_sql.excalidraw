      "link": null,
      "locked": false,
      "text": "Sous contrat aux deux 31/12. Sa 35 de mars est bien\ndans dernier_depart_annee, mais sorties ne garde que\nles absents de la photo de fin (lot 25).",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Sous contrat aux deux 31/12. Sa 35 de mars est bien\ndans dernier_depart_annee, mais sorties ne garde que\nles absents de la photo de fin (lot 25).",
      "autoResize": true,
      "lineHeight": 1.25
