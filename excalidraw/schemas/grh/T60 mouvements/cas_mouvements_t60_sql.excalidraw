    {
      "id": "ujM6l1wu3svUHgw01VNK",
      "type": "text",
      "x": 1249,
      "y": 5992.0,
      "width": 857.8199999999999,
      "height": 170.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "kSW1VxAKUsSNg3WGEfKc"
