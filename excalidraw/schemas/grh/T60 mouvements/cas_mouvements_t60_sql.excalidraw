      "width": 816.42,
      "height": 27.5,
      "angle": 0,
      "strokeColor": "#e8590c",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 367996790,
      "version": 1,
      "versionNonce": 1658626477,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794158206751,
      "link": null,
      "locked": false,
      "text": "LES SORTIES (partie 10, l. 508 à 562) : qui sort, et avec quel cas",
      "fontSize": 22,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "LES SORTIES (partie 10, l. 508 à 562) : qui sort, et avec quel cas",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "7pjfBfdMTvZUppVVZalr",
      "type": "rectangle",
      "x": 40,
      "y": 2303.5,
      "width": 1460,
      "height": 550.0,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "#e9ecef",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "VOA004TYuwnAsUHrBAuB"
      ],
      "frameId": null,
      "roundness": {
        "type": 3
      },
      "seed": 1778023601,
      "version": 1,
      "versionNonce": 1837051819,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794158206751,
      "link": null,
      "locked": false
    },
    {
      "id": "gHUePd1pu1hdFcedwi9B",
      "type": "text",
      "x": 62,
      "y": 2319.5,
      "width": 808.5199999999999,
      "height": 510.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "VOA004TYuwnAsUHrBAuB"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 715356951,
      "version": 1,
      "versionNonce": 2142193916,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794158206751,
      "link": null,
      "locked": false,
      "text": "FROM a_la_fin f\nJOIN personnes p ON p.PERS_ID = f.PERS_ID\n…\nLEFT JOIN au_debut dbt ON dbt.annee = f.annee AND dbt.PERS_ID = f.PERS_ID\n…\nWHERE dbt.PERS_ID IS NULL                                        -- [E1]\n   OR NVL(dbt.NATURE_EMPLOI, '-') <> NVL(f.NATURE_EMPLOI, '-')   -- [E2]\n\n-- et avec quel cas : le premier WHEN vrai l'emporte\nCASE\n    WHEN NVL(f.NATURE_EMPLOI, '-') <> 'TEMPORAIRE'\n     AND dt.PERS_ID IS NOT NULL                       THEN 'DETACHEMENT'   -- [E3]\n    WHEN NVL(f.NATURE_EMPLOI, '-') <> 'TEMPORAIRE'\n     AND p.date_entree >  f.d0\n     AND p.date_entree <= f.d1                        THEN 'EMBAUCHE'      -- [E4]\n    WHEN NVL(f.NATURE_EMPLOI, '-') <> 'TEMPORAIRE'\n     AND pr.disponibilite = 'HORS_EFFECTIF'\n     AND NVL(po.date_dispo, DATE '1900-01-01')\n         > NVL(po.date_remise, DATE '1900-01-01')     THEN 'REMISE'        -- [E5]\n    WHEN f.NATURE_EMPLOI = 'TEMPORAIRE'\n     AND tc0.PERS_ID IS NULL                          THEN 'ENGAGEMENT'    -- [E6]\n    WHEN dbt.PERS_ID IS NOT NULL                      THEN 'NATURE'        -- [E7]\n    ELSE                                                   'SANS_MOTIF'    -- [E8]\nEND                        AS cas",
      "fontSize": 17,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "FROM a_la_fin f\nJOIN personnes p ON p.PERS_ID = f.PERS_ID\n…\nLEFT JOIN au_debut dbt ON dbt.annee = f.annee AND dbt.PERS_ID = f.PERS_ID\n…\nWHERE dbt.PERS_ID IS NULL                                        -- [E1]\n   OR NVL(dbt.NATURE_EMPLOI, '-') <> NVL(f.NATURE_EMPLOI, '-')   -- [E2]\n\n-- et avec quel cas : le premier WHEN vrai l'emporte\nCASE\n    WHEN NVL(f.NATURE_EMPLOI, '-') <> 'TEMPORAIRE'\n     AND dt.PERS_ID IS NOT NULL                       THEN 'DETACHEMENT'   -- [E3]\n    WHEN NVL(f.NATURE_EMPLOI, '-') <> 'TEMPORAIRE'\n     AND p.date_entree >  f.d0\n     AND p.date_entree <= f.d1                        THEN 'EMBAUCHE'      -- [E4]\n    WHEN NVL(f.NATURE_EMPLOI, '-') <> 'TEMPORAIRE'\n     AND pr.disponibilite = 'HORS_EFFECTIF'\n     AND NVL(po.date_dispo, DATE '1900-01-01')\n         > NVL(po.date_remise, DATE '1900-01-01')     THEN 'REMISE'        -- [E5]\n    WHEN f.NATURE_EMPLOI = 'TEMPORAIRE'\n     AND tc0.PERS_ID IS NULL                          THEN 'ENGAGEMENT'    -- [E6]\n    WHEN dbt.PERS_ID IS NOT NULL                      THEN 'NATURE'        -- [E7]\n    ELSE                                                   'SANS_MOTIF'    -- [E8]\nEND                        AS cas",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "rICXmSs0aXqTjV7RioDr",
      "type": "rectangle",
      "x": 1540,
      "y": 2303.5,
      "width": 1460,
      "height": 550.0,
      "angle": 0,
      "strokeColor": "#e8590c",
      "backgroundColor": "#e9ecef",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "qiaZmSGmMNRX30swRoIo"
      ],
      "frameId": null,
      "roundness": {
        "type": 3
      },
      "seed": 222196963,
      "version": 1,
      "versionNonce": 170282259,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794158206751,
      "link": null,
      "locked": false
    },
    {
      "id": "vanGf0CPUQHBPOMOYZVG",
      "type": "text",
      "x": 1562,
      "y": 2319.5,
      "width": 867.68,
      "height": 467.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "qiaZmSGmMNRX30swRoIo"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1040719544,
      "version": 1,
      "versionNonce": 1823697762,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794158206751,
      "link": null,
      "locked": false,
      "text": "FROM au_debut dbt\n…\nLEFT JOIN a_la_fin fin ON fin.annee = dbt.annee AND fin.PERS_ID = dbt.PERS_ID\nLEFT JOIN premier_depart pd ON pd.PERS_ID = dbt.PERS_ID\n…\nWHERE fin.PERS_ID IS NULL                                        -- [S1]\n   OR NVL(fin.NATURE_EMPLOI, '-') <> NVL(dbt.NATURE_EMPLOI, '-') -- [S2]\n\n-- et avec quel cas : le premier WHEN vrai l'emporte\nCASE\n    WHEN NVL(dbt.NATURE_EMPLOI, '-') <> 'TEMPORAIRE'\n     AND pd.date_depart >  dbt.d0\n     AND pd.date_depart <= dbt.d1                     THEN 'DEPART_PERMANENT'    -- [S3]\n    WHEN dbt.NATURE_EMPLOI = 'TEMPORAIRE'\n     AND dda.PERS_ID IS NOT NULL                      THEN 'DEPART_TEMPORAIRE'   -- [S4]\n    WHEN NVL(dbt.NATURE_EMPLOI, '-') <> 'TEMPORAIRE'\n     AND pr.disponibilite = 'HORS_EFFECTIF'\n     AND NVL(po.date_dispo, DATE '1900-01-01')\n         > NVL(po.date_remise, DATE '1900-01-01')     THEN 'DISPONIBILITE'       -- [S5]\n    WHEN fin.PERS_ID IS NOT NULL                      THEN 'NATURE'              -- [S6]\n    ELSE                                                   'SANS_MOTIF'          -- [S7]\nEND                        AS cas",
      "fontSize": 17,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "FROM au_debut dbt\n…\nLEFT JOIN a_la_fin fin ON fin.annee = dbt.annee AND fin.PERS_ID = dbt.PERS_ID\nLEFT JOIN premier_depart pd ON pd.PERS_ID = dbt.PERS_ID\n…\nWHERE fin.PERS_ID IS NULL                                        -- [S1]\n   OR NVL(fin.NATURE_EMPLOI, '-') <> NVL(dbt.NATURE_EMPLOI, '-') -- [S2]\n\n-- et avec quel cas : le premier WHEN vrai l'emporte\nCASE\n    WHEN NVL(dbt.NATURE_EMPLOI, '-') <> 'TEMPORAIRE'\n     AND pd.date_depart >  dbt.d0\n     AND pd.date_depart <= dbt.d1                     THEN 'DEPART_PERMANENT'    -- [S3]\n    WHEN dbt.NATURE_EMPLOI = 'TEMPORAIRE'\n     AND dda.PERS_ID IS NOT NULL                      THEN 'DEPART_TEMPORAIRE'   -- [S4]\n    WHEN NVL(dbt.NATURE_EMPLOI, '-') <> 'TEMPORAIRE'\n     AND pr.disponibilite = 'HORS_EFFECTIF'\n     AND NVL(po.date_dispo, DATE '1900-01-01')\n         > NVL(po.date_remise, DATE '1900-01-01')     THEN 'DISPONIBILITE'       -- [S5]\n    WHEN fin.PERS_ID IS NOT NULL                      THEN 'NATURE'              -- [S6]\n    ELSE                                                   'SANS_MOTIF'          -- [S7]\nEND                        AS cas",
      "autoResize": true,
      "lineHeight": 1.25
    },
