      "versionNonce": 791264165,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794158206751,
      "link": null,
      "locked": false,
      "text": "(NVL(si.nature, '-') <> 'TEMPORAIRE'       -- base : sans situation, compté, nature NULL\n…\n   OR NVL(dbt.NATURE_EMPLOI, '-') <> NVL(f.NATURE_EMPLOI, '-')   -- '-' <> 'PERMANENT'\n…\nWHEN 'NATURE'      THEN 'ETAIT_' || NVL(x.nature_debut, 'SANS_SITUATION')",
      "fontSize": 17,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "(NVL(si.nature, '-') <> 'TEMPORAIRE'       -- base : sans situation, compté, nature NULL\n…\n   OR NVL(dbt.NATURE_EMPLOI, '-') <> NVL(f.NATURE_EMPLOI, '-')   -- '-' <> 'PERMANENT'\n…\nWHEN 'NATURE'      THEN 'ETAIT_' || NVL(x.nature_debut, 'SANS_SITUATION')",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "SSfHJQg3C6O4JX0bmo2n",
      "type": "text",
      "x": 2444,
      "y": 4732.25,
      "width": 521.1,
      "height": 112.5,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
