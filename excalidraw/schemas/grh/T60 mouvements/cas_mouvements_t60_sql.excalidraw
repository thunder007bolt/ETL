    {
      "id": "W8DN7XhVPE0IWJXZK1Pw",
      "type": "text",
      "x": 1249,
      "y": 7613.0,
      "width": 739.5,
      "height": 106.25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "enBsoKt9tkGbU2COar4i"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 498799545,
      "version": 1,
      "versionNonce": 647687166,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794158206751,
      "link": null,
      "locked": false,
      "text": "AND NOT EXISTS (SELECT 1\n                FROM DWH.FAIT_GRH_DECISION a\n                WHERE a.CLICHE = :1\n                  AND TO_CHAR(a.CDEC_CODE) = cd.annulation          -- '40'\n                  AND TO_CHAR(a.NO_DECI_MODIF) = TO_CHAR(d.DECI_NO))",
      "fontSize": 17,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "AND NOT EXISTS (SELECT 1\n                FROM DWH.FAIT_GRH_DECISION a\n                WHERE a.CLICHE = :1\n                  AND TO_CHAR(a.CDEC_CODE) = cd.annulation          -- '40'\n                  AND TO_CHAR(a.NO_DECI_MODIF) = TO_CHAR(d.DECI_NO))",
      "autoResize": true,
      "lineHeight": 1.25
    },
