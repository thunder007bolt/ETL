      "updated": 1794158206751,
      "link": null,
      "locked": false,
      "text": "COALESCE(p.DATE_EMBAUCHE, p.DATE_PRISE_SERVICE)        AS date_entree   -- partie 2\n…\nWHEN NVL(f.NATURE_EMPLOI, '-') <> 'TEMPORAIRE'        -- vrai : permanent à la fin\n AND p.date_entree >  f.d0                           -- vrai : 01/03/2024 > 31/12/2023\n AND p.date_entree <= f.d1          THEN 'EMBAUCHE'   -- vrai\n…\nWHEN 'EMBAUCHE'    THEN 'RECRU'",
      "fontSize": 17,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "COALESCE(p.DATE_EMBAUCHE, p.DATE_PRISE_SERVICE)        AS date_entree   -- partie 2\n…\nWHEN NVL(f.NATURE_EMPLOI, '-') <> 'TEMPORAIRE'        -- vrai : permanent à la fin\n AND p.date_entree >  f.d0                           -- vrai : 01/03/2024 > 31/12/2023\n AND p.date_entree <= f.d1          THEN 'EMBAUCHE'   -- vrai\n…\nWHEN 'EMBAUCHE'    THEN 'RECRU'",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
