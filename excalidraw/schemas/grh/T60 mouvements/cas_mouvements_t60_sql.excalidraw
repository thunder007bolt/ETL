    {
      "id": "MOA6oHqllZtxahzG16bJ",
      "type": "text",
      "x": 62,
      "y": 1930.5,
      "width": 887.4,
      "height": 255.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "wWSTvGqBZmPeT6Dek4LB"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 462498100,
      "version": 1,
      "versionNonce": 1930129596,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794158206751,
      "link": null,
      "locked": false,
      "text": "SELECT EXTRACT(YEAR FROM da.date_arrete)                          AS annee,   -- exercices\n       ADD_MONTHS(da.date_arrete, -12)                            AS d0,\n       da.date_arrete                                             AS d1\n…\nau_debut AS (\n    SELECT e.annee, e.d0, e.d1, b.*\n    FROM exercices e\n    JOIN base b ON b.date_arrete = e.d0          -- la photo du début : le 31/12 d'avant\n…\na_la_fin AS (\n    …\n    JOIN base b ON b.date_arrete = e.d1          -- la photo de fin : le 31/12 de l'année",
      "fontSize": 17,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "SELECT EXTRACT(YEAR FROM da.date_arrete)                          AS annee,   -- exercices\n       ADD_MONTHS(da.date_arrete, -12)                            AS d0,\n       da.date_arrete                                             AS d1\n…\nau_debut AS (\n    SELECT e.annee, e.d0, e.d1, b.*\n    FROM exercices e\n    JOIN base b ON b.date_arrete = e.d0          -- la photo du début : le 31/12 d'avant\n…\na_la_fin AS (\n    …\n    JOIN base b ON b.date_arrete = e.d1          -- la photo de fin : le 31/12 de l'année",
      "autoResize": true,
      "lineHeight": 1.25
    },
