    {
      "id": "abWFkabJRV35QuUA7zXE",
      "type": "text",
      "x": 62,
      "y": 1590.5,
      "width": 2150.8,
      "height": 100.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "1EA61KOFYEbpoQxsTCFr"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 858301105,
      "version": 1,
      "versionNonce": 506611813,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794158206751,
      "link": null,
      "locked": false,
      "text": "LES ALIAS, À GARDER SOUS LES YEUX\ne = l'exercice (annee, d0, d1) · f = la photo de fin, vue d'une entrée · dbt = la photo du début · fin = la photo de fin, vue d'une sortie · p = l'agent · pr = les réglages · cd = les codes de décision\npd = son premier départ · dda = son dernier départ de l'exercice · dt = sa 37 de l'exercice · po = ses 07 et 18 (au 31/12 d'avant pour une entrée, de l'année pour une sortie) · tc0 = son contrat au début\nUn LEFT JOIN qui ne trouve rien laisse ses colonnes à NULL : c'est souvent ce NULL qui décide (dbt.PERS_ID IS NULL = absent de la photo du début).",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "LES ALIAS, À GARDER SOUS LES YEUX\ne = l'exercice (annee, d0, d1) · f = la photo de fin, vue d'une entrée · dbt = la photo du début · fin = la photo de fin, vue d'une sortie · p = l'agent · pr = les réglages · cd = les codes de décision\npd = son premier départ · dda = son dernier départ de l'exercice · dt = sa 37 de l'exercice · po = ses 07 et 18 (au 31/12 d'avant pour une entrée, de l'année pour une sortie) · tc0 = son contrat au début\nUn LEFT JOIN qui ne trouve rien laisse ses colonnes à NULL : c'est souvent ce NULL qui décide (dbt.PERS_ID IS NULL = absent de la photo du début).",
      "autoResize": true,
      "lineHeight": 1.25
    },
