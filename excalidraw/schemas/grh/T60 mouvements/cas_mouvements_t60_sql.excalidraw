      "versionNonce": 345088336,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794158206751,
      "link": null,
      "locked": false,
      "text": "Avec 'PRESENT', l'agent en disponibilité reste dans\nbase : il est sur les deux photos, ni sortie ni retour.\nMême valeur dans la requête de l'effectif (QG6, en\nattente de la DRH).",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Avec 'PRESENT', l'agent en disponibilité reste dans\nbase : il est sur les deux photos, ni sortie ni retour.\nMême valeur dans la requête de l'effectif (QG6, en\nattente de la DRH).",
      "autoResize": true,
      "lineHeight": 1.25
    },
