      "containerId": null,
      "originalText": "LES ENTRÉES (partie 9, l. 449 à 506) : qui entre, et avec quel cas",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "NemdYaLVWBHqgAP3bw9h",
      "type": "text",
