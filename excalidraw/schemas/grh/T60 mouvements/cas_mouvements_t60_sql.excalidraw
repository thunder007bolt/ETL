      "isDeleted": false,
      "boundElements": [],
      "updated": 1794158206751,
      "link": null,
      "locked": false,
      "text": "Pour T60, une ligne par agent, exercice et code : les\ndeux mesures sont égales. Pour les mouvements\ninternes, deux mutations du même agent font 2\nmouvements, 1 agent. T60 lit NB_AGENTS.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Pour T60, une ligne par agent, exercice et code : les\ndeux mesures sont égales. Pour les mouvements\ninternes, deux mutations du même agent font 2\nmouvements, 1 agent. T60 lit NB_AGENTS.",
      "autoResize": true,
      "lineHeight": 1.25
    },
