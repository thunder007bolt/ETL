      "text": "'PRESENT'               AS disponibilite,           -- partie 0 : valeur actuelle\n…\nAND NOT (pr.disponibilite = 'HORS_EFFECTIF'          -- faux : le NOT est vrai\n         AND NVL(po.date_dispo, DATE '1900-01-01')\n             > NVL(po.date_remise, DATE '1900-01-01')))",
      "fontSize": 17,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "'PRESENT'               AS disponibilite,           -- partie 0 : valeur actuelle\n…\nAND NOT (pr.disponibilite = 'HORS_EFFECTIF'          -- faux : le NOT est vrai\n         AND NVL(po.date_dispo, DATE '1900-01-01')\n             > NVL(po.date_remise, DATE '1900-01-01')))",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "sggliUOQ0WBqjl2xzM0E",
      "type": "text",
      "x": 2444,
      "y": 7769.25,
      "width": 516.96,
      "height": 90.0,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
