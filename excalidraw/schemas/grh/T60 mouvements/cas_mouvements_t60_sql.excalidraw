      "updated": 1794158206751,
      "link": null,
      "locked": false,
      "text": "LEFT JOIN DTM.DIM_GRH_TYPE_MOUVEMENT tm\n       ON tm.CODE_TYPE_MVT = m.CODE_TYPE_MVT\n…\nCASE tm.CODE_NAT_MVT\n    WHEN 'ENTREES' THEN 'PRISE'\n    WHEN 'SORTIES' THEN 'CESSA'\n    ELSE NULL\nEND                                                   AS CODE_SENS_MVT,",
      "fontSize": 17,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "LEFT JOIN DTM.DIM_GRH_TYPE_MOUVEMENT tm\n       ON tm.CODE_TYPE_MVT = m.CODE_TYPE_MVT\n…\nCASE tm.CODE_NAT_MVT\n    WHEN 'ENTREES' THEN 'PRISE'\n    WHEN 'SORTIES' THEN 'CESSA'\n    ELSE NULL\nEND                                                   AS CODE_SENS_MVT,",
      "autoResize": true,
      "lineHeight": 1.25
    },
