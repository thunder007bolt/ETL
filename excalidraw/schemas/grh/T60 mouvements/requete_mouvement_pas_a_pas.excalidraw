    {
      "id": "GhSARzXV5mREIzIPFcm5",
      "type": "text",
      "x": 62,
      "y": 4336,
      "width": 1778.8000000000002,
      "height": 75.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "nese5VT7pZ84XyQd7kqW"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 687306353,
      "version": 1,
      "versionNonce": 1863256731,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794162909860,
      "link": null,
      "locked": false,
      "text": "À RETENIR : chaque année, la requête regarde l'agent à deux dates, le 31/12 d'avant et le 31/12 de l'année. S'il change de case (absent, puis présent, ou l'inverse),\nc'est un mouvement, et la fiche ou une décision en donne le code. Ce qui se passe entre les deux photos sans les changer ne compte pas (agent F), et un fait\nsans date n'est vu qu'à sa première trace datée (agent E). Un temporaire titularisé sort des temporaires et entre chez les permanents la même année (agent C).",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "À RETENIR : chaque année, la requête regarde l'agent à deux dates, le 31/12 d'avant et le 31/12 de l'année. S'il change de case (absent, puis présent, ou l'inverse),\nc'est un mouvement, et la fiche ou une décision en donne le code. Ce qui se passe entre les deux photos sans les changer ne compte pas (agent F), et un fait\nsans date n'est vu qu'à sa première trace datée (agent E). Un temporaire titularisé sort des temporaires et entre chez les permanents la même année (agent C).",
      "autoResize": true,
      "lineHeight": 1.25
    },
