      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "mhbNM2yycBX0ybaCvCdV"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 103955761,
      "version": 1,
      "versionNonce": 691091817,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794162931247,
      "link": null,
      "locked": false,
      "text": "-- les contractuels au 31/12/2024\nSELECT COUNT(*)\nFROM   USER_GRH.GRH_PERSONNE p\nJOIN   USER_GRH.GRH_SITUATION s\n       ON s.PERS_ID = p.PERS_ID\nWHERE  p.QUALITE = 'A'\nAND    s.NATURE_EMPLOIE = 'TEMPORAIRE'\nAND    s.DATE_DEBUT = (  -- dernière situation\n         SELECT MAX(x.DATE_DEBUT)\n         FROM   USER_GRH.GRH_SITUATION x\n         WHERE  x.PERS_ID = p.PERS_ID\n         AND    x.DATE_DEBUT <= DATE '2024-12-31')\n-- dernier engagement (50) après le\n-- 30/06/2023 : moins de 18 mois\nAND   (SELECT MAX(e.DATE_VIGUEUR)\n       FROM   USER_GRH.GRH_DECISION e\n       WHERE  e.PERS_ID = p.PERS_ID\n       AND    e.CDEC_CODE = '50'\n       AND    e.DATE_VIGUEUR <= DATE '2024-12-31')\n      > DATE '2023-06-30'\n-- et aucun départ après cet engagement\nAND    NOT EXISTS (\n  SELECT 1\n  FROM   USER_GRH.GRH_DECISION f\n  WHERE  f.PERS_ID = p.PERS_ID\n  AND    f.CDEC_CODE IN\n         ('02','34','35','36','52','54')\n  AND    f.DATE_VIGUEUR <= DATE '2024-12-31'\n  AND    f.DATE_VIGUEUR > (\n           SELECT MAX(e.DATE_VIGUEUR)\n           FROM   USER_GRH.GRH_DECISION e\n           WHERE  e.PERS_ID = f.PERS_ID\n           AND    e.CDEC_CODE = '50'))\n-- 2024 : environ 46, comme l'annuaire",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-- les contractuels au 31/12/2024\nSELECT COUNT(*)\nFROM   USER_GRH.GRH_PERSONNE p\nJOIN   USER_GRH.GRH_SITUATION s\n       ON s.PERS_ID = p.PERS_ID\nWHERE  p.QUALITE = 'A'\nAND    s.NATURE_EMPLOIE = 'TEMPORAIRE'\nAND    s.DATE_DEBUT = (  -- dernière situation\n         SELECT MAX(x.DATE_DEBUT)\n         FROM   USER_GRH.GRH_SITUATION x\n         WHERE  x.PERS_ID = p.PERS_ID\n         AND    x.DATE_DEBUT <= DATE '2024-12-31')\n-- dernier engagement (50) après le\n-- 30/06/2023 : moins de 18 mois\nAND   (SELECT MAX(e.DATE_VIGUEUR)\n       FROM   USER_GRH.GRH_DECISION e\n       WHERE  e.PERS_ID = p.PERS_ID\n       AND    e.CDEC_CODE = '50'\n       AND    e.DATE_VIGUEUR <= DATE '2024-12-31')\n      > DATE '2023-06-30'\n-- et aucun départ après cet engagement\nAND    NOT EXISTS (\n  SELECT 1\n  FROM   USER_GRH.GRH_DECISION f\n  WHERE  f.PERS_ID = p.PERS_ID\n  AND    f.CDEC_CODE IN\n         ('02','34','35','36','52','54')\n  AND    f.DATE_VIGUEUR <= DATE '2024-12-31'\n  AND    f.DATE_VIGUEUR > (\n           SELECT MAX(e.DATE_VIGUEUR)\n           FROM   USER_GRH.GRH_DECISION e\n           WHERE  e.PERS_ID = f.PERS_ID\n           AND    e.CDEC_CODE = '50'))\n-- 2024 : environ 46, comme l'annuaire",
      "autoResize": true,
      "lineHeight": 1.25
    },
