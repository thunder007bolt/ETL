      "versionNonce": 154699315,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793704822125,
      "link": null,
      "locked": false,
      "text": "-- une entrée embauchée en 2024 (à défaut\n-- d'embauche, la prise de service)\nSELECT COUNT(*)\nFROM   permanents_2024\nWHERE  PERS_ID NOT IN\n       (SELECT PERS_ID FROM permanents_2023)\nAND    NVL(DATE_EMBAUCHE, DATE_PRISE_SERVICE)\n         >= DATE '2024-01-01'\n-- 2024 : 104, comme l'annuaire",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-- une entrée embauchée en 2024 (à défaut\n-- d'embauche, la prise de service)\nSELECT COUNT(*)\nFROM   permanents_2024\nWHERE  PERS_ID NOT IN\n       (SELECT PERS_ID FROM permanents_2023)\nAND    NVL(DATE_EMBAUCHE, DATE_PRISE_SERVICE)\n         >= DATE '2024-01-01'\n-- 2024 : 104, comme l'annuaire",
      "autoResize": true,
      "lineHeight": 1.25
    },
