    {
      "id": "kZ9hEayx9FrpIpdqGZlc",
      "type": "text",
      "x": 38.893542546360095,
      "y": 2520.70523054501,
      "width": 1075.14,
      "height": 112.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
