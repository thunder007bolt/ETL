    {
      "id": "bewpicr02maVMPTyVGKA",
      "type": "text",
      "x": 2083,
      "y": 12496.5,
      "width": 473.28,
      "height": 180.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
