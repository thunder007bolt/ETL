    {
      "id": "bpqW0bRlfKanW0li7taN",
      "type": "text",
      "x": 2074,
      "y": 5254.0,
      "width": 399.03999999999996,
      "height": 160.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
