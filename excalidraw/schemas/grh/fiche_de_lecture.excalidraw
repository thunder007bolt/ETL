    {
      "id": "vedKWfiDU0rBBBilaB6e",
      "type": "text",
      "x": 39,
      "y": 9675.0,
      "width": 1082.5200000000002,
      "height": 90.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
