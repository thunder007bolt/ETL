      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "WDyxet1kPRqaSxbf2geq"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1299657005,
      "version": 2,
      "versionNonce": 1759610375,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793707366545,
      "link": null,
      "locked": false,
      "text": "Tu valides : le ratio = frais de personnel de l'année, divisés par les charges de fonctionnement de la même année ?",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
