    },
    {
      "id": "d8KNQPq6asOC0NF6E4cg",
      "type": "text",
      "x": 2074,
      "y": 5941.5,
      "width": 482.55999999999995,
      "height": 1220.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "MpMYy3SYNcyvhIzoK9d9"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1018786128,
      "version": 1,
      "versionNonce": 50135977,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794162931247,
      "link": null,
      "locked": false,
      "text": "-- les permanents présents au 31/12/2023\n-- et au 31/12/2024, comme dans T58\n-- (terme 2) : une fiche sans état\n-- (embauche récente) compte, un agent en\n-- disponibilité non ; réutilisés ensuite\nWITH fins AS (\n  SELECT DATE '2023-12-31' AS fin FROM DUAL\n  UNION ALL\n  SELECT DATE '2024-12-31' FROM DUAL),\npermanents AS (\n  SELECT EXTRACT(YEAR FROM f.fin) AS annee,\n         p.PERS_ID, p.DATE_EMBAUCHE,\n         p.DATE_PRISE_SERVICE\n  FROM   fins f\n  CROSS  JOIN USER_GRH.GRH_PERSONNE p\n  JOIN   USER_GRH.GRH_SITUATION s\n         ON s.PERS_ID = p.PERS_ID\n  WHERE  p.QUALITE = 'A'\n  AND    s.NATURE_EMPLOIE = 'PERMANENT'\n  AND    s.DATE_DEBUT = (\n           SELECT MAX(x.DATE_DEBUT)\n           FROM   USER_GRH.GRH_SITUATION x\n           WHERE  x.PERS_ID = p.PERS_ID\n           AND    x.DATE_DEBUT <= f.fin)\n  AND    NVL(p.DATE_EMBAUCHE,\n             p.DATE_PRISE_SERVICE) <= f.fin\n  AND   (NVL(p.ETAT_EMPLOYE, '-') <> 'INACTIF'\n         OR (SELECT MIN(d.DATE_VIGUEUR)\n             FROM   USER_GRH.GRH_DECISION d\n             WHERE  d.PERS_ID = p.PERS_ID\n             AND    d.CDEC_CODE IN\n                    ('02','34','35','36','52','54'))\n            > f.fin)\n  -- pas en disponibilité ce jour-là (07\n  -- sans 18 après), comme l'annuaire\n  AND    NOT EXISTS (\n           SELECT 1\n           FROM   USER_GRH.GRH_DECISION d7\n           WHERE  d7.PERS_ID = p.PERS_ID\n           AND    d7.CDEC_CODE = '07'\n           AND    d7.DATE_VIGUEUR <= f.fin\n           AND    NOT EXISTS (\n             SELECT 1\n             FROM   USER_GRH.GRH_DECISION r\n             WHERE  r.PERS_ID = p.PERS_ID\n             AND    r.CDEC_CODE = '18'\n             AND    r.DATE_VIGUEUR\n                    >= d7.DATE_VIGUEUR\n             AND    r.DATE_VIGUEUR <= f.fin))),\npermanents_2023 AS (\n  SELECT * FROM permanents WHERE annee = 2023),\npermanents_2024 AS (\n  SELECT * FROM permanents WHERE annee = 2024)\nSELECT annee, COUNT(*)\nFROM   permanents\nGROUP  BY annee\n-- 2023 (début de 2024) : environ 672 ;\n-- 2024 : environ 741 (l'annuaire : 767 et\n-- 758 ; l'écart vient des 84 engagés de\n-- 2019). La requête complète écarte aussi\n-- les départs annulés par une 40",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-- les permanents présents au 31/12/2023\n-- et au 31/12/2024, comme dans T58\n-- (terme 2) : une fiche sans état\n-- (embauche récente) compte, un agent en\n-- disponibilité non ; réutilisés ensuite\nWITH fins AS (\n  SELECT DATE '2023-12-31' AS fin FROM DUAL\n  UNION ALL\n  SELECT DATE '2024-12-31' FROM DUAL),\npermanents AS (\n  SELECT EXTRACT(YEAR FROM f.fin) AS annee,\n         p.PERS_ID, p.DATE_EMBAUCHE,\n         p.DATE_PRISE_SERVICE\n  FROM   fins f\n  CROSS  JOIN USER_GRH.GRH_PERSONNE p\n  JOIN   USER_GRH.GRH_SITUATION s\n         ON s.PERS_ID = p.PERS_ID\n  WHERE  p.QUALITE = 'A'\n  AND    s.NATURE_EMPLOIE = 'PERMANENT'\n  AND    s.DATE_DEBUT = (\n           SELECT MAX(x.DATE_DEBUT)\n           FROM   USER_GRH.GRH_SITUATION x\n           WHERE  x.PERS_ID = p.PERS_ID\n           AND    x.DATE_DEBUT <= f.fin)\n  AND    NVL(p.DATE_EMBAUCHE,\n             p.DATE_PRISE_SERVICE) <= f.fin\n  AND   (NVL(p.ETAT_EMPLOYE, '-') <> 'INACTIF'\n         OR (SELECT MIN(d.DATE_VIGUEUR)\n             FROM   USER_GRH.GRH_DECISION d\n             WHERE  d.PERS_ID = p.PERS_ID\n             AND    d.CDEC_CODE IN\n                    ('02','34','35','36','52','54'))\n            > f.fin)\n  -- pas en disponibilité ce jour-là (07\n  -- sans 18 après), comme l'annuaire\n  AND    NOT EXISTS (\n           SELECT 1\n           FROM   USER_GRH.GRH_DECISION d7\n           WHERE  d7.PERS_ID = p.PERS_ID\n           AND    d7.CDEC_CODE = '07'\n           AND    d7.DATE_VIGUEUR <= f.fin\n           AND    NOT EXISTS (\n             SELECT 1\n             FROM   USER_GRH.GRH_DECISION r\n             WHERE  r.PERS_ID = p.PERS_ID\n             AND    r.CDEC_CODE = '18'\n             AND    r.DATE_VIGUEUR\n                    >= d7.DATE_VIGUEUR\n             AND    r.DATE_VIGUEUR <= f.fin))),\npermanents_2023 AS (\n  SELECT * FROM permanents WHERE annee = 2023),\npermanents_2024 AS (\n  SELECT * FROM permanents WHERE annee = 2024)\nSELECT annee, COUNT(*)\nFROM   permanents\nGROUP  BY annee\n-- 2023 (début de 2024) : environ 672 ;\n-- 2024 : environ 741 (l'annuaire : 767 et\n-- 758 ; l'écart vient des 84 engagés de\n-- 2019). La requête complète écarte aussi\n-- les départs annulés par une 40",
      "autoResize": true,
      "lineHeight": 1.25
    },
