      "updated": 1794162931247,
      "link": null,
      "locked": false,
      "text": "Les frais de personnel (FP) divisés par les charges de fonctionnement (CF), chaque année, sur cinq ans. La norme\nCIPRES : au plus 85 %.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Les frais de personnel (FP) divisés par les charges de fonctionnement (CF), chaque année, sur cinq ans. La norme\nCIPRES : au plus 85 %.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "QUgyhhOM2uFGzSXtupvk",
      "type": "text",
      "x": 39,
      "y": 16166.5,
      "width": 1114.4,
      "height": 20.0,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "VQN2ih4qoS0RcrROT2gY"
      ],
