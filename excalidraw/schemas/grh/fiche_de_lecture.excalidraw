    {
      "id": "ehxEyQrQeUJuJhUSdpSK",
      "type": "text",
      "x": 2083,
      "y": 11312.5,
      "width": 445.43999999999994,
      "height": 220.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "gduYWJAHUxTkXVJuo9lh"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1093325398,
      "version": 1,
      "versionNonce": 142245814,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794162931247,
      "link": null,
      "locked": false,
      "text": "-- agents distincts inscrits à une\n-- formation commencée en 2024\nSELECT COUNT(DISTINCT i.PERS_ID) AS formes,\n       COUNT(*)                  AS inscriptions\nFROM   USER_GRH.GRH_INSCRIPTION i\nJOIN   USER_GRH.GRH_FORMATION f\n       ON f.FORM_NO = i.FORM_NO\nWHERE  f.DATE_DEBUT BETWEEN DATE '2024-01-01'\n                        AND DATE '2024-12-31'\n-- 2024 : 410 agents, 525 inscriptions\n-- (l'annuaire : 480 formés)",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-- agents distincts inscrits à une\n-- formation commencée en 2024\nSELECT COUNT(DISTINCT i.PERS_ID) AS formes,\n       COUNT(*)                  AS inscriptions\nFROM   USER_GRH.GRH_INSCRIPTION i\nJOIN   USER_GRH.GRH_FORMATION f\n       ON f.FORM_NO = i.FORM_NO\nWHERE  f.DATE_DEBUT BETWEEN DATE '2024-01-01'\n                        AND DATE '2024-12-31'\n-- 2024 : 410 agents, 525 inscriptions\n-- (l'annuaire : 480 formés)",
      "autoResize": true,
      "lineHeight": 1.25
    },
