      "groupIds": [
        "6xTqe1oRBib2e4kkHXMx"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 739980595,
      "version": 1,
      "versionNonce": 446330914,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794162931247,
      "link": null,
      "locked": false,
      "text": "Tu valides : l'effectif du 1er janvier = celui du 31 décembre d'avant ?",
