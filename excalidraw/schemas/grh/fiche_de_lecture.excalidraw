    },
    {
      "id": "FvmdHlkVdXBgd2irIB6V",
      "type": "text",
      "x": 39,
      "y": 16123.5,
      "width": 1113.48,
      "height": 67.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "x9XMta88R9RvcEPZr4g6"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1228313994,
      "version": 1,
      "versionNonce": 1561760653,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793704822125,
      "link": null,
      "locked": false,
      "text": "Deux ratios : les dépenses de formation divisées par la masse salariale (norme : entre 1 % et 5 %), puis divisées\npar le budget total de l'année. Le budget est dans la gestion budgétaire (montant, gestion, direction). Ce peut être\nle budget voté en début d'année, ou ce qui a vraiment été dépensé (le budget exécuté).",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Deux ratios : les dépenses de formation divisées par la masse salariale (norme : entre 1 % et 5 %), puis divisées\npar le budget total de l'année. Le budget est dans la gestion budgétaire (montant, gestion, direction). Ce peut être\nle budget voté en début d'année, ou ce qui a vraiment été dépensé (le budget exécuté).",
      "autoResize": true,
      "lineHeight": 1.25
    },
