    },
    {
      "id": "wtTU6mT2pNObBmBuctJE",
      "type": "text",
      "x": 2140,
      "y": 14278.0,
      "width": 417.59999999999997,
      "height": 280.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "1OwfvS6V7in7bO9AFm0n"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1740843312,
      "version": 1,
      "versionNonce": 1514131545,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793625970183,
      "link": null,
      "locked": false,
      "text": "SELECT SUM(NVL(i.FRAIS_INSCRIPTION, 0)\n         + NVL(i.FRAIS_SCOLARITE, 0)\n         + NVL(i.FRAIS_TRANSPORT, 0)\n         + NVL(i.FRAIS_SEJOUR, 0)\n         + NVL(i.FRAIS_DOSSIER, 0)\n         + NVL(i.FRAIS_ASSURANCE, 0)\n         + NVL(i.FRAIS_ACCESSOIRE, 0))\n         AS depenses_formation\nFROM   USER_GRH.GRH_INSCRIPTION i\nJOIN   USER_GRH.GRH_FORMATION f\n       ON f.FORM_NO = i.FORM_NO\nWHERE  f.DATE_DEBUT BETWEEN DATE '2024-01-01'\n                        AND DATE '2024-12-31'\n-- un frais vide compte 0",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "SELECT SUM(NVL(i.FRAIS_INSCRIPTION, 0)\n         + NVL(i.FRAIS_SCOLARITE, 0)\n         + NVL(i.FRAIS_TRANSPORT, 0)\n         + NVL(i.FRAIS_SEJOUR, 0)\n         + NVL(i.FRAIS_DOSSIER, 0)\n         + NVL(i.FRAIS_ASSURANCE, 0)\n         + NVL(i.FRAIS_ACCESSOIRE, 0))\n         AS depenses_formation\nFROM   USER_GRH.GRH_INSCRIPTION i\nJOIN   USER_GRH.GRH_FORMATION f\n       ON f.FORM_NO = i.FORM_NO\nWHERE  f.DATE_DEBUT BETWEEN DATE '2024-01-01'\n                        AND DATE '2024-12-31'\n-- un frais vide compte 0",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "Hha2MB2yaFdNCvVTy2s7",
      "type": "rectangle",
      "x": 25,
      "y": 14607.5,
      "width": 1152,
      "height": 351.0,
      "angle": 0,
