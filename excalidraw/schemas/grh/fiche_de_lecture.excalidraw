    {
      "id": "5a5PFIY2UAET9I0S0nmF",
      "type": "text",
      "x": 2074,
      "y": 8013.0,
      "width": 463.99999999999994,
      "height": 460.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "FXH4aE6U7P2qJ3ZjQzHN"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1846503946,
      "version": 1,
      "versionNonce": 7903515,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793704822125,
      "link": null,
      "locked": false,
      "text": "-- sorties_2024 : la première décision de\n-- départ des présents du 31/12/2023,\n-- quand elle tombe en 2024 ; à ajouter\n-- à la suite du WITH de la terme 1\nsorties_2024 AS (\n  SELECT d.PERS_ID, d.CDEC_CODE\n  FROM   permanents_2023 p\n  JOIN   USER_GRH.GRH_DECISION d\n         ON d.PERS_ID = p.PERS_ID\n  WHERE  d.CDEC_CODE IN\n         ('02','34','35','36','52','54')\n  AND    d.DATE_VIGUEUR = (\n           SELECT MIN(x.DATE_VIGUEUR)\n           FROM   USER_GRH.GRH_DECISION x\n           WHERE  x.PERS_ID = d.PERS_ID\n           AND    x.CDEC_CODE IN\n                  ('02','34','35','36','52','54'))\n  AND    d.DATE_VIGUEUR\n         BETWEEN DATE '2024-01-01'\n             AND DATE '2024-12-31')\nSELECT COUNT(*) FROM sorties_2024\nWHERE  CDEC_CODE = '02'  -- retraite\n-- 2024 : 25 (l'annuaire : 23)",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-- sorties_2024 : la première décision de\n-- départ des présents du 31/12/2023,\n-- quand elle tombe en 2024 ; à ajouter\n-- à la suite du WITH de la terme 1\nsorties_2024 AS (\n  SELECT d.PERS_ID, d.CDEC_CODE\n  FROM   permanents_2023 p\n  JOIN   USER_GRH.GRH_DECISION d\n         ON d.PERS_ID = p.PERS_ID\n  WHERE  d.CDEC_CODE IN\n         ('02','34','35','36','52','54')\n  AND    d.DATE_VIGUEUR = (\n           SELECT MIN(x.DATE_VIGUEUR)\n           FROM   USER_GRH.GRH_DECISION x\n           WHERE  x.PERS_ID = d.PERS_ID\n           AND    x.CDEC_CODE IN\n                  ('02','34','35','36','52','54'))\n  AND    d.DATE_VIGUEUR\n         BETWEEN DATE '2024-01-01'\n             AND DATE '2024-12-31')\nSELECT COUNT(*) FROM sorties_2024\nWHERE  CDEC_CODE = '02'  -- retraite\n-- 2024 : 25 (l'annuaire : 23)",
      "autoResize": true,
      "lineHeight": 1.25
    },
