      "link": null,
      "locked": false,
      "text": "-- à coller sous la terme 2, à la place\n-- de sa dernière ligne\nSELECT CATEGORIE, COUNT(*)\nFROM   permanents_2024\nGROUP  BY CATEGORIE\nORDER  BY CATEGORIE\n-- 2024 : 01 + 02 employés      173\n--        03      maîtrise      207\n--        04 + 05 cadres moyens 304\n--        06      cadres sup.    58\n-- 05 : selon ta réponse au terme 3",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-- à coller sous la terme 2, à la place\n-- de sa dernière ligne\nSELECT CATEGORIE, COUNT(*)\nFROM   permanents_2024\nGROUP  BY CATEGORIE\nORDER  BY CATEGORIE\n-- 2024 : 01 + 02 employés      173\n--        03      maîtrise      207\n--        04 + 05 cadres moyens 304\n--        06      cadres sup.    58\n-- 05 : selon ta réponse au terme 3",
      "autoResize": true,
      "lineHeight": 1.25
    },
