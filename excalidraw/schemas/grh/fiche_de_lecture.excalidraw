      "versionNonce": 815794790,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793625970183,
      "link": null,
      "locked": false,
      "text": "Exemple : une retraite au 15/12/2024 (décision 02) : l'agent n'est pas compté au 31/12/2024 ; une retraite au\n15/01/2025 : il est compté.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Exemple : une retraite au 15/12/2024 (décision 02) : l'agent n'est pas compté au 31/12/2024 ; une retraite au\n15/01/2025 : il est compté.",
      "autoResize": true,
      "lineHeight": 1.25
    },
