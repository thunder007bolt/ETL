    {
      "id": "UX4dcfv0MaLbPh4Fe6xd",
      "type": "text",
      "x": 39,
      "y": 7814.0,
      "width": 1085.58,
      "height": 67.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
