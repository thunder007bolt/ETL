    {
      "id": "GRtfL0H0S3YdJX9AP47S",
      "type": "text",
      "x": 39,
      "y": 10753.5,
      "width": 1073.7,
      "height": 67.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "oeO4A3EcNugSy9DUUFyX"
      ],
