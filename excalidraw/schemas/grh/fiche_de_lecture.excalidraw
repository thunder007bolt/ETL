      "updated": 1793704822125,
      "link": null,
      "locked": false,
      "text": "Le personnel permanent : un agent de la CNSS dont la dernière situation au 31 décembre est permanente. Les\nagents de la fonction publique et les agents affectés n'en font pas partie. Les contractuels sont comptés à part\n(terme 6).",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Le personnel permanent : un agent de la CNSS dont la dernière situation au 31 décembre est permanente. Les\nagents de la fonction publique et les agents affectés n'en font pas partie. Les contractuels sont comptés à part\n(terme 6).",
      "autoResize": true,
      "lineHeight": 1.25
    },
