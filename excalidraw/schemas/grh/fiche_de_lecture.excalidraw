      "roundness": null,
      "seed": 1754469989,
      "version": 1,
      "versionNonce": 756910066,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793704822125,
      "link": null,
      "locked": false,
      "text": "Pour moi, ces quatre tableaux font la photo du personnel de la CNSS au 31 décembre : par catégorie, âge et sexe (T58), par domaine d'activité (T59), par ancienneté (T61), et la part des cadres sur cinq ans (T65). Ils partent tous de la\nmême liste : les agents permanents présents au 31 décembre.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Pour moi, ces quatre tableaux font la photo du personnel de la CNSS au 31 décembre : par catégorie, âge et sexe (T58), par domaine d'activité (T59), par ancienneté (T61), et la part des cadres sur cinq ans (T65). Ils partent tous de la\nmême liste : les agents permanents présents au 31 décembre.",
      "autoResize": true,
      "lineHeight": 1.25
    },
