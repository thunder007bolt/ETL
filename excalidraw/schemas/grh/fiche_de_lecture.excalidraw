    {
      "id": "6vPoMdHSBp6GVagx6j7D",
      "type": "text",
      "x": 25,
      "y": 1027.0,
      "width": 2543.2000000000003,
      "height": 50.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
