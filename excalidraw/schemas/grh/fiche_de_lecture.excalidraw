      "isDeleted": false,
      "boundElements": [],
      "updated": 1794162931247,
      "link": null,
      "locked": false,
      "text": "-- ancienneté en années pleines au\n-- 31/12/2024, depuis l'embauche (à\n-- défaut, depuis la prise de service)\nSELECT anciennete, COUNT(*)\nFROM  (SELECT FLOOR((DATE '2024-12-31'\n                - NVL(DATE_EMBAUCHE,\n                      DATE_PRISE_SERVICE))\n                / 365.25) AS anciennete\n       FROM   permanents_2024)\nGROUP  BY anciennete\nORDER  BY anciennete\n-- puis regrouper : moins de 1, 1-4, 5-9…\n-- 2024 : moins d'un an 101, 10-14 ans 224",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-- ancienneté en années pleines au\n-- 31/12/2024, depuis l'embauche (à\n-- défaut, depuis la prise de service)\nSELECT anciennete, COUNT(*)\nFROM  (SELECT FLOOR((DATE '2024-12-31'\n                - NVL(DATE_EMBAUCHE,\n                      DATE_PRISE_SERVICE))\n                / 365.25) AS anciennete\n       FROM   permanents_2024)\nGROUP  BY anciennete\nORDER  BY anciennete\n-- puis regrouper : moins de 1, 1-4, 5-9…\n-- 2024 : moins d'un an 101, 10-14 ans 224",
      "autoResize": true,
      "lineHeight": 1.25
    },
