    {
      "id": "yEyrjYjCtaHbIqrvo7p9",
      "type": "text",
      "x": 45,
      "y": 775.5,
      "width": 2420.28,
      "height": 45.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "pHY6WCmKzNd1J5dhNi8I"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1825552751,
      "version": 1,
      "versionNonce": 2045281234,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793704822125,
      "link": null,
      "locked": false,
      "text": "Dans l'ordre de l'Annuaire CIPRES : T58, T59, T61 et T65 (l'effectif au 31 décembre, par catégorie, âge, sexe, domaine, ancienneté, et le taux d'encadrement), T60 (le mouvement du personnel), T62 (les formés), T63 et T64 (les ratios de frais de\npersonnel et de formation, qui attendent la comptabilité).",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Dans l'ordre de l'Annuaire CIPRES : T58, T59, T61 et T65 (l'effectif au 31 décembre, par catégorie, âge, sexe, domaine, ancienneté, et le taux d'encadrement), T60 (le mouvement du personnel), T62 (les formés), T63 et T64 (les ratios de frais de\npersonnel et de formation, qui attendent la comptabilité).",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
