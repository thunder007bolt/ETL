    {
      "id": "m0sF1r9lxRsUv33Xq0lc",
      "type": "text",
      "x": 39,
      "y": 1654.0,
      "width": 1086.48,
      "height": 67.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
