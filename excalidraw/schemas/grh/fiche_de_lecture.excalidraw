    {
      "id": "cHgduYWJAHUxTkXVJuo9",
      "type": "text",
      "x": 39,
      "y": 10935.5,
      "width": 1080.0000000000002,
      "height": 67.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
