      "updated": 1794162931247,
      "link": null,
      "locked": false,
      "text": "Exemple : embauché le 15/12/2024, il prend son service le 05/01/2025 : je le compte recruté en 2024.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Exemple : embauché le 15/12/2024, il prend son service le 05/01/2025 : je le compte recruté en 2024.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
