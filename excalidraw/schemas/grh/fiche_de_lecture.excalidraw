      "isDeleted": false,
      "boundElements": [],
      "updated": 1794162931247,
      "link": null,
      "locked": false,
      "text": "-- entrée : dans la liste de fin, pas\n-- dans celle du début ; sortie : l'inverse\nSELECT\n  (SELECT COUNT(*) FROM permanents_2024\n   WHERE  PERS_ID NOT IN\n          (SELECT PERS_ID\n           FROM   permanents_2023)) AS entrees,\n  (SELECT COUNT(*) FROM permanents_2023\n   WHERE  PERS_ID NOT IN\n          (SELECT PERS_ID\n           FROM   permanents_2024)) AS sorties\nFROM   DUAL\n-- 2024 : environ 108 entrées et 39\n-- sorties ; 741 − 672 = 69",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-- entrée : dans la liste de fin, pas\n-- dans celle du début ; sortie : l'inverse\nSELECT\n  (SELECT COUNT(*) FROM permanents_2024\n   WHERE  PERS_ID NOT IN\n          (SELECT PERS_ID\n           FROM   permanents_2023)) AS entrees,\n  (SELECT COUNT(*) FROM permanents_2023\n   WHERE  PERS_ID NOT IN\n          (SELECT PERS_ID\n           FROM   permanents_2024)) AS sorties\nFROM   DUAL\n-- 2024 : environ 108 entrées et 39\n-- sorties ; 741 − 672 = 69",
      "autoResize": true,
      "lineHeight": 1.25
    },
