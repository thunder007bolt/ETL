      "updated": 1794162931247,
      "link": null,
      "locked": false,
      "text": "-- début + entrées − sorties − fin\nSELECT (SELECT COUNT(*) FROM permanents_2023)\n     + (SELECT COUNT(*) FROM permanents_2024\n        WHERE  PERS_ID NOT IN\n               (SELECT PERS_ID\n                FROM   permanents_2023))\n     - (SELECT COUNT(*) FROM permanents_2023\n        WHERE  PERS_ID NOT IN\n               (SELECT PERS_ID\n                FROM   permanents_2024))\n     - (SELECT COUNT(*) FROM permanents_2024)\n       AS controle\nFROM   DUAL\n-- toujours 0 ; les cinq exercices : refaire\n-- avec 2019 et 2020, … , 2023 et 2024",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-- début + entrées − sorties − fin\nSELECT (SELECT COUNT(*) FROM permanents_2023)\n     + (SELECT COUNT(*) FROM permanents_2024\n        WHERE  PERS_ID NOT IN\n               (SELECT PERS_ID\n                FROM   permanents_2023))\n     - (SELECT COUNT(*) FROM permanents_2023\n        WHERE  PERS_ID NOT IN\n               (SELECT PERS_ID\n                FROM   permanents_2024))\n     - (SELECT COUNT(*) FROM permanents_2024)\n       AS controle\nFROM   DUAL\n-- toujours 0 ; les cinq exercices : refaire\n-- avec 2019 et 2020, … , 2023 et 2024",
      "autoResize": true,
      "lineHeight": 1.25
    },
