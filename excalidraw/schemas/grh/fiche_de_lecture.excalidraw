      "updated": 1793625970183,
      "link": null,
      "locked": false,
      "text": "-- aucun filtre sur GRH_FORMATION.STATUT :\n-- toutes les formations sont au statut N\nSELECT STATUT, CATEGORIE, COUNT(*)\nFROM   USER_GRH.GRH_FORMATION\nGROUP  BY STATUT, CATEGORIE\n-- CATEGORIE : PERF perfectionnement,\n-- DIPLO formation diplômante, CONF\n-- conférence ou séminaire",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-- aucun filtre sur GRH_FORMATION.STATUT :\n-- toutes les formations sont au statut N\nSELECT STATUT, CATEGORIE, COUNT(*)\nFROM   USER_GRH.GRH_FORMATION\nGROUP  BY STATUT, CATEGORIE\n-- CATEGORIE : PERF perfectionnement,\n-- DIPLO formation diplômante, CONF\n-- conférence ou séminaire",
      "autoResize": true,
      "lineHeight": 1.25
    },
