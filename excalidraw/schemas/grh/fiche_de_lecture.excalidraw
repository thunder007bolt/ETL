    },
    {
      "id": "PV4UYf6eZuMJAWRjZIDC",
      "type": "text",
      "x": 39,
      "y": 14414.0,
      "width": 1114.56,
      "height": 67.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "e2GJnpYZ59RgNfSrGkaX"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1536826715,
      "version": 1,
      "versionNonce": 1025796621,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793704822125,
      "link": null,
      "locked": false,
      "text": "Tout ce que coûte le personnel dans l'année : salaires, primes, charges sociales. La paie n'est pas dans la copie :\nje les prendrai dans la comptabilité. La grille de la CNSS ne donne pas leurs comptes ; je propose les comptes 65,\nqui comprennent les salaires (651 et 652).",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Tout ce que coûte le personnel dans l'année : salaires, primes, charges sociales. La paie n'est pas dans la copie :\nje les prendrai dans la comptabilité. La grille de la CNSS ne donne pas leurs comptes ; je propose les comptes 65,\nqui comprennent les salaires (651 et 652).",
      "autoResize": true,
      "lineHeight": 1.25
    },
