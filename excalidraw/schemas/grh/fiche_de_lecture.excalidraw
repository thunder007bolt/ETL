      "link": null,
      "locked": false,
      "text": "Ce que j'ai compris",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Ce que j'ai compris",
