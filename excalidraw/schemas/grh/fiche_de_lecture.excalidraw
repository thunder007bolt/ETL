      "y": 12505.0,
      "width": 436.15999999999997,
      "height": 580.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "aUeLN3Uz0cO8XDRadIk2"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 164150831,
      "version": 1,
      "versionNonce": 1814573820,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794162931247,
      "link": null,
      "locked": false,
      "text": "-- la liste des inscriptions de 2024 des\n-- permanents, réutilisée ensuite\nWITH formes_2024 AS (\n  SELECT i.PERS_ID, p.SEXE, s.CATEGORIE,\n         i.CLA_AVANT, i.CLA_APRES,\n         f.CATEGORIE AS finalite\n  FROM   USER_GRH.GRH_INSCRIPTION i\n  JOIN   USER_GRH.GRH_FORMATION f\n         ON f.FORM_NO = i.FORM_NO\n  JOIN   USER_GRH.GRH_PERSONNE p\n         ON p.PERS_ID = i.PERS_ID\n  JOIN   USER_GRH.GRH_SITUATION s\n         ON s.PERS_ID = p.PERS_ID\n  WHERE  f.DATE_DEBUT\n         BETWEEN DATE '2024-01-01'\n             AND DATE '2024-12-31'\n  -- agent CNSS, permanent au 31/12/2024,\n  -- même s'il est parti depuis\n  AND    p.QUALITE = 'A'\n  AND    s.NATURE_EMPLOIE = 'PERMANENT'\n  AND    s.DATE_DEBUT = (\n           SELECT MAX(x.DATE_DEBUT)\n           FROM   USER_GRH.GRH_SITUATION x\n           WHERE  x.PERS_ID = p.PERS_ID\n           AND    x.DATE_DEBUT\n                  <= DATE '2024-12-31'))\nSELECT COUNT(DISTINCT PERS_ID) FROM formes_2024\n-- 2024 : 409 (un des 410 formés n'est pas\n-- permanent)",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-- la liste des inscriptions de 2024 des\n-- permanents, réutilisée ensuite\nWITH formes_2024 AS (\n  SELECT i.PERS_ID, p.SEXE, s.CATEGORIE,\n         i.CLA_AVANT, i.CLA_APRES,\n         f.CATEGORIE AS finalite\n  FROM   USER_GRH.GRH_INSCRIPTION i\n  JOIN   USER_GRH.GRH_FORMATION f\n         ON f.FORM_NO = i.FORM_NO\n  JOIN   USER_GRH.GRH_PERSONNE p\n         ON p.PERS_ID = i.PERS_ID\n  JOIN   USER_GRH.GRH_SITUATION s\n         ON s.PERS_ID = p.PERS_ID\n  WHERE  f.DATE_DEBUT\n         BETWEEN DATE '2024-01-01'\n             AND DATE '2024-12-31'\n  -- agent CNSS, permanent au 31/12/2024,\n  -- même s'il est parti depuis\n  AND    p.QUALITE = 'A'\n  AND    s.NATURE_EMPLOIE = 'PERMANENT'\n  AND    s.DATE_DEBUT = (\n           SELECT MAX(x.DATE_DEBUT)\n           FROM   USER_GRH.GRH_SITUATION x\n           WHERE  x.PERS_ID = p.PERS_ID\n           AND    x.DATE_DEBUT\n                  <= DATE '2024-12-31'))\nSELECT COUNT(DISTINCT PERS_ID) FROM formes_2024\n-- 2024 : 409 (un des 410 formés n'est pas\n-- permanent)",
      "autoResize": true,
      "lineHeight": 1.25
    },
