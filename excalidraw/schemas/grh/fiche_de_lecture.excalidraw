      "boundElements": [],
      "updated": 1793625970183,
      "link": null,
      "locked": false,
      "text": "Un agent de la CNSS permanent au 31 décembre. Il n'a pas à être encore en poste : un agent formé puis retraité\ndans l'année compte. Les contractuels formés sont laissés de côté.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Un agent de la CNSS permanent au 31 décembre. Il n'a pas à être encore en poste : un agent formé puis retraité\ndans l'année compte. Les contractuels formés sont laissés de côté.",
      "autoResize": true,
      "lineHeight": 1.25
    },
