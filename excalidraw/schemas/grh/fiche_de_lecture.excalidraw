    {
      "id": "1AW6pIMp3kmKUqFRlUT6",
      "type": "text",
      "x": 39,
      "y": 6946.5,
      "width": 1080.54,
      "height": 67.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
