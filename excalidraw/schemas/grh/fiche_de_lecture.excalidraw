    {
      "id": "vHCkKu2jGIdFZBOcPFmm",
      "type": "text",
      "x": 39,
      "y": 9255.0,
      "width": 1070.82,
      "height": 67.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "i6XtjbytX8sD4MZ3lhF5"
