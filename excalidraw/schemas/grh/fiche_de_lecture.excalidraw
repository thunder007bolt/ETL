      "seed": 372301099,
      "version": 1,
      "versionNonce": 234931281,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793704822125,
      "link": null,
      "locked": false,
      "text": "Toutes les formations comptent, quel que soit leur statut. Le statut n'est plus tenu depuis 2015 : toutes les\nformations de la base sont au statut N. L'ancienne requête ne gardait que le statut T, qu'aucune formation n'a :\nelle ne trouvait rien.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Toutes les formations comptent, quel que soit leur statut. Le statut n'est plus tenu depuis 2015 : toutes les\nformations de la base sont au statut N. L'ancienne requête ne gardait que le statut T, qu'aucune formation n'a :\nelle ne trouvait rien.",
      "autoResize": true,
      "lineHeight": 1.25
    },
