      "seed": 515969319,
      "version": 1,
      "versionNonce": 155237305,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793625970183,
      "link": null,
      "locked": false,
      "text": "Une sortie dont la première décision de départ, dans l'année, est l'admission à la retraite, à sa date de\nvigueur. Compter une retraite de décembre l'année suivante ne retombe pas mieux sur l'annuaire.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Une sortie dont la première décision de départ, dans l'année, est l'admission à la retraite, à sa date de\nvigueur. Compter une retraite de décembre l'année suivante ne retombe pas mieux sur l'annuaire.",
      "autoResize": true,
      "lineHeight": 1.25
    },
