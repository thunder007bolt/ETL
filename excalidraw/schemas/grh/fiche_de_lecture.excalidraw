      "link": null,
      "locked": false,
      "text": "Avec promotion : le classement de l'agent a changé après une formation de l'année. Sinon, sans promotion. Le\nclassement n'est rempli que pour les formations diplômantes : 2 changements en 2024, pour 6 promotions\npubliées.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Avec promotion : le classement de l'agent a changé après une formation de l'année. Sinon, sans promotion. Le\nclassement n'est rempli que pour les formations diplômantes : 2 changements en 2024, pour 6 promotions\npubliées.",
      "autoResize": true,
      "lineHeight": 1.25
    },
