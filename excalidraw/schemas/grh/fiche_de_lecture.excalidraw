      "link": null,
      "locked": false,
      "text": "Comment lire cette fiche",
      "fontSize": 22,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Comment lire cette fiche",
      "autoResize": true,
