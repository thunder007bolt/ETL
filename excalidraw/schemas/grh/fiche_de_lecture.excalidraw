      "versionNonce": 1428388583,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793707366545,
      "link": null,
      "locked": false,
      "text": "Les frais de personnel (FP) divisés par les charges de fonctionnement (CF), chaque année, sur cinq ans. La norme\nCIPRES : au plus 85 %.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Les frais de personnel (FP) divisés par les charges de fonctionnement (CF), chaque année, sur cinq ans. La norme\nCIPRES : au plus 85 %.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "bBI"
    },
    {
      "id": "HEPq8PIiTFpjc7Bm4q1X",
      "type": "text",
      "x": 39,
      "y": 14891,
      "width": 1114.4,
      "height": 20,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "WDyxet1kPRqaSxbf2geq"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1576191096,
      "version": 2,
      "versionNonce": 487803657,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793707366545,
      "link": null,
      "locked": false,
      "text": "Exemple : (chiffres fictifs) frais de personnel 6 milliards, charges de fonctionnement 9 milliards : 6 / 9 = 67 %, sous la norme.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Exemple : (chiffres fictifs) frais de personnel 6 milliards, charges de fonctionnement 9 milliards : 6 / 9 = 67 %, sous la norme.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "bBJ"
    },
