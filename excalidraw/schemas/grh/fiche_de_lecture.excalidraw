      "text": "Les tableaux de cette fiche",
      "fontSize": 22,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Les tableaux de cette fiche",
      "autoResize": true,
      "lineHeight": 1.25,
