      "boundElements": [],
      "updated": 1794162931247,
      "link": null,
      "locked": false,
      "text": "Les rémunérations du personnel de la CNSS dans l'année : les comptes 651 et 652 de la comptabilité, comme le\ndisent l'Annuaire CIPRES et la grille de la CNSS (« total salaires payés »).",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Les rémunérations du personnel de la CNSS dans l'année : les comptes 651 et 652 de la comptabilité, comme le\ndisent l'Annuaire CIPRES et la grille de la CNSS (« total salaires payés »).",
      "autoResize": true,
      "lineHeight": 1.25
    },
