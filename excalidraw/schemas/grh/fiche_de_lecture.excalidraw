    {
      "id": "31ZqsRpCssomK2UH7WIK",
      "type": "text",
      "x": 25,
      "y": 12996.0,
      "width": 2482.8,
      "height": 50.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
