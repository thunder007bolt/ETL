      "roundness": null,
      "seed": 1901742660,
      "version": 1,
      "versionNonce": 729425773,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794162931247,
      "link": null,
      "locked": false,
      "text": "Démission (36), licenciement (54), fin de contrat (35, et la rupture du contrat 52), mise en disponibilité (07\n: l'agent sort de l'effectif, comme dans l'annuaire CNSS 2024), agent passé dans l'autre nature. Pour un\ntemporaire, c'est le dernier départ de l'année qui compte. Sans départ daté, c'est une sortie sans explication, à\nvérifier. L'annuaire CNSS 2024 compte aussi des détachements, introuvables dans la base.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Démission (36), licenciement (54), fin de contrat (35, et la rupture du contrat 52), mise en disponibilité (07\n: l'agent sort de l'effectif, comme dans l'annuaire CNSS 2024), agent passé dans l'autre nature. Pour un\ntemporaire, c'est le dernier départ de l'année qui compte. Sans départ daté, c'est une sortie sans explication, à\nvérifier. L'annuaire CNSS 2024 compte aussi des détachements, introuvables dans la base.",
      "autoResize": true,
      "lineHeight": 1.25
    },
