      "isDeleted": false,
      "boundElements": [],
      "updated": 1794162931247,
      "link": null,
      "locked": false,
      "text": "SELECT COUNT(DISTINCT PERS_ID) AS total,\n       COUNT(*)                AS inscriptions,\n       COUNT(DISTINCT CASE WHEN finalite = 'PERF'\n             THEN PERS_ID END) AS perfectionnement,\n       COUNT(DISTINCT CASE WHEN finalite = 'DIPLO'\n             THEN PERS_ID END) AS diplomante\nFROM   formes_2024\n-- 2024 : 409 formés, 524 inscriptions, dont\n-- 521 en perfectionnement, 2 diplômantes",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "SELECT COUNT(DISTINCT PERS_ID) AS total,\n       COUNT(*)                AS inscriptions,\n       COUNT(DISTINCT CASE WHEN finalite = 'PERF'\n             THEN PERS_ID END) AS perfectionnement,\n       COUNT(DISTINCT CASE WHEN finalite = 'DIPLO'\n             THEN PERS_ID END) AS diplomante\nFROM   formes_2024\n-- 2024 : 409 formés, 524 inscriptions, dont\n-- 521 en perfectionnement, 2 diplômantes",
      "autoResize": true,
      "lineHeight": 1.25
    },
