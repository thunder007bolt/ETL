    {
      "id": "n9V9fIF1rL8tjAyMTyt1",
      "type": "text",
      "x": 51,
      "y": 2433.0,
      "width": 944.6400000000001,
      "height": 40.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
