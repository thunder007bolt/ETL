    {
      "id": "37na3c0g9jB2ZI69TD0z",
      "type": "text",
      "x": 39,
      "y": 13994.0,
      "width": 1117.98,
      "height": 67.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
