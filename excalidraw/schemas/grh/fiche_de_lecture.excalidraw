    {
      "id": "ibwcD3st5JsOyqy2AHGM",
      "type": "text",
      "x": 39,
      "y": 8139,
      "width": 1040.04,
      "height": 67.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
