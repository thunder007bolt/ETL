      "versionNonce": 537908777,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793707366545,
      "link": null,
      "locked": false,
      "text": "-- une formation compte l'année de sa\n-- date de début, même si elle finit\n-- l'année d'après\nSELECT EXTRACT(YEAR FROM DATE_DEBUT) AS annee,\n       COUNT(*)                      AS formations,\n       SUM(CASE WHEN EXTRACT(YEAR FROM DATE_FIN)\n                   > EXTRACT(YEAR FROM DATE_DEBUT)\n                THEN 1 ELSE 0 END)   AS a_cheval\nFROM   USER_GRH.GRH_FORMATION\nGROUP  BY EXTRACT(YEAR FROM DATE_DEBUT)\nORDER  BY 1\n-- a_cheval : presque toujours 0",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-- une formation compte l'année de sa\n-- date de début, même si elle finit\n-- l'année d'après\nSELECT EXTRACT(YEAR FROM DATE_DEBUT) AS annee,\n       COUNT(*)                      AS formations,\n       SUM(CASE WHEN EXTRACT(YEAR FROM DATE_FIN)\n                   > EXTRACT(YEAR FROM DATE_DEBUT)\n                THEN 1 ELSE 0 END)   AS a_cheval\nFROM   USER_GRH.GRH_FORMATION\nGROUP  BY EXTRACT(YEAR FROM DATE_DEBUT)\nORDER  BY 1\n-- a_cheval : presque toujours 0",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b7f"
    },
