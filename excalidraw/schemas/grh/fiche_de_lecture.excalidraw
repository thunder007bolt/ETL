    {
      "id": "L7znoQu013flNzo5PgJ5",
      "type": "text",
      "x": 39,
      "y": 7743.0,
      "width": 1005.84,
      "height": 45.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
