      "lineHeight": 1.25
    },
    {
      "id": "u6F6eKBkyMsHC5BYq1eO",
      "type": "text",
      "x": 39,
      "y": 7347.5,
      "width": 166.08,
      "height": 20.0,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
