    {
      "id": "bPkHvcZsVYVZBa6BiR9B",
      "type": "text",
      "x": 2074,
      "y": 1136.0,
      "width": 463.99999999999994,
      "height": 320.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "4AWA253fMn8vjhKjeyLs"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 107818427,
      "version": 1,
      "versionNonce": 794246390,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793625970183,
      "link": null,
      "locked": false,
      "text": "-- qui est permanent au 31/12/2024 :\n-- agent de la CNSS (QUALITE = 'A') dont\n-- la dernière situation est PERMANENT\nSELECT p.PERS_ID\nFROM   USER_GRH.GRH_PERSONNE p\nJOIN   USER_GRH.GRH_SITUATION s\n       ON s.PERS_ID = p.PERS_ID\nWHERE  p.QUALITE = 'A'\nAND    s.NATURE_EMPLOIE = 'PERMANENT'\n-- sa dernière situation, commencée\n-- au plus tard le 31/12/2024\nAND    s.DATE_DEBUT = (\n         SELECT MAX(x.DATE_DEBUT)\n         FROM   USER_GRH.GRH_SITUATION x\n         WHERE  x.PERS_ID = p.PERS_ID\n         AND    x.DATE_DEBUT <= DATE '2024-12-31')",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-- qui est permanent au 31/12/2024 :\n-- agent de la CNSS (QUALITE = 'A') dont\n-- la dernière situation est PERMANENT\nSELECT p.PERS_ID\nFROM   USER_GRH.GRH_PERSONNE p\nJOIN   USER_GRH.GRH_SITUATION s\n       ON s.PERS_ID = p.PERS_ID\nWHERE  p.QUALITE = 'A'\nAND    s.NATURE_EMPLOIE = 'PERMANENT'\n-- sa dernière situation, commencée\n-- au plus tard le 31/12/2024\nAND    s.DATE_DEBUT = (\n         SELECT MAX(x.DATE_DEBUT)\n         FROM   USER_GRH.GRH_SITUATION x\n         WHERE  x.PERS_ID = p.PERS_ID\n         AND    x.DATE_DEBUT <= DATE '2024-12-31')",
      "autoResize": true,
      "lineHeight": 1.25
    },
