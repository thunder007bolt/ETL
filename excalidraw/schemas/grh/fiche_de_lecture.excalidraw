    {
      "id": "stEFJqbI5pOWr67X4MjF",
      "type": "text",
      "x": 2074,
      "y": 2860.0,
      "width": 445.43999999999994,
      "height": 240.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "jzUHdjOkWSaAZKz6fuqs"
      ],
