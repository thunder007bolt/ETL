    {
      "id": "FmuqCNhwgxdp1vpbRLhv",
      "type": "text",
      "x": 2074,
      "y": 1631,
      "width": 482.55999999999995,
      "height": 660,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
