    {
      "id": "O8seee5kmwzWeZdY9Z9i",
      "type": "text",
      "x": 39,
      "y": 8683.0,
      "width": 1070.82,
      "height": 67.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
