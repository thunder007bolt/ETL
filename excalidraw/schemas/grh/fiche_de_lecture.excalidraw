    {
      "id": "eb8WDl4YL4IWl8fLPCZ8",
      "type": "text",
      "x": 39,
      "y": 16539.0,
      "width": 1090.44,
      "height": 67.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "IAdVjDrgG28lBbZos6uv"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 326876974,
      "version": 1,
      "versionNonce": 1958089861,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794162931247,
      "link": null,
      "locked": false,
      "text": "Deux sources possibles. La comptabilité : la grille de la CNSS prend les comptes 63812, 6386 et 6577. La base\ndu personnel : la somme des frais saisis sur les inscriptions aux formations commencées dans l'année (un frais\nvide compte zéro). Le champ « budget » des formations contient une année, pas un montant.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Deux sources possibles. La comptabilité : la grille de la CNSS prend les comptes 63812, 6386 et 6577. La base\ndu personnel : la somme des frais saisis sur les inscriptions aux formations commencées dans l'année (un frais\nvide compte zéro). Le champ « budget » des formations contient une année, pas un montant.",
      "autoResize": true,
      "lineHeight": 1.25
    },
