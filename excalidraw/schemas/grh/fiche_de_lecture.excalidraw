    {
      "id": "vCAiRgIr6Hv20wVKiu61",
      "type": "text",
      "x": 2074,
      "y": 2712.0,
      "width": 445.43999999999994,
      "height": 240.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "RweA0hn6DCwquq9kWEBA"
