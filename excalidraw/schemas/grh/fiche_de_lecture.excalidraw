    },
    {
      "id": "5MYnWcfzaNWvb2HV6ObT",
      "type": "text",
      "x": 25,
      "y": 14959.5,
      "width": 2482.8,
      "height": 50.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
