    {
      "id": "b2Aa499zLwwCS1ymcEUJ",
      "type": "text",
      "x": 39,
      "y": 6609.5,
      "width": 1080.54,
      "height": 67.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "CdQkoXXImwwISLyA7Q6j"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1024120084,
      "version": 1,
      "versionNonce": 802025385,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793625970183,
      "link": null,
      "locked": false,
      "text": "Une entrée est un permanent présent à la fin de l'année et absent au début ; une sortie, l'inverse. Ainsi début +\nentrées − sorties = fin, toujours. La table des mouvements de la base n'a ni recrutement ni départ : elle ne\npeut pas servir.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Une entrée est un permanent présent à la fin de l'année et absent au début ; une sortie, l'inverse. Ainsi début +\nentrées − sorties = fin, toujours. La table des mouvements de la base n'a ni recrutement ni départ : elle ne\npeut pas servir.",
      "autoResize": true,
      "lineHeight": 1.25
    },
