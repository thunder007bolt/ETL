      "isDeleted": false,
      "boundElements": [],
      "updated": 1794162931247,
      "link": null,
      "locked": false,
      "text": "Les dépenses de formation : les comptes 63812, 6386 et 6577 de la comptabilité, ou les frais saisis sur les\ninscriptions ?",
