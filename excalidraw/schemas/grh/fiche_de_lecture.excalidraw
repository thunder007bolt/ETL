    {
      "id": "V9l9TvgIYBHfhBLN5z1Y",
      "type": "text",
      "x": 39,
      "y": 1757,
      "width": 1086.48,
      "height": 67.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
