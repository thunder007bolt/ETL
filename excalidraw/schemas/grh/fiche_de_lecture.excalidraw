    {
      "id": "ZFBOTA0Lotl64YRveg3H",
      "type": "text",
      "x": 39,
      "y": 15689.5,
      "width": 1114.56,
      "height": 67.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
