    {
      "id": "0Inrxk0QLcXON8h6R9j1",
      "type": "text",
      "x": 2074,
      "y": 7638,
      "width": 417.59999999999997,
      "height": 280,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "9itBdbwDCQfcGXYnvu7J"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 969112318,
      "version": 2,
      "versionNonce": 1674993831,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793707366545,
      "link": null,
      "locked": false,
      "text": "-- les entrées sans embauche en 2024\nSELECT COUNT(*)\nFROM   permanents_2024\nWHERE  PERS_ID NOT IN\n       (SELECT PERS_ID FROM permanents_2023)\nAND    NVL(DATE_EMBAUCHE, DATE_PRISE_SERVICE)\n         < DATE '2024-01-01'\n-- à part : les remises en activité (18)\nSELECT COUNT(DISTINCT PERS_ID)\nFROM   USER_GRH.GRH_DECISION\nWHERE  CDEC_CODE = '18'\nAND    DATE_VIGUEUR BETWEEN DATE '2024-01-01'\n                        AND DATE '2024-12-31'\n-- 2024 : 4 décisions 18 (6 remises publiées)",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-- les entrées sans embauche en 2024\nSELECT COUNT(*)\nFROM   permanents_2024\nWHERE  PERS_ID NOT IN\n       (SELECT PERS_ID FROM permanents_2023)\nAND    NVL(DATE_EMBAUCHE, DATE_PRISE_SERVICE)\n         < DATE '2024-01-01'\n-- à part : les remises en activité (18)\nSELECT COUNT(DISTINCT PERS_ID)\nFROM   USER_GRH.GRH_DECISION\nWHERE  CDEC_CODE = '18'\nAND    DATE_VIGUEUR BETWEEN DATE '2024-01-01'\n                        AND DATE '2024-12-31'\n-- 2024 : 4 décisions 18 (6 remises publiées)",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b52"
    },
