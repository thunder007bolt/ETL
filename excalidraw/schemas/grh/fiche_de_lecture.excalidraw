    {
      "id": "ibwcD3st5JsOyqy2AHGM",
      "type": "text",
      "x": 39,
      "y": 8139.0,
      "width": 1040.04,
      "height": 67.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "a4d9FJj6jCS5UWQBkE1g"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1699731509,
      "version": 1,
      "versionNonce": 1216773645,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793704822125,
      "link": null,
      "locked": false,
      "text": "Un agent part à la retraite l'année où prend effet sa décision d'admission à la retraite. S'il a plusieurs\ndécisions de départ, seule la première compte. J'ai aussi essayé de compter les départs de décembre l'année\nsuivante : on s'éloigne davantage de l'annuaire CNSS 2024 (16 d'écart sur 5 ans, contre 11).",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Un agent part à la retraite l'année où prend effet sa décision d'admission à la retraite. S'il a plusieurs\ndécisions de départ, seule la première compte. J'ai aussi essayé de compter les départs de décembre l'année\nsuivante : on s'éloigne davantage de l'annuaire CNSS 2024 (16 d'écart sur 5 ans, contre 11).",
      "autoResize": true,
      "lineHeight": 1.25
    },
