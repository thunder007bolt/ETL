      "boundElements": [],
      "updated": 1794925216158,
      "link": null,
      "locked": false,
      "text": "Objectif : dans tous les tableaux, les chiffres de l'année N doivent venir de la photo de la\nbase de fin janvier N+1 (fiche des règles, règle 2). La réponse permet de prévoir cette photo\nchaque année.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Objectif : dans tous les tableaux, les chiffres de l'année N doivent venir de la photo de la\nbase de fin janvier N+1 (fiche des règles, règle 2). La réponse permet de prévoir cette photo\nchaque année.",
      "autoResize": true,
      "lineHeight": 1.25
    },
