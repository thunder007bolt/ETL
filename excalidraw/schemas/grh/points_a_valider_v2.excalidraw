    {
      "id": "KfksWmplrUJblY5j5cND",
      "type": "text",
      "x": 897.0,
      "y": 1892.0,
      "width": 762.5600000000001,
      "height": 40.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
