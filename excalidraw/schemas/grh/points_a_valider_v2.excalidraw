      "frameId": null,
      "roundness": null,
      "seed": 1216053446,
      "version": 1,
      "versionNonce": 1860349503,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794925216158,
      "link": null,
      "locked": false,
      "text": "Chiffre : l'annuaire compte 2 détachements et 2 fins de détachement en 2023, puis 1\ndétachement en 2024.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Chiffre : l'annuaire compte 2 détachements et 2 fins de détachement en 2023, puis 1\ndétachement en 2024.",
      "autoResize": true,
      "lineHeight": 1.25
    },
