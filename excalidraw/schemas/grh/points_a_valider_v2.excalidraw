    },
    {
      "id": "W0NIMJ64dMEiya8Lk5Kr",
      "type": "text",
      "x": 897.0,
      "y": 4946.0,
      "width": 800.32,
      "height": 60.0,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
