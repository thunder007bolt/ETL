      "type": "text",
      "x": 39.0,
      "y": 10320.0,
      "width": 649.9200000000001,
      "height": 20.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "y9xew0omrWpKG9AIEc1O"
      ],
