    },
    {
      "id": "p2epEZGio7TR7LkGqimY",
      "type": "text",
      "x": 897.0,
      "y": 12132.0,
      "width": 538.88,
      "height": 20.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "eLHAvKY1xpvxZV3ecRxl"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 899443735,
      "version": 1,
      "versionNonce": 1996707802,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794925216158,
      "link": null,
      "locked": false,
      "text": "C'est quoi : T58 range les agents par âge, T61 par ancienneté.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "C'est quoi : T58 range les agents par âge, T61 par ancienneté.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "BTwFJW6MKvhuGmIsFwqQ",
      "type": "text",
      "x": 897.0,
      "y": 12160.0,
      "width": 787.5200000000001,
      "height": 60.0,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "eLHAvKY1xpvxZV3ecRxl"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 817636978,
      "version": 1,
      "versionNonce": 2016097244,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794925216158,
      "link": null,
      "locked": false,
      "text": "Réponse donnée : l'âge en années pleines, d'accord. L'ancienneté part de la prise de service,\nsinon de l'embauche, et on retire les périodes où l'agent était parti (disponibilité, départ\npuis nouvel engagement).",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Réponse donnée : l'âge en années pleines, d'accord. L'ancienneté part de la prise de service,\nsinon de l'embauche, et on retire les périodes où l'agent était parti (disponibilité, départ\npuis nouvel engagement).",
      "autoResize": true,
      "lineHeight": 1.25
    },
