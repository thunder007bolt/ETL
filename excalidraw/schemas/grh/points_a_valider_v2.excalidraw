      "versionNonce": 2004373744,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794925216158,
      "link": null,
      "locked": false,
      "text": "Aujourd'hui : il compte seulement l'année où sa formation commence.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Aujourd'hui : il compte seulement l'année où sa formation commence.",
