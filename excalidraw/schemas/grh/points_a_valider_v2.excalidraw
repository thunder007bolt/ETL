      "locked": false,
      "text": "Entré et parti la même année",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Entré et parti la même année",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "UoL45Q7Ofe9dsiNbWFsG",
      "type": "text",
      "x": 39.0,
      "y": 6786.0,
      "width": 624.64,
      "height": 20.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "wZl0ABhsTbqEFYZcMH6h"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 657882195,
      "version": 1,
      "versionNonce": 656083326,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794925216158,
      "link": null,
      "locked": false,
      "text": "C'est quoi : un agent peut être recruté puis partir avant le 31 décembre.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "C'est quoi : un agent peut être recruté puis partir avant le 31 décembre.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "5jYlHg1OtVr9HUWrtg8l",
      "type": "text",
      "x": 39.0,
      "y": 6814.0,
      "width": 776.6400000000001,
      "height": 60.0,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "wZl0ABhsTbqEFYZcMH6h"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 613774260,
      "version": 1,
      "versionNonce": 556217620,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794925216158,
      "link": null,
      "locked": false,
      "text": "Objectif : dans T60, les entrées et les sorties doivent compter tous les mouvements de\nl'année. Elles permettent de suivre les recrutements et les départs (Annuaire CIPRES, p.\n51). La réponse permet de savoir si ces passages courts doivent apparaître.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Objectif : dans T60, les entrées et les sorties doivent compter tous les mouvements de\nl'année. Elles permettent de suivre les recrutements et les départs (Annuaire CIPRES, p.\n51). La réponse permet de savoir si ces passages courts doivent apparaître.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "RKNuxjdfyRD0nh3Gcrxf",
      "type": "text",
      "x": 39.0,
      "y": 6882.0,
      "width": 759.36,
      "height": 40.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "wZl0ABhsTbqEFYZcMH6h"
      ],
