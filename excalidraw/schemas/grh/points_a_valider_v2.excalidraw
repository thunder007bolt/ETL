      "roundness": null,
      "seed": 774764226,
      "version": 1,
      "versionNonce": 546712874,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794925216158,
      "link": null,
      "locked": false,
      "text": "Aujourd'hui : l'effectif se calcule au 31 décembre, et à chaque fin de mois en option.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Aujourd'hui : l'effectif se calcule au 31 décembre, et à chaque fin de mois en option.",
      "autoResize": true,
      "lineHeight": 1.25
    },
