      "updated": 1794925216158,
      "link": null,
      "locked": false,
      "text": "Les cadres moyens sont-ils des encadrants ?",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Les cadres moyens sont-ils des encadrants ?",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "Lb87RiLF1B9z09JzSxpp",
      "type": "text",
      "x": 897.0,
      "y": 13152.0,
      "width": 745.6,
      "height": 20.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "mHLthwxwwyGil5DNAogj"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 405129253,
      "version": 1,
      "versionNonce": 1507822979,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794925216158,
      "link": null,
      "locked": false,
      "text": "C'est quoi : avec les cadres moyens, le taux est de 48,8 % en 2024 ; sans eux, de 7,8 %.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "C'est quoi : avec les cadres moyens, le taux est de 48,8 % en 2024 ; sans eux, de 7,8 %.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "hGxXXpQRZKsBuF41hg50",
      "type": "text",
      "x": 897.0,
      "y": 13180.0,
      "width": 578.5600000000001,
      "height": 20.0,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "mHLthwxwwyGil5DNAogj"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 36529888,
      "version": 1,
      "versionNonce": 697454179,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794925216158,
      "link": null,
      "locked": false,
      "text": "Réponse donnée : oui, un encadrant est un cadre, moyen ou supérieur.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Réponse donnée : oui, un encadrant est un cadre, moyen ou supérieur.",
      "autoResize": true,
      "lineHeight": 1.25
    },
