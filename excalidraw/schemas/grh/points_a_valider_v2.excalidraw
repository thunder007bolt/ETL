    },
    {
      "id": "l4BUa1Vxd9EGfDMdn5i9",
      "type": "text",
      "x": 1755.0,
      "y": 12812.0,
      "width": 705.2800000000001,
      "height": 20.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
