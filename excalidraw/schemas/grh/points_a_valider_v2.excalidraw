    {
      "id": "dfuFOEdPjbrICdfrZdpL",
      "type": "text",
      "x": 39.0,
      "y": 3660.0,
      "width": 786.5600000000001,
      "height": 40.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "V0n9bboBZ9FNPeDblvak"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1780398136,
      "version": 1,
      "versionNonce": 855986585,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794925216158,
      "link": null,
      "locked": false,
      "text": "C'est quoi : quand un agent vient d'être embauché, sa fiche n'a pas encore d'état : elle n'est\nni active ni inactive.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "C'est quoi : quand un agent vient d'être embauché, sa fiche n'a pas encore d'état : elle n'est\nni active ni inactive.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "Zcqm5OGgBwJd8eF2Ejsu",
      "type": "text",
      "x": 39.0,
      "y": 3708.0,
      "width": 800.48,
      "height": 80.0,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "V0n9bboBZ9FNPeDblvak"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1806346338,
      "version": 1,
      "versionNonce": 1429641629,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794925216158,
      "link": null,
      "locked": false,
      "text": "Objectif : dans T58 et T60, un agent embauché avant la date d'arrêté doit être compté, même\nsi sa fiche n'est pas encore passée à « actif ». Cela permet de ne pas perdre les\nrecrutements de fin d'année (recueil v7, RH ligne 1). La réponse permet de fixer la règle\npour ces fiches.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Objectif : dans T58 et T60, un agent embauché avant la date d'arrêté doit être compté, même\nsi sa fiche n'est pas encore passée à « actif ». Cela permet de ne pas perdre les\nrecrutements de fin d'année (recueil v7, RH ligne 1). La réponse permet de fixer la règle\npour ces fiches.",
      "autoResize": true,
      "lineHeight": 1.25
    },
