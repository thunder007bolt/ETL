      "versionNonce": 1719958096,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794925216158,
      "link": null,
      "locked": false,
      "text": "Dans la base : GRH_FORMATION, date de début et date de fin.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Dans la base : GRH_FORMATION, date de début et date de fin.",
      "autoResize": true,
      "lineHeight": 1.25
    },
