      "type": "text",
      "x": 39.0,
      "y": 4624.0,
      "width": 770.24,
      "height": 40.0,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
