    },
    {
      "id": "MDv0npWPCV8a3tVurfN3",
      "type": "text",
      "x": 39.0,
      "y": 12472.0,
      "width": 711.0400000000001,
      "height": 20.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "qPy6dU57ueOLfaMIPKce"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 310059469,
      "version": 1,
      "versionNonce": 1129961219,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794925216158,
      "link": null,
      "locked": false,
      "text": "C'est quoi : un contractuel est un agent temporaire, engagé pour une durée limitée.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "C'est quoi : un contractuel est un agent temporaire, engagé pour une durée limitée.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "fLcxiOVq8XxNsZWA2Oht",
      "type": "text",
      "x": 39.0,
      "y": 12500.0,
      "width": 803.5200000000001,
      "height": 60.0,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "qPy6dU57ueOLfaMIPKce"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1172982128,
      "version": 1,
      "versionNonce": 73193105,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794925216158,
      "link": null,
      "locked": false,
      "text": "Réponse donnée : un temporaire est présent si la date d'arrêté tombe dans un de ses contrats ;\nun contrat commence à l'engagement (50) et finit au départ ou au contrat suivant. Plus de\ndurée de 18 mois.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Réponse donnée : un temporaire est présent si la date d'arrêté tombe dans un de ses contrats ;\nun contrat commence à l'engagement (50) et finit au départ ou au contrat suivant. Plus de\ndurée de 18 mois.",
      "autoResize": true,
      "lineHeight": 1.25
    },
