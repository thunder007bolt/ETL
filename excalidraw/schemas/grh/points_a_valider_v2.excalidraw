      "versionNonce": 413291667,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794925216158,
      "link": null,
      "locked": false,
      "text": "Question : pouvez-vous remplir le domaine de chaque unité dans ce fichier, d'abord les 132\nlignes « À décider » ?",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Question : pouvez-vous remplir le domaine de chaque unité dans ce fichier, d'abord les 132\nlignes « À décider » ?",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "roqRopHa7IzapJF2PWJf",
      "type": "rectangle",
      "x": 1755.0,
      "y": 2248.0,
      "width": 22,
