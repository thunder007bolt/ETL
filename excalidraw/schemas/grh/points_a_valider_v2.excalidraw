    },
    {
      "id": "THxjHu45zTPEFKTlVvTK",
      "type": "text",
      "x": 39.0,
      "y": 9286.0,
      "width": 801.2800000000001,
      "height": 40.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "F2vCskgvGxVjxJaNjxxK"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1631426712,
      "version": 1,
      "versionNonce": 1513310890,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794925216158,
      "link": null,
      "locked": false,
      "text": "C'est quoi : le recueil donne la gestion pour les frais de personnel et la formation (G et S),\npas pour la masse salariale (comptes 651 et 652).",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "C'est quoi : le recueil donne la gestion pour les frais de personnel et la formation (G et S),\npas pour la masse salariale (comptes 651 et 652).",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "nhPYiVnlGJiayPtpJM0u",
      "type": "text",
      "x": 39.0,
      "y": 9334.0,
      "width": 785.44,
      "height": 60.0,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "F2vCskgvGxVjxJaNjxxK"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1216394782,
      "version": 1,
      "versionNonce": 1196674153,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794925216158,
      "link": null,
      "locked": false,
      "text": "Objectif : dans T64, la dépense de formation et la masse salariale doivent porter sur le\nmême périmètre. Cela permet de comparer le ratio à la norme de 1 à 5 % (Annuaire CIPRES,\np. 17). La réponse permet de fixer les gestions de la masse salariale.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Objectif : dans T64, la dépense de formation et la masse salariale doivent porter sur le\nmême périmètre. Cela permet de comparer le ratio à la norme de 1 à 5 % (Annuaire CIPRES,\np. 17). La réponse permet de fixer les gestions de la masse salariale.",
      "autoResize": true,
      "lineHeight": 1.25
    },
