      "link": null,
      "locked": false,
      "text": "C'est quoi : un contractuel peut aussi suivre une formation.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "C'est quoi : un contractuel peut aussi suivre une formation.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "EjSA7hzLYl7xmQCFGNcM",
      "type": "text",
      "x": 897.0,
      "y": 7792.0,
      "width": 804.0,
      "height": 60.0,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
