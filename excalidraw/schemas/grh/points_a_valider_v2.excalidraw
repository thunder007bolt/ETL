      "x": 39.0,
      "y": 7414.0,
      "width": 772.32,
      "height": 40.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "A1F7AGRqLadnFIq1LiDV"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1699550675,
      "version": 1,
      "versionNonce": 1152109500,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794925216158,
      "link": null,
      "locked": false,
      "text": "Aujourd'hui : ce n'est pas une sortie ; le tableau 121 de l'annuaire CNSS 2024 n'a pas de\ncolonne pour elle.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Aujourd'hui : ce n'est pas une sortie ; le tableau 121 de l'annuaire CNSS 2024 n'a pas de\ncolonne pour elle.",
