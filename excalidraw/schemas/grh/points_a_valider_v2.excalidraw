      "versionNonce": 550109238,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794925216158,
      "link": null,
      "locked": false,
      "text": "Dans la base : 817 personnes sont parties sans aucune date : ni décision de départ, ni date de\ndécès (GRH_PERSONNE, ETAT_EMPLOYE = INACTIF).",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Dans la base : 817 personnes sont parties sans aucune date : ni décision de départ, ni date de\ndécès (GRH_PERSONNE, ETAT_EMPLOYE = INACTIF).",
      "autoResize": true,
      "lineHeight": 1.25
