      "version": 1,
      "versionNonce": 1579994830,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794925216158,
      "link": null,
      "locked": false,
      "text": "Dans la base : aucune décision 37 (accueil d'un agent détaché) pour un permanent.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Dans la base : aucune décision 37 (accueil d'un agent détaché) pour un permanent.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "fDYk8O6XHwfsXhGeYnOE",
      "type": "text",
      "x": 1755.0,
      "y": 6486.0,
      "width": 731.5200000000001,
      "height": 40.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "irC5F43wXbtMDN79QJ8U"
