      "versionNonce": 1906965093,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794925216158,
      "link": null,
      "locked": false,
      "text": "C'est quoi : T60 suit les entrées et les sorties du personnel sur cinq ans.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "C'est quoi : T60 suit les entrées et les sorties du personnel sur cinq ans.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "dPvN5jJYoUu4Wu5hdZ1Q",
      "type": "text",
      "x": 897.0,
      "y": 12500.0,
      "width": 761.2800000000001,
      "height": 60.0,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "7yp5zO4zxrBmUNrJWtM4"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 844155501,
      "version": 1,
      "versionNonce": 485764422,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794925216158,
      "link": null,
      "locked": false,
      "text": "Réponse donnée : T60 se lit entre deux photos de l'effectif (début + entrées − sorties =\nfin), avec les codes de mouvement de la CNSS. Les changements de poste restent hors du\ntableau.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Réponse donnée : T60 se lit entre deux photos de l'effectif (début + entrées − sorties =\nfin), avec les codes de mouvement de la CNSS. Les changements de poste restent hors du\ntableau.",
      "autoResize": true,
      "lineHeight": 1.25
    },
