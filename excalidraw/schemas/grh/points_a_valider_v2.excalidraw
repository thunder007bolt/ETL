      "boundElements": [],
      "updated": 1794925216158,
      "link": null,
      "locked": false,
      "text": "C'est quoi : les entrées et les sorties de T60 se lisent dans les décisions.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "C'est quoi : les entrées et les sorties de T60 se lisent dans les décisions.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "6VvzhxG4soOZ22x2uR02",
      "type": "text",
      "x": 1755.0,
      "y": 10348.0,
      "width": 805.2800000000001,
      "height": 60.0,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
