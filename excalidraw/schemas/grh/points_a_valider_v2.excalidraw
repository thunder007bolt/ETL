      "text": "C'est quoi : la table des mouvements de l'application garde les changements de poste.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "C'est quoi : la table des mouvements de l'application garde les changements de poste.",
      "autoResize": true,
