      "version": 1,
      "versionNonce": 1303325887,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794925216158,
      "link": null,
      "locked": false,
      "text": "Dans la base : la nature de la dernière situation (GRH_SITUATION, NATURE_EMPLOIE).",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Dans la base : la nature de la dernière situation (GRH_SITUATION, NATURE_EMPLOIE).",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "y6wMVnJGAr36RZ8gjPPP",
      "type": "text",
      "x": 39.0,
      "y": 9904.0,
      "width": 794.08,
      "height": 40.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
