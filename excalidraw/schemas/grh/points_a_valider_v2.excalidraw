      "updated": 1794925216158,
      "link": null,
      "locked": false,
      "text": "Les actifs ou tout l'effectif ?",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Les actifs ou tout l'effectif ?",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "fZesCZTQTRXcmsiBcvGq",
      "type": "text",
      "x": 1755.0,
      "y": 13152.0,
      "width": 648.0,
      "height": 20.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "DUjzgIM1nkHkvnAIw86c"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 629597296,
      "version": 1,
      "versionNonce": 1510204240,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794925216158,
      "link": null,
      "locked": false,
      "text": "C'est quoi : le taux d'encadrement pouvait se calculer sur les seuls actifs.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "C'est quoi : le taux d'encadrement pouvait se calculer sur les seuls actifs.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "VQWsuCq2GE3p4YVmTOQx",
      "type": "text",
      "x": 1755.0,
      "y": 13180.0,
      "width": 785.44,
      "height": 40.0,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "DUjzgIM1nkHkvnAIw86c"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 56254981,
      "version": 1,
      "versionNonce": 235243184,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794925216158,
      "link": null,
      "locked": false,
      "text": "Réponse donnée : sans objet. Les agents en disponibilité sortent de l'effectif (point 5), il\nne reste presque plus d'inactifs : le taux porte sur tout l'effectif.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Réponse donnée : sans objet. Les agents en disponibilité sortent de l'effectif (point 5), il\nne reste presque plus d'inactifs : le taux porte sur tout l'effectif.",
      "autoResize": true,
      "lineHeight": 1.25
    },
