      "boundElements": [],
      "updated": 1794925216158,
      "link": null,
      "locked": false,
      "text": "Dans la base : la position de la situation (GRH_SITUATION, STATUT_EMPLOYE : B, D,\nF, H) n'est pas datée ; seule la mise à disposition a une décision (14), sans décision de\nretour.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Dans la base : la position de la situation (GRH_SITUATION, STATUT_EMPLOYE : B, D,\nF, H) n'est pas datée ; seule la mise à disposition a une décision (14), sans décision de\nretour.",
      "autoResize": true,
      "lineHeight": 1.25
    },
