      "isDeleted": false,
      "boundElements": [],
      "updated": 1794925216158,
      "link": null,
      "locked": false,
      "text": "Dans la base : la section analytique d'une écriture, si elle est remplie dans Oracle GL.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Dans la base : la section analytique d'une écriture, si elle est remplie dans Oracle GL.",
      "autoResize": true,
