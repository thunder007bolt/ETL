      "isDeleted": false,
      "boundElements": [],
      "updated": 1794925216158,
      "link": null,
      "locked": false,
      "text": "C'est quoi : les montants comptables lus dans la copie de la base semblaient faux.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "C'est quoi : les montants comptables lus dans la copie de la base semblaient faux.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "iARioi1jeXjgBI8R9JgR",
      "type": "text",
      "x": 1755.0,
      "y": 12840.0,
      "width": 772.8000000000001,
      "height": 40.0,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "uy2OqyGNhaGdl1Ddm1LO"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1138144549,
      "version": 1,
      "versionNonce": 989791560,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794925216158,
      "link": null,
      "locked": false,
      "text": "Réponse donnée : la comptabilité de la copie n'est pas valide ; T63 et T64 passent par la\nvue V_BI_BALANCE_COMPTABLE (point 55).",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Réponse donnée : la comptabilité de la copie n'est pas valide ; T63 et T64 passent par la\nvue V_BI_BALANCE_COMPTABLE (point 55).",
      "autoResize": true,
      "lineHeight": 1.25
    },
