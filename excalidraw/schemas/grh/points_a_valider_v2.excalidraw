      "version": 1,
      "versionNonce": 1163294674,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794925216158,
      "link": null,
      "locked": false,
      "text": "Aujourd'hui : T63 et T64 ne sont pas produits. Il leur faut cinq exercices (N−4 à N).",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Aujourd'hui : T63 et T64 ne sont pas produits. Il leur faut cinq exercices (N−4 à N).",
      "autoResize": true,
      "lineHeight": 1.25
    },
