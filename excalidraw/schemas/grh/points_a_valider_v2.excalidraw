      "link": null,
      "locked": false,
      "text": "L'agent en disponibilité",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "L'agent en disponibilité",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "iMJCKdTi1bgNyspIyv3M",
      "type": "text",
      "x": 897.0,
      "y": 11772.0,
      "width": 769.9200000000001,
      "height": 40.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "9MD8pxU8wIDe9lhWP0bP"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 998557316,
      "version": 1,
      "versionNonce": 190657208,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794925216158,
      "link": null,
      "locked": false,
      "text": "C'est quoi : un agent en disponibilité arrête de travailler pour un temps, à sa demande et\nsans salaire.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "C'est quoi : un agent en disponibilité arrête de travailler pour un temps, à sa demande et\nsans salaire.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "oNYAFANj7me8wtwosPcw",
      "type": "text",
      "x": 897.0,
      "y": 11820.0,
      "width": 804.96,
      "height": 40.0,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "9MD8pxU8wIDe9lhWP0bP"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 777950942,
      "version": 1,
      "versionNonce": 427753371,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794925216158,
      "link": null,
      "locked": false,
      "text": "Réponse donnée : il sort de l'effectif à sa mise en disponibilité (décision 07) et y revient à\nsa remise en activité (18). T60 compte une sortie et une entrée.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Réponse donnée : il sort de l'effectif à sa mise en disponibilité (décision 07) et y revient à\nsa remise en activité (18). T60 compte une sortie et une entrée.",
      "autoResize": true,
      "lineHeight": 1.25
    },
