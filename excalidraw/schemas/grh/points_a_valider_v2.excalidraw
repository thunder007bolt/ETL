    {
      "id": "1D4Cy96ycZiRGrtFxEbj",
      "type": "text",
      "x": 1755.0,
      "y": 2192.0,
      "width": 779.84,
      "height": 40.0,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
