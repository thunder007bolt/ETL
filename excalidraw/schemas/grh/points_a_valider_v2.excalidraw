      "boundElements": [],
      "updated": 1794925216158,
      "link": null,
      "locked": false,
      "text": "Dans la base : vue V_BI_BALANCE_COMPTABLE (point 55), gestion G générale et S\nsociale.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
