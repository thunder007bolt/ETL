      "isDeleted": false,
      "boundElements": [],
      "updated": 1794925216158,
      "link": null,
      "locked": false,
      "text": "Objectif : dans tous les tableaux, chaque situation et chaque décision doit tomber à sa vraie\ndate. Cela permet de ne pas perdre d'agents (Proposition BI). La réponse permet de corriger\nces lignes à la source.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Objectif : dans tous les tableaux, chaque situation et chaque décision doit tomber à sa vraie\ndate. Cela permet de ne pas perdre d'agents (Proposition BI). La réponse permet de corriger\nces lignes à la source.",
      "autoResize": true,
      "lineHeight": 1.25
    },
