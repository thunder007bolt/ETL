      "text": "Les temporaires dans T60",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Les temporaires dans T60",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "XXKVllgik3SAVLMbX1Yw",
      "type": "text",
      "x": 897.0,
      "y": 12812.0,
      "width": 541.12,
      "height": 20.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "2aXjLOgCFEyVs98Qj0V6"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 611597031,
      "version": 1,
      "versionNonce": 1503073365,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794925216158,
      "link": null,
      "locked": false,
      "text": "C'est quoi : un temporaire est souvent réengagé plusieurs fois.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "C'est quoi : un temporaire est souvent réengagé plusieurs fois.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "8eJU4sgmQyHWM7a4dSZk",
      "type": "text",
      "x": 897.0,
      "y": 12840.0,
      "width": 762.4000000000001,
      "height": 40.0,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "2aXjLOgCFEyVs98Qj0V6"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1041176582,
      "version": 1,
      "versionNonce": 1317148550,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794925216158,
      "link": null,
      "locked": false,
      "text": "Réponse donnée : T60 se lit pour les permanents ou pour les temporaires, comme T58. Un\ntemporaire devenu permanent est une autre entrée des permanents.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Réponse donnée : T60 se lit pour les permanents ou pour les temporaires, comme T58. Un\ntemporaire devenu permanent est une autre entrée des permanents.",
      "autoResize": true,
      "lineHeight": 1.25
    },
