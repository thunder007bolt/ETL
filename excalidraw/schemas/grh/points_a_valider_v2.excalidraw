    },
    {
      "id": "UZ6ajTT8qXaZtAv9QNer",
      "type": "text",
      "x": 39.0,
      "y": 10756.0,
      "width": 711.0400000000001,
      "height": 20.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "tYWMZqXYj60Yaf2CieZC"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 357223487,
      "version": 1,
      "versionNonce": 464644713,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794925216158,
      "link": null,
      "locked": false,
      "text": "C'est quoi : le chargement de l'entrepôt lit une table des catégories de formation.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "C'est quoi : le chargement de l'entrepôt lit une table des catégories de formation.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "UTcMUxsvCADvfYP6EKJR",
      "type": "text",
      "x": 39.0,
      "y": 10784.0,
      "width": 788.0,
      "height": 60.0,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "tYWMZqXYj60Yaf2CieZC"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 2108073085,
      "version": 1,
      "versionNonce": 1812976613,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794925216158,
      "link": null,
      "locked": false,
      "text": "Objectif : dans T62, la finalité doit se lire dans une liste à jour. Cela permet de séparer\nperfectionnement et diplôme (Annuaire CIPRES, p. 51). La réponse permet de réparer le\nchargement.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Objectif : dans T62, la finalité doit se lire dans une liste à jour. Cela permet de séparer\nperfectionnement et diplôme (Annuaire CIPRES, p. 51). La réponse permet de réparer le\nchargement.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "gBDnbrWc5yiZBDNIUdfA",
      "type": "text",
      "x": 39.0,
      "y": 10852.0,
      "width": 788.48,
      "height": 40.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "tYWMZqXYj60Yaf2CieZC"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 896025499,
      "version": 1,
      "versionNonce": 727012024,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794925216158,
      "link": null,
      "locked": false,
      "text": "Dans la base : toutes les formations sont au statut N, et la table GRH_CAT_FORMATION,\nlue par le chargement, n'existe pas.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Dans la base : toutes les formations sont au statut N, et la table GRH_CAT_FORMATION,\nlue par le chargement, n'existe pas.",
      "autoResize": true,
      "lineHeight": 1.25
    },
