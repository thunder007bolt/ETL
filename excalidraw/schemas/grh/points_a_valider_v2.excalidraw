    {
      "id": "VOEKaZWVtQQe62nJSwQh",
      "type": "text",
      "x": 1818.2220650636493,
      "y": 1844.0,
      "width": 286.8,
      "height": 25.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
