    {
      "id": "WyEuspYuHWsvzDaxdScy",
      "type": "text",
      "x": 897.0,
      "y": 6370.0,
      "width": 805.12,
      "height": 60.0,
      "angle": 0,
      "strokeColor": "#2f9e44",
