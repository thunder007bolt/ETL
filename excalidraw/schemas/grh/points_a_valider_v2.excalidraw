      "roundness": null,
      "seed": 858216044,
      "version": 1,
      "versionNonce": 1145555533,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794925216158,
      "link": null,
      "locked": false,
      "text": "Question : cette lecture est-elle juste, ou l'application garde-t-elle ailleurs le type de\nchaque unité ?",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Question : cette lecture est-elle juste, ou l'application garde-t-elle ailleurs le type de\nchaque unité ?",
      "autoResize": true,
      "lineHeight": 1.25
    },
