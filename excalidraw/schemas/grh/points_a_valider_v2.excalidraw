    {
      "id": "fA75UyiCDmO46ayJKP4G",
      "type": "text",
      "x": 97.0,
      "y": 1222.0,
      "width": 328.8,
      "height": 25.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
