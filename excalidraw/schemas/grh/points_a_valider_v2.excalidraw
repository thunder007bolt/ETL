      "roundness": null,
      "seed": 1306704406,
      "version": 1,
      "versionNonce": 1655922422,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794925216158,
      "link": null,
      "locked": false,
      "text": "Aujourd'hui : le taux CIPRES se calcule sur les permanents (362 cadres sur 742 en 2024) ;\ncelui des temporaires se lit à part, avec le même filtre que T58.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Aujourd'hui : le taux CIPRES se calcule sur les permanents (362 cadres sur 742 en 2024) ;\ncelui des temporaires se lit à part, avec le même filtre que T58.",
      "autoResize": true,
      "lineHeight": 1.25
    },
