      "text": "Les temporaires sans engagement",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Les temporaires sans engagement",
      "autoResize": true,
