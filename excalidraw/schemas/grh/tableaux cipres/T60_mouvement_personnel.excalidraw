      "versionNonce": 699281623,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794159115846,
      "link": null,
      "locked": false,
      "text": "Une ligne par exercice, des quatre années d'avant à l'année choisie. Une\ncolonne de contrôle vérifie début + entrées − sorties − fin = 0. Par\ndirection, agence ou bureau, la fin se lit dans T58 : une mutation n'est\nni une entrée ni une sortie.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Une ligne par exercice, des quatre années d'avant à l'année choisie. Une\ncolonne de contrôle vérifie début + entrées − sorties − fin = 0. Par\ndirection, agence ou bureau, la fin se lit dans T58 : une mutation n'est\nni une entrée ni une sortie.",
      "autoResize": true,
      "lineHeight": 1.25
    },
