    {
      "id": "9xNO7aHAFndd9x3ZcF4j",
      "type": "text",
      "x": 2074.44,
      "y": 2983.5,
      "width": 436.15999999999997,
      "height": 280.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
