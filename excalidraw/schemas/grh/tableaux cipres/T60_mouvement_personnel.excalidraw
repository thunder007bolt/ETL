      "text": "Règle 1 en SQL",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Règle 1 en SQL",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "bwltAH6IyVCk0LfQRa9L",
      "type": "text",
      "x": 779.44,
      "y": 2869.0,
      "width": 482.55999999999995,
      "height": 820.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "ejkEa1pPi9mKeXGtBf2B"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 451996289,
      "version": 1,
      "versionNonce": 1819048653,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793576376563,
      "link": null,
      "locked": false,
      "text": "-- les permanents présents au 31/12/2023\n-- et au 31/12/2024 : la règle 2 de T58,\n-- aux deux dates, réutilisée ensuite\nWITH fins AS (\n  SELECT DATE '2023-12-31' AS fin FROM DUAL\n  UNION ALL\n  SELECT DATE '2024-12-31' FROM DUAL),\npermanents AS (\n  SELECT EXTRACT(YEAR FROM f.fin) AS annee,\n         p.PERS_ID, p.DATE_EMBAUCHE,\n         p.DATE_PRISE_SERVICE\n  FROM   fins f\n  CROSS  JOIN USER_GRH.GRH_PERSONNE p\n  JOIN   USER_GRH.GRH_SITUATION s\n         ON s.PERS_ID = p.PERS_ID\n  WHERE  p.QUALITE = 'A'\n  AND    s.NATURE_EMPLOIE = 'PERMANENT'\n  AND    s.DATE_DEBUT = (\n           SELECT MAX(x.DATE_DEBUT)\n           FROM   USER_GRH.GRH_SITUATION x\n           WHERE  x.PERS_ID = p.PERS_ID\n           AND    x.DATE_DEBUT <= f.fin)\n  AND    NVL(p.DATE_EMBAUCHE,\n             p.DATE_PRISE_SERVICE) <= f.fin\n  AND   (p.ETAT_EMPLOYE = 'ACTIF'\n         OR (SELECT MIN(d.DATE_VIGUEUR)\n             FROM   USER_GRH.GRH_DECISION d\n             WHERE  d.PERS_ID = p.PERS_ID\n             AND    d.CDEC_CODE IN\n                    ('02','34','35','36','52','54'))\n            > f.fin)),\npermanents_2023 AS (\n  SELECT * FROM permanents WHERE annee = 2023),\npermanents_2024 AS (\n  SELECT * FROM permanents WHERE annee = 2024)\nSELECT annee, COUNT(*)\nFROM   permanents\nGROUP  BY annee\n-- 2023 (début de 2024) : 672 ; 2024 : 742\n-- (l'annuaire : 767 et 758 ; l'écart du\n-- début vient des 84 engagés de 2019)",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-- les permanents présents au 31/12/2023\n-- et au 31/12/2024 : la règle 2 de T58,\n-- aux deux dates, réutilisée ensuite\nWITH fins AS (\n  SELECT DATE '2023-12-31' AS fin FROM DUAL\n  UNION ALL\n  SELECT DATE '2024-12-31' FROM DUAL),\npermanents AS (\n  SELECT EXTRACT(YEAR FROM f.fin) AS annee,\n         p.PERS_ID, p.DATE_EMBAUCHE,\n         p.DATE_PRISE_SERVICE\n  FROM   fins f\n  CROSS  JOIN USER_GRH.GRH_PERSONNE p\n  JOIN   USER_GRH.GRH_SITUATION s\n         ON s.PERS_ID = p.PERS_ID\n  WHERE  p.QUALITE = 'A'\n  AND    s.NATURE_EMPLOIE = 'PERMANENT'\n  AND    s.DATE_DEBUT = (\n           SELECT MAX(x.DATE_DEBUT)\n           FROM   USER_GRH.GRH_SITUATION x\n           WHERE  x.PERS_ID = p.PERS_ID\n           AND    x.DATE_DEBUT <= f.fin)\n  AND    NVL(p.DATE_EMBAUCHE,\n             p.DATE_PRISE_SERVICE) <= f.fin\n  AND   (p.ETAT_EMPLOYE = 'ACTIF'\n         OR (SELECT MIN(d.DATE_VIGUEUR)\n             FROM   USER_GRH.GRH_DECISION d\n             WHERE  d.PERS_ID = p.PERS_ID\n             AND    d.CDEC_CODE IN\n                    ('02','34','35','36','52','54'))\n            > f.fin)),\npermanents_2023 AS (\n  SELECT * FROM permanents WHERE annee = 2023),\npermanents_2024 AS (\n  SELECT * FROM permanents WHERE annee = 2024)\nSELECT annee, COUNT(*)\nFROM   permanents\nGROUP  BY annee\n-- 2023 (début de 2024) : 672 ; 2024 : 742\n-- (l'annuaire : 767 et 758 ; l'écart du\n-- début vient des 84 engagés de 2019)",
      "autoResize": true,
      "lineHeight": 1.25
    },
