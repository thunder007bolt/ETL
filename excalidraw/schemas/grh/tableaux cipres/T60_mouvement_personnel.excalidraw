    {
      "id": "IJROOTCcSN4FUATo2hli",
      "type": "text",
      "x": 45,
      "y": 7526.5,
      "width": 1462.24,
      "height": 100.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "qPsDSJq2jrMlrmieJ76T"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 2135301876,
      "version": 1,
      "versionNonce": 6860636,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794159115846,
      "link": null,
      "locked": false,
      "text": "Les recrutements de 2024 retombent exactement sur l'annuaire de la CNSS (104) ; les retraites à 4 près par an ; les démissions exactement ; les licenciements à 1 près.\nLes mises en disponibilité (07) et les remises en activité (18) retombent à 1 à 3 près par an.\nL'effectif du début est sous l'annuaire de 84 agents de 2020 à 2023 : les engagés de 2019 sans date de départ.\nLa requête proposée a été rejouée sur des agents fictifs, un par cas, avec chaque réglage : chaque mouvement est celui attendu. Elle reste à exécuter sur la base.\nLa requête DTM actuelle lit une table sans recrutements ni départs : elle ne peut pas servir.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Les recrutements de 2024 retombent exactement sur l'annuaire de la CNSS (104) ; les retraites à 4 près par an ; les démissions exactement ; les licenciements à 1 près.\nLes mises en disponibilité (07) et les remises en activité (18) retombent à 1 à 3 près par an.\nL'effectif du début est sous l'annuaire de 84 agents de 2020 à 2023 : les engagés de 2019 sans date de départ.\nLa requête proposée a été rejouée sur des agents fictifs, un par cas, avec chaque réglage : chaque mouvement est celui attendu. Elle reste à exécuter sur la base.\nLa requête DTM actuelle lit une table sans recrutements ni départs : elle ne peut pas servir.",
      "autoResize": true,
      "lineHeight": 1.25
    }
  ],
