      "text": "-- même liste sorties_2024 (règle 5) ;\n-- 34 : liquidation des droits après décès\nSELECT COUNT(*) FROM sorties_2024\nWHERE  CDEC_CODE = '34'\n-- 2024 : 5 (l'annuaire : 3 décès)\n-- GRH_PERSONNE.DATE_DECES est vide pour\n-- tous les décès depuis 2010",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-- même liste sorties_2024 (règle 5) ;\n-- 34 : liquidation des droits après décès\nSELECT COUNT(*) FROM sorties_2024\nWHERE  CDEC_CODE = '34'\n-- 2024 : 5 (l'annuaire : 3 décès)\n-- GRH_PERSONNE.DATE_DECES est vide pour\n-- tous les décès depuis 2010",
      "autoResize": true,
      "lineHeight": 1.25
