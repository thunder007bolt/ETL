    {
      "id": "zp61YlBzOSxwckLaP7YH",
      "type": "text",
      "x": 2074.44,
      "y": 2869.0,
      "width": 436.15999999999997,
      "height": 260.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "RSYPxDLxSNctYu0vsZEd"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 134846318,
      "version": 1,
      "versionNonce": 1509021398,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793576376563,
      "link": null,
      "locked": false,
      "text": "-- entrée : dans la liste de fin, pas\n-- dans celle du début ; sortie : l'inverse\nSELECT\n  (SELECT COUNT(*) FROM permanents_2024\n   WHERE  PERS_ID NOT IN\n          (SELECT PERS_ID\n           FROM   permanents_2023)) AS entrees,\n  (SELECT COUNT(*) FROM permanents_2023\n   WHERE  PERS_ID NOT IN\n          (SELECT PERS_ID\n           FROM   permanents_2024)) AS sorties\nFROM   DUAL\n-- 2024 : entrées − sorties = 742 − 672 = 70",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-- entrée : dans la liste de fin, pas\n-- dans celle du début ; sortie : l'inverse\nSELECT\n  (SELECT COUNT(*) FROM permanents_2024\n   WHERE  PERS_ID NOT IN\n          (SELECT PERS_ID\n           FROM   permanents_2023)) AS entrees,\n  (SELECT COUNT(*) FROM permanents_2023\n   WHERE  PERS_ID NOT IN\n          (SELECT PERS_ID\n           FROM   permanents_2024)) AS sorties\nFROM   DUAL\n-- 2024 : entrées − sorties = 742 − 672 = 70",
      "autoResize": true,
      "lineHeight": 1.25
    },
