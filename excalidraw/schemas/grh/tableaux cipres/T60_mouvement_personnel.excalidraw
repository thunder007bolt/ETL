    {
      "id": "wXMdFoA0G4p2gWflfckb",
      "type": "text",
      "x": 2074.44,
      "y": 3967.5,
      "width": 417.59999999999997,
      "height": 300.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "MYp48kU41c5UsmaFllKY"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 400788065,
      "version": 1,
      "versionNonce": 603096718,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794159115846,
      "link": null,
      "locked": false,
      "text": "-- les entrées sans embauche en 2024\nSELECT COUNT(*)\nFROM   permanents_2024\nWHERE  PERS_ID NOT IN\n       (SELECT PERS_ID FROM permanents_2023)\nAND    NVL(DATE_EMBAUCHE, DATE_PRISE_SERVICE)\n         < DATE '2024-01-01'\n-- 2024 : 0 attendu (l'annuaire : 7)\n-- à part : les remises en activité (18)\nSELECT COUNT(DISTINCT PERS_ID)\nFROM   USER_GRH.GRH_DECISION\nWHERE  CDEC_CODE = '18'\nAND    DATE_VIGUEUR BETWEEN DATE '2024-01-01'\n                        AND DATE '2024-12-31'\n-- 2024 : 4 décisions 18 (6 remises publiées)",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-- les entrées sans embauche en 2024\nSELECT COUNT(*)\nFROM   permanents_2024\nWHERE  PERS_ID NOT IN\n       (SELECT PERS_ID FROM permanents_2023)\nAND    NVL(DATE_EMBAUCHE, DATE_PRISE_SERVICE)\n         < DATE '2024-01-01'\n-- 2024 : 0 attendu (l'annuaire : 7)\n-- à part : les remises en activité (18)\nSELECT COUNT(DISTINCT PERS_ID)\nFROM   USER_GRH.GRH_DECISION\nWHERE  CDEC_CODE = '18'\nAND    DATE_VIGUEUR BETWEEN DATE '2024-01-01'\n                        AND DATE '2024-12-31'\n-- 2024 : 4 décisions 18 (6 remises publiées)",
      "autoResize": true,
      "lineHeight": 1.25
    },
