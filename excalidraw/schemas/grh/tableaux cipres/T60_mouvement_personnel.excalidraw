      "boundElements": [],
      "updated": 1794159115846,
      "link": null,
      "locked": false,
      "text": "Dans cet ordre : un agent classé comme détaché (décision 37) ; un agent\nrevenu de disponibilité (décision 18), si la disponibilité sort de\nl'effectif ; un agent qui était dans l'autre nature au 31 décembre\nd'avant, comme un temporaire devenu permanent ; sinon, une entrée sans\nexplication, à vérifier.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Dans cet ordre : un agent classé comme détaché (décision 37) ; un agent\nrevenu de disponibilité (décision 18), si la disponibilité sort de\nl'effectif ; un agent qui était dans l'autre nature au 31 décembre\nd'avant, comme un temporaire devenu permanent ; sinon, une entrée sans\nexplication, à vérifier.",
      "autoResize": true,
      "lineHeight": 1.25
    },
