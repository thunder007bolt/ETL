    {
      "id": "UbCIE3KX3DOiwKwQRese",
      "type": "text",
      "x": 2074.44,
      "y": 4963.0,
      "width": 399.03999999999996,
      "height": 260.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
