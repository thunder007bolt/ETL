    {
      "id": "PgcbJUffl2ySuJJyVXyI",
      "type": "text",
      "x": 45,
      "y": 136,
      "width": 334.40000000000003,
      "height": 27.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
