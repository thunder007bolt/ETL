      "link": null,
      "locked": false,
      "text": "Un agent muté d'une agence à une autre n'est ni une entrée ni une sortie de la\nCNSS. Pour une direction ou une agence, faut-il montrer ses arrivées et ses\ndéparts par mutation ?",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Un agent muté d'une agence à une autre n'est ni une entrée ni une sortie de la\nCNSS. Pour une direction ou une agence, faut-il montrer ses arrivées et ses\ndéparts par mutation ?",
      "autoResize": true,
      "lineHeight": 1.25
