      "boundElements": [],
      "updated": 1793576376563,
      "link": null,
      "locked": false,
      "text": "Il suit le personnel permanent d'une année à l'autre : combien au début,\ncombien sont entrés (recrutés ou revenus), combien sont sortis (retraite,\ndécès, autres), combien à la fin. Cinq années côte à côte montrent les\nvagues de recrutement et de départs.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Il suit le personnel permanent d'une année à l'autre : combien au début,\ncombien sont entrés (recrutés ou revenus), combien sont sortis (retraite,\ndécès, autres), combien à la fin. Cinq années côte à côte montrent les\nvagues de recrutement et de départs.",
      "autoResize": true,
      "lineHeight": 1.25
    },
