      "text": "Départs à la retraite, de 2020 à 2024 :",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Départs à la retraite, de 2020 à 2024 :",
      "autoResize": true,
      "lineHeight": 1.25
