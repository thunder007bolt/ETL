    },
    {
      "id": "w0yy4HCsx0MUkEMgnYVT",
      "type": "text",
      "x": 25,
      "y": 2737.5,
      "width": 2547.36,
      "height": 67.5,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1679067311,
      "version": 1,
      "versionNonce": 1672446432,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793576376563,
      "link": null,
      "locked": false,
      "text": "À droite de chaque règle, une requête courte sur les vraies tables de l'application (schéma USER_GRH), pour l'année 2024, à copier dans SQL Developer. La règle 1 construit les permanents présents au 31/12/2023 et au 31/12/2024 (la règle 2 de la fiche\nT58, aux deux dates) : les listes permanents_2023 et permanents_2024. La règle 5 y ajoute la liste sorties_2024, que les règles 6 et 7 réutilisent. Pour les autres règles, on colle leur requête sous ce WITH, à la place de sa dernière requête. Le commentaire\nen fin de requête donne le chiffre à retrouver. La requête complète, sur les copies de l'entrepôt, est dans analyses/grh/t60_requete_proposee.sql.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "À droite de chaque règle, une requête courte sur les vraies tables de l'application (schéma USER_GRH), pour l'année 2024, à copier dans SQL Developer. La règle 1 construit les permanents présents au 31/12/2023 et au 31/12/2024 (la règle 2 de la fiche\nT58, aux deux dates) : les listes permanents_2023 et permanents_2024. La règle 5 y ajoute la liste sorties_2024, que les règles 6 et 7 réutilisent. Pour les autres règles, on colle leur requête sous ce WITH, à la place de sa dernière requête. Le commentaire\nen fin de requête donne le chiffre à retrouver. La requête complète, sur les copies de l'entrepôt, est dans analyses/grh/t60_requete_proposee.sql.",
      "autoResize": true,
      "lineHeight": 1.25
    },
