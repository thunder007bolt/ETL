    {
      "id": "Xnh4AoPzamtk1dF6eMo4",
      "type": "text",
      "x": 779.44,
      "y": 5507.0,
      "width": 417.59999999999997,
      "height": 300.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "DAz0XgJncboTO9xc0Zpg"
