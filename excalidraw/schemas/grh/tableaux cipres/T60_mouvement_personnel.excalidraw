      "seed": 1329183087,
      "version": 1,
      "versionNonce": 960674307,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794159115846,
      "link": null,
      "locked": false,
      "text": "-- entrée : dans la liste de fin, pas\n-- dans celle du début ; sortie : l'inverse\nSELECT\n  (SELECT COUNT(*) FROM permanents_2024\n   WHERE  PERS_ID NOT IN\n          (SELECT PERS_ID\n           FROM   permanents_2023)) AS entrees,\n  (SELECT COUNT(*) FROM permanents_2023\n   WHERE  PERS_ID NOT IN\n          (SELECT PERS_ID\n           FROM   permanents_2024)) AS sorties\nFROM   DUAL\n-- 2024 : 104 entrées et 34 sorties ;\n-- 104 − 34 = 747 − 677 = 70",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-- entrée : dans la liste de fin, pas\n-- dans celle du début ; sortie : l'inverse\nSELECT\n  (SELECT COUNT(*) FROM permanents_2024\n   WHERE  PERS_ID NOT IN\n          (SELECT PERS_ID\n           FROM   permanents_2023)) AS entrees,\n  (SELECT COUNT(*) FROM permanents_2023\n   WHERE  PERS_ID NOT IN\n          (SELECT PERS_ID\n           FROM   permanents_2024)) AS sorties\nFROM   DUAL\n-- 2024 : 104 entrées et 34 sorties ;\n-- 104 − 34 = 747 − 677 = 70",
      "autoResize": true,
      "lineHeight": 1.25
    },
