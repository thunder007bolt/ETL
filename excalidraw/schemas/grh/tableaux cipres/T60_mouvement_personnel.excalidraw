      "updated": 1793576376563,
      "link": null,
      "locked": false,
      "text": "Comment valider cette fiche",
      "fontSize": 22,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Comment valider cette fiche",
      "autoResize": true,
