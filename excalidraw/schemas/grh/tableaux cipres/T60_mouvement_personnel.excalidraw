      "seed": 448259121,
      "version": 1,
      "versionNonce": 350947308,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794159115846,
      "link": null,
      "locked": false,
      "text": "Une sortie dont le premier départ, dans l'année, est l'admission à la\nretraite (décision 02), à sa date de vigueur. Une retraite suivie d'un\ndécès la même année reste une retraite.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Une sortie dont le premier départ, dans l'année, est l'admission à la\nretraite (décision 02), à sa date de vigueur. Une retraite suivie d'un\ndécès la même année reste une retraite.",
      "autoResize": true,
      "lineHeight": 1.25
    },
