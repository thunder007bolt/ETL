      "seed": 168369443,
      "version": 1,
      "versionNonce": 1672706180,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794159115846,
      "link": null,
      "locked": false,
      "text": "Chaque autre entrée et chaque autre sortie porte un type de mouvement\nde la liste de l'application GRH : remise en activité, détaché ;\ndémission, licenciement, disponibilité, mise à disposition, fin de\ndétachement, fin de contrat, autres. Une raison s'y ajoute : la décision\nqui a servi, ou le changement de nature.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Chaque autre entrée et chaque autre sortie porte un type de mouvement\nde la liste de l'application GRH : remise en activité, détaché ;\ndémission, licenciement, disponibilité, mise à disposition, fin de\ndétachement, fin de contrat, autres. Une raison s'y ajoute : la décision\nqui a servi, ou le changement de nature.",
      "autoResize": true,
      "lineHeight": 1.25
    },
