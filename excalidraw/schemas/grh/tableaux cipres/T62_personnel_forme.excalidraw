    },
    {
      "id": "chB6B06c4QLHDEvPi2Ev",
      "type": "text",
      "x": 25,
      "y": 2661.5,
      "width": 2504.5200000000004,
      "height": 45.0,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 884260320,
      "version": 1,
      "versionNonce": 1268895393,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793576376650,
      "link": null,
      "locked": false,
      "text": "À droite de chaque règle, une requête courte sur les vraies tables de l'application (schéma USER_GRH), pour l'année 2024, à copier dans SQL Developer. La règle 4 construit la liste des inscriptions de 2024 des agents permanents (formes_2024) ; pour les\nrègles 5 à 8, on colle leur requête sous celle de la règle 4, à la place de sa dernière ligne. Le commentaire en fin de requête donne le chiffre à retrouver. La requête complète, sur les copies de l'entrepôt, est dans analyses/grh/t62_requete_proposee.sql.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "À droite de chaque règle, une requête courte sur les vraies tables de l'application (schéma USER_GRH), pour l'année 2024, à copier dans SQL Developer. La règle 4 construit la liste des inscriptions de 2024 des agents permanents (formes_2024) ; pour les\nrègles 5 à 8, on colle leur requête sous celle de la règle 4, à la place de sa dernière ligne. Le commentaire en fin de requête donne le chiffre à retrouver. La requête complète, sur les copies de l'entrepôt, est dans analyses/grh/t62_requete_proposee.sql.",
      "autoResize": true,
      "lineHeight": 1.25
    },
