      "link": null,
      "locked": false,
      "text": "-- avec promotion : le classement a changé\n-- sur une inscription de l'année ; vide\n-- d'un côté : pas compté\nSELECT COUNT(DISTINCT PERS_ID)\nFROM   formes_2024\nWHERE  CLA_APRES <> CLA_AVANT\n-- 2024 : 2 (l'annuaire : 6 promotions) ;\n-- les autres formés sont sans promotion",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-- avec promotion : le classement a changé\n-- sur une inscription de l'année ; vide\n-- d'un côté : pas compté\nSELECT COUNT(DISTINCT PERS_ID)\nFROM   formes_2024\nWHERE  CLA_APRES <> CLA_AVANT\n-- 2024 : 2 (l'annuaire : 6 promotions) ;\n-- les autres formés sont sans promotion",
      "autoResize": true,
      "lineHeight": 1.25
    },
