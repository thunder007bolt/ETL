      "boundElements": [],
      "updated": 1793572700822,
      "link": null,
      "locked": false,
      "text": "84 agents engagés en 2019 n'ont aucune date de départ dans la base. L'annuaire les\ncompte jusqu'en 2023. Que sont-ils devenus, et quand sont-ils partis ?",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "84 agents engagés en 2019 n'ont aucune date de départ dans la base. L'annuaire les\ncompte jusqu'en 2023. Que sont-ils devenus, et quand sont-ils partis ?",
