    },
    {
      "id": "TzJLfIzGDfOwdca7WyCe",
      "type": "text",
      "x": 25,
      "y": 2948.0,
      "width": 2539.44,
      "height": 67.5,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1686700240,
      "version": 1,
      "versionNonce": 914427,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793572700822,
      "link": null,
      "locked": false,
      "text": "À droite de chaque règle, une requête courte sur les vraies tables de l'application (schéma USER_GRH), pour l'année 2024, à copier dans SQL Developer. La règle 2 construit la liste des permanents présents au 31/12/2024 (permanents_2024) ; pour les règles\n3, 4, 5, 7, 8 et 9, on colle leur requête sous celle de la règle 2, à la place de sa dernière ligne. Le commentaire en fin de requête donne le chiffre à retrouver. La requête complète, sur les copies de l'entrepôt, est dans\nanalyses/grh/t58_t65_effectif_requete_proposee.sql.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "À droite de chaque règle, une requête courte sur les vraies tables de l'application (schéma USER_GRH), pour l'année 2024, à copier dans SQL Developer. La règle 2 construit la liste des permanents présents au 31/12/2024 (permanents_2024) ; pour les règles\n3, 4, 5, 7, 8 et 9, on colle leur requête sous celle de la règle 2, à la place de sa dernière ligne. Le commentaire en fin de requête donne le chiffre à retrouver. La requête complète, sur les copies de l'entrepôt, est dans\nanalyses/grh/t58_t65_effectif_requete_proposee.sql.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "TEQirAbvsScn9lRfAWZ9",
      "type": "rectangle",
      "x": 25.0,
      "y": 3035.5,
      "width": 720.44,
      "height": 724.0,
      "angle": 0,
      "strokeColor": "#868e96",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
