    {
      "id": "eCynH0fqmtdgGSdUfOrh",
      "type": "text",
      "x": 45,
      "y": 529,
      "width": 709.9200000000001,
      "height": 112.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
