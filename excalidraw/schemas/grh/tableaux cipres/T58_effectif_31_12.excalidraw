    {
      "id": "TH4m283KHh5B40VKaINV",
      "type": "text",
      "x": 779.44,
      "y": 5568.5,
      "width": 399.03999999999996,
      "height": 160.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
