      "type": "text",
      "x": 911.6666666666666,
      "y": 3597.5,
      "width": 761.04,
      "height": 90.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
