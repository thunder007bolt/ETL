      "seed": 1901503231,
      "version": 1,
      "versionNonce": 112141020,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793638677451,
      "link": null,
      "locked": false,
      "text": "La catégorie CIPRES d'un agent (T58, T62, T65) se lit dans la catégorie de\nsa situation (GRH_SITUATION.CATEGORIE) : 01 et 02 employés, 03 agents\nde maîtrise, 04 et 05 cadres moyens, 06 cadres supérieurs. Plus le niveau de\nla qualification.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "La catégorie CIPRES d'un agent (T58, T62, T65) se lit dans la catégorie de\nsa situation (GRH_SITUATION.CATEGORIE) : 01 et 02 employés, 03 agents\nde maîtrise, 04 et 05 cadres moyens, 06 cadres supérieurs. Plus le niveau de\nla qualification.",
      "autoResize": true,
      "lineHeight": 1.25
    },
