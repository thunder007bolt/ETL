      "link": null,
      "locked": false,
      "text": "C'est la seule définition qui retombe sur l'annuaire de la CNSS : +0,7 %\nd'allocataires en 2024, contre +5 % sans le paiement (lot 6, P79).",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "C'est la seule définition qui retombe sur l'annuaire de la CNSS : +0,7 %\nd'allocataires en 2024, contre +5 % sans le paiement (lot 6, P79).",
      "autoResize": true,
      "lineHeight": 1.25
    },
