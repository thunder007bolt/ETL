      "isDeleted": false,
      "boundElements": [],
      "updated": 1793638677451,
      "link": null,
      "locked": false,
      "text": "Un enfant d'allocataire compte au 31/12 s'il a droit (en cours, 21 ans au\nplus) et a été payé dans l'année ; l'allocataire est le dossier qui a au moins\nun enfant compté.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Un enfant d'allocataire compte au 31/12 s'il a droit (en cours, 21 ans au\nplus) et a été payé dans l'année ; l'allocataire est le dossier qui a au moins\nun enfant compté.",
      "autoResize": true,
      "lineHeight": 1.25
    },
