    {
      "id": "NBqs0GpLiMZsQSoLD087",
      "type": "text",
      "x": 911.6666666666666,
      "y": 581.5,
      "width": 755.6400000000001,
      "height": 202.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
