    {
      "id": "eQgPNgNOyalrHDU5yu9K",
      "type": "text",
      "x": 695.0,
      "y": 2734.0,
      "width": 528.12,
      "height": 112.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
