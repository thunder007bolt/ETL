    {
      "id": "uGjsJ6GCHVuItWXSCXBu",
      "type": "text",
      "x": 45.0,
      "y": 2801.5,
      "width": 528.12,
      "height": 112.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
