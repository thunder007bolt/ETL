    {
      "id": "1fDUnudj2nIfDUEYQ7Lo",
      "type": "text",
      "x": 45.0,
      "y": 711.5,
      "width": 762.1200000000001,
      "height": 180.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "Yenn2Zl5WsnPM9PGPB4V"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 71475500,
      "version": 1,
      "versionNonce": 654729087,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794236057442,
      "link": null,
      "locked": false,
      "text": "Famille 3 (T42 à T49) : lot 7 exécuté, fiche pilote T42. Famille 4 (T50 à\nT57) : lot 8 exécuté, fiche pilote faite. T31 : lot 9 exécuté (indus 0,39 %),\nfiche faite. Restent T28 à T30 (DSI). R4 posée au point du 02/11. Le 08/11\n: le domaine refait à l'image du GRH, sans toucher à l'existant : cinq\ndocuments de famille, la liste du recueil v7 (130 lignes, 108 questions) et\nl'annuaire CNSS 2024 face à T25-T57 ; à relire, puis à reporter. Le 09/11 :\nla fiche des points à valider mise à jour (137 points, dont 8 à trancher en\npriorité).",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Famille 3 (T42 à T49) : lot 7 exécuté, fiche pilote T42. Famille 4 (T50 à\nT57) : lot 8 exécuté, fiche pilote faite. T31 : lot 9 exécuté (indus 0,39 %),\nfiche faite. Restent T28 à T30 (DSI). R4 posée au point du 02/11. Le 08/11\n: le domaine refait à l'image du GRH, sans toucher à l'existant : cinq\ndocuments de famille, la liste du recueil v7 (130 lignes, 108 questions) et\nl'annuaire CNSS 2024 face à T25-T57 ; à relire, puis à reporter. Le 09/11 :\nla fiche des points à valider mise à jour (137 points, dont 8 à trancher en\npriorité).",
      "autoResize": true,
      "lineHeight": 1.25
    },
