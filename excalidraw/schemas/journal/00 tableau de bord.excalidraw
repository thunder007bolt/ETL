    {
      "id": "ShqYe4mNCDvjrQI5dhOo",
      "type": "text",
      "x": 45,
      "y": 183.5,
      "width": 1682.2,
      "height": 50.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
