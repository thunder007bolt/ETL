    {
      "id": "V57i8ZtPTNBHeQr1uBnq",
      "type": "text",
      "x": 45,
      "y": 183.5,
      "width": 1656.8000000000002,
      "height": 75.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
