    {
      "id": "ZJTyTqVCCjERxoHKQfsj",
      "type": "text",
      "x": 911.6666666666666,
      "y": 1413.5,
      "width": 763.74,
      "height": 45.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
