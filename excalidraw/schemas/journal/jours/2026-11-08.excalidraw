    },
    {
      "id": "7oJ8iNsXxPS70k3v8vrf",
      "type": "text",
      "x": 45.0,
      "y": 3324.5,
      "width": 762.1200000000001,
      "height": 202.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "Gpp4d8iBwUk7ywj7YFJU"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1976667469,
      "version": 1,
      "versionNonce": 847519360,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794218311239,
      "link": null,
      "locked": false,
      "text": "Recueil v7 : 102 demandes sur les prestations (130 lignes) : 34 prises en\ncompte, 57 à intégrer, 28 questions, 10 hors base, 1 hors BI ; T26, T39, T40\net T56 n'y ont aucune ligne. L'annuaire CNSS 2024 confirme le comptage au\n31/12, l'âge des orphelins, D4, R1 et A1 ; il tranche la saisie pour les\nnouveaux pensionnés, la coordination, la retraite anticipée à part et le rachat\nde rente ; il contredit seulement la fiche T27 (frais médicaux de maternité\npayés). Il ne publie ni dépôts, ni instance, ni délais, ni contrôles, ni indus.\nÉcarts : paiements AT/MP (−20 %), veuves (−5 %), orphelins (−16 %). 108\nquestions, aucune bloquante.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Recueil v7 : 102 demandes sur les prestations (130 lignes) : 34 prises en\ncompte, 57 à intégrer, 28 questions, 10 hors base, 1 hors BI ; T26, T39, T40\net T56 n'y ont aucune ligne. L'annuaire CNSS 2024 confirme le comptage au\n31/12, l'âge des orphelins, D4, R1 et A1 ; il tranche la saisie pour les\nnouveaux pensionnés, la coordination, la retraite anticipée à part et le rachat\nde rente ; il contredit seulement la fiche T27 (frais médicaux de maternité\npayés). Il ne publie ni dépôts, ni instance, ni délais, ni contrôles, ni indus.\nÉcarts : paiements AT/MP (−20 %), veuves (−5 %), orphelins (−16 %). 108\nquestions, aucune bloquante.",
      "autoResize": true,
      "lineHeight": 1.25
    },
