      "type": "text",
      "x": 1778.3333333333333,
      "y": 1523.5,
      "width": 762.3000000000001,
      "height": 157.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
