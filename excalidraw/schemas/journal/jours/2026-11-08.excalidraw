      "versionNonce": 1197296428,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794161659973,
      "link": null,
      "locked": false,
      "text": "Proposition BI : la requête reprend ces codes ; la disponibilité suit le\nréglage de l'effectif (PRESENT) ; un agent entré et sorti dans l'année n'est\npas compté (Q4 de la fiche T60) ; les mouvements internes restent lus comme\navant.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Proposition BI : la requête reprend ces codes ; la disponibilité suit le\nréglage de l'effectif (PRESENT) ; un agent entré et sorti dans l'année n'est\npas compté (Q4 de la fiche T60) ; les mouvements internes restent lus comme\navant.",
      "autoResize": true,
      "lineHeight": 1.25
    },
