    {
      "id": "COowiTMIGFEB1IfGpmQZ",
      "type": "text",
      "x": 911.6666666666666,
      "y": 2196.5,
      "width": 733.6800000000001,
      "height": 45.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
