      "type": "text",
      "x": 45.0,
      "y": 2952.0,
      "width": 749.52,
      "height": 90.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "Gpp4d8iBwUk7ywj7YFJU"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1895899827,
      "version": 1,
      "versionNonce": 84505398,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794218311239,
      "link": null,
      "locked": false,
      "text": "Refaire pour les prestations (T25 à T57) le travail fait pour la GRH :\nd'abord toutes les demandes du recueil v7, puis l'annuaire CNSS 2024 pour\nvalider ou contredire, des règles claires et les points ouverts ; sans toucher\nau travail déjà fait.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Refaire pour les prestations (T25 à T57) le travail fait pour la GRH :\nd'abord toutes les demandes du recueil v7, puis l'annuaire CNSS 2024 pour\nvalider ou contredire, des règles claires et les points ouverts ; sans toucher\nau travail déjà fait.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "a9F18BhVCxKiP3FX4Rm9",
      "type": "text",
      "x": 45.0,
      "y": 3058.0,
      "width": 146.24,
      "height": 20.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "Gpp4d8iBwUk7ywj7YFJU"
      ],
