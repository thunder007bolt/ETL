    {
      "id": "qQgh1TEItVE1vPVIhzke",
      "type": "text",
      "x": 45.0,
      "y": 895.5,
      "width": 763.92,
      "height": 135.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "dy2Nz13LBENRYHgtVdVg"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1043782723,
      "version": 1,
      "versionNonce": 2030441799,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794135470363,
      "link": null,
      "locked": false,
      "text": "La table des types de mouvement de la CNSS (GRH_TYPE_MOUVEMENT) a déjà\nle détail des « autres » : remise en activité, détaché ; licenciement,\ndémission, disponibilité, mise à disposition, fin de détachement, fin de\ncontrat. Le tableau 121 de l'annuaire CNSS 2024 détaille de la même façon.\nPar unité, début + entrées − sorties ne donne pas la fin à cause des mutations\n: la fin d'une unité se lit dans T58.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "La table des types de mouvement de la CNSS (GRH_TYPE_MOUVEMENT) a déjà\nle détail des « autres » : remise en activité, détaché ; licenciement,\ndémission, disponibilité, mise à disposition, fin de détachement, fin de\ncontrat. Le tableau 121 de l'annuaire CNSS 2024 détaille de la même façon.\nPar unité, début + entrées − sorties ne donne pas la fin à cause des mutations\n: la fin d'une unité se lit dans T58.",
      "autoResize": true,
      "lineHeight": 1.25
    },
