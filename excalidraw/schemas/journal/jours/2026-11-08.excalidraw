      "isDeleted": false,
      "boundElements": [],
      "updated": 1794163076919,
      "link": null,
      "locked": false,
      "text": "Fin 2024, environ 741 permanents (747 moins 6 en disponibilité) ; T60 2024\n: environ 672 · 104 · 4 · 25 · 5 · 9 · 741. Dans les six agents du pas à pas, D\nsort en 2023 et revient en 2025.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Fin 2024, environ 741 permanents (747 moins 6 en disponibilité) ; T60 2024\n: environ 672 · 104 · 4 · 25 · 5 · 9 · 741. Dans les six agents du pas à pas, D\nsort en 2023 et revient en 2025.",
      "autoResize": true,
      "lineHeight": 1.25
    },
