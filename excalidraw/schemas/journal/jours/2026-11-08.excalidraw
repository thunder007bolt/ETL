    {
      "id": "v6j34XsmYcglvJSPJ6A7",
      "type": "text",
      "x": 911.6666666666666,
      "y": 2281.5,
      "width": 763.74,
      "height": 157.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "uZwqXlCBjuxovxxeAmg5"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 997786875,
      "version": 1,
      "versionNonce": 1405205970,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794163076919,
      "link": null,
      "locked": false,
      "text": "Cause : le constructeur met l'heure de génération sur chaque élément ; chaque\ngénération donnait donc un fichier différent, même pour un dessin identique,\net une version de plus pour chacune des 23 fiches du journal (je lançais en\nplus la génération deux fois). Correction : write_with_history et\nDiagram.save comparent les dessins sans l'heure ; un schéma inchangé n'est ni\nréécrit ni versionné, et les générateurs l'affichent « inchangé ». Vérifié : 23\nfiches inchangées, aucune nouvelle version.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Cause : le constructeur met l'heure de génération sur chaque élément ; chaque\ngénération donnait donc un fichier différent, même pour un dessin identique,\net une version de plus pour chacune des 23 fiches du journal (je lançais en\nplus la génération deux fois). Correction : write_with_history et\nDiagram.save comparent les dessins sans l'heure ; un schéma inchangé n'est ni\nréécrit ni versionné, et les générateurs l'affichent « inchangé ». Vérifié : 23\nfiches inchangées, aucune nouvelle version.",
      "autoResize": true,
      "lineHeight": 1.25
    },
