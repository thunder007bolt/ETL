      "isDeleted": false,
      "boundElements": [],
      "updated": 1794135470363,
      "link": null,
      "locked": false,
      "text": "Un schéma « requête du mouvement pas à pas », comme celui de l'effectif ; et\nregrouper les schémas de la GRH, en désordre.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Un schéma « requête du mouvement pas à pas », comme celui de l'effectif ; et\nregrouper les schémas de la GRH, en désordre.",
      "autoResize": true,
      "lineHeight": 1.25
    },
