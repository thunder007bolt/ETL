      "seed": 450198633,
      "version": 1,
      "versionNonce": 764533205,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794135470363,
      "link": null,
      "locked": false,
      "text": "Rendre paramétrable, dans T60, le traitement des disponibilités et des\nremises en activité, comme dans la CTE parametres de la requête de\nl'effectif.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Rendre paramétrable, dans T60, le traitement des disponibilités et des\nremises en activité, comme dans la CTE parametres de la requête de\nl'effectif.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
