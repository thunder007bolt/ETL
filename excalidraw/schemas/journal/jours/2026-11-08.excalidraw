    {
      "id": "Su25UX2EYuUQ3p0RPbuJ",
      "type": "text",
      "x": 911.6666666666666,
      "y": 1696.0,
      "width": 739.98,
      "height": 112.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "7aJZksCiyEf6uHysKUFh"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 974965441,
      "version": 1,
      "versionNonce": 1801013221,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794161659973,
      "link": null,
      "locked": false,
      "text": "Les 25 agents fictifs, un par cas, donnent chacun le mouvement affiché, pour\nles quatre combinaisons des réglages. Deux cas ajoutés pour expliquer les\nELSE : entré sans explication (AUTRE_ENT · SANS_MOTIF) et sorti sans\ndépart daté (AUTRE_SORT · SANS_MOTIF). Sans le NVL qui compare les\nnatures, l'agent sans situation ne bougerait jamais.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Les 25 agents fictifs, un par cas, donnent chacun le mouvement affiché, pour\nles quatre combinaisons des réglages. Deux cas ajoutés pour expliquer les\nELSE : entré sans explication (AUTRE_ENT · SANS_MOTIF) et sorti sans\ndépart daté (AUTRE_SORT · SANS_MOTIF). Sans le NVL qui compare les\nnatures, l'agent sans situation ne bougerait jamais.",
      "autoResize": true,
      "lineHeight": 1.25
    },
