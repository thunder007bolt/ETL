    {
      "id": "BO4lOdDXQO2wRZd4rYn4",
      "type": "text",
      "x": 1778.3333333333333,
      "y": 898.0,
      "width": 720.9000000000001,
      "height": 67.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "fSkc4wQX9IepAZqjpzAb"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1277199026,
      "version": 1,
      "versionNonce": 582412912,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794163076919,
      "link": null,
      "locked": false,
      "text": "Le schéma cas_agents_effectif porte trois annotations « A MIEUX\nECLAIRCIR » (fin de contrat puis réengagé, temporaire devenu permanent,\naucune fin de contrat saisie) : il n'a pas été régénéré.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Le schéma cas_agents_effectif porte trois annotations « A MIEUX\nECLAIRCIR » (fin de contrat puis réengagé, temporaire devenu permanent,\naucune fin de contrat saisie) : il n'a pas été régénéré.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "taNSGrJFPnMGajMCy2NW",
      "type": "text",
