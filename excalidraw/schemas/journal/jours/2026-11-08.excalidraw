    {
      "id": "8rfG2kyFPExi6Z7xjxBn",
      "type": "text",
      "x": 45,
      "y": 183.5,
      "width": 1287.2,
      "height": 75.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
