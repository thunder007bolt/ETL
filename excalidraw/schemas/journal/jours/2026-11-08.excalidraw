      "type": "text",
      "x": 45.0,
      "y": 1070.5,
      "width": 748.08,
      "height": 90.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
