      "seed": 2014337901,
      "version": 1,
      "versionNonce": 736392771,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794161659973,
      "link": null,
      "locked": false,
      "text": "La version technique des cas de mouvement de T60, reliée au SQL, comme celle\ndes cas d'agents de l'effectif.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "La version technique des cas de mouvement de T60, reliée au SQL, comme celle\ndes cas d'agents de l'effectif.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "2lwy6LQTa75XfK47hczq",
      "type": "text",
      "x": 911.6666666666666,
      "y": 1474.5,
      "width": 146.24,
      "height": 20.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "7aJZksCiyEf6uHysKUFh"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1199687463,
      "version": 1,
      "versionNonce": 365200731,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794161659973,
      "link": null,
      "locked": false,
      "text": "Ce qui a été fait",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Ce qui a été fait",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "l6mbiD2mYS2mh4KkCR6R",
      "type": "text",
      "x": 911.6666666666666,
      "y": 1498.5,
      "width": 762.48,
      "height": 157.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "7aJZksCiyEf6uHysKUFh"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 520404471,
      "version": 1,
      "versionNonce": 1334851710,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794161659973,
      "link": null,
      "locked": false,
      "text": "Schéma en sept parties : la requête en un coup d'œil (parties 0 à 14, CTE,\nlignes, grain, alias) ; le cœur (les deux photos, puis le WHERE et le CASE des\nentrées et des sorties, repères E1 à E8 et S1 à S7) ; 7 cas d'entrée, 8 de\nsortie et 8 sans mouvement, chacun avec ses lignes, le SQL qui décide et la\nraison ; le rangement (axes et mesures) ; le comptage final et les colonnes de\nT60 dans OBIEE. Les numéros de ligne sont lus dans le fichier SQL, et\nchaque bout de SQL est comparé au fichier à chaque génération.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Schéma en sept parties : la requête en un coup d'œil (parties 0 à 14, CTE,\nlignes, grain, alias) ; le cœur (les deux photos, puis le WHERE et le CASE des\nentrées et des sorties, repères E1 à E8 et S1 à S7) ; 7 cas d'entrée, 8 de\nsortie et 8 sans mouvement, chacun avec ses lignes, le SQL qui décide et la\nraison ; le rangement (axes et mesures) ; le comptage final et les colonnes de\nT60 dans OBIEE. Les numéros de ligne sont lus dans le fichier SQL, et\nchaque bout de SQL est comparé au fichier à chaque génération.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "bV8KmF6ZX9No1ElMbUSE",
      "type": "text",
      "x": 911.6666666666666,
      "y": 1672.0,
      "width": 145.60000000000002,
      "height": 20.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
