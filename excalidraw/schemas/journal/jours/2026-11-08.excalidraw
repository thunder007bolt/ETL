    },
    {
      "id": "RJBj7XseYc2uYDsVnWHR",
      "type": "text",
      "x": 45.0,
      "y": 3082.0,
      "width": 750.4200000000001,
      "height": 202.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "Gpp4d8iBwUk7ywj7YFJU"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 880828884,
      "version": 1,
      "versionNonce": 2092480939,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794218311239,
      "link": null,
      "locked": false,
      "text": "Un gabarit commun des schémas. L'analyse des sources (12 analyses\ncontre-vérifiées). Cinq documents de famille (T25-T27, le pilote, puis\nT28-T31, T32-T41, T42-T49, T50-T57), chacun avec son schéma et le même\nplan : en bref, le recueil v7 ligne par ligne avec son statut, les règles en\nclair et leurs sources, les cas, l'annuaire CNSS 2024, les réglages, les\nquestions, les points d'attention. La liste de toutes les demandes du recueil\nv7 et l'annuaire CNSS 2024 face à T25-T57. Chaque document relu (chiffres\nrecalculés), puis une critique d'ensemble a mis les sept d'accord. Affichage\ncontrôlé : aucun débordement.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Un gabarit commun des schémas. L'analyse des sources (12 analyses\ncontre-vérifiées). Cinq documents de famille (T25-T27, le pilote, puis\nT28-T31, T32-T41, T42-T49, T50-T57), chacun avec son schéma et le même\nplan : en bref, le recueil v7 ligne par ligne avec son statut, les règles en\nclair et leurs sources, les cas, l'annuaire CNSS 2024, les réglages, les\nquestions, les points d'attention. La liste de toutes les demandes du recueil\nv7 et l'annuaire CNSS 2024 face à T25-T57. Chaque document relu (chiffres\nrecalculés), puis une critique d'ensemble a mis les sept d'accord. Affichage\ncontrôlé : aucun débordement.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "RuIzSNRVBmdeV0lt3Law",
      "type": "text",
      "x": 45.0,
      "y": 3300.5,
