    {
      "id": "BO4lOdDXQO2wRZd4rYn4",
      "type": "text",
      "x": 1778.3333333333333,
      "y": 898.0,
      "width": 720.9000000000001,
      "height": 67.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "fSkc4wQX9IepAZqjpzAb"
      ],
