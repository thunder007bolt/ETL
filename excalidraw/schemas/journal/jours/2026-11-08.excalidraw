      "type": "text",
      "x": 1778.3333333333333,
      "y": 570.5,
      "width": 696.4200000000001,
      "height": 67.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
