      "roundness": null,
      "seed": 1277199026,
      "version": 1,
      "versionNonce": 582412912,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794135470363,
      "link": null,
      "locked": false,
      "text": "Le schéma cas_agents_effectif porte trois annotations « A MIEUX\nECLAIRCIR » (fin de contrat puis réengagé, temporaire devenu permanent,\naucune fin de contrat saisie) : il n'a pas été régénéré.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Le schéma cas_agents_effectif porte trois annotations « A MIEUX\nECLAIRCIR » (fin de contrat puis réengagé, temporaire devenu permanent,\naucune fin de contrat saisie) : il n'a pas été régénéré.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "taNSGrJFPnMGajMCy2NW",
