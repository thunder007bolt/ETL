      "groupIds": [
        "AmxnyYSsiqV7somOHrXL"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1083704540,
      "version": 1,
      "versionNonce": 310381343,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794236058057,
      "link": null,
      "locked": false,
      "text": "99 règles d'une ligne, tirées des cinq familles des prestations, de\nregles_effectif, de regles_t60 et du README de la GRH, chacune avec son\norigine entre parenthèses ; 9 lignes « À faire » pour la CNSS. Chaque réglage\nprend sa valeur retenue. Schéma (aucun débordement) et version Word.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "99 règles d'une ligne, tirées des cinq familles des prestations, de\nregles_effectif, de regles_t60 et du README de la GRH, chacune avec son\norigine entre parenthèses ; 9 lignes « À faire » pour la CNSS. Chaque réglage\nprend sa valeur retenue. Schéma (aucun débordement) et version Word.",
      "autoResize": true,
      "lineHeight": 1.25
    },
