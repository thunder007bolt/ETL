    {
      "id": "LdznFmqgsiSpJgCADjw5",
      "type": "text",
      "x": 911.6666666666666,
      "y": 655.0,
      "width": 757.98,
      "height": 90.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
