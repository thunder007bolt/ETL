      "versionNonce": 1158851088,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794236058057,
      "link": null,
      "locked": false,
      "text": "La date d'arrêt est un choix de la CNSS ; la règle imposée : corrections avant\nla fin de janvier N+1, puis photo reprise, qui fait foi pour l'année N.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "La date d'arrêt est un choix de la CNSS ; la règle imposée : corrections avant\nla fin de janvier N+1, puis photo reprise, qui fait foi pour l'année N.",
      "autoResize": true,
      "lineHeight": 1.25
    },
