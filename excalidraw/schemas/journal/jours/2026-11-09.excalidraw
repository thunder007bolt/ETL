    {
      "id": "kdxntTH5dv2GfMk3I3zU",
      "type": "text",
      "x": 45,
      "y": 183.5,
      "width": 1512.0000000000002,
      "height": 100.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "6RakZ9PiYCeouDx0g3Xb"
      ],
