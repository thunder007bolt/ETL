      "isDeleted": false,
      "boundElements": [],
      "updated": 1794226148868,
      "link": null,
      "locked": false,
      "text": "Ce qu'on a trouvé",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Ce qu'on a trouvé",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "MGrjqijRJLltWUHxePDu",
      "type": "text",
      "x": 45.0,
      "y": 828.0,
      "width": 751.32,
      "height": 90.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "Sxspyy7vykTqFViABcFa"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1451403486,
      "version": 1,
      "versionNonce": 365178526,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794226148868,
      "link": null,
      "locked": false,
      "text": "Huit décisions sont les plus attendues : l'année d'un paiement (point 1), la\ncopie de fin mars (2), les contrôles de la DAI (29, 69, 70), qui compter pour\nun survivant (71), l'année de chaque étape (14) et les demandes qui traînent\n(21). La liste des points de chaque direction est à la fin de la fiche.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Huit décisions sont les plus attendues : l'année d'un paiement (point 1), la\ncopie de fin mars (2), les contrôles de la DAI (29, 69, 70), qui compter pour\nun survivant (71), l'année de chaque étape (14) et les demandes qui traînent\n(21). La liste des points de chaque direction est à la fin de la fiche.",
      "autoResize": true,
      "lineHeight": 1.25
    },
