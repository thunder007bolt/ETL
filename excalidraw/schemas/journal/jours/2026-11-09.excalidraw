    {
      "id": "qzgnNQboM1KZrOZ3LFqS",
      "type": "text",
      "x": 911.6666666666666,
      "y": 785.0,
      "width": 760.1400000000001,
      "height": 90.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "AmxnyYSsiqV7somOHrXL"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1382961594,
      "version": 1,
      "versionNonce": 435972089,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794236058057,
      "link": null,
      "locked": false,
      "text": "Relancer le chargement en janvier remplace la photo du 1er janvier (même nom,\n012025 pour 2024). Deux défauts du chargement gênent cette relance : le\ncliché pris table par table, et le nettoyage de l'ODS des faits, qui vise le\nmois chargé et non le mois archivé.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Relancer le chargement en janvier remplace la photo du 1er janvier (même nom,\n012025 pour 2024). Deux défauts du chargement gênent cette relance : le\ncliché pris table par table, et le nettoyage de l'ODS des faits, qui vise le\nmois chargé et non le mois archivé.",
      "autoResize": true,
      "lineHeight": 1.25
    },
