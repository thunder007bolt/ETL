    {
      "id": "jnqxBKoKNMlkrjdCwFWG",
      "type": "text",
      "x": 45.0,
      "y": 853.0,
      "width": 756.0,
      "height": 157.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "CQyU1QIxJedjAei2UJRq"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 835238686,
      "version": 1,
      "versionNonce": 806401008,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793882077276,
      "link": null,
      "locked": false,
      "text": "La fiche de l'agent donne l'entrée (date d'embauche : les 104 recrutements de\n2024 retrouvés) ; les décisions donnent les départs, disponibilités, remises\nen activité et engagements ; la situation donne le classement. La nature de la\nsituation n'a aucun code de sortie ni de retour (REC = reclassement, RET =\nrétrogradation, DIS = mise à disposition). Le statut E n'est presque jamais\nsaisi (lot 18) : les agents inactifs comptés par le statut risquent de manquer\nles disponibilités.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "La fiche de l'agent donne l'entrée (date d'embauche : les 104 recrutements de\n2024 retrouvés) ; les décisions donnent les départs, disponibilités, remises\nen activité et engagements ; la situation donne le classement. La nature de la\nsituation n'a aucun code de sortie ni de retour (REC = reclassement, RET =\nrétrogradation, DIS = mise à disposition). Le statut E n'est presque jamais\nsaisi (lot 18) : les agents inactifs comptés par le statut risquent de manquer\nles disponibilités.",
      "autoResize": true,
      "lineHeight": 1.25
    },
