    {
      "id": "hQG03pFEWpnmrT9zElaa",
      "type": "text",
      "x": 1778.3333333333333,
      "y": 783.0,
      "width": 758.34,
      "height": 67.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "TBpLpkoJspvQmVGfuNcQ"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 957476530,
      "version": 1,
      "versionNonce": 1574196003,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794069516356,
      "link": null,
      "locked": false,
      "text": "La requête demandait une fiche ACTIF : les 67 fiches sans état (embauches\nrécentes jusqu'au 28/01/2026) n'étaient comptées nulle part, ce qui risquait\nde sous-compter le 31/12/2025.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "La requête demandait une fiche ACTIF : les 67 fiches sans état (embauches\nrécentes jusqu'au 28/01/2026) n'étaient comptées nulle part, ce qui risquait\nde sous-compter le 31/12/2025.",
      "autoResize": true,
      "lineHeight": 1.25
    },
