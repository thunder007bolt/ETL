    {
      "id": "IopAQEh3GxUrGN7O5jvY",
      "type": "text",
      "x": 45.0,
      "y": 700.5,
      "width": 761.4000000000001,
      "height": 112.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "CQyU1QIxJedjAei2UJRq"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 614942426,
      "version": 1,
      "versionNonce": 1652343876,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794069516356,
      "link": null,
      "locked": false,
      "text": "Réponses données à partir des lots 2, 13, 17, 18 et 20. Lot 24 rédigé (Q134 à\nQ139) : CLA par agent et face à la date d'embauche ; nature et statut de la\nsituation autour des décisions 07, 14, 18, 37, 50, 51 ; statut E face aux\ndécisions 07 et 18 ; permanents en disponibilité au 31/12/2024 selon la\ndécision et selon le statut.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Réponses données à partir des lots 2, 13, 17, 18 et 20. Lot 24 rédigé (Q134 à\nQ139) : CLA par agent et face à la date d'embauche ; nature et statut de la\nsituation autour des décisions 07, 14, 18, 37, 50, 51 ; statut E face aux\ndécisions 07 et 18 ; permanents en disponibilité au 31/12/2024 selon la\ndécision et selon le statut.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "fVOljQdKaL6S9f9gh6kA",
      "type": "text",
      "x": 45.0,
      "y": 829.0,
      "width": 145.60000000000002,
      "height": 20.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
