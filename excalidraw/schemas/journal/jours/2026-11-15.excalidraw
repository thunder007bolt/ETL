    {
      "id": "1iPhJi0OHU5nsgKLzZwn",
      "type": "text",
      "x": 45.0,
      "y": 783.0,
      "width": 744.3000000000001,
      "height": 135.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
