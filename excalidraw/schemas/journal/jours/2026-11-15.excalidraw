      "seed": 1552126941,
      "version": 1,
      "versionNonce": 10338036,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794927751618,
      "link": null,
      "locked": false,
      "text": "Pilote T32 (23 règles en 7 groupes), validé ; puis les 32 autres tableaux sur\nle même modèle, chaque règle prise dans la fiche des règles, les documents de\nfamille et les requêtes proposées ; un encadré vert avec les chiffres 2024\nface à l'annuaire CNSS. Générés sans alerte, vus dans la visionneuse.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Pilote T32 (23 règles en 7 groupes), validé ; puis les 32 autres tableaux sur\nle même modèle, chaque règle prise dans la fiche des règles, les documents de\nfamille et les requêtes proposées ; un encadré vert avec les chiffres 2024\nface à l'annuaire CNSS. Générés sans alerte, vus dans la visionneuse.",
      "autoResize": true,
      "lineHeight": 1.25
    },
