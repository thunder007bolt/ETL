    {
      "id": "TVr4FShpB89t4iZQI5ZE",
      "type": "text",
      "x": 1778.3333333333333,
      "y": 630.5,
      "width": 754.5600000000001,
      "height": 90.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "JPEaOEjZHRyXUdx0AAIz"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 585651862,
      "version": 1,
      "versionNonce": 1307774558,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794756697025,
      "link": null,
      "locked": false,
      "text": "Réglage « Auto » dans l'en-tête : désactivé, 10 s à 10 min, ou « Autre… » (5 à\n3600 s), 30 s par défaut, retenu par le navigateur. Le schéma ouvert est\nenregistré à cette fréquence s'il a changé. Testé sur un schéma d'essai,\nsupprimé ensuite.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Réglage « Auto » dans l'en-tête : désactivé, 10 s à 10 min, ou « Autre… » (5 à\n3600 s), 30 s par défaut, retenu par le navigateur. Le schéma ouvert est\nenregistré à cette fréquence s'il a changé. Testé sur un schéma d'essai,\nsupprimé ensuite.",
      "autoResize": true,
      "lineHeight": 1.25
    },
