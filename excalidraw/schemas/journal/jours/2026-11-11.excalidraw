      "seed": 285879979,
      "version": 1,
      "versionNonce": 911876896,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794756697025,
      "link": null,
      "locked": false,
      "text": "Point 83 : le cumul depuis le 1er janvier est gardé par défaut ; les colonnes\ndes trimestres pas encore arrivés restent vides. Partout : sans donnée, une\ncase vide, jamais 0.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Point 83 : le cumul depuis le 1er janvier est gardé par défaut ; les colonnes\ndes trimestres pas encore arrivés restent vides. Partout : sans donnée, une\ncase vide, jamais 0.",
      "autoResize": true,
      "lineHeight": 1.25
    },
