      "versionNonce": 1488051995,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794756697025,
      "link": null,
      "locked": false,
      "text": "Un enregistrement automatique dans la visionneuse Excalidraw, toutes les 30\nsecondes, à fréquence réglable, pour ne plus perdre de retouches.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Un enregistrement automatique dans la visionneuse Excalidraw, toutes les 30\nsecondes, à fréquence réglable, pour ne plus perdre de retouches.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "jbrzb8lrVJBYkjPprEHA",
      "type": "text",
      "x": 1778.3333333333333,
      "y": 606.5,
      "width": 146.24,
      "height": 20.0,
      "angle": 0,
