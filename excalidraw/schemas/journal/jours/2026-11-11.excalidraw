      "boundElements": [],
      "updated": 1794756697025,
      "link": null,
      "locked": false,
      "text": "Expliquer le point 81 : divise-t-on le taux de contrôle par les dossiers payés\ndans la période, ou par les dossiers liquidés ou en portefeuille ?",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
