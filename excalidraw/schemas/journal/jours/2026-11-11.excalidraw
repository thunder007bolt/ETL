      "updated": 1794756697025,
      "link": null,
      "locked": false,
      "text": "Une version auto par tranche de 10 minutes dans l'historique. Si le fichier\nchange sur le disque, l'enregistrement auto s'arrête et la visionneuse propose\nde recharger.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Une version auto par tranche de 10 minutes dans l'historique. Si le fichier\nchange sur le disque, l'enregistrement auto s'arrête et la visionneuse propose\nde recharger.",
      "autoResize": true,
      "lineHeight": 1.25
    },
