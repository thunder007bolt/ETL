    },
    {
      "id": "ydXbZ0RZvlIjqB1YkxBd",
      "type": "text",
      "x": 45.0,
      "y": 873.0,
      "width": 752.4000000000001,
      "height": 202.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "YyS06IooPEEs2RtqvPxY"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 4940950,
      "version": 1,
      "versionNonce": 1113127472,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794090587362,
      "link": null,
      "locked": false,
      "text": "Forme validée (« oui ça me convient ») : faite ensuite pour tous les tableaux.\nPrestations : T25, T26, T27, T28 à T30, T31, T32 à T40, T41, T42 à\nT49, T50 à T57 (79 termes). GRH : T58, T59, T61 et T65 ensemble, T60,\nT62, T63 et T64 (31 termes). T28 à T30, T63 et T64 n'ont pas encore\ntoutes leurs données : leurs termes posent la question et disent où chercher.\nTa question sur « l'annuaire de la CNSS » : c'était l'annuaire statistique\nCNSS 2024, pas l'Annuaire CIPRES ; les deux fiches le disent maintenant\npartout. Le terme 7 de T62 (avec ou sans promotion) reprend le lot 21 : 2\npromotions liées à une formation en 2024, 6 publiées.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Forme validée (« oui ça me convient ») : faite ensuite pour tous les tableaux.\nPrestations : T25, T26, T27, T28 à T30, T31, T32 à T40, T41, T42 à\nT49, T50 à T57 (79 termes). GRH : T58, T59, T61 et T65 ensemble, T60,\nT62, T63 et T64 (31 termes). T28 à T30, T63 et T64 n'ont pas encore\ntoutes leurs données : leurs termes posent la question et disent où chercher.\nTa question sur « l'annuaire de la CNSS » : c'était l'annuaire statistique\nCNSS 2024, pas l'Annuaire CIPRES ; les deux fiches le disent maintenant\npartout. Le terme 7 de T62 (avec ou sans promotion) reprend le lot 21 : 2\npromotions liées à une formation en 2024, 6 publiées.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "Or0Z07oovuOtHDArjLfB",
      "type": "text",
      "x": 45.0,
