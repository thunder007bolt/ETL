    {
      "id": "sNSrpcjqTJj28qam2Xy3",
      "type": "text",
      "x": 45.0,
      "y": 1115.5,
      "width": 759.6,
      "height": 90.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "YyS06IooPEEs2RtqvPxY"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 258014950,
      "version": 1,
      "versionNonce": 456626950,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794090587362,
      "link": null,
      "locked": false,
      "text": "Une section par famille de tableaux calculés de la même façon ; la requête est\ndonnée pour le premier, on change les codes pour les autres. Deux noms fixes :\n« Annuaire CIPRES » (les pages citées, l'encadré rouge) et « annuaire CNSS\n2024 » (la comparaison des chiffres).",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Une section par famille de tableaux calculés de la même façon ; la requête est\ndonnée pour le premier, on change les codes pour les autres. Deux noms fixes :\n« Annuaire CIPRES » (les pages citées, l'encadré rouge) et « annuaire CNSS\n2024 » (la comparaison des chiffres).",
      "autoResize": true,
      "lineHeight": 1.25
    },
