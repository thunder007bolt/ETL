      "boundElements": [],
      "updated": 1793570051626,
      "link": null,
      "locked": false,
      "text": "L'annuaire de la CNSS donne de quoi vérifier T37 à T41 : rentes par type, 97\n378 allocataires et 268 481 enfants en 2024 ; enfants de 21 ans au plus.\nKaya 2017 : T41 compte le dossier de l'allocataire ; T35 sans « 25 ans et\nplus ».",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "L'annuaire de la CNSS donne de quoi vérifier T37 à T41 : rentes par type, 97\n378 allocataires et 268 481 enfants en 2024 ; enfants de 21 ans au plus.\nKaya 2017 : T41 compte le dossier de l'allocataire ; T35 sans « 25 ans et\nplus ».",
      "autoResize": true,
      "lineHeight": 1.25
    },
