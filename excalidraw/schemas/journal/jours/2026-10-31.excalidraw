    {
      "id": "67vMrHhIlyuWEiw82Bsv",
      "type": "text",
      "x": 45.0,
      "y": 1253.0,
      "width": 723.96,
      "height": 135.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "VVs5LblVNEA90ICioGc3"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 40917466,
      "version": 1,
      "versionNonce": 1821911381,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793570051626,
      "link": null,
      "locked": false,
      "text": "T32 31 093 pour 30 808 publiés (+0,9 %), T36 exact, rentes à quelques %.\nSexe 1 = hommes. La CNSS compte les pensions non payées, dont 2 901 de\ncoordination payées par une autre caisse. Montant publié entre nos deux\nmontants. T41 +5 %, mais les enfants payés retombent à +1,1 %. Veuves et\norphelins sous le publié depuis 2023. 500 veuves de 120 ans : date par\ndéfaut.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "T32 31 093 pour 30 808 publiés (+0,9 %), T36 exact, rentes à quelques %.\nSexe 1 = hommes. La CNSS compte les pensions non payées, dont 2 901 de\ncoordination payées par une autre caisse. Montant publié entre nos deux\nmontants. T41 +5 %, mais les enfants payés retombent à +1,1 %. Veuves et\norphelins sous le publié depuis 2023. 500 veuves de 120 ans : date par\ndéfaut.",
      "autoResize": true,
      "lineHeight": 1.25
    },
