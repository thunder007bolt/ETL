    {
      "id": "ib2LfgSDTFOeOHg6LYqz",
      "type": "text",
      "x": 45,
      "y": 183.5,
      "width": 940.4000000000001,
      "height": 100.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
