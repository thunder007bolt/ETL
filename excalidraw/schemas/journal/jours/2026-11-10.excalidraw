    {
      "id": "r0CFNLfzLYslwVTy1mxZ",
      "type": "text",
      "x": 1778.3333333333333,
      "y": 680.0,
      "width": 764.1,
      "height": 202.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
