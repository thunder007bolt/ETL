      "x": 45.0,
      "y": 962.5,
      "width": 705.6,
      "height": 45.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "IXiMgHpBrdGkEWwhab1Y"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 707433638,
      "version": 1,
      "versionNonce": 1462625124,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794387188250,
      "link": null,
      "locked": false,
      "text": "Ta conclusion : dans T25 à T27, la colonne des rejetés n'a de sens qu'au\nTotal. Les requêtes ne sont pas corrigées.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Ta conclusion : dans T25 à T27, la colonne des rejetés n'a de sens qu'au\nTotal. Les requêtes ne sont pas corrigées.",
      "autoResize": true,
      "lineHeight": 1.25
    },
