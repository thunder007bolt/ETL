      "versionNonce": 140735984,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794387188250,
      "link": null,
      "locked": false,
      "text": "Expliquer les points 78 (le rachat de rente dans T26) et 79 (ce que vise un\ncontrôle), et dire si un document écrit que les contrôles viennent de\nl'extérieur.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Expliquer les points 78 (le rachat de rente dans T26) et 79 (ce que vise un\ncontrôle), et dire si un document écrit que les contrôles viennent de\nl'extérieur.",
      "autoResize": true,
      "lineHeight": 1.25
    },
