      "boundElements": [],
      "updated": 1794387188250,
      "link": null,
      "locked": false,
      "text": "Chaque point expliqué et vérifié dans les fichiers : requêtes proposées, lots,\nrecueil v7, Kaya 2017, feuille 03 de la grille des ratios (relue, libellés\nseulement). Rien n'est modifié.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Chaque point expliqué et vérifié dans les fichiers : requêtes proposées, lots,\nrecueil v7, Kaya 2017, feuille 03 de la grille des ratios (relue, libellés\nseulement). Rien n'est modifié.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "ht3Au5JyZfKYOtdpp81l",
      "type": "text",
      "x": 45.0,
      "y": 1696.5,
      "width": 145.60000000000002,
      "height": 20.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
