    {
      "id": "9wHQFFrJ3beehdO9VVn1",
      "type": "text",
      "x": 45.0,
      "y": 2165.5,
      "width": 753.84,
      "height": 90.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "D4U259Wot2K9OeFz7wfj"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 353838718,
      "version": 1,
      "versionNonce": 819941612,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794387188250,
      "link": null,
      "locked": false,
      "text": "Le recueil passe avant la grille des ratios : le point 75 est répondu (pas de\nlimite à la première demande) ; l'enfant ajouté reste au point 27. Point 77 :\nles remarques du recueil s'appliquent, la maquette CIPRES n'est pas suivie à\nla lettre.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Le recueil passe avant la grille des ratios : le point 75 est répondu (pas de\nlimite à la première demande) ; l'enfant ajouté reste au point 27. Point 77 :\nles remarques du recueil s'appliquent, la maquette CIPRES n'est pas suivie à\nla lettre.",
      "autoResize": true,
      "lineHeight": 1.25
    },
