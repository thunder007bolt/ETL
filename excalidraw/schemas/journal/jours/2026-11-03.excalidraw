        "o1xSAetSGuGnJCNOqvWt"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 142699896,
      "version": 1,
      "versionNonce": 1487280457,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794135470238,
      "link": null,
      "locked": false,
      "text": "Expliquer en français facile le terme « dossiers déposés » de T26, puis ce\nque sont les IJ et une rente ; montrer comment une rente est enregistrée dans\nla base, étape par étape ; enfin le mettre en Excalidraw, sur une feuille à\npart.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Expliquer en français facile le terme « dossiers déposés » de T26, puis ce\nque sont les IJ et une rente ; montrer comment une rente est enregistrée dans\nla base, étape par étape ; enfin le mettre en Excalidraw, sur une feuille à\npart.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "JYT5pBiPr0fFYUZbNFPj",
