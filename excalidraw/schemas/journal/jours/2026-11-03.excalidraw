    },
    {
      "id": "9EZoZ8y8JSSiLUYyYJK2",
      "type": "text",
      "x": 911.6666666666666,
      "y": 785.5,
      "width": 750.6,
      "height": 90.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "ZNQ1nM9i4lm7fVBGTDQM"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1330560376,
      "version": 1,
      "versionNonce": 1276593334,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794135470238,
      "link": null,
      "locked": false,
      "text": "Le point à trancher : un dépôt par accident, à la déclaration, ou un dépôt par\ndemande. Avec un seul dépôt par accident, la ligne des rentes reste vide et la\ndurée de liquidation d'une rente passe de 14 à 986 jours en médiane (lot 4,\nP62).",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Le point à trancher : un dépôt par accident, à la déclaration, ou un dépôt par\ndemande. Avec un seul dépôt par accident, la ligne des rentes reste vide et la\ndurée de liquidation d'une rente passe de 14 à 986 jours en médiane (lot 4,\nP62).",
      "autoResize": true,
      "lineHeight": 1.25
    },
