    {
      "id": "WLgqX8UJdR4OKi7JytGW",
      "type": "text",
      "x": 45.0,
      "y": 545.5,
      "width": 752.76,
      "height": 90.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
