      "isDeleted": false,
      "boundElements": [],
      "updated": 1794135470238,
      "link": null,
      "locked": false,
      "text": "Ce qu'on a trouvé",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Ce qu'on a trouvé",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "s1HeK4PwYbE1KStf2YiL",
      "type": "text",
      "x": 45.0,
      "y": 828.0,
      "width": 766.08,
      "height": 90.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "o1xSAetSGuGnJCNOqvWt"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1988341771,
      "version": 1,
      "versionNonce": 278420490,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794135470238,
      "link": null,
      "locked": false,
      "text": "Rien de nouveau dans les données : tout vient des lots 4 et 7. Une rente n'ouvre\npas de dossier : elle arrive par une réception ANCIEN sur le dossier de\nl'accident et devient une ligne ARI de PRESTATION_ESP (ARSV, ARSF,\nARSE, ARSA pour les survivants) ; chaque mois payé est un débours.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Rien de nouveau dans les données : tout vient des lots 4 et 7. Une rente n'ouvre\npas de dossier : elle arrive par une réception ANCIEN sur le dossier de\nl'accident et devient une ligne ARI de PRESTATION_ESP (ARSV, ARSF,\nARSE, ARSA pour les survivants) ; chaque mois payé est un débours.",
      "autoResize": true,
      "lineHeight": 1.25
    },
