    },
    {
      "id": "OqKbbeuEq6yIJCebSbIC",
      "type": "text",
      "x": 45.0,
      "y": 675.5,
      "width": 755.6400000000001,
      "height": 112.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "o1xSAetSGuGnJCNOqvWt"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1325052345,
      "version": 1,
      "versionNonce": 1466565424,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794135470238,
      "link": null,
      "locked": false,
      "text": "Schéma prestations/vie_dossier/cheminement_rente : le parcours en 7 étapes\n(accident, demande au guichet, calcul, notification, paiement, vie de la rente,\nrentes de survivants), ce que chaque étape écrit (tables, colonnes, chiffres du\nlot 4, pièges), les clés d'une table à l'autre, un exemple fictif de bout en\nbout, les tableaux CIPRES où la rente compte.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Schéma prestations/vie_dossier/cheminement_rente : le parcours en 7 étapes\n(accident, demande au guichet, calcul, notification, paiement, vie de la rente,\nrentes de survivants), ce que chaque étape écrit (tables, colonnes, chiffres du\nlot 4, pièges), les clés d'une table à l'autre, un exemple fictif de bout en\nbout, les tableaux CIPRES où la rente compte.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "KDxG0T0pvFiH6r58QZ0u",
      "type": "text",
      "x": 45.0,
      "y": 804.0,
      "width": 145.60000000000002,
      "height": 20.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "o1xSAetSGuGnJCNOqvWt"
      ],
