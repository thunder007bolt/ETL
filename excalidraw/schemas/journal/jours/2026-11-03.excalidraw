      "isDeleted": false,
      "boundElements": [],
      "updated": 1794135470238,
      "link": null,
      "locked": false,
      "text": "Une feuille à part : les fiches, les règles et les README des prestations ne\nchangent pas.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Une feuille à part : les fiches, les règles et les README des prestations ne\nchangent pas.",
