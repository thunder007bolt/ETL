    {
      "id": "sitEseR4G9nXvHuGEabs",
      "type": "text",
      "x": 45.0,
      "y": 630.5,
      "width": 757.8000000000001,
      "height": 135.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
