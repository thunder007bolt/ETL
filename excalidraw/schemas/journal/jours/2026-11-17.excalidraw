      "boundElements": [],
      "updated": 1794927323894,
      "link": null,
      "locked": false,
      "text": "Huit points ajoutés (56 agence, bureau et direction régionale d'une unité ; 57\nles années passées ; 58 T59 au jour près ; 59 T65 sur les permanents ; 60 la\nformation longue ; 61 les temporaires sans engagement ; 62 les agents d'une\nunité fermée ; 63 la gestion de la masse salariale) ; points 2, 4, 25, 37 et 55\nreformulés ; DPC ajoutée aux directions ; schéma et fiches T58 à T65\nrégénérés (56, 57, 63 en orange).",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Huit points ajoutés (56 agence, bureau et direction régionale d'une unité ; 57\nles années passées ; 58 T59 au jour près ; 59 T65 sur les permanents ; 60 la\nformation longue ; 61 les temporaires sans engagement ; 62 les agents d'une\nunité fermée ; 63 la gestion de la masse salariale) ; points 2, 4, 25, 37 et 55\nreformulés ; DPC ajoutée aux directions ; schéma et fiches T58 à T65\nrégénérés (56, 57, 63 en orange).",
      "autoResize": true,
      "lineHeight": 1.25
    },
