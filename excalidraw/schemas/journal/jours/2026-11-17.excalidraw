    {
      "id": "POW1u8BSjjDIXHMduyyZ",
      "type": "text",
      "x": 1778.3333333333333,
      "y": 545.5,
      "width": 756.0,
      "height": 45.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
