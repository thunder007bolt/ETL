      "seed": 450198633,
      "version": 1,
      "versionNonce": 764533205,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794927323894,
      "link": null,
      "locked": false,
      "text": "La liste des schémas est trop désorganisée : des espaces de travail par thème,\nentre lesquels on passe facilement, comme sur les grandes plateformes.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "La liste des schémas est trop désorganisée : des espaces de travail par thème,\nentre lesquels on passe facilement, comme sur les grandes plateformes.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
