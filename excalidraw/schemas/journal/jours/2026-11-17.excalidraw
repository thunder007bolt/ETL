    {
      "id": "CzlVuFubelbkiHJHSDwo",
      "type": "text",
      "x": 45.0,
      "y": 1256.0,
      "width": 743.4000000000001,
      "height": 45.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "npEopsQQp30AuElniesW"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 328784824,
      "version": 1,
      "versionNonce": 317508644,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794927323894,
      "link": null,
      "locked": false,
      "text": "Proposer une meilleure structure, évolutive, et repérer les documents qui ne\nsont plus pertinents, pour les déplacer sans les supprimer.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Proposer une meilleure structure, évolutive, et repérer les documents qui ne\nsont plus pertinents, pour les déplacer sans les supprimer.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
