      "isDeleted": false,
      "boundElements": [],
      "updated": 1794927323894,
      "link": null,
      "locked": false,
      "text": "Ce qu'on a trouvé",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
