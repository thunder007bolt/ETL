    },
    {
      "id": "nvbk9Uod2MTCxFDb1HRx",
      "type": "text",
      "x": 45.0,
      "y": 1561.0,
      "width": 763.74,
      "height": 135.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "npEopsQQp30AuElniesW"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 43366020,
      "version": 1,
      "versionNonce": 61792398,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794927323894,
      "link": null,
      "locked": false,
      "text": "4 archives sûres (3 essais vides, points GRH v1) ; 3 probables (regles_grh,\nregles_prestations, prestation_esp) ; 5 à demander (11 fiches tableaux cipres,\nmaitrise, pensions_2024, remarques besoins v7, fiche de lecture prestations).\n5 schémas annotés à ne jamais écraser. 11 schémas citent encore la photo de\nfin mars. La décision du 01/11 sur le cliché de fin mars est encore « proposé\n» dans le journal.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "4 archives sûres (3 essais vides, points GRH v1) ; 3 probables (regles_grh,\nregles_prestations, prestation_esp) ; 5 à demander (11 fiches tableaux cipres,\nmaitrise, pensions_2024, remarques besoins v7, fiche de lecture prestations).\n5 schémas annotés à ne jamais écraser. 11 schémas citent encore la photo de\nfin mars. La décision du 01/11 sur le cliché de fin mars est encore « proposé\n» dans le journal.",
      "autoResize": true,
      "lineHeight": 1.25
    },
