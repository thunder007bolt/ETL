    },
    {
      "id": "FTfTYmLBs7HoySlFZkhV",
      "type": "text",
      "x": 45.0,
      "y": 1341.0,
      "width": 764.1,
      "height": 180.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "npEopsQQp30AuElniesW"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1694352037,
      "version": 1,
      "versionNonce": 458067384,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794927323894,
      "link": null,
      "locked": false,
      "text": "Inventaire des 137 schémas (28 dossiers) : générateur de chacun, schémas\nannotés à la main, documents périmés, incohérences de noms. Proposition dans\nschemas/rangement : le même squelette par domaine (1 pour la cnss, 2 regles, 3\ncomprendre), un dossier commun, un dossier archives. Réexaminée à ta demande,\nles espaces une fois en place : une seule passe, 6 dossiers à la racine au lieu\nde 13 entrées, plus de dossier pour un seul schéma, les fiches « tableaux\ncipres » gardées dans « 1 pour la cnss/fiches de validation », 6 schémas en\narchives. Rien n'est déplacé.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Inventaire des 137 schémas (28 dossiers) : générateur de chacun, schémas\nannotés à la main, documents périmés, incohérences de noms. Proposition dans\nschemas/rangement : le même squelette par domaine (1 pour la cnss, 2 regles, 3\ncomprendre), un dossier commun, un dossier archives. Réexaminée à ta demande,\nles espaces une fois en place : une seule passe, 6 dossiers à la racine au lieu\nde 13 entrées, plus de dossier pour un seul schéma, les fiches « tableaux\ncipres » gardées dans « 1 pour la cnss/fiches de validation », 6 schémas en\narchives. Rien n'est déplacé.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "FOem4p7Ssf09C7EXlq2L",
      "type": "text",
      "x": 45.0,
      "y": 1537.0,
      "width": 145.60000000000002,
      "height": 20.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
