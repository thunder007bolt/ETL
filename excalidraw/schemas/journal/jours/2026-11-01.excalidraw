      "versionNonce": 1554167238,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793544333387,
      "link": null,
      "locked": false,
      "text": "Lot 9 (P102 à P106) : ajustements par type, branche et année, sens des\nstatuts, débours de type AJ, T31 de 2024 rempli avec son taux, trop-perçus\naprès décès. Requête T31 (mois × branche : payées, trop-perçus, moins-perçus,\ntaux).",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Lot 9 (P102 à P106) : ajustements par type, branche et année, sens des\nstatuts, débours de type AJ, T31 de 2024 rempli avec son taux, trop-perçus\naprès décès. Requête T31 (mois × branche : payées, trop-perçus, moins-perçus,\ntaux).",
      "autoResize": true,
      "lineHeight": 1.25
    },
