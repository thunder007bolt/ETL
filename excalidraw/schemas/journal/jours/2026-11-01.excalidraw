      "isDeleted": false,
      "boundElements": [],
      "updated": 1793883068488,
      "link": null,
      "locked": false,
      "text": "La CNSS classe par la catégorie de la situation (grille de salaire) : 01-02\nemployés, 03 maîtrise, 04-05 cadres moyens, 06 cadres supérieurs ; 173, 207,\n304, 58 pour 177, 208, 311, 62 ; 48,8 % de cadres pour 49 %. Les 84 de 2019\nforment un seul lot, sans date de départ. La date d'état ne date pas les\ndéparts.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "La CNSS classe par la catégorie de la situation (grille de salaire) : 01-02\nemployés, 03 maîtrise, 04-05 cadres moyens, 06 cadres supérieurs ; 173, 207,\n304, 58 pour 177, 208, 311, 62 ; 48,8 % de cadres pour 49 %. Les 84 de 2019\nforment un seul lot, sans date de départ. La date d'état ne date pas les\ndéparts.",
      "autoResize": true,
      "lineHeight": 1.25
    },
