      "type": "text",
      "x": 911.6666666666666,
      "y": 3697.0,
      "width": 750.24,
      "height": 90.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
