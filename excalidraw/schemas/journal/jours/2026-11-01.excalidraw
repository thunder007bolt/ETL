      "type": "text",
      "x": 911.6666666666666,
      "y": 4878.0,
      "width": 736.3800000000001,
      "height": 112.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
