    {
      "id": "IBjjhCdLiR1VQLrCZ2aF",
      "type": "text",
      "x": 45.0,
      "y": 1835.5,
      "width": 757.6200000000001,
      "height": 135.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "D4U259Wot2K9OeFz7wfj"
      ],
