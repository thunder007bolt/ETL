      "type": "text",
      "x": 1778.3333333333333,
      "y": 2523.5,
      "width": 757.8000000000001,
      "height": 67.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
