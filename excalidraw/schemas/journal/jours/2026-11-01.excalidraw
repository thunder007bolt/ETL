      "link": null,
      "locked": false,
      "text": "Un doc concis par domaine, qui regroupe les règles et les questions à valider,\nécrit comme par une personne ; puis en Word, comme fait par toi, et en\nExcalidraw.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Un doc concis par domaine, qui regroupe les règles et les questions à valider,\nécrit comme par une personne ; puis en Word, comme fait par toi, et en\nExcalidraw.",
      "autoResize": true,
      "lineHeight": 1.25
    },
