    {
      "id": "rYymxrT9em7HiOG73KNO",
      "type": "text",
      "x": 45.0,
      "y": 3719.5,
      "width": 750.96,
      "height": 112.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "jlR0B1ArVb2Qp8vdExM7"
      ],
