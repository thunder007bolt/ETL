    {
      "id": "DfLOSzqOIwezAwoZmwdV",
      "type": "text",
      "x": 911.6666666666666,
      "y": 5521.0,
      "width": 760.32,
      "height": 157.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "UOdZHqWVkSeHzBf5sMBc"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 370757125,
      "version": 1,
      "versionNonce": 318608147,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793883068488,
      "link": null,
      "locked": false,
      "text": "À droite de chaque règle, une requête courte sur les tables de l'application\n(USER_GRH ou USER_DWH), pour 2024 (2025 pour T25 à T27), à coller dans\nSQL Developer, avec le chiffre à retrouver en commentaire. Une règle\nconstruit la liste réutilisée par les suivantes (permanents_2024, demandes,\npensions_2024…). Fait sur les 13 fiches : T58, T60, T62 ; T25, T26, T27,\nT31, T32, T41, T42, T50 à T57. Contrôles : lignes de 52 caractères au\nplus, aucun texte qui déborde, polices vérifiées dans la visionneuse.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "À droite de chaque règle, une requête courte sur les tables de l'application\n(USER_GRH ou USER_DWH), pour 2024 (2025 pour T25 à T27), à coller dans\nSQL Developer, avec le chiffre à retrouver en commentaire. Une règle\nconstruit la liste réutilisée par les suivantes (permanents_2024, demandes,\npensions_2024…). Fait sur les 13 fiches : T58, T60, T62 ; T25, T26, T27,\nT31, T32, T41, T42, T50 à T57. Contrôles : lignes de 52 caractères au\nplus, aucun texte qui déborde, polices vérifiées dans la visionneuse.",
      "autoResize": true,
      "lineHeight": 1.25
    },
