      "seed": 2020459684,
      "version": 1,
      "versionNonce": 872287815,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793883068488,
      "link": null,
      "locked": false,
      "text": "Première saisie : T42 2 463 pour 2 489, veuves +0,7 %, orphelins +0,5 % ;\n220 reliquidations en 2025 ; T48 39 pour 44. Âge juste par tranche, pas le\nsexe (641 femmes pour 527). Rappel : 8 % retraités, deux fois l'année pour les\nrentes d'orphelins. Mois cotisés toujours remplis ; PE_COT_AUTRE = mois\ndans l'autre caisse ; par accident, T48 ne change pas ; taux d'IPP toujours\nrempli, de 15 à 100.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Première saisie : T42 2 463 pour 2 489, veuves +0,7 %, orphelins +0,5 % ;\n220 reliquidations en 2025 ; T48 39 pour 44. Âge juste par tranche, pas le\nsexe (641 femmes pour 527). Rappel : 8 % retraités, deux fois l'année pour les\nrentes d'orphelins. Mois cotisés toujours remplis ; PE_COT_AUTRE = mois\ndans l'autre caisse ; par accident, T48 ne change pas ; taux d'IPP toujours\nrempli, de 15 à 100.",
      "autoResize": true,
      "lineHeight": 1.25
    },
