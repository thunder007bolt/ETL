    {
      "id": "MGrjqijRJLltWUHxePDu",
      "type": "text",
      "x": 45.0,
      "y": 828.0,
      "width": 765.0,
      "height": 157.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "Sxspyy7vykTqFViABcFa"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1451403486,
      "version": 1,
      "versionNonce": 365178526,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795111624816,
      "link": null,
      "locked": false,
      "text": "Les documents de travail gardent les chiffres d'avant le 17/11 : 742\npermanents au lieu de 741, 104 recrutements au lieu de 101, 48,8 % au lieu de\n48,3 %, 409 formés et 524 inscriptions au lieu de 407 et 522 ; regles_t60.md\nattend encore 672 au début de 2024 et 4 autres sorties ; le README et le\nTODO disent que les requêtes proposées ne sont pas exécutées. Deux lectures\nse contredisent sur les codes REC, RET et DIS (situations ou mouvements) ;\nun recrutement de 2024 sur trois manquants reste inexpliqué.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Les documents de travail gardent les chiffres d'avant le 17/11 : 742\npermanents au lieu de 741, 104 recrutements au lieu de 101, 48,8 % au lieu de\n48,3 %, 409 formés et 524 inscriptions au lieu de 407 et 522 ; regles_t60.md\nattend encore 672 au début de 2024 et 4 autres sorties ; le README et le\nTODO disent que les requêtes proposées ne sont pas exécutées. Deux lectures\nse contredisent sur les codes REC, RET et DIS (situations ou mouvements) ;\nun recrutement de 2024 sur trois manquants reste inexpliqué.",
      "autoResize": true,
      "lineHeight": 1.25
    },
