      "boundElements": [],
      "updated": 1795111624816,
      "link": null,
      "locked": false,
      "text": "11 fiches dans schemas/maitrise/4 gestion administrative : 01 le domaine en\nbref, 02 le vocabulaire (44 mots), 03 les données (9 tables, les codes), 04 la\ndémarche (28 lots en 6 étapes), 05 les découvertes (25 constats), 06 les\nrègles qui comptent les agents, 07 les règles des mouvements et de la\nformation, 08 les erreurs des DTM (13), 09 les questions ouvertes, 10 où on\nen est, 11 se préparer aux questions (16 chiffres, 12 questions-réponses).\nSommaire mis à jour. Rendu vérifié, aucune alerte.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "11 fiches dans schemas/maitrise/4 gestion administrative : 01 le domaine en\nbref, 02 le vocabulaire (44 mots), 03 les données (9 tables, les codes), 04 la\ndémarche (28 lots en 6 étapes), 05 les découvertes (25 constats), 06 les\nrègles qui comptent les agents, 07 les règles des mouvements et de la\nformation, 08 les erreurs des DTM (13), 09 les questions ouvertes, 10 où on\nen est, 11 se préparer aux questions (16 chiffres, 12 questions-réponses).\nSommaire mis à jour. Rendu vérifié, aucune alerte.",
      "autoResize": true,
      "lineHeight": 1.25
    },
