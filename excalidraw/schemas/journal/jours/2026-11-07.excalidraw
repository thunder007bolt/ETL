    {
      "id": "1WHfLdXjUdA8mWybl90s",
      "type": "text",
      "x": 1778.3333333333333,
      "y": 877.5,
      "width": 754.3800000000001,
      "height": 67.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
