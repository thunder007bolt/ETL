      "version": 1,
      "versionNonce": 1332633564,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794090587452,
      "link": null,
      "locked": false,
      "text": "Trois cas tiennent à un NULL ramené par un LEFT JOIN : fiche INACTIF\nsans date (NULL > date jamais vrai), temporaire sans 50 (tc.PERS_ID NULL),\nagent sans situation (NATURE_EMPLOI NULL).",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Trois cas tiennent à un NULL ramené par un LEFT JOIN : fiche INACTIF\nsans date (NULL > date jamais vrai), temporaire sans 50 (tc.PERS_ID NULL),\nagent sans situation (NATURE_EMPLOI NULL).",
      "autoResize": true,
      "lineHeight": 1.25
    },
