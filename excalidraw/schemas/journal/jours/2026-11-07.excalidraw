      "isDeleted": false,
      "boundElements": [],
      "updated": 1794161659933,
      "link": null,
      "locked": false,
      "text": "Ce qui a été fait",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Ce qui a été fait",
