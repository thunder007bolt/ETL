      "seed": 366351613,
      "version": 1,
      "versionNonce": 1447373156,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794069516379,
      "link": null,
      "locked": false,
      "text": "Mettre en place la structure (table ou vue matérialisée) que la CNSS\nalimentera, pour construire les tableaux GRH qui demandent des montants\nfinanciers. Toujours lire d'abord le recueil des besoins.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Mettre en place la structure (table ou vue matérialisée) que la CNSS\nalimentera, pour construire les tableaux GRH qui demandent des montants\nfinanciers. Toujours lire d'abord le recueil des besoins.",
      "autoResize": true,
      "lineHeight": 1.25
    },
