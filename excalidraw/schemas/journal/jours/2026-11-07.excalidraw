    {
      "id": "hFFi0UmIawtF7jYRPg71",
      "type": "text",
      "x": 45.0,
      "y": 1233.5,
      "width": 727.9200000000001,
      "height": 67.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "V6043Qg5KCHwwRxYtg3B"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 26107787,
      "version": 1,
      "versionNonce": 759812279,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794069516379,
      "link": null,
      "locked": false,
      "text": "Lister clairement tous les cas d'agents que traite la requête de l'effectif\n(permanent, temporaire en fin de contrat…), puis les mettre dans un schéma\nExcalidraw simple.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Lister clairement tous les cas d'agents que traite la requête de l'effectif\n(permanent, temporaire en fin de contrat…), puis les mettre dans un schéma\nExcalidraw simple.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "7Dm2nVJBuldnp4qhe5MB",
      "type": "text",
      "x": 45.0,
      "y": 1317.0,
      "width": 146.24,
      "height": 20.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
