      "id": "PsPtTWG6XpeHpQdnejEP",
      "type": "text",
      "x": 45.0,
      "y": 1496.5,
      "width": 145.60000000000002,
      "height": 20.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
