    {
      "id": "1WHfLdXjUdA8mWybl90s",
      "type": "text",
      "x": 1778.3333333333333,
      "y": 852.5,
      "width": 754.3800000000001,
      "height": 67.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "TCJz1wToaRPCtOT5j3l7"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 2136079664,
      "version": 1,
      "versionNonce": 28378536,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794090587452,
      "link": null,
      "locked": false,
      "text": "Le recueil et la grille ne donnent pas les mêmes comptes : formation « 63, 86\net 87 » ou 63812, 6386 et 6577 ; charges 61 à 66 ou 61 à 68 ; les frais de\npersonnel prennent G et S, les charges G seule.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Le recueil et la grille ne donnent pas les mêmes comptes : formation « 63, 86\net 87 » ou 63812, 6386 et 6577 ; charges 61 à 66 ou 61 à 68 ; les frais de\npersonnel prennent G et S, les charges G seule.",
      "autoResize": true,
      "lineHeight": 1.25
    },
