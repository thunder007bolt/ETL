    {
      "id": "TvG9jysxAlmyIywyw0Xn",
      "type": "text",
      "x": 911.6666666666666,
      "y": 1260.5,
      "width": 752.4000000000001,
      "height": 45.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
