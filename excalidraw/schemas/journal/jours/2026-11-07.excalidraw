      "type": "text",
      "x": 1778.3333333333333,
      "y": 850.5,
      "width": 754.3800000000001,
      "height": 67.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "TCJz1wToaRPCtOT5j3l7"
      ],
