    },
    {
      "id": "G8x6TLfXWfxddbzkxgfJ",
      "type": "text",
      "x": 911.6666666666666,
      "y": 2081.0,
      "width": 761.22,
      "height": 135.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "uYJu5qYHWmKTKRlJRLGa"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 6831351,
      "version": 1,
      "versionNonce": 1882961739,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794161659933,
      "link": null,
      "locked": false,
      "text": "Recueil v7 relu (Prestation, Finance), maquettes de l'Annuaire (T28 à T30,\nT63 à T76), Kaya, nos lots. Quatre schémas dans schemas/vues cnss : le\nsommaire, et trois vues. V_BI_BALANCE_COMPTABLE est la balance\nd'Oracle GL, mois par mois, avec le budget : T63, T64, T66 à T76, SP1, SP2.\nV_BI_CONTROLE_POSTERIORI couvre T28 à T30, V_BI_RESERVE couvre\nT75. Le schéma T63-T64 reprend la vue commune.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Recueil v7 relu (Prestation, Finance), maquettes de l'Annuaire (T28 à T30,\nT63 à T76), Kaya, nos lots. Quatre schémas dans schemas/vues cnss : le\nsommaire, et trois vues. V_BI_BALANCE_COMPTABLE est la balance\nd'Oracle GL, mois par mois, avec le budget : T63, T64, T66 à T76, SP1, SP2.\nV_BI_CONTROLE_POSTERIORI couvre T28 à T30, V_BI_RESERVE couvre\nT75. Le schéma T63-T64 reprend la vue commune.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "mXTet7jVRMuBot8TAj8x",
      "type": "text",
      "x": 911.6666666666666,
      "y": 2232.0,
      "width": 145.60000000000002,
      "height": 20.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "uYJu5qYHWmKTKRlJRLGa"
