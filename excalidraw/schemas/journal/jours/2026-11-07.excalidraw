    {
      "id": "0J7iqdemjIITgF2mFAp3",
      "type": "text",
      "x": 1778.3333333333333,
      "y": 547.5,
      "width": 708.1200000000001,
      "height": 67.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "TCJz1wToaRPCtOT5j3l7"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 366351613,
      "version": 1,
      "versionNonce": 1447373156,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794090587452,
      "link": null,
      "locked": false,
      "text": "Mettre en place la structure (table ou vue matérialisée) que la CNSS\nalimentera, pour construire les tableaux GRH qui demandent des montants\nfinanciers. Toujours lire d'abord le recueil des besoins.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Mettre en place la structure (table ou vue matérialisée) que la CNSS\nalimentera, pour construire les tableaux GRH qui demandent des montants\nfinanciers. Toujours lire d'abord le recueil des besoins.",
      "autoResize": true,
      "lineHeight": 1.25
    },
