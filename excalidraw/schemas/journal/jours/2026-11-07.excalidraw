    {
      "id": "uVDFtO1EQToUWo8wNPVG",
      "type": "text",
      "x": 45.0,
      "y": 1493.5,
      "width": 742.32,
      "height": 67.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
