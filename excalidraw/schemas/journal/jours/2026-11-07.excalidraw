    {
      "id": "O4YSU1ckN9caaRqIKwpG",
      "type": "text",
      "x": 45.0,
      "y": 632.5,
      "width": 764.6400000000001,
      "height": 135.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "PtgNGAbfoJyvwxXUEQTg"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 67382111,
      "version": 1,
      "versionNonce": 1173636290,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794090587452,
      "link": null,
      "locked": false,
      "text": "Schéma en quatre parties : l'idée (le DWH ne garde qu'une photo, mais la fiche,\nles situations et les décisions sont datées) ; la requête partie par partie (0\nà 8, puis OBIEE) ; trois agents fictifs sur une frise de 2018 à 2025 (un\npermanent promu, mis en disponibilité puis retraité ; un temporaire à trois\ncontrats ; un agent parti sans date, comme les 84 engagés de 2019) ; ce qui en\nsort et ce que la base ne permet pas de rejouer.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Schéma en quatre parties : l'idée (le DWH ne garde qu'une photo, mais la fiche,\nles situations et les décisions sont datées) ; la requête partie par partie (0\nà 8, puis OBIEE) ; trois agents fictifs sur une frise de 2018 à 2025 (un\npermanent promu, mis en disponibilité puis retraité ; un temporaire à trois\ncontrats ; un agent parti sans date, comme les 84 engagés de 2019) ; ce qui en\nsort et ce que la base ne permet pas de rejouer.",
      "autoResize": true,
      "lineHeight": 1.25
    },
