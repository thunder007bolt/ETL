      "versionNonce": 1212176500,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794161659933,
      "link": null,
      "locked": false,
      "text": "Pas de SQL : c'est à la CNSS de fournir les données. Définir seulement une\nstructure simple (colonnes, types, granularité) que la DSI créera, en table ou\nen vue, et alimentera.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Pas de SQL : c'est à la CNSS de fournir les données. Définir seulement une\nstructure simple (colonnes, types, granularité) que la DSI créera, en table ou\nen vue, et alimentera.",
      "autoResize": true,
      "lineHeight": 1.25
    },
