    {
      "id": "ztjjNq9mOw8Q43oYS6j4",
      "type": "text",
      "x": 45.0,
      "y": 2033.5,
      "width": 747.9000000000001,
      "height": 90.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "OVGqhAZWbpYAK9Nzi9uD"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1653739844,
      "version": 1,
      "versionNonce": 917228100,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794161659933,
      "link": null,
      "locked": false,
      "text": "Schéma à envoyer à la DSI et à la DFC : pourquoi (T63, T64, recueil v7), la\nstructure (nom proposé, une ligne, dix colonnes avec type et contenu), des\nlignes fictives, les règles d'alimentation, ce que la BI en fera et les cinq\nquestions à la DFC.",
      "fontSize": 18,
      "fontFamily": 5,
