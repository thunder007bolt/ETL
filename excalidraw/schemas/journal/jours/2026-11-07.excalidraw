      "version": 1,
      "versionNonce": 1585804484,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794090587452,
      "link": null,
      "locked": false,
      "text": "Une seconde version, plus technique, qui relie le schéma des cas aux requêtes,\npour mieux comprendre la requête SQL.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Une seconde version, plus technique, qui relie le schéma des cas aux requêtes,\npour mieux comprendre la requête SQL.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "gFSTEhLAQgxF9FEYCBAQ",
      "type": "text",
      "x": 911.6666666666666,
      "y": 1296.5,
      "width": 146.24,
      "height": 20.0,
