    {
      "id": "rSa4pv2pbXCgYIRx9ODx",
      "type": "text",
      "x": 911.6666666666666,
      "y": 1473.0,
      "width": 762.84,
      "height": 67.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
