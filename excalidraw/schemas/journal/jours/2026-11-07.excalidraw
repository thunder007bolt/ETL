    },
    {
      "id": "H9HAHnd3xjlxmK76FHiR",
      "type": "text",
      "x": 911.6666666666666,
      "y": 1320.5,
      "width": 737.6400000000001,
      "height": 112.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "yJW0fWdHkNM08FQ5LiFt"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1775855744,
      "version": 1,
      "versionNonce": 134557024,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794090587452,
      "link": null,
      "locked": false,
      "text": "Schéma en sept parties : la requête en un coup d'œil (parties 0 à 8, CTE,\nlignes du fichier, grain, alias) ; le WHERE de base annoté ligne par ligne ;\npour chaque cas (permanents, temporaires, entre les deux), le verdict, la\npartie, le bout de SQL qui décide et la raison ; les axes et les mesures ; le\ncomptage final.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Schéma en sept parties : la requête en un coup d'œil (parties 0 à 8, CTE,\nlignes du fichier, grain, alias) ; le WHERE de base annoté ligne par ligne ;\npour chaque cas (permanents, temporaires, entre les deux), le verdict, la\npartie, le bout de SQL qui décide et la raison ; les axes et les mesures ; le\ncomptage final.",
      "autoResize": true,
      "lineHeight": 1.25
    },
