    },
    {
      "id": "mpjUThtke6TBB03Iv5vM",
      "type": "text",
      "x": 911.6666666666666,
      "y": 2256.0,
      "width": 757.98,
      "height": 90.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "uYJu5qYHWmKTKRlJRLGa"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 863306910,
      "version": 1,
      "versionNonce": 94088962,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794161659933,
      "link": null,
      "locked": false,
      "text": "Prestations : seuls les contrôles a posteriori manquent. T31 est dans la base\n(AJUSTEMENT) et T71 semble dans TXDEPOT. Finance : une seule balance\nmensuelle suffit, avec le mois 0 pour T72 et la branche pour T66 à T68 ; les\nréserves sont calculées à la main par la DFC.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Prestations : seuls les contrôles a posteriori manquent. T31 est dans la base\n(AJUSTEMENT) et T71 semble dans TXDEPOT. Finance : une seule balance\nmensuelle suffit, avec le mois 0 pour T72 et la branche pour T66 à T68 ; les\nréserves sont calculées à la main par la DFC.",
      "autoResize": true,
      "lineHeight": 1.25
    },
