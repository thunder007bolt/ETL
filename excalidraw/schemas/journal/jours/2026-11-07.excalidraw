      "isDeleted": false,
      "boundElements": [],
      "updated": 1794090587452,
      "link": null,
      "locked": false,
      "text": "Ce qu'on a trouvé",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
