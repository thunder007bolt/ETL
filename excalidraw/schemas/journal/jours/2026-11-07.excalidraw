    {
      "id": "CSfWLt6sCiLg9eP4uX1r",
      "type": "text",
      "x": 911.6666666666666,
      "y": 1951.0,
      "width": 750.24,
      "height": 90.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "uYJu5qYHWmKTKRlJRLGa"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 605850528,
      "version": 1,
      "versionNonce": 1615864601,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794161659933,
      "link": null,
      "locked": false,
      "text": "D'après le recueil v7 et les tableaux CIPRES, trouver ce qui manque en\nprestations et en gestion financière, et proposer des vues simples, combinées\nsi possible, que la CNSS créera dans la base source. Ne pas lire la\ncomptabilité de la copie : la CNSS la dit non valide.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "D'après le recueil v7 et les tableaux CIPRES, trouver ce qui manque en\nprestations et en gestion financière, et proposer des vues simples, combinées\nsi possible, que la CNSS créera dans la base source. Ne pas lire la\ncomptabilité de la copie : la CNSS la dit non valide.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "y6ckDXcgFVWXM4aSb4Ac",
