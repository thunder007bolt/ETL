      "type": "text",
      "x": 1778.3333333333333,
      "y": 545.5,
      "width": 708.1200000000001,
      "height": 67.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
