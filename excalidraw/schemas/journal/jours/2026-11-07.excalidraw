      "roundness": null,
      "seed": 2136079664,
      "version": 1,
      "versionNonce": 28378536,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794069516379,
      "link": null,
      "locked": false,
      "text": "Le recueil et la grille ne donnent pas les mêmes comptes : formation « 63, 86\net 87 » ou 63812, 6386 et 6577 ; charges 61 à 66 ou 61 à 68 ; les frais de\npersonnel prennent G et S, les charges G seule.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Le recueil et la grille ne donnent pas les mêmes comptes : formation « 63, 86\net 87 » ou 63812, 6386 et 6577 ; charges 61 à 66 ou 61 à 68 ; les frais de\npersonnel prennent G et S, les charges G seule.",
      "autoResize": true,
      "lineHeight": 1.25
    },
