    },
    {
      "id": "uVDFtO1EQToUWo8wNPVG",
      "type": "text",
      "x": 45.0,
      "y": 1495.5,
      "width": 742.32,
      "height": 67.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "V6043Qg5KCHwwRxYtg3B"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1172097355,
      "version": 1,
      "versionNonce": 1511190989,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794090587452,
      "link": null,
      "locked": false,
      "text": "Un agent sans situation au 31/12 est compté, mais sa nature est vide : les\nfiltres Permanent et Temporaire d'OBIEE l'écartent des tableaux. Nombre à\ncompter.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Un agent sans situation au 31/12 est compté, mais sa nature est vide : les\nfiltres Permanent et Temporaire d'OBIEE l'écartent des tableaux. Nombre à\ncompter.",
      "autoResize": true,
      "lineHeight": 1.25
    },
