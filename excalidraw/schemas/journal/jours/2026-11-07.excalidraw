    {
      "id": "gE0AUsFZrbAdjPAzHMXx",
      "type": "text",
      "x": 1778.3333333333333,
      "y": 680.0,
      "width": 734.94,
      "height": 157.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "TCJz1wToaRPCtOT5j3l7"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1979103277,
      "version": 1,
      "versionNonce": 964124694,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794161659933,
      "link": null,
      "locked": false,
      "text": "Recueil v7 relu (RH lignes 6 et 7, indicateur de formation, Finance T66 et\nT69), puis l'Annuaire, la grille des ratios et Kaya. Table\nSTG_GL.BI_GRH_SOLDE_COMPTABLE proposée : montants par exercice,\nmois, gestion, compte et section analytique, réalisés et budgétés. Elle est\nremplie par la DSI depuis Oracle GL, par son traitement ou par une vue\nmatérialisée posée dessus. Avec elle : cinq questions à la DFC et quatre\ncontrôles, testés dans SQLite.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Recueil v7 relu (RH lignes 6 et 7, indicateur de formation, Finance T66 et\nT69), puis l'Annuaire, la grille des ratios et Kaya. Table\nSTG_GL.BI_GRH_SOLDE_COMPTABLE proposée : montants par exercice,\nmois, gestion, compte et section analytique, réalisés et budgétés. Elle est\nremplie par la DSI depuis Oracle GL, par son traitement ou par une vue\nmatérialisée posée dessus. Avec elle : cinq questions à la DFC et quatre\ncontrôles, testés dans SQLite.",
      "autoResize": true,
      "lineHeight": 1.25
    },
