    {
      "id": "qwzzbLSIg3in3ckW1OM9",
      "type": "text",
      "x": 45.0,
      "y": 1770.0,
      "width": 535.6800000000001,
      "height": 157.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
