      "boundElements": [],
      "updated": 1794161659713,
      "link": null,
      "locked": false,
      "text": "rangé par famille : T58 effectif, T60 mouvements, T63 T64 finances ;\nregles_grh (règles G1 à G11) ; requete_effectif_pas_a_pas (la requête de\nl'effectif expliquée) ; cas_agents_effectif (tous les cas d'agents) et\ncas_agents_effectif_sql (les mêmes, reliés à la requête) ;\ncas_mouvements_t60 (T60 cas par cas), cas_mouvements_t60_sql (les mêmes,\nreliés à la requête) et requete_mouvement_pas_a_pas ;\nt63_t64_donnees_a_fournir (la structure à envoyer à la CNSS) ; tableaux\ncipres : fiches T58, T60, T62",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "rangé par famille : T58 effectif, T60 mouvements, T63 T64 finances ;\nregles_grh (règles G1 à G11) ; requete_effectif_pas_a_pas (la requête de\nl'effectif expliquée) ; cas_agents_effectif (tous les cas d'agents) et\ncas_agents_effectif_sql (les mêmes, reliés à la requête) ;\ncas_mouvements_t60 (T60 cas par cas), cas_mouvements_t60_sql (les mêmes,\nreliés à la requête) et requete_mouvement_pas_a_pas ;\nt63_t64_donnees_a_fournir (la structure à envoyer à la CNSS) ; tableaux\ncipres : fiches T58, T60, T62",
      "autoResize": true,
      "lineHeight": 1.25
    },
