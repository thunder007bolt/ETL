      "versionNonce": 1529966985,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793789568333,
      "link": null,
      "locked": false,
      "text": "Comptes des charges techniques (601, 602, 603, 605), des produits financiers\n(771 à 778) et des placements ; budget lu dans Oracle GL (module budget) ; taux\nd'absorption du budget (SP1) ; immeubles de rapport, gestion I (SP2) ; réserves\nde T75, disponibles vers juillet de l'année suivante.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Comptes des charges techniques (601, 602, 603, 605), des produits financiers\n(771 à 778) et des placements ; budget lu dans Oracle GL (module budget) ; taux\nd'absorption du budget (SP1) ; immeubles de rapport, gestion I (SP2) ; réserves\nde T75, disponibles vers juillet de l'année suivante.",
      "autoResize": true,
      "lineHeight": 1.25
    },
