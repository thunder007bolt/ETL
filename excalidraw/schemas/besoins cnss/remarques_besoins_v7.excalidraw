      "type": "text",
      "x": 901.6666666666666,
      "y": 4730.0,
      "width": 772.74,
      "height": 90.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
