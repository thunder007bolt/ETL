      "boundElements": [],
      "updated": 1793789568333,
      "link": null,
      "locked": false,
      "text": "La structure de la CNSS (12 directions centrales, 5 directions régionales :\nOuagadougou, Bobo-Dioulasso, Ouahigouya, Fada N'Gourma, Dédougou), ses 7\napplications (immatriculation, recouvrement, prestations, GRH et paie, loyers,\nimmobilisations, Oracle E-Business), les attentes et les exigences techniques de\nl'outil décisionnel.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "La structure de la CNSS (12 directions centrales, 5 directions régionales :\nOuagadougou, Bobo-Dioulasso, Ouahigouya, Fada N'Gourma, Dédougou), ses 7\napplications (immatriculation, recouvrement, prestations, GRH et paie, loyers,\nimmobilisations, Oracle E-Business), les attentes et les exigences techniques de\nl'outil décisionnel.",
      "autoResize": true,
      "lineHeight": 1.25
    },
