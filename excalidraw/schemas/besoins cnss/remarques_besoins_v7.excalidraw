    {
      "id": "0WsB7DWGk2j9IqTJCJS6",
      "type": "text",
      "x": 1758.3333333333333,
      "y": 3924.5,
      "width": 793.26,
      "height": 112.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "5GckNaz0JMl2DJP4qnE1"
      ],
