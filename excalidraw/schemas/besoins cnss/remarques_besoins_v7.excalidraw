    {
      "id": "Tn9oK8Tcv8wnAxVH7Qcw",
      "type": "text",
      "x": 45.0,
      "y": 4730.0,
      "width": 789.4800000000001,
      "height": 112.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "sh2WtwPiyywhbYZjfnyU"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 192978772,
      "version": 1,
      "versionNonce": 2126353675,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793789568333,
      "link": null,
      "locked": false,
      "text": "Deux définitions selon le destinataire, par exemple l'employeur actif : celui qui\na déclaré ou payé (CIPRES), celui qui a le statut actif (CNSS). Renommages,\nfusion des assurés volontaires et des travailleurs indépendants, nomenclatures\nCITI et NAEMA, calculs sur le compte individuel, deux maquettes en plus (SP\nREC1, SP REC2).",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Deux définitions selon le destinataire, par exemple l'employeur actif : celui qui\na déclaré ou payé (CIPRES), celui qui a le statut actif (CNSS). Renommages,\nfusion des assurés volontaires et des travailleurs indépendants, nomenclatures\nCITI et NAEMA, calculs sur le compte individuel, deux maquettes en plus (SP\nREC1, SP REC2).",
      "autoResize": true,
      "lineHeight": 1.25
    },
