      "boundElements": [],
      "updated": 1793789568333,
      "link": null,
      "locked": false,
      "text": "Un atelier par domaine, avec un commentaire de la CNSS pour chaque tableau :\nPrestation (14/01, 30 tableaux), RH (15/01, T58 à T65), Finance (15/01, T66 à\nT76 et 2 tableaux en plus), Recouvrement (16/01, T1 à T22 et 2 maquettes en\nplus).",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Un atelier par domaine, avec un commentaire de la CNSS pour chaque tableau :\nPrestation (14/01, 30 tableaux), RH (15/01, T58 à T65), Finance (15/01, T66 à\nT76 et 2 tableaux en plus), Recouvrement (16/01, T1 à T22 et 2 maquettes en\nplus).",
      "autoResize": true,
      "lineHeight": 1.25
