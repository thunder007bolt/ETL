      "type": "text",
      "x": 39,
      "y": 11148,
      "width": 466.88000000000005,
      "height": 20,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
