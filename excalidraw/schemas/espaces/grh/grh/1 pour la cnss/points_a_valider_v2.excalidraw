      "isDeleted": false,
      "boundElements": [],
      "updated": 1795082621082,
      "link": null,
      "locked": false,
      "text": "C'est quoi : une formation peut commencer en décembre et finir en janvier.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "C'est quoi : une formation peut commencer en décembre et finir en janvier.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b7F"
