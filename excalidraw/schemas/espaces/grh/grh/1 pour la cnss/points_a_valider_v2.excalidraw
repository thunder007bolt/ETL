    {
      "id": "IfvfrVg5ufbOPjgV0PBp",
      "type": "text",
      "x": 1813,
      "y": 1222,
      "width": 193.2,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
