    },
    {
      "id": "IEuVrFreg981FQviN8WH",
      "type": "text",
      "x": 39,
      "y": 12428,
      "width": 711.0400000000001,
      "height": 20,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "ap2epEZGio7TR7LkGqim"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1637094425,
      "version": 2,
      "versionNonce": 1658169645,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795082621082,
      "link": null,
      "locked": false,
      "text": "C'est quoi : un contractuel est un agent temporaire, engagé pour une durée limitée.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "C'est quoi : un contractuel est un agent temporaire, engagé pour une durée limitée.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "bDE"
    },
    {
      "id": "1na6xc4AWBD8PKIJbBbQ",
      "type": "text",
      "x": 39,
      "y": 12456,
      "width": 803.5200000000001,
      "height": 60,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "ap2epEZGio7TR7LkGqim"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1203848290,
      "version": 2,
      "versionNonce": 496405539,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795082621082,
      "link": null,
      "locked": false,
      "text": "Réponse donnée : un temporaire est présent si la date d'arrêté tombe dans un de ses contrats ;\nun contrat commence à l'engagement (50) et finit au départ ou au contrat suivant. Plus de\ndurée de 18 mois.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Réponse donnée : un temporaire est présent si la date d'arrêté tombe dans un de ses contrats ;\nun contrat commence à l'engagement (50) et finit au départ ou au contrat suivant. Plus de\ndurée de 18 mois.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "bDF"
    },
