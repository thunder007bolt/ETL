    {
      "id": "arm83yM4E9DS5xkVyGV8",
      "type": "text",
      "x": 897,
      "y": 6998,
      "width": 758.5600000000001,
      "height": 40,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
