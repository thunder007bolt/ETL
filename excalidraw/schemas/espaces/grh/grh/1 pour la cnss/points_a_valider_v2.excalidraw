    {
      "id": "zWWCbSDkr5JSUj3fGNSD",
      "type": "text",
      "x": 104.25884016973126,
      "y": 6418,
      "width": 309.6,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
