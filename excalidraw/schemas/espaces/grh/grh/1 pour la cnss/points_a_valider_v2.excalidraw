      "versionNonce": 108651981,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795082621082,
      "link": null,
      "locked": false,
      "text": "Objectif : dans T62, chaque formation doit compter dans une seule année. Cela permet de ne\npas compter deux fois un agent (Kaya 2017). La réponse permet de confirmer l'année retenue.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Objectif : dans T62, chaque formation doit compter dans une seule année. Cela permet de ne\npas compter deux fois un agent (Kaya 2017). La réponse permet de confirmer l'année retenue.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b7G"
