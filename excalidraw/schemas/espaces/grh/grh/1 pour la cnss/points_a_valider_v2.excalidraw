      "isDeleted": false,
      "boundElements": [],
      "updated": 1795082621082,
      "link": null,
      "locked": false,
      "text": "C'est quoi : un temporaire est souvent réengagé plusieurs fois.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "C'est quoi : un temporaire est souvent réengagé plusieurs fois.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "bEM"
    },
    {
      "id": "ISuWqTQnJuLpGUKJUlvX",
      "type": "text",
      "x": 1755,
      "y": 12796,
      "width": 762.4000000000001,
      "height": 40,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "XzbXP1i913yMJMgxYRjS"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 844659216,
      "version": 2,
      "versionNonce": 802057987,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795082621082,
      "link": null,
      "locked": false,
      "text": "Réponse donnée : T60 se lit pour les permanents ou pour les temporaires, comme T58. Un\ntemporaire devenu permanent est une autre entrée des permanents.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Réponse donnée : T60 se lit pour les permanents ou pour les temporaires, comme T58. Un\ntemporaire devenu permanent est une autre entrée des permanents.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "bEN"
    },
