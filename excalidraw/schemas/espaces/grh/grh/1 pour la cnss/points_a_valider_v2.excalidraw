      "versionNonce": 765661859,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795082621082,
      "link": null,
      "locked": false,
      "text": "Aujourd'hui : le taux CIPRES se calcule sur les permanents : 48,3 % en 2024 (358 cadres\nsur 741), pour 49,2 % publiés. Celui des temporaires se lit à part : 19,7 % (59 sur 299), à\nrevoir avec le point 20.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Aujourd'hui : le taux CIPRES se calcule sur les permanents : 48,3 % en 2024 (358 cadres\nsur 741), pour 49,2 % publiés. Celui des temporaires se lit à part : 19,7 % (59 sur 299), à\nrevoir avec le point 20.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b9F"
