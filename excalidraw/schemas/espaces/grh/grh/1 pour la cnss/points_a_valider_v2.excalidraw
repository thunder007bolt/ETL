      "seed": 256483967,
      "version": 2,
      "versionNonce": 1549093699,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795082621082,
      "link": null,
      "locked": false,
      "text": "Réponse donnée : sans objet aujourd'hui. Depuis 2019, aucune formation ne dure plus d'un an ;\nune seule est à cheval sur deux années (point 28).",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Réponse donnée : sans objet aujourd'hui. Depuis 2019, aucune formation ne dure plus d'un an ;\nune seule est à cheval sur deux années (point 28).",
