      "versionNonce": 651098477,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795082621082,
      "link": null,
      "locked": false,
      "text": "Aujourd'hui : seul ce qui est dans l'application compte (fiche des règles, règle 3).",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Aujourd'hui : seul ce qui est dans l'application compte (fiche des règles, règle 3).",
