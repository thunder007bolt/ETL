      "text": "Les contractuels",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Les contractuels",
      "autoResize": true,
      "lineHeight": 1.25,
