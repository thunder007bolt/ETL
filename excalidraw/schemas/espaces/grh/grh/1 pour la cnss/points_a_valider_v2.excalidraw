      "isDeleted": false,
      "boundElements": [],
      "updated": 1795082621082,
      "link": null,
      "locked": false,
      "text": "Dans la base : vue V_BI_BALANCE_COMPTABLE (point 55), gestion G générale et S\nsociale.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Dans la base : vue V_BI_BALANCE_COMPTABLE (point 55), gestion G générale et S\nsociale.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b8f"
    },
