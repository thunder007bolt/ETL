    {
      "id": "pqdLxHUvHRwDPp74Almj",
      "type": "text",
      "x": 1818.2220650636493,
      "y": 3184,
      "width": 196.8,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "FbJ85Jfi5tqvoSr8jI83"
      ],
      "frameId": null,
