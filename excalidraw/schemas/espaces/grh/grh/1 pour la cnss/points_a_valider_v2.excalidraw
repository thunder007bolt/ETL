      "isDeleted": false,
      "boundElements": [],
      "updated": 1795082621082,
      "link": null,
      "locked": false,
      "text": "Dans la base : aucune décision 37 (accueil d'un agent détaché) pour un permanent.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Dans la base : aucune décision 37 (accueil d'un agent détaché) pour un permanent.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b4l"
    },
    {
      "id": "LEpDcwJLAjVqmhybOHDV",
