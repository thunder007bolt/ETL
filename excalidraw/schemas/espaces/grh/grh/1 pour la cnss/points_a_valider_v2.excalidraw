      "version": 2,
      "versionNonce": 28100707,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795082621082,
      "link": null,
      "locked": false,
      "text": "Aujourd'hui : budget définitif des comptes 6 et 2, toutes gestions.",
