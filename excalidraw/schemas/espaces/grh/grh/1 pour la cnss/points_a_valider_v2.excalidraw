      "boundElements": [],
      "updated": 1795082621082,
      "link": null,
      "locked": false,
      "text": "Source : décision du 08/11, d'après le tableau 121 de l'annuaire CNSS 2024 et la réunion\ndu 03/11. La DRH peut encore la revoir.",
      "fontSize": 16,
      "fontFamily": 5,
