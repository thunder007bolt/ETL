      "versionNonce": 3281357,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795082621082,
      "link": null,
      "locked": false,
      "text": "À qui : DRH",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "À qui : DRH",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b02"
    },
    {
