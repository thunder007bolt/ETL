    {
      "id": "rZtZ4lh0EtTpc6Zb9GQv",
      "type": "text",
      "x": 102.22206506364921,
      "y": 3748,
      "width": 210.8,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
