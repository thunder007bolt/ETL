      "type": "text",
      "x": 1755,
      "y": 1618,
      "width": 708.8000000000001,
      "height": 40,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "s4jowQUux6huTCKM658R"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 510272150,
      "version": 2,
      "versionNonce": 1628077443,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795082621082,
      "link": null,
      "locked": false,
      "text": "Question : peut-on saisir la date du décès dans l'application, ou au moins celle du\ncommuniqué nécrologique ?",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Question : peut-on saisir la date du décès dans l'application, ou au moins celle du\ncommuniqué nécrologique ?",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b03"
    },
