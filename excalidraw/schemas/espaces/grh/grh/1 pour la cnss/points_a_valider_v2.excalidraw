      "versionNonce": 1401686029,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795082621082,
      "link": null,
      "locked": false,
      "text": "• Les formations, table GRH_FORMATION (date de début, date de fin, et catégorie : PERF perfectionnement, DIPLO diplômante, CONF conférence) ; les inscriptions, table GRH_INSCRIPTION : un agent inscrit à une formation, avec ses frais et son\nclassement avant et après la formation (CLA_AVANT, CLA_APRES).",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "• Les formations, table GRH_FORMATION (date de début, date de fin, et catégorie : PERF perfectionnement, DIPLO diplômante, CONF conférence) ; les inscriptions, table GRH_INSCRIPTION : un agent inscrit à une formation, avec ses frais et son\nclassement avant et après la formation (CLA_AVANT, CLA_APRES).",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "aC"
    },
    {
      "id": "Y96vwfRE5e32A8Yb3FKa",
      "type": "text",
      "x": 45,
      "y": 801.5,
      "width": 2415.78,
      "height": 45,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "ar3ZLt4bnlz2MPKgcjnC"
      ],
      "frameId": null,
