      "boundElements": [],
      "updated": 1795082621082,
      "link": null,
      "locked": false,
      "text": "C'est quoi : T60 suit les entrées et les sorties du personnel sur cinq ans.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "C'est quoi : T60 suit les entrées et les sorties du personnel sur cinq ans.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "bDS"
    },
    {
      "id": "HzEz3GiG0LEbYJ4fmGd8",
      "type": "text",
      "x": 897,
      "y": 12456,
      "width": 761.2800000000001,
      "height": 60,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
