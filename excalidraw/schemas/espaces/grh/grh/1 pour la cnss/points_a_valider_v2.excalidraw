      "versionNonce": 1332237347,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795082621082,
      "link": null,
      "locked": false,
      "text": "Question : T62 compte-t-il aussi les temporaires et les agents de la fonction publique\nformés ?",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Question : T62 compte-t-il aussi les temporaires et les agents de la fonction publique\nformés ?",
