      "boundElements": [],
      "updated": 1795082621082,
      "link": null,
      "locked": false,
      "text": "C'est quoi : les montants comptables lus dans la copie de la base semblaient faux.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "C'est quoi : les montants comptables lus dans la copie de la base semblaient faux.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "bEa"
    },
    {
      "id": "WgBWKKiHOr1zth9ckQ24",
      "type": "text",
      "x": 39,
      "y": 13136,
      "width": 772.8000000000001,
      "height": 40,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
