    {
      "id": "9JaWitGnHrwHn3rrzFoA",
      "type": "text",
      "x": 1755,
      "y": 11148,
      "width": 758.08,
      "height": 40,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
