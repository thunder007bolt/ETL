      "seed": 442856667,
      "version": 2,
      "versionNonce": 1275350765,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795082621082,
      "link": null,
      "locked": false,
      "text": "C'est quoi : le recueil demande T63 et T64 par direction, agence et bureau (RH lignes 6 et\n7).",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "C'est quoi : le recueil demande T63 et T64 par direction, agence et bureau (RH lignes 6 et\n7).",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b8u"
    },
    {
      "id": "70n4CmXGsLfUoTcwt8Wj",
      "type": "text",
      "x": 897,
      "y": 9270,
      "width": 775.84,
      "height": 60,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "GjA9L8bdWs1mcZs21Lmv"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 723286505,
      "version": 2,
      "versionNonce": 543040099,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795082621082,
      "link": null,
      "locked": false,
      "text": "Objectif : dans T63 et T64, chaque montant doit pouvoir se lire par unité. Cela permet à\nchaque direction de suivre ses frais de personnel et sa formation (recueil v7). La réponse\npermet de savoir si la comptabilité le permet.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Objectif : dans T63 et T64, chaque montant doit pouvoir se lire par unité. Cela permet à\nchaque direction de suivre ses frais de personnel et sa formation (recueil v7). La réponse\npermet de savoir si la comptabilité le permet.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b8v"
    },
