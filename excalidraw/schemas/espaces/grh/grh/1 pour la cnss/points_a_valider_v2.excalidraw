      "versionNonce": 847561763,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795082764914,
      "link": null,
      "locked": false,
      "text": "Question : d'où viennent les chiffres de l'annuaire ? Si c'est un autre fichier que\nl'application, pouvez-vous nous le donner, avec la liste de ses colonnes ?",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Question : d'où viennent les chiffres de l'annuaire ? Si c'est un autre fichier que\nl'application, pouvez-vous nous le donner, avec la liste de ses colonnes ?",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b0L"
    },
