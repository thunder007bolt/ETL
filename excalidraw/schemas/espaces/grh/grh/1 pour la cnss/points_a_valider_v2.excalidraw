      "isDeleted": false,
      "boundElements": [],
      "updated": 1795082621082,
      "link": null,
      "locked": false,
      "text": "Aujourd'hui : on reprend cette liste telle quelle.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Aujourd'hui : on reprend cette liste telle quelle.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b5K"
    },
    {
      "id": "mpMbISi3tZS2nYtRMJNG",
      "type": "text",
      "x": 897,
      "y": 6698,
      "width": 796,
      "height": 40,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
