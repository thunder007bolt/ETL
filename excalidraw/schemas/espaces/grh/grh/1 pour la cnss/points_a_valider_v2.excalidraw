      "boundElements": [],
      "updated": 1795082621082,
      "link": null,
      "locked": false,
      "text": "Question : « 63, 86 et 87 » veut-il dire tous ces comptes, ou des sous-comptes comme 6386 et\n6387 ?",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
