      "updated": 1795082621082,
      "link": null,
      "locked": false,
      "text": "Les actifs ou tout l'effectif ?",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Les actifs ou tout l'effectif ?",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "bFF"
    },
    {
      "id": "xS9zCj6788IUAUSfTXOZ",
      "type": "text",
      "x": 39,
      "y": 13408,
      "width": 648,
      "height": 20,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "lMVQ4ILb87RiLF1B9z09"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 777131363,
      "version": 2,
      "versionNonce": 1339531981,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795082621082,
      "link": null,
      "locked": false,
      "text": "C'est quoi : le taux d'encadrement pouvait se calculer sur les seuls actifs.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "C'est quoi : le taux d'encadrement pouvait se calculer sur les seuls actifs.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "bFG"
    },
    {
      "id": "JvAdHFd7k03Ea7wL3k6z",
      "type": "text",
      "x": 39,
      "y": 13436,
      "width": 785.44,
      "height": 40,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "lMVQ4ILb87RiLF1B9z09"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 2130006814,
      "version": 2,
      "versionNonce": 1963097219,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795082621082,
      "link": null,
      "locked": false,
      "text": "Réponse donnée : sans objet. Les agents en disponibilité sortent de l'effectif (point 5), il\nne reste presque plus d'inactifs : le taux porte sur tout l'effectif.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Réponse donnée : sans objet. Les agents en disponibilité sortent de l'effectif (point 5), il\nne reste presque plus d'inactifs : le taux porte sur tout l'effectif.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "bFH"
    },
