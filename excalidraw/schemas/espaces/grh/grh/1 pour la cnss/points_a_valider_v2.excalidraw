      "link": null,
      "locked": false,
      "text": "C'est quoi : l'annuaire donne l'effectif permanent de 2020 à 2024.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "C'est quoi : l'annuaire donne l'effectif permanent de 2020 à 2024.",
