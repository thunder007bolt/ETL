      "locked": false,
      "text": "C'est quoi : la colonne des retraites compte les agents admis à la retraite dans l'année.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "C'est quoi : la colonne des retraites compte les agents admis à la retraite dans l'année.",
