    {
      "id": "tEga4wO5Ndor89QtvnQz",
      "type": "text",
      "x": 955,
      "y": 1222,
      "width": 328.8,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
