      "type": "text",
      "x": 1755,
      "y": 10712,
      "width": 731.5200000000001,
      "height": 20,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
