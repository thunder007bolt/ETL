    {
      "id": "vJLnC9ENKxWwjzn1imHu",
      "type": "text",
      "x": 897,
      "y": 9222,
      "width": 787.36,
      "height": 40,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
