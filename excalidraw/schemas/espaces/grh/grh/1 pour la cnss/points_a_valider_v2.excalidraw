    {
      "id": "aV5K4dTgaM8IqmPhWiJ8",
      "type": "text",
      "x": 104.25884016973126,
      "y": 7612,
      "width": 346,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
