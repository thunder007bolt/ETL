      "locked": false,
      "text": "C'est quoi : T59 répartit le personnel par domaine d'activité.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "C'est quoi : T59 répartit le personnel par domaine d'activité.",
