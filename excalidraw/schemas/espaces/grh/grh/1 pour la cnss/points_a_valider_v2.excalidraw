    {
      "id": "fA75UyiCDmO46ayJKP4G",
      "type": "text",
      "x": 106.2956152758133,
      "y": 1222,
      "width": 328.00000000000006,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "FRuT11NCue1cr3McRTrK"
      ],
      "frameId": null,
