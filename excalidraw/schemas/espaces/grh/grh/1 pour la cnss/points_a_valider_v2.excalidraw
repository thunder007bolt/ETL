      "roundness": null,
      "seed": 1335744614,
      "version": 2,
      "versionNonce": 316225571,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795082621082,
      "link": null,
      "locked": false,
      "text": "Aujourd'hui : l'effectif se calcule au 31 décembre, et à chaque fin de mois en option.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Aujourd'hui : l'effectif se calcule au 31 décembre, et à chaque fin de mois en option.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b3x"
    },
