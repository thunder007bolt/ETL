      "isDeleted": false,
      "boundElements": [],
      "updated": 1795082621082,
      "link": null,
      "locked": false,
      "text": "C'est quoi : une formation diplômante peut durer plus d'un an.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "C'est quoi : une formation diplômante peut durer plus d'un an.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "bFi"
    },
    {
      "id": "Jiq0D2xZQ0bVKyY4Uo93",
      "type": "text",
      "x": 1755,
      "y": 13436,
      "width": 800.6400000000001,
      "height": 40,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
