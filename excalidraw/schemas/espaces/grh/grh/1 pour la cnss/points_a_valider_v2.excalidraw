    {
      "id": "ZUG8brWKvH9Fuk7OY5FQ",
      "type": "text",
      "x": 897,
      "y": 3796,
      "width": 768.96,
      "height": 40,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
