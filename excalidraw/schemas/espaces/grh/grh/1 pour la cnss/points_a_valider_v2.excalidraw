    },
    {
      "id": "uaRdzuEF09NPU2pLg6cR",
      "type": "text",
      "x": 897,
      "y": 6050,
      "width": 805.12,
      "height": 60,
      "angle": 0,
      "strokeColor": "#2f9e44",
