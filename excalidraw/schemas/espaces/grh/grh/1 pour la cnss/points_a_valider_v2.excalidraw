      "updated": 1795082621082,
      "link": null,
      "locked": false,
      "text": "L'agent en disponibilité",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "L'agent en disponibilité",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "bC5"
    },
    {
      "id": "8uh80tpBMqETofmAf38A",
      "type": "text",
      "x": 897,
      "y": 11728,
      "width": 769.9200000000001,
      "height": 40,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "dOgjfeCikdkXDrXtYbzJ"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1498901373,
      "version": 2,
      "versionNonce": 496918029,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795082621082,
      "link": null,
      "locked": false,
      "text": "C'est quoi : un agent en disponibilité arrête de travailler pour un temps, à sa demande et\nsans salaire.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "C'est quoi : un agent en disponibilité arrête de travailler pour un temps, à sa demande et\nsans salaire.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "bC6"
    },
    {
      "id": "oSPyR0W1Cv26RwRn44UZ",
      "type": "text",
      "x": 897,
      "y": 11776,
      "width": 804.96,
      "height": 40,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "dOgjfeCikdkXDrXtYbzJ"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1573339151,
      "version": 2,
      "versionNonce": 1485313347,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795082621082,
      "link": null,
      "locked": false,
      "text": "Réponse donnée : il sort de l'effectif à sa mise en disponibilité (décision 07) et y revient à\nsa remise en activité (18). T60 compte une sortie et une entrée.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Réponse donnée : il sort de l'effectif à sa mise en disponibilité (décision 07) et y revient à\nsa remise en activité (18). T60 compte une sortie et une entrée.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "bC7"
    },
