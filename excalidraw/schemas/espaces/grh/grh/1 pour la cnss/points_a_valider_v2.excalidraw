    {
      "id": "UwpNFgFULh2GNqTmSH4B",
      "type": "text",
      "x": 69,
      "y": 1714,
      "width": 72.96000000000001,
      "height": 20,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
