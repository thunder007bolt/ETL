    {
      "id": "9LE1Ki3ylOjt6o0NpUmk",
      "type": "text",
      "x": 45,
      "y": 414.5,
      "width": 2449.9800000000005,
      "height": 45,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "ar3ZLt4bnlz2MPKgcjnC"
      ],
      "frameId": null,
