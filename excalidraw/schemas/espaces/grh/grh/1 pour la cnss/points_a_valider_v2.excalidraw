      "seed": 1344511251,
      "version": 2,
      "versionNonce": 202582019,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795082621082,
      "link": null,
      "locked": false,
      "text": "Chiffre : la table a bien ses 18 codes (vérifié le 17/11). De 2020 à 2025, T60 ne remplit\nque REM, DISP, DEM, LIC et FIN_CTRAT : aucun détachement, aucune mise à disposition.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Chiffre : la table a bien ses 18 codes (vérifié le 17/11). De 2020 à 2025, T60 ne remplit\nque REM, DISP, DEM, LIC et FIN_CTRAT : aucun détachement, aucune mise à disposition.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b5L"
    },
