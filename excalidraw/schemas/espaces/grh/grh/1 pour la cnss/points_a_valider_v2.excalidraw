      "versionNonce": 1144149987,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795082621082,
      "link": null,
      "locked": false,
      "text": "D'accord",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
