      "seed": 1691465709,
      "version": 1,
      "versionNonce": 888339989,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794932908491,
      "link": null,
      "locked": false,
      "text": "-- à coller sous la règle 4, à la place\n-- de sa dernière ligne\nSELECT CATEGORIE, COUNT(DISTINCT PERS_ID)\nFROM   formes_2024\nGROUP  BY CATEGORIE\nORDER  BY CATEGORIE\n-- 2024 : 01 + 02 employés       81\n--        03      maîtrise       96\n--        04 + 05 cadres moyens 179\n--        06      cadres sup.    51\n-- (l'annuaire : 132, 142, 118, 88)",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-- à coller sous la règle 4, à la place\n-- de sa dernière ligne\nSELECT CATEGORIE, COUNT(DISTINCT PERS_ID)\nFROM   formes_2024\nGROUP  BY CATEGORIE\nORDER  BY CATEGORIE\n-- 2024 : 01 + 02 employés       81\n--        03      maîtrise       96\n--        04 + 05 cadres moyens 179\n--        06      cadres sup.    51\n-- (l'annuaire : 132, 142, 118, 88)",
      "autoResize": true,
      "lineHeight": 1.25
    },
