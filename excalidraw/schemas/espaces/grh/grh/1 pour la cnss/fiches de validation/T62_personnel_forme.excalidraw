    },
    {
      "id": "Vsv3K3Qm2LQ20dnahxT6",
      "type": "text",
      "x": 39.0,
      "y": 4836.5,
      "width": 805.6800000000001,
      "height": 90.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "2u1cR97RceOqTz6ZARo6"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1595986781,
      "version": 1,
      "versionNonce": 176515054,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794932908491,
      "link": null,
      "locked": false,
      "text": "L'annuaire de la CNSS publie 480 permanents formés en 2024. La base en compte\n407 avec la date de début des formations, 409 avec la date de fin (522\ninscriptions), sans temporaire ni personne externe. D'où viennent les chiffres\npubliés ? Si c'est un autre fichier, pouvez-vous nous le donner, avec ses colonnes ?",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "L'annuaire de la CNSS publie 480 permanents formés en 2024. La base en compte\n407 avec la date de début des formations, 409 avec la date de fin (522\ninscriptions), sans temporaire ni personne externe. D'où viennent les chiffres\npubliés ? Si c'est un autre fichier, pouvez-vous nous le donner, avec ses colonnes ?",
      "autoResize": true,
      "lineHeight": 1.25
    },
