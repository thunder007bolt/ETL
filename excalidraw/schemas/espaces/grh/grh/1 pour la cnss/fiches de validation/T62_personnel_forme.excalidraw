    {
      "id": "2RQnGuq5hlFYBV52dCof",
      "type": "text",
      "x": 788.72,
      "y": 2822.5,
      "width": 445.43999999999994,
      "height": 220.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "jN7qMyXsjedDtphHq4YL"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1024957263,
      "version": 1,
      "versionNonce": 1834084466,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794932908491,
      "link": null,
      "locked": false,
      "text": "-- agents distincts inscrits à une\n-- formation commencée en 2024\nSELECT COUNT(DISTINCT i.PERS_ID) AS formes,\n       COUNT(*)                  AS inscriptions\nFROM   USER_GRH.GRH_INSCRIPTION i\nJOIN   USER_GRH.GRH_FORMATION f\n       ON f.FORM_NO = i.FORM_NO\nWHERE  f.DATE_DEBUT BETWEEN DATE '2024-01-01'\n                        AND DATE '2024-12-31'\n-- 2024 : 408 personnes, 523 inscriptions\n-- (l'annuaire : 480 formés)",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-- agents distincts inscrits à une\n-- formation commencée en 2024\nSELECT COUNT(DISTINCT i.PERS_ID) AS formes,\n       COUNT(*)                  AS inscriptions\nFROM   USER_GRH.GRH_INSCRIPTION i\nJOIN   USER_GRH.GRH_FORMATION f\n       ON f.FORM_NO = i.FORM_NO\nWHERE  f.DATE_DEBUT BETWEEN DATE '2024-01-01'\n                        AND DATE '2024-12-31'\n-- 2024 : 408 personnes, 523 inscriptions\n-- (l'annuaire : 480 formés)",
      "autoResize": true,
      "lineHeight": 1.25
    },
