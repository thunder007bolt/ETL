    {
      "id": "RTZPFg3BR9iSOXDHzySf",
      "type": "text",
      "x": 788.72,
      "y": 3879.5,
      "width": 380.47999999999996,
      "height": 220.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
