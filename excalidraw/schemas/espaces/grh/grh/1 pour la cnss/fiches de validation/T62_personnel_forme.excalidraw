      "text": "D'où viennent les 480 formés ?",
      "fontSize": 22,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "D'où viennent les 480 formés ?",
