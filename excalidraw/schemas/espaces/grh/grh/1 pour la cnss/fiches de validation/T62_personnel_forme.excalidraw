      "updated": 1794932908491,
      "link": null,
      "locked": false,
      "text": "SELECT COUNT(DISTINCT PERS_ID) AS total,\n       COUNT(*)                AS inscriptions,\n       COUNT(DISTINCT CASE WHEN finalite = 'PERF'\n             THEN PERS_ID END) AS perfectionnement,\n       COUNT(DISTINCT CASE WHEN finalite = 'DIPLO'\n             THEN PERS_ID END) AS diplomante\nFROM   formes_2024\n-- 2024 : 407 formés, 522 inscriptions ;\n-- 406 en perfectionnement, 0 diplômante",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "SELECT COUNT(DISTINCT PERS_ID) AS total,\n       COUNT(*)                AS inscriptions,\n       COUNT(DISTINCT CASE WHEN finalite = 'PERF'\n             THEN PERS_ID END) AS perfectionnement,\n       COUNT(DISTINCT CASE WHEN finalite = 'DIPLO'\n             THEN PERS_ID END) AS diplomante\nFROM   formes_2024\n-- 2024 : 407 formés, 522 inscriptions ;\n-- 406 en perfectionnement, 0 diplômante",
      "autoResize": true,
      "lineHeight": 1.25
    },
