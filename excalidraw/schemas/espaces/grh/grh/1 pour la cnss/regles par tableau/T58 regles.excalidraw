      "updated": 1794932317267,
      "link": null,
      "locked": false,
      "text": "Pour l'année N, la photo de la base de fin janvier N+1 fait foi. Ce qui est saisi plus tard\nn'entre que dans les photos suivantes.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Pour l'année N, la photo de la base de fin janvier N+1 fait foi. Ce qui est saisi plus tard\nn'entre que dans les photos suivantes.",
      "autoResize": true,
      "lineHeight": 1.25
