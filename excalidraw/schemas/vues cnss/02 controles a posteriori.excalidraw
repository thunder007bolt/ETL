      "boundElements": [],
      "updated": 1794092461730,
      "link": null,
      "locked": false,
      "text": "LA BI\n· dossiers payés : déjà dans la base des prestations\n· dossiers contrôlés : cette vue, par trimestre de la date du contrôle\n· taux de contrôle = contrôlés / payés, par type de prestation\n· par direction régionale et agence, grâce au dossier (Kaya 2017)\n· T31 : l'indu constaté se compare aux trop-perçus de la base",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "LA BI\n· dossiers payés : déjà dans la base des prestations\n· dossiers contrôlés : cette vue, par trimestre de la date du contrôle\n· taux de contrôle = contrôlés / payés, par type de prestation\n· par direction régionale et agence, grâce au dossier (Kaya 2017)\n· T31 : l'indu constaté se compare aux trop-perçus de la base",
      "autoResize": true,
      "lineHeight": 1.25
    },
