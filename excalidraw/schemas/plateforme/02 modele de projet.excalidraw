    {
      "id": "8ax4Mokku3J770ETI7NS",
      "type": "text",
      "x": 65,
      "y": 771.5,
      "width": 638.0,
      "height": 475.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "0Jj4mwAtio9rOlPnSNs8"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1051248409,
      "version": 1,
      "versionNonce": 1615507967,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795176000644,
      "link": null,
      "locked": false,
      "text": "cnss_grh/\n  projet.yml           # nom, environnements, packs\n  parametres/\n    dev.yml  prod.yml  # schémas, seuils, choix métier\n  connexions.yml       # base GRH, entrepôt\n                       # (mots de passe au coffre)\n  sources/\n    grh.yml            # tables à lire, mode, fréquence\n  modeles/\n    brut/              # la copie des sources\n    propre/            # nettoyé, relié\n    indicateurs/\n      effectif.sql\n  indicateurs/\n    t58_effectif.yml   # définition, règles, validation\n  controles/\n    t58.yml\n  livraisons/\n    oac.yml",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "cnss_grh/\n  projet.yml           # nom, environnements, packs\n  parametres/\n    dev.yml  prod.yml  # schémas, seuils, choix métier\n  connexions.yml       # base GRH, entrepôt\n                       # (mots de passe au coffre)\n  sources/\n    grh.yml            # tables à lire, mode, fréquence\n  modeles/\n    brut/              # la copie des sources\n    propre/            # nettoyé, relié\n    indicateurs/\n      effectif.sql\n  indicateurs/\n    t58_effectif.yml   # définition, règles, validation\n  controles/\n    t58.yml\n  livraisons/\n    oac.yml",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "Y8tdEqmgXnonAjvGalIV",
      "type": "rectangle",
      "x": 1060,
