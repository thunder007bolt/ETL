    {
      "id": "NrepyWbhvImWAB7MwYkP",
      "type": "text",
      "x": 62,
      "y": 257.0,
      "width": 2268.4800000000005,
      "height": 90.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
