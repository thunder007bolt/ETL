      "seed": 263316098,
      "version": 1,
      "versionNonce": 322928653,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795176402030,
      "link": null,
      "locked": false,
      "text": "LA PLATEFORME EST UN PRODUIT D'OPTIWARE, vendu à d'autres clients. Le projet CNSS en est le premier client et la première référence.\nConséquence : on ne construit plus seulement un outil qui marche entre nos mains, mais un produit qu'un autre peut installer, comprendre, mettre à jour, payer, et faire évoluer\navec nous.",
      "fontSize": 24,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "LA PLATEFORME EST UN PRODUIT D'OPTIWARE, vendu à d'autres clients. Le projet CNSS en est le premier client et la première référence.\nConséquence : on ne construit plus seulement un outil qui marche entre nos mains, mais un produit qu'un autre peut installer, comprendre, mettre à jour, payer, et faire évoluer\navec nous.",
      "autoResize": true,
      "lineHeight": 1.25
    },
