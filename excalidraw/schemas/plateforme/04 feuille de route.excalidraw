      "isDeleted": false,
      "boundElements": [],
      "updated": 1795176410436,
      "link": null,
      "locked": false,
      "text": "LE PÉRIMÈTRE\nLe piège est de vouloir tout faire. Chaque\nétape livre quelque chose d'utilisable, et la\nporte de sortie évite de tout prévoir.",
      "fontSize": 21,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "LE PÉRIMÈTRE\nLe piège est de vouloir tout faire. Chaque\nétape livre quelque chose d'utilisable, et la\nporte de sortie évite de tout prévoir.",
      "autoResize": true,
      "lineHeight": 1.25
    },
