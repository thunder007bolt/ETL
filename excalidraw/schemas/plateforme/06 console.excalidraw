    {
      "id": "HOuasjUAyCaq2MBCKh3b",
      "type": "text",
      "x": 1602,
      "y": 6273.0,
      "width": 729.4,
      "height": 325.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
