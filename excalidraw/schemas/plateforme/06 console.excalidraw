    {
      "id": "IOTcRB6VeJCyi1J86NRC",
      "type": "text",
      "x": 1602,
      "y": 4306.0,
      "width": 734.6000000000001,
      "height": 425.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
