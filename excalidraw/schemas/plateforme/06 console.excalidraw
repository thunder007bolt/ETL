    {
      "id": "aW5uEyoWJzPI0zvBb6P0",
      "type": "text",
      "x": 1602,
      "y": 1591.5,
      "width": 734.0,
      "height": 275.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
