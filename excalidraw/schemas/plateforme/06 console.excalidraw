      "text": "L'API\nTout ce que fait la console passe par elle : mêmes droits, même journal d'audit. Un client peut aussi l'appeler depuis ses propres\noutils.",
      "fontSize": 21,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "L'API\nTout ce que fait la console passe par elle : mêmes droits, même journal d'audit. Un client peut aussi l'appeler depuis ses propres\noutils.",
      "autoResize": true,
      "lineHeight": 1.25
    },
