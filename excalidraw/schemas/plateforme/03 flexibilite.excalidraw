      "boundElements": [],
      "updated": 1795176000661,
      "link": null,
      "locked": false,
      "text": "CE QUI N'EST PAS SON CŒUR\nLe vrai temps réel (flux à la seconde, Kafka), les téraoctets (Spark, en plugin seulement), les\ndonnées non structurées (textes, images), l'apprentissage automatique. La plateforme s'y branche\n; elle ne les remplace pas.",
      "fontSize": 21,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "CE QUI N'EST PAS SON CŒUR\nLe vrai temps réel (flux à la seconde, Kafka), les téraoctets (Spark, en plugin seulement), les\ndonnées non structurées (textes, images), l'apprentissage automatique. La plateforme s'y branche\n; elle ne les remplace pas.",
      "autoResize": true,
      "lineHeight": 1.25
    },
