      "type": "text",
      "x": 45.0,
      "y": 2800.0,
      "width": 1177.02,
      "height": 45.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "cgCyOKboIhbASUXFrZ45"
      ],
      "frameId": null,
      "roundness": null,
