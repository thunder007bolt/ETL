      "locked": false,
      "text": "1. Le tableau 18 comparé : bénéficiaires de pension de 2020 à 2024",
      "fontSize": 30,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Le tableau 18 comparé : bénéficiaires de pension de 2020 à 2024",
      "autoResize": true,
