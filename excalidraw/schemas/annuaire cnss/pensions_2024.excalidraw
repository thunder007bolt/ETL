      "version": 1,
      "versionNonce": 509057253,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793390643208,
      "link": null,
      "locked": false,
      "text": "• Orphelins : la CNSS ne compte que les moins de 25 ans ; notre base garde près de 6 000 pensions d'orphelins plus âgés,\njamais radiées.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "• Orphelins : la CNSS ne compte que les moins de 25 ans ; notre base garde près de 6 000 pensions d'orphelins plus âgés,\njamais radiées.",
