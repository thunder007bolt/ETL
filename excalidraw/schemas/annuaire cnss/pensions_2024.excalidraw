    },
    {
      "id": "PmDlEurUDOC1TZ0nzL3C",
      "type": "text",
      "x": 25,
      "y": 462.5,
      "width": 2046.7800000000002,
      "height": 22.5,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
