      "boundElements": [],
      "updated": 1794179733300,
      "link": null,
      "locked": false,
      "text": "Un échantillon (la BI peut tout compter) ; deux tranches au\nlieu de trois ; seulement les premières demandes. Pour les\nPF, la notification, alors que le recueil dit « date de\nvalidation ». Défaut : une ligne vide compte comme un délai\nde 0 jour, dans les 45 jours et dans la moyenne",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Un échantillon (la BI peut tout compter) ; deux tranches au\nlieu de trois ; seulement les premières demandes. Pour les\nPF, la notification, alors que le recueil dit « date de\nvalidation ». Défaut : une ligne vide compte comme un délai\nde 0 jour, dans les 45 jours et dans la moyenne",
      "autoResize": true,
      "lineHeight": 1.25
    },
