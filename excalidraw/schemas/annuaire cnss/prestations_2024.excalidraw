      "verticalAlign": "top",
      "containerId": null,
      "originalText": "2.3 D'une année à l'autre",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "1Z9mg27wXTcb0glOM690",
      "type": "rectangle",
      "x": 25,
      "y": 7477.0,
