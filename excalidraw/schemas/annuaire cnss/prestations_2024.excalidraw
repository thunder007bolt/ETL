    {
      "id": "1V9jRUSs4SuQCz5OKgkr",
      "type": "text",
      "x": 47,
      "y": 7717.25,
      "width": 2443.6000000000004,
      "height": 50.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "BmycHPL5YxuKTK7aQ4YQ"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1183828725,
      "version": 1,
      "versionNonce": 1660729040,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794179733300,
      "link": null,
      "locked": false,
      "text": "En clair : les tableaux d'un même chapitre se recoupent presque toujours à l'unité. Ce qui ne colle pas porte sur les flux d'une année à l'autre (orphelins, ascendants), sur l'ASS et sur des étiquettes. Un chiffre publié isolé ne\nsuffit donc pas à juger une règle : on regarde aussi s'il tient avec ses voisins.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "En clair : les tableaux d'un même chapitre se recoupent presque toujours à l'unité. Ce qui ne colle pas porte sur les flux d'une année à l'autre (orphelins, ascendants), sur l'ASS et sur des étiquettes. Un chiffre publié isolé ne\nsuffit donc pas à juger une règle : on regarde aussi s'il tient avec ses voisins.",
      "autoResize": true,
      "lineHeight": 1.25
    },
