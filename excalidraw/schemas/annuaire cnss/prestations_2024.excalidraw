      "seed": 1994354023,
      "version": 1,
      "versionNonce": 1167323763,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794179733300,
      "link": null,
      "locked": false,
      "text": "8. La majoration pour enfant (tableaux 28 et 34).",
      "fontSize": 21,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "8. La majoration pour enfant (tableaux 28 et 34).",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "UmE1tzIEljBRFeBEjgPE",
      "type": "text",
      "x": 1337.0,
      "y": 20707.5,
      "width": 1194.66,
      "height": 90.0,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "k8sYImVzPV0fAx5pkJqY"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 664536366,
      "version": 1,
      "versionNonce": 1663376259,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794179733300,
      "link": null,
      "locked": false,
      "text": "T25-T27 et T32-T41 disent « confirme » pour le même chiffre (A1 : pas un pensionné de plus). T42-T49 dit « précise »\npour une autre comparaison (le montant d'un pensionné, tableaux 19 et 28, comme la carte « montant de T32 » de T32-T41).\nQue le montant de T32 se fasse sans les accessoires (T32-T41 N13) est tranché par la présentation de l'annuaire, pas par\nce chiffre.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "T25-T27 et T32-T41 disent « confirme » pour le même chiffre (A1 : pas un pensionné de plus). T42-T49 dit « précise »\npour une autre comparaison (le montant d'un pensionné, tableaux 19 et 28, comme la carte « montant de T32 » de T32-T41).\nQue le montant de T32 se fasse sans les accessoires (T32-T41 N13) est tranché par la présentation de l'annuaire, pas par\nce chiffre.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "EVaRisWxewouuil6bM4x",
      "type": "rectangle",
      "x": 25,
      "y": 20839.5,
      "width": 2550,
      "height": 81.5,
      "angle": 0,
      "strokeColor": "#f08c00",
