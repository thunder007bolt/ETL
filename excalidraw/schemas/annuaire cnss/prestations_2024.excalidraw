      "isDeleted": false,
      "boundElements": [],
      "updated": 1794179733300,
      "link": null,
      "locked": false,
      "text": "• Il contredit une seule affirmation : la fiche T27 disait les frais médicaux de maternité « jamais payés » ; 25 030 869 FCFA payés en 2024, absents de la base.",
      "fontSize": 21,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "• Il contredit une seule affirmation : la fiche T27 disait les frais médicaux de maternité « jamais payés » ; 25 030 869 FCFA payés en 2024, absents de la base.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "Iy7VU8OehodHi81n6ON7",
      "type": "text",
      "x": 22,
      "y": 416.75,
      "width": 2469.81,
      "height": 52.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
