      "type": "text",
      "x": 22,
      "y": 201.0,
      "width": 2451.7500000000005,
      "height": 52.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "PjIn3AdXwOADhUViWuyv"
      ],
      "frameId": null,
