      "isDeleted": false,
      "boundElements": [],
      "updated": 1794179733300,
      "link": null,
      "locked": false,
      "text": "• Écarts à expliquer : paiements AT/MP (soins 13,5 % dans la base, rentes −12 à −25 %, prestations en espèces −20,3 %) ; veuves −5,0 % et orphelins −15,9 % en 2024 ; rentes viagères 39 pour 44 ; allocataires 2020 à\n2023 (+5 à +11 %) ; sexe des nouveaux retraités (641 femmes pour 527) ; montants des IJ de maternité 2023 et 2024 (−2 à −4 %) ; rentiers décédés 16 pour 24.",
      "fontSize": 21,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "• Écarts à expliquer : paiements AT/MP (soins 13,5 % dans la base, rentes −12 à −25 %, prestations en espèces −20,3 %) ; veuves −5,0 % et orphelins −15,9 % en 2024 ; rentes viagères 39 pour 44 ; allocataires 2020 à\n2023 (+5 à +11 %) ; sexe des nouveaux retraités (641 femmes pour 527) ; montants des IJ de maternité 2023 et 2024 (−2 à −4 %) ; rentiers décédés 16 pour 24.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "GlpFLZUkkfiNgZ8MJZMO",
      "type": "text",
      "x": 22,
      "y": 477.25,
      "width": 2485.5600000000004,
      "height": 52.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
