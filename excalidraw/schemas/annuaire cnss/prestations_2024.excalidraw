      "isDeleted": false,
      "boundElements": [],
      "updated": 1794179733300,
      "link": null,
      "locked": false,
      "text": "Les 89 « décès d'ascendants » ne sont pas des pensions d'ascendant (T50-T57\nQ15 ; points_a_valider n° 57). Le stock d'orphelins 2024 est à faire\nexpliquer (T42-T49 Q20)",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Les 89 « décès d'ascendants » ne sont pas des pensions d'ascendant (T50-T57\nQ15 ; points_a_valider n° 57). Le stock d'orphelins 2024 est à faire\nexpliquer (T42-T49 Q20)",
      "autoResize": true,
      "lineHeight": 1.25
    },
