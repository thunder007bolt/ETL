      "seed": 1713315146,
      "version": 1,
      "versionNonce": 1312875991,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794179733300,
      "link": null,
      "locked": false,
      "text": "Harmonisé le 08/11 : « précise » dans T25-T27 et dans T50-T57 (T50-T57 disait « confirme »). Les IJ liquidées\nretombent, mais la date de comptage ne se départage pas (2022, 2023).",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
