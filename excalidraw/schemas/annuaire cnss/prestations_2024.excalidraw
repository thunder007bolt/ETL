    {
      "id": "bTL2XkgoZXIcgYOWIT2j",
      "type": "text",
      "x": 47.0,
      "y": 20204.25,
      "width": 1131.1200000000001,
      "height": 45.0,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "PQ0ynW6bXWanRiL5ld59"
