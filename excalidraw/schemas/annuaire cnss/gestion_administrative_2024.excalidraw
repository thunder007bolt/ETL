    {
      "id": "xK6SlvrZwlC04VY6rTkf",
      "type": "text",
      "x": 907.0,
      "y": 1515.25,
      "width": 708.66,
      "height": 112.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "iZAZtTUk9fRIYBlUGNnJ"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 260965961,
      "version": 1,
      "versionNonce": 1853367348,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794161626255,
      "link": null,
      "locked": false,
      "text": "Employés : 1re A 15 + 1re B 6 + 2e A 92 + 2e B 64 = 177\nAgents de maîtrise : 3e A 126 + 3e B 82 = 208\nCadres moyens : 4e A 27 + 4e B 175 + 4e C 23 + 5e A 59 + 5e B 27 = 311\nCadres supérieurs : 6e A 35 + 6e B 26 + HC 1 = 62\nLes quatre totaux sont ceux du tableau 119, à l'unité près.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Employés : 1re A 15 + 1re B 6 + 2e A 92 + 2e B 64 = 177\nAgents de maîtrise : 3e A 126 + 3e B 82 = 208\nCadres moyens : 4e A 27 + 4e B 175 + 4e C 23 + 5e A 59 + 5e B 27 = 311\nCadres supérieurs : 6e A 35 + 6e B 26 + HC 1 = 62\nLes quatre totaux sont ceux du tableau 119, à l'unité près.",
      "autoResize": true,
      "lineHeight": 1.25
    },
