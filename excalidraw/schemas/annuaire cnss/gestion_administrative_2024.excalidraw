      "boundElements": [],
      "updated": 1794161626255,
      "link": null,
      "locked": false,
      "text": "Le début d'une année est la fin de l'année d'avant, de 2015 à 2024. Le tableau\nne suit que les permanents. 104 recrutements en 2024, comme la base. Les 84 de\n2019 entrent en « autres », pas en recrutement, et sortent en « autres » en\n2024.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Le début d'une année est la fin de l'année d'avant, de 2015 à 2024. Le tableau\nne suit que les permanents. 104 recrutements en 2024, comme la base. Les 84 de\n2019 entrent en « autres », pas en recrutement, et sortent en « autres » en\n2024.",
      "autoResize": true,
      "lineHeight": 1.25
    },
