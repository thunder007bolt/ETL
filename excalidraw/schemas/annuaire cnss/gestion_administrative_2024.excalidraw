      "isDeleted": false,
      "boundElements": [],
      "updated": 1794161626255,
      "link": null,
      "locked": false,
      "text": "103 agents de moins d'un an, pour 104 recrutés en 2024 ; 1 seul de 1 à 4 ans,\ncar aucun recrutement de 2018 à 2023 (tableau 121). 232 de 10 à 14 ans. La\nbase (ancien calcul) : 101 et 224.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "103 agents de moins d'un an, pour 104 recrutés en 2024 ; 1 seul de 1 à 4 ans,\ncar aucun recrutement de 2018 à 2023 (tableau 121). 232 de 10 à 14 ans. La\nbase (ancien calcul) : 101 et 224.",
      "autoResize": true,
      "lineHeight": 1.25
    },
