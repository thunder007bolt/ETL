      "isDeleted": false,
      "boundElements": [],
      "updated": 1794161626255,
      "link": null,
      "locked": false,
      "text": "Chaque année, de 2015 à 2024 : début + entrées − sorties = fin (colonne\ncontrôle, calculée). L'effectif publié, 758 fin 2024, ne compte donc pas les\nagents en disponibilité : ils sont sortis.",
      "fontSize": 19,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Chaque année, de 2015 à 2024 : début + entrées − sorties = fin (colonne\ncontrôle, calculée). L'effectif publié, 758 fin 2024, ne compte donc pas les\nagents en disponibilité : ils sont sortis.",
      "autoResize": true,
      "lineHeight": 1.25
    },
