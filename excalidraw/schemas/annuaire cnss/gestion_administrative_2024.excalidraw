    {
      "id": "Oc6naRiQefNUFl9tERsM",
      "type": "text",
      "x": 47,
      "y": 1165.75,
      "width": 1441.15,
      "height": 95.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
